            "\[IndentingNewLine]", "\t      ", "]"}]}], "\[IndentingNewLine]",
           "\t    ", "]"}], ",", "\[IndentingNewLine]", "\t    ", "newExpr", ",",
          "\[IndentingNewLine]", "\t    ", "symmetrizationGroups"}], 
        "\[IndentingNewLine]", "\t  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "\t  ", "\[IndentingNewLine]", "\t  ", 
      RowBox[{"Join", "[", 
