          " ", "perms"}], "]"}], "/", 
       RowBox[{"Length", "[", "perms", "]"}]}]}]}], "\[IndentingNewLine]", 
    "\t", "]"}]}], "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "makeVertexSpinIndicesExplicit", "[", "\[IndentingNewLine]", "\t  ", 
    RowBox[{
    "vertexStructure_Association", ",", "\[IndentingNewLine]", "\t  ", 
     "vertex_", ",", "\[IndentingNewLine]", "\t  ", "diag_", ",", 
     "\[IndentingNewLine]", "\t  ", "edgeIndexData_Association", ",", 
     "\[IndentingNewLine]", "\t  ", "antiParticleRules_Association"}], 
    "\[IndentingNewLine]", "\t", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t    ", 
      RowBox[{
      "expr", ",", "incidentLegs", ",", "internalSpinorLegs", ",", 
       "groupedByIndex", ",", "replacementRules", ",", "\[IndentingNewLine]", 
       "\t    ", "symmetrizationGroups", ",", "newExpr"}], 
      "\[IndentingNewLine]", "\t  ", "}"}], ",", "\[IndentingNewLine]", 
     "\t  ", "\[IndentingNewLine]", "\t  ", 
     RowBox[{
      RowBox[{"expr", "=", 
       RowBox[{"vertexStructure", "[", "\"\<Expression\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t  ", 
      RowBox[{"incidentLegs", "=", 
       RowBox[{
        RowBox[{"diag", "[", "\"\<IncidentLegData\>\"", "]"}], "[", "vertex", 
        "]"}]}], ";", "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", 
      "\t  ", 
      RowBox[{"internalSpinorLegs", "=", 
       RowBox[{"Cases", "[", "\[IndentingNewLine]", "\t    ", 
        RowBox[{"expr", ",", "\[IndentingNewLine]", "\t    ", 
         RowBox[{
          RowBox[{"s", " ", ":", " ", 
           RowBox[{"Spinor", "[", 
            RowBox[{"\"\<Spin\>\"", ",", "sa_", ",", "mp_Multiparticle"}], 
            "]"}]}], ":>", 
          RowBox[{"<|", "\[IndentingNewLine]", "\t      ", 
           RowBox[{
            RowBox[{"\"\<Spinor\>\"", "->", "s"}], ",", "\[IndentingNewLine]",
             "\t      ", 
            RowBox[{"\"\<SpinType\>\"", "->", "sa"}], ",", 
            "\[IndentingNewLine]", "\t      ", 
            RowBox[{"\"\<IndexLabel\>\"", "->", "mp"}]}], 
           "\[IndentingNewLine]", "\t    ", "|>"}]}], ",", 
         "\[IndentingNewLine]", "\t    ", "Infinity"}], "\[IndentingNewLine]",
         "\t  ", "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
      "\[IndentingNewLine]", "\t  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"internalSpinorLegs", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "vertexStructure", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
      RowBox[{"groupedByIndex", "=", 
       RowBox[{"GroupBy", "[", "\[IndentingNewLine]", "\t    ", 
        RowBox[{"internalSpinorLegs", ",", "\[IndentingNewLine]", "\t    ", 
         RowBox[{"Function", "[", 
          RowBox[{"item", ",", "\[IndentingNewLine]", "\t      ", 
           RowBox[{
            RowBox[{"SelectFirst", "[", "\[IndentingNewLine]", "\t        ", 
             RowBox[{"incidentLegs", ",", "\[IndentingNewLine]", "\t        ", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "\"\<Kind\>\"", "]"}], 
                 "===", "\"\<Internal\>\""}], "&&", 
                RowBox[{
                 RowBox[{"#", "[", "\"\<Index\>\"", "]"}], "===", 
                 RowBox[{"item", "[", "\"\<IndexLabel\>\"", "]"}]}]}], " ", 
               "&"}]}], "\[IndentingNewLine]", "\t      ", "]"}], 
            "[", "\"\<Source\>\"", "]"}]}], "\[IndentingNewLine]", "\t    ", 
          "]"}]}], "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
      RowBox[{"replacementRules", "=", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "\t    ", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"edge", ",", "spinorsForEdge"}], "}"}], ",", 
