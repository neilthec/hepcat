                    "]"}]}]}], "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", "internalEdges"}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"newVertexStructures", "=", 
                  RowBox[{"Association", " ", "@", " ", 
                    
                    RowBox[{
                    "KeyValueMap", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"vertex", ",", "structures"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
