Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "spinorVarianceForLeg", ",", "\[IndentingNewLine]", "  ", 
    "symmetrizeIndexPair", ",", "\[IndentingNewLine]", "  ", 
    "makeVertexSpinIndicesExplicit", ",", "\[IndentingNewLine]", "  ", 
    "makeDiagramSpinIndicesExplicit"}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spinorVarianceForLeg", "[", 
    RowBox[{"leg_Association", ",", "internalEdgeLabels_Association"}], "]"}],
    ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "source", ",", "particle", ",", "edge", ",", "endpointLabels", ",", 
       "oppositeParticle"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"leg", "[", "\"\<Kind\>\"", "]"}], 
         "===", "\"\<External\>\""}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<NotInternal\>\"", "]"}], "]"}]}], "]"}],
       ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"source", "=", 
       RowBox[{"leg", "[", "\"\<Source\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"particle", "=", 
       RowBox[{"leg", "[", "\"\<Particle\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"edge", "=", "source"}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"endpointLabels", "=", 
       RowBox[{"internalEdgeLabels", "[", "edge", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"oppositeParticle", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Values", "[", "endpointLabels", "]"}], ",", "particle"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"oppositeParticle", "===", 
         RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
        "    ", "\"\<Upper\>\"", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "oppositeParticle", "]"}], "===", 
           "particle"}], ",", "\"\<Upper\>\"", ",", "\"\<Lower\>\""}], 
         "]"}]}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symmetrizeIndexPair", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"{", 
      RowBox[{"idx1_", ",", "idx2_"}], "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"expr", "+", 
      RowBox[{"(", 
       RowBox[{"expr", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"idx1", "->", "idx2"}], ",", 
          RowBox[{"idx2", "->", "idx1"}]}], "}"}]}], ")"}]}], ")"}], "/", 
    "2"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "makeVertexSpinIndicesExplicit", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "vertexStructure_Association", ",", "\[IndentingNewLine]", "  ", 
     "incidentLegs_List", ",", "\[IndentingNewLine]", "  ", 
     "internalEdgeLabels_Association"}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "expr", ",", "\[IndentingNewLine]", "    ", "spinorMatches", ",", 
       "\[IndentingNewLine]", "    ", "replacements", ",", 
       "\[IndentingNewLine]", "    ", "indexedData", ",", 
       "\[IndentingNewLine]", "    ", "indexSymbols", ",", 
       "\[IndentingNewLine]", "    ", "mpGroups", ",", "\[IndentingNewLine]", 
       "    ", "symmetrizedExpr"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"expr", "=", 
       RowBox[{"vertexStructure", "[", "\"\<Expression\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"spinorMatches", "=", 
       RowBox[{"Cases", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"expr", ",", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"s", " ", ":", " ", 
           RowBox[{"Spinor", "[", 
            RowBox[{"\"\<Spin\>\"", ",", "sa_", ",", "mp_Multiparticle"}], 
            "]"}]}], ":>", 
          RowBox[{"<|", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"\"\<Original\>\"", "->", "s"}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<SpinType\>\"", "->", "sa"}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<Multiparticle\>\"", "->", "mp"}]}], 
           "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
         "\[IndentingNewLine]", "    ", "Infinity"}], "\[IndentingNewLine]", 
        "  ", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"spinorMatches", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "vertexStructure", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"indexedData", "=", 
       RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"match", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"Module", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"mp", ",", "matchingLeg", ",", "variance", ",", "idx"}],
               "}"}], ",", "\[IndentingNewLine]", "        ", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"mp", "=", 
               RowBox[{"match", "[", "\"\<Multiparticle\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"matchingLeg", "=", 
               RowBox[{
               "SelectFirst", "[", "\[IndentingNewLine]", "          ", 
                RowBox[{
                "incidentLegs", ",", "\[IndentingNewLine]", "          ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"KeyExistsQ", "[", 
                    RowBox[{"#", ",", "\"\<Index\>\""}], "]"}], "&&", 
                   RowBox[{
                    RowBox[{"#", "[", "\"\<Index\>\"", "]"}], "===", "mp"}]}],
                   " ", "&"}]}], "\[IndentingNewLine]", "        ", "]"}]}], ";",
               "\[IndentingNewLine]", "        ", "\[IndentingNewLine]", 
              "        ", 
              RowBox[{"variance", "=", 
               RowBox[{"If", "[", "\[IndentingNewLine]", "          ", 
                RowBox[{
                 RowBox[{"AssociationQ", "[", "matchingLeg", "]"}], ",", 
                 "\[IndentingNewLine]", "          ", 
                 RowBox[{"spinorVarianceForLeg", "[", 
                  RowBox[{"matchingLeg", ",", "internalEdgeLabels"}], "]"}], ",",
                  "\[IndentingNewLine]", "          ", 
                 RowBox[{"Missing", "[", "\"\<VarianceNotFound\>\"", "]"}]}], 
                "\[IndentingNewLine]", "        ", "]"}]}], ";", 
              "\[IndentingNewLine]", "        ", "\[IndentingNewLine]", 
              "        ", 
              RowBox[{"idx", "=", 
               RowBox[{"Symbol", "[", 
                RowBox[{"\"\<i\>\"", " ", "<>", " ", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"First", "[", "k", "]"}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "        ", "\[IndentingNewLine]", 
              "        ", 
              RowBox[{"<|", "\[IndentingNewLine]", "          ", 
               RowBox[{
                RowBox[{"\"\<Original\>\"", "->", 
                 RowBox[{"match", "[", "\"\<Original\>\"", "]"}]}], ",", 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"\"\<Replacement\>\"", "->", 
                 RowBox[{"Spinor", "[", 
                  RowBox[{"\"\<Spin\>\"", ",", "variance", ",", 
                   RowBox[{"match", "[", "\"\<SpinType\>\"", "]"}], ",", "mp",
                    ",", "idx"}], "]"}]}], ",", "\[IndentingNewLine]", 
                "          ", 
                RowBox[{"\"\<Multiparticle\>\"", "->", "mp"}], ",", 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"\"\<Index\>\"", "->", "idx"}]}], 
               "\[IndentingNewLine]", "        ", "|>"}]}]}], 
            "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         "spinorMatches"}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"replacements", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "[", "\"\<Original\>\"", "]"}], ":>", 
           RowBox[{"#", "[", "\"\<Replacement\>\"", "]"}]}], ")"}], " ", 
         "&"}], " ", "/@", " ", "indexedData"}]}], ";", "\[IndentingNewLine]",
       "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"symmetrizedExpr", "=", 
       RowBox[{"expr", " ", "/.", " ", "replacements"}]}], ";", 
      "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"mpGroups", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"indexedData", ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Multiparticle\>\"", "]"}], " ", "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"symmetrizedExpr", "=", 
       RowBox[{"Fold", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"currentExpr", ",", "group"}], "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"If", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "group", "]"}], "==", "2"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"symmetrizeIndexPair", "[", 
              RowBox[{"currentExpr", ",", 
               RowBox[{"group", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "\"\<Index\>\""}], "]"}], "]"}]}], "]"}],
              ",", "\[IndentingNewLine]", "        ", "currentExpr"}], 
            "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         "symmetrizedExpr", ",", "\[IndentingNewLine]", "    ", "mpGroups"}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"vertexStructure", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"<|", 
         RowBox[{"\"\<Expression\>\"", "->", "symmetrizedExpr"}], "|>"}]}], 
       "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"makeDiagramSpinIndicesExplicit", "[", "diag_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", "newVertexStructures", "}"}], ",", "\[IndentingNewLine]", 
    "  ", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"newVertexStructures", "=", 
      RowBox[{"Association", " ", "@", " ", 
       RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vertex", ",", "structures"}], "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"vertex", "->", 
            RowBox[{"Map", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"vs", ",", "\[IndentingNewLine]", "          ", 
                RowBox[{
                "makeVertexSpinIndicesExplicit", "[", "\[IndentingNewLine]", 
                 "            ", 
                 RowBox[{"vs", ",", "\[IndentingNewLine]", "            ", 
                  RowBox[{
                   RowBox[{"diag", "[", "\"\<IncidentLegData\>\"", "]"}], "[",
                    "vertex", "]"}], ",", "\[IndentingNewLine]", 
                  "            ", 
                  RowBox[{"diag", "[", "\"\<InternalEdgeLabels\>\"", "]"}]}], 
                 "\[IndentingNewLine]", "          ", "]"}]}], 
               "\[IndentingNewLine]", "        ", "]"}], ",", 
              "\[IndentingNewLine]", "        ", "structures"}], 
             "\[IndentingNewLine]", "      ", "]"}]}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"diag", "[", "\"\<VertexStructures\>\"", "]"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}]}], ";", "\[IndentingNewLine]", 
     "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"Join", "[", 
      RowBox[{"diag", ",", 
       RowBox[{"<|", 
        RowBox[{"\"\<VertexStructures\>\"", "->", "newVertexStructures"}], 
        "|>"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellTags->"ChatGeneratedCell",
 CellLabel->
  "In[300]:=",ExpressionUUID->"cefecc83-5ce6-4a7c-beac-03202d294cbe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"processed", ",", "vertexFactors", ",", "propagatorFactors"}], 
     "}"}], ",", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"processed", "=", 
      RowBox[{"makeDiagramSpinIndicesExplicit", "[", "diag", "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"vertexFactors", "=", 
      RowBox[{"Replace", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Values", "[", 
         RowBox[{"processed", "[", "\"\<VertexStructures\>\"", "]"}], "]"}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "}"}], ":>", "1"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"list_List", ":>", 
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"Last", "[", "list", "]"}], ",", "\"\<Expression\>\"", ",",
              "1"}], "]"}]}]}], "\[IndentingNewLine]", "    ", "}"}], ",", 
        "\[IndentingNewLine]", "    ", "1"}], "\[IndentingNewLine]", "  ", 
       "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"propagatorFactors", "=", 
      RowBox[{"Lookup", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Values", "[", 
         RowBox[{"processed", "[", "\"\<Propagators\>\"", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", "\"\<Factor\>\"", ",", 
        "\[IndentingNewLine]", "    ", "1"}], "\[IndentingNewLine]", "  ", 
       "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Times", " ", "@@", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"vertexFactors", ",", "propagatorFactors"}], "]"}]}], "/", 
      "I"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
