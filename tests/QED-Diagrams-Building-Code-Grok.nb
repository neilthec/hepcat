   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "62a888a1-241c-45ec-9418-ba1aa0f297cc"],
 "\nThen update your amplitude function: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"diagramAmplitude", "[", 
          RowBox[{"diag_", ",", "antiParticleRules_Association"}], "]"}], 
        ":=", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
          RowBox[{
            RowBox[{"{", 
              
              RowBox[{"processed", ",", "vertexFactors", ",", 
                "propagatorFactors"}], "}"}], ",", "\[IndentingNewLine]", 
            "\t  ", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"processed", "=", 
                RowBox[{"makeDiagramSpinIndicesExplicit", "[", 
                  RowBox[{"diag", ",", "antiParticleRules"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{"vertexFactors", "=", 
                RowBox[{"Replace", "[", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"VertexStructures\"", "]"}], 
                    "]"}], ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"{", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", "1"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"list_List", ":>", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", "\"Expression\"",
                     ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", "\t    ", 
                    "}"}], ",", "\[IndentingNewLine]", "\t    ", "1"}], 
                  "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{"propagatorFactors", "=", 
                RowBox[{"Lookup", "[", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"Propagators\"", "]"}], "]"}],
                     ",", "\[IndentingNewLine]", "\t    ", "\"Factor\"", ",", 
                    "\[IndentingNewLine]", "\t    ", "1"}], 
                  "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"Times", " ", "@@", " ", 
                  RowBox[{"Join", "[", 
                    RowBox[{"vertexFactors", ",", "propagatorFactors"}], 
                    "]"}]}], "/", "I"}]}]}], "\[IndentingNewLine]", "\t", 
          "]"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
