Cell[CellGroupData[{

Cell["\<\
Almost, but you can see that the index should be \"Upper\" on the particle \
end and \"Lower\" on the antiparticle end of the propagator.  Also, the index \
should match between the two ends of the propagator.\
\>", "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellLabel->
  "In[307]:=",ExpressionUUID->"fe00c71c-054d-4d7a-aef7-f8f820922e87"],

Cell[TextData[{
 "Yes \[LongDash] the issue is that the current code assigns indices \
independently inside each vertex, so the two ends of the same internal \
propagator do ",
 StyleBox["not",
  FontWeight->Bold],
 " share the same spin index, and the upper/lower assignment is being \
inferred too loosely.\n\nWhat you want instead is:\n\n1. assign one unique \
index per internal propagator, not per spinor occurrence\n2. use that same \
index on both ends of that propagator\n3. determine variance from the \
endpoint label on that propagator: \n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "particle end ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Rule]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\to", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "2176bac4-85a4-4555-a7b5-067dbce09ced"],
  " ",
  Cell[BoxData["\"\<Upper\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "516afcf8-28e7-4647-8413-95f00148d940"]
 }], "InlineSubitem",ExpressionUUID->"99d6026d-4e5c-45b0-a457-2827ebd791bb"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "antiparticle end ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Rule]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\to", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "3a5907a4-c14b-4893-b171-2cc0a1204baf"],
  " ",
  Cell[BoxData["\"\<Lower\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "71fcba0d-8fa8-4038-8b16-57246113b1b5"]
 }], "InlineSubitem",ExpressionUUID->"f18fa5a2-b858-4cf4-8bcf-34cf3d656649"],
 "\n4. if a given endpoint contributes two spinors with the same ",
 Cell[BoxData[
  TemplateBox[{
    Cell["Multiparticle[...]", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "3cb7746a-81aa-406a-b868-04d04ca20e8f"],
 " then use two indices for that propagator and symmetrize\n\nSo the logic \
has to be based on the actual internal edge, not just the local vertex \
expression.\n\nHere is a corrected version. \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "\t  ", 
          
          RowBox[{"spinIndexSymbolsForEdge", ",", "\[IndentingNewLine]", 
            "\t  ", "spinorVarianceAtEndpoint", ",", "\[IndentingNewLine]", 
            "\t  ", "symmetrizeIndices", ",", "\[IndentingNewLine]", "\t  ", 
            "makeVertexSpinIndicesExplicit", ",", "\[IndentingNewLine]", 
            "\t  ", "makeDiagramSpinIndicesExplicit"}], "\[IndentingNewLine]",
           "\t", "]"}], "\[IndentingNewLine]", "\t", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"spinIndexSymbolsForEdge", "[", 
            RowBox[{"edge_", ",", "multiplicity_Integer"}], "]"}], ":=", 
          "\[IndentingNewLine]", "\t  ", 
          RowBox[{"Array", "[", 
            RowBox[{
              RowBox[{
                RowBox[{"Symbol", "[", 
                  RowBox[{"\"i\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "#", "]"}]}], "]"}], " ", "&"}], 
              ",", "multiplicity"}], "]"}]}], "\[IndentingNewLine]", "\t", 
        "\[IndentingNewLine]", 
        RowBox[{
          
          RowBox[{"spinorVarianceAtEndpoint", "[", "\[IndentingNewLine]", 
            "\t  ", 
            
            RowBox[{"vertex_", ",", "\[IndentingNewLine]", "\t  ", "edge_", 
              ",", "\[IndentingNewLine]", "\t  ", 
              "internalEdgeLabels_Association", ",", "\[IndentingNewLine]", 
              "\t  ", "antiParticleRules_Association"}], 
            "\[IndentingNewLine]", "\t", "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", 
                
                RowBox[{
                 "endpointParticle", ",", "oppositeVertex", ",", 
                  "oppositeParticle"}], "}"}], ",", "\[IndentingNewLine]", 
              "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"endpointParticle", "=", 
                  RowBox[{
                    RowBox[{"internalEdgeLabels", "[", "edge", "]"}], "[", 
                    "vertex", "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"oppositeVertex", "=", 
                  RowBox[{"SelectFirst", "[", 
                    RowBox[{
                    RowBox[{"List", " ", "@@", " ", "edge"}], ",", 
                    RowBox[{
                    RowBox[{"#", "=!=", "vertex"}], " ", "&"}]}], "]"}]}], 
                ";", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"oppositeParticle", "=", 
                  RowBox[{
                    RowBox[{"internalEdgeLabels", "[", "edge", "]"}], "[", 
                    "oppositeVertex", "]"}]}], ";", "\[IndentingNewLine]", 
                "\t  ", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{"antiParticleRules", ",", "endpointParticle", ",", 
                    RowBox[{"Missing", "[", "\"NotFound\"", "]"}]}], "]"}], 
                    "===", "oppositeParticle"}], ",", "\[IndentingNewLine]", 
                    "\t    ", "\"Upper\"", ",", "\[IndentingNewLine]", 
                    "\t    ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{"antiParticleRules", ",", "oppositeParticle", ",", 
                    RowBox[{"Missing", "[", "\"NotFound\"", "]"}]}], "]"}], 
                    "===", "endpointParticle"}], ",", "\[IndentingNewLine]", 
                    "\t      ", "\"Lower\"", ",", "\[IndentingNewLine]", 
                    "\t      ", "\"Upper\""}], "\[IndentingNewLine]", 
                    "\t    ", "]"}]}], "\[IndentingNewLine]", "\t  ", 
                  "]"}]}]}], "\[IndentingNewLine]", "\t", "]"}]}], 
        "\[IndentingNewLine]", "\t", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"symmetrizeIndices", "[", 
            RowBox[{"expr_", ",", "inds_List"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", "perms", "}"}], ",", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"perms", "=", 
                  RowBox[{"Permutations", "[", "inds", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", 
                RowBox[{
                  RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"expr", " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"inds", "->", "#"}], "]"}]}], ")"}], " ", "&"}], 
                    " ", "/@", " ", "perms"}], "]"}], "/", 
                  RowBox[{"Length", "[", "perms", "]"}]}]}]}], 
            "\[IndentingNewLine]", "\t", "]"}]}], "\[IndentingNewLine]", "\t",
         "\[IndentingNewLine]", 
        RowBox[{
          
          RowBox[{"makeVertexSpinIndicesExplicit", "[", "\[IndentingNewLine]",
             "\t  ", 
            
            RowBox[{"vertexStructure_Association", ",", "\[IndentingNewLine]",
               "\t  ", "vertex_", ",", "\[IndentingNewLine]", "\t  ", "diag_",
               ",", "\[IndentingNewLine]", "\t  ", 
              "edgeIndexData_Association", ",", "\[IndentingNewLine]", "\t  ",
               "antiParticleRules_Association"}], "\[IndentingNewLine]", "\t",
             "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", "\t    ", 
                
                RowBox[{
                 "expr", ",", "incidentLegs", ",", "internalSpinorLegs", ",", 
                  "groupedByIndex", ",", "replacementRules", ",", 
                  "\[IndentingNewLine]", "\t    ", "symmetrizationGroups", 
                  ",", "newExpr"}], "\[IndentingNewLine]", "\t  ", "}"}], ",",
               "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"expr", "=", 
                  RowBox[{"vertexStructure", "[", "\"Expression\"", "]"}]}], 
                ";", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"incidentLegs", "=", 
                  RowBox[{
                    RowBox[{"diag", "[", "\"IncidentLegData\"", "]"}], "[", 
                    "vertex", "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
                "\[IndentingNewLine]", "\t  ", 
                RowBox[{"internalSpinorLegs", "=", 
                  RowBox[{"Cases", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"expr", ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"s", " ", ":", " ", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "sa_", ",", "mp_Multiparticle"}],
                     "]"}]}], ":>", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{"\"Spinor\"", "->", "s"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"\"SpinType\"", "->", "sa"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"\"IndexLabel\"", "->", "mp"}]}], 
                    "\[IndentingNewLine]", "\t    ", "|>"}]}], ",", 
                    "\[IndentingNewLine]", "\t    ", "Infinity"}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{"internalSpinorLegs", "===", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"Return", "[", "vertexStructure", "]"}]}], "]"}], 
                ";", "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", 
                "\t  ", 
                RowBox[{"groupedByIndex", "=", 
                  RowBox[{"GroupBy", "[", "\[IndentingNewLine]", "\t    ", 
                    
                    RowBox[{
                    "internalSpinorLegs", ",", "\[IndentingNewLine]", 
                    "\t    ", 
                    RowBox[{"Function", "[", 
                    RowBox[{"item", ",", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    
                    RowBox[{"SelectFirst", "[", "\[IndentingNewLine]", 
                    "\t        ", 
                    
                    RowBox[{"incidentLegs", ",", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"Kind\"", "]"}], "===", 
                    "\"Internal\""}], "&&", 
                    RowBox[{
                    RowBox[{"#", "[", "\"Index\"", "]"}], "===", 
                    RowBox[{"item", "[", "\"IndexLabel\"", "]"}]}]}], " ", 
                    "&"}]}], "\[IndentingNewLine]", "\t      ", "]"}], "[", 
                    "\"Source\"", "]"}]}], "\[IndentingNewLine]", "\t    ", 
                    "]"}]}], "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"replacementRules", "=", 
                  RowBox[{"Flatten", " ", "@", " ", 
                    
                    RowBox[{
                    "KeyValueMap", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"edge", ",", "spinorsForEdge"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    
                    RowBox[{"Module", "[", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"inds", ",", "variance", ",", "vertexLocal", ",", 
                    "orderedSpinors"}], "}"}], ",", "\[IndentingNewLine]", 
                    "\t        ", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"vertexLocal", "=", "vertex"}], ";", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"variance", "=", 
                    
                    RowBox[{"spinorVarianceAtEndpoint", "[", 
                    "\[IndentingNewLine]", "\t          ", 
                    
                    RowBox[{"vertexLocal", ",", "\[IndentingNewLine]", 
                    "\t          ", "edge", ",", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{"diag", "[", "\"InternalEdgeLabels\"", "]"}], ",",
                     "\[IndentingNewLine]", "\t          ", 
                    "antiParticleRules"}], "\[IndentingNewLine]", 
                    "\t        ", "]"}]}], ";", "\[IndentingNewLine]", 
                    "\t        ", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"inds", "=", 
                    RowBox[{"edgeIndexData", "[", "edge", "]"}]}], ";", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"orderedSpinors", "=", "spinorsForEdge"}], ";", 
                    "\[IndentingNewLine]", "\t        ", 
                    "\[IndentingNewLine]", "\t        ", 
                    
                    RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#1", "[", "\"Spinor\"", "]"}], ":>", 
                    "\[IndentingNewLine]", "\t            ", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "variance", ",", 
                    RowBox[{"#1", "[", "\"SpinType\"", "]"}], ",", 
                    RowBox[{"#1", "[", "\"IndexLabel\"", "]"}], ",", "#2"}], 
                    "]"}]}], ")"}], " ", "&"}], ",", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{"{", 
                    RowBox[{"orderedSpinors", ",", "inds"}], "}"}]}], 
                    "\[IndentingNewLine]", "\t        ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", "groupedByIndex"}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"newExpr", "=", 
                  RowBox[{"expr", " ", "/.", " ", "replacementRules"}]}], ";",
                 "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"symmetrizationGroups", "=", 
                  RowBox[{"Select", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Normal", "[", "groupedByIndex", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"Last", "[", "#", "]"}], "]"}], ">", "1"}], " ", 
                    "&"}]}], "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"newExpr", "=", 
                  RowBox[{"Fold", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"currentExpr", ",", "group"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"edge", ",", "inds"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"edge", "=", 
                    RowBox[{"First", "[", "group", "]"}]}], ";", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"inds", "=", 
                    RowBox[{"edgeIndexData", "[", "edge", "]"}]}], ";", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"symmetrizeIndices", "[", 
                    RowBox[{"currentExpr", ",", "inds"}], "]"}]}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", "newExpr", ",", 
                    "\[IndentingNewLine]", "\t    ", "symmetrizationGroups"}],
                     "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"Join", "[", 
                  RowBox[{"vertexStructure", ",", 
                    RowBox[{"<|", 
                    RowBox[{"\"Expression\"", "->", "newExpr"}], "|>"}]}], 
                  "]"}]}]}], "\[IndentingNewLine]", "\t", "]"}]}], 
        "\[IndentingNewLine]", "\t", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"makeDiagramSpinIndicesExplicit", "[", 
            RowBox[{"diag_", ",", "antiParticleRules_Association"}], "]"}], 
          ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", 
                
                RowBox[{
                 "internalEdges", ",", "multiplicities", ",", "edgeIndexData",
                   ",", "newVertexStructures"}], "}"}], ",", 
              "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"internalEdges", "=", 
                  RowBox[{"Keys", "[", 
                    RowBox[{"diag", "[", "\"InternalEdgeLabels\"", "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
                "\[IndentingNewLine]", "\t  ", 
                RowBox[{"multiplicities", "=", 
                  RowBox[{"Association", " ", "@", " ", 
                    
                    RowBox[{
                    "KeyValueMap", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"vertex", ",", "structures"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"Sequence", " ", "@@", " ", 
                    RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "\t    ", 
                    "]"}], ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}]}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"multiplicities", "=", 
                  
                  RowBox[{
                   "AssociationMap", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"edge", ",", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"Max", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"1", ",", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"Sequence", " ", "@@", " ", 
                    RowBox[{"Flatten", " ", "@", " ", 
                    
                    RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"vertex", ",", "structures"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t            ", 
                    
                    RowBox[{"Cases", "[", "\[IndentingNewLine]", 
                    "\t              ", 
                    
                    RowBox[{"structures", ",", "\[IndentingNewLine]", 
                    "\t              ", 
                    RowBox[{"vs_Association", ":>", 
                    
                    RowBox[{"Count", "[", "\[IndentingNewLine]", 
                    "\t                ", 
                    RowBox[{
                    
                    RowBox[{"Cases", "[", "\[IndentingNewLine]", 
                    "\t                  ", 
                    RowBox[{
                    RowBox[{"vs", "[", "\"Expression\"", "]"}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "_", ",", "mp_"}], "]"}], " ", 
                    "/;", " ", 
                    RowBox[{"mp", "===", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"diag", "[", "\"InternalEdgeIndices\"", "]"}], 
                    "[", "edge", "]"}], "[", "vertex", "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    "Infinity"}], "\[IndentingNewLine]", "\t                ",
                     "]"}], ",", "\[IndentingNewLine]", "\t                ", 
                    "_"}], "\[IndentingNewLine]", "\t              ", 
                    "]"}]}]}], "\[IndentingNewLine]", "\t            ", 
                    "]"}]}], "\[IndentingNewLine]", "\t          ", "]"}], 
                    ",", "\[IndentingNewLine]", "\t          ", 
                    
                    RowBox[{"Select", "[", "\[IndentingNewLine]", 
                    "\t            ", 
                    RowBox[{
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}], ",", 
                    "\[IndentingNewLine]", "\t            ", 
                    RowBox[{
                    RowBox[{"KeyMemberQ", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"diag", "[", "\"InternalEdgeIndices\"", "]"}], 
                    "[", "edge", "]"}], ",", "#"}], "]"}], " ", "&"}]}], 
                    "\[IndentingNewLine]", "\t          ", "]"}]}], 
                    "\[IndentingNewLine]", "\t        ", "]"}]}]}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", "internalEdges"}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"edgeIndexData", "=", 
                  RowBox[{"Association", " ", "@", " ", 
                    
                    RowBox[{
                    "MapIndexed", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"edge", ",", "k"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"edge", "->", 
                    RowBox[{"Array", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Symbol", "[", 
