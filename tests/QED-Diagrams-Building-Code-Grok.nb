Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"2", " ", 
    SqrtBox["2"], " ", 
    SuperscriptBox["EE", "3"], " ", 
    TemplateBox[{
      TemplateBox[{"\"\[LeftAngleBracket]\"", 
        StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"], 
      TemplateBox[{
        SubscriptBox[
         StyleBox[
          SubscriptBox["\"P\"", 
           RowBox[{"2", ",", "4", ",", "5"}]], Bold, StripOnInput -> False], 
         "i1"], "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"], " ", 
    TemplateBox[{
      TemplateBox[{"\"\[LeftAngleBracket]\"", 
        SubscriptBox[
         StyleBox[
          SubscriptBox["\"P\"", 
           RowBox[{"1", ",", "3"}]], Bold, StripOnInput -> False], "i1"]}, 
       "RowDefault"], 
      TemplateBox[{
        SubscriptBox[
         StyleBox[
          SubscriptBox["\"P\"", 
           RowBox[{"2", ",", "5"}]], Bold, StripOnInput -> False], "i2"], 
        "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"], " ", 
    TemplateBox[{
      TemplateBox[{"\"\[LeftAngleBracket]\"", 
        SubscriptBox[
         StyleBox[
          SubscriptBox["\"P\"", 
           RowBox[{"1", ",", "3", ",", "4"}]], Bold, StripOnInput -> False], 
         "i1"]}, "RowDefault"], 
      TemplateBox[{
        StyleBox["2", Bold, StripOnInput -> False], 
        "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"], " ", 
    SubscriptBox["\<\"x\"\>", "\<\"1,245\"\>"], " ", 
