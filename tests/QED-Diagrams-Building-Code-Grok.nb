              "\t        ", "\[IndentingNewLine]", "\t        ", 
              RowBox[{
               RowBox[{"vertexLocal", "=", "vertex"}], ";", 
               "\[IndentingNewLine]", "\t        ", 
               RowBox[{"variance", "=", 
                RowBox[{
                "spinorVarianceAtEndpoint", "[", "\[IndentingNewLine]", 
                 "\t          ", 
                 RowBox[{
                 "vertexLocal", ",", "\[IndentingNewLine]", "\t          ", 
                  "edge", ",", "\[IndentingNewLine]", "\t          ", 
                  RowBox[{"diag", "[", "\"\<InternalEdgeLabels\>\"", "]"}], ",",
                   "\[IndentingNewLine]", "\t          ", 
                  "antiParticleRules"}], "\[IndentingNewLine]", "\t        ", 
                 "]"}]}], ";", "\[IndentingNewLine]", "\t        ", 
               "\[IndentingNewLine]", "\t        ", 
               RowBox[{"inds", "=", 
                RowBox[{"edgeIndexData", "[", "edge", "]"}]}], ";", 
               "\[IndentingNewLine]", "\t        ", 
               RowBox[{"orderedSpinors", "=", "spinorsForEdge"}], ";", 
               "\[IndentingNewLine]", "\t        ", "\[IndentingNewLine]", 
               "\t        ", 
               RowBox[{
               "MapThread", "[", "\[IndentingNewLine]", "\t          ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"#1", "[", "\"\<Spinor\>\"", "]"}], ":>", 
                    "\[IndentingNewLine]", "\t            ", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"\<Spin\>\"", ",", "variance", ",", 
                    RowBox[{"#1", "[", "\"\<SpinType\>\"", "]"}], ",", 
                    RowBox[{"#1", "[", "\"\<IndexLabel\>\"", "]"}], ",", 
                    "#2"}], "]"}]}], ")"}], " ", "&"}], ",", 
                 "\[IndentingNewLine]", "\t          ", 
                 RowBox[{"{", 
                  RowBox[{"orderedSpinors", ",", "inds"}], "}"}]}], 
                "\[IndentingNewLine]", "\t        ", "]"}]}]}], 
             "\[IndentingNewLine]", "\t      ", "]"}]}], 
           "\[IndentingNewLine]", "\t    ", "]"}], ",", "\[IndentingNewLine]",
           "\t    ", "groupedByIndex"}], "\[IndentingNewLine]", "\t  ", 
         "]"}]}]}], ";", "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]",
       "\t  ", 
      RowBox[{"newExpr", "=", 
       RowBox[{"expr", " ", "/.", " ", "replacementRules"}]}], ";", 
      "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
      RowBox[{"symmetrizationGroups", "=", 
       RowBox[{"Select", "[", "\[IndentingNewLine]", "\t    ", 
        RowBox[{
         RowBox[{"Normal", "[", "groupedByIndex", "]"}], ",", 
         "\[IndentingNewLine]", "\t    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Last", "[", "#", "]"}], "]"}], ">", "1"}], " ", "&"}]}], 
        "\[IndentingNewLine]", "\t  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "\t  ", "\[IndentingNewLine]", "\t  ", 
      RowBox[{"newExpr", "=", 
       RowBox[{"Fold", "[", "\[IndentingNewLine]", "\t    ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"currentExpr", ",", "group"}], "}"}], ",", 
           "\[IndentingNewLine]", "\t      ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"edge", ",", "inds"}], "}"}], ",", 
             "\[IndentingNewLine]", "\t        ", 
             RowBox[{
              RowBox[{"edge", "=", 
               RowBox[{"First", "[", "group", "]"}]}], ";", 
              "\[IndentingNewLine]", "\t        ", 
              RowBox[{"inds", "=", 
               RowBox[{"edgeIndexData", "[", "edge", "]"}]}], ";", 
              "\[IndentingNewLine]", "\t        ", 
              RowBox[{"symmetrizeIndices", "[", 
