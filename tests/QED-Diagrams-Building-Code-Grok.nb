                    "\[IndentingNewLine]", "\t        ", "]"}], " ", "&"}], 
                    ",", "\[IndentingNewLine]", "\t        ", "structures"}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}]}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"Join", "[", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{"diag", ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t      ", 
