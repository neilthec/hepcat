Cell[CellGroupData[{

Cell["\<\
I don't know what you mean by a list of candidates for the vertex expression. \
  There is only ever one expression.  So, just assume the last if there is \
more than one.\
\>", "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellLabel->
  "In[294]:=",ExpressionUUID->"6bfa4b5f-89ad-42e6-905a-3909e7cf3a86"],

Cell[TextData[{
 "Got it \[LongDash] then we should take exactly one vertex expression per \
internal vertex, and if a list somehow has more than one entry, use the last \
one. \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
          RowBox[{
            RowBox[{"{", 
              RowBox[{"vertexFactors", ",", "propagatorFactors"}], "}"}], ",",
             "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"vertexFactors", "=", 
                RowBox[{"Replace", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}], "]"}],
                     ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"{", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", "1"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"list_List", ":>", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", "\"Expression\"",
                     ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", "    ", 
                    "}"}], ",", "\[IndentingNewLine]", "    ", "1"}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{"propagatorFactors", "=", 
                RowBox[{"Lookup", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"diag", "[", "\"Propagators\"", "]"}], "]"}], ",",
                     "\[IndentingNewLine]", "    ", "\"Factor\"", ",", 
                    "\[IndentingNewLine]", "    ", "1"}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"Times", " ", "@@", " ", 
                  RowBox[{"Join", "[", 
                    RowBox[{"vertexFactors", ",", "propagatorFactors"}], 
                    "]"}]}], "/", "I"}]}]}], "\[IndentingNewLine]", "]"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "19dd0fdd-6f32-4ab5-bd29-80d00b90f162"],
 "\nIf you want a version that also simplifies the result, use: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
          RowBox[{
            RowBox[{"{", 
              RowBox[{"vertexFactors", ",", "propagatorFactors"}], "}"}], ",",
             "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"vertexFactors", "=", 
                RowBox[{"Replace", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}], "]"}],
                     ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"{", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", "1"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"list_List", ":>", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", "\"Expression\"",
                     ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", "    ", 
                    "}"}], ",", "\[IndentingNewLine]", "    ", "1"}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{"propagatorFactors", "=", 
                RowBox[{"Lookup", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"diag", "[", "\"Propagators\"", "]"}], "]"}], ",",
                     "\[IndentingNewLine]", "    ", "\"Factor\"", ",", 
                    "\[IndentingNewLine]", "    ", "1"}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{"Simplify", "[", 
                RowBox[{
                  RowBox[{"Times", " ", "@@", " ", 
                    RowBox[{"Join", "[", 
                    RowBox[{"vertexFactors", ",", "propagatorFactors"}], 
                    "]"}]}], "/", "I"}], "]"}]}]}], "\[IndentingNewLine]", 
          "]"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "272415b5-c2ed-48fd-a817-be01fc83d9dd"],
 "\nAnd for a list of diagrams: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"diagramAmplitudes", "[", "diags_List", "]"}], ":=", 
        RowBox[{"diagramAmplitude", " ", "/@", " ", "diags"}]}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "84683454-17ec-45ac-ad48-a12d707eb9d9"],
 "\nSo the total amplitude for all diagrams would be: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"Total", "[", 
        RowBox[{"diagramAmplitude", " ", "/@", " ", "diags"}], "]"}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "63c84d91-cc5d-418c-a485-ddfc8d70432d"],
 "\nA likely next improvement is to control the ordering of factors, e.g. \
vertices first and propagators after, or ordered by internal momentum index."
}], "ChatOutput",
 TaggingRules-><|
  "CellToStringData" -> 
   "Got it \[LongDash] then we should take exactly one vertex expression per \
internal vertex, and if a list somehow has more than one entry, use the last \
one.\n\n```wl\ndiagramAmplitude[diag_] := Module[\n  {vertexFactors, \
propagatorFactors},\n  \n  vertexFactors = Replace[\n    \
Values[diag[\"VertexStructures\"]],\n    {\n      {} :> 1,\n      list_List \
:> Lookup[Last[list], \"Expression\", 1]\n    },\n    1\n  ];\n  \n  \
propagatorFactors = Lookup[\n    Values[diag[\"Propagators\"]],\n    \"Factor\
\",\n    1\n  ];\n  \n  Times @@ Join[vertexFactors, propagatorFactors] / I\n\
]\n```\n\nIf you want a version that also simplifies the result, use:\n\n\
```wl\ndiagramAmplitude[diag_] := Module[\n  {vertexFactors, \
propagatorFactors},\n  \n  vertexFactors = Replace[\n    \
Values[diag[\"VertexStructures\"]],\n    {\n      {} :> 1,\n      list_List \
:> Lookup[Last[list], \"Expression\", 1]\n    },\n    1\n  ];\n  \n  \
propagatorFactors = Lookup[\n    Values[diag[\"Propagators\"]],\n    \"Factor\
\",\n    1\n  ];\n  \n  Simplify[Times @@ Join[vertexFactors, \
propagatorFactors] / I]\n]\n```\n\nAnd for a list of diagrams:\n\n```wl\n\
diagramAmplitudes[diags_List] := diagramAmplitude /@ diags\n```\n\nSo the \
total amplitude for all diagrams would be:\n\n```wl\nTotal[diagramAmplitude \
/@ diags]\n```\n\nA likely next improvement is to control the ordering of \
factors, e.g. vertices first and propagators after, or ordered by internal \
momentum index.", "ChatData" -> 
