Cell[BoxData[
 RowBox[{
  RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vertexFactors", ",", "propagatorFactors"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"vertexFactors", "=", 
      RowBox[{"Replace", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Values", "[", 
         RowBox[{"diag", "[", "\"\<VertexStructures\>\"", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "}"}], ":>", "1"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"list_List", ":>", 
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"Last", "[", "list", "]"}], ",", "\"\<Expression\>\"", ",",
              "1"}], "]"}]}]}], "\[IndentingNewLine]", "    ", "}"}], ",", 
        "\[IndentingNewLine]", "    ", "1"}], "\[IndentingNewLine]", "  ", 
       "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"propagatorFactors", "=", 
      RowBox[{"Lookup", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Values", "[", 
         RowBox[{"diag", "[", "\"\<Propagators\>\"", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", "\"\<Factor\>\"", ",", 
        "\[IndentingNewLine]", "    ", "1"}], "\[IndentingNewLine]", "  ", 
       "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Times", " ", "@@", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"vertexFactors", ",", "propagatorFactors"}], "]"}]}], "/", 
      "I"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellTags->"ChatGeneratedCell",
 CellLabel->
  "In[295]:=",ExpressionUUID->"7017825d-837f-476c-9c4c-d5daf0dbb53f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"diagramAmplitude", "[", 
  RowBox[{"diags", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.997367152113697*^9, 3.997367156613968*^9}},
 CellLabel->
  "In[296]:=",ExpressionUUID->"6d03dd8b-c69f-4bb1-8a6d-6b36d789f91c"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"2", " ", 
    SqrtBox["2"], " ", 
    SuperscriptBox["EE", "3"], " ", 
    TemplateBox[{
      TemplateBox[{"\"\[LeftAngleBracket]\"", 
        StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"], 
      TemplateBox[{
        StyleBox[
         SubscriptBox["\"P\"", 
          RowBox[{"2", ",", "4", ",", "5"}]], Bold, StripOnInput -> False], 
        "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"], " ", 
    TemplateBox[{
      TemplateBox[{"\"\[LeftAngleBracket]\"", 
        StyleBox[
         SubscriptBox["\"P\"", 
          RowBox[{"1", ",", "3"}]], Bold, StripOnInput -> False]}, 
       "RowDefault"], 
      TemplateBox[{
        StyleBox[
         SubscriptBox["\"P\"", 
          RowBox[{"2", ",", "5"}]], Bold, StripOnInput -> False], 
        "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"], " ", 
    TemplateBox[{
      TemplateBox[{"\"\[LeftAngleBracket]\"", 
        StyleBox[
         SubscriptBox["\"P\"", 
          RowBox[{"1", ",", "3", ",", "4"}]], Bold, StripOnInput -> False]}, 
       "RowDefault"], 
      TemplateBox[{
        StyleBox["2", Bold, StripOnInput -> False], 
        "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"], " ", 
    SubscriptBox["\<\"x\"\>", "\<\"1,245\"\>"], " ", 
    SubscriptBox["\<\"x\"\>", "\<\"13,25\"\>"], " ", 
    SubscriptBox["\<\"x\"\>", "\<\"134,2\"\>"]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["Me", "2"]}], "+", 
      SubsuperscriptBox["p", 
       RowBox[{"2", ",", "5"}], "2"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["Me", "2"]}], "+", 
      SubsuperscriptBox["p", 
       RowBox[{"2", ",", "4", ",", "5"}], "2"]}], ")"}]}]]}]], "Output",
 CellChangeTimes->{3.997367156925873*^9},
 CellLabel->
  "Out[296]=",ExpressionUUID->"2693347e-4094-4428-82b5-3d774ae6a22b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
That is a great first step.  Next, for each vertex that has a spinor with a \
\"Spin\" for the first argument and Multiparticle in the last index, we must \
make the indices explicit.  So, we begin with something like Spinor[\"Spin\", \
sa, Multiparticle[...]], where sa is either \"Square\" or \"Angle\".  If this \
is the particle end of the propagator, we replace this with \
Spinor[\"Spin\",\"Upper\",sa, Multiparticle[...],i1].  If it is an \
antiparticle end of the propagator then you replace it with \
Spinor[\"Spin\",\"Lower\",sa, Multiparticle[...],i1].  However, if there are \
multiple spinors with Multiparticle, then we need to use a different index \
for each one.  So, i1 for the first, i2 for the second, and so on.  Fioally, \
if this particle is massive spin 1, there will be two spinors with the same \
Multiparticle.  In this case, you need to symmetrize the expression between \
the two indices i1 and i2 or whate3ver .expression\
\>", "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellLabel->
  "In[299]:=",ExpressionUUID->"93a15a25-ae10-4db9-9323-97759e9e6727"],

Cell[TextData[{
 "Yes \[LongDash] the right way to do this is as a post-processing step on \
each vertex expression.\n\nThe key ingredients are:\n\n1. find every ",
 Cell[BoxData[
  TemplateBox[{
    Cell["Spinor[\"Spin\", sa_, Multiparticle[...]]", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "72269776-0388-40a3-9fd2-7da4df1cc150"],
 "\n2. determine whether that internal leg is a particle end or antiparticle \
end\n3. replace it by either \n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["Spinor[\"Spin\", \"Upper\", sa, mp, i1]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "6e909548-6401-497d-b0d2-e2431176d1c4"],
  " or"
 }], "InlineSubitem",ExpressionUUID->"e583d295-0f3b-4f99-a8e7-c860cb02988a"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["Spinor[\"Spin\", \"Lower\", sa, mp, i1]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "fc4a657f-ec67-4b76-9e58-13cb31c33dc7"]
 }], "InlineSubitem",ExpressionUUID->"5b21dc33-c25c-4dd6-bf8e-59fafd62370d"],
 "\n4. assign fresh indices ",
 Cell[BoxData[
  TemplateBox[{
    Cell["i1", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "965267f3-45c8-456c-b49c-77bd75af4026"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell["i2", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "160747af-bf35-4f35-ad67-503582c6022d"],
 ", ...\n5. if the same ",
 Cell[BoxData[
  TemplateBox[{
    Cell["Multiparticle[...]", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "45aaa4a2-7e49-451b-be74-479affa0a429"],
 " appears twice in the same vertex expression, symmetrize in the \
corresponding pair of indices\n\nSince your diagram data already contains: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["diag[\"IncidentLegData\"]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "74c8aca6-9879-4428-b1cb-8a7b7bfcda96"],
  " for each vertex"
 }], "InlineItem",ExpressionUUID->"15ef7de0-e618-4f54-9c68-f759d1e2c252"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["diag[\"VertexStructures\"]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "adf7ce67-4554-4907-80b7-e9a5609fbdf6"],
  " for each vertex"
 }], "InlineItem",ExpressionUUID->"60486b64-8e81-4f46-bc04-394e0f652958"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["diag[\"InternalEdgeLabels\"]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "a3f54e42-3779-4e33-8cdc-a279390ff5ed"],
  " and propagator orientation information"
 }], "InlineItem",ExpressionUUID->"9f20378a-c06a-4ba3-b5ce-144d4cf3e74a"],
 "\nwe can do this vertex-by-vertex.\n\nHere is a first implementation: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
          
          RowBox[{"spinorVarianceForLeg", ",", "\[IndentingNewLine]", "  ", 
            "symmetrizeIndexPair", ",", "\[IndentingNewLine]", "  ", 
            "makeVertexSpinIndicesExplicit", ",", "\[IndentingNewLine]", "  ",
             "makeDiagramSpinIndicesExplicit"}], "\[IndentingNewLine]", "]"}],
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"spinorVarianceForLeg", "[", 
            
            RowBox[{"leg_Association", ",", 
              "internalEdgeLabels_Association"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", 
                
                RowBox[{
                 "source", ",", "particle", ",", "edge", ",", 
                  "endpointLabels", ",", "oppositeParticle"}], "}"}], ",", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"leg", "[", "\"Kind\"", "]"}], "===", 
                    "\"External\""}], ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"Missing", "[", "\"NotInternal\"", "]"}], "]"}]}],
                   "]"}], ";", "\[IndentingNewLine]", "  ", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"source", "=", 
                  RowBox[{"leg", "[", "\"Source\"", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"particle", "=", 
                  RowBox[{"leg", "[", "\"Particle\"", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"edge", "=", "source"}], ";", "\[IndentingNewLine]", 
                "  ", 
                RowBox[{"endpointLabels", "=", 
                  RowBox[{"internalEdgeLabels", "[", "edge", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"oppositeParticle", "=", 
                  RowBox[{"DeleteCases", "[", 
                    RowBox[{
                    RowBox[{"Values", "[", "endpointLabels", "]"}], ",", 
                    "particle"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{"oppositeParticle", "===", 
                    RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "    ", 
                    "\"Upper\"", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"First", "[", "oppositeParticle", "]"}], "===", 
                    "particle"}], ",", "\"Upper\"", ",", "\"Lower\""}], 
                    "]"}]}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
            "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"symmetrizeIndexPair", "[", 
            RowBox[{"expr_", ",", 
              RowBox[{"{", 
                RowBox[{"idx1_", ",", "idx2_"}], "}"}]}], "]"}], ":=", 
          RowBox[{
            RowBox[{"(", 
              RowBox[{"expr", "+", 
                RowBox[{"(", 
                  RowBox[{"expr", " ", "/.", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"idx1", "->", "idx2"}], ",", 
                    RowBox[{"idx2", "->", "idx1"}]}], "}"}]}], ")"}]}], ")"}],
             "/", "2"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          
          RowBox[{"makeVertexSpinIndicesExplicit", "[", "\[IndentingNewLine]",
             "  ", 
            
            RowBox[{"vertexStructure_Association", ",", "\[IndentingNewLine]",
               "  ", "incidentLegs_List", ",", "\[IndentingNewLine]", "  ", 
              "internalEdgeLabels_Association"}], "\[IndentingNewLine]", 
            "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", "    ", 
                
                RowBox[{
                 "expr", ",", "\[IndentingNewLine]", "    ", "spinorMatches", 
                  ",", "\[IndentingNewLine]", "    ", "replacements", ",", 
                  "\[IndentingNewLine]", "    ", "indexedData", ",", 
                  "\[IndentingNewLine]", "    ", "indexSymbols", ",", 
                  "\[IndentingNewLine]", "    ", "mpGroups", ",", 
                  "\[IndentingNewLine]", "    ", "symmetrizedExpr"}], 
                "\[IndentingNewLine]", "  ", "}"}], ",", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"expr", "=", 
                  RowBox[{"vertexStructure", "[", "\"Expression\"", "]"}]}], 
                ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"spinorMatches", "=", 
                  RowBox[{"Cases", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{"expr", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"s", " ", ":", " ", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "sa_", ",", "mp_Multiparticle"}],
                     "]"}]}], ":>", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"\"Original\"", "->", "s"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"SpinType\"", "->", "sa"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Multiparticle\"", "->", "mp"}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
                    "\[IndentingNewLine]", "    ", "Infinity"}], 
                    "\[IndentingNewLine]", "  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{"spinorMatches", "===", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"Return", "[", "vertexStructure", "]"}]}], "]"}], 
                ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"indexedData", "=", 
                  RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"match", ",", "k"}], "}"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    
                    RowBox[{
                    "Module", "[", "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"mp", ",", "matchingLeg", ",", "variance", ",", 
                    "idx"}], "}"}], ",", "\[IndentingNewLine]", "        ", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{"mp", "=", 
                    RowBox[{"match", "[", "\"Multiparticle\"", "]"}]}], ";", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{"matchingLeg", "=", 
                    
                    RowBox[{"SelectFirst", "[", "\[IndentingNewLine]", 
                    "          ", 
                    
                    RowBox[{"incidentLegs", ",", "\[IndentingNewLine]", 
                    "          ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"KeyExistsQ", "[", 
                    RowBox[{"#", ",", "\"Index\""}], "]"}], "&&", 
                    RowBox[{
                    RowBox[{"#", "[", "\"Index\"", "]"}], "===", "mp"}]}], 
                    " ", "&"}]}], "\[IndentingNewLine]", "        ", "]"}]}], 
                    ";", "\[IndentingNewLine]", "        ", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{"variance", "=", 
                    RowBox[{"If", "[", "\[IndentingNewLine]", "          ", 
                    RowBox[{
                    RowBox[{"AssociationQ", "[", "matchingLeg", "]"}], ",", 
                    "\[IndentingNewLine]", "          ", 
                    RowBox[{"spinorVarianceForLeg", "[", 
                    RowBox[{"matchingLeg", ",", "internalEdgeLabels"}], "]"}],
                     ",", "\[IndentingNewLine]", "          ", 
                    RowBox[{"Missing", "[", "\"VarianceNotFound\"", "]"}]}], 
                    "\[IndentingNewLine]", "        ", "]"}]}], ";", 
                    "\[IndentingNewLine]", "        ", "\[IndentingNewLine]", 
                    "        ", 
                    RowBox[{"idx", "=", 
                    RowBox[{"Symbol", "[", 
                    RowBox[{"\"i\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"First", "[", "k", "]"}], "]"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "        ", "\[IndentingNewLine]", 
                    "        ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "          ", 
                    RowBox[{
                    RowBox[{"\"Original\"", "->", 
                    RowBox[{"match", "[", "\"Original\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "          ", 
                    RowBox[{"\"Replacement\"", "->", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "variance", ",", 
                    RowBox[{"match", "[", "\"SpinType\"", "]"}], ",", "mp", 
                    ",", "idx"}], "]"}]}], ",", "\[IndentingNewLine]", 
                    "          ", 
                    RowBox[{"\"Multiparticle\"", "->", "mp"}], ",", 
                    "\[IndentingNewLine]", "          ", 
                    RowBox[{"\"Index\"", "->", "idx"}]}], 
                    "\[IndentingNewLine]", "        ", "|>"}]}]}], 
                    "\[IndentingNewLine]", "      ", "]"}]}], 
                    "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", "spinorMatches"}], 
                    "\[IndentingNewLine]", "  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"replacements", "=", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", "\"Original\"", "]"}], ":>", 
                    RowBox[{"#", "[", "\"Replacement\"", "]"}]}], ")"}], " ", 
                    "&"}], " ", "/@", " ", "indexedData"}]}], ";", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"symmetrizedExpr", "=", 
                  RowBox[{"expr", " ", "/.", " ", "replacements"}]}], ";", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"mpGroups", "=", 
                  RowBox[{"GatherBy", "[", 
                    RowBox[{"indexedData", ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"Multiparticle\"", "]"}], " ", 
                    "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"symmetrizedExpr", "=", 
                  RowBox[{"Fold", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"currentExpr", ",", "group"}], "}"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"If", "[", "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "group", "]"}], "==", "2"}], ",", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{"symmetrizeIndexPair", "[", 
                    RowBox[{"currentExpr", ",", 
                    RowBox[{"group", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"Index\""}], "]"}], "]"}]}], "]"}], 
                    ",", "\[IndentingNewLine]", "        ", "currentExpr"}], 
                    "\[IndentingNewLine]", "      ", "]"}]}], 
                    "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", "symmetrizedExpr", ",", 
                    "\[IndentingNewLine]", "    ", "mpGroups"}], 
                    "\[IndentingNewLine]", "  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"Join", "[", "\[IndentingNewLine]", "    ", 
                  
                  RowBox[{
                   "vertexStructure", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", 
                    RowBox[{"\"Expression\"", "->", "symmetrizedExpr"}], 
                    "|>"}]}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
            "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"makeDiagramSpinIndicesExplicit", "[", "diag_", "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", "newVertexStructures", "}"}], ",", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"newVertexStructures", "=", 
                  RowBox[{"Association", " ", "@", " ", 
                    RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"vertex", ",", "structures"}], "}"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"vertex", "->", 
                    RowBox[{"Map", "[", "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"vs", ",", "\[IndentingNewLine]", "          ", 
                    
                    RowBox[{"makeVertexSpinIndicesExplicit", "[", 
                    "\[IndentingNewLine]", "            ", 
                    
                    RowBox[{"vs", ",", "\[IndentingNewLine]", "            ", 
                    
                    RowBox[{
                    RowBox[{"diag", "[", "\"IncidentLegData\"", "]"}], "[", 
                    "vertex", "]"}], ",", "\[IndentingNewLine]", 
                    "            ", 
                    RowBox[{"diag", "[", "\"InternalEdgeLabels\"", "]"}]}], 
                    "\[IndentingNewLine]", "          ", "]"}]}], 
                    "\[IndentingNewLine]", "        ", "]"}], ",", 
                    "\[IndentingNewLine]", "        ", "structures"}], 
                    "\[IndentingNewLine]", "      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}]}], 
                    "\[IndentingNewLine]", "  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"Join", "[", 
                  RowBox[{"diag", ",", 
                    RowBox[{"<|", 
                    
                    RowBox[{
                    "\"VertexStructures\"", "->", "newVertexStructures"}], 
                    "|>"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "80018cbd-a1f6-4f97-87a6-aae4a4309ddd"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What this does\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9f7bfdf5-d598-4e16-bc3a-389d11ed9b3e"],
 "\nFor each vertex expression it: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "finds all factors of the form ",
  Cell[BoxData[
   TemplateBox[{
     Cell["Spinor[\"Spin\", sa_, Multiparticle[...]]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "29b94fd8-452d-48b6-b759-c7f679271586"]
 }], "InlineItem",ExpressionUUID->"8e6c8f99-2e4b-43de-a4eb-f2fd6bd48912"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "matches the ",
  Cell[BoxData[
   TemplateBox[{
     Cell["Multiparticle[...]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "2d0dab23-52d6-4954-8be7-f00f7fbd791a"],
  " against the corresponding internal leg in ",
  Cell[BoxData[
   TemplateBox[{
     Cell["IncidentLegData", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "0b1aa516-aab1-43e9-a980-fb12c19f4c64"]
 }], "InlineItem",ExpressionUUID->"1656aa85-5739-4399-9846-c9bd8749a45b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "checks whether that endpoint should be upper or lower"
 }], "InlineItem",ExpressionUUID->"a70cdafa-b7f8-4267-b792-893d0b027837"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "inserts explicit indices ",
  Cell[BoxData[
   TemplateBox[{
     Cell["i1", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "bec664bb-c061-4126-84f9-9ba56e6e05d1"],
  ", ",
  Cell[BoxData[
   TemplateBox[{
     Cell["i2", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "7fa5fa77-c42c-477d-8960-4e7cebed8b5f"],
  ", ..."
 }], "InlineItem",ExpressionUUID->"b45a9f49-8864-4085-9398-cd445f195f37"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "if the same ",
  Cell[BoxData[
   TemplateBox[{
     Cell["Multiparticle[...]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "d9d856a0-5ac1-4942-a572-2af65b7fb236"],
  " appears twice, symmetrizes over those two indices"
 }], "InlineItem",ExpressionUUID->"96fa324b-7a28-448d-93a6-bf103565cd60"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Important caveat\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"85f836f5-c201-4510-89b3-261c67e9b3e3"],
 "\nThis part: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"spinorVarianceForLeg", "[", 
        RowBox[{"leg_Association", ",", "internalEdgeLabels_Association"}], 
        "]"}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "d8a66cda-8d96-4093-85c6-e041030591c3"],
 "\nuses a simple heuristic based on whether the particle shown at that \
endpoint matches the edge labeling structure. Depending on how exactly your \
particle/antiparticle orientation is encoded in ",
 Cell[BoxData[
  TemplateBox[{
    Cell["diag[\"InternalEdgeLabels\"]", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "e3e4ad1b-7f3e-4fcc-a2d6-05e934fdac3a"],
 ", you may want to tighten this logic.\n\nIn particular, if your internal \
edge labels are of the form \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"<|", 
        RowBox[{
          RowBox[{"vertex1", "->", "\"e\""}], ",", 
          RowBox[{"vertex2", "->", "\"E\""}]}], "|>"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "98aa9b37-d131-439a-84a8-ed1194accd68"],
 "\nthen a robust rule is: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "endpoint labeled by particle ",
  StyleBox["p", "TI"],
  " gets ",
  Cell[BoxData["\"\<Upper\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "ccb5de1a-2918-4c2a-9bd4-8127e2ddbb0b"]
 }], "InlineItem",ExpressionUUID->"b01270f2-e6c5-4d62-a4b7-063a2322038f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "endpoint labeled by antiparticle ",
  StyleBox["ap", "TI"],
  " gets ",
  Cell[BoxData["\"\<Lower\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "81a860ed-7a82-4fe4-98ba-8c8ca72adac1"]
 }], "InlineItem",ExpressionUUID->"f30c598a-e025-49ab-a4fd-339da158cf7f"],
 "\nIf you want, I can rewrite that part to use your explicit antiparticle \
map so it is exact rather than heuristic. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Then update amplitude construction\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"882f617c-9c92-4e09-8c6d-10b1d1d049ca"],
 "\nAfter processing the diagram, \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"diag2", "=", 
            RowBox[{"makeDiagramSpinIndicesExplicit", "[", 
              RowBox[{"diags", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", 
        RowBox[{"diagramAmplitude", "[", "diag2", "]"}]}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "1eff78fb-153e-4cfa-854e-dfb6e1fe00a4"],
 "\nor automatically: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
          RowBox[{
            RowBox[{"{", 
              
              RowBox[{"processed", ",", "vertexFactors", ",", 
                "propagatorFactors"}], "}"}], ",", "\[IndentingNewLine]", 
            "  ", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"processed", "=", 
                
                RowBox[{
                 "makeDiagramSpinIndicesExplicit", "[", "diag", "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{"vertexFactors", "=", 
                RowBox[{"Replace", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"VertexStructures\"", "]"}], 
                    "]"}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"{", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", "1"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"list_List", ":>", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", "\"Expression\"",
                     ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", "    ", 
                    "}"}], ",", "\[IndentingNewLine]", "    ", "1"}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{"propagatorFactors", "=", 
                RowBox[{"Lookup", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"Propagators\"", "]"}], "]"}],
                     ",", "\[IndentingNewLine]", "    ", "\"Factor\"", ",", 
                    "\[IndentingNewLine]", "    ", "1"}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"Times", " ", "@@", " ", 
                  RowBox[{"Join", "[", 
                    RowBox[{"vertexFactors", ",", "propagatorFactors"}], 
                    "]"}]}], "/", "I"}]}]}], "\[IndentingNewLine]", "]"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "d945a311-eb3d-45f1-9797-60456f3d0c36"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"One likely adjustment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d186c52a-b763-406b-bb5b-36413959a835"],
 "\nRight now the fresh indices are generated separately inside each vertex, \
so each vertex starts again with ",
 Cell[BoxData[
  TemplateBox[{
    Cell["i1", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "45465fae-4262-4125-a904-bf3b32e6d11d"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell["i2", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "352826ed-60f3-4644-86c4-c9b4f3f02fa8"],
 ", etc. That is probably fine if they are local to a vertex expression, but \
if you want the full diagram amplitude to use globally unique spin indices, I \
can change it so the whole diagram uses: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "1", ",", 
         StyleBox["i", "TI"], "2", ",", 
         StyleBox["i", "TI"], "3", ",", "\[Ellipsis]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "i1, i2, i3, \\dots", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ac86754-90a4-4818-85ff-a2ebe948a5ae"],
 "\nacross all vertices consistently.\n\nIf you want, I can give you the next \
version that: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "uses your antiparticle rules explicitly,"
 }], "InlineItem",ExpressionUUID->"bb08226c-913e-4a7f-926e-a8e9d7ba46c5"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "assigns indices globally across the whole diagram,"
 }], "InlineItem",ExpressionUUID->"72807e34-95c2-4a4a-80a7-14b86f540aac"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and symmetrizes automatically for repeated massive spin-1 spinors."
 }], "InlineItem",ExpressionUUID->"0e736495-120d-4848-9bfe-1aff371dcce0"]
}], "ChatOutput",
 TaggingRules-><|
  "CellToStringData" -> 
   "Yes \[LongDash] the right way to do this is as a post-processing step on \
each vertex expression.\n\nThe key ingredients are:\n\n1. find every \
``Spinor[\"Spin\", sa_, Multiparticle[...]]``\n2. determine whether that \
internal leg is a particle end or antiparticle end\n3. replace it by either\n \
  * ``Spinor[\"Spin\", \"Upper\", sa, mp, i1]`` or\n   * ``Spinor[\"Spin\", \
\"Lower\", sa, mp, i1]``\n4. assign fresh indices ``i1``, ``i2``, ...\n5. if \
the same ``Multiparticle[...]`` appears twice in the same vertex expression, \
symmetrize in the corresponding pair of indices\n\nSince your diagram data \
already contains:\n\n* ``diag[\"IncidentLegData\"]`` for each vertex\n* \
``diag[\"VertexStructures\"]`` for each vertex\n* ``diag[\"InternalEdgeLabels\
\"]`` and propagator orientation information\n\nwe can do this \
vertex-by-vertex.\n\nHere is a first implementation:\n\n```wl\nClearAll[\n  \
spinorVarianceForLeg,\n  symmetrizeIndexPair,\n  \
makeVertexSpinIndicesExplicit,\n  makeDiagramSpinIndicesExplicit\n]\n\n\
spinorVarianceForLeg[leg_Association, internalEdgeLabels_Association] := \
Module[\n  {source, particle, edge, endpointLabels, oppositeParticle},\n  \n  \
If[leg[\"Kind\"] === \"External\", Return[Missing[\"NotInternal\"]]];\n  \n  \
source = leg[\"Source\"];\n  particle = leg[\"Particle\"];\n  edge = source;\n\
  endpointLabels = internalEdgeLabels[edge];\n  \n  oppositeParticle = \
DeleteCases[Values[endpointLabels], particle];\n  \n  If[oppositeParticle === \
{},\n    \"Upper\",\n    If[First[oppositeParticle] === particle, \"Upper\", \
\"Lower\"]\n  ]\n]\n\nsymmetrizeIndexPair[expr_, {idx1_, idx2_}] := (expr + \
(expr /. {idx1 -> idx2, idx2 -> idx1})) / 2\n\nmakeVertexSpinIndicesExplicit[\
\n  vertexStructure_Association,\n  incidentLegs_List,\n  \
internalEdgeLabels_Association\n] := Module[\n  {\n    expr,\n    \
spinorMatches,\n    replacements,\n    indexedData,\n    indexSymbols,\n    \
mpGroups,\n    symmetrizedExpr\n  },\n  \n  expr = \
vertexStructure[\"Expression\"];\n  \n  spinorMatches = Cases[\n    expr,\n   \
 s : Spinor[\"Spin\", sa_, mp_Multiparticle] :> <|\n      \"Original\" -> s,\n\
      \"SpinType\" -> sa,\n      \"Multiparticle\" -> mp\n    |>,\n    \
Infinity\n  ];\n  \n  If[spinorMatches === {}, Return[vertexStructure]];\n  \n\
  indexedData = MapIndexed[\n    Function[{match, k},\n      Module[\n        \
{mp, matchingLeg, variance, idx},\n        \n        mp = \
match[\"Multiparticle\"];\n        matchingLeg = SelectFirst[\n          \
incidentLegs,\n          KeyExistsQ[#, \"Index\"] && #[\"Index\"] === mp &\n  \
      ];\n        \n        variance = If[\n          \
AssociationQ[matchingLeg],\n          spinorVarianceForLeg[matchingLeg, \
internalEdgeLabels],\n          Missing[\"VarianceNotFound\"]\n        ];\n   \
     \n        idx = Symbol[\"i\" <> ToString[First[k]]];\n        \n        \
<|\n          \"Original\" -> match[\"Original\"],\n          \"Replacement\" \
-> Spinor[\"Spin\", variance, match[\"SpinType\"], mp, idx],\n          \
\"Multiparticle\" -> mp,\n          \"Index\" -> idx\n        |>\n      ]\n   \
 ],\n    spinorMatches\n  ];\n  \n  replacements = (#[\"Original\"] :> \
#[\"Replacement\"]) & /@ indexedData;\n  \n  symmetrizedExpr = expr /. \
replacements;\n  \n  mpGroups = GatherBy[indexedData, #[\"Multiparticle\"] \
&];\n  \n  symmetrizedExpr = Fold[\n    Function[{currentExpr, group},\n      \
If[\n        Length[group] == 2,\n        symmetrizeIndexPair[currentExpr, \
group[[All, \"Index\"]]],\n        currentExpr\n      ]\n    ],\n    \
symmetrizedExpr,\n    mpGroups\n  ];\n  \n  Join[\n    vertexStructure,\n    \
<|\"Expression\" -> symmetrizedExpr|>\n  ]\n]\n\n\
makeDiagramSpinIndicesExplicit[diag_] := Module[\n  {newVertexStructures},\n  \
\n  newVertexStructures = Association @ KeyValueMap[\n    Function[{vertex, \
structures},\n      vertex -> Map[\n        Function[vs,\n          \
makeVertexSpinIndicesExplicit[\n            vs,\n            \
diag[\"IncidentLegData\"][vertex],\n            diag[\"InternalEdgeLabels\"]\n\
          ]\n        ],\n        structures\n      ]\n    ],\n    \
diag[\"VertexStructures\"]\n  ];\n  \n  Join[diag, <|\"VertexStructures\" -> \
newVertexStructures|>]\n]\n```\n\n## What this does\n\nFor each vertex \
expression it:\n\n* finds all factors of the form ``Spinor[\"Spin\", sa_, \
Multiparticle[...]]``\n* matches the ``Multiparticle[...]`` against the \
corresponding internal leg in ``IncidentLegData``\n* checks whether that \
endpoint should be upper or lower\n* inserts explicit indices ``i1``, ``i2``, \
...\n* if the same ``Multiparticle[...]`` appears twice, symmetrizes over \
those two indices\n\n## Important caveat\n\nThis part:\n\n```wl\n\
spinorVarianceForLeg[leg_Association, internalEdgeLabels_Association]\n```\n\n\
uses a simple heuristic based on whether the particle shown at that endpoint \
matches the edge labeling structure. Depending on how exactly your \
particle/antiparticle orientation is encoded in \
``diag[\"InternalEdgeLabels\"]``, you may want to tighten this logic.\n\nIn \
particular, if your internal edge labels are of the form\n\n```wl\n<|vertex1 \
-> \"e\", vertex2 -> \"E\"|>\n```\n\nthen a robust rule is:\n\n* endpoint \
labeled by particle ``p`` gets ``\"Upper\"``\n* endpoint labeled by \
antiparticle ``ap`` gets ``\"Lower\"``\n\nIf you want, I can rewrite that \
part to use your explicit antiparticle map so it is exact rather than \
heuristic.\n\n## Then update amplitude construction\n\nAfter processing the \
diagram,\n\n```wl\ndiag2 = makeDiagramSpinIndicesExplicit[diags[[1]]];\n\
diagramAmplitude[diag2]\n```\n\nor automatically:\n\n```wl\n\
diagramAmplitude[diag_] := Module[\n  {processed, vertexFactors, \
propagatorFactors},\n  \n  processed = makeDiagramSpinIndicesExplicit[diag];\n\
  \n  vertexFactors = Replace[\n    Values[processed[\"VertexStructures\"]],\n\
    {\n      {} :> 1,\n      list_List :> Lookup[Last[list], \"Expression\", \
1]\n    },\n    1\n  ];\n  \n  propagatorFactors = Lookup[\n    \
Values[processed[\"Propagators\"]],\n    \"Factor\",\n    1\n  ];\n  \n  \
Times @@ Join[vertexFactors, propagatorFactors] / I\n]\n```\n\n## One likely \
adjustment\n\nRight now the fresh indices are generated separately inside \
each vertex, so each vertex starts again with ``i1``, ``i2``, etc. That is \
probably fine if they are local to a vertex expression, but if you want the \
full diagram amplitude to use globally unique spin indices, I can change it \
so the whole diagram uses:\n\n$$i1, i2, i3, \\dots$$\n\nacross all vertices \
consistently.\n\nIf you want, I can give you the next version that:\n\n* uses \
your antiparticle rules explicitly,\n* assigns indices globally across the \
whole diagram,\n* and symmetrizes automatically for repeated massive spin-1 \
spinors.", "ChatData" -> 
