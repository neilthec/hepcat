                    RowBox[{"Map", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"makeVertexSpinIndicesExplicit", "[", 
                    "\[IndentingNewLine]", "\t          ", 
                    
                    RowBox[{"#", ",", "\[IndentingNewLine]", "\t          ", 
                    "vertex", ",", "\[IndentingNewLine]", "\t          ", 
                    "diag", ",", "\[IndentingNewLine]", "\t          ", 
