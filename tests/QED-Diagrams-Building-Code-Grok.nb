 RowBox[{
  RowBox[{
   RowBox[{"spinorVarianceAtEndpoint", "[", "\[IndentingNewLine]", "\t  ", 
    RowBox[{
    "vertex_", ",", "\[IndentingNewLine]", "\t  ", "edge_", ",", 
     "\[IndentingNewLine]", "\t  ", "internalEdgeLabels_Association", ",", 
     "\[IndentingNewLine]", "\t  ", "antiParticleRules_Association"}], 
    "\[IndentingNewLine]", "\t", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "endpointParticle", ",", "oppositeVertex", ",", "oppositeParticle"}], 
      "}"}], ",", "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", 
     "\t  ", 
     RowBox[{
      RowBox[{"endpointParticle", "=", 
       RowBox[{
        RowBox[{"internalEdgeLabels", "[", "edge", "]"}], "[", "vertex", 
        "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
      RowBox[{"oppositeVertex", "=", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{
         RowBox[{"List", " ", "@@", " ", "edge"}], ",", 
         RowBox[{
          RowBox[{"#", "=!=", "vertex"}], " ", "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t  ", 
      RowBox[{"oppositeParticle", "=", 
       RowBox[{
        RowBox[{"internalEdgeLabels", "[", "edge", "]"}], "[", 
        "oppositeVertex", "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
      "\[IndentingNewLine]", "\t  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"antiParticleRules", ",", "endpointParticle", ",", 
           RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}], "===", 
         "oppositeParticle"}], ",", "\[IndentingNewLine]", 
        "\t    ", "\"\<Upper\>\"", ",", "\[IndentingNewLine]", "\t    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"antiParticleRules", ",", "oppositeParticle", ",", 
             RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}], "===",
            "endpointParticle"}], ",", "\[IndentingNewLine]", 
          "\t      ", "\"\<Lower\>\"", ",", "\[IndentingNewLine]", 
          "\t      ", "\"\<Upper\>\""}], "\[IndentingNewLine]", "\t    ", 
         "]"}]}], "\[IndentingNewLine]", "\t  ", "]"}]}]}], 
    "\[IndentingNewLine]", "\t", "]"}]}], "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symmetrizeIndices", "[", 
    RowBox[{"expr_", ",", "inds_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
    RowBox[{
     RowBox[{"{", "perms", "}"}], ",", "\[IndentingNewLine]", "\t  ", 
     RowBox[{
