Cell[CellGroupData[{

Cell["compareAmps", "Section",
 CellChangeTimes->{{3.917172028575809*^9, 3.917172030303906*^9}, {
  3.996065133597856*^9, 
  3.996065134531671*^9}},ExpressionUUID->"a5619ada-4d28-4715-b6c5-\
aa623a84b21b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"compareAmps", "[", 
    RowBox[{"amp_", ",", "ampTested_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"diff", "=", "0"}], ",", 
       RowBox[{"sum", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"diff", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"amp", "-", "ampTested"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"diff", "=!=", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"sum", "=", 
          RowBox[{"Simplify", "[", 
           RowBox[{"amp", "+", "ampTested"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"sum", "=!=", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<Difference detected:\>\"", "]"}], ";", 
            
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t amp=              \>\"", ",", "amp"}], "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t ampTested=\>\"", ",", "ampTested"}], "]"}], 
            ";"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<Opposite sign detected:\>\"", "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t amp=              \>\"", ",", "amp"}], "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t ampTested=\>\"", ",", "ampTested"}], "]"}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.917172033289138*^9, 3.91717210691038*^9}, {
  3.917172176987441*^9, 3.9171723211849413`*^9}, {3.91717786966842*^9, 
  3.9171778767613173`*^9}, {3.917178056694068*^9, 3.917178059690837*^9}, {
  3.917178324612371*^9, 3.917178357568068*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"7d6c3b8e-7f61-4988-814c-8db5fc174fb8"]
}, Closed]],

