Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "f24e5fc7-83bb-42ac-9b8c-8175ff434e01"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "8d3d2ba9-2ede-4bb5-8c2d-598dce05bbc0"],

Cell[CellGroupData[{

Cell["sm47Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm47_GuZU\"}],\n  {\"G\", \"u\"} -> {\"Z\", \"u\"},\n  {\n  \
{{\"G.+\", \"u\", \"Z\", \"U\"}, sm47PAmplitude},\n  {{\"G.-\", \"u\", \"Z\", \"U\"}, sm47MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm47_GuZU\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm47Export], sm47Export[\"Directory\"], sm47Export]", "Input",
               ExpressionUUID -> "db74ab06-c612-4528-b60a-05d7e8af8976"],

