Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "17b0b371-46aa-463c-aa0a-3281a8041a11"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "090e506c-eea9-4ed5-9875-4e7516ce0a8e"],

Cell[CellGroupData[{

Cell["sm34Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm34_AeZE\"}],\n  {\"A\", \"e\"} -> {\"Z\", \"e\"},\n  {\n  \
{{\"A.+\", \"e\", \"Z\", \"E\"}, sm34PAmplitude},\n  {{\"A.-\", \"e\", \"Z\", \"E\"}, sm34MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm34_AeZE\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm34Export], sm34Export[\"Directory\"], sm34Export]", "Input",
               ExpressionUUID -> "2e2d0651-b7f3-4f56-a9c4-4c52e49c6c77"],

