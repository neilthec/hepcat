Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "03a3053e-7ef7-4d9a-83a1-15980de0c7f1"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "00373a68-7cfb-4ed6-b2f7-a09d79cd300f"],

Cell[CellGroupData[{

Cell["sm65Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm65_hhWmWp\"}],\n  {\"h\", \"h\"} -> {\"W+\", \"W-\"},\n  {\n  \
{{\"h\", \"h\", \"W-\", \"W+\"}, sm65Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm65_hhWmWp\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm65Export], sm65Export[\"Directory\"], sm65Export]",
               "Input", ExpressionUUID -> "9fef2690-d4d9-4c46-9447-19df29b5d32f"],

