Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "b5e87e12-f0ae-4b81-b18a-78323ca9f383"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "71458298-b37e-472c-b3fc-fd874a2634a7"],

Cell[CellGroupData[{

Cell["sm45Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm45_hGUu\"}],\n  {\"h\", \"G\"} -> {\"u\", \"U\"},\n  {\n  \
{{\"h\", \"G.+\", \"U\", \"u\"}, sm45PAmplitude},\n  {{\"h\", \"G.-\", \"U\", \"u\"}, sm45MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm45_hGUu\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm45Export], sm45Export[\"Directory\"], sm45Export]", "Input",
               ExpressionUUID -> "3d4cef32-a2cb-4676-aaee-c16a16342fdc"],

