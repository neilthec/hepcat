(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{Cell[CellGroupData[{Cell["SM Four-Point Construction and Independent Validation", "Title",
      ExpressionUUID -> "4b2f9c68-f5bd-47c0-95c9-309f103711ad"], Cell["The 73 process sections contain \
74 process families, including both charge-conjugate cases in the quark Z W section. The 132 \
construction calls cover the listed photon and gluon helicity combinations. The original formulas and \
manual derivations remain in SM-4-point.nb.", "Text", ExpressionUUID ->
       "4fc01ccb-5134-4fbf-82ff-b4c6d40517fc"], Cell["Evaluate Setup first, then run the process \
sections. Each construction prints its pole, high-energy, reference-spinor and independent \
Feynman-diagram checks. The C++ export below each family builds the process and runs the CalcHEP and \
MadGraph comparisons at 1000 phase-space points. The tables are produced by these cells.", "Text",
      CellChangeTimes -> {{4.00323269713818*^9, 4.0032327267888813*^9}},
      ExpressionUUID -> "32c06b17-d088-42d5-b1a8-b26e5bd24c41"], Cell["The process lists in construction \
cells use all momenta ingoing. Each export also states a physical two-to-two process: legs 1 and 2 are \
incoming and legs 3 and 4 are crossed to outgoing antiparticles. HEPCAT performs the momentum and spinor \
crossing. External photon/gluon helicities are kept separately in the C++ amplitude, while \
squared-amplitude validation uses the appropriate sums and initial averages.", "Text",
      ExpressionUUID -> "6a35dae1-9591-47d4-85bc-2a708383338d"],
     Cell[CellGroupData[{Cell["Setup", "Section", ExpressionUUID ->
          "9464562d-3966-4c1c-b632-5c6d1cdcf5e0"],
        Cell[CellGroupData[{Cell["hepcatDirectory = \
ExpandFileName[\"~/code/hepcat\"];\nGet[FileNameJoin[{hepcatDirectory, \"source\", \"HEPCAT.wl\"}]]",
            "Input", ExpressionUUID -> "aba1a8ad-b45a-40b6-a541-86b88ae7ac17"]}, Open]],
        Cell["sm = ReadModel[FileNameJoin[{hepcatDirectory, \"models\"}], 1];\nsmFeynman = \
ReadModel[FileNameJoin[{hepcatDirectory, \"model_feynman\"}], 1];", "Input",
         ExpressionUUID -> "afa26618-9063-4d51-86b1-02b240717313"], Cell["Model 1 supplies the SM \
elementary amplitudes used for both diagrams and four-point factorization. The Feynman diagram code use \
their own SM Feynman rules and this is used to validate the constructive amplitude expressions. Change \
the following paths for another installation. The comparison keeps model parameters consistent and \
disables widths in its private benchmark copies.", "Text", CellChangeTimes ->
          {{4.003232817192768*^9, 4.003232860696499*^9}}, ExpressionUUID ->
          "9cd1ed9d-e78a-4c79-84f2-d75f2f4b4d95"], Cell["spinasDirectory = \
FileNameJoin[{ParentDirectory[hepcatDirectory], \"spinas\"}];\nspinasOutputDirectory = \
FileNameJoin[{hepcatDirectory, \"tests\", \"spinas-output\", \"SM-4-point\"}];\ncalcHEPDirectory = \
FileNameJoin[{ParentDirectory[hepcatDirectory], \"CalcHEP\", \"calchep_3.9.2\"}];\ncalcHEPModel = \
{FileNameJoin[{hepcatDirectory, \"model_feynman\"}], 1};\nmadGraphDirectory = \
FileNameJoin[{ParentDirectory[hepcatDirectory], \"MadGraph\"}];\nmadGraphModel = \
FileNameJoin[{hepcatDirectory, \"model_madgraph\", \"sm\"}];\nmadGraphParameterRules = {\"lamWS\" -> \
0};(*Turn off CKM to match our model*)\nvalidationPoints = 1000;\nvalidationOptions = {\n  \
\"SPINASDirectory\" -> spinasDirectory,\n  \"Build\" -> True, \"RunExamples\" -> True, \"Overwrite\" -> \
True,\n  \"CalcHEPDirectory\" -> calcHEPDirectory,\n  \"CalcHEPModel\" -> calcHEPModel,\n  \
\"CalcHEPPoints\" -> validationPoints, \"RunCalcHEPValidation\" -> True,\n  \"MadGraphDirectory\" -> \
madGraphDirectory,\n  \"MadGraphModel\" -> madGraphModel,\n  \"MadGraphParameterRules\" -> \
madGraphParameterRules,\n  \"MadGraphPoints\" -> validationPoints, \"RunMadGraphValidation\" -> True,\n  \
\"ReturnDetails\" -> True};", "Input", CellChangeTimes -> {{4.0032330899532433*^9,
            4.003233112444242*^9}}, ExpressionUUID -> "69fa9cc3-84eb-4350-9d6b-9e83d4e922ac"],
        Cell["The full SM particle content is allowed in both reference programs. MadGraphParameterRules \
sets lamWS to zero to match the diagonal quark flavor mixing in the constructive model.  Colored \
amplitudes retain their explicit SU(3) tensors, and the exported code performs coherent color sums and \
the correct incoming color averages. Neutrinos retain their declared helicity spin states.", "Text",
         CellChangeTimes -> {{4.003233165787346*^9, 4.0032332017615767*^9}},
         ExpressionUUID -> "b6f63a41-d53f-4c72-a936-56389c2a0536"], Cell["The independent MadGraph \
reference is the local model_madgraph/sm UFO, including up-, down- and strange-quark masses and their \
Higgs couplings. Its numerical inputs are matched to the constructive model.", "Text",
         CellChangeTimes -> {4.0032332372241573*^9}, ExpressionUUID ->
          "0eb0d20c-d6f7-4d99-8a76-ddfc517fea29"]}, Open]],
     Cell[CellGroupData[{Cell["01. u, U, C, c", "Section", CellTags -> "construction-sm01",
         ExpressionUUID -> "72906c65-eff5-4bf0-8713-ec70c5941a6e"],
        Cell["All-ingoing ordering: u, U, C, c. Physical export: u, U -> c, C.", "Text",
         ExpressionUUID -> "af5b521e-05a3-48be-a379-3f28bb9a37c6"],
        Cell[CellGroupData[{Cell["u, U, C, c", "Subsection", ExpressionUUID ->
             "e9a4eebc-97e3-47c9-9672-942a6dafb2b9"], Cell[CellGroupData[
             {Cell["sm01Particles = {\"u\", \"U\", \"C\", \"c\"};\nsm01Amplitude = \
ConstructAmplitude[sm01Particles, sm, sm, \"FeynmanModel\" -> smFeynman]", "Input", ExpressionUUID ->
                "0b963fd6-c0bf-4f1d-8368-6d78e3d8cd48"]}, Open]]}, Open]],
        Cell[CellGroupData[{Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "e8457c56-2f47-4fc9-9df2-4289abbad1ec"], Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "17c21a12-cd3c-40ed-82f6-89ef0445fddf"],
           Cell[CellGroupData[{Cell["sm01Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm01_uUCc\"}],\n  {\"u\", \"U\"} -> {\"c\", \"C\"},\n  {\n  \
{{\"u\", \"U\", \"C\", \"c\"}, sm01Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm01_uUCc\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm01Export], sm01Export[\"Directory\"], sm01Export]", "Input",
               ExpressionUUID -> "354c81e1-79a3-469a-88fe-00698bc9b72d"]}, Open]]}, Open]]}, Closed]],
     Cell[CellGroupData[{Cell["02. u, U, U, u", "Section", CellTags -> "construction-sm02",
         ExpressionUUID -> "fd457fca-8ee3-415d-b83c-b3a4629b925a"],
        Cell["All-ingoing ordering: u, U, U, u. Physical export: u, U -> u, U.", "Text",
         ExpressionUUID -> "1f9ab426-97d7-4854-94e1-774c3c1f2414"],
        Cell[CellGroupData[{Cell["u, U, U, u", "Subsection", ExpressionUUID ->
             "f730b86b-962b-4d13-965e-bd3e45e16c34"], Cell[CellGroupData[
             {Cell["sm02Particles = {\"u\", \"U\", \"U\", \"u\"};\nsm02Amplitude = \
ConstructAmplitude[sm02Particles, sm, sm, \"FeynmanModel\" -> smFeynman]", "Input", ExpressionUUID ->
                "adefed44-b447-470f-b87e-0b8ba697d8ff"]}, Open]]}, Open]],
        Cell[CellGroupData[{Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "104d6b6f-75e7-47fe-8abb-f4d4a3ec41fd"], Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
