Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "3cd741cd-c5d2-4e43-ac39-e7db79ec132a"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "01b372f9-4f01-48cc-a5c8-e4e045698a84"],

Cell[CellGroupData[{

Cell["sm11Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm11_eEMm\"}],\n  {\"e\", \"E\"} -> {\"m\", \"M\"},\n  {\n  \
{{\"e\", \"E\", \"M\", \"m\"}, sm11Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm11_eEMm\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm11Export], sm11Export[\"Directory\"], sm11Export]", "Input",
               ExpressionUUID -> "ac7600bd-b10b-49d7-b1b6-af0e5ea3779a"],

