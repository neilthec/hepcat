Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "bd87b2c8-fae6-4dc2-b25b-6d2f04cf9bb6"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "ccd65cb7-e005-4ec9-a7d1-6c4a4961032d"],

Cell[CellGroupData[{

Cell["sm18Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm18_dULnl\"}],\n  {\"d\", \"U\"} -> {\"l\", \"Nl\"},\n  {\n  \
{{\"d\", \"U\", \"L\", \"nl\"}, sm18Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm18_dULnl\", Sequence \
@@ validationOptions];\nIf[AssociationQ[sm18Export], sm18Export[\"Directory\"], sm18Export]", "Input",
               ExpressionUUID -> "b3b03f02-fcf1-470a-ba0b-d17d57208d31"],

