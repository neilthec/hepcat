Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "9a616730-1c45-448c-85e9-41567d73f1a3"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "56f2763b-3de1-46ba-adc0-3cd421c60e59"],

Cell[CellGroupData[{

Cell["sm17Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm17_uDTb\"}],\n  {\"u\", \"D\"} -> {\"t\", \"B\"},\n  {\n  \
{{\"u\", \"D\", \"T\", \"b\"}, sm17Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm17_uDTb\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm17Export], sm17Export[\"Directory\"], sm17Export]", "Input",
               ExpressionUUID -> "2f197f07-3a47-4772-8ff5-cbcfe032004e"],

