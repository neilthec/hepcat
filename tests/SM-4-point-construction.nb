(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{Cell[CellGroupData[{Cell["SM Four-Point Construction and Independent Validation",
       "Title", ExpressionUUID -> "4b2f9c68-f5bd-47c0-95c9-309f103711ad"],
     Cell["The 73 process sections contain 74 process families, including both charge-conjugate \
cases in the quark Z W section. The 132 construction calls cover the listed photon and gluon helicity \
combinations. The original formulas and manual derivations remain in SM-4-point.nb.", "Text",
       ExpressionUUID -> "4fc01ccb-5134-4fbf-82ff-b4c6d40517fc"],
     Cell["Evaluate Setup first, then run the process sections. Each construction prints its \
pole, high-energy, reference-spinor and independent Feynman-diagram checks. The C++ export below each \
family builds the process and runs the CalcHEP and MadGraph comparisons at 1000 phase-space points. The \
tables are produced by these cells.", "Text", CellChangeTimes ->
        {{4.00323269713818*^9, 4.0032327267888813*^9}}, ExpressionUUID ->
        "32c06b17-d088-42d5-b1a8-b26e5bd24c41"], Cell["The process lists in construction cells \
use all momenta ingoing. Each export also states a physical two-to-two process: legs 1 and 2 are \
incoming and legs 3 and 4 are crossed to outgoing antiparticles. HEPCAT performs the momentum and spinor \
crossing. External photon/gluon helicities are kept separately in the C++ amplitude, while \
squared-amplitude validation uses the appropriate sums and initial averages.", "Text",
       ExpressionUUID -> "6a35dae1-9591-47d4-85bc-2a708383338d"],
     Cell[CellGroupData[{Cell["Setup", "Section", ExpressionUUID ->
           "9464562d-3966-4c1c-b632-5c6d1cdcf5e0"], Cell[CellGroupData[
           {Cell["hepcatDirectory = \
ExpandFileName[\"~/code/hepcat\"];\nGet[FileNameJoin[{hepcatDirectory, \"source\", \"HEPCAT.wl\"}]]",
             "Input", CellLabel -> " In[1]:=", ExpressionUUID ->
              "aba1a8ad-b45a-40b6-a541-86b88ae7ac17"], Cell[BoxData["\"----------HEPCAT----------\""],
             "Print", GeneratedCell -> True, CellAutoOverwrite -> True], Cell[BoxData[""], "Print",
             GeneratedCell -> True, CellAutoOverwrite -> True], Cell[BoxData["\"Version: \""], "Print",
             GeneratedCell -> True, CellAutoOverwrite -> True],
            Cell[BoxData["\"Authors: N. Christensen\""], "Print", GeneratedCell -> True,
             CellAutoOverwrite -> True], Cell[BoxData["\"Please cite: ...\""], "Print",
             GeneratedCell -> True, CellAutoOverwrite -> True],
            Cell[BoxData["\"Contributions by: ...\""], "Print", GeneratedCell -> True,
             CellAutoOverwrite -> True], Cell[BoxData["\"Instructions can be found...\""], "Print",
             GeneratedCell -> True, CellAutoOverwrite -> True], Cell[BoxData[""], "Print",
             GeneratedCell -> True, CellAutoOverwrite -> True],
            Cell[BoxData["\"We welcome contributors.  Please contact Neil if interested.\""], "Print",
             GeneratedCell -> True, CellAutoOverwrite -> True],
            Cell[BoxData["\"------------------------------------\""], "Print", GeneratedCell -> True,
             CellAutoOverwrite -> True]}, Open]], Cell["sm = ReadModel[FileNameJoin[{hepcatDirectory, \
\"models\"}], 1];\nsmFeynman = ReadModel[FileNameJoin[{hepcatDirectory, \"model_feynman\"}], 1];",
          "Input", CellLabel -> " In[3]:=", ExpressionUUID -> "afa26618-9063-4d51-86b1-02b240717313"],
         Cell["Model 1 supplies the SM elementary amplitudes used for both diagrams and four-point \
factorization. The Feynman diagram code use their own SM Feynman rules and this is used to validate the \
constructive amplitude expressions. Change the following paths for another installation. The comparison \
keeps model parameters consistent and disables widths in its private benchmark copies.", "Text",
          CellChangeTimes -> {{4.003232817192768*^9, 4.003232860696499*^9}},
          ExpressionUUID -> "9cd1ed9d-e78a-4c79-84f2-d75f2f4b4d95"], Cell["spinasDirectory = \
FileNameJoin[{ParentDirectory[hepcatDirectory], \"spinas\"}];\nspinasOutputDirectory = \
FileNameJoin[{hepcatDirectory, \"tests\", \"spinas-output\", \"SM-4-point\"}];\ncalcHEPDirectory = \
FileNameJoin[{ParentDirectory[hepcatDirectory], \"CalcHEP\", \"calchep_3.9.2\"}];\ncalcHEPModel = \
{FileNameJoin[{hepcatDirectory, \"model_feynman\"}], 1};\nmadGraphDirectory = \
FileNameJoin[{ParentDirectory[hepcatDirectory], \"MadGraph\"}];\nmadGraphModel = \
FileNameJoin[{hepcatDirectory, \"model_madgraph\", \"sm\"}];\nmadGraphParameterRules = {\"lamWS\" -> \
0};(*Turn off CKM to match our model*)\nvalidationPoints = 1000;\nvalidationOptions = {\n  \
\"SPINASDirectory\" -> spinasDirectory,\n  \"Build\" -> True, \"RunExamples\" -> True, \"Overwrite\" -> \
True,\n  \"CalcHEPDirectory\" -> calcHEPDirectory,\n  \"CalcHEPModel\" -> calcHEPModel,\n  \
\"CalcHEPPoints\" -> validationPoints, \"RunCalcHEPValidation\" -> True,\n  \"MadGraphDirectory\" -> \
madGraphDirectory,\n  \"MadGraphModel\" -> madGraphModel,\n  \"MadGraphParameterRules\" -> \
madGraphParameterRules,\n  \"MadGraphPoints\" -> validationPoints, \"RunMadGraphValidation\" -> True,\n  \
\"ReturnDetails\" -> True};", "Input", CellChangeTimes -> {{4.0032330899532433*^9,
             4.003233112444242*^9}}, CellLabel -> " In[5]:=", ExpressionUUID ->
           "69fa9cc3-84eb-4350-9d6b-9e83d4e922ac"], Cell["The full SM particle content is allowed in \
both reference programs. MadGraphParameterRules sets lamWS to zero to match the diagonal quark flavor \
mixing in the constructive model.  Colored amplitudes retain their explicit SU(3) tensors, and the \
exported code performs coherent color sums and the correct incoming color averages. Neutrinos retain \
their declared helicity spin states.", "Text", CellChangeTimes ->
           {{4.003233165787346*^9, 4.0032332017615767*^9}}, ExpressionUUID ->
           "b6f63a41-d53f-4c72-a936-56389c2a0536"], Cell["The independent MadGraph reference is the \
local model_madgraph/sm UFO, including up-, down- and strange-quark masses and their Higgs couplings. \
Its numerical inputs are matched to the constructive model.", "Text", CellChangeTimes ->
           {4.0032332372241573*^9}, ExpressionUUID -> "0eb0d20c-d6f7-4d99-8a76-ddfc517fea29"]}, Open]],
     Cell[CellGroupData[{Cell["01. u, U, C, c", "Section", CellTags -> "construction-sm01",
