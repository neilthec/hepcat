Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "da8dead7-1a6b-4a16-8ee7-d7a01d52ea5b"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "f0d9cde6-830a-45a6-8f0a-08695b7ca318"],

Cell[CellGroupData[{

Cell["sm16Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm16_neNeNene\"}],\n  {\"ne\", \"Ne\"} -> {\"ne\", \"Ne\"},\n  \
{\n  {{\"ne\", \"Ne\", \"Ne\", \"ne\"}, sm16Amplitude}\n  }, sm,\n  \"ProcessName\" -> \
\"sm16_neNeNene\", Sequence @@ validationOptions];\nIf[AssociationQ[sm16Export], \
sm16Export[\"Directory\"], sm16Export]", "Input", ExpressionUUID ->
                "0a2e0e5a-c873-47a5-a9a7-a4b9376ed35c"],

