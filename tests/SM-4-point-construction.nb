Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "76299a5d-53c1-4616-94b8-b99e627baab4"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "efd1cef2-5709-4233-987c-d5eaffeb1bf2"],

Cell[CellGroupData[{

Cell["sm66Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm66_AhWpWm\"}],\n  {\"A\", \"h\"} -> {\"W-\", \"W+\"},\n  {\n  \
{{\"A.+\", \"h\", \"W+\", \"W-\"}, sm66PAmplitude},\n  {{\"A.-\", \"h\", \"W+\", \"W-\"}, \
sm66MAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm66_AhWpWm\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm66Export], sm66Export[\"Directory\"], sm66Export]", "Input",
               ExpressionUUID -> "a7acedac-0070-42c9-a788-1e6b5c803082"],

