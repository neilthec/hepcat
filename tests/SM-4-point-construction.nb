Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "88548234-36fb-437e-9f64-19eb7fb05cd3"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "a4321a33-cea5-4778-b427-1efa28c40bd5"],

Cell[CellGroupData[{

Cell["sm20Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm20_eEhh\"}],\n  {\"e\", \"E\"} -> {\"h\", \"h\"},\n  {\n  \
{{\"e\", \"E\", \"h\", \"h\"}, sm20Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm20_eEhh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm20Export], sm20Export[\"Directory\"], sm20Export]", "Input",
               ExpressionUUID -> "becbf5ac-e0cc-4801-a866-1a88d5569088"],

