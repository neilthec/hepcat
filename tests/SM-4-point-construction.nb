Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "50ab9f94-49e5-4843-8c1f-7fdc7f6ade2a"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "a6242378-85ac-47ca-9718-0f6bfcfae494"],

Cell[CellGroupData[{

Cell["sm42Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm42_neNeWmWp\"}],\n  {\"ne\", \"Ne\"} -> {\"W+\", \"W-\"},\n  \
{\n  {{\"ne\", \"Ne\", \"W-\", \"W+\"}, sm42Amplitude}\n  }, sm,\n  \"ProcessName\" -> \
\"sm42_neNeWmWp\", Sequence @@ validationOptions];\nIf[AssociationQ[sm42Export], \
sm42Export[\"Directory\"], sm42Export]", "Input", ExpressionUUID ->
                "d15b6c60-d777-4da1-9e95-6ae8c108f264"],

