Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "e7778c33-48bc-4352-8d1c-39dded57d52b"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "de4994dc-4ffc-4d24-ae37-b51d0abb1f83"],

Cell[CellGroupData[{

Cell["sm38Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm38_neNeZZ\"}],\n  {\"ne\", \"Ne\"} -> {\"Z\", \"Z\"},\n  {\n  \
{{\"ne\", \"Ne\", \"Z\", \"Z\"}, sm38Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm38_neNeZZ\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm38Export], sm38Export[\"Directory\"], sm38Export]",
               "Input", ExpressionUUID -> "ace435f8-de64-4e19-8675-08e90db80b7f"],

