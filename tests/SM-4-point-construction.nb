Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "d705c44e-bb8d-4249-b4e5-dc95ad2e7737"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "af1c52f3-9447-4428-9ed4-f4cc6fd18883"],

Cell[CellGroupData[{

Cell["sm54Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm54_uDWmh\"}],\n  {\"u\", \"D\"} -> {\"W+\", \"h\"},\n  {\n  \
{{\"u\", \"D\", \"W-\", \"h\"}, sm54Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm54_uDWmh\", Sequence \
@@ validationOptions];\nIf[AssociationQ[sm54Export], sm54Export[\"Directory\"], sm54Export]", "Input",
               ExpressionUUID -> "a998fafc-47cc-41be-a73c-3766f9e75aee"],

