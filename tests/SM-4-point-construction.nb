Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "1d94f03e-701b-4e89-995d-409ce9acb671"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "af541796-1d37-44dd-93c8-aa2119fbf6eb"],

Cell[CellGroupData[{

Cell["sm09Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm09_dDEe\"}],\n  {\"d\", \"D\"} -> {\"e\", \"E\"},\n  {\n  \
{{\"d\", \"D\", \"E\", \"e\"}, sm09Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm09_dDEe\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm09Export], sm09Export[\"Directory\"], sm09Export]", "Input",
               ExpressionUUID -> "778de9dd-e9a3-4182-bba4-5b4cc57e31f5"],

