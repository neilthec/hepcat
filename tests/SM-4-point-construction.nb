Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "0a1650b5-3cac-4926-a3a0-8e1e810ffe50"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "7ffb65e5-df5f-4a5f-84aa-2d51d8b61c8f"],

Cell[CellGroupData[{

Cell["sm39Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm39_uUZZ\"}],\n  {\"u\", \"U\"} -> {\"Z\", \"Z\"},\n  {\n  \
{{\"u\", \"U\", \"Z\", \"Z\"}, sm39Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm39_uUZZ\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm39Export], sm39Export[\"Directory\"], sm39Export]", "Input",
               ExpressionUUID -> "d8553267-628b-4bb9-b2e6-509001f2c3b4"],

