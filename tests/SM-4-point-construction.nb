Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "766d6317-7317-43a0-839b-f2406e000df3"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "1cc516b9-9ba5-4c66-add9-df40fe0d231b"],

Cell[CellGroupData[{

Cell["sm71Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm71_ZZWmWp\"}],\n  {\"Z\", \"Z\"} -> {\"W+\", \"W-\"},\n  {\n  \
{{\"Z\", \"Z\", \"W-\", \"W+\"}, sm71Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm71_ZZWmWp\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm71Export], sm71Export[\"Directory\"], sm71Export]",
               "Input", CellLabel -> " In[16]:=", ExpressionUUID ->
                "b238ea4d-104b-4796-b5d9-bdf9f9e57d0a"],

