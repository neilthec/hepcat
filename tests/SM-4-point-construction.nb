Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "7f468eb1-f6a5-4b40-b364-db89d9873ebc"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "1111f674-46fd-4434-817c-38b6b47527a7"],

Cell[CellGroupData[{

Cell["sm30Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm30_eEAA\"}],\n  {\"e\", \"E\"} -> {\"A\", \"A\"},\n  {\n  \
{{\"e\", \"E\", \"A.+\", \"A.+\"}, sm30PPAmplitude},\n  {{\"e\", \"E\", \"A.+\", \"A.-\"}, \
sm30PMAmplitude},\n  {{\"e\", \"E\", \"A.-\", \"A.+\"}, sm30MPAmplitude},\n  {{\"e\", \"E\", \"A.-\", \
\"A.-\"}, sm30MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm30_eEAA\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm30Export], sm30Export[\"Directory\"], sm30Export]", "Input",
               ExpressionUUID -> "06a481fc-1e02-4b7b-9d9b-a37cce48d72d"],

