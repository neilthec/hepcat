Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "a4aaefee-f28b-4677-b8f4-1f10970176d8"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "aabf5ccc-fdce-474d-ae95-18013ec62dad"],

Cell[CellGroupData[{

Cell["sm28Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm28_uUZh\"}],\n  {\"u\", \"U\"} -> {\"Z\", \"h\"},\n  {\n  \
{{\"u\", \"U\", \"Z\", \"h\"}, sm28Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm28_uUZh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm28Export], sm28Export[\"Directory\"], sm28Export]", "Input",
               ExpressionUUID -> "79287c89-59d1-4a03-bd2f-8b8ec07ebba7"],

