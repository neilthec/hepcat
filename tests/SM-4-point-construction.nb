Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "e4f953e2-f1d6-4a60-9e2a-36a741450fa4"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "58b1e7a3-a787-43f5-9473-7fb8b6394eb3"],

Cell[CellGroupData[{

Cell["sm03Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm03_uUSs\"}],\n  {\"u\", \"U\"} -> {\"s\", \"S\"},\n  {\n  \
{{\"u\", \"U\", \"S\", \"s\"}, sm03Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm03_uUSs\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm03Export], sm03Export[\"Directory\"], sm03Export]", "Input",
               CellLabel -> " In[16]:=", ExpressionUUID -> "a3c400c6-a1cd-443a-aa51-dc020296af23"],

