Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "9d9a477e-b6cc-4425-9661-a18cb6f3f20e"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "146034b9-ac9e-4034-908c-817ad1a50dfa"],

Cell[CellGroupData[{

Cell["sm21Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm21_uUhh\"}],\n  {\"u\", \"U\"} -> {\"h\", \"h\"},\n  {\n  \
{{\"u\", \"U\", \"h\", \"h\"}, sm21Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm21_uUhh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm21Export], sm21Export[\"Directory\"], sm21Export]", "Input",
               ExpressionUUID -> "b3ddf999-df65-4277-ab72-e777bb824c0e"],

