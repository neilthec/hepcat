ConstructAmplitude[sm01Particles, sm, sm, \"FeynmanModel\" -> smFeynman]", "Input", CellLabel ->
                " In[14]:=", ExpressionUUID -> "0b963fd6-c0bf-4f1d-8368-6d78e3d8cd48"],

