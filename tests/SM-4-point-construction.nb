Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "0a4f8a42-1847-4688-bd0f-63ab1d14e055"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "1ca3d77f-d42f-4de6-be5a-ea0acf8f18be"],

Cell[CellGroupData[{

Cell["sm67Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm67_ZhWpWm\"}],\n  {\"Z\", \"h\"} -> {\"W-\", \"W+\"},\n  {\n  \
{{\"Z\", \"h\", \"W+\", \"W-\"}, sm67Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm67_ZhWpWm\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm67Export], sm67Export[\"Directory\"], sm67Export]",
               "Input", ExpressionUUID -> "6db8ab5d-6cb4-4ade-aa78-361a1aac2e4f"],

