Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "c2c8ba7e-2931-41ca-b691-6ac5f1a22412"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "5884bb3c-5b7f-4391-b78e-accfd023210b"],

Cell[CellGroupData[{

Cell["sm57Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm57_AWpUd\"}],\n  {\"A\", \"W+\"} -> {\"u\", \"D\"},\n  {\n  \
{{\"A.+\", \"W+\", \"U\", \"d\"}, sm57PAmplitude},\n  {{\"A.-\", \"W+\", \"U\", \"d\"}, \
sm57MAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm57_AWpUd\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm57Export], sm57Export[\"Directory\"], sm57Export]", "Input",
               ExpressionUUID -> "076dceba-da52-4879-858b-8228ffaaae26"],

