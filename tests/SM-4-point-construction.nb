Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "f71b890c-35c9-44bb-9949-24d2a9882d20"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "1b426aff-635c-4c99-8183-f42a970b4cf5"],

Cell[CellGroupData[{

Cell["sm40Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm40_dDZZ\"}],\n  {\"d\", \"D\"} -> {\"Z\", \"Z\"},\n  {\n  \
{{\"d\", \"D\", \"Z\", \"Z\"}, sm40Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm40_dDZZ\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm40Export], sm40Export[\"Directory\"], sm40Export]", "Input",
               ExpressionUUID -> "9167456a-b6a4-4102-9b1c-8b2eb242d33d"],

