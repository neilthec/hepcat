Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "a25d8491-a43a-4fc4-89f0-9a4302382ed9"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "ad5f2c40-f2ee-42cb-ab6b-6f07def4350b"],

Cell[CellGroupData[{

Cell["sm61Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm61_UdZWp\"}],\n  {\"U\", \"d\"} -> {\"Z\", \"W-\"},\n  {\n  \
{{\"U\", \"d\", \"Z\", \"W+\"}, sm61Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm61_UdZWp\", Sequence \
@@ validationOptions];\nIf[AssociationQ[sm61Export], sm61Export[\"Directory\"], sm61Export]", "Input",
               ExpressionUUID -> "2a0321e6-c75b-420a-af33-74e768a6e9de"],

