Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "42cca1ac-fa3a-4eed-af78-de4041d8a0d0"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "c946792e-1c1d-459a-b288-9bac5787ed3c"],

Cell[CellGroupData[{

Cell["sm15Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm15_neNeNmnm\"}],\n  {\"ne\", \"Ne\"} -> {\"nm\", \"Nm\"},\n  \
{\n  {{\"ne\", \"Ne\", \"Nm\", \"nm\"}, sm15Amplitude}\n  }, sm,\n  \"ProcessName\" -> \
\"sm15_neNeNmnm\", Sequence @@ validationOptions];\nIf[AssociationQ[sm15Export], \
sm15Export[\"Directory\"], sm15Export]", "Input", ExpressionUUID ->
                "a008eb06-a662-42cb-b931-7eaa3bb0a55c"],

