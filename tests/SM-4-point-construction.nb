Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "50b3e279-7519-4595-bc5a-127f0032eaa6"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "7dbcf257-3b05-4379-9791-4264cc86c9d8"],

Cell[CellGroupData[{

Cell["sm46Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm46_hGDd\"}],\n  {\"h\", \"G\"} -> {\"d\", \"D\"},\n  {\n  \
{{\"h\", \"G.+\", \"D\", \"d\"}, sm46PAmplitude},\n  {{\"h\", \"G.-\", \"D\", \"d\"}, sm46MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm46_hGDd\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm46Export], sm46Export[\"Directory\"], sm46Export]", "Input",
               ExpressionUUID -> "51eb7618-93b8-4b87-9bc5-c24baf0d5297"],

