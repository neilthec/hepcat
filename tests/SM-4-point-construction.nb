Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "ea4398c3-c6d0-425c-9a34-3f12796712ad"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "e588bc6a-efbb-43ef-8a4d-779a3eb6a9d1"],

Cell[CellGroupData[{

Cell["sm60Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm60_EneZWm\"}],\n  {\"E\", \"ne\"} -> {\"Z\", \"W+\"},\n  {\n  \
{{\"E\", \"ne\", \"Z\", \"W-\"}, sm60Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm60_EneZWm\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm60Export], sm60Export[\"Directory\"], sm60Export]",
               "Input", ExpressionUUID -> "90bec26e-e346-4e50-b893-4fe8f826ef6f"],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  TagBox[
   DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
    "InitialData" -> {<|
       "Reference" -> "CalcHEP", "Status" -> "PASS", "RequestedPoints" -> 
        1000|>}, "AllowEmbedding" -> True, "InitialShape" -> 
     TypeSystem`PackageScope`HeaderShape[<|{All, "Reference"} -> 
        1, {All, "Status"} -> 1, {All, "RequestedPoints"} -> 1|>, 
       TypeSystem`PackageScope`Limited[
        TypeSystem`PackageScope`ColumnShape[
         TypeSystem`PackageScope`Limited[
          
          TypeSystem`PackageScope`RowShape[<|
           "Reference" -> TypeSystem`PackageScope`AtomShape[78.4], "Status" -> 
            TypeSystem`PackageScope`AtomShape[44.800000000000004`], 
            "RequestedPoints" -> TypeSystem`PackageScope`AtomShape[34]|>], 
          Infinity, 3, {All}]], 1, Infinity, {}]], "InitialType" -> 
     TypeSystem`Vector[
       TypeSystem`Struct[{"Reference", "Status", "RequestedPoints"}, {
         TypeSystem`Atom[String], 
