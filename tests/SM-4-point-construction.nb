Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "713b1995-6176-4c55-b2c0-b0507f7a9fc4"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "f79d785f-e605-4f45-bac8-3d520783893f"],

Cell[CellGroupData[{

Cell["sm58Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm58_AWpNee\"}],\n  {\"A\", \"W+\"} -> {\"ne\", \"E\"},\n  {\n  \
{{\"A.+\", \"W+\", \"Ne\", \"e\"}, sm58PAmplitude},\n  {{\"A.-\", \"W+\", \"Ne\", \"e\"}, \
sm58MAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm58_AWpNee\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm58Export], sm58Export[\"Directory\"], sm58Export]", "Input",
               ExpressionUUID -> "398078f3-6506-4107-9bc9-e670987313dd"],

