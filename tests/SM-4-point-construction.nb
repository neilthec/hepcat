Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "b2c8c3f2-337c-47ca-8327-56ca41a20195"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "60e5ad04-dc8d-4a4f-ab99-831528660576"],

Cell[CellGroupData[{

Cell["sm72Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm72_WpWpWmWm\"}],\n  {\"W+\", \"W+\"} -> {\"W+\", \"W+\"},\n  \
{\n  {{\"W+\", \"W+\", \"W-\", \"W-\"}, sm72Amplitude}\n  }, sm,\n  \"ProcessName\" -> \
\"sm72_WpWpWmWm\", Sequence @@ validationOptions];\nIf[AssociationQ[sm72Export], \
sm72Export[\"Directory\"], sm72Export]", "Input", ExpressionUUID ->
                "e9e70860-83b5-4508-a53c-957d24848018"],

