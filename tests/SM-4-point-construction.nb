Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "5dcee237-38b1-4f5f-bb75-9745dd31f474"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "8f9e5e0d-abcd-4db8-9cea-b86ec4bfc5a5"],

Cell[CellGroupData[{

Cell["sm14Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm14_eENene\"}],\n  {\"e\", \"E\"} -> {\"ne\", \"Ne\"},\n  {\n  \
{{\"e\", \"E\", \"Ne\", \"ne\"}, sm14Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm14_eENene\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm14Export], sm14Export[\"Directory\"], sm14Export]",
               "Input", ExpressionUUID -> "97789ea6-c1c9-4c24-af35-95e85703d691"],

