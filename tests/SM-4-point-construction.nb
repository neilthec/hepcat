Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "904125c5-c267-480b-b066-ba61fbd315bc"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "5af19dac-0ef3-4fad-999a-5f843ed354f1"],

Cell[CellGroupData[{

Cell["sm29Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm29_dDZh\"}],\n  {\"d\", \"D\"} -> {\"Z\", \"h\"},\n  {\n  \
{{\"d\", \"D\", \"Z\", \"h\"}, sm29Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm29_dDZh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm29Export], sm29Export[\"Directory\"], sm29Export]", "Input",
               ExpressionUUID -> "5bc44ca7-94d9-40cd-9aba-8c7ff0f16824"],

