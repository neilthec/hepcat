Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "f301260f-6df8-41ef-92ad-6d7707c1a26b"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "374a39f8-9f95-4a35-9f1d-6b0967b8d832"],

Cell[CellGroupData[{

Cell["sm64Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm64_hhZZ\"}],\n  {\"h\", \"h\"} -> {\"Z\", \"Z\"},\n  {\n  \
{{\"h\", \"h\", \"Z\", \"Z\"}, sm64Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm64_hhZZ\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm64Export], sm64Export[\"Directory\"], sm64Export]", "Input",
               ExpressionUUID -> "87f3348c-c8a4-4443-9c8e-8a258d8d08d9"],

