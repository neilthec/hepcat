Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "1d8c2701-a0ff-49db-ae5c-10ca40d3058c"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "bf9539c1-0227-441c-9016-2e2785780202"],

Cell[CellGroupData[{

Cell["sm55Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm55_NeeWph\"}],\n  {\"Ne\", \"e\"} -> {\"W-\", \"h\"},\n  {\n  \
{{\"Ne\", \"e\", \"W+\", \"h\"}, sm55Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm55_NeeWph\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm55Export], sm55Export[\"Directory\"], sm55Export]",
               "Input", ExpressionUUID -> "1b6e1c4c-6643-4861-bd33-445cec64bd88"],

