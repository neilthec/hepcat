Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "a2a47535-0f02-436d-b020-666d763a1b43"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "5529b056-c3f4-4977-9bf6-2505a3655596"],

Cell[CellGroupData[{

Cell["sm19Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm19_mNmEne\"}],\n  {\"m\", \"Nm\"} -> {\"e\", \"Ne\"},\n  {\n  \
{{\"m\", \"Nm\", \"E\", \"ne\"}, sm19Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm19_mNmEne\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm19Export], sm19Export[\"Directory\"], sm19Export]",
               "Input", ExpressionUUID -> "55ac663d-7084-4514-82b0-fd07b08f7fcb"],

