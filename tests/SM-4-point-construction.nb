Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "e30b8df5-bb3b-45a1-aaa4-eb8f99b70f62"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "a0229454-8078-454a-bc21-8498373057a8"],

Cell[CellGroupData[{

Cell["sm07Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm07_uUEe\"}],\n  {\"u\", \"U\"} -> {\"e\", \"E\"},\n  {\n  \
{{\"u\", \"U\", \"E\", \"e\"}, sm07Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm07_uUEe\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm07Export], sm07Export[\"Directory\"], sm07Export]", "Input",
               ExpressionUUID -> "ab7a51e5-d068-4504-babb-215a50925abb"],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  TagBox[
   DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
    "InitialData" -> {<|
       "Reference" -> "CalcHEP", "Status" -> "PASS", "RequestedPoints" -> 
