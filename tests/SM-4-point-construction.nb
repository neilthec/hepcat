Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "4cdc9c4b-254f-455e-ad08-efbfe4c01ae1"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "7c0e5cb5-26aa-47ec-b23f-49dbbfe4a645"],

Cell[CellGroupData[{

Cell["sm33Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm33_uUGG\"}],\n  {\"u\", \"U\"} -> {\"G\", \"G\"},\n  {\n  \
{{\"u\", \"U\", \"G.+\", \"G.+\"}, sm33PPAmplitude},\n  {{\"u\", \"U\", \"G.+\", \"G.-\"}, \
sm33PMAmplitude},\n  {{\"u\", \"U\", \"G.-\", \"G.+\"}, sm33MPAmplitude},\n  {{\"u\", \"U\", \"G.-\", \
\"G.-\"}, sm33MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm33_uUGG\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm33Export], sm33Export[\"Directory\"], sm33Export]", "Input",
               ExpressionUUID -> "50df6bf2-42a1-4c1b-8011-0e32f573b073"],

