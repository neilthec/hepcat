Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "841bc36e-1c6f-4b64-a670-59756adfe0cf"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "f2c3846d-ba67-41e5-b333-39c0e3a55427"],

Cell[CellGroupData[{

Cell["sm24Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm24_uUAh\"}],\n  {\"u\", \"U\"} -> {\"A\", \"h\"},\n  {\n  \
{{\"u\", \"U\", \"A.+\", \"h\"}, sm24PAmplitude},\n  {{\"u\", \"U\", \"A.-\", \"h\"}, sm24MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm24_uUAh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm24Export], sm24Export[\"Directory\"], sm24Export]", "Input",
               ExpressionUUID -> "589d75d1-3d9b-4079-b57c-6165541c8bdc"],

