Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "dc46a538-5cb7-45f4-9222-27a03f41d849"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "fe603a4c-29f3-4463-9af2-caf84dce3204"],

Cell[CellGroupData[{

Cell["sm10Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm10_dDNene\"}],\n  {\"d\", \"D\"} -> {\"ne\", \"Ne\"},\n  {\n  \
{{\"d\", \"D\", \"Ne\", \"ne\"}, sm10Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm10_dDNene\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm10Export], sm10Export[\"Directory\"], sm10Export]",
               "Input", ExpressionUUID -> "f51a105a-3716-4b18-90a2-1ea88d62f6e7"],

