Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "43f3558c-3354-4d83-8e6f-7d53dfa37a25"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "7182ecfa-d1af-481e-b6f5-36c89138e3a8"],

Cell[CellGroupData[{

Cell["sm25Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm25_dDAh\"}],\n  {\"d\", \"D\"} -> {\"A\", \"h\"},\n  {\n  \
{{\"d\", \"D\", \"A.+\", \"h\"}, sm25PAmplitude},\n  {{\"d\", \"D\", \"A.-\", \"h\"}, sm25MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm25_dDAh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm25Export], sm25Export[\"Directory\"], sm25Export]", "Input",
               ExpressionUUID -> "de36b73f-93ff-4064-af9f-03fbd17dd9fe"],

