Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "09acf2da-a197-4bdc-965c-8feb3540f733"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "02491df0-7d31-4b47-9943-a34ed192318e"],

Cell[CellGroupData[{

Cell["sm59Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm59_EneAWm\"}],\n  {\"E\", \"ne\"} -> {\"A\", \"W+\"},\n  {\n  \
{{\"E\", \"ne\", \"A.+\", \"W-\"}, sm59PAmplitude},\n  {{\"E\", \"ne\", \"A.-\", \"W-\"}, \
sm59MAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm59_EneAWm\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm59Export], sm59Export[\"Directory\"], sm59Export]", "Input",
               ExpressionUUID -> "41be8215-278c-4ba5-846c-daf00d7dae4f"],

