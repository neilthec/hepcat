Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "1903c248-df2f-41b9-a37a-4700e2cdf4c4"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "fb564928-c469-4094-b79c-4047abd0400d"],

Cell[CellGroupData[{

Cell["sm69Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm69_AZWmWp\"}],\n  {\"A\", \"Z\"} -> {\"W+\", \"W-\"},\n  {\n  \
{{\"A.+\", \"Z\", \"W-\", \"W+\"}, sm69PAmplitude},\n  {{\"A.-\", \"Z\", \"W-\", \"W+\"}, \
sm69MAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm69_AZWmWp\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm69Export], sm69Export[\"Directory\"], sm69Export]", "Input",
               ExpressionUUID -> "be95a9a5-f35b-4689-9a30-f84a65b1fc03"],

