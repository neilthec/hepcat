Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "783e4eba-9780-4249-8522-4ece3da73331"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "de8b1667-3024-41cb-bef4-303357aa3fab"],

Cell[CellGroupData[{

Cell["sm04Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm04_uUDd\"}],\n  {\"u\", \"U\"} -> {\"d\", \"D\"},\n  {\n  \
{{\"u\", \"U\", \"D\", \"d\"}, sm04Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm04_uUDd\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm04Export], sm04Export[\"Directory\"], sm04Export]", "Input",
               ExpressionUUID -> "20dcce99-293b-4765-8685-86ff43507b38"],

