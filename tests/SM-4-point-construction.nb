Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "49b96e00-1843-4bce-8308-1166901d4c6d"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "707bccf8-2317-46b7-9b1b-f0605e965fef"],

Cell[CellGroupData[{

Cell["sm37Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm37_eEZZ\"}],\n  {\"e\", \"E\"} -> {\"Z\", \"Z\"},\n  {\n  \
{{\"e\", \"E\", \"Z\", \"Z\"}, sm37Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm37_eEZZ\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm37Export], sm37Export[\"Directory\"], sm37Export]", "Input",
               ExpressionUUID -> "ac46f0bc-9226-4090-a3d4-5a67ebc6ced7"],

