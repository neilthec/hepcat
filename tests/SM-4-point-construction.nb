Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "0fb4c1b6-86c8-47e5-aecf-952859e34359"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "01748a10-952e-4458-b740-8974ea232c87"],

Cell[CellGroupData[{

Cell["sm50Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm50_GdAD\"}],\n  {\"G\", \"d\"} -> {\"A\", \"d\"},\n  {\n  \
{{\"G.+\", \"d\", \"A.+\", \"D\"}, sm50PPAmplitude},\n  {{\"G.+\", \"d\", \"A.-\", \"D\"}, \
sm50PMAmplitude},\n  {{\"G.-\", \"d\", \"A.+\", \"D\"}, sm50MPAmplitude},\n  {{\"G.-\", \"d\", \"A.-\", \
\"D\"}, sm50MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm50_GdAD\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm50Export], sm50Export[\"Directory\"], sm50Export]", "Input",
               ExpressionUUID -> "94686e30-42c5-4c82-8e8a-df76728695e2"],

