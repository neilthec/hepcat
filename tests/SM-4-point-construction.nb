                           {All}]], 1, Infinity, {}]], "InitialType" -> TypeSystem`Vector[
                        TypeSystem`Struct[{"Reference", "Status", "RequestedPoints"}, {TypeSystem`Atom[
                           String], TypeSystem`Atom[String], TypeSystem`Atom[Integer]}], 1],
                      "Meta" -> Association[], "RowTarget" -> 20, "ColumnTarget" -> 10, "Shape" ->
                       TypeSystem`PackageScope`HeaderShape[Association[{All, "Reference"} -> 1,
