Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "1f2fe207-8a02-4d7e-9b3d-2394da60af77"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "dbb79a3b-1d29-43d4-94ec-ef693cca9e9d"],

Cell[CellGroupData[{

Cell["sm48Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm48_GdZD\"}],\n  {\"G\", \"d\"} -> {\"Z\", \"d\"},\n  {\n  \
{{\"G.+\", \"d\", \"Z\", \"D\"}, sm48PAmplitude},\n  {{\"G.-\", \"d\", \"Z\", \"D\"}, sm48MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm48_GdZD\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm48Export], sm48Export[\"Directory\"], sm48Export]", "Input",
               ExpressionUUID -> "fea008a3-39c6-4e5e-bbb9-5a26b88751d3"],

