Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "165a2d5d-961e-46da-84c4-c20555799988"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "efef760b-3a63-42e3-81d6-98db11172e8e"],

Cell[CellGroupData[{

Cell["sm23Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm23_eEAh\"}],\n  {\"e\", \"E\"} -> {\"A\", \"h\"},\n  {\n  \
{{\"e\", \"E\", \"A.+\", \"h\"}, sm23PAmplitude},\n  {{\"e\", \"E\", \"A.-\", \"h\"}, sm23MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm23_eEAh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm23Export], sm23Export[\"Directory\"], sm23Export]", "Input",
               ExpressionUUID -> "45429cf9-5374-4093-a8c0-47da0f3bdc14"],

