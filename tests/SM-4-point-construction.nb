Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "2aa3acfe-80f0-40a0-89cc-e1181b26455a"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "80f9c95c-b029-40af-87f6-435d57180a73"],

Cell[CellGroupData[{

Cell["sm49Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm49_GuAU\"}],\n  {\"G\", \"u\"} -> {\"A\", \"u\"},\n  {\n  \
{{\"G.+\", \"u\", \"A.+\", \"U\"}, sm49PPAmplitude},\n  {{\"G.+\", \"u\", \"A.-\", \"U\"}, \
sm49PMAmplitude},\n  {{\"G.-\", \"u\", \"A.+\", \"U\"}, sm49MPAmplitude},\n  {{\"G.-\", \"u\", \"A.-\", \
\"U\"}, sm49MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm49_GuAU\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm49Export], sm49Export[\"Directory\"], sm49Export]", "Input",
               ExpressionUUID -> "c7b56b52-cbe8-4251-a1f8-05a50fcb0bcf"],

