Cell["C++ export and independent validation",
               "Subsubsection", ExpressionUUID -> "4afe56f7-0985-48fe-8816-81fd58ebb6a6"],

Cell["Run this cell after its construction has completed. It validates this charged \
process independently, using the same model and tool settings as the other sections.", "Text",
               ExpressionUUID -> "e85b1ad2-baa4-4759-a68f-b3c779947c7b"],

Cell[CellGroupData[{

Cell["sm61CExport = WriteSPINASProcess[\n  FileNameJoin[{spinasOutputDirectory, \
\"sm61C\"}],\n  {\"D\", \"u\"} -> {\"Z\", \"W+\"},\n  {{{\"D\", \"u\", \"Z\", \"W-\"}, sm61CAmplitude}}, \
sm,\n  \"ProcessName\" -> \"sm61C\", Sequence @@ validationOptions];\nIf[AssociationQ[sm61CExport], \
sm61CExport[\"Directory\"], sm61CExport]", "Input", ExpressionUUID ->
                   "ec90e324-9e0b-4c9e-a958-f1a4751c4d02"],

