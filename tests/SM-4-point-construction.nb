Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "5e5632ac-e459-4c39-b349-f17b08de2c67"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "3f29efee-471a-4648-a341-37054a4740ab"],

Cell[CellGroupData[{

Cell["sm62Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm62_GWpUd\"}],\n  {\"G\", \"W+\"} -> {\"u\", \"D\"},\n  {\n  \
{{\"G.+\", \"W+\", \"U\", \"d\"}, sm62PAmplitude},\n  {{\"G.-\", \"W+\", \"U\", \"d\"}, \
sm62MAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm62_GWpUd\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm62Export], sm62Export[\"Directory\"], sm62Export]", "Input",
               ExpressionUUID -> "3dabfeb3-e2f8-40a4-bc4d-4e13715da73e"],

