Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "06a99db7-1c6a-49de-83b4-7613c92e30cd"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "e18d0b49-9c48-4cb0-b4f8-a021519bdc43"],

Cell[CellGroupData[{

Cell["sm08Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm08_uUNene\"}],\n  {\"u\", \"U\"} -> {\"ne\", \"Ne\"},\n  {\n  \
{{\"u\", \"U\", \"Ne\", \"ne\"}, sm08Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm08_uUNene\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm08Export], sm08Export[\"Directory\"], sm08Export]",
               "Input", ExpressionUUID -> "b3a53947-d17d-4a77-8bcf-7e2352631176"],

