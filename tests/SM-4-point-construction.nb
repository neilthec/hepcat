Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "b05d0a51-575a-4c65-83af-25edac080a8d"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "c6d31fb7-75cd-4444-a73b-f81d8accb471"],

Cell[CellGroupData[{

Cell["sm53Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm53_neEWmh\"}],\n  {\"ne\", \"E\"} -> {\"W+\", \"h\"},\n  {\n  \
{{\"ne\", \"E\", \"W-\", \"h\"}, sm53Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm53_neEWmh\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm53Export], sm53Export[\"Directory\"], sm53Export]",
               "Input", ExpressionUUID -> "e435c187-7df3-4eb7-a0fa-4119609b01aa"],

