Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "b914a758-db0b-4ce1-8cfd-0a1a8df718fd"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "599e43ae-7c54-4ce1-81d2-85cbecf00a82"],

Cell[CellGroupData[{

Cell["sm12Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm12_eEEe\"}],\n  {\"e\", \"E\"} -> {\"e\", \"E\"},\n  {\n  \
{{\"e\", \"E\", \"E\", \"e\"}, sm12Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm12_eEEe\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm12Export], sm12Export[\"Directory\"], sm12Export]", "Input",
               ExpressionUUID -> "48598ded-5e0c-4a4b-89d1-96175a837a68"],

