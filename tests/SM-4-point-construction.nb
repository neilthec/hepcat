Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "616d209e-0e4e-4b6a-b457-b80d1ffc4a1c"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "72f74f74-90d0-4fc3-ab24-52a3956b63bb"],

Cell[CellGroupData[{

Cell["sm22Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm22_dDhh\"}],\n  {\"d\", \"D\"} -> {\"h\", \"h\"},\n  {\n  \
{{\"d\", \"D\", \"h\", \"h\"}, sm22Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm22_dDhh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm22Export], sm22Export[\"Directory\"], sm22Export]", "Input",
               ExpressionUUID -> "8e5e0977-d5f9-48a0-a2d8-cdea103843a8"],

