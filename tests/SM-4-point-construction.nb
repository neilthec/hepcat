Cell["\<\
sm = ReadModel[FileNameJoin[{hepcatDirectory, \"models\"}], 1];
smFeynman = ReadModel[FileNameJoin[{hepcatDirectory, \"tests\", \"reference-models\", \"calchep\"}], 1];\
\
\>", "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"afa26618-9063-4d51-86b1-02b240717313"],

Cell["Model 1 supplies the SM elementary amplitudes used for both diagrams and four-point \
factorization. The Feynman diagram code use their own SM Feynman rules and this is used to validate the \
constructive amplitude expressions. Change the following paths for another installation. The comparison \
keeps model parameters consistent and disables widths in its private benchmark copies.", "Text",
          CellChangeTimes -> {{4.003232817192768*^9, 4.003232860696499*^9}},
          ExpressionUUID -> "9cd1ed9d-e78a-4c79-84f2-d75f2f4b4d95"],

Cell["\<\
spinasDirectory = FileNameJoin[{ParentDirectory[hepcatDirectory], \"spinas\"}];
spinasOutputDirectory = FileNameJoin[{hepcatDirectory, \"tests\", \"results\", \
\"spinas-output\", \"SM-4-point\"}];
calcHEPDirectory = FileNameJoin[{ParentDirectory[hepcatDirectory], \
\"CalcHEP\", \"calchep_3.9.2\"}];
calcHEPModel = {FileNameJoin[{hepcatDirectory, \"tests\", \"reference-models\", \"calchep\"}], 1};
madGraphDirectory = FileNameJoin[{ParentDirectory[hepcatDirectory], \
\"MadGraph\"}];
madGraphModel = FileNameJoin[{hepcatDirectory, \"tests\", \"reference-models\", \"madgraph\", \"sm\"}];
madGraphParameterRules = {\"lamWS\" -> 0};(*Turn off CKM to match our model*)
validationPoints = 1000;
validationOptions = {
  \"SPINASDirectory\" -> spinasDirectory,
  \"Build\" -> True, \"RunExamples\" -> True, \"Overwrite\" -> True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPPoints\" -> validationPoints, \"RunCalcHEPValidation\" -> True,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphParameterRules\" -> madGraphParameterRules,
  \"MadGraphPoints\" -> validationPoints, \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True};\
\>", "Input",
 CellChangeTimes->{{4.0032330899532433`*^9, 4.003233112444242*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"69fa9cc3-84eb-4350-9d6b-9e83d4e922ac"],

Cell["The full SM particle content is allowed in \
both reference programs. MadGraphParameterRules sets lamWS to zero to match the diagonal quark flavor \
mixing in the constructive model.  Colored amplitudes retain their explicit SU(3) tensors, and the \
exported code performs coherent color sums and the correct incoming color averages. Neutrinos retain \
their declared helicity spin states.", "Text", CellChangeTimes ->
           {{4.003233165787346*^9, 4.0032332017615767*^9}}, ExpressionUUID ->
           "b6f63a41-d53f-4c72-a936-56389c2a0536"],

Cell["The independent MadGraph reference is the \
local tests/reference-models/madgraph/sm UFO, including up-, down- and strange-quark masses and their Higgs couplings. \
Its numerical inputs are matched to the constructive model.", "Text", CellChangeTimes ->
           {4.0032332372241573*^9}, ExpressionUUID -> "0eb0d20c-d6f7-4d99-8a76-ddfc517fea29"]
}, Open  ]],

Cell[CellGroupData[{

