Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "8ce18cff-6d21-49cf-8e7e-7e8b3b107aa6"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "665fd489-9d8d-4cad-a0b8-c2638c20f59c"],

Cell[CellGroupData[{

Cell["sm68Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm68_AAWmWp\"}],\n  {\"A\", \"A\"} -> {\"W+\", \"W-\"},\n  {\n  \
{{\"A.+\", \"A.+\", \"W-\", \"W+\"}, sm68PPAmplitude},\n  {{\"A.+\", \"A.-\", \"W-\", \"W+\"}, \
sm68PMAmplitude},\n  {{\"A.-\", \"A.+\", \"W-\", \"W+\"}, sm68MPAmplitude},\n  {{\"A.-\", \"A.-\", \
\"W-\", \"W+\"}, sm68MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm68_AAWmWp\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm68Export], sm68Export[\"Directory\"], sm68Export]", "Input",
               ExpressionUUID -> "dd2166a7-83aa-4487-8d1e-c1028dc0d3ca"],

