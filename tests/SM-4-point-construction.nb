Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "41180e3f-8366-4c35-aaa4-c5a98feea6f9"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "e9030e47-9f3d-4275-b125-7d019bd8dc50"],

Cell[CellGroupData[{

Cell["sm41Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm41_eEWmWp\"}],\n  {\"e\", \"E\"} -> {\"W+\", \"W-\"},\n  {\n  \
{{\"e\", \"E\", \"W-\", \"W+\"}, sm41Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm41_eEWmWp\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm41Export], sm41Export[\"Directory\"], sm41Export]",
               "Input", ExpressionUUID -> "286099bf-1302-4bb3-ab1f-2af3c59d7fea"],

