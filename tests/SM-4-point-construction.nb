Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "478f7786-57ae-455f-8099-00f4558d6ef8"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "d6c5b9a6-3f1e-428f-bd63-4cd7a51bb247"],

Cell[CellGroupData[{

Cell["sm44Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm44_dDWmWp\"}],\n  {\"d\", \"D\"} -> {\"W+\", \"W-\"},\n  {\n  \
{{\"d\", \"D\", \"W-\", \"W+\"}, sm44Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm44_dDWmWp\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm44Export], sm44Export[\"Directory\"], sm44Export]",
               "Input", ExpressionUUID -> "cc424f27-6cc1-4be2-b384-4b10c17186f3"],

