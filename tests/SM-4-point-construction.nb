Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "d9e50962-faeb-448f-8a46-eb5b25083caf"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "0ccea128-1431-45da-b06b-2692c09f1f51"],

Cell[CellGroupData[{

Cell["sm05Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm05_dDSs\"}],\n  {\"d\", \"D\"} -> {\"s\", \"S\"},\n  {\n  \
{{\"d\", \"D\", \"S\", \"s\"}, sm05Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm05_dDSs\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm05Export], sm05Export[\"Directory\"], sm05Export]", "Input",
               ExpressionUUID -> "c40a4575-15c5-4c42-8bfd-0c368fb3f39d"],

