Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "4ee5eb06-639b-4666-adec-350b0c5374de"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "1e7d3cce-fd33-4b32-aba6-13958cb73306"],

Cell[CellGroupData[{

Cell["sm06Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm06_dDDd\"}],\n  {\"d\", \"D\"} -> {\"d\", \"D\"},\n  {\n  \
{{\"d\", \"D\", \"D\", \"d\"}, sm06Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm06_dDDd\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm06Export], sm06Export[\"Directory\"], sm06Export]", "Input",
               ExpressionUUID -> "b699fa8b-9596-4d06-b9d3-f4c5b7619a5f"],

