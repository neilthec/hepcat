random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "30ea5ee8-bf40-49ec-b8f2-61fc48a0b7e0"],
           Cell[CellGroupData[{Cell["sm02Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm02_uUUu\"}],\n  {\"u\", \"U\"} -> {\"u\", \"U\"},\n  {\n  \
{{\"u\", \"U\", \"U\", \"u\"}, sm02Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm02_uUUu\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm02Export], sm02Export[\"Directory\"], sm02Export]", "Input",
               ExpressionUUID -> "77947c4e-9b56-43e4-847f-46ba8b2a0786"]}, Open]]}, Open]]}, Closed]],
     Cell[CellGroupData[{Cell["03. u, U, S, s", "Section", CellTags -> "construction-sm03",
