Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "1fd53ffe-9eef-4866-a959-efe9244c55de"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "b43598d3-77cb-49d4-aedb-28fa91ed3cb3"],

Cell[CellGroupData[{

Cell["sm52Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm52_GdGD\"}],\n  {\"G\", \"d\"} -> {\"G\", \"d\"},\n  {\n  \
{{\"G.+\", \"d\", \"G.+\", \"D\"}, sm52PPAmplitude},\n  {{\"G.+\", \"d\", \"G.-\", \"D\"}, \
sm52PMAmplitude},\n  {{\"G.-\", \"d\", \"G.+\", \"D\"}, sm52MPAmplitude},\n  {{\"G.-\", \"d\", \"G.-\", \
\"D\"}, sm52MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm52_GdGD\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm52Export], sm52Export[\"Directory\"], sm52Export]", "Input",
               ExpressionUUID -> "d26ce49d-779a-45b4-8b96-7863e643cee5"],

