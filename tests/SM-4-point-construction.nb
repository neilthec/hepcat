Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "e87dba8a-7f1e-4e1a-95bc-29352c8f9b66"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "69d9fae0-0771-4da8-b94b-882bc625928e"],

Cell[CellGroupData[{

Cell["sm27Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm27_neNeZh\"}],\n  {\"ne\", \"Ne\"} -> {\"Z\", \"h\"},\n  {\n  \
{{\"ne\", \"Ne\", \"Z\", \"h\"}, sm27Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm27_neNeZh\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm27Export], sm27Export[\"Directory\"], sm27Export]",
               "Input", ExpressionUUID -> "55517bd3-418e-4de7-b764-d77e2216d570"],

