Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "5966b642-1334-4220-9c5d-8c7b56e30be2"],

Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "cc6e572a-65c3-4309-b113-f86b074923c5"],

Cell[CellGroupData[{

Cell["sm70Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm70_ZZZZ\"}],\n  {\"Z\", \"Z\"} -> {\"Z\", \"Z\"},\n  {\n  \
{{\"Z\", \"Z\", \"Z\", \"Z\"}, sm70Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm70_ZZZZ\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm70Export], sm70Export[\"Directory\"], sm70Export]", "Input",
               ExpressionUUID -> "9c6d4d74-dc07-4bd8-862b-c33b173cc5e6"],

