Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "69b9cbf9-80ca-4eb9-9d76-2e1b31b678b9"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "202e537d-2164-4b16-ad02-49e330e05c0a"],

Cell[CellGroupData[{

Cell["sm26Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm26_eEZh\"}],\n  {\"e\", \"E\"} -> {\"Z\", \"h\"},\n  {\n  \
{{\"e\", \"E\", \"Z\", \"h\"}, sm26Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm26_eEZh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm26Export], sm26Export[\"Directory\"], sm26Export]", "Input",
               ExpressionUUID -> "f998ae41-2dda-472f-8db4-9433a23c13c0"],

