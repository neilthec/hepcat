Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "713e9f18-d551-4937-8bf3-a58f5fd173e3"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "aeb57c45-286d-4e52-a826-8cb7e777b5e8"],

Cell[CellGroupData[{

Cell["sm56Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm56_UdWph\"}],\n  {\"U\", \"d\"} -> {\"W-\", \"h\"},\n  {\n  \
{{\"U\", \"d\", \"W+\", \"h\"}, sm56Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm56_UdWph\", Sequence \
@@ validationOptions];\nIf[AssociationQ[sm56Export], sm56Export[\"Directory\"], sm56Export]", "Input",
               ExpressionUUID -> "5993191b-511a-42a8-8a8a-c6e1298d5d5f"],

