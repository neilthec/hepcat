Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "69b9b9fe-17b6-4bdd-b977-ef7387967aa4"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "c3bd10ee-897d-48eb-bddc-32807e27a333"],

Cell[CellGroupData[{

Cell["sm31Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm31_uUAA\"}],\n  {\"u\", \"U\"} -> {\"A\", \"A\"},\n  {\n  \
{{\"u\", \"U\", \"A.+\", \"A.+\"}, sm31PPAmplitude},\n  {{\"u\", \"U\", \"A.+\", \"A.-\"}, \
sm31PMAmplitude},\n  {{\"u\", \"U\", \"A.-\", \"A.+\"}, sm31MPAmplitude},\n  {{\"u\", \"U\", \"A.-\", \
\"A.-\"}, sm31MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm31_uUAA\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm31Export], sm31Export[\"Directory\"], sm31Export]", "Input",
               ExpressionUUID -> "fcf70f00-5ffd-45ac-b2f2-94f036d5fa15"],

