Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "44525002-b260-4d08-bfe2-4981dcb2ade9"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "71880dce-9649-497f-94c8-70d02ffece57"],

Cell[CellGroupData[{

Cell["sm51Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm51_GuGU\"}],\n  {\"G\", \"u\"} -> {\"G\", \"u\"},\n  {\n  \
{{\"G.+\", \"u\", \"G.+\", \"U\"}, sm51PPAmplitude},\n  {{\"G.+\", \"u\", \"G.-\", \"U\"}, \
sm51PMAmplitude},\n  {{\"G.-\", \"u\", \"G.+\", \"U\"}, sm51MPAmplitude},\n  {{\"G.-\", \"u\", \"G.-\", \
\"U\"}, sm51MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm51_GuGU\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm51Export], sm51Export[\"Directory\"], sm51Export]", "Input",
               ExpressionUUID -> "269f3bdf-a0b3-46c0-984e-e8963ac7c18f"],

