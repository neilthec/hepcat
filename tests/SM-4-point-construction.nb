Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "133f1c45-0fd1-4caf-88e8-4f261141d73b"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "71e305c2-402b-4679-8c19-5db541adc7f0"],

Cell[CellGroupData[{

Cell["sm73Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm73_GGGG\"}],\n  {\"G\", \"G\"} -> {\"G\", \"G\"},\n  {\n  \
{{\"G.+\", \"G.+\", \"G.+\", \"G.+\"}, sm73PPPPAmplitude},\n  {{\"G.+\", \"G.+\", \"G.+\", \"G.-\"}, \
sm73PPPMAmplitude},\n  {{\"G.+\", \"G.+\", \"G.-\", \"G.+\"}, sm73PPMPAmplitude},\n  {{\"G.+\", \"G.+\", \
\"G.-\", \"G.-\"}, sm73PPMMAmplitude},\n  {{\"G.+\", \"G.-\", \"G.+\", \"G.+\"}, sm73PMPPAmplitude},\n  \
{{\"G.+\", \"G.-\", \"G.+\", \"G.-\"}, sm73PMPMAmplitude},\n  {{\"G.+\", \"G.-\", \"G.-\", \"G.+\"}, \
sm73PMMPAmplitude},\n  {{\"G.+\", \"G.-\", \"G.-\", \"G.-\"}, sm73PMMMAmplitude},\n  {{\"G.-\", \"G.+\", \
\"G.+\", \"G.+\"}, sm73MPPPAmplitude},\n  {{\"G.-\", \"G.+\", \"G.+\", \"G.-\"}, sm73MPPMAmplitude},\n  \
{{\"G.-\", \"G.+\", \"G.-\", \"G.+\"}, sm73MPMPAmplitude},\n  {{\"G.-\", \"G.+\", \"G.-\", \"G.-\"}, \
sm73MPMMAmplitude},\n  {{\"G.-\", \"G.-\", \"G.+\", \"G.+\"}, sm73MMPPAmplitude},\n  {{\"G.-\", \"G.-\", \
\"G.+\", \"G.-\"}, sm73MMPMAmplitude},\n  {{\"G.-\", \"G.-\", \"G.-\", \"G.+\"}, sm73MMMPAmplitude},\n  \
{{\"G.-\", \"G.-\", \"G.-\", \"G.-\"}, sm73MMMMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm73_GGGG\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm73Export], sm73Export[\"Directory\"], sm73Export]",
               "Input", CellLabel -> " In[46]:=", ExpressionUUID ->
                "3bf0cf92-21a4-43b0-b1a0-0105a8709910"],

