     TypeSystem`PackageScope`HeaderShape[<|{All, "Reference"} -> 
        1, {All, "Status"} -> 1, {All, "RequestedPoints"} -> 1|>, 
       TypeSystem`PackageScope`Limited[
        TypeSystem`PackageScope`ColumnShape[
         TypeSystem`PackageScope`Limited[
          
