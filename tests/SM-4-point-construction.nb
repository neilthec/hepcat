        Cell[CellGroupData[{Cell["C++ export and independent validation", "Subsection",
            ExpressionUUID -> "104d6b6f-75e7-47fe-8abb-f4d4a3ec41fd"], Cell["Run this cell after all \
helicity amplitudes above have completed successfully. One C++ class contains the complete helicity \
family. The saved Export variable keeps the build and both independent comparisons, including their \
random seeds. The final output is the generated directory on success; a failure remains visible.",
            "Text", ExpressionUUID -> "30ea5ee8-bf40-49ec-b8f2-61fc48a0b7e0"],
           Cell[CellGroupData[{Cell["sm02Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm02_uUUu\"}],\n  {\"u\", \"U\"} -> {\"u\", \"U\"},\n  {\n  \
{{\"u\", \"U\", \"U\", \"u\"}, sm02Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm02_uUUu\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm02Export], sm02Export[\"Directory\"], sm02Export]", "Input",
               CellLabel -> " In[16]:=", ExpressionUUID -> "77947c4e-9b56-43e4-847f-46ba8b2a0786"],
              Cell[BoxData[TagBox[TagBox[DynamicModuleBox[
                   {TypeSystem`NestedGrid`PackagePrivate`$state$$ = Association["InitialData" ->
                       {Association["Reference" -> "CalcHEP", "Status" -> "PASS", "RequestedPoints" ->
                          1000]}, "AllowEmbedding" -> True, "InitialShape" ->
                       TypeSystem`PackageScope`HeaderShape[Association[{All, "Reference"} -> 1,
                         {All, "Status"} -> 1, {All, "RequestedPoints"} -> 1],
