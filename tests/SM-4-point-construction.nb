Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "34a68213-cb17-4e9f-829a-f0bda9f227d9"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "8355a137-0b79-4220-8102-a0023cc9370c"],

Cell[CellGroupData[{

Cell["sm36Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm36_AdZD\"}],\n  {\"A\", \"d\"} -> {\"Z\", \"d\"},\n  {\n  \
{{\"A.+\", \"d\", \"Z\", \"D\"}, sm36PAmplitude},\n  {{\"A.-\", \"d\", \"Z\", \"D\"}, sm36MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm36_AdZD\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm36Export], sm36Export[\"Directory\"], sm36Export]", "Input",
               ExpressionUUID -> "41c86854-d064-432a-82e2-92d51f129565"],

