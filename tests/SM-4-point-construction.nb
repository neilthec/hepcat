Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "7859b32d-b9cd-4954-9d60-3815beb926f3"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "ed4d6b17-7eb0-45af-9e05-c4707f7350ff"],

Cell[CellGroupData[{

Cell["sm13Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm13_eENmnm\"}],\n  {\"e\", \"E\"} -> {\"nm\", \"Nm\"},\n  {\n  \
{{\"e\", \"E\", \"Nm\", \"nm\"}, sm13Amplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm13_eENmnm\", \
Sequence @@ validationOptions];\nIf[AssociationQ[sm13Export], sm13Export[\"Directory\"], sm13Export]",
               "Input", ExpressionUUID -> "784d9bb7-9ddd-4547-85fe-fc373ad19382"],

