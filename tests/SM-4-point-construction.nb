Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "c54753c7-de1d-4d08-b517-700621cf1eed"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "dbdb0b41-1279-4bed-bf8d-4fcc03c360d2"],

Cell[CellGroupData[{

Cell["sm35Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm35_AuZU\"}],\n  {\"A\", \"u\"} -> {\"Z\", \"u\"},\n  {\n  \
{{\"A.+\", \"u\", \"Z\", \"U\"}, sm35PAmplitude},\n  {{\"A.-\", \"u\", \"Z\", \"U\"}, sm35MAmplitude}\n  \
}, sm,\n  \"ProcessName\" -> \"sm35_AuZU\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm35Export], sm35Export[\"Directory\"], sm35Export]", "Input",
               ExpressionUUID -> "a39ad400-aa35-4500-becb-47998167b2d2"],

