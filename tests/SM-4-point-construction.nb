Cell[CellGroupData[{

Cell["C++ export and independent validation", "Subsection", ExpressionUUID ->
             "3c865d2a-fe9e-4200-afc6-bc87bb9180a2"],

Cell["Run this cell after all helicity amplitudes \
above have completed successfully. One C++ class contains the complete helicity family. The saved Export \
variable keeps the build and both independent comparisons, including their random seeds. The final \
output is the generated directory on success; a failure remains visible.", "Text",
            ExpressionUUID -> "135b9cca-ed53-4ef4-9d0e-a491bdd08a71"],

Cell[CellGroupData[{

Cell["sm32Export = WriteSPINASProcess[\n  \
FileNameJoin[{spinasOutputDirectory, \"sm32_dDAA\"}],\n  {\"d\", \"D\"} -> {\"A\", \"A\"},\n  {\n  \
{{\"d\", \"D\", \"A.+\", \"A.+\"}, sm32PPAmplitude},\n  {{\"d\", \"D\", \"A.+\", \"A.-\"}, \
sm32PMAmplitude},\n  {{\"d\", \"D\", \"A.-\", \"A.+\"}, sm32MPAmplitude},\n  {{\"d\", \"D\", \"A.-\", \
\"A.-\"}, sm32MMAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm32_dDAA\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm32Export], sm32Export[\"Directory\"], sm32Export]", "Input",
               ExpressionUUID -> "1515ca2d-d8ac-423d-86b8-4511046bb871"],

