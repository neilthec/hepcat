+  !AllTrue[fermions,HEPCATCovariantCurrentSources`Private`supportedFermionRowQ[#]&&MemberQ[{1,3},Abs[#[[8]]]]&],Return[False]];
+ reps=ConstructiveDiagrams`Private`colorParticleRepresentation[#,model]&/@process;
+ If[AnyTrue[reps,FailureQ],Return[False]];colored=DeleteCases[reps,1];
+ MemberQ[{2,4},Length[colored]]&&Count[colored,3]===Count[colored,-3]
+];
+ConstructiveDiagrams`Private`colorCurrentVectorSourceClass[___]:=False;
