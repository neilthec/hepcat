+(* The same injective symmetric-spin polynomial encoding used by the existing
+   colorless source. Only declared external massive-vector slots are mapped. *)
+ConstructiveDiagrams`Private`colorCurrentEncodeVector[expression_,process_List,model_List]:=Module[{rows,legs},
+ rows=HEPCATCovariantCurrentSources`Private`particleRow[#,model]&/@process;
+ If[!AllTrue[rows,ListQ],Return[Failure["UnknownExternalVectorMetadata",<||>]]];
+ legs=Select[Range[Length[process]],rows[[#,5]]===2&&rows[[#,6]]=!=0&];
+ expression/.((HoldPattern[Spinor["Spin","Upper",kind:("Angle"|"Square"),leg_Integer,
+   VectorSpinIndex[leg_Integer,1|2]]]/;MemberQ[legs,leg]):>Spinor["Spin",kind,leg])
+];
+(* Source flow comes from the model-owned ordered endpoint certificate. Actual
+   differentiated Feynman paths are read only from genuine lifted diagrams. *)
+ConstructiveDiagrams`Private`colorCurrentWickWitness[certificates_List,diagrams_:None]:=Module[
+ {pairs,paths,actual,signs,required={"Graph","ExternalParticles","CanonicalExternalParticles","Spin2","FermionRole","Propagators","LeafVertices"}},
+ If[!AllTrue[certificates,AssociationQ[#]&&ListQ[Lookup[#,"OrientedFermionEndpoints",None]]&],
+  Return[Failure["MissingOrderedSourceFermionEndpoints",<||>]]];
+ pairs=(Reverse/@#["OrientedFermionEndpoints"]&/@certificates);
+ If[!AllTrue[pairs,Function[lines,lines=!={}&&AllTrue[lines,MatchQ[#,{_Integer?Positive,_Integer?Positive}]&&First[#]=!=Last[#]&]&&DuplicateFreeQ[Flatten[lines]]]],
+  Return[Failure["MalformedOrderedSourceFermionEndpoints",<||>]]];
+ signs=ConstructiveDiagrams`Private`feynmanFermionPairSign/@pairs;
+ If[!AllTrue[signs,MemberQ[{-1,1},#]&],Return[Failure["UnresolvedSourcePairingWickParity",<||>]]];
+ If[diagrams=!=None,
+  If[!ListQ[diagrams]||Length[diagrams]=!=Length[certificates]||!AllTrue[diagrams,AssociationQ[#]&&ContainsAll[Keys[#],required]&],
+   Return[Failure["MissingDifferentiatedFeynmanDiagramMetadata",<||>]]];
+  paths=ConstructiveDiagrams`Private`feynmanFermionPaths/@diagrams;
+  If[!AllTrue[paths,ListQ]||!FreeQ[paths,_Failure],Return[Failure["UnresolvedDifferentiatedFermionFlow",<||>]]];
+  actual=Map[({First[#],Last[#]}&),paths,{2}];
+  If[!And@@MapThread[Sort[#1]===Sort[#2]&,{actual,pairs}]||
+    (ConstructiveDiagrams`Private`feynmanFermionPairSign/@actual)=!=signs,
+   Return[Failure["ActualFeynmanEndpointsOrWickParityDifferFromSource",<||>]]]];
+ MapThread[<|"BarToKetEndpoints"->Sort[#1],"WickParity"->#2|>&,{pairs,signs}]
+];
 
