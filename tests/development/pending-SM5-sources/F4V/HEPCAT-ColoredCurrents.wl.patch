+(* One new external class: four supported Dirac/Weyl endpoints and one singlet
+   vector. Its used rows must still pass the exact local-operator catalogue. *)
+ConstructiveDiagrams`Private`colorCurrentVectorSourceClass[process_List,model_List]:=Module[
+ {rows,fermions,vectors,reps,colored},
+ If[Length[process]=!=5||!AllTrue[process,StringQ]||Length[model]=!=4||!AllTrue[model,ListQ],Return[False]];
+ rows=HEPCATCovariantCurrentSources`Private`particleRow[#,model]&/@process;
