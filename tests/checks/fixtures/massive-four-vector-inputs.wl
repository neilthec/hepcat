Function[parameterLookup,
  Uncompress["1:"] /. Thread[
    (Inactive[ConstructiveDiagrams`ModelParameter] /@ {"MW", "EE", "MZ", "SW", "Mh"}) ->
    (parameterLookup /@ {"MW", "EE", "MZ", "SW", "Mh"})]
]
