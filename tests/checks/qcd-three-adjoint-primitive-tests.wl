 <|"Helicity"->hel,"Branch"->branch,"ExactFullTemplateValue"->g3TValue,"MissingSourceRowIsZero"->(g3TNativeZero===0)|>,{hel,{1,-1}},{branch,{"AngleCollinear","SquareCollinear"}}],1];
