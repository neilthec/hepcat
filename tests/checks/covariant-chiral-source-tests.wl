(* Portable production chiral-current and admission controls. No full construction. *)
root=DirectoryName[DirectoryName[DirectoryName[$InputFileName]]];
Get[FileNameJoin[{root,"source","HEPCAT.wl"}]];
Begin["HEPCATChiralProductionTest`Private`"];
$ContextPath=Prepend[DeleteCases[$ContextPath,"HEPCATChiralProductionTest`Private`"],"HEPCATChiralProductionTest`Private`"];
$HistoryLength=0;directory=DirectoryName[$InputFileName];root=DirectoryName[DirectoryName[directory]];
checks={};record[name_,value_]:=AppendTo[checks,<|"Name"->name,"Status"->If[TrueQ[value],"PASS","FAIL"]|>];
model=ReadModel[FileNameJoin[{root,"models"}],1];
parts=HEPCATCovariantCurrentSources`Private`rowParticles;
lift=HEPCATCovariantCurrentSources`Private`liftVertex;
neutral=SelectFirst[model[[2]],Sort[parts[#]]===Sort[{"ne","Ne","Z"}]&];
charged=SelectFirst[model[[2]],Sort[parts[#]]===Sort[{"e","Ne","W+"}]&];
massive=SelectFirst[model[[2]],Sort[parts[#]]===Sort[{"e","E","Z"}]&];
oldMassive=lift[massive,model];
record["baseline massive current is exactly certified",AssociationQ[oldMassive]&&oldMassive["ExactDifference"]===0];
record["production neutral chiral current is exactly supported",AssociationQ[lift[neutral,model]]];
Global`fermionEndpointHand="ambient endpoint";Global`declaredExternalSpinWeights="ambient weights";
ambient={OwnValues[Global`fermionEndpointHand],OwnValues[Global`declaredExternalSpinWeights]};
Get[FileNameJoin[{root,"source","internal","HEPCAT-CovariantSources.wl"}]];
Get[FileNameJoin[{root,"source","internal","HEPCAT-CovariantContacts.wl"}]];
record["fully qualified production helpers preserve ambient names",ambient==={OwnValues[Global`fermionEndpointHand],OwnValues[Global`declaredExternalSpinWeights]}];
started=AbsoluteTime[];
work[]:=Module[{n,w,m,meta,hand,expected,mv,g,toy,raw,unit,right,zero,duplicate,owned},
 meta=HEPCATCovariantCurrentSources`Private`particleRow;
 hand=HEPCATCovariantCurrentSources`Private`fermionEndpointHand;
 expected=HEPCATCovariantCurrentSources`Private`declaredExternalSpinWeights;
 n=lift[neutral,model];w=lift[charged,model];m=lift[massive,model];
 record["left neutral current has one nonzero projector and exact symbolic match",AssociationQ[n]&&n["ExactDifference"]===0&&n["ActiveTemplatePositions"]==={1}&&n["IdenticallyZeroTemplatePositions"]==={2}&&n["Coefficients"][[2]]===0];
 record["mixed massive/chiral charged current is exactly matched",AssociationQ[w]&&w["ExactDifference"]===0&&w["DeclaredFermionEndpointHands"]==={"Dirac","L"}&&w["IdenticallyZeroTemplatePositions"]==={2}];
 record["massive Dirac coefficients remain unchanged",AssociationQ[m]&&m["Coefficients"]===oldMassive["Coefficients"]&&m["IdenticallyZeroTemplatePositions"]==={}];
 record["declared neutral endpoint hands are preserved for both roles",hand["ne",model]==="L"&&hand["Ne",model]==="L"&&hand["e",model]==="Dirac"];
 record["left chiral weights distinguish particle and antiparticle",expected[{"ne","Ne","Z","h","h"},model]==={1,-1,2,0,0}&&expected[{"Ne","ne","Z","h","h"},model]==={-1,1,2,0,0}];
 mv=ModelParameter["vectorMass","tiny-right","Real"];g=ModelParameter["currentCoupling","tiny-right","Real"];
 toy={{{"right","q","Q",1,1,0,0,1,"R","q","Q"},{"vector","V","V",2,2,mv,0,1,"G","V","V"},{"scalar","s","s",3,0,mv,0,1,"","s","s"}}, {},{{mv,3},{g,2/7}}, {}};
 raw=DiracChain[FermionBar[2,0,"R"],(DiracWord[DiracGamma[LorentzIndex[3]]]+DiracWord[DiracGamma[LorentzIndex[3]],DiracGamma5])/2,FermionKet[1,0,"R"]]PolarizationVector[3,LorentzIndex[3],mv,Automatic];
 (* Distribute the projector before conversion so DiracChain retains one ordered word. *)
 raw=(DiracChain[FermionBar[2,0,"R"],DiracWord[DiracGamma[LorentzIndex[3]]],FermionKet[1,0,"R"]]+DiracChain[FermionBar[2,0,"R"],DiracWord[DiracGamma[LorentzIndex[3]],DiracGamma5],FermionKet[1,0,"R"]])PolarizationVector[3,LorentzIndex[3],mv,Automatic]/2;
 unit=HEPCATCovariantContactCalibration`Private`coherent[FeynmanToSpinorProducts[raw,"ReduceSpinorProducts"->False]];
 toy[[2]]={{"q","Q","V","",g,unit}};right=lift[First[toy[[2]]],toy];
 record["renamed right-handed toy chooses the other exact projector",AssociationQ[right]&&right["ExactDifference"]===0&&right["ActiveTemplatePositions"]==={2}&&right["Coefficients"]==={0,g}];
 record["right-handed endpoint weights reverse the left convention",expected[{"q","Q","V","s","s"},toy]==={-1,1,2,0,0}];
 record["undeclared massless Dirac helicity is rejected",FailureQ[hand["q",ReplacePart[toy,{1,1,9}->""]]]];
 zero=HEPCATCovariantCurrentSources`Private`exactVertexMatch[0,{0,0},{},toy];
 record["an entirely vanishing template space does not claim uniqueness",FailureQ[zero]];
 duplicate=HEPCATCovariantCurrentSources`Private`exactVertexMatch[g unit,{raw,raw},{3},toy];
 record["nonzero dependent templates remain unresolved rather than being dropped",FailureQ[duplicate]];
 record["new chiral certificates never fit parameter values or internal shells",And@@(AssociationQ[#]&&#["NumericalParameterAssignments"]==={}&&#["InternalOnShellConditions"]==={}&/@{n,w,right})];
 record["the used cubic catalog certifies both declared chiral currents",AssociationQ[HEPCATCovariantCurrentSources`Private`sourceCatalog[model,{neutral,charged}]]];
];
outcome=MemoryConstrained[TimeConstrained[work[],15,$TimedOut],2 2^30,$Aborted];
(* Negative metadata boundaries use mocks only; no five-point graph is generated. *)
electronPosition=First[FirstPosition[model[[1,All,2]],"e"]];
leftMassive=ReplacePart[model,{1,electronPosition,9}->"L"];rightMassive=ReplacePart[model,{1,electronPosition,9}->"R"];
record["massive L metadata is rejected consistently at the endpoint and row guard",FailureQ[HEPCATCovariantCurrentSources`Private`fermionEndpointHand["e",leftMassive]]&&!HEPCATCovariantCurrentSources`Private`supportedFermionRowQ[leftMassive[[1,electronPosition]]]];
record["massive R metadata is rejected consistently at the endpoint and row guard",FailureQ[HEPCATCovariantCurrentSources`Private`fermionEndpointHand["e",rightMassive]]&&!HEPCATCovariantCurrentSources`Private`supportedFermionRowQ[rightMassive[[1,electronPosition]]]];
lower=ReadModel[FileNameJoin[{root,"models"}],2];quartic=SelectFirst[model[[2]],Sort[parts[#]]===Sort[{"h","h","Z","Z"}]&];
definitionsBefore={DownValues[CreateDiagrams],DownValues[HEPCATCovariantCurrentSources`Private`usedRows],DownValues[HEPCATCovariantCurrentSources`Private`sourceCatalog]};
probeUsed[used_List]:=Internal`InheritedBlock[{CreateDiagrams,HEPCATCovariantCurrentSources`Private`usedRows,HEPCATCovariantCurrentSources`Private`sourceCatalog},
 Unprotect[CreateDiagrams];DownValues[CreateDiagrams]={};DownValues[HEPCATCovariantCurrentSources`Private`usedRows]={};DownValues[HEPCATCovariantCurrentSources`Private`sourceCatalog]={};
 CreateDiagrams[___]:={<|"StubOnly"->True|>};HEPCATCovariantCurrentSources`Private`usedRows[_List]:=used;
 catalogReached=False;HEPCATCovariantCurrentSources`Private`sourceCatalog[___]:=(catalogReached=True;Failure["DeliberatelyUncertifiedCubic",<||>]);
 probeResult=HEPCATCovariantContactCalibration`Private`calibratedCovariantSource[{"ne","Ne","Z","Z","h"},model,lower,"TimeConstraint"->2];
 {probeResult,catalogReached}];
empty=probeUsed[{}];quarticOnly=probeUsed[{quartic}];cubicOnly=probeUsed[{neutral}];higher=probeUsed[{neutral,{"ne","Ne","Z","h","h",1,1}}];
record["empty used vertices do not form a source candidate",FailureQ[First[empty]]&&First[empty][[1]]==="UnsupportedCalibratedSourceVertexArity"&&Last[empty]===False];
record["quartics alone cannot bypass the required nonempty cubic catalog",FailureQ[First[quarticOnly]]&&First[quarticOnly][[1]]==="UnsupportedCalibratedSourceVertexArity"&&Last[quarticOnly]===False];
record["empty quartics reach cubic certification and cannot bypass it",FailureQ[First[cubicOnly]]&&First[cubicOnly][[1]]==="UsedCubicCurrentNotCertified"&&Last[cubicOnly]===True];
record["an unsupported higher-arity used row is rejected before certification",FailureQ[First[higher]]&&First[higher][[1]]==="UnsupportedCalibratedSourceVertexArity"&&Last[higher]===False];
record["all mock diagram and catalog definitions are restored exactly",definitionsBefore==={DownValues[CreateDiagrams],DownValues[HEPCATCovariantCurrentSources`Private`usedRows],DownValues[HEPCATCovariantCurrentSources`Private`sourceCatalog]}];
summary=<|"Status"->If[MemberQ[{$TimedOut,$Aborted},outcome],"BOUNDED_CONTROL_UNFINISHED",If[AllTrue[checks,#["Status"]==="PASS"&],"PASS","FAIL"]],"Checks"->checks,"Count"->Length[checks],"Seconds"->N[AbsoluteTime[]-started],"FivePointPhysicsStarted"->False,"MockedFiveLegMetadataBoundariesOnly"->True,"ProductionChanged"->False|>;
Print["COVARIANT CHIRAL SOURCE CHECKS: ",Length[checks],"; FAILURES: ",Count[Lookup[checks,"Status"],"FAIL"]];
If[summary["Status"]==="PASS",Print["HEPCAT_TEST_COMPLETED:covariant-chiral-source-tests.wl"],Print[summary]];
End[];Quit[If[summary["Status"]==="PASS",0,1]];
