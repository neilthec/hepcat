(* Pure four-adjoint local tensor controls. No stored calibration, five-point
   expression, numerical point, benchmark or positive source admission. *)
HEPCATAuxiliaryTensorTests`repository=DirectoryName[DirectoryName[DirectoryName[$InputFileName]]];
HEPCATAuxiliaryTensorTests`source=Replace[Environment["HEPCAT_QCD_TEST_SOURCE"],{""->FileNameJoin[{HEPCATAuxiliaryTensorTests`repository,"source"}],Except[_String]->FileNameJoin[{HEPCATAuxiliaryTensorTests`repository,"source"}]}];
Get[FileNameJoin[{HEPCATAuxiliaryTensorTests`source,"HEPCAT.wl"}]];
$HistoryLength=0;
HEPCATAuxiliaryTensorTests`rows={};
HEPCATAuxiliaryTensorTests`test[HEPCATAuxiliaryTensorTests`name_String,HEPCATAuxiliaryTensorTests`value_]:=AppendTo[HEPCATAuxiliaryTensorTests`rows,<|"Test"->HEPCATAuxiliaryTensorTests`name,"Pass"->TrueQ[HEPCATAuxiliaryTensorTests`value]|>];
HEPCATAuxiliaryTensorTests`particle={"unit adjoint","V","V",21,2,0,0,8,"G","V","V"};
HEPCATAuxiliaryTensorTests`row={"V","V","V.t","",1,HEPCATCovariantContactCalibration`Private`adjointQuarticP2operator[]};
HEPCATAuxiliaryTensorTests`model=ConstructiveDiagrams`FeynmanModel[{HEPCATAuxiliaryTensorTests`particle},{HEPCATAuxiliaryTensorTests`row},{},{}];
HEPCATAuxiliaryTensorTests`before=HEPCATAuxiliaryTensorTests`model;
HEPCATAuxiliaryTensorTests`graphs=HEPCATCovariantContactCalibration`Private`adjointQuarticP2auxiliaryGraphs[HEPCATAuxiliaryTensorTests`model,ConstantArray["V.+",4],"V.t"];
HEPCATAuxiliaryTensorTests`test["All three constant auxiliary pairings generated",AssociationQ[HEPCATAuxiliaryTensorTests`graphs]&&Length[HEPCATAuxiliaryTensorTests`graphs["Graphs"]]===3];
If[!TrueQ[Last[HEPCATAuxiliaryTensorTests`rows]["Pass"]],Print[HEPCATAuxiliaryTensorTests`graphs];Quit[1]];
HEPCATAuxiliaryTensorTests`test["Three raw auxiliary diagrams form one logical contact",HEPCATAuxiliaryTensorTests`graphs["RawAuxiliaryGraphCount"]===3&&HEPCATAuxiliaryTensorTests`graphs["LogicalContactCount"]===1];
HEPCATAuxiliaryTensorTests`test["No auxiliary exchange contributes a physical pole",HEPCATAuxiliaryTensorTests`graphs["PhysicalPropagatorCount"]===0&&AllTrue[HEPCATAuxiliaryTensorTests`graphs["PairingCertificates"],#["PhysicalPoleCount"]===0&]];
HEPCATAuxiliaryTensorTests`test["Raw auxiliary diagrams are never original cubic diagrams",AllTrue[HEPCATAuxiliaryTensorTests`graphs["PairingCertificates"],#["RawGraphIsOriginalCubic"]===False&]];
HEPCATAuxiliaryTensorTests`test["Pairings are distinct and exhaust the three partitions",Sort[Lookup[HEPCATAuxiliaryTensorTests`graphs["PairingCertificates"],"Pairing"]]===Sort[HEPCATCovariantContactCalibration`Private`adjointQuarticP2metricPairings[]]];
HEPCATAuxiliaryTensorTests`test["All four external wavefunctions reconstruct exactly",AllTrue[HEPCATAuxiliaryTensorTests`graphs["Stripped"],#["ExactReconstruction"]&&#["WavefunctionCount"]===4&]];
HEPCATAuxiliaryTensorTests`basis=HEPCATCovariantContactCalibration`Private`adjointQuarticP1basis[];
HEPCATAuxiliaryTensorTests`test["Complete color and Bose metric basis",AssociationQ[HEPCATAuxiliaryTensorTests`basis]&&HEPCATAuxiliaryTensorTests`basis["ColourRank"]===8&&HEPCATAuxiliaryTensorTests`basis["BoseMetricRank"]===3];
HEPCATAuxiliaryTensorTests`test["Local basis does not claim calibrated model coefficients",HEPCATAuxiliaryTensorTests`basis["ModelCoefficientsDetermined"]===False&&HEPCATAuxiliaryTensorTests`basis["IndependentBenchmarkRead"]===False];
HEPCATAuxiliaryTensorTests`test["All24 Bose relations and Jacobi are exact",Length[HEPCATAuxiliaryTensorTests`basis["OrderedBoseZeroGrams"]]===24&&AllTrue[HEPCATAuxiliaryTensorTests`basis["OrderedBoseZeroGrams"],#===ConstantArray[0,{3,3}]&]&&HEPCATAuxiliaryTensorTests`basis["JacobiZeroGram"]===0];
HEPCATAuxiliaryTensorTests`symbols=Table[Unique["HEPCATAuxiliaryTensorTests`metric"],{3}];
HEPCATAuxiliaryTensorTests`unit=HEPCATCovariantContactCalibration`Private`adjointQuarticP2contractMetrics[#["Tensor"],HEPCATAuxiliaryTensorTests`symbols]&/@HEPCATAuxiliaryTensorTests`graphs["Stripped"];
HEPCATAuxiliaryTensorTests`q=Sum[HEPCATAuxiliaryTensorTests`basis["YMFFDirection"][[3(HEPCATAuxiliaryTensorTests`c-1)+HEPCATAuxiliaryTensorTests`m]] HEPCATAuxiliaryTensorTests`basis["RawColours"][[HEPCATAuxiliaryTensorTests`c]] HEPCATCovariantContactCalibration`Private`adjointQuarticP1metricExpression[HEPCATAuxiliaryTensorTests`basis["MetricDescriptors"][[HEPCATAuxiliaryTensorTests`m]]],{HEPCATAuxiliaryTensorTests`c,9},{HEPCATAuxiliaryTensorTests`m,3}];
HEPCATAuxiliaryTensorTests`target=HEPCATCovariantContactCalibration`Private`adjointQuarticP2contractMetrics[HEPCATAuxiliaryTensorTests`q,HEPCATAuxiliaryTensorTests`symbols];
HEPCATAuxiliaryTensorTests`test["Every metric forest contracts completely",AllTrue[HEPCATAuxiliaryTensorTests`unit,AssociationQ]&&AssociationQ[HEPCATAuxiliaryTensorTests`target]];
HEPCATAuxiliaryTensorTests`external=Thread[ConstructiveDiagrams`Mass/@Range[4]->ConstantArray[0,4]];
HEPCATAuxiliaryTensorTests`projection=ConstructiveDiagrams`Private`colorProjectionData[Join[({HEPCATAuxiliaryTensorTests`external,#}&/@HEPCATAuxiliaryTensorTests`basis["RawColours"]),{{HEPCATAuxiliaryTensorTests`external,Total[Lookup[HEPCATAuxiliaryTensorTests`unit,"Value"]]},{HEPCATAuxiliaryTensorTests`external,HEPCATAuxiliaryTensorTests`target["Value"]}}],{},{8,8,8,8}];
HEPCATAuxiliaryTensorTests`test["Full color projection reconstructs its exact Gram",AssociationQ[HEPCATAuxiliaryTensorTests`projection]&&Length[HEPCATAuxiliaryTensorTests`projection["Basis"]]===8&&HEPCATAuxiliaryTensorTests`projection["ColorTensorDeduplication"]["UniqueGramReconstructionVerified"]];
HEPCATAuxiliaryTensorTests`unitCoordinates=Table[Coefficient[HEPCATAuxiliaryTensorTests`projection["DiagramCoefficients"][[10,HEPCATAuxiliaryTensorTests`c]],HEPCATAuxiliaryTensorTests`symbols[[HEPCATAuxiliaryTensorTests`m]]],{HEPCATAuxiliaryTensorTests`c,8},{HEPCATAuxiliaryTensorTests`m,3}];
HEPCATAuxiliaryTensorTests`targetCoordinates=Table[Coefficient[HEPCATAuxiliaryTensorTests`projection["DiagramCoefficients"][[11,HEPCATAuxiliaryTensorTests`c]],HEPCATAuxiliaryTensorTests`symbols[[HEPCATAuxiliaryTensorTests`m]]],{HEPCATAuxiliaryTensorTests`c,8},{HEPCATAuxiliaryTensorTests`m,3}];
HEPCATAuxiliaryTensorTests`residuals=Map[Cancel[Together[#]]&,HEPCATAuxiliaryTensorTests`unitCoordinates+2 HEPCATAuxiliaryTensorTests`targetCoordinates,{2}];
HEPCATAuxiliaryTensorTests`test["All24 free Lorentz and color coordinates fix the unit tensor sign and normalization",Length[Flatten[HEPCATAuxiliaryTensorTests`residuals]]===24&&AllTrue[Flatten[HEPCATAuxiliaryTensorTests`residuals],#===0&]];
HEPCATAuxiliaryTensorTests`test["Opposite tensor sign rejects",AnyTrue[Flatten[HEPCATAuxiliaryTensorTests`unitCoordinates-2 HEPCATAuxiliaryTensorTests`targetCoordinates],#=!=0&]];
HEPCATAuxiliaryTensorTests`test["Wrong tensor magnitude rejects",AnyTrue[Flatten[4 HEPCATAuxiliaryTensorTests`unitCoordinates+2 HEPCATAuxiliaryTensorTests`targetCoordinates],#=!=0&]];
HEPCATAuxiliaryTensorTests`test["Auxiliary cannot appear externally",FailureQ[ConstructiveDiagrams`CreateDiagrams[{"V.t","V.+","V.+","V.+"},HEPCATAuxiliaryTensorTests`model]]];
HEPCATAuxiliaryTensorTests`test["Derived auxiliary alias collisions reject",FailureQ[HEPCATCovariantContactCalibration`Private`adjointQuarticP2collisionGuard[{{HEPCATAuxiliaryTensorTests`particle},{},{},{}},"V","V.t"]]];
HEPCATAuxiliaryTensorTests`test["Source model expression remains unchanged",HEPCATAuxiliaryTensorTests`model===HEPCATAuxiliaryTensorTests`before];
HEPCATAuxiliaryTensorTests`failed=Count[Lookup[HEPCATAuxiliaryTensorTests`rows,"Pass"],False];
Scan[If[!#["Pass"],Print["FAIL: ",#["Test"]]]&,HEPCATAuxiliaryTensorTests`rows];
Print[Length[HEPCATAuxiliaryTensorTests`rows]," local tensor controls; ",HEPCATAuxiliaryTensorTests`failed," failed"];
Print["HEPCAT_TEST_COMPLETED:qcd-four-adjoint-auxiliary-tests.wl"];
Quit[If[HEPCATAuxiliaryTensorTests`failed===0&&Length[HEPCATAuxiliaryTensorTests`rows]===17,0,1]];
