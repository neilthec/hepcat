(* Opt-in validation of every independent six-point entry in QED model 4.
   The amplitudes are read from the model, not regenerated by construction.
   Actual Feynman diagrams supply the independent off-cut comparison. *)
root = DirectoryName[DirectoryName[DirectoryName[$InputFileName]]];
Get[FileNameJoin[{root, "source", "HEPCAT.wl"}]];
$HistoryLength = 0;
modelDirectory = FileNameJoin[{root, "models"}];
model = ReadModel[modelDirectory, 4];
benchmark = ReadModel[FileNameJoin[{root, "model_feynman"}], 2];
processes = {
  {"e", "E", "A.+", "A.+", "A.+", "A.+"},
  {"e", "E", "A.+", "A.+", "A.+", "A.-"},
  {"e", "E", "A.+", "A.+", "A.-", "A.-"},
  {"e", "E", "A.+", "A.-", "A.-", "A.-"},
  {"e", "E", "A.-", "A.-", "A.-", "A.-"},
  {"e", "E", "E", "e", "A.+", "A.+"},
  {"e", "E", "E", "e", "A.+", "A.-"},
  {"e", "E", "E", "e", "A.-", "A.-"},
  {"e", "E", "e", "E", "e", "E"}};
ceilings = {120, 528, 1044, 528, 120, 1216, 1632, 1216, 3168};
spuriousCounts = {6, 4, 4, 4, 6, 1, 2, 1, 0};
physicalCounts = {14, 14, 14, 14, 14, 20, 20, 20, 18};
checks = 0; failures = {};
SetAttributes[check, HoldRest];
check[name_, test_] := (checks++; If[!TrueQ[test],
  AppendTo[failures, name]; Print["FAIL: ", name]]);
lookup[process_] := LookupAmplitude[
  MapIndexed[{#1, First[#2]} &, process], model, False, {mi, mj, mk, ml}];
rows = Select[model[[2]], Length[DeleteCases[Drop[#, -2], ""]] === 6 &];
check["all nine independent six-point multisets occur exactly once",
  Length[rows] === 9 &&
    Sort[Sort[DeleteCases[Drop[#, -2], ""]] & /@ rows] === Sort[Sort /@ processes]];
entries = Table[{processes[[i]], lookup[processes[[i]]]}, {i, Length[processes]}];
Do[
  check["saved amplitude is compact and reference free " <> ToString[i],
    !FreeQ[entries[[i, 2]], _SpinorChain] &&
      FreeQ[entries[[i, 2]], _Failure | _Missing | $Failed | $Aborted |
        _xFactor | _xTildeFactor | (Spinor | SpinorHat)["Xi", ___]] &&
      SpinorExpressionComplexity[entries[[i, 2]]] <= ceilings[[i]]],
  {i, Length[entries]}];
bytes = BinaryReadList[FileNameJoin[{modelDirectory, "amps4.mdl"}], "Byte"];
appendResult = AppendModelAmplitudes[modelDirectory, 4, entries];
check["the public writer rereads all nine entries without rewriting them",
  AssociationQ[appendResult] && appendResult["Added"] === 0 &&
    appendResult["Skipped"] === 9 &&
    BinaryReadList[FileNameJoin[{modelDirectory, "amps4.mdl"}], "Byte"] === bytes];

verify[expression_, process_, parameters_, seed_] := Module[{channels, feynman, report},
  channels = FactorizationAmplitudeChannels[process, model];
  feynman = DiagramAmplitudes[CreateDiagrams[process, benchmark]];
  report = TimeConstrained[MemoryConstrained[
    CheckAmplitudes[expression, channels, model,
      "FeynmanAmplitudes" -> feynman, "FeynmanModel" -> benchmark,
      "ParameterRules" -> parameters, "Samples" -> 2, "FeynmanSamples" -> 2,
      "HighEnergySamples" -> 1, "ReferenceSamples" -> 1,
      "TimeConstraint" -> 90, "FeynmanTimeConstraint" -> 90,
      "HighEnergyTimeConstraint" -> 60, "RandomSeed" -> seed,
      "Parallelization" -> False, "Output" -> "Details"],
    2147483648, Missing["MemoryLimit"]], 240, Missing["TimeLimit"]];
  report
];
Do[
  process = entries[[i, 1]];
  Print["BEGIN model-4 case ", i, " ", process];
  elapsed = AbsoluteTiming[report = verify[entries[[i, 2]], process,
    Automatic, 202611050000 + i];][[1]];
  check["fresh physical, spurious, high-energy, reference and Feynman checks " <> ToString[i],
    AssociationQ[report] && Length[report["Channels"]] === physicalCounts[[i]] &&
      Length[report["SpuriousChecks"]] === spuriousCounts[[i]] &&
      report["Summary"] === <|"PASS" -> physicalCounts[[i]] + spuriousCounts[[i]] + 3|> &&
      report["FeynmanCheck"]["CompletedSamples"] === 2];
  Print["RESULT ", i, " ", If[AssociationQ[report], report["Summary"], report],
    " seconds ", elapsed],
  {i, Length[entries]}];

(* Relabel only typed particle slots. A transposition of identical fermions
   supplies a minus sign; photon permutations supply none. These independent
   checks also change the model's mass and coupling parameters. *)
Do[
  {i, order, sign} = item;
  process = entries[[i, 1, order]];
  expression = sign ConstructiveDiagrams`Private`relabelLegs[
    entries[[i, 2]], AssociationThread[order, Range[6]]];
  Print["BEGIN signed permutation ", i, " ", process];
  report = verify[expression, process, {"Me" -> 3/7, "EE" -> 2}, 202611051000 + i];
  check["changed-mass signed permutation " <> ToString[i],
    AssociationQ[report] && Length[report["Checks"]] > 0 &&
      AllTrue[report["Checks"], #["Status"] === "PASS" &] &&
      report["FeynmanCheck"]["CompletedSamples"] === 2];
  Print["PERMUTATION RESULT ", i, " ", If[AssociationQ[report], report["Summary"], report]],
  {item, {{2, {1, 2, 6, 3, 4, 5}, 1}, {7, {4, 2, 3, 1, 6, 5}, -1},
    {9, {3, 2, 1, 4, 5, 6}, -1}}}];
Print["QED spurious model export checks: ", checks, "; failures: ", Length[failures]];
If[failures === {}, Print["HEPCAT_TEST_COMPLETED:qed-spurious-model-export-tests.wl"], Print[failures]];
Quit[If[failures === {}, 0, 1]];
