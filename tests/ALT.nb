 CellChangeTimes->{{3.991489137184761*^9, 
  3.991489140967881*^9}},ExpressionUUID->"477ff88c-2cf5-4e59-bcc9-\
d1ba11e39d3a"],

Cell[CellGroupData[{

Cell["FactorizationPartitions[particles_List]", "Subsubsection",
 CellChangeTimes->{{3.991492141126491*^9, 
  3.9914921527294493`*^9}},ExpressionUUID->"aa14adca-b7b2-4ebf-ba89-\
0b3ea7179540"],

Cell["\<\
This function partitions the particle list into pairs of groups where each \
group has at least two particles and all duplicates are removed.  Ordering \
doesn\[CloseCurlyQuote]t matter.  
\
\>", "Text",
 CellChangeTimes->{{3.991492176651381*^9, 
  3.9914923095402603`*^9}},ExpressionUUID->"845ba873-e906-44ba-a76f-\
83837c27a7d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FactorizationPartitions", "[", "particles_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"partitions", ",", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "particles", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "First", " ", "create", " ", "a", " ", "list", " ", "of", " ", "all", " ", 
      RowBox[{"partitions", "."}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"partitions", "=", 
      RowBox[{"Select", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{"particles", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"Floor", "[", 
             RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"2", "<=", 
          RowBox[{"Length", "[", "#", "]"}], "<=", 
          RowBox[{"n", "-", "2"}]}], " ", "&"}]}], "\[IndentingNewLine]", 
       "  ", "]"}]}], ";", "\[IndentingNewLine]", " ", 
     RowBox[{"partitions", "=", " ", 
      RowBox[{"DeleteDuplicatesBy", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Sort", " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"Complement", "[", 
              RowBox[{"particles", ",", "#"}], "]"}]}], "}"}]}], " ", "&"}], 
         " ", "/@", " ", "partitions"}], ",", "\[IndentingNewLine]", "    ", 
        "Sort"}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "partitions"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.991489199475038*^9, 3.9914892419625387`*^9}, {
   3.991489295742148*^9, 3.991489323307953*^9}, {3.991489572658195*^9, 
   3.991489617308901*^9}, {3.991489652037736*^9, 3.991489654503828*^9}, 
   3.9914898297918262`*^9, {3.991489895948242*^9, 3.991489902309574*^9}, {
