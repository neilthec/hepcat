Cell["Selection and Verification Helpers", "Section"],

Cell["(* Diagram selection uses only particle, mediator, and channel metadata. *)\nubCases = (Join[#, <|\"SourceName\" -> Lookup[#, \"SourceName\", #[\"Name\"]],\n  \"Name\" -> StringRiffle[#[\"Particles\"], \", \"]|>] &) /@ ubCases;\nubStatus[s_] := Style[s, Bold, If[s === \"PASS\", Darker[Green], Red]];\nubChannel[key_, permutation_] := Module[{parts = StringSplit[key, \":\"], legs},\n  If[Length[parts] =!= 2 || !MemberQ[{\"S\", \"T\", \"U\"}, Last[parts]], Return[key]];\n  legs = Sort[permutation[[Lookup[<|\"S\" -> {1, 2}, \"T\" -> {1, 3}, \"U\" -> {1, 4}|>, Last[parts]]]]];\n  If[!MemberQ[legs, 1], legs = Complement[Range[4], legs]];\n  First[parts] <> \":\" <> Switch[legs, {1, 2}, \"S\", {1, 3}, \"T\", {1, 4}, \"U\"]\n];\nubTable[rows_] := Dataset[(Join[#, <|\"Status\" -> ubStatus[#[\"Status\"]]|>] &) /@ rows];\nubRelabel[expr_, permutation_] := Module[{ids = AssociationThread[Range[4], permutation], idx},\n  idx[i_Integer] := Lookup[ids, i, i];\n  idx[Multiparticle[ii__]] := Multiparticle @@ (idx /@ {ii});\n  idx[x_] := x;\n  expr /. {\n    Spinor[k:(\"Spin\" | \"Helicity\"), t:(\"Angle\" | \"Square\"), i_, rest___] :> Spinor[k, t, idx[i], rest],\n    Spinor[k:(\"Spin\" | \"Helicity\"), ud_, t:(\"Angle\" | \"Square\"), i_, rest___] :> Spinor[k, ud, t, idx[i], rest],\n    SpinorHat[k:(\"Spin\" | \"Helicity\"), t:(\"Angle\" | \"Square\"), i_, rest___] :> SpinorHat[k, t, idx[i], rest],\n    SpinorHat[k:(\"Spin\" | \"Helicity\"), ud_, t:(\"Angle\" | \"Square\"), i_, rest___] :> SpinorHat[k, ud, t, idx[i], rest],\n    Mom[i_] :> Mom[idx[i]], MomHat[i_] :> MomHat[idx[i]], Mass[i_] :> Mass[idx[i]],\n    MomProd[i_, j_] :> MomProd[idx[i], idx[j]], Mandelstahm[i_, j_] :> Mandelstahm[idx[i], idx[j]],\n    MomProdHat1[i_, j_] :> MomProdHat1[idx[i], idx[j]],\n    MomProdHat2[i_, j_] :> MomProdHat2[idx[i], idx[j]],\n    MomProdHat12[i_, j_] :> MomProdHat12[idx[i], idx[j]],\n    xFactor[i_, j_] :> xFactor[idx[i], idx[j]]}\n];\nubMediator[d_] := Module[{props = Values[d[\"Propagators\"]], particle},\n  If[props === {}, Return[\"contact\"]];\n  particle = First[props][\"Particle\"];\n  Which[MemberQ[{\"A\", \"A.+\", \"A.-\"}, particle], \"A\",\n    MemberQ[{\"G\", \"G.+\", \"G.-\"}, particle], \"G\", True, particle]\n];\nubSelect[diagrams_, key_, sumAll_] := Module[{parts = StringSplit[key, \":\"]},\n  If[TrueQ[sumAll], Return[diagrams]];\n  Select[diagrams, ubMediator[#] === First[parts] &&\n    (Length[parts] === 1 || diagramChannel[#] === Last[parts]) &]\n];\nubReference[name_, key_] := Module[{source, matches},\n  source = \"SM-4-point-test.nb / \" <> name <> \" / \" <> key;\n  matches = Select[ubCatalog, MemberQ[#[\"Sources\"], source] &];\n  If[Length[matches] === 1, First[matches][\"Amplitude\"], Missing[\"Reference\", source]]\n];\n\nubCompare[got_, expected_, masses_] := Module[{check, assumptions, difference, sum},\n  assumptions = MW == MZ CW &&\n    Mandelstahm[1, 2] + Mandelstahm[1, 3] + Mandelstahm[1, 4] == Total[masses^2];\n  check[expr_] := TimeConstrained[\n    FullSimplify[ExtractMandelstahm[ReduceSpinorProducts[expr]], Assumptions -> assumptions],\n    verificationSeconds, $TimedOut];\n  If[got === expected, Return[<|\"Equivalence\" -> \"Exact\", \"Residual\" -> 0|>]];\n  difference = check[got - expected];\n  If[difference === 0, Return[<|\"Equivalence\" -> \"Proved\", \"Residual\" -> 0|>]];\n  sum = check[got + expected];\n  <|\"Equivalence\" -> Which[sum === 0, \"OppositeSign\",\n      difference === $TimedOut || sum === $TimedOut, \"VerificationTimeout\", True, \"Unresolved\"],\n    \"Residual\" -> difference|>\n];\n", "Input"],

Cell["<|\"ReferenceEntries\" -> Length[simplificationReferences],\n  \"ManualRoutes\" -> Length[simplificationRoutes],\n  \"EveryReferenceResolves\" -> And @@ Flatten[Table[\n    !MissingQ[ubReference[test[\"SourceName\"], channel]],\n    {test, ubCases}, {channel, test[\"Channels\"]}]]|>", "Input"],

