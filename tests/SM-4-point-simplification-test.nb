Notebook[{
Cell["SM Four-Point Manual Simplification Tests", "Title"],

Cell["Known reference amplitudes, symbolic comparison helpers, and the original handwritten diagram work. No learned policy is loaded. Manual derivations and their saved outputs are preserved below; historical neural input is explicitly archived.", "Text"],

Cell["Setup", "Section"],

Cell["hepcatDirectory = Replace[Environment[\"HEPCAT_TEST_ROOT\"],\n  Except[_String] :> DirectoryName[NotebookDirectory[]]];\n$HEPCATpath = FileNameJoin[{hepcatDirectory, \"source\"}];\nGet[FileNameJoin[{$HEPCATpath, \"HEPCAT.wl\"}]];\nGet[FileNameJoin[{hepcatDirectory, \"tests\", \"simplification-paths.wl\"}]];\nubModel = ReadModel[FileNameJoin[{hepcatDirectory, \"models\"}], 1];\nubCatalog = simplificationReferences;\nverificationSeconds = 5;", "Input"],

