Cell[CellGroupData[{

Cell["Diagram Runner and Independent Verification", "Section",ExpressionUUID->"0cc8eed9-b503-483f-b665-2efe4fb3a48a"],

Cell["\<\
The solver never sees the reference. Verification uses generic spinor-product \
reduction, Mandelstam extraction, and scalar algebra under MW = MZ CW and \
four-point invariant conservation, separately from the solver output. PASS \
requires proved same-sign equivalence and complexity no greater than the \
reference. EquivalentButLarger means algebraic agreement without reaching the \
target compactness. OppositeSign is not a pass. Unresolved does not prove \
inequivalence. No numeric spot checks are treated as proofs.\
\>", "Text",ExpressionUUID->"c68501e2-c8f7-491f-9a44-c1993ebc3238"],

Cell["\<\
(* Diagram selection uses only particle, mediator, and channel metadata. *)
ubCases = (Join[#, <|\"SourceName\" -> Lookup[#, \"SourceName\", \
#[\"Name\"]],
  \"Name\" -> StringRiffle[#[\"Particles\"], \", \"]|>] &) /@ ubCases;
ubStatus[s_] := Style[s, Bold, If[s === \"PASS\", Darker[Green], Red]];
ubChannel[key_, permutation_] := Module[{parts = StringSplit[key, \":\"], \
legs},
  If[Length[parts] =!= 2 || !MemberQ[{\"S\", \"T\", \"U\"}, Last[parts]], \
Return[key]];
  legs = Sort[permutation[[Lookup[<|\"S\" -> {1, 2}, \"T\" -> {1, 3}, \"U\" \
-> {1, 4}|>, Last[parts]]]]];
  If[!MemberQ[legs, 1], legs = Complement[Range[4], legs]];
  First[parts] <> \":\" <> Switch[legs, {1, 2}, \"S\", {1, 3}, \"T\", {1, 4}, \
\"U\"]
];
ubTable[rows_] := Dataset[(Join[#, <|\"Status\" -> ubStatus[#[\"Status\"]]|>] \
&) /@ rows];
ubRelabel[expr_, permutation_] := Module[{ids = AssociationThread[Range[4], \
permutation], idx},
  idx[i_Integer] := Lookup[ids, i, i];
  idx[Multiparticle[ii__]] := Multiparticle @@ (idx /@ {ii});
  idx[x_] := x;
  expr /. {
    Spinor[k:(\"Spin\" | \"Helicity\"), t:(\"Angle\" | \"Square\"), i_, \
rest___] :> Spinor[k, t, idx[i], rest],
    Spinor[k:(\"Spin\" | \"Helicity\"), ud_, t:(\"Angle\" | \"Square\"), i_, \
rest___] :> Spinor[k, ud, t, idx[i], rest],
    SpinorHat[k:(\"Spin\" | \"Helicity\"), t:(\"Angle\" | \"Square\"), i_, \
rest___] :> SpinorHat[k, t, idx[i], rest],
    SpinorHat[k:(\"Spin\" | \"Helicity\"), ud_, t:(\"Angle\" | \"Square\"), \
i_, rest___] :> SpinorHat[k, ud, t, idx[i], rest],
    Mom[i_] :> Mom[idx[i]], MomHat[i_] :> MomHat[idx[i]], Mass[i_] :> \
Mass[idx[i]],
    MomProd[i_, j_] :> MomProd[idx[i], idx[j]], Mandelstahm[i_, j_] :> \
Mandelstahm[idx[i], idx[j]],
    MomProdHat1[i_, j_] :> MomProdHat1[idx[i], idx[j]],
    MomProdHat2[i_, j_] :> MomProdHat2[idx[i], idx[j]],
    MomProdHat12[i_, j_] :> MomProdHat12[idx[i], idx[j]],
    xFactor[i_, j_] :> xFactor[idx[i], idx[j]]}
];
ubMediator[d_] := Module[{props = Values[d[\"Propagators\"]], particle},
  If[props === {}, Return[\"contact\"]];
  particle = First[props][\"Particle\"];
  Which[MemberQ[{\"A\", \"A.+\", \"A.-\"}, particle], \"A\",
    MemberQ[{\"G\", \"G.+\", \"G.-\"}, particle], \"G\", True, particle]
];
ubSelect[diagrams_, key_, sumAll_] := Module[{parts = StringSplit[key, \":\"]},
  If[TrueQ[sumAll], Return[diagrams]];
  Select[diagrams, ubMediator[#] === First[parts] &&
    (Length[parts] === 1 || diagramChannel[#] === Last[parts]) &]
];
ubReference[name_, key_] := Module[{source, matches},
  source = \"SM-4-point-test.nb / \" <> name <> \" / \" <> key;
  matches = Select[ubCatalog, MemberQ[#[\"Sources\"], source] &];
  If[Length[matches] === 1, First[matches][\"Amplitude\"], \
Missing[\"Reference\", source]]
];

(* No reference expression is passed to the solver. Public diagramAmplitudes
   pairs internal massless-vector helicities, just as in the manual tests.
   Generic spin contractions are optional input preparation. *)
ubSolve[pair_] := UnscrambleTrace[pair, \"Model\" -> unscrambleModel,
  \"MaxSteps\" -> maxSteps,
  \"MaxStagnantSteps\" -> maxStagnantSteps, \"ProgressReporting\" -> \
liveProgress,
  \"Attempts\" -> attempts, \"TimeLimit\" -> solverSeconds,
  \"ModelDirectory\" -> FileNameJoin[{hepcatDirectory, \"tests\"}]];
ubSimplifyDiagrams[diagrams_, masses_, permutation_:Range[4]] := Module[
  {external, groups, pieces, pair, raw, prepared, trace, combined, finalTrace},
  external = Thread[(Mass /@ Range[4]) -> masses];
  groups = GatherBy[diagramAmplitudes[diagrams], First];
  pieces = Table[
    pair = {Join[external, Select[First[group][[1]],
        MatchQ[First[#], Mass[_Multiparticle]] &]], Total[group[[All, 2]]]};
    pair = ubRelabel[pair, permutation];
    raw = pair[[2]] /. pair[[1]];
    prepared = If[TrueQ[contractSpinIndices], ReduceSpinContractions[raw], \
raw];
    trace = ubSolve[{pair[[1]], prepared}];
    If[!AssociationQ[trace] || !TrueQ[trace[\"ModelLoaded\"]] || TrueQ[trace[\
\"ScoringFailed\"]],
      Return[Failure[\"Solver\", <|\"Trace\" -> trace|>], Module]];
    <|\"MassRules\" -> pair[[1]], \"Raw\" -> raw, \"Prepared\" -> prepared,
      \"Output\" -> trace[\"Result\"][[2]], \"Trace\" -> trace|>, {group, \
groups}];
  If[!ListQ[pieces], Return[pieces]];
  combined = Total[Lookup[pieces, \"Output\"]];
  (* Never impose different channel poles simultaneously on a channel sum. *)
  finalTrace = If[Length[pieces] > 1, ubSolve[{ubRelabel[external, \
permutation], combined}], First[pieces][\"Trace\"]];
  If[!AssociationQ[finalTrace] || !TrueQ[finalTrace[\"ModelLoaded\"]] || \
TrueQ[finalTrace[\"ScoringFailed\"]],
    Return[Failure[\"Solver\", <|\"Trace\" -> finalTrace|>]]];
  <|\"Raw\" -> Total[Lookup[pieces, \"Raw\"]], \"Prepared\" -> \
Total[Lookup[pieces, \"Prepared\"]],
    \"Output\" -> finalTrace[\"Result\"][[2]], \"Pieces\" -> pieces, \
\"FinalTrace\" -> finalTrace|>
];

(* Verification is separate from inference. A nonzero symbolic residual is
   inconclusive: this bounded verifier is not a complete spinor identity \
prover. *)
ubCompare[got_, expected_, masses_] := Module[{check, assumptions, \
difference, sum},
  assumptions = MW == MZ CW &&
    Mandelstahm[1, 2] + Mandelstahm[1, 3] + Mandelstahm[1, 4] == \
Total[masses^2];
  check[expr_] := TimeConstrained[
    FullSimplify[ExtractMandelstahm[ReduceSpinorProducts[expr]], Assumptions \
-> assumptions],
    verificationSeconds, $TimedOut];
  If[got === expected, Return[<|\"Equivalence\" -> \"Exact\", \"Residual\" -> \
0|>]];
  difference = check[got - expected];
  If[difference === 0, Return[<|\"Equivalence\" -> \"Proved\", \"Residual\" \
-> 0|>]];
  sum = check[got + expected];
  <|\"Equivalence\" -> Which[sum === 0, \"OppositeSign\",
      difference === $TimedOut || sum === $TimedOut, \"VerificationTimeout\", \
True, \"Unresolved\"],
    \"Residual\" -> difference|>
];
ubResult[test_, key_, diagrams_, permutation_:Range[4]] := Module[{selected, \
expected, solved, comparison, compact, status, elapsed, display, masses},
  display = StringRiffle[test[\"Particles\"][[Ordering[permutation]]], \", \"];
  masses = test[\"Masses\"][[Ordering[permutation]]];
  selected = ubSelect[diagrams, key, Lookup[test, \"SumAll\", False]];
  expected = ubRelabel[ubReference[Lookup[test, \"SourceName\", \
test[\"Name\"]], key], permutation];
  If[MissingQ[expected] || selected === {}, Return[<|\"Process\" -> display, \
\"Permutation\" -> permutation, \"SourceChannel\" -> key, \"Channel\" -> \
ubChannel[key, permutation],
    \"Status\" -> If[MissingQ[expected], \"MissingReference\", \
\"MissingDiagrams\"]|>]];
  {elapsed, solved} = AbsoluteTiming[TimeConstrained[
    BlockRandom[SeedRandom[Hash[{test[\"Name\"], key, \
\"UnscrambleBenchmark\"}]];
      ubSimplifyDiagrams[selected, test[\"Masses\"], permutation]], \
caseSeconds, $TimedOut]];
  If[!AssociationQ[solved], Return[<|\"Process\" -> display, \"Permutation\" \
-> permutation, \"SourceChannel\" -> key, \"Channel\" -> ubChannel[key, \
permutation],
    \"Status\" -> If[solved === $TimedOut, \"SolverTimeout\", \
\"SolverError\"], \"Details\" -> solved,
    \"Seconds\" -> elapsed|>]];
  comparison = ubCompare[solved[\"Output\"], expected, masses];
  compact = SpinorExpressionComplexity[solved[\"Output\"]] <= \
SpinorExpressionComplexity[expected];
  status = If[MemberQ[{\"Exact\", \"Proved\"}, comparison[\"Equivalence\"]],
    If[TrueQ[compact], \"PASS\", \"EquivalentButLarger\"], \
comparison[\"Equivalence\"]];
  Join[<|\"Process\" -> display, \"Permutation\" -> permutation, \
\"SourceChannel\" -> key, \"Channel\" -> ubChannel[key, permutation], \
\"Status\" -> status,
    \"Diagrams\" -> Length[selected], \"Seconds\" -> elapsed,
    \"RawComplexity\" -> SpinorExpressionComplexity[solved[\"Raw\"]],
    \"InputComplexity\" -> SpinorExpressionComplexity[solved[\"Prepared\"]],
    \"OutputComplexity\" -> SpinorExpressionComplexity[solved[\"Output\"]],
    \"ReferenceComplexity\" -> SpinorExpressionComplexity[expected],
    \"ReachedReferenceComplexity\" -> compact, \"Reference\" -> expected|>, \
comparison, solved]
];
ubRun[selection_:All] := Module[{chosen, diagrams, row},
  If[!ListQ[particlePermutations] || particlePermutations === {} ||
    !AllTrue[particlePermutations, Sort[#] === Range[4] &], \
Return[Failure[\"InvalidPermutations\", <||>]]];
  chosen = If[selection === All, ubCases, Select[ubCases, \
MemberQ[Flatten[{selection}], #[\"Name\"]] &]];
  ubResults = {};
  Do[
    diagrams = TimeConstrained[CreateDiagrams[test[\"Particles\"], ubModel], \
diagramSeconds, $TimedOut];
    Do[
      row = If[ListQ[diagrams], ubResult[test, key, diagrams, permutation],
        <|\"Process\" -> \
StringRiffle[test[\"Particles\"][[Ordering[permutation]]], \", \"],
          \"Permutation\" -> permutation, \"SourceChannel\" -> key, \"Channel\
\" -> ubChannel[key, permutation], \"Status\" -> \"DiagramError\", \
\"Details\" -> diagrams|>];
      AppendTo[ubResults, row];
      Print[row[\"Process\"], \"  \", row[\"Channel\"], \"  \", permutation, \
\"  \", ubStatus[row[\"Status\"]]],
      {key, test[\"Channels\"]}, {permutation, particlePermutations}], {test, \
chosen}];
  Print[Counts[Lookup[ubResults, \"Status\"]]];
  ubTable[KeyTake[#, {\"Process\", \"Permutation\", \"Channel\", \"Status\", \
\"Diagrams\", \"Seconds\",
    \"InputComplexity\", \"OutputComplexity\", \"ReferenceComplexity\"}] & /@ \
ubResults]
];
\
\>", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"9ef7a917-3a2b-402e-b334-a65816123ce5"]
}, Open  ]],

