Notebook[{

Cell[CellGroupData[{
Cell["SM Four-Point Unscrambler Tests", "Title",ExpressionUUID->"58e4ab54-89f4-49bd-9542-6cd56c05699c"],

Cell["\<\
Build the same diagrams as SM-4-point-test.nb, then test the selected model \
without process-specific simplification recipes or \
SimplifySpinorProducts. The source notebooks are not evaluated or modified. \
Reference formulas come from the shared training-amplitudes.wl catalog; this \
is a diagram-to-reference regression benchmark, not an unseen-process \
generalization test.\
\>", "Text",ExpressionUUID->"86684485-f9c1-44f4-83bf-61b8faaa563e"],

Cell[CellGroupData[{

Cell["Setup and Limits", "Section",ExpressionUUID->"4c2ccecd-b400-4510-a129-af43fbacd7ec"],

Cell[CellGroupData[{

Cell["\<\
unscrambleModel = \"CompactActions\"; (* Or \"CandidateScorer\". *)
hepcatDirectory = Replace[Environment[\"HEPCAT_TEST_ROOT\"],
  Except[_String] :> DirectoryName[NotebookDirectory[]]];
$HEPCATpath = FileNameJoin[{hepcatDirectory, \"source\"}];
Get[FileNameJoin[{$HEPCATpath, \"HEPCAT.wl\"}]];
Get[FileNameJoin[{hepcatDirectory, \"tests\", \"unscrambling.wl\"}]];
ubModel = ReadModel[FileNameJoin[{hepcatDirectory, \"models\"}], 1];
ubCatalog = Get[FileNameJoin[{hepcatDirectory, \"tests\", \
\"training-amplitudes.wl\"}]];

testAllPermutations = False; (* True tests all 24 particle-label \
permutations. *)
particlePermutations := If[TrueQ[testAllPermutations], \
Permutations[Range[4]], {Range[4]}];
selectedProcesses = All; (* Or {\"e, E, M, m\"}, using a Name from ubCases. \
*)
contractSpinIndices = True; (* False sends raw diagram expressions directly. *)
maxSteps = Infinity;
maxStagnantSteps = 5;
liveProgress = True;
SetOptions[UnscrambleSpinorAmplitudes,
  \"MaxSteps\" -> maxSteps, \"MaxStagnantSteps\" -> maxStagnantSteps,
  \"ProgressReporting\" -> liveProgress];
SetOptions[UnscrambleTrace,
  \"MaxSteps\" -> maxSteps, \"MaxStagnantSteps\" -> maxStagnantSteps,
  \"ProgressReporting\" -> liveProgress];
attempts = 2;
solverSeconds = 10;
caseSeconds = 60;
verificationSeconds = 5;
diagramSeconds = 20;\
\>", "Input",
 CellChangeTimes->{4.0003001616551*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"bbcbacc8-b381-4345-bbb5-f75a04acf458"],

