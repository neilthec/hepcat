Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"c, u, C, U\"\>", "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"A\"\>", "\[InvisibleSpace]", "\<\"  \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
