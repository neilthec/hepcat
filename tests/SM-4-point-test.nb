Cell["Hardcoded amplitudes (copied from SM-4-point.nb)", "Section",ExpressionUUID->"1381e3a2-f57c-41eb-80ec-e6082af94eba"],

Cell["mReplacments = {};", "Input",
 CellChangeTimes->{3.997888771219178*^9},
 CellLabel->
