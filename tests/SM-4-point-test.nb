Mf^2)/(Mandelstahm[1, 4] - Mf^2)); ;
ampgfAfpmTested[] := ampgfAfpmTestedTmp[] //. {pre -> 2*g2*GG};
ampffWhWTestedTmp[] := (-preW)*((2*MW^2*rsp[\"<13>[23]\"] + (M2*rsp[\"<12>\"] \
