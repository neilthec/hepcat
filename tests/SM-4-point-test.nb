EE*EE*Q1*(M1/(Sqrt[2]*MW*SW))};
ampffZhZSTestedTmp[] := Collect[preZ*((M1*(gL1 - gR1)*spPr[\"(<12>-[12])[343>\
\"] + 2*MZ^2*(gL1*spPr[\"[23]<13>\"] + \
gR1*spPr[\"[13]<23>\"]))/(Mandelstahm[1, 2] - MZ^2)), {gL1, gR1}, Simplify]; \
;
ampffZhZSTested[] := ampffZhZSTestedTmp[] //. {preZ -> \
Sqrt[2]*EE*(EE/(4*MW*MW*SW*SW))};
ampffZhfTTestedTmp[] := Collect[preTU*((gL1*spPr[\"<13>\"]*(spPr[\"[342>\"] + \
2*M1*spPr[\"[23]\"]) + gR1*spPr[\"[13]\"]*(2*M1*spPr[\"<23>\"] + spPr[\"[243>\
\"]))/(Mandelstahm[1, 3] - M1^2)), {gL1, gR1}, Simplify]; ;
ampffZhfTTested[] := ampffZhfTTestedTmp[] //. {preTU -> \
Sqrt[2]*EE*EE*(M1/(4*MW*MW*SW*SW))};
ampffZhfUTestedTmp[] := Collect[preTU*((gL1*spPr[\"[23]\"]*(spPr[\"[143>\"] + \
2*M1*spPr[\"<13>\"]) + gR1*spPr[\"<23>\"]*(2*M1*spPr[\"[13]\"] + spPr[\"[341>\
\"]))/(Mandelstahm[1, 4] - M1^2)), {gL1, gR1}, Simplify]; ;
ampffZhfUTested[] := ampffZhfUTestedTmp[] //. {preTU -> \
Sqrt[2]*EE*EE*(M1/(4*MW*MW*SW*SW))};
ampffApApTested[] := 2*Q1^2*EE^2*M1*(spPr[\"[34]^2<12>\"]/(Mandelstahm[1, 3] \
- M1^2)/(Mandelstahm[1, 4] - M1^2));
ampffApAmTested[] := \
-2*Q1^2*EE^2*(spPr[\"([13]<24>+[23]<14>)[314>\"]/(Mandelstahm[1, 3] - \
M1^2)/(Mandelstahm[1, 4] - M1^2));
ampAfZfTestedTmp[] := Collect[pre*(((MZ*rsp[\"[14][123>\"] - \
M2*rsp[\"[13][134>\"])*gL2*rsp[\"<23>\"] + ((-M2)*rsp[\"[13][132>\"] + \
MZ*rsp[\"[12][143>\"])*gR2*rsp[\"<34>\"])/(Mandelstahm[1, 2] - \
M2^2)/(Mandelstahm[1, 4] - M2^2)), {gL2, gR2}, Simplify]; ;
ampAfZfTested[] := ampAfZfTestedTmp[] /. pre -> Q2*(EE^2/(MW*SW));
ampffZZhSTestedTmp[] := \
-Simplify[preh*(rsp[\"[34]<34>([12]+<12>)\"]/(Mandelstahm[1, 2] - Mh^2))]; ;
ampffZZhSTested[] := ampffZZhSTestedTmp[] /. preh -> \
EE*EE*(M1/(2*MW*MW*SW*SW));
ampffZZfTTestedTmp[] := (-preTU)*gL1^2*rsp[\"[24]<13>\"]*((MZ*rsp[\"<34>\"] + \
rsp[\"[314>\"])/(M1^2 - Mandelstahm[1, 3])) - \
preTU*gR1^2*rsp[\"[13]<24>\"]*((MZ*rsp[\"[34]\"] + rsp[\"[413>\"])/(M1^2 - \
Mandelstahm[1, 3])) - preTU*gL1*gR1*M1*(rsp[\"[13][24]<34>+[34]<13> \
<24>\"]/(M1^2 - Mandelstahm[1, 3])); ;
ampffZZfTTested[] := ampffZZfTTestedTmp[] /. preTU -> \
EE*(EE/(2*MW*MW*SW*SW));
ampffZZfUTestedTmp[] := (-preTU)*gL1^2*rsp[\"[23]<14>\"]*((MZ*rsp[\"<34>\"] - \
rsp[\"[413>\"])/(Mandelstahm[1, 4] - M1^2)) - \
preTU*gR1^2*rsp[\"[14]<23>\"]*((MZ*rsp[\"[34]\"] - \
rsp[\"[314>\"])/(Mandelstahm[1, 4] - M1^2)) - preTU*gL1*gR1*M1*(rsp[\"[14] \
[23] <34>+[34] <14> <23>\"]/(Mandelstahm[1, 4] - M1^2)); ;
ampffZZfUTested[] := ampffZZfUTestedTmp[] /. preTU -> \
EE*(EE/(2*MW*MW*SW*SW));
ampffWWhSTestedTmp[] := \
-Simplify[preh*(rsp[\"[34]<34>([12]+<12>)\"]/(Mandelstahm[1, 2] - Mh^2))]; ;
ampffWWhSTested[] := ampffWWhSTestedTmp[] /. preh -> \
EE*EE*(M1/(2*MW*MW*SW*SW));
ampffWWZSTestedTmp[] := \
-Collect[(-preZ)*gL1*((M1*rsp[\"[34]<34>([12]-<12>)\"] + \
2*rsp[\"[34]<34>[231>\"] + \
2*MW*rsp[\"([23]<14>+[24]<13>)([34]+<34>)\"])/(Mandelstahm[1, 2] - MZ^2)) - \
preZ*gR1*((M1*rsp[\"[34]<34>(-[12]+<12>)\"] + 2*rsp[\"[34]<34>[132>\"] + \
2*MW*rsp[\"([13]<24>+[14]<23>)([34]+<34>)\"])/(Mandelstahm[1, 2] - MZ^2)), \
{gL1, gR1}, Simplify]; ;
ampffWWZSTested[] := ampffWWZSTestedTmp[] /. preZ -> EE*(EE/(2*MW*MW*SW*SW));
ampffWWASTested[] := Collect[2*Q1*(EE^2/MW)*(rsp[\"( <13>[24]+[13]<24>+ \
<14>[23]+[14]<23>)( <34>+[34])\"]/Mandelstahm[1, 2]) + \
2*Q1*(EE^2/MW/MW)*(rsp[\"[34]<34>([231>+[132>)\"]/Mandelstahm[1, 2]), MW, \
Simplify];
ampffWWfTTestedTmp[] := pred*rsp[\"[24]<13>\"]*((rsp[\"[314>\"] + \
MW*rsp[\"<34>\"])/(Mandelstahm[1, 3] - Mprop^2)); ;
ampffWWfTTested[] := ampffWWfTTestedTmp[] /. pred -> EE*(EE/(MW*MW*SW*SW));
ampffWWfUTestedTmp[] := (-pred)*rsp[\"[23]<14>\"]*((MW*rsp[\"<34>\"] - \
rsp[\"[413>\"])/(Mandelstahm[1, 4] - Mprop^2)); ;
ampffWWfUTested[] := ampffWWfUTestedTmp[] /. pred -> EE*(EE/(MW*MW*SW*SW));
amphgffTestedTmp[] := (-pre)*(((-Mh^2)*rsp[\"[24][23]\"] + Mf*rsp[\"[24][213>\
\"] + Mf*rsp[\"[23][214>\"] + rsp[\"<34>[2312]\"])/(Mandelstahm[1, 3] - \
Mf^2)/(Mandelstahm[1, 4] - Mf^2)); ;
amphgffTested[] := amphgffTestedTmp[] //. {pre -> \
EE*GG*(Mf/(Sqrt[2]*MW*SW))};
ampgfZfTestedTmp[] := Collect[pre*(((MZ*rsp[\"[14][123>\"] - \
Mf*rsp[\"[13][134>\"])*gLf*rsp[\"<23>\"] + ((-Mf)*rsp[\"[13][132>\"] + \
MZ*rsp[\"[12][143>\"])*gRf*rsp[\"<34>\"])/(Mandelstahm[1, 2] - \
Mf^2)/(Mandelstahm[1, 4] - Mf^2)), {gLf, gRf}, Simplify]; ;
ampgfZfTested[] := ampgfZfTestedTmp[] /. pre -> (EE*GG)/(MW*SW);
ampgfAfppTestedTmp[] := pre*(rsp[\"[13]^2<24>\"]/(Mandelstahm[1, 2] - \
Mf^2)/(Mandelstahm[1, 4] - Mf^2)); ;
ampgfAfppTested[] := ampgfAfppTestedTmp[] //. {pre -> 2*g2*GG*Mf};
ampgfAfpmTestedTmp[] := \
pre*(rsp[\"([14]<23>-[12]<34>)[123>\"]/(Mandelstahm[1, 2] - \
Mf^2)/(Mandelstahm[1, 4] - Mf^2)); ;
ampgfAfpmTested[] := ampgfAfpmTestedTmp[] //. {pre -> 2*g2*GG};
ampffWhWTestedTmp[] := (-preW)*((2*MW^2*rsp[\"<13>[23]\"] + (M2*rsp[\"<12>\"] \
- M1*rsp[\"[12]\"])*rsp[\"[343>\"])/(Mandelstahm[1, 2] - MW^2)); ;
ampffWhWTested[] := ampffWhWTestedTmp[] /. preW -> EE*(EE/(2*MW*MW*SW*SW));
ampffWhfTTestedTmp[] := (-pred)*rsp[\"<13>\"]*((2*M2*rsp[\"[23]\"] + \
rsp[\"[342>\"])/(Mandelstahm[1, 3] - M2^2)); ;
ampffWhfTTested[] := ampffWhfTTestedTmp[] /. pred -> \
EE*EE*(M2/(2*MW*MW*SW*SW));
ampffWhfUTestedTmp[] := (-preu)*rsp[\"[23]\"]*((2*M1*rsp[\"<13>\"] + \
rsp[\"[143>\"])/(Mandelstahm[1, 4] - M1^2)); ;
ampffWhfUTested[] := ampffWhfUTestedTmp[] /. preu -> \
EE*EE*(M1/(2*MW*MW*SW*SW));
prop = (1/3)*((QW/(Mandelstahm[1, 2] - MW^2))*(1/(Mandelstahm[1, 4] - Md^2) - \
1/(Mandelstahm[1, 3] - Mu^2)) + (Qu/(Mandelstahm[1, 3] - \
Mu^2))*(1/(Mandelstahm[1, 4] - Md^2) - 1/(Mandelstahm[1, 2] - MW^2)) + \
(Qd/(Mandelstahm[1, 4] - Md^2))*(1/(Mandelstahm[1, 3] - Mu^2) - \
1/(Mandelstahm[1, 2] - MW^2))); ;
propSimpB = (-(Mandelstahm[1, 2] - MW^2)^(-1))*(Qu/(Mandelstahm[1, 3] - Mu^2) \
+ Qd/(Mandelstahm[1, 4] - Md^2)); ;
ampAWffWTestedTmp[] := (-pre)*rsp[\"<24>\"]*((-MW)*rsp[\"[13][142>\"] + \
rsp[\"[12]\"]*(M4^2*rsp[\"[13]\"] - M3*rsp[\"[143>\"]))*propSimpB; ;
ampAWffWTested[] := ampAWffWTestedTmp[] /. pre -> Sqrt[2]*EE*(EE/(MW*SW));
ampffAWTestedTmp[] := pre*rsp[\"[324>\"]*((Me*rsp[\"[34]<12>\"] + \
MW*rsp[\"<24>[13]\"])/((Mandelstahm[1, 2] - MW^2)*(Mandelstahm[1, 3] - \
M1^2))); ;
ampffAWTested[] := ampffAWTestedTmp[] /. pre -> Sqrt[2]*EE*(EE/(MW*SW));
ampffZWWSlepTestedTmp[] := (-preW)*(((Plus[2])*(MZ*rsp[\"<34>\"] + \
MW*rsp[\"[34]\"])*MW^2*rsp[\"<23>[14]\"] + 2*(MW*rsp[\"<34>\"] + \
MZ*rsp[\"[34]\"])*MW^2*rsp[\"<24>[13]\"] + ((2*MW^2 - MZ^2)*M1*rsp[\"<12>\"] \
+ 2*MW^2*rsp[\"[132>\"])*rsp[\"<34>[34]\"])/(Mandelstahm[1, 2] - MW^2)); ;
