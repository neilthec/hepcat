      \"Z\" :> (ampffWWZSTested[] /. {M1 -> Mu, gL1 -> gLu, gR1 -> gRu}),
      \"A\" :> (ampffWWASTested[] /. {M1 -> Mu, Q1 -> 2/3}),
      \"d:T\" :> (ampffWWfTTested[] /. {M1 -> Mu, Mprop -> Md})
    }|>,
  <|\"Name\" -> \"d D -> W- W+\", \"Particles\" -> {\"d\", \"D\", \"W-\", \
\"W+\"},
    \"Masses\" -> {Md, Md, MW, MW},
    \"Expected\" -> {
      \"h\" :> (ampffWWhSTested[] /. M1 -> Md),
      \"Z\" :> (ampffWWZSTested[] /. {M1 -> Md, gL1 -> gLd, gR1 -> gRd}),
      \"A\" :> (ampffWWASTested[] /. {M1 -> Md, Q1 -> -1/3}),
      \"u:U\" :> (ampffWWfUTested[] /. Mprop -> Mu)
    }|>,
  <|\"Name\" -> \"ne Ne -> W- W+\", \"Particles\" -> {\"ne\", \"Ne\", \"W-\", \
\"W+\"},
    \"Masses\" -> {0, 0, MW, MW},
    \"Expected\" -> {
      \"Z\" :> (ampffWWZSTested[] /. {M1 -> 0, gL1 -> 1, gR1 -> 0}),
      \"e:T\" :> (ampffWWfTTested[] /. {M1 -> 0, Mprop -> Me})
    }|>,
  <|\"Name\" -> \"ne E -> W- h\", \"Particles\" -> {\"ne\", \"E\", \"W-\", \
\"h\"},
    \"Masses\" -> {0, Me, MW, Mh},
    \"FermionTRewrite\" -> True,
    \"Expected\" -> {
      \"W+\" :> (ampffWhWTested[] /. {M1 -> 0, M2 -> Me}),
      \"e:T\" :> (ampffWhfTTested[] /. {M2 -> Me})
    }|>,
  <|\"Name\" -> \"u D -> W- h\", \"Particles\" -> {\"u\", \"D\", \"W-\", \
\"h\"},
    \"Masses\" -> {Mu, Md, MW, Mh},
    \"FermionTRewrite\" -> True,
    \"Expected\" -> {
      \"W+\" :> (ampffWhWTested[] /. {M1 -> Mu, M2 -> Md}),
      \"d:T\" :> (ampffWhfTTested[] /. {M1 -> Mu, M2 -> Md}),
      \"u:U\" :> (ampffWhfUTested[] /. {M1 -> Mu, M2 -> Md})
    }|>,
  <|\"Name\" -> \"ne Ne -> Z h\", \"Particles\" -> {\"ne\", \"Ne\", \"Z\", \
\"h\"},
    \"Masses\" -> {0, 0, MZ, Mh},
    \"Expected\" -> {
      \"Z\" :> (ampffZhZSTested[] /. {gL1 -> 1, gR1 -> 0, M1 -> 0})
    }|>,
  <|\"Name\" -> \"ne Ne -> Z Z\", \"Particles\" -> {\"ne\", \"Ne\", \"Z\", \
\"Z\"},
    \"Masses\" -> {0, 0, MZ, MZ},
    \"Expected\" -> {
      \"ne\" :> ((ampffZZfTTested[] + ampffZZfUTested[]) /. {gL1 -> 1, gR1 -> \
0, M1 -> 0})
    }|>,
  <|\"Name\" -> \"e E -> A.+ h\", \"Particles\" -> {\"e\", \"E\", \"A.+\", \
\"h\"},
    \"Masses\" -> {Me, Me, 0, Mh},
    \"Expected\" -> {
      \"e:T\" :> (ampffAhTested[] /. {Q1 -> -1, M1 -> Me})
    }|>,
  <|\"Name\" -> \"u U -> A.+ h\", \"Particles\" -> {\"u\", \"U\", \"A.+\", \
\"h\"},
    \"Masses\" -> {Mu, Mu, 0, Mh},
    \"Expected\" -> {
      \"u:T\" :> (ampffAhTested[] /. {Q1 -> 2/3, M1 -> Mu})
    }|>,
  <|\"Name\" -> \"d D -> A.+ h\", \"Particles\" -> {\"d\", \"D\", \"A.+\", \
\"h\"},
    \"Masses\" -> {Md, Md, 0, Mh},
    \"Expected\" -> {
      \"d:T\" :> (ampffAhTested[] /. {Q1 -> -1/3, M1 -> Md})
    }|>,
  <|\"Name\" -> \"e E -> A.+ A.+\", \"Particles\" -> {\"e\", \"E\", \"A.+\", \
\"A.+\"},
    \"Masses\" -> {Me, Me, 0, 0},
    \"Expected\" -> {
      \"e:T\" :> (ampffApApTested[] /. {Q1 -> -1, M1 -> Me})
    }|>,
  <|\"Name\" -> \"e E -> A.+ A.-\", \"Particles\" -> {\"e\", \"E\", \"A.+\", \
\"A.-\"},
    \"Masses\" -> {Me, Me, 0, 0},
    \"Expected\" -> {
      \"e\" :> (ampffApAmTested[] /. {Q1 -> -1, M1 -> Me})
    }|>,
  <|\"Name\" -> \"u U -> A.+ A.+\", \"Particles\" -> {\"u\", \"U\", \"A.+\", \
\"A.+\"},
    \"Masses\" -> {Mu, Mu, 0, 0},
    \"Expected\" -> {
      \"u:T\" :> (ampffApApTested[] /. {Q1 -> 2/3, M1 -> Mu})
    }|>,
  <|\"Name\" -> \"u U -> A.+ A.-\", \"Particles\" -> {\"u\", \"U\", \"A.+\", \
\"A.-\"},
    \"Masses\" -> {Mu, Mu, 0, 0},
    \"Expected\" -> {
      \"u\" :> (ampffApAmTested[] /. {Q1 -> 2/3, M1 -> Mu})
    }|>,
  <|\"Name\" -> \"d D -> A.+ A.+\", \"Particles\" -> {\"d\", \"D\", \"A.+\", \
\"A.+\"},
    \"Masses\" -> {Md, Md, 0, 0},
    \"Expected\" -> {
      \"d:T\" :> (ampffApApTested[] /. {Q1 -> -1/3, M1 -> Md})
    }|>,
