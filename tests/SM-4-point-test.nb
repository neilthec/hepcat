    }|>,
  <|\"Name\" -> \"G.+ d -> A.+ D\", \"Particles\" -> {\"G.+\", \"d\", \
\"A.+\", \"D\"},
    \"Masses\" -> {0, Md, 0, Md},
    \"Expected\" -> {
      \"d\" :> (ampgfAfppTested[] //. {Mf -> Md, g2 -> EE*(-1/3)})
    }|>,
  <|\"Name\" -> \"G.+ u -> G.+ U\", \"Particles\" -> {\"G.+\", \"u\", \
\"G.+\", \"U\"},
    \"Masses\" -> {0, Mu, 0, Mu},
    \"Expected\" -> {
      \"u\" :> (ampgfAfppTested[] //. {Mf -> Mu, g2 -> GG})
    }|>,
  <|\"Name\" -> \"A.+ W+ -> U d\", \"Particles\" -> {\"A.+\", \"W+\", \"U\", \
