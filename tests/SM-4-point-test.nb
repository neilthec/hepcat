Cell["\<\
bosonTests = {
  <|\"Name\" -> \"h h -> h h\", \"Particles\" -> {\"h\", \"h\", \"h\", \
\"h\"},
    \"Masses\" -> {Mh, Mh, Mh, Mh},
    \"Expected\" -> {
      \"h:S\" :> amphhhhSTested[],
      \"h:T\" :> amphhhhTTested[],
      \"h:U\" :> amphhhhUTested[],
      \"contact\" :> amphhhh4Tested[]
    }|>,
  <|\"Name\" -> \"h h -> Z Z\", \"Particles\" -> {\"h\", \"h\", \"Z\", \
\"Z\"},
    \"Masses\" -> {Mh, Mh, MZ, MZ},
    \"Expected\" -> {
      \"h:S\" :> amphhVVSTested[],
      \"Z:T\" :> amphhZZTTested[],
      \"Z:U\" :> amphhZZUTested[],
      \"contact\" :> amphhVV4Tested[]
    }|>,
  <|\"Name\" -> \"h h -> W- W+\", \"Particles\" -> {\"h\", \"h\", \"W-\", \
\"W+\"},
    \"Masses\" -> {Mh, Mh, MW, MW},
    \"Expected\" -> {
      \"h:S\" :> amphhVVSTested[],
      \"W+:T\" :> amphhWWTTested[],
      \"W+:U\" :> amphhWWUTested[],
      \"contact\" :> amphhVV4Tested[]
    }|>,
  <|\"Name\" -> \"Z Z -> Z Z\", \"Particles\" -> {\"Z\", \"Z\", \"Z\", \
\"Z\"},
    \"Masses\" -> {MZ, MZ, MZ, MZ},
    \"Expected\" -> {
      \"h:S\" :> ampVVVVhSTested[],
      \"h:T\" :> ampVVVVhTTested[],
      \"h:U\" :> ampVVVVhUTested[]
    }|>,
  <|\"Name\" -> \"Z Z -> W- W+\", \"Particles\" -> {\"Z\", \"Z\", \"W-\", \
\"W+\"},
    \"Masses\" -> {MZ, MZ, MW, MW},
    \"Expected\" -> {
      \"h:S\" :> ampVVVVhSTested[]
    }|>,
  <|\"Name\" -> \"W+ W- -> W+ W-\", \"Particles\" -> {\"W+\", \"W-\", \"W+\", \
\"W-\"},
    \"Masses\" -> {MW, MW, MW, MW},
    \"Expected\" -> {
      \"h:S\" :> ampVVVVhSTested[],
      \"h:U\" :> ampVVVVhUTested[]
    }|>,
  <|\"Name\" -> \"W+ W- -> W- W+\", \"Particles\" -> {\"W+\", \"W-\", \"W-\", \
\"W+\"},
    \"Masses\" -> {MW, MW, MW, MW},
    \"Expected\" -> {
      \"h:T\" :> ampVVVVhTTested[]
    }|>,
  <|\"Name\" -> \"A.+ h -> W- W+\", \"Particles\" -> {\"A.+\", \"h\", \"W-\", \
\"W+\"},
    \"Masses\" -> {0, Mh, MW, MW},
    \"Expected\" -> {
      \"W+:T\" :> ampAhWWTested[]
    }|>,
  <|\"Name\" -> \"Z h -> W- W+\", \"Particles\" -> {\"Z\", \"h\", \"W-\", \
\"W+\"},
    \"Masses\" -> {MZ, Mh, MW, MW},
    \"Expected\" -> {
      \"Z:S\" :> ampZhWWSTested[],
      \"W+:T\" :> zhWWFinalize[ampZhWWTTested[], \"T\"],
      \"W+:U\" :> zhWWFinalize[ampZhWWUTested[], \"U\"]
    }|>,
  <|\"Name\" -> \"A.+ A.+ -> W- W+\", \"Particles\" -> {\"A.+\", \"A.+\", \
\"W-\", \"W+\"},
    \"Masses\" -> {0, 0, MW, MW},
    \"Expected\" -> {
      \"W+\" :> ampAAWWppTested[]
    }|>,
  <|\"Name\" -> \"A.+ A.- -> W- W+\", \"Particles\" -> {\"A.+\", \"A.-\", \
\"W-\", \"W+\"},
    \"Masses\" -> {0, 0, MW, MW},
    \"Expected\" -> {
      \"W+\" :> ampAAWWpmTested[]
    }|>,
  <|\"Name\" -> \"A.+ Z -> W- W+\", \"Particles\" -> {\"A.+\", \"Z\", \"W-\", \
\"W+\"},
    \"Masses\" -> {0, MZ, MW, MW},
    \"Expected\" -> {
      \"W+:U\" :> (ampAZWWTested[] /. MW -> MZ*CW /. SW^2 -> 1 - CW^2)
    }|>
,
  <|\"Name\" -> \"W+ W+ -> W- W-\", \"Particles\" -> {\"W+\", \"W+\", \"W-\", \
\"W-\"},
    \"Masses\" -> {MW, MW, MW, MW},
    \"Expected\" -> {
      \"h:T\" :> ampVVVVhTTested[],
