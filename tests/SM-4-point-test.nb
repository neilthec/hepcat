M4*M2*spPr[\"<12>[34]\"] + M1*M4*spPr[\"[12][34]\"])/(Mandelstahm[1, 2] - \
MW^2)); ;
ampffffWSTested[] := ampffffWSTestedTmp[] //. {preW -> EE^2/(2*MW^2*SW^2)};
ampffhhSTestedTmp[] := (-prehS)*(spPr[\"[12]+<12>\"]/(Mandelstahm[1, 2] - \
