EE*EE*M1*(M1/(4*MW*MW*SW*SW))};
ampffhhUTestedTmp[] := (-prehTU)*((2*M1*spPr[\"[12]+<12>\"] + spPr[\"[142> + \
[241>\"])/(Mandelstahm[1, 4] - M1^2)); ;
ampffhhUTested[] := ampffhhUTestedTmp[] //. {prehTU -> \
EE*EE*M1*(M1/(4*MW*MW*SW*SW))};
ampffAhTestedTmp[] := \
