EE*(EE/(Sqrt[2]*MW*MW*MZ*MZ*SW*SW));
ampffZWfTlepTestedTmp[] := pree*rsp[\"<24>\"]*(((Plus[gRe])*M1*rsp[\"<13>[34]\
\"] + (MZ*rsp[\"[34]\"] + rsp[\"[413>\"])*gL1*rsp[\"[13]\"])/(Mandelstahm[1, \
3] - M1^2)); ;
