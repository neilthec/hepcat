    }|>,
  <|\"Name\" -> \"G.+ d -> Z D\", \"Particles\" -> {\"G.+\", \"d\", \"Z\", \
\"D\"},
    \"Masses\" -> {0, Md, MZ, Md},
    \"Expected\" -> {
      \"d:S\" :> (ampgfZfTested[] /. {Mf -> Md, gLf -> gLd, gRf -> gRd})
    }|>,
  <|\"Name\" -> \"G.+ u -> A.+ U\", \"Particles\" -> {\"G.+\", \"u\", \
\"A.+\", \"U\"},
    \"Masses\" -> {0, Mu, 0, Mu},
    \"Expected\" -> {
      \"u\" :> (ampgfAfppTested[] //. {Mf -> Mu, g2 -> EE*(2/3)})
    }|>,
  <|\"Name\" -> \"G.+ u -> A.- U\", \"Particles\" -> {\"G.+\", \"u\", \
\"A.-\", \"U\"},
    \"Masses\" -> {0, Mu, 0, Mu},
    \"Expected\" -> {
