    \"Masses\" -> {0, Mu, MZ, Mu},
    \"Expected\" -> {
      \"u:S\" :> (ampAfZfTested[] /. {gL2 -> gLu, gR2 -> gRu, M2 -> Mu, Q2 -> \
2/3})
    }|>,
  <|\"Name\" -> \"A.+ d -> Z D\", \"Particles\" -> {\"A.+\", \"d\", \"Z\", \
\"D\"},
    \"Masses\" -> {0, Md, MZ, Md},
    \"Expected\" -> {
      \"d:S\" :> (ampAfZfTested[] /. {gL2 -> gLd, gR2 -> gRd, M2 -> Md, Q2 -> \
-1/3})
    }|>,
  <|\"Name\" -> \"h G.+ -> U u\", \"Particles\" -> {\"h\", \"G.+\", \"U\", \
\"u\"},
    \"Masses\" -> {Mh, 0, Mu, Mu},
    \"Expected\" -> {
      \"u:T\" :> (amphgffTested[] /. Mf -> Mu)
    }|>,
  <|\"Name\" -> \"h G.+ -> D d\", \"Particles\" -> {\"h\", \"G.+\", \"D\", \
\"d\"},
    \"Masses\" -> {Mh, 0, Md, Md},
    \"Expected\" -> {
