Cell["\<\
Four-boson processes from SM-4-point.nb (bbbb chapter), including channels \
that currently FAIL (mixed contact, AhWW / ZhWW / AAWW / AZWW). WWWW photon/Z \
templates in the original notebook are fully expanded and not copied. gg -> \
gg has no hardcoded amplitude in the original notebook.
\
\>", "Text",ExpressionUUID->"d7cab2a4-7f7d-44ac-8d06-e49b037a48e6"],

Cell["\<\
bosonTests = {
  <|\"Name\" -> \"h h -> h h\", \"Particles\" -> {\"h\", \"h\", \"h\", \
\"h\"},
    \"Masses\" -> {Mh, Mh, Mh, Mh},
    \"Expected\" -> {
      \"h:S\" :> amphhhhSTested[],
      \"h:T\" :> amphhhhTTested[],
      \"h:U\" :> amphhhhUTested[],
      \"contact\" :> amphhhh4Tested[]
    }|>,
  <|\"Name\" -> \"h h -> Z Z\", \"Particles\" -> {\"h\", \"h\", \"Z\", \
\"Z\"},
    \"Masses\" -> {Mh, Mh, MZ, MZ},
    \"Expected\" -> {
      \"h:S\" :> amphhVVSTested[],
      \"Z:T\" :> amphhZZTTested[],
      \"Z:U\" :> amphhZZUTested[],
      \"contact\" :> amphhVV4Tested[]
    }|>,
  <|\"Name\" -> \"h h -> W- W+\", \"Particles\" -> {\"h\", \"h\", \"W-\", \
\"W+\"},
    \"Masses\" -> {Mh, Mh, MW, MW},
    \"Expected\" -> {
      \"h:S\" :> amphhVVSTested[],
      \"W+:T\" :> amphhWWTTested[],
      \"W+:U\" :> amphhWWUTested[],
      \"contact\" :> amphhVV4Tested[]
    }|>,
  <|\"Name\" -> \"Z Z -> Z Z\", \"Particles\" -> {\"Z\", \"Z\", \"Z\", \
\"Z\"},
    \"Masses\" -> {MZ, MZ, MZ, MZ},
    \"Expected\" -> {
      \"h:S\" :> ampVVVVhSTested[],
      \"h:T\" :> ampVVVVhTTested[],
      \"h:U\" :> ampVVVVhUTested[]
    }|>,
  <|\"Name\" -> \"Z Z -> W- W+\", \"Particles\" -> {\"Z\", \"Z\", \"W-\", \
\"W+\"},
    \"Masses\" -> {MZ, MZ, MW, MW},
    \"Expected\" -> {
      \"h:S\" :> ampVVVVhSTested[]
    }|>,
  <|\"Name\" -> \"W+ W- -> W+ W-\", \"Particles\" -> {\"W+\", \"W-\", \"W+\", \
\"W-\"},
    \"Masses\" -> {MW, MW, MW, MW},
    \"Expected\" -> {
      \"h:S\" :> ampVVVVhSTested[],
      \"h:U\" :> ampVVVVhUTested[]
    }|>,
  <|\"Name\" -> \"W+ W- -> W- W+\", \"Particles\" -> {\"W+\", \"W-\", \"W-\", \
\"W+\"},
    \"Masses\" -> {MW, MW, MW, MW},
    \"Expected\" -> {
      \"h:T\" :> ampVVVVhTTested[]
    }|>,
  <|\"Name\" -> \"A.+ h -> W- W+\", \"Particles\" -> {\"A.+\", \"h\", \"W-\", \
\"W+\"},
    \"Masses\" -> {0, Mh, MW, MW},
    \"Expected\" -> {
      \"W+:T\" :> ampAhWWTested[]
    }|>,
  <|\"Name\" -> \"Z h -> W- W+\", \"Particles\" -> {\"Z\", \"h\", \"W-\", \
\"W+\"},
    \"Masses\" -> {MZ, Mh, MW, MW},
    \"Expected\" -> {
      \"Z:S\" :> ampZhWWSTested[],
      \"W+:T\" :> ampZhWWTTested[],
      \"W+:U\" :> ampZhWWUTested[]
    }|>,
  <|\"Name\" -> \"A.+ A.+ -> W- W+\", \"Particles\" -> {\"A.+\", \"A.+\", \
\"W-\", \"W+\"},
    \"Masses\" -> {0, 0, MW, MW},
    \"Expected\" -> {
      \"W+\" :> ampAAWWppTested[]
    }|>,
  <|\"Name\" -> \"A.+ A.- -> W- W+\", \"Particles\" -> {\"A.+\", \"A.-\", \
\"W-\", \"W+\"},
    \"Masses\" -> {0, 0, MW, MW},
    \"Expected\" -> {
      \"W+\" :> ampAAWWpmTested[]
    }|>,
  <|\"Name\" -> \"A.+ Z -> W- W+\", \"Particles\" -> {\"A.+\", \"Z\", \"W-\", \
\"W+\"},
    \"Masses\" -> {0, MZ, MW, MW},
    \"Expected\" -> {
      \"W+\" :> ampAZWWTested[]
    }|>
};
\
\>", "Input",
 CellLabel->
  "In[3295]:=",ExpressionUUID->"54d99ef7-8ab6-4383-89ea-4f0719b064f0"],

Cell["\<\

runFFFFTest[t_Association] := Module[{diags, masses, results, med, ch, key, \
got, exp, row, nDiags, fermT, sumAll},
  mReplacments = Thread[Mass /@ Range[4] -> t[\"Masses\"]];
  masses = t[\"Masses\"];
  diags = diagramsFor[t[\"Particles\"]];
  fermT = TrueQ[Lookup[t, \"FermionTRewrite\", False]];
  sumAll = TrueQ[Lookup[t, \"SumAll\", False]];
  results = Table[
    key = e[[1]];
    {med, ch} = parseMedKey[key];
    nDiags = If[sumAll, Length[diags],
      Length[Select[diags, mediatorOf[#] === med && (ch === All || \
diagramChannel[#] === ch) &]]];
    got = TimeConstrained[
      If[sumAll, simplifyQuarkAWffCombined[diags, masses],
        sumMediator[diags, med, masses, ch, fermT]], 60, $TimedOut];
    If[got === $TimedOut,
      row = {t[\"Name\"], key, \"TIMEOUT\", nDiags},
      If[med === \"Z\", got = got /. MW -> MZ*CW];
      exp = ReleaseHold[e[[2]]];
      If[med === \"Z\", exp = exp /. MW -> MZ*CW];
      row = {t[\"Name\"], key, agreeUpToSign[got, exp], nDiags}
    ];
    Print[row[[1]], \"  \", row[[2]], \"  \", statusStyle[row[[3]]], \"  (n \
diags = \", row[[4]], \")\"];
    row
    ,
    {e, Normal[t[\"Expected\"]]}
  ];
  results
];

runAllFFFF[] := Module[{all},
  Print[\"==== results ====\"];
  all = Flatten[runFFFFTest /@ Join[ffffTests, otherTests, bosonTests], 1];
  Print[\"----\"];
  Print[Style[ToString[Count[all, {__, s_String /; StringStartsQ[s, \
\"PASS\"], _}]] <> \" passed\", Bold, Darker[Green]], \", \",
    Style[ToString[Count[all, {__, \"FAIL\", _}]] <> \" failed\", Bold, Red], \
\", \",
    Count[all, {__, \"TIMEOUT\", _}], \" timed out, of \", Length[all]];
  all
];
\
\>", "Input",
 CellLabel->
  "In[3297]:=",ExpressionUUID->"501a2ea4-f666-4e4e-9be8-c5e9f940f68a"]
}, Open  ]],

