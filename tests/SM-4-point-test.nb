ampffhhSTested[] := ampffhhSTestedTmp[] //. {prehS -> \
3*EE*EE*M1*Mh*(Mh/(4*MW*MW*SW*SW))};
ampffhhTTestedTmp[] := (-prehTU)*((2*M1*spPr[\"[12]+<12>\"] + \
spPr[\"[132>+[231>\"])/(Mandelstahm[1, 3] - M1^2)); ;
