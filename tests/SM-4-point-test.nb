(-EE^2/(MW^2*SW^2))*(rsp[\"[12]<12>[34]<34>\"]/(Mandelstahm[1, 2] - Mh^2));
ampVVVVhTTested[] := \
(-EE^2/(MW^2*SW^2))*(rsp[\"[13]<13>[24]<24>\"]/(Mandelstahm[1, 3] - Mh^2));
