M3^2)*(Mandelstahm[1, 4] - M4^2))); ;
ampgWffTested[] := ampgWffTestedTmp[] /. pre -> Sqrt[2]*EE*(GG/(MW*SW));
amphhhhSTested[] := (-9*EE^2*Mh^4/(4*MW^2*SW^2))/(Mandelstahm[1, 2] - Mh^2);
amphhhhTTested[] := (-9*EE^2*Mh^4/(4*MW^2*SW^2))/(Mandelstahm[1, 3] - Mh^2);
amphhhhUTested[] := (-9*EE^2*Mh^4/(4*MW^2*SW^2))/(Mandelstahm[1, 4] - Mh^2);
