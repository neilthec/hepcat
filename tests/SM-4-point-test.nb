Cell["\<\
compareAmps[amp_, ampTested_] := Module[{diff = 0, sum = 0}, diff = \
Simplify[amp - ampTested]; If[diff =!= 0, sum = Simplify[amp + ampTested]; \
If[sum =!= 0, Print[\"Difference detected:\"]; Print[\"\\t amp=              \
\", amp]; Print[\"\\t ampTested=\", ampTested]; , Print[\"Opposite sign \
detected:\"]; Print[\"\\t amp=              \", amp]; Print[\"\\t \
ampTested=\", ampTested]; ]; ]; ];
spPr[str_] := ConvertStringAmplitude[str, {Mass[1], Mass[2], Mass[3], \
Mass[4]} /. mReplacments];
rsp[str_] := ReduceSpinorProducts[ConvertStringAmplitude[str, {Mass[1], \
Mass[2], Mass[3], Mass[4]} /. mReplacments]];
ampffffASTested[] := -2*Q1*Q2*EE^2*(spPr[\"<13>[24] + <14>[23] + [13]<24> + \
[14]<23>\"]/Mandelstahm[1, 2]);
ampffffATTested[] := 2*Q1*Q2*EE^2*(spPr[\"<12>[34] - <14>[23] + [12]<34> - \
[14]<23>\"]/Mandelstahm[1, 3]);
ampffffhSTested[] := EE^2*M1*(M2/(4*MW*MW*SW*SW))*(spPr[\"([12]+<12>) \
([34]+<34>)\"]/(Mandelstahm[1, 2] - Mh^2));
ampffffhTTested[] := \
(-EE^2)*M1*(M2/(4*MW*MW*SW*SW))*(spPr[\"([13]+<13>)([24]+<24>)\"]/(\
Mandelstahm[1, 3] - Mh^2));
ampffffZSTestedTmp[] := (-preZ0)*(spPr[\"(<12>-[12]) \
(<34>-[34])\"]/(Mandelstahm[1, 2] - MZ^2)) - preZ*2*((gL1*gL2*spPr[\"[23]<14>\
\"] + gL2*gR1*spPr[\"[13]<24>\"] + gL1*gR2*spPr[\"[24]<13>\"] + gR1*gR2*spPr[\
\"[14]<23>\"])/(Mandelstahm[1, 2] - MZ^2)); ;
ampffffZSTested[] := ampffffZSTestedTmp[] //. {preZ0 -> preZ*(gL1 - gR1)*(gL2 \
- gR2)*M1*(M2/MZ/MZ), preZ -> EE^2/(4*CW*CW*SW*SW)};
ampffffZTTestedTmp[] := preZ0*(spPr[\"(<13>-[13]) \
(<24>-[24])\"]/(Mandelstahm[1, 3] - MZ^2)) + \
preZ*2*(((-gL1^2)*spPr[\"[23]<14>\"] + gL1*gR1*spPr[\"( [12] <34>+ [34] <12>)\
\"] - gR1^2*spPr[\"[14]<23>\"])/(Mandelstahm[1, 3] - MZ^2)); ;
ampffffZTTested[] := ampffffZTTestedTmp[] //. {preZ0 -> preZ*(gL1 - gR1)*(gL1 \
- gR1)*M1*(M2/MZ/MZ), preZ -> EE^2/(4*CW*CW*SW*SW)};
ampffffWTTestedTmp[] := (-preW)*((2*MW^2*spPr[\"[23]<14>\"] + (M2*spPr[\"<13>\
\"] - M1*spPr[\"[13]\"])*(M2*spPr[\"[24]\"] - \
M1*spPr[\"<24>\"]))/(Mandelstahm[1, 3] - MW^2)); ;
ampffffWTTested[] := ampffffWTTestedTmp[] //. {preW -> EE^2/(2*MW^2*SW^2)};
ampffffWSTestedTmp[] := (-preW)*((2*MW^2*spPr[\"[23]<14>\"] + \
M2*M3*spPr[\"<12><34>\"] - M3*M1*spPr[\"[12]<34>\"] - \
M4*M2*spPr[\"<12>[34]\"] + M1*M4*spPr[\"[12][34]\"])/(Mandelstahm[1, 2] - \
MW^2)); ;
ampffffWSTested[] := ampffffWSTestedTmp[] //. {preW -> EE^2/(2*MW^2*SW^2)};
ampffhhSTestedTmp[] := (-prehS)*(spPr[\"[12]+<12>\"]/(Mandelstahm[1, 2] - \
