 qChannels=FactorizationAmplitudeChannels[qProcess,qModel];
 Get[FileNameJoin[{qDirectory,"fresh-feynman-conversion.wl"}]];
 qReference=qConvertBenchmark[qProcess,qFeynmanModel];
 If[!AssociationQ[qReference],Print[qReference];Quit[2]];qBenchmark=qReference["Benchmark"];
 qRules={"Mm"->1/2000};
 qReport=Block[{ConstructiveDiagrams`Private`$amplitudeParallelActive=True},CheckAmplitudes[
  qPair,qChannels,qModel,"FeynmanAmplitudes"->qBenchmark,"FeynmanModel"->qFeynmanModel,
  "ParameterRules"->qRules,"RandomSeed"->840071863,"TimeConstraint"->90,"Output"->"Details"]];
 qRows=If[AssociationQ[qReport],Lookup[qReport,"Checks",{}],{}];
 qRecord=<|"Scope"->"FreshCanonicalConstructorExpressionEqualMassRecheck",
  "ContextSHA256"->qSource["ContextSHA256"],"SourceCaseID"->qSource["ID"],"SourceCapsuleSHA256"->qSourceSHA,
  "SourceAmplitudeUnchanged"->(qPair===qOriginal&&qSHA[qSourcePath]===qSourceSHA),
  "NoExpressionMassSlotOrFlavorTransport"->True,"NormalizationOrPhaseFitted"->False,
  "ParameterRules"->qRules,"ResolvedConstructiveRules"->ModelParameterRules[qModel,qRules],
  "ResolvedFeynmanRules"->ModelParameterRules[qFeynmanModel,qRules],"RandomSeed"->840071863,
  "FreshCompleteFeynmanGraphCount"->qReference["GraphCount"],"SourceAmplitude"->qPair,
  "OriginalSourceChannels"->qChannels,"FeynmanBenchmark"->qBenchmark,"Report"->qReport,
  "Rows"->(KeyTake[#,{"Type","Cut","Mass","Status","CompletedSamples","RequestedSamples","Diagnostics"}]&/@qRows),
  "StatusCounts"->Counts[Lookup[qRows,"Status",{}]],"Status"->If[qRows=!={}&&AllTrue[qRows,#["Status"]==="PASS"&],"ALL_PASS","CHECKS_NOT_ALL_PASS"],
  "Seconds"->N[AbsoluteTime[]-qStart],"CheckTimeConstraint"->90|>;
 qWrite[FileNameJoin[{qDirectory,"canonical-Mm-override.wxf"}],qRecord];
 Export[FileNameJoin[{qDirectory,"canonical-Mm-override.json"}],qSafe[KeyDrop[qRecord,{"SourceAmplitude","OriginalSourceChannels","FeynmanBenchmark","Report"}]],"RawJSON"];
 Print[qRecord["Status"]," ",qRecord["StatusCounts"]," ",qRecord["Seconds"]];
 If[qRecord["Status"]=!="ALL_PASS",Quit[1]];
];
qOutcome=MemoryConstrained[TimeConstrained[qWork[],180,Missing["TimeConstraint"]],4*2^30,Missing["MemoryLimit"]];
If[MissingQ[qOutcome],Print[qOutcome];Quit[2]];End[];Quit[];
