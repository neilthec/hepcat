Get["/Users/neil/code/hepcat/source/HEPCAT.wl"];
Begin["SM5CanonicalEqualMassRecheck`Private`"];
$ContextPath=Prepend[DeleteCases[$ContextPath,"SM5CanonicalEqualMassRecheck`Private`"],"SM5CanonicalEqualMassRecheck`Private`"];
$HistoryLength=0;
qRoot="/Users/neil/code/hepcat";
qDirectory=DirectoryName[$InputFileName];
qSourcePath=FileNameJoin[{qRoot,"tests","results","SM-5-point","sm5_46dff720d04e.wxf"}];
qSHA[p_]:=IntegerString[FileHash[p,"SHA256"],16,64];
qSafe[a_Association]:=Association@KeyValueMap[(If[StringQ[#1],#1,ToString[#1,InputForm]]->qSafe[#2])&,a];
qSafe[a_List]:=qSafe/@a;
qSafe[a_]:=If[StringQ[a]||IntegerQ[a]||Head[a]===Real||MemberQ[{True,False,Null},a],a,ToString[a,InputForm]];
qWrite[p_,a_]:=Module[{s},s=OpenWrite[p,BinaryFormat->True];BinaryWrite[s,Normal[BinarySerialize[a,PerformanceGoal->"Size"]],"Byte"];Close[s]];
qStart=AbsoluteTime[];
qWork[]:=Module[{qSource,qSourceSHA,qPair,qOriginal,qProcess,qChannels,qModel,qFeynmanModel,qReference,qBenchmark,qRules,qReport,qRows,qRecord},
 qSourceSHA=qSHA[qSourcePath];qSource=Import[qSourcePath,"WXF"];
 If[qSource["Status"]=!="COMPLETE"||qSource["ContextSHA256"]=!="55701e7a9f6d674b7f37aa1ced637de0e9e1934badd54be9dce03244084725f9",Quit[2]];
 qPair=qSource["Expression"];qOriginal=qPair;qProcess=qSource["Particles"];
 qModel=ReadModel[FileNameJoin[{qRoot,"models"}],2];
