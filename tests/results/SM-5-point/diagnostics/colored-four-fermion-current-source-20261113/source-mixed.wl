(* Isolated source-only proposal. No reference model or saved amplitude is read. *)
Begin["HEPCATColoredMixedCurrentSources`Private`"];
HEPCATColoredMixedCurrentSources`Private`source[ccsProcess_List,ccsModel_List]:=Module[
 {ccsTag=Unique["coloredCurrent"],ccsAbort,ccsRows,ccsFermions,ccsScalars,ccsBefore,ccsOriginal,ccsData,ccsDiagrams,
 ccsUsed,ccsNeeded,ccsTemporary,ccsCatalog,ccsLifted,ccsOriginalCertificates,ccsLiftedCertificates,ccsOriginalSigns,
 ccsLiftedSigns,ccsRepresentations,ccsColoredRepresentations,ccsCandidates,ccsCoordinates,ccsMappedCoordinates,ccsMapping={},ccsMatches,ccsUnmatched,ccsOriginalPairs,
 ccsConverted,ccsExternal,ccsTerms,ccsExpression,ccsExpected,ccsWeights,ccsLocal={},ccsStructure,ccsLegs,ccsTensor,
 ccsRow,ccsVertex,ccsI,ccsJ,ccsKind,ccsRowsByName,ccsAlias,ccsReconstructed},
 Catch[
 ccsAbort[ccsReason_,ccsDetails_:<||>]:=Throw[Failure[ccsReason,ccsDetails],ccsTag];
 ccsBefore=HEPCATCovariantCurrentSources`Private`objectSHA[ccsModel];
 If[Length[ccsModel]=!=4||Length[ccsProcess]=!=5,ccsAbort["UnsupportedModelOrProcess"]];
 ccsRows=HEPCATCovariantCurrentSources`Private`particleRow[#,ccsModel]&/@ccsProcess;
 If[!AllTrue[ccsRows,ListQ],ccsAbort["UnknownExternalParticle"]];
 ccsFermions=Select[ccsRows,#[[5]]===1&];ccsScalars=Select[ccsRows,#[[5]]===0&];
 If[Length[ccsFermions]=!=4||Length[ccsScalars]=!=1||First[ccsScalars][[8]]=!=1||
   !AllTrue[ccsFermions,#[[6]]=!=0&&#[[2]]=!=#[[3]]&&!MemberQ[{"L","R"},#[[9]]]&&MemberQ[{1,3},Abs[#[[8]]]]&],
  ccsAbort["UnsupportedExternalMassiveColoredFourFermionScalarClass"]];
 ccsRepresentations=ConstructiveDiagrams`Private`colorParticleRepresentation[#,ccsModel]&/@ccsProcess;
 ccsColoredRepresentations=DeleteCases[ccsRepresentations,1];
 If[!MemberQ[{2,4},Length[ccsColoredRepresentations]]||Count[ccsColoredRepresentations,3]=!=Count[ccsColoredRepresentations,-3],
  ccsAbort["UnsupportedBalancedColoredDiracPairs"]];
 ccsOriginal=CreateDiagrams[ccsProcess,ccsModel];
 If[!ListQ[ccsOriginal]||ccsOriginal==={}||!AllTrue[ccsOriginal,AssociationQ],ccsAbort["OriginalDiagramGenerationIncomplete"]];
 ccsData=ConstructiveDiagrams`Private`colorDiagramBasis[ccsOriginal,ccsModel];
 If[!AssociationQ[ccsData],ccsAbort["OriginalColorProjectionIncomplete",<|"Reason"->ccsData|>]];
 ccsDiagrams=ccsData["Diagrams"];ccsUsed=HEPCATCovariantCurrentSources`Private`usedRows[ccsDiagrams];
 If[ccsUsed==={}||!AllTrue[ccsUsed,Length[HEPCATCovariantCurrentSources`Private`rowParticles[#]]===3&],ccsAbort["UnsupportedUsedArity"]];
 If[!FreeQ[ccsUsed,_ColorIndex|_ColorDelta|_ColorGenerator|_ColorStructure|_ColorTrace],ccsAbort["ExplicitStoredColorNeedsSeparateFactorizationProof"]];
 ccsNeeded=DeleteDuplicates[Flatten[HEPCATCovariantCurrentSources`Private`rowParticles/@ccsUsed]];
 If[!AllTrue[HEPCATCovariantCurrentSources`Private`particleRow[#,ccsModel]&/@ccsNeeded,
  ListQ[#]&&MemberQ[{1,3,-3,8},#[[8]]]&],ccsAbort["UnsupportedUsedRepresentation"]];
 Do[
  ccsStructure=Last[ccsDiagrams[[ccsI]]["VertexStructures"][ccsVertex]];
  ccsLegs=MapIndexed[Join[#1,<|"ColorIndex"->ColorIndex[First[#2]]|>]&,ccsStructure["IncidentLegs"]];
  ccsTensor=ConstructiveDiagrams`Private`colorVertexTensor[ccsLegs,ccsModel,ccsStructure["ModelRow"]];
  If[!MatchQ[ccsTensor,1|_ColorDelta|_ColorGenerator],ccsAbort["UnsupportedLocalColorOperator",<|"Tensor"->ccsTensor|>]];
  AppendTo[ccsLocal,<|"Diagram"->ccsI,"Vertex"->ccsVertex,"OrderedParticles"->Lookup[ccsLegs,"Particle"],
   "SourceModelRow"->ccsStructure["ModelRow"],"LocalColorOperator"->ccsTensor,"KinematicsIndependent"->True|>],
  {ccsI,Length[ccsDiagrams]},{ccsVertex,ccsDiagrams[[ccsI]]["InternalVertices"]}];
 ccsTemporary=ReplacePart[ccsModel,1->(ReplacePart[#,8->1]&/@ccsModel[[1]])];
 ccsCatalog=HEPCATCovariantCurrentSources`Private`sourceCatalog[ccsTemporary,ccsUsed];
 If[!AssociationQ[ccsCatalog],ccsAbort["ExactLorentzCatalogUnavailable",<|"Reason"->ccsCatalog|>]];
 ccsLifted=CreateDiagrams[ccsProcess,ccsCatalog["Model"]];
 If[!ListQ[ccsLifted]||ccsLifted==={}||!AllTrue[ccsLifted,AssociationQ],ccsAbort["LiftedDiagramGenerationIncomplete"]];
 ccsOriginalCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,ccsCatalog,ccsTemporary,False]&/@ccsDiagrams;
 ccsLiftedCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,ccsCatalog,ccsTemporary,True]&/@ccsLifted;
 If[!AllTrue[Join[ccsOriginalCertificates,ccsLiftedCertificates],AssociationQ],ccsAbort["IncompleteOrderedGraphCertificate"]];
 ccsOriginalSigns=ConstructiveDiagrams`diagramFermionSign/@ccsDiagrams;
 ccsLiftedSigns=ConstructiveDiagrams`diagramFermionSign/@ccsLifted;
 If[!AllTrue[Join[ccsOriginalSigns,ccsLiftedSigns],MemberQ[{-1,1},#]&],ccsAbort["UnresolvedGraphFermionSign"]];
 ccsCoordinates=ccsData["DiagramCoordinates"];ccsUnmatched=Range[Length[ccsDiagrams]];
 Do[
  ccsMatches=Select[ccsUnmatched,SameQ[ccsOriginalCertificates[[#]],ccsLiftedCertificates[[ccsJ]]]&&ccsOriginalSigns[[#]]===ccsLiftedSigns[[ccsJ]]&];
  If[ccsMatches==={},ccsAbort["NoOrderedGraphColorCorrespondence",<|"LiftedIndex"->ccsJ|>]];
  If[Length[ccsMatches]>1&&!TrueQ[SameQ@@ccsCoordinates[[ccsMatches]]],ccsAbort["AmbiguousGraphColorCorrespondence"]];
  ccsI=First[ccsMatches];AppendTo[ccsMapping,<|"LiftedIndex"->ccsJ,"OriginalIndex"->ccsI,"OriginalOrigin"->ccsData["DiagramOrigins"][[ccsI]],
   "OrderedGraphCertificate"->ccsLiftedCertificates[[ccsJ]],"OriginalFermionSign"->ccsOriginalSigns[[ccsI]],
   "LiftedFermionSign"->ccsLiftedSigns[[ccsJ]],"ColorCoordinates"->ccsCoordinates[[ccsI]],"EquivalentColorBucket"->ccsMatches|>];
  ccsUnmatched=DeleteCases[ccsUnmatched,ccsI],{ccsJ,Length[ccsLifted]}];
 If[ccsUnmatched=!={}||Length[ccsMapping]=!=Length[ccsDiagrams],ccsAbort["IncompletePerGraphCoverage"]];
 ccsOriginalPairs=DiagramAmplitudes[ccsLifted];
 ccsConverted=FeynmanToSpinorProducts[ccsOriginalPairs,"ReferenceSpinors"->Automatic,"ReduceSpinorProducts"->False,"TimeConstraint"->90];
 If[!TrueQ[ConstructiveDiagrams`Private`constructBenchmarkConversionCompleteQ[ccsOriginalPairs,ccsConverted]],ccsAbort["IncompleteOffShellConversion"]];
 ccsExternal=First[First[ccsConverted]];
 If[!AllTrue[ccsConverted,First[#]===ccsExternal&],ccsAbort["ExternalMassOrderingMismatch"]];
 ccsMappedCoordinates=Lookup[ccsMapping,"ColorCoordinates"];
 ccsTerms=MapThread[Times,{Last/@ccsConverted,(#.ccsData["Basis"]&/@ccsMappedCoordinates)}];
 ccsExpression=Total[ccsTerms];
 ccsExpected=HEPCATCovariantCurrentSources`Private`declaredExternalSpinWeights[ccsProcess,ccsTemporary];
 ccsWeights=ConstructiveDiagrams`Private`completionExternalSpinWeights[ccsExpression,ccsExternal];
 If[ccsWeights=!=ccsExpected,ccsAbort["ExternalSpinWeightMismatch",<|"Expected"->ccsExpected,"Actual"->ccsWeights|>]];
 If[ccsBefore=!=HEPCATCovariantCurrentSources`Private`objectSHA[ccsModel],ccsAbort["OriginalModelChanged"]];
 <|"Status"->"UNVALIDATED_CANDIDATE","Amplitude"->{ccsExternal,ccsExpression},"Expression"->ccsExpression,
 "Process"->ccsProcess,"OriginalDiagramCount"->Length[ccsOriginal],"ResolvedOriginalDiagramCount"->Length[ccsDiagrams],
 "LiftedDiagramCount"->Length[ccsLifted],"PerGraphCorrespondence"->ccsMapping,"LocalColorCertificates"->ccsLocal,
 "VertexCertificates"->ccsCatalog["Certificates"],"OriginalColorProjection"->ccsData,
 "OriginalGraphCertificates"->ccsOriginalCertificates,"LiftedGraphCertificates"->ccsLiftedCertificates,
 "ConvertedLorentzPairs"->ccsConverted,"ColoredGraphTerms"->ccsTerms,"ModelParametersUnchanged"->SameQ[ccsModel[[3;;4]],ccsTemporary[[3;;4]]],
 "SourceModelSHA256"->ccsBefore,"TemporaryModelSHA256"->HEPCATCovariantCurrentSources`Private`objectSHA[ccsTemporary],
 "EveryOriginalOrderedGraphAndFermionSignMatched"->True,"CompleteOffShellConversionCoverage"->True,
 "NumericalCoefficientFit"->False,"IndependentBenchmarkRead"->False,"NativeValidationPerformed"->False,
 "InternalOnShellConditions"->{},"RequiresCheckAmplitudes"->True|>
 ,ccsTag]
];
End[];
