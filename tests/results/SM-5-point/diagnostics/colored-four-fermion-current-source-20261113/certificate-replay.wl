(* Independent replay of the finite color and ordered-graph ledger; no reference amplitude is read. *)
Begin["HEPCATColorCurrentReplay`Private`"];
HEPCATColorCurrentReplay`Private`verify[cvSource_Association,cvModel_List]:=Module[
 {cvTag=Unique["replay"],cvRequire,cvData,cvResolvedData,cvDiagrams,cvUsed,cvTemporary,cvCatalog,cvLifted,
 cvOriginalCertificates,cvLiftedCertificates,cvOriginalSigns,cvLiftedSigns,cvRepresentations,
 cvOriginalTensors,cvBasisVectors,cvOriginalVectors,cvGram,cvCoordinates,cvMap,cvPairs,cvExpectedPairs,
 cvTerms,cvExpression,cvLocalExpected={},cvStructure,cvLegs,cvOperator,cvI,cvJ,cvVertex,cvEntry},
 Catch[
 cvRequire[cvValue_,cvReason_]:=If[!TrueQ[cvValue],Throw[Failure[cvReason,<||>],cvTag]];
 cvRequire[Lookup[cvSource,"Status",None]==="UNVALIDATED_CANDIDATE","ProposalStatusMustRemainUnvalidated"];
 cvRequire[cvSource["SourceModelSHA256"]===HEPCATCovariantCurrentSources`Private`objectSHA[cvModel],"SourceModelOwnership"];
 cvData=cvSource["OriginalColorProjection"];cvDiagrams=cvData["Diagrams"];
 cvUsed=HEPCATCovariantCurrentSources`Private`usedRows[cvDiagrams];
 cvRequire[AllTrue[cvUsed,MemberQ[cvModel[[2]],#]&],"StoredVertexRowNotOwnedByModel"];
 cvTemporary=ReplacePart[cvModel,1->(ReplacePart[#,8->1]&/@cvModel[[1]])];
 cvRequire[cvSource["TemporaryModelSHA256"]===HEPCATCovariantCurrentSources`Private`objectSHA[cvTemporary],"TemporaryModelOwnership"];
 cvCatalog=HEPCATCovariantCurrentSources`Private`sourceCatalog[cvTemporary,cvUsed];cvRequire[AssociationQ[cvCatalog],"ExactLocalVertexCatalog"];
 cvRequire[Sort[Lookup[cvSource["VertexCertificates"],"CertificateID"]]===Sort[Lookup[cvCatalog["Certificates"],"CertificateID"]],"LocalVertexCertificateBinding"];
 cvLifted=CreateDiagrams[cvSource["Process"],cvCatalog["Model"]];cvRequire[ListQ[cvLifted]&&cvLifted=!={},"LiftedGraphsAvailable"];
 cvOriginalCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,cvCatalog,cvTemporary,False]&/@cvDiagrams;
 cvLiftedCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,cvCatalog,cvTemporary,True]&/@cvLifted;
 cvRequire[cvOriginalCertificates===cvSource["OriginalGraphCertificates"]&&cvLiftedCertificates===cvSource["LiftedGraphCertificates"],"OrderedGraphLedgerBinding"];
 cvOriginalSigns=ConstructiveDiagrams`diagramFermionSign/@cvDiagrams;cvLiftedSigns=ConstructiveDiagrams`diagramFermionSign/@cvLifted;
 cvRepresentations=ConstructiveDiagrams`Private`colorParticleRepresentation[#,cvModel]&/@cvSource["Process"];
 cvRequire[cvRepresentations===cvData["Representations"],"ColorRepresentationBinding"];
 cvResolvedData=ConstructiveDiagrams`Private`colorDiagramBasis[cvDiagrams,cvModel];
 cvRequire[AssociationQ[cvResolvedData]&&cvResolvedData["DiagramOrigins"]===Range[Length[cvDiagrams]],"ResolvedHelicityColorCoverage"];
 cvOriginalTensors=cvResolvedData["DiagramTensors"];
 cvRequire[cvOriginalTensors===cvData["DiagramTensors"],"OriginalColorTensorBinding"];
 cvBasisVectors=Normal[ConstructiveDiagrams`Private`colorTensorVectorSparse[#,cvRepresentations]]&/@cvData["Basis"];
 cvOriginalVectors=Normal[ConstructiveDiagrams`Private`colorTensorVectorSparse[#,cvRepresentations]]&/@cvOriginalTensors;
 cvGram=Simplify[Conjugate[cvBasisVectors].Transpose[cvBasisVectors]];
 cvRequire[cvGram===cvData["GramMatrix"]&&MatrixRank[cvGram]===Length[cvBasisVectors],"ExactColorGramBinding"];
 cvCoordinates=cvData["DiagramCoordinates"];
 cvRequire[cvCoordinates.cvBasisVectors===cvOriginalVectors,"EveryGraphColorCoordinateReconstruction"];
 Do[cvStructure=Last[cvDiagrams[[cvI]]["VertexStructures"][cvVertex]];
  cvLegs=MapIndexed[Join[#1,<|"ColorIndex"->ColorIndex[First[#2]]|>]&,cvStructure["IncidentLegs"]];
  cvOperator=ConstructiveDiagrams`Private`colorVertexTensor[cvLegs,cvModel,cvStructure["ModelRow"]];
  AppendTo[cvLocalExpected,<|"Diagram"->cvI,"Vertex"->cvVertex,"OrderedParticles"->Lookup[cvLegs,"Particle"],"SourceModelRow"->cvStructure["ModelRow"],"LocalColorOperator"->cvOperator,"KinematicsIndependent"->True|>],
  {cvI,Length[cvDiagrams]},{cvVertex,cvDiagrams[[cvI]]["InternalVertices"]}];
 cvRequire[cvLocalExpected===cvSource["LocalColorCertificates"],"EveryLocalColorOperatorAndRowBinding"];
 cvMap=cvSource["PerGraphCorrespondence"];
 cvRequire[Length[cvMap]===Length[cvDiagrams]===Length[cvLifted]&&Sort[Lookup[cvMap,"OriginalIndex"]]===Range[Length[cvDiagrams]]&&Lookup[cvMap,"LiftedIndex"]===Range[Length[cvLifted]],"PerGraphBijection"];
 Do[cvEntry=cvMap[[cvJ]];cvI=cvEntry["OriginalIndex"];
  cvRequire[cvEntry["OrderedGraphCertificate"]===cvOriginalCertificates[[cvI]]===cvLiftedCertificates[[cvJ]],"PerGraphOrderedPortAndCutMatch"];
  cvRequire[cvEntry["OriginalFermionSign"]===cvOriginalSigns[[cvI]]===cvEntry["LiftedFermionSign"]===cvLiftedSigns[[cvJ]],"PerGraphWickSignMatch"];
  cvRequire[cvEntry["ColorCoordinates"]===cvCoordinates[[cvI]],"PerGraphColorCoordinateMatch"],{cvJ,Length[cvMap]}];
 cvPairs=cvSource["ConvertedLorentzPairs"];
 cvExpectedPairs=FeynmanToSpinorProducts[DiagramAmplitudes[cvLifted],"ReferenceSpinors"->Automatic,"ReduceSpinorProducts"->False,"TimeConstraint"->60];
 cvRequire[cvPairs===cvExpectedPairs,"OffShellLorentzConversionReplay"];
 cvTerms=MapThread[#1(#2.cvData["Basis"])&,{Last/@cvPairs,Lookup[cvMap,"ColorCoordinates"]}];
 cvRequire[cvTerms===cvSource["ColoredGraphTerms"],"PerGraphColorLorentzAssembly"];
 cvExpression=Total[cvTerms];
 cvRequire[cvExpression===cvSource["Expression"]&&cvSource["Amplitude"]==={First[First[cvPairs]],cvExpression},"CompleteAmplitudeAssembly"];
 <|"Status"->"CERTIFICATE_VERIFIED","Graphs"->Length[cvDiagrams],"ColorRank"->Length[cvBasisVectors],
  "ColorStates"->Length[First[cvBasisVectors]],"EveryGraphColorVectorExactlyReconstructed"->True,
  "EveryWickSignAndOrderedPortRecomputed"->True,"CompleteLorentzConversionRecomputed"->True,
  "ReferenceBenchmarkRead"->False,"NativeAmplitudeValidationClaimed"->False|>
 ,cvTag]
];
End[];
