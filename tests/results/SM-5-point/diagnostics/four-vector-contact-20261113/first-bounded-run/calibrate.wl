 canonicalMetric[value_]:=value/.LorentzMetric[a_,b_]:>Apply[LorentzMetric,Sort[{a,b}]];
 localTensor=canonicalMetric[coefficients.operators];exchangeGroups=Select[GatherBy[Range[4],process[[#]]&],Length[#]>1&];
