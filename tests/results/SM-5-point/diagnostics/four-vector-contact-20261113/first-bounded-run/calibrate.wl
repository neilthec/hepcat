 lowerRows=HEPCATCovariantCurrentSources`Private`particleRow[#,lower]&/@process;
 If[Length[process]=!=4||!AllTrue[Join[rows,lowerRows],ListQ]||!AllTrue[rows,#[[5]]===2&&#[[6]]=!=0&&#[[8]]===1&],fail["UnsupportedFourMassiveVectorClass"]];
