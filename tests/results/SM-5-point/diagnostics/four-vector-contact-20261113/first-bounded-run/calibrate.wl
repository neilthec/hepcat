(* Diagnostic finite contact extraction from known complete lower data. No reference model is read. *)
Begin["HEPCATFourVectorContactPrototype`Private`"];
$ContextPath=Prepend[DeleteCases[$ContextPath,"HEPCATFourVectorContactPrototype`Private`"],"HEPCATFourVectorContactPrototype`Private`"];
HEPCATFourVectorContactPrototype`Private`objectSHA[x_]:=IntegerString[Hash[x,"SHA256"],16,64];
HEPCATFourVectorContactPrototype`Private`cubicCatalog[process_List,model_List]:=Module[
 {cubicModel,diagrams,used,certificates={},liftedRows={},parts,metadata,certificate,v4VertexMatch,needed,particles,liftedModel,liftedDiagrams,originalSignatures,liftedSignatures,
 tag=Unique["fourVectorCatalog"],fail},Catch[
 fail[reason_,data_:<||>]:=Throw[Failure[reason,data],tag];
 Print["CONTACT_CATALOG entry"];
 cubicModel=ReplacePart[model,2->Select[model[[2]],Length[HEPCATCovariantCurrentSources`Private`rowParticles[#]]===3&]];
 Print["CONTACT_CATALOG graphs"];
 diagrams=CreateDiagrams[process,cubicModel];
 If[!ListQ[diagrams]||diagrams==={}||!AllTrue[diagrams,AssociationQ],fail["OriginalCubicGraphsIncomplete"]];
 Print["CONTACT_CATALOG used rows"];
 used=HEPCATCovariantCurrentSources`Private`usedRows[diagrams];
 Do[parts=HEPCATCovariantCurrentSources`Private`rowParticles[row];metadata=HEPCATCovariantCurrentSources`Private`particleRow[#,model]&/@parts;
  If[!AllTrue[metadata,ListQ]||!AllTrue[metadata,#[[8]]===1&],fail["UnsupportedCubicMetadata"]];
  If[metadata[[All,5]]==={2,2,2},
   If[MemberQ[metadata[[All,6]],0],fail["MasslessVectorAliasNotCertifiedForThisCatalog"]];
   v4VertexMatch=HEPCATMinimalVVVExtended`Private`match[row,model];
   If[!AssociationQ[v4VertexMatch]||Lookup[v4VertexMatch,"Status",None]=!="EXACT_MINIMAL_VVV_MATCH",fail["UncertifiedVectorCubic",<|"Report"->v4VertexMatch|>]];
   certificate=Join[v4VertexMatch,<|"Class"->"MinimalVectorVectorVector","SourceRows"->{row},"Coefficients"->{v4VertexMatch["Coefficient"]},
    "LiftedRow"->Join[parts,{"",1,v4VertexMatch["Coefficient"]v4VertexMatch["MinimalLorentzOperator"]}]|>],
   certificate=HEPCATCovariantCurrentSources`Private`liftVertex[row,model];
   If[!AssociationQ[certificate],fail["UncertifiedNonVectorCubic",<|"Report"->certificate|>]]];
  certificate=Append[certificate,"CertificateID"->HEPCATCovariantCurrentSources`Private`objectSHA[KeyTake[certificate,{"Class","Particles","Coefficients"}]]];
  AppendTo[certificates,certificate];AppendTo[liftedRows,certificate["LiftedRow"]],{row,used}];
 needed=DeleteDuplicates[Flatten[HEPCATCovariantCurrentSources`Private`rowParticles/@liftedRows]];
 particles=Select[(ReplacePart[#,7->0]&/@model[[1]]),Intersection[#[[{2,3}]],needed]=!={}&];
 liftedModel=FeynmanModel[particles,DeleteDuplicates[liftedRows],model[[3]],model[[4]]];
 certificate=<|"Certificates"->certificates,"Aliases"-><||>,"Model"->liftedModel|>;
 liftedDiagrams=CreateDiagrams[process,liftedModel];
 If[!ListQ[liftedDiagrams]||!AllTrue[liftedDiagrams,AssociationQ],fail["LiftedCubicGraphsIncomplete"]];
 originalSignatures=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,certificate,cubicModel,False]&/@diagrams;
 liftedSignatures=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,certificate,cubicModel,True]&/@liftedDiagrams;
 If[!AllTrue[Join[originalSignatures,liftedSignatures],AssociationQ]||Sort[originalSignatures]=!=Sort[liftedSignatures],fail["CubicGraphCoverageMismatch",<|"Original"->originalSignatures,"Lifted"->liftedSignatures|>]];
 Join[certificate,<|"OriginalDiagrams"->diagrams,"OriginalUsedRows"->used,"LiftedDiagrams"->liftedDiagrams,
  "OriginalCubicGraphCertificates"->originalSignatures,"LiftedCubicGraphCertificates"->liftedSignatures,
  "ExactOriginalCubicGraphCoverage"->True,"OriginalCubicDiagramCount"->Length[diagrams],"LiftedCubicDiagramCount"->Length[liftedDiagrams]|>]
 ,tag]];

