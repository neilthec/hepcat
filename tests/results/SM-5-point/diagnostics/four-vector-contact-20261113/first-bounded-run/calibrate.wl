 known=Block[{ConstructiveDiagrams`Private`$colorFactorizationEnabled=False},LookupAmplitude[MapIndexed[{#1,First[#2]}&,process],ReplacePart[lower,2->knownRows],False,Table[Unique["knownVectorSlot"],{4}]]];
