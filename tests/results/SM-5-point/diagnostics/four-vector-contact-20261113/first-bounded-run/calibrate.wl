 If[!FreeQ[mapped,_Missing|_Failure|_Spinor|_SpinorChain|_Mom|_MomProd|_PropDen|_Mandelstahm]||!AllTrue[mapped,PolynomialQ[#,spins]&],fail["UnsupportedSymbolicFourVectorMap"]];
