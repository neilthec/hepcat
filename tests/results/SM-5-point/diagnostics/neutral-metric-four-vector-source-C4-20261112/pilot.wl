If[!TrueQ[ConstructiveDiagrams`Private`constructBenchmarkConversionCompleteQ[pFeyRaw,pFey]],pSave["reference-failure.wxf",pFey];Quit[2]];
pPair=pProposal["Amplitude"];
pSets=ConstructiveDiagrams`Private`completionValidationRuleSets[pLower,Automatic,Automatic];pReports={};pAll=True;
Do[pSay["Checking parameter assignment "<>ToString[pI]<>"/"<>ToString[Length[pSets]]];
 pOverrides=ConstructiveDiagrams`Private`constructValidationOverrides[pLower,Automatic,pSets[[pI]]];
 pOptions={"ParameterRules"->pOverrides,"FeynmanAmplitudes"->pFey,"FeynmanModel"->pFeyModel,"SpuriousPoles"->Automatic,"HighEnergyCheck"->True,"ReferenceCheck"->True,"Samples"->4,"RandomSeed"->(1971189+104729pI),"TimeConstraint"->120,"FeynmanTimeConstraint"->120,"Output"->"Details"};
 pSave["fixed-input-"<>ToString[pI]<>".wxf",<|"Pair"->pPair,"Channels"->pChannels,"IndependentFeynman"->pFey,"Options"->pOptions|>];
 pCheck=MemoryConstrained[TimeConstrained[CheckAmplitudes[pPair,pChannels,pLower,Sequence@@pOptions],150,Failure["OuterCheckDeadline",<||>]],4 2^30,Failure["MemoryLimit",<||>]];
 pPass=TrueQ[ConstructiveDiagrams`Private`constructAllChecksPassQ[pCheck,pPair,pChannels,pLower,pFey]];
 AppendTo[pReports,<|"ParameterSet"->pSets[[pI]],"Report"->pCheck,"AllChecksPass"->pPass|>];pAll=pAll&&pPass;
 pSave["validation.wxf",<|"Records"->pReports,"AmplitudePair"->pPair,"Proposal"->pProposal,"InternalOnShellConditions"->{},"CanonicalRecordsModified"->False,"Seconds"->N[AbsoluteTime[]-pStarted]|>];
 pSay[<|"Assignment"->pI,"AllChecksPass"->pPass,"Summary"->If[AssociationQ[pCheck],Lookup[pCheck,"Summary",<||>],pCheck]|>];
 If[!pPass,Break[]],{pI,Length[pSets]}];
pSummary=<|"Status"->If[pAll&&Length[pReports]===Length[pSets],"ALL_NATIVE_CHECKS_PASS","CHECKS_NOT_ALL_PASS"],"Process"->pProcess,"CompletedAssignments"->Length[pReports],"ExpectedAssignments"->Length[pSets],"Seconds"->N[AbsoluteTime[]-pStarted],"Leaves"->LeafCount[pProposal["Expression"]],"CanonicalRecordsModified"->False,"ProductionSourceChanged"->False|>;
Export[FileNameJoin[{pDirectory,"summary.json"}],pSummary,"RawJSON"];pSay[pSummary];
End[];Quit[If[pAll,0,1]];
