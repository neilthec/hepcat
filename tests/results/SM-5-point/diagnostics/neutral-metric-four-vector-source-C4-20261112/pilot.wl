Global`$HEPCATpath="/private/tmp/hepcat-neutral-vector-pilot-C4/source";
Get[FileNameJoin[{Global`$HEPCATpath,"HEPCAT.wl"}]];
Get["/private/tmp/hepcat-neutral-vector-pilot-C4/neutral-source.wl"];
Begin["SMNeutralVectorSourceProbe`Private`"];
$HistoryLength=0;
pDirectory="/private/tmp/hepcat-neutral-vector-pilot-C4";pStarted=AbsoluteTime[];
pSay[s_]:=Print[DateString[{"Hour",":","Minute",":","Second"}]," total ",N[AbsoluteTime[]-pStarted],"s ",s];
pSave[n_,v_]:=Module[{f=OpenWrite[FileNameJoin[{pDirectory,n}],BinaryFormat->True]},BinaryWrite[f,Normal[BinarySerialize[v,PerformanceGoal->"Size"]],"Byte"];Close[f]];
pRoot="/Users/neil/code/hepcat";
pModel=ReadModel[FileNameJoin[{pRoot,"models"}],1];pLower=ReadModel[FileNameJoin[{pRoot,"models"}],2];
pFeyModel=ReadModel[FileNameJoin[{pRoot,"tests","reference-models","calchep"}],1];
pProcess={"Z","Z","Z","Z","h"};
pSay["Building source from exactly certified cubics and calibrated existing metric quartics"];
pProposal=MemoryConstrained[HEPCATNeutralVectorSourceProbe`Private`calibratedCovariantSource[pProcess,pModel,pLower,"TimeConstraint"->90],4 2^30,Failure["MemoryLimit",<||>]];
pSave["proposal.wxf",pProposal];
If[!AssociationQ[pProposal]||Lookup[pProposal,"Status",None]=!="UNVALIDATED_CANDIDATE",pSay[<|"Status"->"SOURCE_REJECTED","Reason"->pProposal|>];Quit[2]];
pSay[<|"Status"->pProposal["Status"],"Leaves"->LeafCount[pProposal["Expression"]],"Graphs"->pProposal["OriginalDiagramCount"]|>];
pChannels=FactorizationAmplitudeChannels[pProcess,pLower];
pSay["Building separate Feynman reference"];
