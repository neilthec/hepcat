Begin["ConstructiveDiagrams`Private`"];

ConstructiveDiagrams`Private`colorCurrentSourceClass[process_List,model_List]:=Module[
 {rows,fermions,scalars,reps,colored},
 If[Length[process]=!=5||!AllTrue[process,StringQ]||Length[model]=!=4||!AllTrue[model,ListQ],Return[False]];
 rows=HEPCATCovariantCurrentSources`Private`particleRow[#,model]&/@process;
 If[!AllTrue[rows,ListQ],Return[False]];
 fermions=Select[rows,#[[5]]===1&];scalars=Select[rows,#[[5]]===0&];
 If[Length[fermions]=!=4||Length[scalars]=!=1||First[scalars][[8]]=!=1||
  !AllTrue[fermions,#[[6]]=!=0&&#[[2]]=!=#[[3]]&&!MemberQ[{"L","R"},#[[9]]]&&MemberQ[{1,3},Abs[#[[8]]]]&],Return[False]];
 reps=ConstructiveDiagrams`Private`colorParticleRepresentation[#,model]&/@process;
 If[AnyTrue[reps,FailureQ],Return[False]];colored=DeleteCases[reps,1];
 MemberQ[{2,4},Length[colored]]&&Count[colored,3]===Count[colored,-3]
];
ConstructiveDiagrams`Private`colorCurrentSourceClass[___]:=False;

ConstructiveDiagrams`Private`colorCurrentSource[ccsProcess_List,ccsModel_List]:=Module[
 {ccsTag=Unique["coloredCurrent"],ccsAbort,ccsRows,ccsFermions,ccsScalars,ccsBefore,ccsOriginal,ccsData,ccsDiagrams,
 ccsUsed,ccsNeeded,ccsTemporary,ccsCatalog,ccsLifted,ccsOriginalCertificates,ccsLiftedCertificates,ccsOriginalSigns,
 ccsLiftedSigns,ccsRepresentations,ccsColoredRepresentations,ccsCandidates,ccsCoordinates,ccsMappedCoordinates,ccsMapping={},ccsMatches,ccsUnmatched,ccsOriginalPairs,
 ccsConverted,ccsExternal,ccsTerms,ccsExpression,ccsExpected,ccsWeights,ccsLocal={},ccsStructure,ccsLegs,ccsTensor,
 ccsRow,ccsVertex,ccsI,ccsJ,ccsKind,ccsRowsByName,ccsAlias,ccsReconstructed},
 Catch[
 ccsAbort[ccsReason_,ccsDetails_:<||>]:=Throw[Failure[ccsReason,ccsDetails],ccsTag];
 ccsBefore=HEPCATCovariantCurrentSources`Private`objectSHA[ccsModel];
 If[!ConstructiveDiagrams`Private`colorCurrentSourceClass[ccsProcess,ccsModel],
  ccsAbort["UnsupportedExternalMassiveColoredFourFermionScalarClass"]];
 ccsOriginal=CreateDiagrams[ccsProcess,ccsModel];
 If[!ListQ[ccsOriginal]||ccsOriginal==={}||!AllTrue[ccsOriginal,AssociationQ],ccsAbort["OriginalDiagramGenerationIncomplete"]];
 ccsData=ConstructiveDiagrams`Private`colorDiagramBasis[ccsOriginal,ccsModel];
 If[!AssociationQ[ccsData],ccsAbort["OriginalColorProjectionIncomplete",<|"Reason"->ccsData|>]];
 ccsDiagrams=ccsData["Diagrams"];
 If[Sort[DeleteDuplicates[ccsData["DiagramOrigins"]]]=!=Range[Length[ccsOriginal]],ccsAbort["IncompleteOriginalHelicityBlockCoverage"]];
 ccsUsed=HEPCATCovariantCurrentSources`Private`usedRows[ccsDiagrams];
 If[ccsUsed==={}||!AllTrue[ccsUsed,Length[HEPCATCovariantCurrentSources`Private`rowParticles[#]]===3&],ccsAbort["UnsupportedUsedArity"]];
 If[!FreeQ[ccsUsed,_ColorIndex|_ColorDelta|_ColorGenerator|_ColorStructure|_ColorTrace],ccsAbort["ExplicitStoredColorNeedsSeparateFactorizationProof"]];
 ccsNeeded=DeleteDuplicates[Flatten[HEPCATCovariantCurrentSources`Private`rowParticles/@ccsUsed]];
 If[!AllTrue[HEPCATCovariantCurrentSources`Private`particleRow[#,ccsModel]&/@ccsNeeded,
  ListQ[#]&&MemberQ[{1,3,-3,8},#[[8]]]&],ccsAbort["UnsupportedUsedRepresentation"]];
 Do[
  ccsStructure=Last[ccsDiagrams[[ccsI]]["VertexStructures"][ccsVertex]];
  ccsLegs=MapIndexed[Join[#1,<|"ColorIndex"->ColorIndex[First[#2]]|>]&,ccsStructure["IncidentLegs"]];
  ccsTensor=ConstructiveDiagrams`Private`colorVertexTensor[ccsLegs,ccsModel,ccsStructure["ModelRow"]];
  If[!MatchQ[ccsTensor,1|_ColorDelta|_ColorGenerator],ccsAbort["UnsupportedLocalColorOperator",<|"Tensor"->ccsTensor|>]];
  AppendTo[ccsLocal,<|"Diagram"->ccsI,"Vertex"->ccsVertex,"OrderedParticles"->Lookup[ccsLegs,"Particle"],
   "SourceModelRow"->ccsStructure["ModelRow"],"LocalColorOperator"->ccsTensor,"KinematicsIndependent"->True|>],
  {ccsI,Length[ccsDiagrams]},{ccsVertex,ccsDiagrams[[ccsI]]["InternalVertices"]}];
 ccsTemporary=ReplacePart[ccsModel,1->(ReplacePart[#,8->1]&/@ccsModel[[1]])];
 ccsCatalog=HEPCATCovariantCurrentSources`Private`sourceCatalog[ccsTemporary,ccsUsed];
 If[!AssociationQ[ccsCatalog],ccsAbort["ExactLorentzCatalogUnavailable",<|"Reason"->ccsCatalog|>]];
 ccsLifted=CreateDiagrams[ccsProcess,ccsCatalog["Model"]];
 If[!ListQ[ccsLifted]||ccsLifted==={}||!AllTrue[ccsLifted,AssociationQ],ccsAbort["LiftedDiagramGenerationIncomplete"]];
 ccsOriginalCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,ccsCatalog,ccsTemporary,False]&/@ccsDiagrams;
 ccsLiftedCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,ccsCatalog,ccsTemporary,True]&/@ccsLifted;
 If[!AllTrue[Join[ccsOriginalCertificates,ccsLiftedCertificates],AssociationQ],ccsAbort["IncompleteOrderedGraphCertificate"]];
 ccsOriginalSigns=ConstructiveDiagrams`diagramFermionSign/@ccsDiagrams;
 ccsLiftedSigns=ConstructiveDiagrams`diagramFermionSign/@ccsLifted;
 If[!AllTrue[Join[ccsOriginalSigns,ccsLiftedSigns],MemberQ[{-1,1},#]&],ccsAbort["UnresolvedGraphFermionSign"]];
 ccsCoordinates=ccsData["DiagramCoordinates"];ccsUnmatched=Range[Length[ccsDiagrams]];
 Do[
  ccsMatches=Select[ccsUnmatched,SameQ[ccsOriginalCertificates[[#]],ccsLiftedCertificates[[ccsJ]]]&&ccsOriginalSigns[[#]]===ccsLiftedSigns[[ccsJ]]&];
  If[ccsMatches==={},ccsAbort["NoOrderedGraphColorCorrespondence",<|"LiftedIndex"->ccsJ|>]];
  If[Length[ccsMatches]>1&&!TrueQ[SameQ@@ccsCoordinates[[ccsMatches]]],ccsAbort["AmbiguousGraphColorCorrespondence"]];
  ccsI=First[ccsMatches];AppendTo[ccsMapping,<|"LiftedIndex"->ccsJ,"OriginalIndex"->ccsI,"OriginalOrigin"->ccsData["DiagramOrigins"][[ccsI]],
   "OrderedGraphCertificate"->ccsLiftedCertificates[[ccsJ]],"OriginalFermionSign"->ccsOriginalSigns[[ccsI]],
   "LiftedFermionSign"->ccsLiftedSigns[[ccsJ]],"ColorCoordinates"->ccsCoordinates[[ccsI]],"EquivalentColorBucket"->ccsMatches|>];
  ccsUnmatched=DeleteCases[ccsUnmatched,ccsI],{ccsJ,Length[ccsLifted]}];
 If[ccsUnmatched=!={}||Length[ccsMapping]=!=Length[ccsDiagrams],ccsAbort["IncompletePerGraphCoverage"]];
 ccsOriginalPairs=DiagramAmplitudes[ccsLifted];
 ccsConverted=FeynmanToSpinorProducts[ccsOriginalPairs,"ReferenceSpinors"->Automatic,"ReduceSpinorProducts"->False,"TimeConstraint"->90];
 If[!TrueQ[ConstructiveDiagrams`Private`constructBenchmarkConversionCompleteQ[ccsOriginalPairs,ccsConverted]],ccsAbort["IncompleteOffShellConversion"]];
 ccsExternal=First[First[ccsConverted]];
 If[!AllTrue[ccsConverted,First[#]===ccsExternal&],ccsAbort["ExternalMassOrderingMismatch"]];
 ccsMappedCoordinates=Lookup[ccsMapping,"ColorCoordinates"];
 ccsTerms=MapThread[Times,{Last/@ccsConverted,(#.ccsData["Basis"]&/@ccsMappedCoordinates)}];
 ccsExpression=Total[ccsTerms];
 ccsExpected=HEPCATCovariantCurrentSources`Private`declaredExternalSpinWeights[ccsProcess,ccsTemporary];
 ccsWeights=ConstructiveDiagrams`Private`completionExternalSpinWeights[ccsExpression,ccsExternal];
 If[ccsWeights=!=ccsExpected,ccsAbort["ExternalSpinWeightMismatch",<|"Expected"->ccsExpected,"Actual"->ccsWeights|>]];
 If[ccsBefore=!=HEPCATCovariantCurrentSources`Private`objectSHA[ccsModel],ccsAbort["OriginalModelChanged"]];
 <|"Status"->"UNVALIDATED_CANDIDATE","Amplitude"->{ccsExternal,ccsExpression},"Expression"->ccsExpression,
 "ExternalMassRules"->ccsExternal,"ExternalParticles"->ccsProcess,"CompleteSpinWeights"->ccsWeights,
 "NumericalParameterAssignments"->{},"NewIndependentContacts"->False,
 "EveryOriginalDiagramCovered"->True,"EveryUsedOrderedVertexCertified"->True,
 "Method"->"ExactPerGraphColoredMinimalCurrents",
 "ContinuationAssumption"->"MinimalRenormalizableCovariantCurrentsOfExactlyMatchedElementaryVertices",
 "Process"->ccsProcess,"OriginalDiagramCount"->Length[ccsOriginal],"ResolvedOriginalDiagramCount"->Length[ccsDiagrams],
 "LiftedDiagramCount"->Length[ccsLifted],"PerGraphCorrespondence"->ccsMapping,"LocalColorCertificates"->ccsLocal,
 "VertexCertificates"->ccsCatalog["Certificates"],"OriginalColorProjection"->ccsData,
 "OriginalGraphCertificates"->ccsOriginalCertificates,"LiftedGraphCertificates"->ccsLiftedCertificates,
 "ConvertedLorentzPairs"->ccsConverted,"ColoredGraphTerms"->ccsTerms,"ModelParametersUnchanged"->SameQ[ccsModel[[3;;4]],ccsTemporary[[3;;4]]],
 "SourceModelSHA256"->ccsBefore,"TemporaryModelSHA256"->HEPCATCovariantCurrentSources`Private`objectSHA[ccsTemporary],
 "EveryOriginalOrderedGraphAndFermionSignMatched"->True,"CompleteOffShellConversionCoverage"->True,
 "NumericalCoefficientFit"->False,"IndependentBenchmarkRead"->False,"NativeValidationPerformed"->False,
 "InternalOnShellConditions"->{},"RequiresCheckAmplitudes"->True|>
 ,ccsTag]
];

ConstructiveDiagrams`Private`colorCurrentSourceCertificate[cvSource_Association,cvModel_List]:=Module[
 {cvTag=Unique["replay"],cvRequire,cvData,cvResolvedData,cvDiagrams,cvUsed,cvTemporary,cvCatalog,cvLifted,
 cvOriginalCertificates,cvLiftedCertificates,cvOriginalSigns,cvLiftedSigns,cvRepresentations,
 cvOriginalTensors,cvBasisVectors,cvOriginalVectors,cvGram,cvCoordinates,cvMap,cvPairs,cvExpectedPairs,
 cvTerms,cvExpression,cvLocalExpected={},cvStructure,cvLegs,cvOperator,cvI,cvJ,cvVertex,cvEntry},
 Catch[
 cvRequire[cvValue_,cvReason_]:=If[!TrueQ[cvValue],Throw[Failure[cvReason,<||>],cvTag]];
 cvRequire[Lookup[cvSource,"Status",None]==="UNVALIDATED_CANDIDATE","ProposalStatusMustRemainUnvalidated"];
 cvRequire[cvSource["SourceModelSHA256"]===HEPCATCovariantCurrentSources`Private`objectSHA[cvModel],"SourceModelOwnership"];
 cvData=cvSource["OriginalColorProjection"];cvDiagrams=cvData["Diagrams"];
 cvUsed=HEPCATCovariantCurrentSources`Private`usedRows[cvDiagrams];
 cvRequire[AllTrue[cvUsed,MemberQ[cvModel[[2]],#]&],"StoredVertexRowNotOwnedByModel"];
 cvTemporary=ReplacePart[cvModel,1->(ReplacePart[#,8->1]&/@cvModel[[1]])];
 cvRequire[cvSource["TemporaryModelSHA256"]===HEPCATCovariantCurrentSources`Private`objectSHA[cvTemporary],"TemporaryModelOwnership"];
 cvCatalog=HEPCATCovariantCurrentSources`Private`sourceCatalog[cvTemporary,cvUsed];cvRequire[AssociationQ[cvCatalog],"ExactLocalVertexCatalog"];
 cvRequire[Sort[Lookup[cvSource["VertexCertificates"],"CertificateID"]]===Sort[Lookup[cvCatalog["Certificates"],"CertificateID"]],"LocalVertexCertificateBinding"];
 cvLifted=CreateDiagrams[cvSource["Process"],cvCatalog["Model"]];cvRequire[ListQ[cvLifted]&&cvLifted=!={},"LiftedGraphsAvailable"];
 cvOriginalCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,cvCatalog,cvTemporary,False]&/@cvDiagrams;
 cvLiftedCertificates=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,cvCatalog,cvTemporary,True]&/@cvLifted;
 cvRequire[cvOriginalCertificates===cvSource["OriginalGraphCertificates"]&&cvLiftedCertificates===cvSource["LiftedGraphCertificates"],"OrderedGraphLedgerBinding"];
 cvOriginalSigns=ConstructiveDiagrams`diagramFermionSign/@cvDiagrams;cvLiftedSigns=ConstructiveDiagrams`diagramFermionSign/@cvLifted;
 cvRepresentations=ConstructiveDiagrams`Private`colorParticleRepresentation[#,cvModel]&/@cvSource["Process"];
 cvRequire[cvRepresentations===cvData["Representations"],"ColorRepresentationBinding"];
 cvResolvedData=ConstructiveDiagrams`Private`colorDiagramBasis[cvDiagrams,cvModel];
 cvRequire[AssociationQ[cvResolvedData]&&cvResolvedData["DiagramOrigins"]===Range[Length[cvDiagrams]],"ResolvedHelicityColorCoverage"];
 cvOriginalTensors=cvResolvedData["DiagramTensors"];
 cvRequire[cvOriginalTensors===cvData["DiagramTensors"],"OriginalColorTensorBinding"];
 cvBasisVectors=Normal[ConstructiveDiagrams`Private`colorTensorVectorSparse[#,cvRepresentations]]&/@cvData["Basis"];
 cvOriginalVectors=Normal[ConstructiveDiagrams`Private`colorTensorVectorSparse[#,cvRepresentations]]&/@cvOriginalTensors;
 cvGram=Simplify[Conjugate[cvBasisVectors].Transpose[cvBasisVectors]];
 cvRequire[cvGram===cvData["GramMatrix"]&&MatrixRank[cvGram]===Length[cvBasisVectors],"ExactColorGramBinding"];
 cvCoordinates=cvData["DiagramCoordinates"];
 cvRequire[cvCoordinates.cvBasisVectors===cvOriginalVectors,"EveryGraphColorCoordinateReconstruction"];
 Do[cvStructure=Last[cvDiagrams[[cvI]]["VertexStructures"][cvVertex]];
  cvLegs=MapIndexed[Join[#1,<|"ColorIndex"->ColorIndex[First[#2]]|>]&,cvStructure["IncidentLegs"]];
  cvOperator=ConstructiveDiagrams`Private`colorVertexTensor[cvLegs,cvModel,cvStructure["ModelRow"]];
  AppendTo[cvLocalExpected,<|"Diagram"->cvI,"Vertex"->cvVertex,"OrderedParticles"->Lookup[cvLegs,"Particle"],"SourceModelRow"->cvStructure["ModelRow"],"LocalColorOperator"->cvOperator,"KinematicsIndependent"->True|>],
  {cvI,Length[cvDiagrams]},{cvVertex,cvDiagrams[[cvI]]["InternalVertices"]}];
 cvRequire[cvLocalExpected===cvSource["LocalColorCertificates"],"EveryLocalColorOperatorAndRowBinding"];
 cvMap=cvSource["PerGraphCorrespondence"];
 cvRequire[Length[cvMap]===Length[cvDiagrams]===Length[cvLifted]&&Sort[Lookup[cvMap,"OriginalIndex"]]===Range[Length[cvDiagrams]]&&Lookup[cvMap,"LiftedIndex"]===Range[Length[cvLifted]],"PerGraphBijection"];
 Do[cvEntry=cvMap[[cvJ]];cvI=cvEntry["OriginalIndex"];
  cvRequire[cvEntry["OrderedGraphCertificate"]===cvOriginalCertificates[[cvI]]===cvLiftedCertificates[[cvJ]],"PerGraphOrderedPortAndCutMatch"];
  cvRequire[cvEntry["OriginalFermionSign"]===cvOriginalSigns[[cvI]]===cvEntry["LiftedFermionSign"]===cvLiftedSigns[[cvJ]],"PerGraphWickSignMatch"];
  cvRequire[cvEntry["ColorCoordinates"]===cvCoordinates[[cvI]],"PerGraphColorCoordinateMatch"],{cvJ,Length[cvMap]}];
 cvPairs=cvSource["ConvertedLorentzPairs"];
 cvExpectedPairs=FeynmanToSpinorProducts[DiagramAmplitudes[cvLifted],"ReferenceSpinors"->Automatic,"ReduceSpinorProducts"->False,"TimeConstraint"->60];
 cvRequire[cvPairs===cvExpectedPairs,"OffShellLorentzConversionReplay"];
 cvTerms=MapThread[#1(#2.cvData["Basis"])&,{Last/@cvPairs,Lookup[cvMap,"ColorCoordinates"]}];
 cvRequire[cvTerms===cvSource["ColoredGraphTerms"],"PerGraphColorLorentzAssembly"];
 cvExpression=Total[cvTerms];
 cvRequire[cvExpression===cvSource["Expression"]&&cvSource["Amplitude"]==={First[First[cvPairs]],cvExpression},"CompleteAmplitudeAssembly"];
 <|"Status"->"CERTIFICATE_VERIFIED","Graphs"->Length[cvDiagrams],"ColorRank"->Length[cvBasisVectors],
  "ColorStates"->Length[First[cvBasisVectors]],"EveryGraphColorVectorExactlyReconstructed"->True,
  "EveryWickSignAndOrderedPortRecomputed"->True,"CompleteLorentzConversionRecomputed"->True,
  "ReferenceBenchmarkRead"->False,"NativeAmplitudeValidationClaimed"->False|>
 ,cvTag]
];


ConstructiveDiagrams`Private`colorCurrentPrepare[process_List,model_List,lower_List,settings_Association,
 deadline_?constructSecondsQ,originalDiagrams_List]:=Module[
 {remaining,proposal,certificate,prepared,pair,prepOptions,childLimit,budget,started=AbsoluteTime[],retain},
 If[Lookup[settings,"FeynmanModel",None]===None||!ConstructiveDiagrams`Private`colorCurrentSourceClass[process,model],
  Return[<|"Attempted"->False,"Selected"->False,"Status"->"NOT_APPLICABLE"|>]];
 remaining=Max[0,deadline-AbsoluteTime[]];If[remaining<=0.01,
  Return[<|"Attempted"->False,"Selected"->False,"Status"->"NO_REMAINING_BUDGET"|>]];
 budget=Min[60,Max[0.001,remaining/3]];
 If[TrueQ[settings["ProgressReporting"]],Print["Building certified per-graph colored currents."]];
 proposal=TimeConstrained[ConstructiveDiagrams`Private`colorCurrentSource[process,model],budget,Missing["ColoredCurrentSourceTimeConstraint"]];
 If[!AssociationQ[proposal]||Lookup[proposal,"Status",None]=!="UNVALIDATED_CANDIDATE"||
  !AllTrue[{"EveryOriginalOrderedGraphAndFermionSignMatched","EveryOriginalDiagramCovered","EveryUsedOrderedVertexCertified",
   "CompleteOffShellConversionCoverage","ModelParametersUnchanged","RequiresCheckAmplitudes"},TrueQ[Lookup[proposal,#,False]]&]||
  !AllTrue[{"NumericalCoefficientFit","IndependentBenchmarkRead","NativeValidationPerformed","NewIndependentContacts"},Lookup[proposal,#,None]===False&]||
  Lookup[proposal,"InternalOnShellConditions",None]=!={}||Lookup[proposal,"NumericalParameterAssignments",None]=!={}||
  Lookup[proposal,"SourceModelSHA256",None]=!=HEPCATCovariantCurrentSources`Private`objectSHA[model]||
  Lookup[proposal,"OriginalDiagramCount",None]=!=Length[originalDiagrams]||!preparationPairQ[Lookup[proposal,"Amplitude",None]],
  Return[<|"Attempted"->True,"Selected"->False,"Status"->"NOT_PROPOSED","Proposal"->proposal,"ElapsedTime"->AbsoluteTime[]-started|>]];
 remaining=Max[0.001,deadline-AbsoluteTime[]];
 certificate=TimeConstrained[ConstructiveDiagrams`Private`colorCurrentSourceCertificate[proposal,model],Min[budget,remaining],Missing["ColoredCurrentCertificateTimeConstraint"]];
 If[!AssociationQ[certificate]||Lookup[certificate,"Status",None]=!="CERTIFICATE_VERIFIED",
  Return[<|"Attempted"->True,"Selected"->False,"Status"->"NOT_PROPOSED","Proposal"->proposal,"Certificate"->certificate,"ElapsedTime"->AbsoluteTime[]-started|>]];
 remaining=Max[0.001,deadline-AbsoluteTime[]];
 prepOptions=Join[KeyTake[settings,First/@Options[PrepareAmplitudes]],constructRuleOptions[settings["FinalPreparationOptions"]],
  <|"ExternalParticles"->process,"InternalOnShell"->False,"ReturnDetails"->True,"Output"->"Amplitudes"|>];
 childLimit=Replace[Lookup[prepOptions,"TimeConstraint",Automatic],{Automatic->40,Infinity->40}];prepOptions["TimeConstraint"]=Min[childLimit,remaining];
 If[!KeyExistsQ[constructRuleOptions[settings["FinalPreparationOptions"]],"PolePreference"],prepOptions["PolePreference"]=settings["PolePreference"]];
 If[TrueQ[settings["ProgressReporting"]],Print["Preparing completed colored currents with external identities."]];
 prepared=TimeConstrained[Block[{$preparationModelParameterOverrides=settings["ParameterRules"]},
  PrepareAmplitudes[proposal["Amplitude"],model,Sequence@@Normal[prepOptions]]],remaining,Missing["ColoredCurrentPreparationTimeConstraint"]];
 If[!constructPreparationUsableQ[prepared],Return[<|"Attempted"->True,"Selected"->False,"Status"->"NOT_PROPOSED",
  "Proposal"->proposal,"Certificate"->certificate,"Preparation"->prepared,"ElapsedTime"->AbsoluteTime[]-started|>]];
 pair=First[prepared["PreparedAmplitudes"]];retain=MemberQ[{None,"Xi","IndependentXi"},settings["PolePreference"]];
 If[!preparationPairQ[pair]||First[pair]=!=proposal["ExternalMassRules"]||
  Sort[First/@First[pair]]=!=Sort[Mass/@Range[Length[process]]]||
  (!retain&&!FreeQ[Last[pair],(Spinor|SpinorHat)["Xi",___]]),
  Return[<|"Attempted"->True,"Selected"->False,"Status"->"NOT_PROPOSED","Proposal"->proposal,
   "Certificate"->certificate,"Preparation"->prepared,"Reason"->"No external-only completed representative was established.","ElapsedTime"->AbsoluteTime[]-started|>]];
 <|"Attempted"->True,"Selected"->False,"Status"->"PROPOSED","Proposal"->proposal,"Certificate"->certificate,
  "PreparedPair"->pair,"Preparation"->prepared,"InternalOnShell"->False,
  "IndependentBenchmarkUsedForConstruction"->False,"SourcePreparationTimeConstraint"->prepOptions["TimeConstraint"],"ElapsedTime"->AbsoluteTime[]-started|>
];
ConstructiveDiagrams`Private`colorCurrentProjection[attempt_Association,pairs_List,channels_List,reps_List,benchmarkPairs_List]:=Module[
 {pair,data,amplitudes,expected},
 If[Lookup[attempt,"Status",None]=!="PROPOSED",Return[Missing["NoColoredCurrentProposal"]]];
 If[benchmarkPairs==={},Return[Missing["IndependentBenchmarkRequired"]]];
 pair=Lookup[attempt,"PreparedPair",Missing["NoColoredCurrentPair"]];If[!preparationPairQ[pair],Return[Missing["InvalidColoredCurrentPair"]]];
 data=colorProjectionData[Append[pairs,pair],channels,reps,benchmarkPairs];
 If[!AssociationQ[data]||Length[Lookup[data,"Basis",{}]]<1,Return[Missing["IncompleteColoredCurrentProjection"]]];
 expected=Length[pairs]+1;
 If[!AllTrue[data["ProjectedDiagrams"],Length[#]===expected&]||!AllTrue[data["ProjectedChannels"],Length[#]===Length[channels]&]||
  !AllTrue[data["ProjectedFeynmanAmplitudes"],Length[#]===Length[benchmarkPairs]&],Return[Missing["IncompleteColoredCurrentUnion"]]];
 amplitudes=Last[Last[#]]&/@data["ProjectedDiagrams"];
 <|"Status"->"PROJECTED","Data"->data,"Amplitudes"->amplitudes,"Certificate"-><|
  "AllOriginalDiagramPairsIncluded"->Length[pairs],"AllOriginalTargetRowsIncluded"->Length[channels],
  "AllIndependentFeynmanPairsIncluded"->Length[benchmarkPairs],"CandidatePairIncluded"->True,
  "FullUnionRank"->Length[data["Basis"]],"ExactCommonUnionGramReconstruction"->True|>|>
];
End[];
