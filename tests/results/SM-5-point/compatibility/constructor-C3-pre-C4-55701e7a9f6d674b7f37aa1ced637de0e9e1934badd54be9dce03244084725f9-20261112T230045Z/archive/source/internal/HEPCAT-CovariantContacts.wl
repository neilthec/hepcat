(* Source-only, portable calibration of an existing metric quartic continuation.
   Load HEPCAT and covariant-current-sources.wl first. The complete lower amplitude
   determines the contact after the chosen cubic continuation; no benchmark is read. *)
Begin["HEPCATCovariantContactCalibration`Private`"];
HEPCATCovariantContactCalibration`Private`reject[tag_String,data_:<||>]:=Failure[tag,data];
HEPCATCovariantContactCalibration`Private`objectSHA[value_]:=IntegerString[Hash[value,"SHA256"],16,64];
HEPCATCovariantContactCalibration`Private`rowParticles[row_List]:=DeleteCases[Drop[row,-2],""];
HEPCATCovariantContactCalibration`Private`coherent[expression_]:=expression/.
 Spinor["Spin","Upper",kind:("Angle"|"Square"),leg_Integer,VectorSpinIndex[leg_Integer,1|2]]:>Spinor["Spin",kind,leg];
(* A name map is admitted only between declared keys of matching parameter roles.
   Independent numerical defaults do not enter this symbolic identification. *)
HEPCATCovariantContactCalibration`Private`parameterTransport[expression_,source_List,lower_List]:=Module[
 {sourceKeys,lowerKeys,used,previous={},functions,map={},matches,p,key,sourceKey,lowerExpanded,sourceExpanded,
  differences={},lowerIndependent,sourceIndependent,declaredNames},
 sourceKeys=First/@Join[source[[3]],source[[4]]];lowerKeys=First/@Join[lower[[3]],lower[[4]]];
 If[!AllTrue[Join[sourceKeys,lowerKeys],MatchQ[#,_ModelParameter]&],Return[HEPCATCovariantContactCalibration`Private`reject["MalformedParameterOwnership"]]];
 used=DeleteDuplicates[Cases[expression,_ModelParameter,{0,Infinity}]];
 If[Complement[used,lowerKeys]=!={},Return[HEPCATCovariantContactCalibration`Private`reject["ForeignLowerModelParameter"]]];
 functions=First[#]->#[[2]]&/@lower[[4]];
 While[used=!=previous,previous=used;used=DeleteDuplicates[Join[used,Flatten[Cases[#, _ModelParameter,{0,Infinity}]&/@
  Cases[functions,Rule[p_,body_]/;MemberQ[used,p]:>body]]]]];
 Do[matches=Select[sourceKeys,ModelParameterName[#]===ModelParameterName[p]&];
  If[Length[matches]=!=1,Return[HEPCATCovariantContactCalibration`Private`reject["MissingOrAmbiguousSourceParameter",<|"Name"->ModelParameterName[p]|>]]];
  sourceKey=First[matches];
  If[Last[List@@p]=!=Last[List@@sourceKey]||MemberQ[First/@lower[[3]],p]=!=MemberQ[First/@source[[3]],sourceKey],
   Return[HEPCATCovariantContactCalibration`Private`reject["ParameterRoleMismatch",<|"Name"->ModelParameterName[p]|>]]];
  AppendTo[map,p->sourceKey],{p,used}];
 Do[If[MemberQ[First/@lower[[4]],p],
   lowerExpanded=ConstructiveDiagrams`Private`modelExpandParameterDefinitions[p,lower]/.map;
   sourceExpanded=ConstructiveDiagrams`Private`modelExpandParameterDefinitions[p/.map,source];
   If[!FreeQ[{lowerExpanded,sourceExpanded},_ModelFunction|_Failure],Return[HEPCATCovariantContactCalibration`Private`reject["UnsupportedParameterDependency"]]];
   AppendTo[differences,ModelParameterName[p]->Cancel[Together[Rationalize[lowerExpanded-sourceExpanded,0]]]]],{p,used}];
 If[!AllTrue[Last/@differences,#===0&],Return[HEPCATCovariantContactCalibration`Private`reject["DifferentModelParameterDefinitions",<|"Differences"->differences|>]]];
 <|"Expression"->(expression/.map),"ParameterMap"->map,"DependentDefinitionDifferences"->differences,
   "NumericalDefaultsUsed"->False|>
];
Options[HEPCATCovariantContactCalibration`Private`metricContactCalibration]={"TimeConstraint"->30};
HEPCATCovariantContactCalibration`Private`metricContactCalibration[diagramModel_List,lowerModel_List,
 vectorNames:{_String,_String},scalarName_String,OptionsPattern[]]:=Module[
 {seconds=OptionValue["TimeConstraint"],before,lowerBefore,result,started=AbsoluteTime[],tag=Unique["metricContactCalibration"]},
 If[!(NumericQ[seconds]&&TrueQ[0<seconds<Infinity]),Return[HEPCATCovariantContactCalibration`Private`reject["InvalidContactCalibrationBudget"]]];
 before=HEPCATCovariantContactCalibration`Private`objectSHA[diagramModel];lowerBefore=HEPCATCovariantContactCalibration`Private`objectSHA[lowerModel];
 result=TimeConstrained[Catch[Module[
  {fail,process,rows,sourceMasses,external,lowerRows,matchingLower,matchingQuartic,known,bare,transport,lowerMasses,
   cubicModel,diagrams,used,catalog,liftedDiagrams,sourceSignatures,liftedSignatures,pairs,converted,cubic,unit,rawUnit,match,prefactor,
   p=Unique["radialScalar"],q=Unique["radialVector"],energy=Unique["energy"],angle=Unique["angle"],beta=Unique["metricCoefficient"],
   coordinates=Table[Unique["coherentSpin"],{4}],mh,mv,sine,cosine,momenta,angleBasis,squareBasis,chart,mapped,rules,monomials,
   coefficientRules,coefficients,reducedParts={},numerator,denominator,relations,reduced,equations,solutions,coefficient,remainder,
   conservation,shells,homogeneity,transportedLowerMasses,sourceBareCertificate,denominators,fullNumerator,fullDenominator},
  fail[reason_,data_:<||>]:=Throw[HEPCATCovariantContactCalibration`Private`reject[reason,data],tag];
  If[Length[diagramModel]=!=4||Length[lowerModel]=!=4||!AllTrue[Join[diagramModel,lowerModel],ListQ],fail["InvalidContactCalibrationModels"]];
  If[DownValues[HEPCATCovariantCurrentSources`Private`sourceCatalog]==={},fail["MissingCubicSourceHelper"]];
  process=Join[{scalarName,scalarName},vectorNames];
  rows=HEPCATCovariantCurrentSources`Private`particleRow[#,diagramModel]&/@process;
  lowerRows=HEPCATCovariantCurrentSources`Private`particleRow[#,lowerModel]&/@process;
  If[!AllTrue[Join[rows,lowerRows],ListQ],fail["UnknownContactParticle"]];
  If[rows[[All,5]]=!={0,0,2,2}||lowerRows[[All,5]]=!={0,0,2,2}||
    !AllTrue[Join[rows,lowerRows],#[[8]]===1&],fail["UnsupportedContactSpinOrColor"]];
  sourceMasses=rows[[All,6]];
  If[sourceMasses[[3]]===0||sourceMasses[[3]]=!=sourceMasses[[4]]||
    !AllTrue[sourceMasses,HEPCATCovariantCurrentSources`Private`modelScalarQ[#,diagramModel]&],fail["UnsupportedContactMassClass"]];
  external=Thread[(Mass/@Range[4])->sourceMasses];mh=sourceMasses[[1]];mv=sourceMasses[[3]];
  matchingLower=Select[lowerModel[[2]],Sort[HEPCATCovariantContactCalibration`Private`rowParticles[#]]===Sort[process]&];
  matchingQuartic=Select[diagramModel[[2]],Sort[HEPCATCovariantContactCalibration`Private`rowParticles[#]]===Sort[process]&];
  If[Length[matchingLower]=!=1,fail["UnknownOrAmbiguousCompleteLowerAmplitude"]];
  If[Length[matchingQuartic]=!=1,fail["MissingOrAmbiguousExistingQuarticOperator"]];
  known=Block[{ConstructiveDiagrams`Private`$colorFactorizationEnabled=False},
   LookupAmplitude[MapIndexed[{#1,First[#2]}&,process],ReplacePart[lowerModel,2->matchingLower],False,Table[Unique["lowerSpin"],{4}]]];
  transport=HEPCATCovariantContactCalibration`Private`parameterTransport[{known,lowerRows[[All,6]]},diagramModel,lowerModel];
  If[FailureQ[transport],Throw[transport,tag]];
  {known,transportedLowerMasses}=transport["Expression"];
  If[!AllTrue[MapThread[Cancel[Together[Rationalize[ConstructiveDiagrams`Private`modelExpandParameterDefinitions[#1-#2,diagramModel],0]]]&, {sourceMasses,transportedLowerMasses}],#===0&],fail["LowerExternalMassMismatch"]];
  If[!FreeQ[known,_Real|_ModelFunction|_SpinorHat|_MomHat|_MomQ|_xFactor|_xTildeFactor|Spinor["Xi"|"Zeta",___]],fail["UnsupportedKnownFourPointExpression"]];
  bare=Block[{ConstructiveDiagrams`Private`$colorFactorizationEnabled=False},
   LookupAmplitude[MapIndexed[{#1,First[#2]}&,process],ReplacePart[diagramModel,2->matchingQuartic],False,Table[Unique["quarticSpin"],{4}]]];
  rawUnit=LorentzMetric[LorentzIndex[3],LorentzIndex[4]]PolarizationVector[3,LorentzIndex[3],mv,Automatic]PolarizationVector[4,LorentzIndex[4],mv,Automatic];
  sourceBareCertificate=HEPCATCovariantCurrentSources`Private`exactVertexMatch[bare,{rawUnit},{3,4},diagramModel];
  If[!AssociationQ[sourceBareCertificate],fail["NonminimalExistingQuarticOperator",<|"Reason"->sourceBareCertificate|>]];
  prefactor=First[sourceBareCertificate["Coefficients"]];
  If[prefactor===0,fail["ZeroExistingQuarticNormalization"]];
  cubicModel=ReplacePart[diagramModel,2->Select[diagramModel[[2]],Length[HEPCATCovariantContactCalibration`Private`rowParticles[#]]===3&]];
  diagrams=CreateDiagrams[process,cubicModel];
  If[!ListQ[diagrams]||diagrams==={}||!AllTrue[diagrams,AssociationQ],fail["IncompleteCubicExchangeGraphs"]];
  used=HEPCATCovariantCurrentSources`Private`usedRows[diagrams];
  catalog=HEPCATCovariantCurrentSources`Private`sourceCatalog[cubicModel,used];
  If[!AssociationQ[catalog],fail["UnsupportedCubicExchangeSource",<|"Reason"->catalog|>]];
  liftedDiagrams=CreateDiagrams[process,catalog["Model"]];
  If[!ListQ[liftedDiagrams]||!AllTrue[liftedDiagrams,AssociationQ],fail["IncompleteLiftedExchangeGraphs"]];
  sourceSignatures=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,catalog,cubicModel,False]&/@diagrams;
  liftedSignatures=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,catalog,cubicModel,True]&/@liftedDiagrams;
  If[!AllTrue[Join[sourceSignatures,liftedSignatures],AssociationQ]||Sort[sourceSignatures]=!=Sort[liftedSignatures],fail["CubicOrderedGraphCoverageMismatch"]];
  pairs=DiagramAmplitudes[liftedDiagrams];converted=FeynmanToSpinorProducts[pairs,"ReferenceSpinors"->Automatic,"ReduceSpinorProducts"->False,"TimeConstraint"->seconds];
  If[!TrueQ[ConstructiveDiagrams`Private`constructBenchmarkConversionCompleteQ[pairs,converted]],fail["CubicOffShellConversionIncomplete"]];
  cubic=HEPCATCovariantContactCalibration`Private`coherent[Total[Last/@converted]];
  unit=HEPCATCovariantContactCalibration`Private`coherent[FeynmanToSpinorProducts[rawUnit,"ReduceSpinorProducts"->False,"TimeConstraint"->seconds]];
  homogeneity=ConstructiveDiagrams`Private`completionExternalSpinWeights[#,external]&/@{known,cubic,unit};
  If[homogeneity=!={{0,0,2,2},{0,0,2,2},{0,0,2,2}},fail["UnsupportedFourPointSpinHomogeneity"]];
  sine=2angle/(1+angle^2);cosine=(1-angle^2)/(1+angle^2);
  momenta=<|1->{{energy+p,0},{0,energy-p}},2->{{energy-p,0},{0,energy+p}},
   3->{{-energy+q cosine,q sine},{q sine,-energy-q cosine}},4->{{-energy-q cosine,-q sine},{-q sine,-energy+q cosine}}|>;
  angleBasis=Association@Table[i->{{mv,0},{0,1}},{i,{3,4}}];
  squareBasis=Association@Table[i->{{0,1},{-1,0}}.ConstructiveDiagrams`Private`residueAdjugate[momenta[i]].angleBasis[i]/mv,{i,{3,4}}];
  chart=<|"Momenta"->momenta,"Masses"->AssociationThread[Range[4],sourceMasses],
   "Angle"-><|3->angleBasis[3].Take[coordinates,2],4->angleBasis[4].Take[coordinates,-2]|>,
   "Square"-><|3->squareBasis[3].Take[coordinates,2],4->squareBasis[4].Take[coordinates,-2]|>,
   "AngleBasis"->angleBasis,"SquareBasis"->squareBasis,"PoleVariable"->Unique["unusedPole"]|>;
  relations={p^2-energy^2+mh^2,q^2-energy^2+mv^2};
  conservation=Total[Values[momenta]]===ConstantArray[0,{2,2}];
  shells=Table[PolynomialReduce[Det[momenta[i]]-sourceMasses[[i]]^2,relations,{p,q}][[2]],{i,4}];
  If[!conservation||shells=!={0,0,0,0},fail["InvalidSymbolicExternalChart"]];
  mapped=ConstructiveDiagrams`Private`residueEvaluateChart[(known-cubic)/prefactor-beta unit,chart,{}];
  If[!FreeQ[mapped,_Missing|_Failure|_Spinor|_Mom|_MomProd|_PropDen|_Mandelstahm]||!PolynomialQ[mapped,coordinates],fail["UnsupportedSymbolicFourPointMap"]];
  coefficientRules=CoefficientRules[Expand[mapped],coordinates];
  monomials=Flatten[Table[{i,2-i,j,2-j},{i,0,2},{j,0,2}],1];
  If[Complement[First/@coefficientRules,monomials]=!={},fail["UnexpectedCoherentSpinDegree"]];
  coefficients=Table[Total[Last/@Select[coefficientRules,First[#]===monomial&]],{monomial,monomials}];
  Do[{numerator,denominator}=Through[{Numerator,Denominator}[Together[component]]];
   AppendTo[reducedParts,{PolynomialReduce[numerator,relations,{p,q}][[2]],PolynomialReduce[denominator,relations,{p,q}][[2]]}],{component,coefficients}];
  reduced=First/@reducedParts;denominators=Last/@reducedParts;
  If[AnyTrue[denominators,#===0&],fail["DegenerateSymbolicDenominator"]];
  equations=DeleteCases[Flatten[Last/@CoefficientRules[Expand[#],{p,q,energy,angle}]&/@reduced],0];
  solutions=Solve[Thread[equations==0],beta];
  If[!ListQ[solutions]||Length[solutions]=!=1||!FreeQ[beta/.First[solutions],beta],fail["AllowedMetricContactNotUniquelyDetermined"]];
  coefficient=Cancel[Together[prefactor(beta/.First[solutions])]];
  remainder=Simplify[reduced/.First[solutions]];
  If[!HEPCATCovariantCurrentSources`Private`modelScalarQ[coefficient,diagramModel]||
    !FreeQ[coefficient,Alternatives@@Join[{p,q,energy,angle},coordinates]]||remainder=!=ConstantArray[0,9],fail["CompleteSymbolicContactReconstructionFailed"]];
  <|"Status"->"EXACT_SYMBOLIC_CONTACT_CALIBRATION","Particles"->process,"MetricCoefficient"->coefficient,
    "MetricOperator"->LorentzMetric[LorentzIndex[3],LorentzIndex[4]],"MetricSpinorTemplate"->unit,
    "AllowedOriginalQuarticRow"->First[matchingQuartic],"BareQuarticVertexCertificate"->sourceBareCertificate,
    "CompleteKnownFourPointAmplitude"->known,"SourceDerivedCubicExchanges"->cubic,"ParameterTransport"->transport,
    "CubicVertexCertificates"->catalog["Certificates"],"OriginalGraphCertificates"->sourceSignatures,"LiftedGraphCertificates"->liftedSignatures,
    "CubicDiagramCount"->Length[diagrams],"CompleteOffShellConversionCoverage"->True,
    "SymbolicChart"->chart,"MassShellIdeal"->relations,"MomentumConservationVerified"->conservation,
    "ExternalMassShellRemainders"->shells,"CoherentMonomials"->monomials,"AllCoherentCoefficientRemainders"->remainder,
    "CoherentComponentCount"->9,"CompleteCoherentCoefficientCoverage"->True,"DenominatorRemainders"->denominators,
    "NumericalKinematicSamples"->0,"NumericalParameterAssignments"->{},"NumericalCoefficientFit"->False,
    "IndependentBenchmarkRead"->False,"NewIndependentContact"->False,"InternalOnShellConditions"->{},
    "RequiresFullAmplitudeValidation"->True,"SourceModelSHA256"->before,"LowerModelSHA256"->lowerBefore,
    "ContinuationAssumption"->"MinimalCovariantCubicContinuationWithExistingMetricContactFixedByCompleteKnownLowerAmplitude"|>
 ],tag],seconds,HEPCATCovariantContactCalibration`Private`reject["ContactCalibrationTimeConstraint"]];
 If[HEPCATCovariantContactCalibration`Private`objectSHA[diagramModel]=!=before||HEPCATCovariantContactCalibration`Private`objectSHA[lowerModel]=!=lowerBefore,
  Return[HEPCATCovariantContactCalibration`Private`reject["ContactCalibrationModelChanged"]]];
 If[AssociationQ[result],Append[result,"Seconds"->N[AbsoluteTime[]-started]],result]
];
HEPCATCovariantContactCalibration`Private`metricContactCalibration[___]:=HEPCATCovariantContactCalibration`Private`reject["UnsupportedContactCalibrationInput"];
End[];

(* Five-leg candidate source. Contact data comes only from the complete lower model.
   The raw vector tensor is retained, and the implicit expression is its injective
   homogeneous coherent encoding, not an internal on-shell simplification. *)
Begin["HEPCATCovariantContactCalibration`Private`"];
Options[HEPCATCovariantContactCalibration`Private`calibratedCovariantSource]={"TimeConstraint"->60};
HEPCATCovariantContactCalibration`Private`calibratedCovariantSource[process_List,diagramModel_List,lowerModel_List,OptionsPattern[]]:=Module[
 {seconds=OptionValue["TimeConstraint"],started=AbsoluteTime[],sourceBefore,lowerBefore,result,tag=Unique["calibratedSource"]},
 If[!(NumericQ[seconds]&&TrueQ[0<seconds<Infinity]),Return[HEPCATCovariantContactCalibration`Private`reject["InvalidCalibratedSourceBudget"]]];
 sourceBefore=HEPCATCovariantContactCalibration`Private`objectSHA[diagramModel];lowerBefore=HEPCATCovariantContactCalibration`Private`objectSHA[lowerModel];
 result=TimeConstrained[Catch[Module[
  {fail,rows,fermions,vectors,scalars,diagrams,used,cubics,quartics,catalog,calibrations={},certificates,liftedRows,
   quartetRows,vectorNames,scalarNames,calibration,canonical,liftedRow,certificate,needed,particles,liftedModel,liftedDiagrams,
   sourceSignatures,liftedSignatures,pairs,converted,external,rawExpression,expression,vectorLegs,weights,expected,remaining},
  fail[reason_,data_:<||>]:=Throw[HEPCATCovariantContactCalibration`Private`reject[reason,data],tag];
  remaining[]:=Max[0.000001,seconds-(AbsoluteTime[]-started)];
  If[Length[diagramModel]=!=4||Length[lowerModel]=!=4||!AllTrue[Join[diagramModel,lowerModel],ListQ]||
    Length[process]=!=5||!AllTrue[process,StringQ],fail["UnsupportedCalibratedSourceInput"]];
  rows=HEPCATCovariantCurrentSources`Private`particleRow[#,diagramModel]&/@process;
  If[!AllTrue[rows,ListQ],fail["UnknownCalibratedSourceParticle"]];
  fermions=Select[rows,#[[5]]===1&];vectors=Select[rows,#[[5]]===2&];scalars=Select[rows,#[[5]]===0&];
  If[Length[fermions]=!=2||Length[vectors]=!=1||Length[scalars]=!=2||
    !AllTrue[rows,#[[8]]===1&]||!AllTrue[fermions,#[[6]]=!=0&&#[[2]]=!=#[[3]]&&!MemberQ[{"L","R"},#[[9]]]&]||
    First[vectors][[6]]===0||Length[DeleteDuplicates[Pick[process,rows[[All,5]],0]]]=!=1,
    fail["UnsupportedExternalCalibratedCurrentClass"]];
  diagrams=CreateDiagrams[process,diagramModel];
  If[!ListQ[diagrams]||diagrams==={}||!AllTrue[diagrams,AssociationQ],fail["OriginalCalibratedSourceGraphsIncomplete"]];
  used=HEPCATCovariantCurrentSources`Private`usedRows[diagrams];
  cubics=Select[used,Length[HEPCATCovariantContactCalibration`Private`rowParticles[#]]===3&];
  quartics=Select[used,Length[HEPCATCovariantContactCalibration`Private`rowParticles[#]]===4&];
  If[quartics==={}||Length[cubics]+Length[quartics]=!=Length[used],fail["UnsupportedCalibratedSourceVertexArity"]];
  catalog=HEPCATCovariantCurrentSources`Private`sourceCatalog[diagramModel,cubics];
  If[!AssociationQ[catalog],fail["UsedCubicCurrentNotCertified",<|"Reason"->catalog|>]];
  certificates=catalog["Certificates"];liftedRows=catalog["Model"][[2]];
  Do[quartetRows=HEPCATCovariantCurrentSources`Private`particleRow[#,diagramModel]&/@HEPCATCovariantContactCalibration`Private`rowParticles[row];
   If[!AllTrue[quartetRows,ListQ]||Count[quartetRows[[All,5]],2]=!=2||Count[quartetRows[[All,5]],0]=!=2,
    fail["UnsupportedUsedQuarticCurrentClass"]];
   vectorNames=Pick[HEPCATCovariantContactCalibration`Private`rowParticles[row],quartetRows[[All,5]],2];
   scalarNames=Pick[HEPCATCovariantContactCalibration`Private`rowParticles[row],quartetRows[[All,5]],0];
   If[Length[DeleteDuplicates[scalarNames]]=!=1,fail["UnsupportedUnequalScalarQuartic"]];
   calibration=HEPCATCovariantContactCalibration`Private`metricContactCalibration[diagramModel,lowerModel,vectorNames,First[scalarNames],"TimeConstraint"->remaining[]];
   If[!AssociationQ[calibration]||Lookup[calibration,"Status",None]=!="EXACT_SYMBOLIC_CONTACT_CALIBRATION",
    fail["UsedMetricContactNotExactlyCalibrated",<|"Reason"->calibration|>]];
   If[calibration["AllowedOriginalQuarticRow"]=!=row,fail["QuarticCalibrationRowMismatch"]];
   canonical=Join[vectorNames,scalarNames];
   liftedRow=Join[canonical,{1,calibration["MetricCoefficient"]LorentzMetric[LorentzIndex[1],LorentzIndex[2]]}];
   certificate=<|"Class"->"VectorVectorScalarScalar","Particles"->canonical,"SourceRows"->{row},"LiftedRow"->liftedRow,
    "Coefficients"->{calibration["MetricCoefficient"]},"Status"->"EXACT_COMPLETE_LOWER_AMPLITUDE_CONTACT_CONTINUATION",
    "LowerAmplitudeCalibration"->calibration,"NumericalParameterAssignments"->{},"InternalOnShellConditions"->{},
    "BareVertexOffShellEqualityClaimed"->False|>;
   certificate=Append[certificate,"CertificateID"->HEPCATCovariantCurrentSources`Private`objectSHA[KeyTake[certificate,{"Class","Particles","Coefficients"}]]];
   AppendTo[certificates,certificate];AppendTo[liftedRows,liftedRow];AppendTo[calibrations,calibration],{row,quartics}];
  needed=DeleteDuplicates[Flatten[HEPCATCovariantContactCalibration`Private`rowParticles/@liftedRows]];
  particles=Map[Function[p,With[{r=ReplacePart[p,7->0]},If[KeyExistsQ[catalog["Aliases"],r[[2]]],
   ReplacePart[r,{2->catalog["Aliases"][r[[2]]],3->catalog["Aliases"][r[[3]]],9->"G"}],r]]],diagramModel[[1]]];
  particles=Select[particles,Intersection[#[[{2,3}]],needed]=!={}&];
  liftedModel=FeynmanModel[particles,DeleteDuplicates[liftedRows],diagramModel[[3]],diagramModel[[4]]];
  catalog=Join[catalog,<|"Certificates"->certificates,"Model"->liftedModel|>];
  liftedDiagrams=CreateDiagrams[process,liftedModel];
  If[!ListQ[liftedDiagrams]||!AllTrue[liftedDiagrams,AssociationQ],fail["LiftedCalibratedSourceGraphsIncomplete"]];
  sourceSignatures=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,catalog,diagramModel,False]&/@diagrams;
  liftedSignatures=HEPCATCovariantCurrentSources`Private`diagramCertificate[#,catalog,diagramModel,True]&/@liftedDiagrams;
  If[!AllTrue[Join[sourceSignatures,liftedSignatures],AssociationQ]||Sort[sourceSignatures]=!=Sort[liftedSignatures],fail["CalibratedOrderedGraphCoverageMismatch"]];
  pairs=DiagramAmplitudes[liftedDiagrams];converted=FeynmanToSpinorProducts[pairs,"ReferenceSpinors"->Automatic,"ReduceSpinorProducts"->False,"TimeConstraint"->remaining[]];
  If[!TrueQ[ConstructiveDiagrams`Private`constructBenchmarkConversionCompleteQ[pairs,converted]],fail["CalibratedOffShellConversionIncomplete"]];
  external=First[First[converted]];
  If[!AllTrue[converted,First[#]===external&],fail["CalibratedExternalMassOrderingMismatch"]];
  rawExpression=Total[Last/@converted];expression=HEPCATCovariantContactCalibration`Private`coherent[rawExpression];
  vectorLegs=Flatten[Position[rows[[All,5]],2]];expected=rows[[All,5]];
  weights=ConstructiveDiagrams`Private`completionExternalSpinWeights[expression,external];
  If[!FreeQ[expression,_VectorSpinIndex]||weights=!=expected,fail["UnsupportedCoherentExternalTensorEncoding"]];
  <|"Status"->"UNVALIDATED_CANDIDATE","Amplitude"->{external,expression},"Expression"->expression,
   "RawTensorExpression"->rawExpression,"ExternalMassRules"->external,"ExternalParticles"->process,
   "CoherentExternalVectorEncoding"-><|"Method"->"InjectiveHomogeneousSymmetricSpinPolynomial","VectorLegs"->vectorLegs,
    "RawTensorRetained"->True,"CompleteSpinDegrees"->weights,"OffShellKinematicsChanged"->False|>,
   "VertexCertificates"->certificates,"ContactCalibrations"->calibrations,"SourceUsedRows"->used,
   "OrderedGraphCertificates"->sourceSignatures,"LiftedGraphCertificates"->liftedSignatures,
   "EveryOriginalDiagramCovered"->True,"EveryUsedOrderedVertexCertified"->True,"CompleteOffShellConversionCoverage"->True,
   "OriginalDiagramCount"->Length[diagrams],"LiftedDiagramCount"->Length[liftedDiagrams],
   "SourceModelSHA256"->sourceBefore,"LowerModelSHA256"->lowerBefore,"NativeValidationPerformed"->False,
   "IndependentBenchmarkRead"->False,"NumericalCoefficientFit"->False,"NumericalParameterAssignments"->{},
   "InternalOnShellConditions"->{},"NewIndependentContacts"->False,"RequiresCheckAmplitudes"->True,
   "ContinuationAssumption"->"MinimalCovariantCubicCurrentsWithExistingMetricContactsFixedByCompleteKnownLowerAmplitudes"|>
 ],tag],seconds,HEPCATCovariantContactCalibration`Private`reject["CalibratedSourceTimeConstraint"]];
 If[HEPCATCovariantContactCalibration`Private`objectSHA[diagramModel]=!=sourceBefore||HEPCATCovariantContactCalibration`Private`objectSHA[lowerModel]=!=lowerBefore,
  Return[HEPCATCovariantContactCalibration`Private`reject["CalibratedSourceModelChanged"]]];
 If[AssociationQ[result],Append[result,"Seconds"->N[AbsoluteTime[]-started]],result]
];
HEPCATCovariantContactCalibration`Private`calibratedCovariantSource[___]:=HEPCATCovariantContactCalibration`Private`reject["UnsupportedCalibratedSourceInput"];
End[];
