           Cell["After the amplitudes above complete, run this export. One \
C++ process contains the helicity family. It builds SPINAS and compares the \
squared amplitudes with CalcHEP and MadGraph at 1000 phase-space points each. \
The complete reports and random seeds remain in the Export variable.",
            "Text"], Cell[CellGroupData[{Cell["sm5lLhhhExport = \
WriteSPINASProcess[\n  FileNameJoin[{spinasOutputDirectory, \"llbarhhh\"}],\n \
 {\"l\", \"L\"} -> {\"h\", \"h\", \"h\"},\n  {\n    {sm5lLhhhParticles, \
sm5lLhhhAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm5llbarhhh\", Sequence \
@@ validationOptions];\nIf[AssociationQ[sm5lLhhhExport], \
sm5lLhhhExport[\"Directory\"], sm5lLhhhExport]", "Input", CellTags ->
                "sm5-export-sm5f_2b62c112ba71"], Cell[BoxData[TagBox[
                 TagBox[DynamicModuleBox[
                   {TypeSystem`NestedGrid`PackagePrivate`$state$$ =
                     <|"InitialData" -> {<|"Reference" -> "CalcHEP",
                         "Status" -> "PASS", "RequestedPoints" -> 1000|>},
                      "AllowEmbedding" -> True, "InitialShape" ->
                       TypeSystem`PackageScope`HeaderShape[<|{All,
                          "Reference"} -> 1, {All, "Status"} -> 1,
                         {All, "RequestedPoints"} -> 1|>,
                        TypeSystem`PackageScope`Limited[
                         TypeSystem`PackageScope`ColumnShape[
                          TypeSystem`PackageScope`Limited[
                          TypeSystem`PackageScope`RowShape[<|"Reference" ->
                          TypeSystem`PackageScope`AtomShape[78.4],
                          "Status" -> TypeSystem`PackageScope`AtomShape[
                          44.800000000000004], "RequestedPoints" ->
                          TypeSystem`PackageScope`AtomShape[34]|>], Infinity,
                          3, {All}]], 1, Infinity, {}]], "InitialType" ->
                       TypeSystem`Vector[TypeSystem`Struct[{"Reference",
                          "Status", "RequestedPoints"}, {TypeSystem`Atom[
                          String], TypeSystem`Atom[String], TypeSystem`Atom[
