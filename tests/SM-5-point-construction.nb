           Cell["CalcHEP precision replay (optional)", "Subsubsection"],
           Cell["The default CalcHEP comparison above retains its raw \
residuals. This separate replay uses the same saved phase-space points and \
CalcHEP expressions. With 113 mantissa bits, all 1000 points agree at the \
unchanged tolerance. This behavior is consistent with roundoff in \
cancellations at ordinary precision. The native and GCC53 controls remain \
visible below. Run this optional cell for a fresh replay; each run keeps its \
own output directory.", "Text"], Cell[CellGroupData[{Cell["sm5WpWmhhhPrecisio\
nDirectory = FileNameJoin[{hepcatDirectory, \"tests\", \"results\", \
\"SM-5-point\", \"precision\", \"WpWmhhh-replay\",\n  DateString[{\"Year\", \
\"Month\", \"Day\", \"-\", \"Hour\", \"Minute\", \
\"Second\"}]}];\nsm5WpWmhhhPrecisionRun = RunProcess[{\n  \"python3\",\n  \
FileNameJoin[{hepcatDirectory, \"tests\", \"SM-5-point\", \
\"replay-calchep-precision.py\"}],\n  FileNameJoin[{spinasOutputDirectory, \
\"WpWmhhh\"}],\n  \"--points-csv\", FileNameJoin[{hepcatDirectory, \"tests\", \
\"results\", \"SM-5-point\", \"precision\", \"WpWmhhh-default\", \
\"points.csv\"}],\n  \"--seed\", \"1794435492327841000\",\n  \"--output\", \
sm5WpWmhhhPrecisionDirectory}];\nsm5WpWmhhhPrecisionSummaryFile = \
FileNameJoin[{sm5WpWmhhhPrecisionDirectory, \
\"precision-summary.json\"}];\nIf[FileExistsQ[sm5WpWmhhhPrecisionSummaryFile]\
,\n  sm5WpWmhhhPrecisionReport = Import[sm5WpWmhhhPrecisionSummaryFile, \
\"RawJSON\"];\n  Dataset[Table[\n    Join[<|\"Evaluation\" -> name|>, \
KeyTake[sm5WpWmhhhPrecisionReport[\"Results\"][name],\n      \
{\"MantissaBits\", \"Points\", \"Mismatches\", \"Errors\", \
\"MaximumRelativeError\", \"Status\"}]],\n    {name, {\"Native\", \"GCC53\", \
\"GCC128\"}}]],\n  sm5WpWmhhhPrecisionRun]", "Input", CellTags ->
