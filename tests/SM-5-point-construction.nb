{\"h\", \"h\"} -> {\"h\", \"h\", \"h\"},\n  {\n    {sm5hhhhhParticles, \
sm5hhhhhAmplitude}\n  }, sm,\n  \"ProcessName\" -> \"sm5hhhhh\", Sequence @@ \
validationOptions];\nIf[AssociationQ[sm5hhhhhExport], \
sm5hhhhhExport[\"Directory\"], sm5hhhhhExport]", "Input", CellTags ->
