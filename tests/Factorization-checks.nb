Cell["\<\
This form, called H in the derivation, gives six PASS rows using the \
corrected four-point signs in model 3 and the channel-to-residue sewing \
conversion. H itself is unchanged.\
\>", "Text",ExpressionUUID->"da844eb5-fd9d-4ba3-9603-1eda56289346"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Hard-Coded Form With Spurious Poles", "Section",ExpressionUUID->"0aa14348-b147-45a3-ba54-8189dbf5b285"],

Cell["\<\
This equivalent form, S2, has angle-bracket denominators as well as physical \
propagators. It is checked against the same factorization channels and \
unchanged model.\
\>", "Text",ExpressionUUID->"684c0963-7bf0-4a9f-aa98-566a700b9104"],

Cell[CellGroupData[{

Cell["\<\
spuriousPoleAmplitude = 2 Sqrt[2] EE^3 Me *
  ConvertStringAmplitude[
    \"<12>*([34]*<3|2|5]/(<34>*<35>*t[1,3]*t[2,5]) +
           [35]*<3|2|4]/(<35>*<34>*t[1,3]*t[2,4]) +
           [43]*<4|2|5]/(<43>*<45>*t[1,4]*t[2,5]) +
           [45]*<4|2|3]/(<45>*<43>*t[1,4]*t[2,3]) +
           [53]*<5|2|4]/(<53>*<54>*t[1,5]*t[2,4]) +
           [54]*<5|2|3]/(<54>*<53>*t[1,5]*t[2,3]))\",
    fivePointMasses];
spuriousPoleAmplitude\
\>", "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"804a6f34-1349-4b20-8655-a4d3f412b206"],

