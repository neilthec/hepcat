Cell["\<\
H has only physical denominator poles, so it needs no extra finiteness \
checks. S2 has three apparent photon-pair poles, which should cancel. The old \
permutation expression is a negative control: its uncanceled poles should \
fail. Each form is checked with one call, and the counts below distinguish \
the two kinds of checks.\
\>", "Text",ExpressionUUID->"2e891bc5-efda-40e6-91d8-33ec82285567"],

Cell[CellGroupData[{

Cell["\<\
qedAllPoleSummary = Table[
  With[{report = CheckPhysicalResidues[
      form[[2]], fivePointChannels, qedFactorizationModel,
      \"ParameterRules\" -> {Me -> 1, EE -> 1},
      \"Output\" -> \"Details\"]},
    <|\"Form\" -> form[[1]],
      \"Physical\" -> qedStatusCounts[report[\"PhysicalSummary\"]],
      \"Spurious\" -> qedStatusCounts[report[\"SpuriousSummary\"]]|>],
  {form, {{\"H\", physicalPoleAmplitude}, {\"S2\", spuriousPoleAmplitude},
    {\"OldPermutation\", oldPermutationAmplitude}}}];
Dataset[qedAllPoleSummary]\
\>", "Input",
 CellLabel->
  "In[142]:=",ExpressionUUID->"fd43bbe8-4095-4992-ae8d-7283470d1798"],

