Cell[CellGroupData[{

Cell["6. All Eight Electron-Pair And Three-Photon Helicity Choices", "Section",ExpressionUUID->"28997b95-4502-467d-bdc0-df17549e1db3"],

Cell["\<\
These are all eight photon-helicity choices for e, E and three photons in the \
electron-only QED model. The mixed-helicity route below starts with the six \
actual diagram expressions, records each diagram-local numerator \
representative and its on-shell assumptions, then eliminates the auxiliary \
poles by external identities. The resulting three-term expression has no \
reference spinors. The original input and the intermediate choices remain \
available for inspection. The checker and the model are unchanged.\
\>", "Text",ExpressionUUID->"64e318b3-c56d-4802-9229-67ac2c234665"],

Cell["\<\
The equal-helicity starting expression is H, displayed above. The following \
mixed-helicity expression is for e, E, A.+, A.+, A.-. It has only physical \
propagator poles. The bracket strings keep the expression readable; t[i,j] \
has the same meaning as above.\
\>", "Text",ExpressionUUID->"6cac1540-6e12-4381-825f-17b199d3c71a"],

Cell[CellGroupData[{

Cell["\<\
Get[FileNameJoin[{hepcatDirectory, \"tests\", \"QED-5-point-residues.wl\"}]];
qedMixedDiagramAmplitudes = diagramAmplitudes[CreateDiagrams[
  {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\"}, qedDiagramModel]];
qedMixedDerivation = qedFivePointMixedRoute[qedMixedDiagramAmplitudes];
qedFivePointMixedAmplitude = qedMixedDerivation[\"Final\"];
qedFivePointMixedReference = 2 Sqrt[2] EE^3/Me *
  ConvertStringAmplitude[
    \"<5|1|3]*[4|12|4]*(<12>*<5|1|3]-<15>*<25>*[35])/t[2,4] +
     <5|1|4]*[3|12|3]*(<12>*<5|1|4]-<15>*<25>*[45])/t[2,3] +
     Me^2*[34]^2*(<12>*<5|12|5>+<15>*<25>*(t[1,5]+t[2,5]))/t[2,5]\",
    fivePointMasses] / (t[1,3] t[1,4] t[1,5]);
(qedFivePointMixedAmplitude // nice) /. nice[parameter_Symbol] :> parameter\
\>", "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"6044332b-a98f-416a-b4bf-00c95f0aa93f"],

