  fivePointSimplifiedAmplitude, fivePointChannels, qedFactorizationModel,
  \"ParameterRules\" -> {Me -> 1, EE -> 1},
  \"Output\" -> \"Residues\"]\
\>", "Input",
 CellLabel->
  "In[150]:=",ExpressionUUID->"22286248-455c-49d6-a176-a8d27e7133d8"],

