Cell["\<\
Inspect one diagram's identity route. OffCutRemainder is generally not zero: \
the representative choice is justified by its numerator on-shell factor, not \
by an identity on the complete off-shell amplitude. Neither physical \
propagator is set to zero in the returned expression.\
\>", "Text",ExpressionUUID->"632487e2-2cf5-4efb-b75c-51b83a9f9428"],

Cell[CellGroupData[{

Cell["\<\
fermionDiagramExample = 1;
fermionRoute = qedFourFermionDerivation[\"Routes\"][[fermionDiagramExample]];
Grid[{
  {\"Original diagram\", fermionRoute[\"Raw\"] // nice},
  {\"Dirac reduction\", fermionRoute[\"DiracReduced\"] // nice},
  {\"Removed numerator multiple\", fermionRoute[\"RemovedNumeratorMultiple\"] \
// nice},
  {\"Selected representative\", fermionRoute[\"NumeratorRepresentative\"] // \
nice},
  {\"Off-cut remainder\", fermionRoute[\"OffCutRemainder\"] // nice}
  }, Alignment -> Left] /. nice[parameter_Symbol] :> parameter
\
\>", "Input",
 CellLabel->
  "In[133]:=",ExpressionUUID->"ced24e02-d4c3-4262-bcd5-e6d16958ab51"],

