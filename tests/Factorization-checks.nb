Cell[CellGroupData[{

Cell["\<\
qedFourFermionPhoton = Association@Table[
  With[{particles = {\"e\", \"E\", \"e\", \"E\", helicity}},
    With[{pairs = diagramAmplitudes[CreateDiagrams[
          particles, qedDiagramModel]],
        channels = FactorizationAmplitudeChannels[
          particles, qedFactorizationModel]},
      With[{amplitude = If[helicity === \"A.+\", \
qedFourFermionPositiveAmplitude,
          qedReverseHelicities[qedFourFermionPositiveAmplitude]]},
        StringRiffle[particles, \", \"] -> <|
          \"Particles\" -> particles, \"DiagramAmplitudes\" -> pairs,
          \"PreparedRawAmplitude\" -> qedPrepareFivePointDiagrams[pairs],
          \"Amplitude\" -> amplitude, \"Channels\" -> channels,
          \"Report\" -> CheckPhysicalResidues[
            amplitude, channels, qedFactorizationModel,
            \"ParameterRules\" -> {Me -> 1, EE -> 1},
            \"Output\" -> \"Details\"]|>]]],
  {helicity, {\"A.+\", \"A.-\"}}];
qedCheckSummary[qedFourFermionPhoton]\
\>", "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"98571b23-9670-42bd-9c2d-9149a22d745d"],

