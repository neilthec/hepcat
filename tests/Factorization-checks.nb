Cell[CellGroupData[{

Cell["7. Compare The Prepared Diagram Results Separately", "Section",ExpressionUUID->"b6e4be08-7595-41f1-91dd-628ad348b759"],

Cell["\<\
For comparison, retain the original diagram representatives with only the \
partial chain reduction used above. This deliberately stops before the \
diagram-local numerator choices in the completed route. The equal-helicity \
sums pass all six channels, while each unfinished mixed-helicity sum passes \
two and fails four. These retained expressions are not the completed results \
used in the preceding section.\
\>", "Text",ExpressionUUID->"332bf6e5-8a13-4e92-b117-8cdfbd484d42"],

Cell[CellGroupData[{

Cell["\<\
qedPrepareFivePointDiagrams[pairs_List] := Total[
  Function[pair, Factor[
    (ReduceSpinContractions[Last[pair]] /. First[pair]) /.
      chain_SpinorChain :> fivePointSimplifyChain[chain]]] /@
    (pairs /. Spinor[\"Xi\", kind_, _Integer] :>
      Spinor[\"Xi\", kind, 0])];

qedFivePointPrepared = Association@Table[
  With[{completed = qedFivePointCompleted[name]},
    With[{pairs = diagramAmplitudes[CreateDiagrams[
          completed[\"Particles\"], qedDiagramModel]]},
      With[{amplitude = qedPrepareFivePointDiagrams[pairs]},
        name -> <|\"Particles\" -> completed[\"Particles\"],
          \"DiagramAmplitudes\" -> pairs, \"Amplitude\" -> amplitude,
          \"Channels\" -> completed[\"Channels\"],
          \"Report\" -> CheckPhysicalResidues[
            amplitude, completed[\"Channels\"], qedFactorizationModel,
            \"ParameterRules\" -> {Me -> 1, EE -> 1},
            \"Output\" -> \"Details\"]|>]]],
  {name, Keys[qedFivePointCompleted]}];
qedCheckSummary[qedFivePointPrepared]\
\>", "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"1ba3fd49-1d8a-4ac4-9f46-8a2b683c1577"],

