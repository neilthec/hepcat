Cell["\<\
Relabel the three photons to put the different helicity on any desired leg. \
Swapping angle and square spinors gives the opposite-helicity expression, \
with no extra overall sign in these conventions. The helpers below change \
only particle labels or bracket chirality, never numerical coefficients or \
exponents.\
\>", "Text",ExpressionUUID->"6392d79d-f986-4f91-987f-18f8f6bab863"],

Cell["\<\
qedRelabelPhotons[expression_, order_List] :=
  With[{rules = Thread[Range[5] -> Join[{1, 2}, order]]},
    expression /. {
      Spinor[type_, kind_, label_Integer] :>
        Spinor[type, kind, label /. rules],
      Mom[label_Integer] :> Mom[label /. rules],
      Mom[Multiparticle[labels__Integer]] :>
        Mom[Multiparticle @@ Sort[{labels} /. rules]]}];

qedReverseHelicities[expression_] := expression /.
  Spinor[type_, kind : (\"Angle\" | \"Square\"), rest___] :>
    Spinor[type, If[kind === \"Angle\", \"Square\", \"Angle\"], rest];

qedCompletedPhotonAmplitude[helicities_List] := Module[
  {plus = Pick[{3, 4, 5}, helicities, \"A.+\"], minus},
  minus = Complement[{3, 4, 5}, plus];
  Which[
    Length[plus] === 3, physicalPoleAmplitude,
    Length[minus] === 3, qedReverseHelicities[physicalPoleAmplitude],
    Length[plus] === 2,
      qedRelabelPhotons[qedFivePointMixedAmplitude, Join[plus, minus]],
    Length[minus] === 2,
      qedRelabelPhotons[qedReverseHelicities[qedFivePointMixedAmplitude],
        Join[minus, plus]]]];

qedFivePointHelicities = Tuples[{\"A.+\", \"A.-\"}, 3];\
\>", "Input",
 CellLabel->
  "In[112]:=",ExpressionUUID->"7fb0e6ff-15a4-4af8-83cc-40902be4d50a"],

Cell["\<\
Check every completed expression. Results and the original channel rows are \
retained in qedFivePointCompleted, indexed by the process name. The summary \
distinguishes physical residues from automatically discovered spurious poles. \
None means no apparent spurious denominator remains in that expression. PASS \
remains a sampled check, not an analytic proof.\
\>", "Text",ExpressionUUID->"1cbda5d5-2790-4154-b806-e389fe3fc076"],

Cell[CellGroupData[{

Cell["\<\
qedFivePointCompleted = Association@Table[
  With[{particles = Join[{\"e\", \"E\"}, helicities]},
    With[{amplitude = qedCompletedPhotonAmplitude[helicities],
        channels = FactorizationAmplitudeChannels[
          particles, qedFactorizationModel]},
      StringRiffle[particles, \", \"] -> <|
        \"Particles\" -> particles, \"Amplitude\" -> amplitude,
        \"Channels\" -> channels,
        \"Report\" -> CheckPhysicalResidues[
          amplitude, channels, qedFactorizationModel,
          \"ParameterRules\" -> {Me -> 1, EE -> 1},
          \"Output\" -> \"Details\"]|>]],
  {helicities, qedFivePointHelicities}];

qedStatusCounts[counts_Association] := If[counts === <||>, \"None\",
  StringRiffle[KeyValueMap[ToString[#2] <> \" \" <> #1 &, counts], \", \"]];
qedCheckSummary[cases_Association] := Dataset[
  KeyValueMap[Function[{name, result}, <|\"Process\" -> name,
    \"Physical\" -> qedStatusCounts[result[\"Report\"][\"PhysicalSummary\"]],
    \"Spurious\" -> \
qedStatusCounts[result[\"Report\"][\"SpuriousSummary\"]]|>], cases]];
qedCheckSummary[qedFivePointCompleted]\
\>", "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"1e5c0a2a-1fc3-4e8c-89f4-23d1c8be0ceb"],

