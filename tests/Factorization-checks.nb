Cell[CellGroupData[{
Cell["Physical Factorization Checks", "Title",ExpressionUUID->"fa7eb9cb-886c-4b5b-9e96-71de3171645e"],

Cell["\<\
Calculate diagram amplitudes, obtain the usual factorization channels, then \
compare them. All momenta are ingoing. Evaluate from the top in a fresh \
kernel.\
\>", "Text",ExpressionUUID->"bb23050a-aca6-41a4-a18f-f556af23bf49"],

Cell[CellGroupData[{

Cell["Setup", "Section",ExpressionUUID->"dbbfeeac-8bef-439f-83f8-12dc094ce5da"],

Cell[CellGroupData[{

Cell["\<\
hepcatDirectory = ParentDirectory[NotebookDirectory[]];
$HEPCATpath = FileNameJoin[{hepcatDirectory, \"source\"}];
Get[FileNameJoin[{$HEPCATpath, \"HEPCAT.wl\"}]];\
\>", "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"7a5a2d19-f0ef-40cc-b461-4275ecb7e8bc"],

