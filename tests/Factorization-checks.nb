Cell["\<\
Expected: six PASS rows. At each tested electron pole, the common-reference \
diagram residue agrees with the physical residue from model 3 after the \
channel's sewing conversion. Use Residues below to inspect them.\
\>", "Text",ExpressionUUID->"4009a1ef-0bcf-4eb4-9346-dc910268fe49"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Hard-Coded Form With Physical Poles", "Section",ExpressionUUID->"d8ae659f-d4d7-41e0-8269-91cf9688c564"],

Cell["\<\
A supplied analytic amplitude can be checked directly, without generating \
diagrams. Here t[i,j] denotes the electron propagator denominator. The \
bracket string is converted by the existing HEPCAT function.\
\>", "Text",ExpressionUUID->"19f7b6c5-79a8-489e-8707-4adb7012cf7e"],

Cell["\<\
t[i_, j_] := PropDen[Mom[Multiparticle @@ Sort[{i, j}]], Me];
fivePointMasses = {Me, Me, 0, 0, 0};\
\>", "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"d2f0d04a-d033-4f5d-932a-b545580b7475"],

Cell[CellGroupData[{

Cell["\<\
physicalPoleAmplitude = 2 Sqrt[2] EE^3 Me *
  ConvertStringAmplitude[
    \"<12>*([45]^2*[3|12|3]/t[2,3] +
           [35]^2*[4|12|4]/t[2,4] +
           [34]^2*[5|12|5]/t[2,5])\",
    fivePointMasses]/(t[1,3] t[1,4] t[1,5]);
physicalPoleAmplitude\
\>", "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"c8def4eb-f491-4c3d-9763-a3d3f2f66cb1"],

Cell[BoxData[
 FractionBox[
