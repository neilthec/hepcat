Cell[CellGroupData[{

Cell["9. One Report For All Poles", "Section",ExpressionUUID->"b6f6d6d2-9e3f-4d97-a803-39b1f1703fe1"],

Cell["The ordinary call discovers denominator factors automatically. The supplied factorization channels identify physical poles, including equivalent invariant or massless-bracket forms. Other supported factors are tested for finiteness in the full sum, keeping physical poles away from zero. Unknown structures appear as Unclassified and UNRESOLVED, never as a guessed pass. These are exact sampled checks, not an analytic proof.", "Text",ExpressionUUID->"3dfeaa13-d595-4c16-a6a0-94d685157382"],

Cell[CellGroupData[{

Cell["\<\
CheckPhysicalResidues[
  spuriousPoleAmplitude, fivePointChannels, qedFactorizationModel,
  \"ParameterRules\" -> {Me -> 1, EE -> 1}]\
\>", "Input",
 CellLabel->
  "In[141]:=",ExpressionUUID->"9692a24a-6845-4cb3-8e85-3311e2d104d1"],

