Cell["\<\
The displayed bracket formula above is also retained as \
qedFivePointMixedReference, an independent check of the route's final value. \
A numerator change is allowed only within its own diagram's internal on-shell \
assumptions, not as an identity on the full off-shell sum. The next cells \
make that choice and the exact final simplification visible.\
\>", "Text",ExpressionUUID->"e312f191-a32c-4854-a94b-4f049ca0a21f"],

Cell[CellGroupData[{

Cell["\<\
<|\"SameThreeTermResult\" ->
    (Together[qedFivePointMixedAmplitude - qedFivePointMixedReference] === \
0),
  \"ReferenceFree\" -> FreeQ[qedFivePointMixedAmplitude, Spinor[\"Xi\", \
__]]|>
\
\>", "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"974b3b99-1d43-484f-99ee-356e25d0eb86"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SameThreeTermResult\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"ReferenceFree\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.001587627500787*^9},
 CellLabel->
  "Out[105]=",ExpressionUUID->"59e8f80b-e067-40bf-8cb8-2df2c1ba3740"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
mixedDiagramExample = 1;
Grid[{
  {\"Original diagram\", \
qedMixedDerivation[\"RawDiagrams\"][[mixedDiagramExample]] // nice},
  {\"First numerator representative\", \
qedMixedDerivation[\"LocalSeedNumerators\"][[mixedDiagramExample]] // nice},
  {\"Additional numerator multiple\", \
qedMixedDerivation[\"LocalCompletionNumerators\"][[mixedDiagramExample]] // \
nice},
  {\"Completed numerator\", \
qedMixedDerivation[\"LocalCompletedNumerators\"][[mixedDiagramExample]] // \
nice},
  {\"Own on-shell factor used\", \
qedMixedDerivation[\"OnShellFactorUsed\"][[mixedDiagramExample]] // nice}
  }, Alignment -> Left] /. nice[parameter_Symbol] :> parameter
\
\>", "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"390ffb26-329b-45e9-b642-f6eed7b810b9"],

