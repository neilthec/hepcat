Cell["\<\
Each saved case contains its Amplitude, Channels and Report. The same \
three-input checker shows physical and spurious checks together, or the \
individual sampled values when requested. For example:\
\>", "Text",ExpressionUUID->"b7824df4-d075-4ff1-ac07-4d286d845e61"],

Cell[CellGroupData[{

Cell["\<\
mixedPhotonCase = qedFivePointCompleted[\"e, E, A.+, A.+, A.-\"];
CheckPhysicalResidues[
  mixedPhotonCase[\"Amplitude\"], mixedPhotonCase[\"Channels\"],
  qedFactorizationModel, \"ParameterRules\" -> {Me -> 1, EE -> 1},
  \"Output\" -> \"Residues\"]\
\>", "Input",
 CellLabel->
  "In[139]:=",ExpressionUUID->"cc010d21-9ba2-4bad-9578-50d113f44bcf"],

