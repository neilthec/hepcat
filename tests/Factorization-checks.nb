Cell["\<\
Like H, S2 gives six PASS rows against the converted physical residues from \
model 3. H and S2 agree with each other; this call does not establish \
cancellation of all spurious poles.\
\>", "Text",ExpressionUUID->"0b9fdbb2-71fc-4fb6-a0eb-bd77b0916dcc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Old Permutation Form: A Negative Control", "Section",ExpressionUUID->"e5320cd8-07c9-4b90-922c-4687d6114aaa"],

Cell["\<\
This older expression is known not to agree with H and S2. Its discrepancy is \
not merely an overall sign. Keeping it as a negative control checks that an \
incorrect amplitude is rejected.\
\>", "Text",ExpressionUUID->"3471d5d4-7cb9-4478-9625-b8720716e009"],

Cell[CellGroupData[{

Cell["\<\
oldPermutationAmplitude = 2 Sqrt[2] EE^3 Me *
  ConvertStringAmplitude[
    \"<12>*([45]*<4|1|3]/(<34>*<45>*t[1,3]*t[2,5]) +
           [54]*<5|1|3]/(<35>*<54>*t[1,3]*t[2,4]) +
           [35]*<3|1|4]/(<43>*<35>*t[1,4]*t[2,5]) +
           [53]*<5|1|4]/(<45>*<53>*t[1,4]*t[2,3]) +
           [34]*<3|1|5]/(<53>*<34>*t[1,5]*t[2,4]) +
           [43]*<4|1|5]/(<54>*<43>*t[1,5]*t[2,3]))\",
    fivePointMasses];
oldPermutationAmplitude\
\>", "Input",
 CellLabel->"In[96]:=",ExpressionUUID->"fd00437c-ee8a-4df5-9b87-363e4fdb79f6"],

