Cell["\<\
The completed mixed-helicity and four-fermion expressions have only physical \
denominators. Their ordinary reports therefore contain only physical rows. \
PoleDiscovery in Details records every apparent denominator and its \
classification when you want to inspect how that conclusion was reached.\
\>", "Text",ExpressionUUID->"f616d4e1-380e-486f-9f72-1c354a264885"],

Cell[CellGroupData[{

Cell["\<\
qedMixedSpuriousReport = CheckPhysicalResidues[
  qedFivePointMixedAmplitude,
  qedFivePointCompleted[\"e, E, A.+, A.+, A.-\"][\"Channels\"],
  qedFactorizationModel, \"ParameterRules\" -> {Me -> 1, EE -> 1},
  \"Samples\" -> 2, \"Output\" -> \"Details\"];
qedMixedSpuriousReport[\"Table\"]
\
\>", "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"686a238a-8f62-4954-a7be-07341586a2d2"],

