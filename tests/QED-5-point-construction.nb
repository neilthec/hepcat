Cell["\<\
Each result is {mass replacements, prepared expression}, ready for the next \
step. Original expressions and reduction histories are not returned unless \
requested.\
\>", "Text",ExpressionUUID->"f3bb5e78-8509-4a68-8049-acd45147bfec"],

Cell[CellGroupData[{

Cell["Optional: Preparation Details", "Subsection",ExpressionUUID->"75a8ef12-ac29-4855-adb3-134b3c85bab8"],

Cell["\<\
ReturnDetails -> True requests the full report. Inspect the first diagram's \
reference assignments below. A PARTIAL status means preparation retained the \
last completed expression; the report explains why.\
\>", "Text",ExpressionUUID->"0b2bf6b8-8eb1-43cb-a78e-417b251fa0cc"],

Cell["\<\
preparationDetails = PrepareAmplitudes[rawAmplitudes, diagramModel,
  \"ReferenceSpinors\" -> referenceChoice,
  \"ReturnDetails\" -> True];
Grid[Prepend[
  ({#[\"Reference\"], #[\"Mode\"], #[\"Target\"]} & /@
    preparationDetails[\"DiagramReports\"][[1]][\"ReferenceSpinors\"][\"Assignments\"\
]),
  {\"Original reference\", \"Choice\", \"Replacement\"}], Frame -> All]\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"e491cb78-13a4-495a-b158-4e479e480dea"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Complete the Physical Residues", "Section",ExpressionUUID->"da13714b-7e29-4e39-9cab-225c647ba0ed"],

Cell["\<\
Generate and prepare the factorization channels, then solve their residue \
constraints simultaneously. Preparation uses only the selected channel's \
internal on-shell condition. Original channels are kept as fallback correction \
directions only if the prepared channels do not suffice. The result is the updated amplitude, not a \
report. An unfinished completion returns a concise Failure instead.\
\>", "Text",ExpressionUUID->"69934b68-953e-4bc0-93b1-dfdfbd6556d4"],

Cell[CellGroupData[{

Cell["\<\
channels = FactorizationAmplitudeChannels[particles, factorizationModel];
preparedChannels = PrepareAmplitudes[channels, factorizationModel,
  \"ReferenceSpinors\" -> referenceChoice];
Length[channels]\
\>", "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"6ce8fa77-7a9f-4891-97d7-b6cbfc93f628"],

Cell[BoxData["6"], "Output",
 CellChangeTimes->{4.001687978158999*^9, 4.001758089978546*^9},
 CellLabel->
  "Out[187]=",ExpressionUUID->"65ea7589-0ca3-41f4-a3c7-726158e06f05"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
factorization = CompleteFactorization[preparation, preparedChannels, \
factorizationModel,
  \"AlternativeChannels\" -> channels,
  \"Samples\" -> 1, \"ValidationSamples\" -> 1,
  \"MaxCorrectionTerms\" -> 128, \"TimeConstraint\" -> timeLimit];
factorization\
\>", "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"8a5e3a73-226a-4b05-b02c-9c60d84cc572"],

