Cell[CellGroupData[{

Cell["e,E,E,e,A.+", "Chapter",
 CellChangeTimes->{{4.001759665590519*^9, 4.001759700623199*^9}, {
  4.002022017979504*^9, 4.0020220197101088`*^9}, {4.00202209134326*^9, 
  4.0020220920413723`*^9}},ExpressionUUID->"e62cc4b7-85c3-47b2-b75a-\
e1dd311d185c"],

Cell["Construct and Check", "Section", ExpressionUUID->"adea72e3-c8dc-5579-81a9-fe49b8884211"],

Cell["Evaluate this cell after Setup. The wrapper generates and prepares the diagrams and factorization channels, completes and prepares the amplitude, then runs all final checks. The printed test report precedes the returned expression. The saved manual work remains available below.", "Text", ExpressionUUID->"8a0e400e-e796-55fe-8fc2-c7fa37685606"],

Cell["qed5FourFermionsP = ConstructAmplitude[\n  {\"e\", \"E\", \"E\", \"e\", \"A.+\"},\n  diagramModel, factorizationModel,\n  \"FeynmanModel\" -> qedFeynmanModel]", "Input", ExpressionUUID->"98a3963d-bf2b-5092-832a-9f8e0aef3ea7"],

Cell[CellGroupData[{

Cell["Earlier Step-by-Step Work (Optional)", "Section", ExpressionUUID->"d914545f-82aa-524c-996a-ec2d39476a12"],

Cell[CellGroupData[{

Cell["1. Choose the Process and References", "Section",ExpressionUUID->"5f1d6f76-3110-44d9-aa44-ce1079df991f"],

Cell["\<\
particles = {\"e\", \"E\", \"E\", \"e\", \"A.+\"};
referenceChoice = Automatic;\
\>", "Input",
 CellChangeTimes->{{4.0016723486207333`*^9, 4.001672391849534*^9}, {
   4.001757782755148*^9, 4.00175778752351*^9}, 4.001757993489561*^9, {
   4.00175970377367*^9, 4.001759704136251*^9}, {4.002022024845811*^9, 
   4.0020220280129967`*^9}, {4.002022086387506*^9, 4.002022086708763*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"4cecd6bb-dc75-4fad-8841-e7179e144e70"],

Cell["\<\
There is only one massless external particle, so no other massless spinor is \
available for AllSpurious. Automatic uses momentum-insertion references for \
the constructive diagrams. The independent Feynman benchmark below uses \
AllPhysical.\
\>", "Text",ExpressionUUID->"2461f639-ae40-49eb-bf36-9c02916c34de"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Generate the Diagrams", "Section",ExpressionUUID->"b9557763-dbbc-4f7b-8487-9aa2cc1b2069"],

Cell[CellGroupData[{

Cell["\<\
diagrams = CreateDiagrams[particles, diagramModel];
rawAmplitudes = diagramAmplitudes[diagrams];
Length[rawAmplitudes]\
\>", "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"6427db48-6319-432e-a5b6-5921c1f3110c"],

