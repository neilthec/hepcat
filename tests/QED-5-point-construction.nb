Cell[CellGroupData[{
Cell["Five-Point QED: Construction and Checks", "Title",ExpressionUUID->"5ca1b447-bdbb-4884-877e-3bc950bf458e"],

Cell["\<\
First use the new preparation and completion functions, one step at a time. \
Then calculate the compact worked QED results and check all photon \
helicities. Evaluate from the top in a fresh kernel. All momenta are ingoing.\
\
\>", "Text",ExpressionUUID->"456f9b3b-17be-418a-8209-5779a70c7365"],

Cell[CellGroupData[{

Cell["Setup", "Section",ExpressionUUID->"4816341a-7984-4b8b-988a-1a38dedfcf65"],

Cell[CellGroupData[{

Cell["\<\
hepcatDirectory = ParentDirectory[NotebookDirectory[]];
$HEPCATpath = FileNameJoin[{hepcatDirectory, \"source\"}];
Get[FileNameJoin[{$HEPCATpath, \"HEPCAT.wl\"}]];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"502400f7-a148-4769-998b-3289c5a54045"],

