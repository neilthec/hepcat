Cell[CellGroupData[{

Cell["\<\
Clear[constructedAmplitude, constructionChecks];
If[FailureQ[completion] || completion === $Failed,
  completion,
  constructedAmplitude = completion;
  constructionChecks = CheckAmplitudes[
    constructedAmplitude, channels, factorizationModel,
    \"FeynmanAmplitudes\" -> preparedFeynman,
    \"FeynmanModel\" -> qedFeynmanModel,
    \"Samples\" -> checkSamples, \"TimeConstraint\" -> timeLimit,
    \"Output\" -> \"Details\"];
  constructionChecks[\"Table\"]]\
\>", "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"c9322b4d-143f-4709-a278-9f060affb40e"],

