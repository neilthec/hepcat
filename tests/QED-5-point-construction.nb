Cell[CellGroupData[{

Cell["", "Chapter",ExpressionUUID->"b6dd752b-69dd-43ae-8fe6-f2fdd6135a1f"],

Cell[CellGroupData[{

Cell["6. Compact Worked QED Results", "Section",ExpressionUUID->"2cf2fd86-409e-433f-bfcd-dceba02743d2"],

Cell["\<\
The general completion functions do not yet automatically finish every \
five-point case. The following are separate, existing QED derivations, not \
hidden substitutes for Sections 1-5. They give three representative compact \
amplitudes; photon relabeling and parity give the remaining helicities. Every \
resulting amplitude is checked independently in Section 7.\
\>", "Text",ExpressionUUID->"edd40085-a8bb-429c-a805-92eecea9c14e"],

Cell["\<\
Get[FileNameJoin[{hepcatDirectory, \"tests\", \"QED-5-point-residues.wl\"}]];\
\
\>", "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"b688bea5-1a21-4088-a261-03190d7eb181"],

Cell[CellGroupData[{

Cell["All-plus three-photon amplitude", "Subsection",ExpressionUUID->"3083faa4-f065-4610-8857-835fd9123e22"],

Cell["\<\
This is the compact expression derived previously in QED-5-point.nb, \
displayed explicitly rather than attributed to the automatic completion stage.\
\>", "Text",ExpressionUUID->"7ea00ed6-7662-468c-9b1f-05f4f579a87e"],

Cell[CellGroupData[{

Cell["\<\
allPlusWorkedAmplitude =
  2 Sqrt[2] electricCharge^3 electronMass *
    SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Spin\", \"Angle\", \
2]] *
    Total[Table[With[{other = DeleteCases[{3, 4, 5}, photon]},
      SpinorChain[Spinor[\"Helicity\", \"Square\", other[[1]]],
        Spinor[\"Helicity\", \"Square\", other[[2]]]]^2 *
      SpinorChain[Spinor[\"Helicity\", \"Square\", photon], Mom[1], Mom[2],
        Spinor[\"Helicity\", \"Square\", photon]] /
      PropDen[Mom[Multiparticle[2, photon]], electronMass]], {photon, {3, 4, 5}}]] /
    (Times @@ Table[PropDen[Mom[Multiparticle[1, photon]], electronMass],
      {photon, {3, 4, 5}}]);
allPlusWorkedAmplitude\
\>", "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"0d27ad3b-ec77-48ea-bdce-b76db9e946cf"],

