Cell["\<\
Show the final checks. A failed or unfinished attempt \
is never assigned to constructedAmplitude. The all-plus result can still \
contain Xi: the reference-independence test verifies its cancellation at the \
sampled momenta.\
\>", "Text",ExpressionUUID->"5f86fa51-e8e0-4476-ab3e-676a28d63c3b"],

Cell[CellGroupData[{

Cell["\<\
Clear[constructedAmplitude, constructionChecks];
If[FailureQ[completion] || completion === $Failed,
  completion,
  constructedAmplitude = completion;
  constructionChecks = CheckPhysicalResidues[
    constructedAmplitude, channels, factorizationModel,
    \"Samples\" -> checkSamples, \"TimeConstraint\" -> timeLimit,
    \"Output\" -> \"Details\"];
  constructionChecks[\"Table\"]]\
\>", "Input",
 CellLabel->
  "In[193]:=",ExpressionUUID->"6a8cd981-441c-4abf-9173-13a89e05fc1a"],

