Cell[CellGroupData[{

Cell["Independent Feynman Benchmark", "Subsection",ExpressionUUID->"2b5ecc59-5b39-4a7f-86a6-232d171e8aa8"],

Cell["\<\
Generate the same process from Feynman rules. Preparation converts the tensors \
to spinor products without putting internal lines on shell. Each external \
photon uses one fixed Xi across all Feynman diagrams. The final check \
compares the two complete amplitudes away from all poles. MaxSteps -> 0 skips \
the optional identity search, not the exact conversion and spinor reduction.\
\>", "Text",ExpressionUUID->"d6029ac6-3fce-4936-87c7-1f3388499fc6"],

Cell["\<\
feynmanDiagrams = CreateDiagrams[particles, qedFeynmanModel];
feynmanPairs = diagramAmplitudes[feynmanDiagrams];
CreateArrowDiagrams[feynmanDiagrams];\
\>", "Input",
 CellChangeTimes->{4.002021562043014*^9},
 CellLabel->"In[28]:=",ExpressionUUID->"039bf1ac-86e8-4f7c-b8cc-64f454c06d95"],

Cell[CellGroupData[{

Cell["\<\
preparedFeynman = PrepareAmplitudes[feynmanPairs, qedFeynmanModel,
  \"ReferenceSpinors\" -> \"AllPhysical\", \"MaxSteps\" -> 0];
feynmanAmplitude = Total[Last /@ preparedFeynman];
feynmanAmplitude\
\>", "Input",
 CellChangeTimes->{{4.002017491227551*^9, 4.0020174959831553`*^9}, {
  4.002017591197651*^9, 4.002017594509304*^9}, {4.002017634211087*^9, 
  4.002017660474188*^9}, {4.002021594442821*^9, 4.002021634476451*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"f013de80-8815-4f85-8295-d11d8c1e781b"],

