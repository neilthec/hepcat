Cell[CellGroupData[{

Cell["Mixed helicities: e, E, A.+, A.+, A.-", "Subsection",ExpressionUUID->"00a63bca-afc3-4fb3-b302-7c1453074b6c"],

Cell["\<\
The existing worked route starts with the six generated diagrams, records \
diagram-local numerator choices and their completion terms, and eliminates \
the reference poles. It is a QED-specific derivation, not an automatic \
solution for arbitrary inputs.\
\>", "Text",ExpressionUUID->"5e1ac6aa-4b18-4257-a81c-e53227f700f1"],

Cell[CellGroupData[{

Cell["\<\
mixedParticles = {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\"};
mixedDiagrams = CreateDiagrams[mixedParticles, diagramModel];
mixedRawAmplitudes = diagramAmplitudes[mixedDiagrams];
mixedWorkedRoute = qedFivePointMixedRoute[mixedRawAmplitudes];
mixedWorkedAmplitude = mixedWorkedRoute[\"Final\"];
mixedWorkedAmplitude\
\>", "Input",
 CellLabel->
  "In[139]:=",ExpressionUUID->"62b2aa74-25ad-4894-bd3b-c2bcb1423d47"],

