Cell[CellGroupData[{

Cell["Inspect a mixed-helicity numerator correction", "Subsection",ExpressionUUID->"918905a1-c6a2-460b-84cb-7257e7737c83"],

Cell["\<\
Grid[{
  {\"Diagram order\", mixedWorkedRoute[\"PhotonOrders\"][[1]]},
  {\"Seed numerator\", mixedWorkedRoute[\"LocalSeedNumerators\"][[1]]},
  {\"Added numerator\", mixedWorkedRoute[\"LocalCompletionNumerators\"][[1]]}},
  Alignment -> Left, Frame -> All]\
\>", "Input",ExpressionUUID->"e40775dc-a743-46f5-a2e1-30e6caeba4e4"]
}, Closed]],

Cell[CellGroupData[{

Cell["Four fermions and a photon: e, E, E, e, A.+", "Subsection",ExpressionUUID->"f783efdd-f4cb-4be5-91a1-27d221d69c6c"],

Cell["\<\
The eight diagrams combine into four radiating-current blocks. This worked \
route records each Dirac reduction, its removed numerator multiple and \
off-cut remainder, then cancels the common Xi when pairing photon \
attachments. It preserves both physical propagators off shell.\
\>", "Text",ExpressionUUID->"05e17657-4b6e-4a0a-9797-4281416e2f5e"],

Cell[CellGroupData[{

Cell["\<\
fourFermionParticles = {\"e\", \"E\", \"E\", \"e\", \"A.+\"};
fourFermionDiagrams = CreateDiagrams[fourFermionParticles, diagramModel];
fourFermionWorkedRoute = q5FourFermionPhotonRoute[fourFermionDiagrams];
fourFermionWorkedAmplitude = fourFermionWorkedRoute[\"Final\"];
fourFermionWorkedAmplitude\
\>", "Input",
 CellLabel->
  "In[145]:=",ExpressionUUID->"e06eb4c0-2bd5-4243-9602-bba9f9a05267"],

