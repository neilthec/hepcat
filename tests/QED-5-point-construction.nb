Cell["CheckAmplitudes[qedAmplitudes[[caseNumber]], qedChannels[[caseNumber]],\n  factorizationModel,\n  \"Output\" -> \"Residues\"]", "Input",ExpressionUUID->"81a48114-772b-4daa-988b-8fee1c950b68"]
}, Closed]]
}, Closed]]

}, Closed]],

Cell[CellGroupData[{

Cell["Six-Point Amplitudes", "Subtitle", ExpressionUUID->"888390d6-34ec-58e0-9110-41252f148171"],

Cell["Twenty-one separate calculations: all sixteen four-photon helicity assignments, all four two-photon assignments with four fermions, and six-fermion scattering. Some mixed-helicity calls retain a two-hour factorization budget; this is a limit, not a finishing-time guarantee. Unresolved calculations must not be interpreted as validated amplitudes.", "Text", ExpressionUUID->"34b004e4-81fa-586c-aee9-f98b402dfaa0"],

Cell[CellGroupData[{

Cell["e,E,A.+,A.+,A.+,A.+", "Chapter",
 CellChangeTimes->{{4.001759665590519*^9, 4.00175967079949*^9}, {
  4.002028656445068*^9, 
  4.002028657482607*^9}},ExpressionUUID->"15493c99-b701-4018-8d18-\
090e7c1acfef"],

Cell["Construct and Check", "Section", ExpressionUUID->"cef9dd1a-4216-51ba-9e59-1ce50abe37a7"],

Cell["Evaluate this cell after Setup. The wrapper generates and prepares the diagrams and factorization channels, completes and prepares the amplitude, then runs all final checks. The printed test report precedes the returned expression. The saved manual work remains available below.", "Text", ExpressionUUID->"b7f4d745-8e49-5b0f-b734-9f343933d143"],

Cell["qed6PPPP = ConstructAmplitude[\n  {\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.+\"},\n  diagramModel, factorizationModel,\n  \"FeynmanModel\" -> qedFeynmanModel]", "Input", ExpressionUUID->"48382d56-5ad0-55e2-a99f-e9d5d2546991"],

Cell[CellGroupData[{

Cell["Earlier Step-by-Step Work (Optional)", "Section", ExpressionUUID->"0b6cd90d-2c02-5223-aec4-1d5e3a34fabf"],

Cell[CellGroupData[{

Cell["1. Choose the Process and References", "Section",ExpressionUUID->"89026863-5544-489b-ab25-ac603cac3bb4"],

Cell["\<\
particles = {\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\",\"A.+\"};
referenceChoice = \"AllSpurious\";\
\>", "Input",
 CellChangeTimes->{{4.0016723486207333`*^9, 4.001672391849534*^9}, {
   4.001757782755148*^9, 4.00175778752351*^9}, 4.001757993489561*^9, {
   4.002028662947987*^9, 4.002028666130702*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"973adb5c-6d80-4af0-a836-34261c6484b5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Generate the Diagrams", "Section",ExpressionUUID->"829336c3-0232-4ede-97cc-606232df4f3f"],

Cell[CellGroupData[{

Cell["\<\
diagrams = CreateDiagrams[particles, diagramModel];
rawAmplitudes = diagramAmplitudes[diagrams];
Length[rawAmplitudes]\
\>", "Input",
 CellLabel->
  "In[129]:=",ExpressionUUID->"53aaf630-9d47-402c-8e76-3f9c9e04a922"],

Cell[BoxData["24"], "Output",
 CellChangeTimes->{4.0016721377967997`*^9, 4.0016879511169777`*^9, 
  4.0020168126609573`*^9, 4.002021500272408*^9, 4.002028527826282*^9, 
  4.002028678542947*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"3ff4402d-6579-4821-bb18-136f2ec1a844"]
}, Open  ]],

Cell[CellGroupData[{

Cell["View the diagrams", "Subsection",ExpressionUUID->"f095ff72-e0c7-4626-9ccb-cd57a8a70d3d"],

Cell["CreateArrowDiagrams[diagrams]", "Input",ExpressionUUID->"67d8c5bd-f375-416c-b478-6811d832ff41"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Prepare Each Diagram", "Section",ExpressionUUID->"ebda4c03-b7cb-4748-8e82-35ee77c7dae0"],

Cell["\<\
Preparation applies ReduceSpinContractions, selects the references, reduces \
known numerator scalar products, calls ReduceSpinorProducts, then continues \
with improving identity steps. Each diagram uses its own internal on-shell \
conditions in its numerator. Original propagators stay off shell.\
\>", "Text",ExpressionUUID->"9916c18d-f6e4-45a7-b842-fe42dde7df29"],

Cell["\<\
preparationDetails = PrepareAmplitudes[rawAmplitudes, diagramModel,
  \"ExternalParticles\" -> particles,
  \"PolePreference\" -> referenceChoice,
  \"ReturnDetails\" -> True];
preparation = preparationDetails[\"PreparedAmplitudes\"];\
\>", "Input",
 CellChangeTimes->{{4.002029627104932*^9, 
  4.002029627937378*^9}},ExpressionUUID->"d61557f4-ea78-4d0f-8fe8-\
1657f5c1719f"],

