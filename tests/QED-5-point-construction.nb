Cell[CellGroupData[{

Cell["e,E,E,e,A.-", "Chapter", ExpressionUUID->"a580c69d-cf9b-5c7a-af95-9df454c158d7"],

Cell["This calculation now completes automatically. The apparent high-energy freedom consisted of expressions proved identically zero using external identities and momentum conservation. Final checks, including the independent Feynman comparison, passed. Evaluate the calculation below to obtain a fresh result.", "Text", ExpressionUUID->"7dbf9a87-9808-5c95-a673-9ed74906ec45"],

Cell["qed5FourFermionsM = ConstructAmplitude[\n  {\"e\", \"E\", \"E\", \"e\", \"A.-\"},\n  diagramModel, factorizationModel,\n  \"FeynmanModel\" -> qedFeynmanModel]", "Input", ExpressionUUID->"2ac0cb72-3082-5941-925b-b84b0bc3f0f4"]

}, Open]]

}, Open]],

Cell[CellGroupData[{

Cell["Additional Five-Point Worked Results (Optional)", "Subtitle", ExpressionUUID->"d001e7f1-725d-5fa4-ad99-82cddc48413b"],

Cell["The earlier compact formulas and batch checks are preserved here. The explicit calculations above are independent and do not require these supplementary sections. Earlier step-by-step work also remains collapsed beneath its original process.", "Text", ExpressionUUID->"f9e5bf17-b3ce-5905-ae23-669a81c4abc5"],

Cell[CellGroupData[{

Cell["Compact Worked QED Results", "Chapter",ExpressionUUID->"2cf2fd86-409e-433f-bfcd-dceba02743d2"],

Cell["\<\
The general completion functions do not yet automatically finish every \
five-point case. The following are separate, existing QED derivations, not \
hidden substitutes for Sections 1-5. They give three representative compact \
amplitudes; photon relabeling and parity give the remaining helicities. Every \
resulting amplitude is checked independently in Section 7.\
\>", "Text",ExpressionUUID->"edd40085-a8bb-429c-a805-92eecea9c14e"],

Cell["\<\
Get[FileNameJoin[{hepcatDirectory, \"tests\", \"QED-5-point-residues.wl\"}]];\
\
\>", "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"b688bea5-1a21-4088-a261-03190d7eb181"],

Cell[CellGroupData[{

Cell["All-plus three-photon amplitude", "Subsection",ExpressionUUID->"3083faa4-f065-4610-8857-835fd9123e22"],

Cell["\<\
This is the compact expression derived previously in QED-5-point.nb, \
displayed explicitly rather than attributed to the automatic completion stage.\
\>", "Text",ExpressionUUID->"7ea00ed6-7662-468c-9b1f-05f4f579a87e"],

Cell[CellGroupData[{

Cell["\<\
allPlusWorkedAmplitude =
  2 Sqrt[2] electricCharge^3 electronMass *
    SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Spin\", \"Angle\", \
2]] *
    Total[Table[With[{other = DeleteCases[{3, 4, 5}, photon]},
      SpinorChain[Spinor[\"Helicity\", \"Square\", other[[1]]],
        Spinor[\"Helicity\", \"Square\", other[[2]]]]^2 *
      SpinorChain[Spinor[\"Helicity\", \"Square\", photon], Mom[1], Mom[2],
        Spinor[\"Helicity\", \"Square\", photon]] /
      PropDen[Mom[Multiparticle[2, photon]], electronMass]], {photon, {3, 4, 5}}]] /
    (Times @@ Table[PropDen[Mom[Multiparticle[1, photon]], electronMass],
      {photon, {3, 4, 5}}]);
allPlusWorkedAmplitude\
\>", "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"0d27ad3b-ec77-48ea-bdce-b76db9e946cf"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SqrtBox["2"], " ", 
   SuperscriptBox["EE", "3"], " ", "Me", " ", 
   TemplateBox[{
     TemplateBox[{"\"\[LeftAngleBracket]\"", 
       StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"], 
     TemplateBox[{
       StyleBox["2", Bold, StripOnInput -> False], 
       "\"\[RightAngleBracket]\""}, "RowDefault"]},
    "RowDefault"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox[
        TemplateBox[{
          TemplateBox[{"\"[\"", "4"}, "RowDefault"], 
          TemplateBox[{"5", "\"]\""}, "RowDefault"]},
         "RowDefault"], "2"], " ", 
       TemplateBox[{
         TemplateBox[{"\"[\"", "3"}, "RowDefault"], "\"|\"", 
         SubscriptBox["p", "1"], 
         SubscriptBox["p", "2"], "\"|\"", 
         TemplateBox[{"3", "\"]\""}, "RowDefault"]},
        "RowDefault"]}], 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["Me", "2"]}], "+", 
       SubsuperscriptBox["p", 
