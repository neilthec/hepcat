Cell[CellGroupData[{

Cell["5. Complete High Energy and Verify", "Section",ExpressionUUID->"b21fa8bd-2996-40da-85bb-5e50520266a2"],

Cell[CellGroupData[{

Cell["\<\
completion = If[FailureQ[factorization] || factorization === $Failed,
  factorization,
  CompleteHighEnergy[factorization, channels, factorizationModel,
    \"Samples\" -> 1, \"ValidationSamples\" -> 1,
    \"MaxCorrectionTerms\" -> 128, \"TimeConstraint\" -> timeLimit]];
completion\
\>", "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"74a2a00e-8f4f-478f-a9ac-4ce4f6177007"],

