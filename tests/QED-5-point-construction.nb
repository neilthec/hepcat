Cell["\<\
Show the final checks, including the independent Feynman result. A failed or \
unfinished attempt is never assigned to constructedAmplitude. The all-plus \
result can still contain Xi: the reference-independence test verifies its \
cancellation at the sampled momenta.\
\>", "Text",ExpressionUUID->"5f86fa51-e8e0-4476-ab3e-676a28d63c3b"],

Cell[CellGroupData[{

Cell["\<\
Clear[constructedAmplitude, constructionChecks];
If[FailureQ[completion] || completion === $Failed,
  completion,
  constructedAmplitude = completion;
  constructionChecks = CheckAmplitudes[
    constructedAmplitude, channels, factorizationModel,
    \"FeynmanAmplitudes\" -> preparedFeynman,
    \"FeynmanModel\" -> qedFeynmanModel,
    \"Samples\" -> checkSamples, \"TimeConstraint\" -> timeLimit,
    \"Output\" -> \"Details\"];
  constructionChecks[\"Table\"]]\
\>", "Input",
 CellChangeTimes->{{4.002017187598366*^9, 4.0020171932212467`*^9}, {
  4.002017349371266*^9, 4.002017357332312*^9}, {4.002017433514278*^9, 
  4.002017458909691*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"6a8cd981-441c-4abf-9173-13a89e05fc1a"],

