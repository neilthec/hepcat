Cell[CellGroupData[{

Cell["1. Choose the Process and References", "Section",ExpressionUUID->"5f1d6f76-3110-44d9-aa44-ce1079df991f"],

Cell["\<\
particles = {\"e\", \"E\", \"E\", \"e\", \"A.+\"};
referenceChoice = Automatic;\
\>", "Input",
 CellChangeTimes->{{4.0016723486207333`*^9, 4.001672391849534*^9}, {
   4.001757782755148*^9, 4.00175778752351*^9}, 4.001757993489561*^9, {
