Cell[CellGroupData[{

Cell["5. Complete High Energy and Verify", "Section",ExpressionUUID->"14798994-0fb5-423e-b30f-6ed5442d6637"],

Cell[CellGroupData[{

Cell["\<\
completion = If[FailureQ[factorization] || factorization === $Failed,
  factorization,
  CompleteHighEnergy[factorization, channels, factorizationModel,
    \"Samples\" -> 1, \"ValidationSamples\" -> 1,
    \"MaxCorrectionTerms\" -> 128, \"TimeConstraint\" -> timeLimit]];
completion\
\>", "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"d1534d58-7c0a-4fcd-9a29-6c3009b68059"],

