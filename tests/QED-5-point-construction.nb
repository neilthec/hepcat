Cell[CellGroupData[{

Cell["7. Check Every Five-Point Helicity Choice", "Section",ExpressionUUID->"ac6ec3a6-f0cf-47e7-8d9c-2f001b033e6f"],

Cell["\<\
The electron/photon model has two nonzero five-point tree families: one \
electron-positron pair with three photons (eight photon-helicity choices), \
and two pairs with one photon (two choices). Other orderings follow by \
relabeling. Pure five-photon amplitudes vanish at tree level. Other charged \
flavors are not included in this model.\
\>", "Text",ExpressionUUID->"39e199c3-56eb-4618-81ac-d93d00dfa632"],

Cell["\<\
The following two small helpers only relabel the external photons or exchange \
angle and square spinors. They do not simplify or complete an amplitude. Xi \
IDs, numerical coefficients and exponents are not particle labels.\
\>", "Text",ExpressionUUID->"db54113d-b21d-47f0-aa16-6ced103ae475"],

Cell["\<\
relabelPhotons[expression_, order_List] :=
  With[{rules = Thread[{3, 4, 5} -> order]}, expression /. {
    Spinor[type : Except[\"Xi\"], kind_, leg_Integer, rest___] :>
      Spinor[type, kind, leg /. rules, rest],
    Mom[leg_Integer] :> Mom[leg /. rules],
    Mom[Multiparticle[legs__Integer]] :>
      Mom[Multiparticle @@ Sort[{legs} /. rules]]}];

reverseHelicities[expression_] := expression /.
  Spinor[type_, kind : (\"Angle\" | \"Square\"), rest___] :>
    Spinor[type, If[kind === \"Angle\", \"Square\", \"Angle\"], rest];\
\>", "Input",
 CellLabel->
  "In[150]:=",ExpressionUUID->"7ad9692e-cf7d-4996-ac43-c4f24b376773"],

Cell["\<\
Build the eight three-photon expressions from the two displayed worked \
amplitudes. In these conventions parity adds no extra overall sign.\
\>", "Text",ExpressionUUID->"4a2d80da-d90a-425d-aa60-00d60c9ef184"],

Cell["\<\
photonHelicities = Tuples[{\"A.+\", \"A.-\"}, 3];
threePhotonProcesses = Join[{\"e\", \"E\"}, #] & /@ photonHelicities;
threePhotonAmplitudes = Table[
  With[{plus = Pick[{3, 4, 5}, helicities, \"A.+\"],
        minus = Pick[{3, 4, 5}, helicities, \"A.-\"]},
    Which[
      Length[plus] === 3, allPlusWorkedAmplitude,
      Length[minus] === 3, reverseHelicities[allPlusWorkedAmplitude],
      Length[plus] === 2, relabelPhotons[mixedWorkedAmplitude, Join[plus, \
minus]],
      Length[minus] === 2, \
relabelPhotons[reverseHelicities[mixedWorkedAmplitude],
        Join[minus, plus]]]],
  {helicities, photonHelicities}];

qedProcesses = Join[threePhotonProcesses, {
  {\"e\", \"E\", \"E\", \"e\", \"A.+\"},
  {\"e\", \"E\", \"E\", \"e\", \"A.-\"}}];
qedAmplitudes = Join[threePhotonAmplitudes,
  {fourFermionWorkedAmplitude, \
reverseHelicities[fourFermionWorkedAmplitude]}];\
\>", "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"a567f2ed-0002-4769-8fc9-4adf08c310d6"],

Cell["\<\
Run all four kinds of check on each complete summed amplitude. The displayed \
process name reports progress; this loop can take a few minutes. A \
reference-free expression has no explicit Xi dependence; that is not an \
independent Ward-identity proof.\
\>", "Text",ExpressionUUID->"e0f83eb0-9f4d-4bae-a184-1514e6db1ca0"],

Cell[CellGroupData[{

Cell["\<\
qedChannels = FactorizationAmplitudeChannels[#, factorizationModel] & /@ \
qedProcesses;
qedChecks = Table[
  Print[\"Checking \", StringRiffle[qedProcesses[[i]], \", \"]];
  CheckAmplitudes[qedAmplitudes[[i]], qedChannels[[i]], \
factorizationModel,
    \"Samples\" -> checkSamples,
    \"HighEnergySamples\" -> checkSamples, \"ReferenceSamples\" -> \
checkSamples,
    \"TimeConstraint\" -> timeLimit, \"Output\" -> \"Details\"],
  {i, Length[qedProcesses]}];\
\>", "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"d1af0282-ea1f-4773-a480-0772edb9c8ab"],

