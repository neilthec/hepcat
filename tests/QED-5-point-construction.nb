Cell["\<\
Show the final checks, including the independent Feynman result. A failed or \
unfinished attempt is never assigned to constructedAmplitude. The all-plus \
result can still contain Xi: the reference-independence test verifies its \
cancellation at the sampled momenta.\
\>", "Text",ExpressionUUID->"f898b1d2-a926-4d85-950c-bf2c028ded42"],

Cell[CellGroupData[{

Cell["Clear[constructedAmplitude, constructionChecks];\nIf[FailureQ[completion] || completion === $Failed,\n  completion,\n  constructedAmplitude = PrepareAmplitudes[completion, factorizationModel];\n  If[FailureQ[constructedAmplitude] || constructedAmplitude === $Failed,\n    constructedAmplitude,\n    constructionChecks = CheckAmplitudes[\n      constructedAmplitude, channels, factorizationModel,\n      \"FeynmanAmplitudes\" -> preparedFeynman,\n      \"FeynmanModel\" -> qedFeynmanModel,\n      \"Output\" -> \"Details\"];\n    constructionChecks[\"Table\"]]]", "Input",
 CellChangeTimes->{{4.002017187598366*^9, 4.0020171932212467`*^9}, {
  4.002017349371266*^9, 4.002017357332312*^9}, {4.002017433514278*^9, 
  4.002017458909691*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"62cf9510-81cd-4566-9e42-51f3c8b6de40"],

