Cell[CellGroupData[{

Cell["Independent Feynman Benchmark", "Subsection",ExpressionUUID->"a7174b5a-bb86-4400-a443-781d89b64f28"],

Cell["\<\
Generate and prepare the mixed-helicity Feynman diagrams independently, then \
compare the complete results away from all poles. No internal on-shell \
conditions are applied. Each photon keeps one fixed Xi across all diagrams.\
\>", "Text",ExpressionUUID->"0b5ec014-3b23-422a-a15a-3d66a6efcac7"],

Cell["\<\
feynmanDiagrams = CreateDiagrams[particles, qedFeynmanModel];
feynmanPairs = diagramAmplitudes[feynmanDiagrams];
CreateArrowDiagrams[feynmanDiagrams];\
\>", "Input",
 CellChangeTimes->{4.002021940157158*^9},
 CellLabel->"In[70]:=",ExpressionUUID->"ea97d2eb-e401-4a4c-9129-cc07ba8885d1"],

Cell[CellGroupData[{

Cell["preparedFeynman = PrepareAmplitudes[feynmanPairs, qedFeynmanModel,\n  \"PolePreference\" -> \"AllPhysical\"];\nfeynmanAmplitude = Total[Last /@ preparedFeynman];\nfeynmanAmplitude", "Input",
 CellChangeTimes->{{4.002021947280526*^9, 4.0020219530464277`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"0aa112a4-f362-4f57-aec9-486432e254b6"],

