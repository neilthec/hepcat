Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[Table[{
  StringRiffle[qedProcesses[[i]], \", \"],
  qedChecks[[i]][\"PhysicalSummary\"],
  If[qedChecks[[i]][\"SpuriousSummary\"] === <||>, \"None found\",
    qedChecks[[i]][\"SpuriousSummary\"]],
  qedChecks[[i]][\"HighEnergyCheck\"][\"Status\"],
  qedChecks[[i]][\"ReferenceCheck\"][\"Status\"]},
  {i, Length[qedProcesses]}],
  {\"Process\", \"Physical residues\", \"Spurious poles\", \"High energy\", \
\"Xi independence\"}],
  Alignment -> Left, Frame -> All]\
\>", "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"8235a1e2-7b33-4aee-9c36-66aeac147619"],

