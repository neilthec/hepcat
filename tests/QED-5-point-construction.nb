  4.001776461567669*^9, 4.001777399015984*^9, 4.001943275082426*^9, 
  4.002021782251495*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"7064e033-0259-4ccf-bcc1-481785e2e47c"]
}, Open  ]],

