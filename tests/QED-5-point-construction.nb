Cell[CellGroupData[{

Cell["Optional: Preparation Details", "Subsection",ExpressionUUID->"b1067fca-8bad-40c1-8e00-779461c05107"],

Cell["\<\
The preparation report is already saved. Inspect the first diagram's \
reference assignments below. A PARTIAL status means preparation retained the \
last completed expression; the report explains why.\
\>", "Text",ExpressionUUID->"1784af3a-f8d7-4a70-ba15-34440b5621c8"],

Cell["\<\
Grid[Prepend[
  ({#[\"Reference\"], #[\"Mode\"], #[\"Target\"]} & /@
    preparationDetails[\"DiagramReports\"][[1]][\"PolePreference\"][\"Assignments\"]),
  {\"Original reference\", \"Choice\", \"Replacement\"}], Frame -> All]\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"472f3ff8-8d5a-4669-9613-97fc5583ef00"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Complete the Physical Residues", "Section",ExpressionUUID->"b2277d8e-d982-407c-81cd-b498c2b4d73a"],

Cell[CellGroupData[{

Cell["\<\
channels = FactorizationAmplitudeChannels[particles, factorizationModel];
channelPreparationDetails = PrepareAmplitudes[channels, factorizationModel,
  \"ExternalParticles\" -> particles,
  \"PolePreference\" -> referenceChoice, \"ReturnDetails\" -> True];
preparedChannels = channelPreparationDetails[\"PreparedAmplitudes\"];
Length[channels]\
\>", "Input",
 CellChangeTimes->{4.0020296563474417`*^9},
 CellLabel->
  "In[138]:=",ExpressionUUID->"ee6aee73-6160-495b-b328-effacc98849a"],

Cell[BoxData["14"], "Output",
 CellChangeTimes->{
  4.001687978158999*^9, 4.001758089978546*^9, 4.0020169127499104`*^9, 
   4.0020215307078857`*^9, 4.002028559397571*^9, {4.002029651108294*^9, 
   4.002029658020447*^9}},
 CellLabel->
  "Out[139]=",ExpressionUUID->"7919e002-34b1-4224-a208-af4864fe878a"]
}, Open  ]],

Cell["The four photons on legs 3 through 6 are identical states. Completion infers their Bose symmetry from the ordered process and the model; no manual groups are needed. This six-point system needs more \
samples and correction terms than the five-point examples.", "Text",
 ExpressionUUID->"87d2e013-6b7b-43fc-8a92-eaa571f69986"],

Cell[CellGroupData[{

Cell["factorization = CompleteFactorization[preparationDetails, channelPreparationDetails,\n  factorizationModel];\nfactorization", "Input",
 CellChangeTimes->{{4.0020169608216467`*^9, 4.0020169623748627`*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"2728646b-efee-4444-81aa-d52c19f3d07d"],

