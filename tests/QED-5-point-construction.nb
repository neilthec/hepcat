Cell[CellGroupData[{

Cell["Independent Feynman Benchmark", "Subsection",ExpressionUUID->"57af8919-bccf-4c2b-88b3-11ee8883ffb2"],

Cell["\<\
Generate and prepare the mixed-helicity Feynman diagrams independently, then \
compare the complete results away from all poles. No internal on-shell \
conditions are applied. Each photon keeps one fixed Xi across all diagrams.\
\>", "Text",ExpressionUUID->"a7a694c4-f1a2-4124-a741-213d8e2bfe1e"],

Cell["\<\
feynmanDiagrams = CreateDiagrams[particles, qedFeynmanModel];
feynmanPairs = diagramAmplitudes[feynmanDiagrams];
CreateArrowDiagrams[feynmanDiagrams];\
\>", "Input",
 CellChangeTimes->{4.002021940157158*^9},
 CellLabel->"In[70]:=",ExpressionUUID->"11dcb2ba-ac54-409e-957b-8b92be5fa478"],

Cell[CellGroupData[{

Cell["\<\
preparedFeynman = PrepareAmplitudes[feynmanPairs, qedFeynmanModel,
  \"ReferenceSpinors\" -> \"AllPhysical\", \"MaxSteps\" -> 0];
feynmanAmplitude = Total[Last /@ preparedFeynman];
feynmanAmplitude\
\>", "Input",
 CellChangeTimes->{{4.002021947280526*^9, 4.0020219530464277`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"233aefc4-996b-461a-81b2-a417948bf8cc"],

