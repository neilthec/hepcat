Cell[CellGroupData[{

Cell["e,E,A.-,A.+,A.+", "Chapter", ExpressionUUID->"30268457-ceb6-5ada-9ca0-39bbe417f399"],

Cell["This ordering now completes automatically. The apparent high-energy freedom consisted of expressions proved identically zero using external identities and momentum conservation. Final checks, including the independent Feynman comparison, passed. Evaluate the calculation below to obtain a fresh result.", "Text", ExpressionUUID->"0451a7f9-3405-5d2d-9ae1-da9bdf177f7d"],

Cell["qed5MPP = ConstructAmplitude[\n  {\"e\", \"E\", \"A.-\", \"A.+\", \"A.+\"},\n  diagramModel, factorizationModel,\n  \"FeynmanModel\" -> qedFeynmanModel]", "Input", ExpressionUUID->"505d8c13-008c-5100-b989-cbbbf7637ebf"]

}, Open]],

