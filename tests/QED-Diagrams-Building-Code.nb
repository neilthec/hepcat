                    "]"}], "===", "pu"}], ",", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t          ", 
                    RowBox[{
                    RowBox[{"\"Particle\"", "->", "pv"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"Antiparticle\"", "->", "pu"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"ParticleVertex\"", "->", "v"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"AntiparticleVertex\"", "->", "u"}]}], 
                    "\[IndentingNewLine]", "\t        ", "|>"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    "\[IndentingNewLine]", "\t        ", "True", ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t          ", 
