                    RowBox[{
                    RowBox[{"inds", "=", 
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"edgeIndexData", "[", "edge", "]"}], ",", 
                    RowBox[{"Length", "[", "items", "]"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{"variance", "=", 
                    RowBox[{"spinorVarianceAtEndpoint", "[", 
                    RowBox[{"diag", ",", "edge", ",", "vertex"}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "        ", 
                    "\[IndentingNewLine]", "        ", 
                    
                    RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
                    "          ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#1", "[", "\"Spinor\"", "]"}], ":>", 
                    "\[IndentingNewLine]", "            ", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "variance", ",", 
                    RowBox[{"#1", "[", "\"SpinType\"", "]"}], ",", 
                    RowBox[{"#1", "[", "\"Multiparticle\"", "]"}], ",", 
                    "#2"}], "]"}]}], " ", "&"}], ",", "\[IndentingNewLine]", 
                    "          ", 
                    RowBox[{"{", 
                    RowBox[{"items", ",", "inds"}], "}"}]}], 
                    "\[IndentingNewLine]", "        ", "]"}]}]}], 
                    "\[IndentingNewLine]", "      ", "]"}]}], 
                    "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", "grouped"}], 
                    "\[IndentingNewLine]", "  ", "]"}]}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"newExpr", "=", 
                    RowBox[{"expr", " ", "/.", " ", "replacementRules"}]}], 
                  ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", 
                  "  ", 
                  RowBox[{"newExpr", "=", 
                    RowBox[{"Fold", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"currentExpr", ",", "edge"}], "}"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"If", "[", "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"grouped", "[", "edge", "]"}], "]"}], ">", "1"}], 
                    ",", "\[IndentingNewLine]", "        ", 
                    
                    RowBox[{"symmetrizeIndices", "[", "\[IndentingNewLine]", 
                    "          ", 
                    
                    RowBox[{"currentExpr", ",", "\[IndentingNewLine]", 
                    "          ", 
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"edgeIndexData", "[", "edge", "]"}], ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"grouped", "[", "edge", "]"}], "]"}]}], "]"}]}], 
                    "\[IndentingNewLine]", "        ", "]"}], ",", 
                    "\[IndentingNewLine]", "        ", "currentExpr"}], 
                    "\[IndentingNewLine]", "      ", "]"}]}], 
                    "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", "newExpr", ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"Keys", "[", "grouped", "]"}]}], 
                    "\[IndentingNewLine]", "  ", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"Join", "[", 
                    RowBox[{"vertexStructure", ",", 
                    RowBox[{"<|", 
                    RowBox[{"\"Expression\"", "->", "newExpr"}], "|>"}]}], 
                    "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"makeDiagramSpinIndicesExplicit", "[", "diag_", "]"}], 
            ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", 
                  RowBox[{"edgeIndexData", ",", "newVertexStructures"}], 
                  "}"}], ",", "\[IndentingNewLine]", "  ", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"edgeIndexData", "=", 
                    RowBox[{"edgeSpinIndexData", "[", "diag", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"newVertexStructures", "=", 
                    RowBox[{"Association", " ", "@", " ", 
                    RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"vertex", ",", "structures"}], "}"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"vertex", "->", 
                    RowBox[{"Replace", "[", "\[IndentingNewLine]", "        ", 
                    
                    RowBox[{"structures", ",", "\[IndentingNewLine]", 
                    "        ", 
                    RowBox[{"{", "\[IndentingNewLine]", "          ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", 
                    RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                    "          ", 
                    RowBox[{"list_List", ":>", 
                    
                    RowBox[{"ReplacePart", "[", "\[IndentingNewLine]", 
                    "            ", 
                    
                    RowBox[{"list", ",", "\[IndentingNewLine]", 
                    "            ", 
                    RowBox[{
                    RowBox[{"-", "1"}], "->", 
                    
                    RowBox[{"makeVertexSpinIndicesExplicit", "[", 
                    "\[IndentingNewLine]", "              ", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", 
                    "\[IndentingNewLine]", "              ", "vertex", ",", 
                    "\[IndentingNewLine]", "              ", "diag", ",", 
                    "\[IndentingNewLine]", "              ", 
                    "edgeIndexData"}], "\[IndentingNewLine]", "            ", 
                    "]"}]}]}], "\[IndentingNewLine]", "          ", "]"}]}]}],
                     "\[IndentingNewLine]", "        ", "}"}]}], 
                    "\[IndentingNewLine]", "      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}]}], 
                    "\[IndentingNewLine]", "  ", "]"}]}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"Join", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{"diag", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    
                    RowBox[{
                    "\"VertexStructures\"", "->", "newVertexStructures"}], 
                    ",", "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"SpinIndices\"", "->", "edgeIndexData"}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}]}], 
                    "\[IndentingNewLine]", "  ", "]"}]}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", 
                  
                  RowBox[{
                   "processed", ",", "vertexFactors", ",", 
                    "propagatorFactors"}], "}"}], ",", "\[IndentingNewLine]", 
                "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"processed", "=", 
                    
                    RowBox[{
                    "makeDiagramSpinIndicesExplicit", "[", "diag", "]"}]}], 
                  ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", 
                  "  ", 
                  RowBox[{"vertexFactors", "=", 
                    RowBox[{"Replace", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"VertexStructures\"", "]"}], 
                    "]"}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"{", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", "1"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"list_List", ":>", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", "\"Expression\"",
                     ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", "    ", 
                    "}"}], ",", "\[IndentingNewLine]", "    ", "1"}], 
                    "\[IndentingNewLine]", "  ", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"propagatorFactors", "=", 
                    RowBox[{"Lookup", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"Propagators\"", "]"}], "]"}],
                     ",", "\[IndentingNewLine]", "    ", "\"Factor\"", ",", 
                    "\[IndentingNewLine]", "    ", "1"}], 
                    "\[IndentingNewLine]", "  ", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{
                    RowBox[{"Times", " ", "@@", " ", 
                    RowBox[{"Join", "[", 
                    RowBox[{"vertexFactors", ",", "propagatorFactors"}], 
                    "]"}]}], "/", "I"}]}]}], "\[IndentingNewLine]", "]"}]}], 
          ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"diagramAmplitudes", "[", "diags_List", "]"}], ":=", 
          RowBox[{"diagramAmplitude", " ", "/@", " ", "diags"}]}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "3d4b3cfb-d272-4d44-97e6-7cd692e0fde7"],
 "\nYou should also keep your current ",
 Cell[BoxData[
  TemplateBox[{
    Cell["CreateDiagrams", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "f321a1bd-9ff4-4e5a-9876-177e9cf32a31"],
 " definition that calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell["decorateTopology", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "0fde571c-a399-436b-a877-0a230deb7a5d"],
 " and then ",
 Cell[BoxData[
  TemplateBox[{
    Cell["attachVertexStructures", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "fb844ce6-7a78-45e4-96ed-a5b73224188b"],
 ", because these updated functions are compatible with that workflow.\n\n\
Then use: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"diags", "=", 
            RowBox[{"CreateDiagrams", "[", 
              
              RowBox[{"\"e\"", ",", "\"E\"", ",", "\"A.+\"", ",", "\"A.+\"", 
                ",", "sm"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
        RowBox[{"diagramAmplitude", "[", 
          RowBox[{"diags", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "098b5f84-fb12-4242-b2e6-e253198e651d"],
 "\nand for all diagrams: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"diagramAmplitudes", "[", "diags", "]"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "f4103fcb-b3ab-4320-8988-b33f11b6d19d"],
 "\nIf you want, next I can give you a companion function like ",
 Cell[BoxData[
  TemplateBox[{
    Cell["totalAmplitude[diags_] := Total[diagramAmplitudes[diags]]", 
     Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "73daac21-b419-435c-8922-154fad1482dc"],
 " plus a version that factors or simplifies the result."
}], "ChatOutput",
 TaggingRules-><|
  "CellToStringData" -> 
   "Here are complete updated functions that add explicit \
particle/antiparticle endpoint tags to the diagram and then use them when \
constructing the amplitude.\n\nPaste these in as replacements.\n\n```wl\n\
ClearAll[\n  internalEdgeAssignments,\n  internalEdgeOrientationData,\n  \
decorateTopology,\n  internalPropagatorData,\n  attachVertexStructures,\n  \
spinorVarianceAtEndpoint,\n  symmetrizeIndices,\n  edgeSpinMultiplicity,\n  \
edgeSpinIndexData,\n  makeVertexSpinIndicesExplicit,\n  \
makeDiagramSpinIndicesExplicit,\n  diagramAmplitude,\n  diagramAmplitudes\n];\
\n\ninternalEdgeAssignments[\n  internalEdges_List,\n  particleTypes_List,\n  \
antiParticleRules_Association\n] := Module[\n  {choicesPerEdge},\n  \n  \
choicesPerEdge = Function[edge,\n    DeleteDuplicates @ Flatten[\n      \
Table[\n        With[{anti = Lookup[antiParticleRules, particle, \
Missing[\"NotFound\"]]},\n          If[\n            MissingQ[anti],\n        \
    {},\n            With[{ends = Sort[List @@ edge]},\n              {\n     \
           <|\n                  \"EndpointLabels\" -> \
AssociationThread[ends, {particle, anti}],\n                  \"Particle\" -> \
particle,\n                  \"Antiparticle\" -> anti,\n                  \
\"ParticleVertex\" -> ends[[1]],\n                  \"AntiparticleVertex\" -> \
ends[[2]]\n                |>,\n                <|\n                  \
\"EndpointLabels\" -> AssociationThread[ends, {anti, particle}],\n            \
      \"Particle\" -> particle,\n                  \"Antiparticle\" -> anti,\n\
                  \"ParticleVertex\" -> ends[[2]],\n                  \
\"AntiparticleVertex\" -> ends[[1]]\n                |>\n              }\n    \
        ]\n          ]\n        ],\n        {particle, particleTypes}\n      \
],\n      1\n    ]\n  ] /@ internalEdges;\n  \n  \
AssociationThread[internalEdges, #] & /@ Tuples[choicesPerEdge]\n];\n\n\
internalEdgeOrientationData[\n  internalEdgeData_Association\n] := \
Association @ KeyValueMap[\n  Function[{edge, data},\n    edge -> KeyTake[\n  \
    data,\n      {\"Particle\", \"Antiparticle\", \"ParticleVertex\", \
\"AntiparticleVertex\"}\n    ]\n  ],\n  internalEdgeData\n];\n\n\
decorateTopology[\n  graph_,\n  externalParticles_List,\n  model_,\n  \
antiParticleRules_Association\n] := Module[\n  {\n    particleTypes,\n    \
internalVerts,\n    leafVerts,\n    internalEdges,\n    extAssignments,\n    \
edgeAssignments\n  },\n  \n  particleTypes = particleNames[model];\n  \n  \
internalVerts = Select[VertexList[graph], VertexDegree[graph, #] > 1 &];\n  \
leafVerts = Select[VertexList[graph], VertexDegree[graph, #] == 1 &];\n  \n  \
internalEdges = Select[\n    EdgeList[graph],\n    FreeQ[leafVerts, \
Alternatives @@ (List @@ #)] &\n  ];\n  \n  extAssignments = \
externalAssignments[externalParticles, leafVerts];\n  edgeAssignments = \
internalEdgeAssignments[\n    internalEdges,\n    particleTypes,\n    \
antiParticleRules\n  ];\n  \n  Flatten @ Table[\n    Module[{edgeLabels, \
edgeOrientation},\n      edgeLabels = AssociationMap[\n        \
internalEdgeData[#, \"EndpointLabels\"] &,\n        Keys[internalEdgeData]\n  \
    ];\n      \n      edgeOrientation = \
internalEdgeOrientationData[internalEdgeData];\n      \n      If[\n        \
validVertexAssignmentFastQ[\n          graph,\n          internalVerts,\n     \
     extMap,\n          edgeLabels,\n          model\n        ],\n        <|\n\
          \"Graph\" -> graph,\n          \"ExternalAssignment\" -> extMap,\n  \
        \"InternalEdgeData\" -> internalEdgeData,\n          \
\"InternalEdgeLabels\" -> edgeLabels,\n          \"InternalEdgeOrientation\" \
-> edgeOrientation,\n          \"InternalVertices\" -> internalVerts,\n       \
   \"LeafVertices\" -> leafVerts\n        |>,\n        Nothing\n      ]\n    \
],\n    {extMap, extAssignments},\n    {internalEdgeData, edgeAssignments}\n  \
]\n];\n\ninternalPropagatorData[\n  graph_,\n  internalEdgeData_Association,\n\
  internalEdgeIndices_Association,\n  particleMassRules_Association\n] := \
Association @ KeyValueMap[\n  Function[{edge, edgeData},\n    \
Module[{particle, antiParticle, index, mass},\n      particle = \
edgeData[\"Particle\"];\n      antiParticle = edgeData[\"Antiparticle\"];\n   \
   index = First[Values[internalEdgeIndices[edge]]];\n      mass = \
Lookup[particleMassRules, particle, Missing[\"MassNotFound\"]];\n      \n     \
 edge -> <|\n        \"Particle\" -> particle,\n        \"Antiparticle\" -> \
antiParticle,\n        \"ParticleVertex\" -> edgeData[\"ParticleVertex\"],\n  \
      \"AntiparticleVertex\" -> edgeData[\"AntiparticleVertex\"],\n        \
\"Index\" -> index,\n        \"Mass\" -> mass,\n        \"Factor\" -> If[\n   \
       MissingQ[mass],\n          Missing[\"MassNotFound\", particle],\n      \
    I / PropDen[Mom[index], mass]\n        ]\n      |>\n    ]\n  ],\n  \
internalEdgeData\n];\n\nattachVertexStructures[diag_, model_] := Module[\n  {\
\n    graph,\n    extMap,\n    internalEdgeData,\n    internalEdgeLabels,\n   \
 internalVerts,\n    leafVerts,\n    internalEdgeIndices,\n    \
incidentLegData,\n    vertexStructures,\n    propagatorData,\n    \
particleMassRules\n  },\n  \n  graph = diag[\"Graph\"];\n  extMap = \
diag[\"ExternalAssignment\"];\n  internalEdgeData = \
diag[\"InternalEdgeData\"];\n  internalEdgeLabels = diag[\"InternalEdgeLabels\
\"];\n  internalVerts = diag[\"InternalVertices\"];\n  leafVerts = \
diag[\"LeafVertices\"];\n  particleMassRules = \
particleMassRulesFromModel[model];\n  \n  internalEdgeIndices = \
internalEdgeIndexLabels[graph, leafVerts, extMap];\n  \n  incidentLegData = \
diagramIncidentLegData[\n    graph,\n    internalVerts,\n    extMap,\n    \
internalEdgeLabels,\n    internalEdgeIndices\n  ];\n  \n  vertexStructures = \
AssociationMap[\n    vertexStructureInstances[\n      graph,\n      #,\n      \
extMap,\n      internalEdgeLabels,\n      internalEdgeIndices,\n      model\n \
   ] &,\n    internalVerts\n  ];\n  \n  propagatorData = \
internalPropagatorData[\n    graph,\n    internalEdgeData,\n    \
internalEdgeIndices,\n    particleMassRules\n  ];\n  \n  If[\n    \
AllTrue[Values[vertexStructures], Length[#] > 0 &],\n    Join[\n      diag,\n \
     <|\n        \"InternalEdgeIndices\" -> internalEdgeIndices,\n        \
\"IncidentLegData\" -> incidentLegData,\n        \"VertexStructures\" -> \
vertexStructures,\n        \"Propagators\" -> propagatorData\n      |>\n    \
],\n    Nothing\n  ]\n];\n\nspinorVarianceAtEndpoint[diag_, edge_, vertex_] \
:= Which[\n  vertex === diag[\"InternalEdgeOrientation\"][edge, \
\"ParticleVertex\"],\n  \"Upper\",\n  \n  vertex === \
diag[\"InternalEdgeOrientation\"][edge, \"AntiparticleVertex\"],\n  \
\"Lower\",\n  \n  True,\n  Missing[\"InvalidVertex\", {edge, vertex}]\n];\n\n\
symmetrizeIndices[expr_, inds_List] := Module[\n  {perms},\n  perms = \
Permutations[inds];\n  Total[(expr /. Thread[inds -> #]) & /@ perms] / \
Length[perms]\n];\n\nedgeSpinMultiplicity[diag_, edge_] := Module[\n  \
{vertices},\n  \n  vertices = Keys[diag[\"InternalEdgeIndices\"][edge]];\n  \n\
  Max[\n    1,\n    Sequence @@ Table[\n      Count[\n        Cases[\n        \
  Lookup[Last[diag[\"VertexStructures\"][vertex]], \"Expression\", 1],\n      \
    Spinor[\"Spin\", _, diag[\"InternalEdgeIndices\"][edge][vertex]],\n       \
   Infinity\n        ],\n        _\n      ],\n      {vertex, vertices}\n    ]\
\n  ]\n];\n\nedgeSpinIndexData[diag_] := Module[\n  {edges, multiplicities, \
starts},\n  \n  edges = Keys[diag[\"InternalEdgeLabels\"]];\n  multiplicities \
= edgeSpinMultiplicity[diag, #] & /@ edges;\n  starts = Most @ FoldList[Plus, \
1, multiplicities];\n  \n  AssociationThread[\n    edges,\n    MapThread[\n   \
   Array[Symbol[\"i\" <> ToString[#]] &, #1, #2] &,\n      {multiplicities, \
starts}\n    ]\n  ]\n];\n\nmakeVertexSpinIndicesExplicit[\n  \
vertexStructure_Association,\n  vertex_,\n  diag_,\n  \
edgeIndexData_Association\n] := Module[\n  {\n    expr,\n    incidentLegs,\n  \
  spinorData,\n    grouped,\n    replacementRules,\n    newExpr\n  },\n  \n  \
expr = vertexStructure[\"Expression\"];\n  incidentLegs = \
diag[\"IncidentLegData\"][vertex];\n  \n  spinorData = DeleteCases[\n    \
Cases[\n      expr,\n      s : Spinor[\"Spin\", sa_, mp_Multiparticle] :> \
Module[\n        {leg},\n        leg = SelectFirst[\n          incidentLegs,\n\
          #[\"Kind\"] === \"Internal\" && #[\"Index\"] === mp &\n        ];\n \
       \n        If[\n          MissingQ[leg],\n          Nothing,\n          \
<|\n            \"Spinor\" -> s,\n            \"SpinType\" -> sa,\n           \
 \"Multiparticle\" -> mp,\n            \"Edge\" -> leg[\"Source\"]\n          \
|>\n        ]\n      ],\n      Infinity\n    ],\n    Nothing\n  ];\n  \n  \
If[spinorData === {}, Return[vertexStructure]];\n  \n  grouped = \
GroupBy[spinorData, #Edge &];\n  \n  replacementRules = Flatten @ \
KeyValueMap[\n    Function[{edge, items},\n      Module[{inds, variance},\n   \
     inds = Take[edgeIndexData[edge], Length[items]];\n        variance = \
spinorVarianceAtEndpoint[diag, edge, vertex];\n        \n        MapThread[\n \
         #1[\"Spinor\"] :> \n            Spinor[\"Spin\", variance, \
#1[\"SpinType\"], #1[\"Multiparticle\"], #2] &,\n          {items, inds}\n    \
    ]\n      ]\n    ],\n    grouped\n  ];\n  \n  newExpr = expr /. \
replacementRules;\n  \n  newExpr = Fold[\n    Function[{currentExpr, edge},\n \
     If[\n        Length[grouped[edge]] > 1,\n        symmetrizeIndices[\n    \
      currentExpr,\n          Take[edgeIndexData[edge], \
Length[grouped[edge]]]\n        ],\n        currentExpr\n      ]\n    ],\n    \
newExpr,\n    Keys[grouped]\n  ];\n  \n  Join[vertexStructure, <|\"Expression\
\" -> newExpr|>]\n];\n\nmakeDiagramSpinIndicesExplicit[diag_] := Module[\n  \
{edgeIndexData, newVertexStructures},\n  \n  edgeIndexData = \
edgeSpinIndexData[diag];\n  \n  newVertexStructures = Association @ \
KeyValueMap[\n    Function[{vertex, structures},\n      vertex -> Replace[\n  \
      structures,\n        {\n          {} :> {},\n          list_List :> \
ReplacePart[\n            list,\n            -1 -> \
makeVertexSpinIndicesExplicit[\n              Last[list],\n              \
vertex,\n              diag,\n              edgeIndexData\n            ]\n    \
      ]\n        }\n      ]\n    ],\n    diag[\"VertexStructures\"]\n  ];\n  \
\n  Join[\n    diag,\n    <|\n      \"VertexStructures\" -> \
newVertexStructures,\n      \"SpinIndices\" -> edgeIndexData\n    |>\n  ]\n];\
\n\ndiagramAmplitude[diag_] := Module[\n  {processed, vertexFactors, \
propagatorFactors},\n  \n  processed = makeDiagramSpinIndicesExplicit[diag];\n\
  \n  vertexFactors = Replace[\n    Values[processed[\"VertexStructures\"]],\n\
    {\n      {} :> 1,\n      list_List :> Lookup[Last[list], \"Expression\", \
1]\n    },\n    1\n  ];\n  \n  propagatorFactors = Lookup[\n    \
Values[processed[\"Propagators\"]],\n    \"Factor\",\n    1\n  ];\n  \n  \
Times @@ Join[vertexFactors, propagatorFactors] / I\n];\n\n\
diagramAmplitudes[diags_List] := diagramAmplitude /@ diags\n```\n\nYou should \
also keep your current ``CreateDiagrams`` definition that calls \
``decorateTopology`` and then ``attachVertexStructures``, because these \
updated functions are compatible with that workflow.\n\nThen use:\n\n```wl\n\
diags = CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", sm];\n\
diagramAmplitude[diags[[1]]]\n```\n\nand for all diagrams:\n\n```wl\n\
diagramAmplitudes[diags]\n```\n\nIf you want, next I can give you a companion \
