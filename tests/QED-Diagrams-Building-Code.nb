            RowBox[{"4", "->", "1"}]}], "|>"}], ",", "5"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"leafVerts", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "skeleton", "]"}], ",", 
         RowBox[{
          RowBox[{
