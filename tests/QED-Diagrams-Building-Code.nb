           RowBox[{"g", ",", "degree3Vertex"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"VertexDegree", "[", 
             RowBox[{"g", ",", "#"}], "]"}], ">", "1"}], " ", "&"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"externalMap", "=", 
