    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"antiParticleRules", "=", 
      RowBox[{"antiParticleRulesFromModel", "[", "model", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{"valences", "=", 
