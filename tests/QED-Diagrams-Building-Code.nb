  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"validParticles", ",", "incidentLegs", ",", "candidateRows"}], 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"validParticles", "=", 
      RowBox[{"particleNames", "[", "model", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{"incidentLegs", "=", 
      RowBox[{"vertexIncidentLegData", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
