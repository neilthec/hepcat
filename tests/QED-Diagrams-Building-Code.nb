      "\[IndentingNewLine]", "\t  ", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"expr", " ", "/.", " ", 
            RowBox[{"Thread", "[", 
