                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"AntiparticleVertex\"", "->", "v"}]}], 
                    "\[IndentingNewLine]", "\t        ", "|>"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    "\[IndentingNewLine]", "\t        ", 
