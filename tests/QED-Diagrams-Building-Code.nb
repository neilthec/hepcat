Cell[BoxData[
 RowBox[{
  RowBox[{"vertexStructureInstances", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "graph_", ",", "\[IndentingNewLine]", "  ", "vertex_", ",", 
    "\[IndentingNewLine]", "  ", "externalMap_Association", ",", 
    "\[IndentingNewLine]", "  ", "internalEdgeLabels_Association", ",", 
    "\[IndentingNewLine]", "  ", "internalEdgeIndices_Association", ",", 
