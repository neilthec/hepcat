     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"g", "=", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"makeTopologySkeletons", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"3", "->", "1"}], ",", 
             RowBox[{"4", "->", "1"}]}], "|>"}], ",", "5"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "   ", "degree3Vertex", ",", 
