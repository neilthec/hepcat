                    RowBox[{"\"\<SlotRules\>\"", "->", "rules"}], ",", 
                    "\[IndentingNewLine]", "                ", 
                    RowBox[{"\"\<Expression\>\"", "->", "expr"}]}], 
                   "\[IndentingNewLine]", "              ", "|>"}]}]}], 
                "\[IndentingNewLine]", "            ", "]"}]}], 
              "\[IndentingNewLine]", "          ", "]"}], ",", 
             "\[IndentingNewLine]", "          ", 
