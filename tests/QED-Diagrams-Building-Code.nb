           "|>"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}], ";", 
      "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"canonicalDiagram", "[", "diag1", "]"}], "===", 
       RowBox[{"canonicalDiagram", "[", "diag2", "]"}]}]}]}], 
    "\[IndentingNewLine]", " ", "]"}], ",", "\[IndentingNewLine]", " ", 
