 RowBox[{
  RowBox[{"vertexIncidentParticles", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "graph_", ",", "\[IndentingNewLine]", "  ", "vertex_", ",", 
    "\[IndentingNewLine]", "  ", "externalMap_Association", ",", 
