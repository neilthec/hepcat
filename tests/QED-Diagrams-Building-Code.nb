      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"428e3578-a063-4a05-9d59-13e086dbd684"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Then amplitude construction becomes trivial\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d56281eb-f456-4920-85df-b0ac9b88cbec"],
 "\nNow define particle/antiparticle end lookup by using ",
 Cell[BoxData[
  TemplateBox[{
    Cell["InternalEdgeData", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "8939d051-1e36-4075-8eff-cf4bfcb08c8b"],
 ": \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"spinorVarianceAtEndpoint", "[", 
          RowBox[{"diag_", ",", "edge_", ",", "vertex_"}], "]"}], ":=", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
          RowBox[{
            RowBox[{"{", "edgeData", "}"}], ",", "\[IndentingNewLine]", 
            "\t  ", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"edgeData", "=", 
                RowBox[{
                  RowBox[{"diag", "[", "\"InternalEdgeData\"", "]"}], "[", 
                  "edge", "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
              "\[IndentingNewLine]", "\t  ", 
              RowBox[{"Which", "[", "\[IndentingNewLine]", "\t    ", 
                RowBox[{
                  RowBox[{"vertex", "===", 
                    RowBox[{"edgeData", "[", "\"ParticleVertex\"", "]"}]}], 
                  ",", "\"Upper\"", ",", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{"vertex", "===", 
                    
                    RowBox[{
                    "edgeData", "[", "\"AntiparticleVertex\"", "]"}]}], ",", 
                  "\"Lower\"", ",", "\[IndentingNewLine]", "\t    ", "True", 
                  ",", 
                  RowBox[{"Missing", "[", "\"InvalidVertex\"", "]"}]}], 
                "\[IndentingNewLine]", "\t  ", "]"}]}]}], 
          "\[IndentingNewLine]", "\t", "]"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "a1dfa69b-d9bb-43f6-ac48-1d463eda5819"],
 "\nThat is robust and completely avoids guessing. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
