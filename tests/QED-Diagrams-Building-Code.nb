      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"705ea36b-f53e-49b2-ab11-1dc12ef1c4a8"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Likely dominant cost in your example\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"12a21cf5-9abc-4ba3-8ab6-ee3a27d8c26a"],
 "\nFor: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"CreateDiagrams", "[", 
        RowBox[{
         "\"e\"", ",", "\"E\"", ",", "\"A.+\"", ",", "\"A.+\"", ",", 
          "\"A.+\"", ",", "sm"}], "]"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "96cc9947-98e5-49fe-9890-eb97ca0467d7"],
 "\nthe likely cost order is:\n\n1. external assignment permutations,\n2. \
internal assignment generation plus repeated vertex matching,\n3. repeated \
connected-component computation,\n4. duplicate elimination by full \
signatures.\n\nThe fact that you still get only ",
 Cell[BoxData[
  TemplateBox[{
    Cell["6", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "452c1528-7a6a-42c0-8ea4-646fb60f5cd9"],
 " final diagrams after ",
 Cell[BoxData[
  TemplateBox[{
    Cell["500", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "9628c8a3-b652-4338-90bf-0a3ff2710dc2"],
 " seconds is exactly the symptom of \[OpenCurlyDoubleQuote]huge search tree, \
tiny answer set.\[CloseCurlyDoubleQuote] \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"a7efdf87-2d3a-47e7-8681-887ff461c24a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Recommendation\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"46f4ad16-7060-495a-9316-5440e4aab89d"],
 "\nIf your goal is practical performance, I would strongly recommend \
rewriting generation as:\n\n1. generate nonisomorphic tree topologies for the \
external multiplicity,\n2. for each topology, assign external particles ",
 StyleBox["modulo automorphisms",
  FontWeight->Bold],
 ",\n3. recursively assign internal lines one edge/vertex at a time using \
model constraints,\n4. build vertex expressions only after a full consistent \
assignment exists.\n\nThat will be dramatically faster than your current \
decorate-everything approach.\n\nIf you want, I can help you with the next \
step in a concrete way and provide either:\n\n1. a ",
 StyleBox["drop-in optimized version",
  FontWeight->Bold],
 " of your current code with memoization and reduced permutations, or  \n2. a \
",
 StyleBox["more serious rewrite",
  FontWeight->Bold],
 " using recursive constraint propagation for internal line assignment.\n\nIf \
you want maximum speedup, I\[CloseCurlyQuote]d suggest option 2."
}], "ChatOutput",
 TaggingRules-><|
  "CellToStringData" -> 
   "Yes \[LongDash] the main bottleneck is combinatorics, not graph drawing.\n\
\nYour current pipeline does several expensive things:\n\n1. generates \
topology skeletons via **all permutations** of a Pr\[UDoubleDot]fer multiset,\
\n2. generates external assignments via **all permutations** of tagged \
externals,\n3. generates internal labelings via **all tuples** of particle \
choices,\n4. then removes duplicates only **after** constructing full \
decorated diagrams,\n5. and repeatedly recomputes expensive structural data \
like connected components and vertex matches.\n\nThat is why ``2 \\to 3`` \
already jumps to hundreds of seconds.\n\n## Where the blowup is\n\nThe worst \
offenders are:\n\n### 1. ``makeTopologySkeletons``\nThis line is brutal:\n\n\
```wl\npruferSeqs = Union[Permutations[pruferMultiset]];\n```\n\nEven with \
repeated elements, this is factorial growth.\n\n### 2. \
``externalAssignments``\nThis also does a factorial enumeration:\n\n```wl\n\
DeleteDuplicates[Permutations[tagParticles[externalParticles]]]\n```\n\nFor \
identical photons this is still large, and you're doing it for every \
topology.\n\n### 3. ``vertexStructureInstances``\nFor each candidate model \
row, you do:\n\n```wl\nPermutations[incidentLegs]\n```\n\nThat is another \
local factorial at every vertex.\n\n### 4. ``internalEdgeIndexLabels``\nFor \
each internal edge, you do:\n\n```wl\nConnectedComponents[EdgeDelete[graph, \
edge]]\n```\n\nThat is expensive and repeated many times across assignments.\n\
\n### 5. canonicalization only at the end\nYou allow many equivalent \
assignments to survive deep into the pipeline.\n\n---\n\n# Big-picture fix\n\n\
MadGraph is fast because it does **constraint-driven generation**, not \
brute-force decorate-and-deduplicate.\n\nYou want to move toward:\n\n- \
generate only a tiny set of nonisomorphic topologies,\n- assign externals in \
symmetry-reduced fashion,\n- propagate allowed internal particles by vertex \
constraints,\n- avoid ``Permutations`` whenever matching can be done by \
indexed lookup,\n- cache everything topology-dependent,\n- canonicalize \
early.\n\n---\n\n# Highest-impact changes\n\n## 1. Replace Pr\[UDoubleDot]fer \
multiset permutation generation\n\nFor tree topologies with prescribed \
degrees, Pr\[UDoubleDot]fer decoding is mathematically fine, but enumerating \
all multiset permutations is too expensive.\n\nFor your use case, the number \
of internal vertices is usually small. Better approaches:\n\n- build trees \
recursively by attaching leaves/internal vertices under degree constraints,\n\
- or generate unlabeled trees with given degree sequence directly,\n- or at \
minimum, generate labeled trees and quotient by isomorphism \
**incrementally**, not after ``Permutations``.\n\nIf you want a simple \
improvement without redesign, memoize by degree sequence and canonical graph:\
\n\n```wl\nClearAll[makeTopologySkeletons]\n\n\
makeTopologySkeletons[valenceCount_Association, nExternal_Integer] :=\n  \
makeTopologySkeletons[valenceCount, nExternal] =\n    Module[\n      {\n      \
  internalDegrees, nInternal, internalVerts, leafVerts,\n        allVerts, \
targetDegrees, pruferMultiset, pruferSeqs\n      },\n      internalDegrees = \
Flatten @ KeyValueMap[ConstantArray[#1, #2] &, valenceCount];\n      \
nInternal = Length[internalDegrees];\n      internalVerts = Range[nInternal];\
\n      leafVerts = Range[nInternal + 1, nInternal + nExternal];\n      \
allVerts = Join[internalVerts, leafVerts];\n      targetDegrees = \
Join[internalDegrees, ConstantArray[1, nExternal]];\n\n      \
If[Total[targetDegrees] =!= 2 Length[allVerts] - 2, Return[{}]];\n\n      \
pruferMultiset = Flatten @ MapThread[ConstantArray, {allVerts, targetDegrees \
- 1}];\n\n      pruferSeqs = DeleteDuplicates[Permutations[pruferMultiset]];\n\
\n      DeleteDuplicatesBy[\n        Graph[allVerts, \
EdgeList[pruferDecode[#]]] & /@ pruferSeqs,\n        CanonicalGraph\n      ]\n\
    ];\n```\n\nBut this only helps repeated calls. The real fix is to stop \
using full Pr\[UDoubleDot]fer multiset permutations.\n\n---\n\n## 2. \
Precompute topology metadata once per skeleton\n\nA lot of your work depends \
only on the graph topology, not on particle labels.\n\nFor each graph, \
precompute:\n\n- ``leafVerts``\n- ``internalVerts``\n- ``internalEdges``\n- \
for each internal edge and endpoint, the leaf set on the opposite side\n- \
adjacency structure for internal vertices\n- automorphism group of the \
topology\n\nThis avoids recomputing connected components repeatedly.\n\nFor \
example:\n\n```wl\nClearAll[topologyData]\n\ntopologyData[graph_] := \
topologyData[graph] =\n  Module[\n    {leafVerts, internalVerts, \
internalEdges, splitLeafIndices},\n    leafVerts = Select[VertexList[graph], \
VertexDegree[graph, #] == 1 &];\n    internalVerts = \
Complement[VertexList[graph], leafVerts];\n    internalEdges = Select[\n      \
EdgeList[graph],\n      FreeQ[leafVerts, Alternatives @@ (List @@ #)] &\n    \
];\n\n    splitLeafIndices = Association @ Map[\n      Function[edge,\n       \
 Module[{u, v, comps, compU, compV},\n          {u, v} = List @@ edge;\n      \
    comps = ConnectedComponents[EdgeDelete[graph, edge]];\n          compU = \
SelectFirst[comps, MemberQ[#, u] &];\n          compV = SelectFirst[comps, \
MemberQ[#, v] &];\n          edge -> <|\n            u -> Intersection[compV, \
leafVerts],\n            v -> Intersection[compU, leafVerts]\n          |>\n  \
      ]\n      ],\n      internalEdges\n    ];\n\n    <|\n      \
\"LeafVertices\" -> leafVerts,\n      \"InternalVertices\" -> internalVerts,\n\
      \"InternalEdges\" -> internalEdges,\n      \"SplitLeafVertices\" -> \
splitLeafIndices\n    |>\n  ];\n```\n\nThen ``internalEdgeIndexLabels`` \
becomes cheap:\n\n```wl\nClearAll[internalEdgeIndexLabels]\n\n\
internalEdgeIndexLabels[graph_, externalMap_Association] := Module[\n  {data, \
splitLeafVertices},\n  data = topologyData[graph];\n  splitLeafVertices = \
data[\"SplitLeafVertices\"];\n\n  Association @ KeyValueMap[\n    \
Function[{edge, sideData},\n      edge -> Association @ KeyValueMap[\n        \
Function[{v, leaves},\n          v -> Apply[\n            Multiparticle,\n    \
        Sort[Lookup[externalMap /@ leaves, \"InputIndex\"]]\n          ]\n    \
    ],\n        sideData\n      ]\n    ],\n    splitLeafVertices\n  ]\n]\n```\
\n\nThis removes repeated calls to \
[ConnectedComponents](paclet:ref/ConnectedComponents).\n\n---\n\n## 3. Stop \
permuting incident legs at each vertex\n\nThis is a major inefficiency:\n\n\
```wl\nSelect[Permutations[incidentLegs], rowParticles === #[[All, \"Particle\
\"]] &]\n```\n\nYou do not need all permutations. You only need permutations \
consistent with repeated particle slots of a model row.\n\nA faster approach \
is:\n\n- group incident legs by particle type,\n- group row slots by particle \
type,\n- assign only within matching groups,\n- take product across particle \
groups.\n\nHere is a much faster replacement idea:\n\n```wl\n\
ClearAll[vertexRowMatches]\n\nvertexRowMatches[incidentLegs_List, row_, \
validParticles_List] := Module[\n  {rowParticles, legGroups, rowPositions, \
assignmentsPerParticle},\n  rowParticles = modelRowParticles[row, \
validParticles];\n\n  If[Length[rowParticles] =!= Length[incidentLegs], \
Return[{}]];\n  If[Sort[rowParticles] =!= Sort[incidentLegs[[All, \
\"Particle\"]]], Return[{}]];\n\n  legGroups = GroupBy[incidentLegs, \
#[\"Particle\"] &];\n  rowPositions = GroupBy[Range[Length[rowParticles]], \
rowParticles[[#]] &];\n\n  assignmentsPerParticle =\n    KeyValueMap[\n      \
Function[{particle, positions},\n        Thread[positions -> #] & /@ \
Permutations[legGroups[particle]]\n      ],\n      rowPositions\n    ];\n\n  \
Map[\n    Function[rules,\n      ReplacePart[ConstantArray[None, \
Length[rowParticles]], Flatten[rules]]\n    ],\n    \
Tuples[assignmentsPerParticle]\n  ]\n]\n```\n\nThis still uses permutations, \
but only within equal-particle groups rather than across the whole vertex. \
For many realistic vertices this is much smaller.\n\n---\n\n## 4. Filter \
internal edge assignments by vertex compatibility immediately\n\nRight now \
``internalEdgeAssignments`` generates all internal particle/orientation \
choices before checking whether any vertex can use them.\n\nInstead, for each \
internal edge, derive allowed particles from the adjacent vertex \
possibilities.\n\nFor a given topology and external assignment:\n\n1. compute \
each internal vertex\[CloseCurlyQuote]s required multiset patterns from the \
model,\n2. infer which internal particles can appear on each adjacent \
internal edge,\n3. intersect constraints from both ends of an internal edge,\n\
4. backtrack only over surviving possibilities.\n\nThis is the single biggest \
algorithmic shift.\n\nInstead of:\n\n```wl\nedgeAssignments = \
internalEdgeAssignments[internalEdges, particleTypes, antiParticleRules];\n\
```\n\nyou want a recursive constraint solver.\n\nPseudo-structure:\n\n```wl\n\
assignInternalEdges[graph_, extMap_, model_, antiRules_] := Module[\n  \
{internalEdges, domains, solutions = {}},\n\n  domains = \
initialDomainsFromVertexConstraints[graph, extMap, model, antiRules];\n\n  \
backtrack[currentDomains_, assigned_] := Module[\n    {edge, choices, \
newState},\n    If[allAssignedQ[currentDomains],\n      AppendTo[solutions, \
assigned],\n      edge = chooseMostConstrainedEdge[currentDomains];\n      \
choices = currentDomains[edge];\n      Do[\n        newState = \
propagateChoice[edge, choice, currentDomains, assigned];\n        If[newState \
=!= $Failed,\n          backtrack[newState[[1]], newState[[2]]]\n        ],\n \
       {choice, choices}\n      ]\n    ]\n  ];\n\n  backtrack[domains, <||>];\
\n  solutions\n]\n```\n\nThis is much closer to what fast diagram generators \
do.\n\n---\n\n## 5. Canonicalize external assignments before deep decoration\n\
\nWhen externals include repeated particles like \
``{\"A.+\",\"A.+\",\"A.+\"}``, many leaf assignments are graph-automorphism \
equivalent.\n\nInstead of all permutations of tagged particles over leaves, \
quotient by the automorphism group of the topology.\n\nYou already compute \
automorphisms in ``canonicalDiagram``. Use them earlier.\n\nA practical quick \
fix:\n\n```wl\nClearAll[externalAssignmentsReduced]\n\n\
externalAssignmentsReduced[graph_, externalParticles_List] := Module[\n  \
{leafVerts, raw, canonicalize},\n  leafVerts = Select[VertexList[graph], \
VertexDegree[graph, #] == 1 &];\n  raw = AssociationThread[leafVerts, #] & /@ \
DeleteDuplicates[Permutations[tagParticles[externalParticles]]];\n\n  \
canonicalize[extMap_] := First @ SortBy[\n    Map[\n      Function[iso,\n     \
   KeySort @ Association @ KeyValueMap[(iso[#1] -> #2) &, extMap]\n      ],\n \
     Association /@ (Normal /@ FindGraphIsomorphism[graph, graph, All])\n    \
],\n    ToString[InputForm[#]] &\n  ];\n\n  DeleteDuplicatesBy[raw, \
canonicalize]\n]\n```\n\nThen use this instead of ``externalAssignments``.\n\n\
For repeated bosons this can reduce work a lot.\n\n---\n\n## 6. Replace \
string-based canonicalization keys\n\nThis is slow:\n\n```wl\nSortBy[..., \
ToString[InputForm[#]] &]\n```\n\nPrefer structural keys such as \
[OrderedQ](paclet:ref/OrderedQ), [Sort](paclet:ref/Sort), \
[CanonicalGraph](paclet:ref/CanonicalGraph), or explicit normalized \
associations/lists.\n\nFor example, instead of stringifying whole structures:\
\n\n```wl\ncanonicalVertexInstance[vs_] := {\n  SortBy[\n    \
vs[\"IncidentLegs\"][[All, {\"Particle\", \"Index\", \"Kind\"}]],\n    \
{#Particle, #Kind, ToString[#Index, InputForm]} &\n  ],\n  \
HoldComplete[vs[\"Expression\"]]\n}\n```\n\nand then use direct structural \
comparison.\n\nEven better, define a compact signature using only what \
determines uniqueness.\n\n---\n\n# A concrete optimization plan\n\nIf you \
want the biggest speedup for the least rewrite effort, do these in order:\n\n\
## Step 1\nMemoize topology-dependent computations:\n\n- \
``makeTopologySkeletons``\n- ``topologyData``\n- ``canonicalDiagram`` or \
better the topology automorphisms\n- model-derived things:\n  - \
``particleNames[model]``\n  - ``modelVertices[model]``\n  - \
``vertexValences[model]``\n  - ``antiParticleRulesFromModel[model]``\n\n## \
Step 2\nReplace ``internalEdgeIndexLabels`` with a version that uses cached \
edge-split data.\n\n## Step 3\nReplace ``vertexRowMatches`` so it does not \
permute all incident legs.\n\n## Step 4\nReduce external assignments modulo \
graph automorphisms.\n\n## Step 5\nReplace brute-force \
``internalEdgeAssignments`` with backtracking + pruning.\n\nThat last step is \
where you'll go from \[OpenCurlyDoubleQuote]works\[CloseCurlyDoubleQuote] to \
\[OpenCurlyDoubleQuote]MadGraph-like.\[CloseCurlyDoubleQuote]\n\n---\n\n# A \
few immediate code-level memoizations\n\nThese are easy wins.\n\n```wl\n\
ClearAll[\n  particleNames, modelVertices, vertexValences,\n  \
antiParticleRulesFromModel\n];\n\nparticleNames[model_] := \
particleNames[model] =\n  DeleteDuplicates @ Flatten[model[[1, All, {2, \
3}]]];\n\nmodelVertices[model_] := modelVertices[model] =\n  \
Module[{validParticles},\n    validParticles = particleNames[model];\n    \
DeleteDuplicates[\n      Sort /@ Select[\n        vertexParticles[#, \
validParticles] & /@ model[[2]],\n        Length[#] >= 3 &\n      ]\n    ]\n  \
];\n\nvertexValences[model_] := vertexValences[model] =\n  \
DeleteDuplicates[Length /@ modelVertices[model]];\n\n\
antiParticleRulesFromModel[model_] := antiParticleRulesFromModel[model] =\n  \
Association @ Flatten[\n    model[[1, All, {2, 3}]] /. {particle_, \
antiParticle_} :> {\n      particle -> antiParticle,\n      antiParticle -> \
particle\n    },\n    1\n  ];\n```\n\n---\n\n# Why MadGraph is so much faster\
\n\nMadGraph does not:\n\n- enumerate all external permutations blindly,\n- \
enumerate all internal particle assignments blindly,\n- match vertices by \
trying all local permutations,\n- deduplicate only at the end.\n\nInstead it \
uses:\n\n- canonical topologies,\n- recursive construction from interaction \
rules,\n- immediate rejection of impossible partial assignments,\n- strong \
symmetry reduction,\n- process-specific pruning.\n\nSo your code is more of a \
brute-force verifier, while MadGraph is a constrained generator.\n\n---\n\n# \
Likely dominant cost in your example\n\nFor:\n\n```wl\nCreateDiagrams[\"e\", \
\"E\", \"A.+\", \"A.+\", \"A.+\", sm]\n```\n\nthe likely cost order is:\n\n1. \
external assignment permutations,\n2. internal assignment generation plus \
repeated vertex matching,\n3. repeated connected-component computation,\n4. \
duplicate elimination by full signatures.\n\nThe fact that you still get only \
``6`` final diagrams after ``500`` seconds is exactly the symptom of \
\[OpenCurlyDoubleQuote]huge search tree, tiny answer set.\
\[CloseCurlyDoubleQuote]\n\n---\n\n# Recommendation\n\nIf your goal is \
practical performance, I would strongly recommend rewriting generation as:\n\n\
1. generate nonisomorphic tree topologies for the external multiplicity,\n2. \
for each topology, assign external particles **modulo automorphisms**,\n3. \
recursively assign internal lines one edge/vertex at a time using model \
constraints,\n4. build vertex expressions only after a full consistent \
assignment exists.\n\nThat will be dramatically faster than your current \
decorate-everything approach.\n\nIf you want, I can help you with the next \
step in a concrete way and provide either:\n\n1. a **drop-in optimized \
version** of your current code with memoization and reduced permutations, or  \
\n2. a **more serious rewrite** using recursive constraint propagation for \
internal line assignment.\n\nIf you want maximum speedup, \
I\[CloseCurlyQuote]d suggest option 2.", "ChatData" -> 
   "OEM6eJztfdtyG0eWYF/\
cdgvTF9vTPdMzsTubBr1uUQ2ABHgTZUtrSqRsTksyLVDyOmCMWAQSQJlAFbqqQBJNcaN/\
