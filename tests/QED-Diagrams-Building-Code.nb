    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellLabel->
  "In[316]:=",ExpressionUUID->"9e28980a-bebb-435b-aa97-2b8c1a7ea5d2"],

Cell[TextData[{
 "Yes \[LongDash] the immediate problem is simple: your new definition is \n\
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"diagramAmplitude", "[", 
          RowBox[{"diag_", ",", "antiParticleRules_Association"}], "]"}], 
        ":=", "..."}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "e65b4d06-9dba-4a2f-9900-1e94045a80cd"],
 "\nbut you called it as \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"diagramAmplitude", "[", 
        RowBox[{"diags", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "81db5c6d-5a98-4040-810f-23236b28b6cd"],
 "\nwith only one argument. Because of that, ",
 Cell[BoxData[
  TemplateBox[{
    Cell["diagramAmplitude", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "e73e5dc3-79db-45c8-bf78-ec9ba472e18d"],
 " never evaluated, so ",
 StyleBox["processed", "TI"],
 " never became an association, and then things like ",
 Cell[BoxData[
  TemplateBox[{
    Cell["processed[\"VertexStructures\"]", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "523e9720-6240-40a2-b0e7-f5f73e2b98a6"],
 " remained symbolic, producing the ",
 Cell[BoxData[
  TemplateBox[{
    Cell["Values::invrl", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "9fa83034-c3ba-4c46-a527-66e3d3e84b49"],
 " cascade. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Immediate fix\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0d58043b-d9bb-4fdd-9e22-f06be45498d4"],
 "\nEither call it with the second argument: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"diagramAmplitude", "[", 
        RowBox[{
          RowBox[{"diags", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"antiParticleRulesFromModel", "[", "sm", "]"}]}], "]"}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "2c5d26e3-0c39-4509-9330-08b8a9213fce"],
 "\nor define a one-argument wrapper: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
        RowBox[{"diagramAmplitude", "[", 
          RowBox[{"diag", ",", 
            RowBox[{"antiParticleRulesFromModel", "[", "sm", "]"}]}], 
          "]"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "d4bcbf08-1da4-43c9-9cc7-d2390f9aefde"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"f4ef6299-1586-4614-811d-3729e243b242"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"But there is also a structural issue\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"52e8c783-d042-49e6-8b41-ea83388953a1"],
 "\nYour current ",
 Cell[BoxData[
  TemplateBox[{
    Cell["spinorVarianceAtEndpoint", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "50c4c334-f334-412f-9a7d-b5320001c84d"],
 " logic can\[CloseCurlyQuote]t really distinguish particle end vs \
antiparticle end robustly just from \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"Lookup", "[", 
          RowBox[{"antiParticleRules", ",", "endpointParticle"}], "]"}], 
        "===", "oppositeParticle"}]], "ChatCode", "Input", LanguageCategory -> 
     "Input", ShowAutoStyles -> True, ShowStringCharacters -> True, 
     ShowSyntaxStyles -> True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "143994a1-ac26-4989-b75d-7ef7a6f58113"],
 "\nbecause for a pair like ",
 Cell[BoxData["\"\<e\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "5fb8c403-e8b6-4da7-94dc-3d597d97cadc"],
 " and ",
 Cell[BoxData["\"\<E\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "f7397b2b-9361-4f8e-8933-53f0fdf69f56"],
 ", both directions are true in the inverse sense. What you really want is \
simpler: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "for each internal edge, pick the propagating particle from ",
  Cell[BoxData[
   TemplateBox[{
     Cell["diag[\"Propagators\"][edge, \"Particle\"]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "08399f61-c0ea-436f-9f6f-db690f3c6114"]
 }], "InlineItem",ExpressionUUID->"fa4fb6f8-c0dc-48ed-bee1-06a0dcc278a1"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "at the endpoint where ",
  Cell[BoxData[
   TemplateBox[{
     Cell["diag[\"InternalEdgeLabels\"][edge][vertex]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "5b67e6a4-d1a9-4539-a07c-ca4183f8f4af"],
  " equals that particle, use ",
  Cell[BoxData["\"\<Upper\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "528c9e69-f6fd-4cfb-918b-a545c021d237"]
 }], "InlineItem",ExpressionUUID->"88978413-041c-4f55-9693-cccfca5f6938"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "at the other endpoint, use ",
  Cell[BoxData["\"\<Lower\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "97eed690-55f8-49e6-a8f0-fad9f9af8cab"]
 }], "InlineItem",ExpressionUUID->"d58300ee-e07e-42a6-a4f3-7858b641d8c2"],
 "\nThat directly matches your statement: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "particle end ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Rule]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\to", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "3140bf24-8917-4587-83cc-3438450c8e05"],
  " upper"
 }], "InlineItem",ExpressionUUID->"aadcf22f-6b5c-4acd-a833-ea1f3afc6272"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "antiparticle end ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Rule]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\to", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "bf03b722-78c4-4872-a76a-d900b9a600eb"],
  " lower"
 }], "InlineItem",ExpressionUUID->"b705f73a-4e56-4b5d-bdfa-e3e245c49066"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"37281b31-194a-41ed-9b57-44d870a793a8"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Cleaner corrected version\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"316e65c2-ec5b-4807-8690-a2b2931a5be5"],
 "\nReplace your spin-index code with this: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "\t  ", 
          
          RowBox[{"spinorVarianceAtEndpoint", ",", "\[IndentingNewLine]", 
            "\t  ", "symmetrizeIndices", ",", "\[IndentingNewLine]", "\t  ", 
            "edgeSpinMultiplicity", ",", "\[IndentingNewLine]", "\t  ", 
            "edgeSpinIndexData", ",", "\[IndentingNewLine]", "\t  ", 
            "makeVertexSpinIndicesExplicit", ",", "\[IndentingNewLine]", 
            "\t  ", "makeDiagramSpinIndicesExplicit", ",", 
            "\[IndentingNewLine]", "\t  ", "diagramAmplitude"}], 
          "\[IndentingNewLine]", "\t", "]"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"spinorVarianceAtEndpoint", "[", 
            RowBox[{"diag_", ",", "edge_", ",", "vertex_"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"propParticle", ",", "endpointParticle"}], "}"}], ",",
               "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"propParticle", "=", 
                  RowBox[{
                    RowBox[{"diag", "[", "\"Propagators\"", "]"}], "[", 
                    RowBox[{"edge", ",", "\"Particle\""}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", 
                RowBox[{"endpointParticle", "=", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"diag", "[", "\"InternalEdgeLabels\"", "]"}], "[",
                     "edge", "]"}], "[", "vertex", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{"endpointParticle", "===", "propParticle"}], ",", 
                    "\"Upper\"", ",", "\"Lower\""}], "]"}]}]}], 
            "\[IndentingNewLine]", "\t", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"symmetrizeIndices", "[", 
            RowBox[{"expr_", ",", "inds_List"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", "perms", "}"}], ",", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"perms", "=", 
                  RowBox[{"Permutations", "[", "inds", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", 
                RowBox[{
                  RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"expr", " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"inds", "->", "#"}], "]"}]}], ")"}], " ", "&"}], 
                    " ", "/@", " ", "perms"}], "]"}], "/", 
                  RowBox[{"Length", "[", "perms", "]"}]}]}]}], 
            "\[IndentingNewLine]", "\t", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"edgeSpinMultiplicity", "[", 
            RowBox[{"diag_", ",", "edge_"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", "vertices", "}"}], ",", "\[IndentingNewLine]", 
              "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"vertices", "=", 
                  RowBox[{"Keys", "[", 
                    RowBox[{
                    RowBox[{"diag", "[", "\"InternalEdgeIndices\"", "]"}], 
                    "[", "edge", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                "\t  ", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"Max", "[", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{"Cases", "[", "\[IndentingNewLine]", "\t      ", 
                    
                    RowBox[{
                    "vertices", ",", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"vertex_", ":>", 
                    RowBox[{"Count", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    
                    RowBox[{"Cases", "[", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", 
                    RowBox[{
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}], "[", 
                    "vertex", "]"}], "]"}], ",", "\"Expression\"", ",", "1"}],
                     "]"}], ",", "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "_", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"diag", "[", "\"InternalEdgeIndices\"", "]"}], 
                    "[", "edge", "]"}], "[", "vertex", "]"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", "\t          ", "Infinity"}], 
                    "\[IndentingNewLine]", "\t        ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t        ", "_"}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}], 
                  "\[IndentingNewLine]", "\t  ", "]"}]}]}], 
            "\[IndentingNewLine]", "\t", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"edgeSpinIndexData", "[", "diag_", "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"edges", ",", "multiplicities", ",", "starts"}], 
                "}"}], ",", "\[IndentingNewLine]", "\t  ", 
              "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"edges", "=", 
                  RowBox[{"Keys", "[", 
                    RowBox[{"diag", "[", "\"InternalEdgeLabels\"", "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"multiplicities", "=", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"edgeSpinMultiplicity", "[", 
                    RowBox[{"diag", ",", "#"}], "]"}], " ", "&"}], " ", "/@", 
                    " ", "edges"}]}], ";", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"starts", "=", 
                  RowBox[{"Most", " ", "@", " ", 
                    RowBox[{"FoldList", "[", 
                    RowBox[{"Plus", ",", "1", ",", "multiplicities"}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", "\t  ", 
                "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{
                 "AssociationThread", "[", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{"edges", ",", "\[IndentingNewLine]", "\t    ", 
                    
                    RowBox[{
                    "MapThread", "[", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Array", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Symbol", "[", 
                    RowBox[{"\"i\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "#", "]"}]}], "]"}], " ", "&"}], 
                    ",", "#1", ",", "#2"}], "]"}], " ", "&"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"{", 
                    RowBox[{"multiplicities", ",", "starts"}], "}"}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}]}], 
                  "\[IndentingNewLine]", "\t  ", "]"}]}]}], 
            "\[IndentingNewLine]", "\t", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          
          RowBox[{"makeVertexSpinIndicesExplicit", "[", "\[IndentingNewLine]",
             "\t  ", 
            
            RowBox[{"vertexStructure_Association", ",", "\[IndentingNewLine]",
               "\t  ", "vertex_", ",", "\[IndentingNewLine]", "\t  ", "diag_",
               ",", "\[IndentingNewLine]", "\t  ", 
              "edgeIndexData_Association"}], "\[IndentingNewLine]", "\t", 
            "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", "\t    ", 
                
                RowBox[{
                 "expr", ",", "incidentLegs", ",", "spinorData", ",", 
                  "grouped", ",", "replacementRules", ",", "newExpr"}], 
                "\[IndentingNewLine]", "\t  ", "}"}], ",", 
              "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"expr", "=", 
                  RowBox[{"vertexStructure", "[", "\"Expression\"", "]"}]}], 
                ";", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"incidentLegs", "=", 
                  RowBox[{
                    RowBox[{"diag", "[", "\"IncidentLegData\"", "]"}], "[", 
                    "vertex", "]"}]}], ";", "\[IndentingNewLine]", "\t  ", 
                "\[IndentingNewLine]", "\t  ", 
                RowBox[{"spinorData", "=", 
                  RowBox[{"Cases", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"expr", ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"s", " ", ":", " ", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "sa_", ",", "mp_Multiparticle"}],
                     "]"}]}], ":>", 
                    
                    RowBox[{
                    "Module", "[", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{"{", "leg", "}"}], ",", "\[IndentingNewLine]", 
                    "\t      ", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{"leg", "=", 
                    
                    RowBox[{"SelectFirst", "[", "\[IndentingNewLine]", 
                    "\t        ", 
                    
                    RowBox[{"incidentLegs", ",", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"Kind\"", "]"}], "===", 
                    "\"Internal\""}], "&&", 
                    RowBox[{
                    RowBox[{"#", "[", "\"Index\"", "]"}], "===", "mp"}]}], 
                    " ", "&"}]}], "\[IndentingNewLine]", "\t      ", "]"}]}], 
                    ";", "\[IndentingNewLine]", "\t      ", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"MissingQ", "[", "leg", "]"}], ",", 
                    "\[IndentingNewLine]", "\t        ", "Nothing", ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t          ", 
                    RowBox[{
                    RowBox[{"\"Spinor\"", "->", "s"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"SpinType\"", "->", "sa"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"Multiparticle\"", "->", "mp"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"Edge\"", "->", 
                    RowBox[{"leg", "[", "\"Source\"", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t        ", "|>"}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}]}], ",", 
                    "\[IndentingNewLine]", "\t    ", "Infinity"}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{"spinorData", "===", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"Return", "[", "vertexStructure", "]"}]}], "]"}], 
                ";", "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", 
                "\t  ", 
                RowBox[{"grouped", "=", 
                  RowBox[{"GroupBy", "[", 
                    RowBox[{"spinorData", ",", 
                    RowBox[{"#Edge", " ", "&"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"replacementRules", "=", 
                  RowBox[{"Flatten", " ", "@", " ", 
                    
                    RowBox[{
                    "KeyValueMap", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"edge", ",", "items"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    
                    RowBox[{"Module", "[", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"inds", ",", "variance"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"inds", "=", 
                    RowBox[{"edgeIndexData", "[", "edge", "]"}]}], ";", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"variance", "=", 
                    RowBox[{"spinorVarianceAtEndpoint", "[", 
                    RowBox[{"diag", ",", "edge", ",", "vertex"}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "\t        ", 
                    "\[IndentingNewLine]", "\t        ", 
                    
                    RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#1", "[", "\"Spinor\"", "]"}], ":>", 
                    RowBox[{"Spinor", "[", 
                    RowBox[{"\"Spin\"", ",", "variance", ",", 
                    RowBox[{"#1", "[", "\"SpinType\"", "]"}], ",", 
                    RowBox[{"#1", "[", "\"Multiparticle\"", "]"}], ",", 
                    "#2"}], "]"}]}], " ", "&"}], ",", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{"{", 
                    RowBox[{"items", ",", "inds"}], "}"}]}], 
                    "\[IndentingNewLine]", "\t        ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", "grouped"}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"newExpr", "=", 
                  RowBox[{"expr", " ", "/.", " ", "replacementRules"}]}], ";",
                 "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                RowBox[{"newExpr", "=", 
                  RowBox[{"Fold", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"currentExpr", ",", "edge"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"grouped", "[", "edge", "]"}], "]"}], ">", "1"}], 
                    ",", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"symmetrizeIndices", "[", 
                    RowBox[{"currentExpr", ",", 
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"edgeIndexData", "[", "edge", "]"}], ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"grouped", "[", "edge", "]"}], "]"}]}], "]"}]}], 
                    "]"}], ",", "\[IndentingNewLine]", "\t        ", 
                    "currentExpr"}], "\[IndentingNewLine]", "\t      ", 
                    "]"}]}], "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", "newExpr", ",", 
                    "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"Keys", "[", "grouped", "]"}]}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"Join", "[", 
                  RowBox[{"vertexStructure", ",", 
                    RowBox[{"<|", 
                    RowBox[{"\"Expression\"", "->", "newExpr"}], "|>"}]}], 
                  "]"}]}]}], "\[IndentingNewLine]", "\t", "]"}]}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"makeDiagramSpinIndicesExplicit", "[", "diag_", "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"edgeIndexData", ",", "newVertexStructures"}], "}"}], 
              ",", "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", 
              "\t  ", 
              RowBox[{
                RowBox[{"edgeIndexData", "=", 
                  RowBox[{"edgeSpinIndexData", "[", "diag", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"newVertexStructures", "=", 
                  RowBox[{"Association", " ", "@", " ", 
                    
                    RowBox[{
                    "KeyValueMap", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"vertex", ",", "structures"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"vertex", "->", 
                    
                    RowBox[{"Replace", "[", "\[IndentingNewLine]", 
                    "\t        ", 
                    
                    RowBox[{"structures", ",", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{"{", "\[IndentingNewLine]", "\t          ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", 
                    RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                    "\t          ", 
                    RowBox[{"list_List", ":>", 
                    
                    RowBox[{"ReplacePart", "[", "\[IndentingNewLine]", 
                    "\t            ", 
                    
                    RowBox[{"list", ",", "\[IndentingNewLine]", 
                    "\t            ", 
                    RowBox[{
                    RowBox[{"-", "1"}], "->", 
                    RowBox[{"makeVertexSpinIndicesExplicit", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", "vertex", ",", 
                    "diag", ",", "edgeIndexData"}], "]"}]}]}], 
                    "\[IndentingNewLine]", "\t          ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t        ", "}"}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"diag", "[", "\"VertexStructures\"", "]"}]}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"Join", "[", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{"diag", ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    
                    RowBox[{
                    "\"VertexStructures\"", "->", "newVertexStructures"}], 
                    ",", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"\"SpinIndices\"", "->", "edgeIndexData"}]}], 
                    "\[IndentingNewLine]", "\t    ", "|>"}]}], 
                  "\[IndentingNewLine]", "\t  ", "]"}]}]}], 
            "\[IndentingNewLine]", "\t", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"diagramAmplitude", "[", "diag_", "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"{", 
                
                RowBox[{
                 "processed", ",", "vertexFactors", ",", 
                  "propagatorFactors"}], "}"}], ",", "\[IndentingNewLine]", 
              "\t  ", "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{"processed", "=", 
                  
                  RowBox[{
                   "makeDiagramSpinIndicesExplicit", "[", "diag", "]"}]}], 
                ";", "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", 
                "\t  ", 
                RowBox[{"vertexFactors", "=", 
                  RowBox[{"Replace", "[", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"VertexStructures\"", "]"}], 
                    "]"}], ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"{", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "}"}], ":>", "1"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"list_List", ":>", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "list", "]"}], ",", "\"Expression\"",
                     ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", "\t    ", 
                    "}"}], ",", "\[IndentingNewLine]", "\t    ", "1"}], 
                    "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{"propagatorFactors", "=", 
                  RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"Values", "[", 
                    RowBox[{"processed", "[", "\"Propagators\"", "]"}], "]"}],
                     ",", "\"Factor\"", ",", "1"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
                
                RowBox[{
                  RowBox[{"Times", " ", "@@", " ", 
                    RowBox[{"Join", "[", 
                    RowBox[{"vertexFactors", ",", "propagatorFactors"}], 
                    "]"}]}], "/", "I"}]}]}], "\[IndentingNewLine]", "\t", 
            "]"}]}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
