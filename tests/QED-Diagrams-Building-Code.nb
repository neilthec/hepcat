            RowBox[{
             RowBox[{"3", "->", "1"}], ",", 
             RowBox[{"4", "->", "1"}]}], "|>"}], ",", "5"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "   ", "degree3Vertex", ",", 
