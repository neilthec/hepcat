Cell[CellGroupData[{

Cell["Just give me the complete updated functions.", "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellLabel->
  "In[319]:=",ExpressionUUID->"4fa38e87-871f-4e84-9233-a698d41ef1eb"],

Cell[TextData[{
 "Here are complete updated functions that add explicit particle/antiparticle \
endpoint tags to the diagram and then use them when constructing the \
amplitude.\n\nPaste these in as replacements. \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
            
            RowBox[{"internalEdgeAssignments", ",", "\[IndentingNewLine]", 
              "  ", "internalEdgeOrientationData", ",", "\[IndentingNewLine]",
               "  ", "decorateTopology", ",", "\[IndentingNewLine]", "  ", 
              "internalPropagatorData", ",", "\[IndentingNewLine]", "  ", 
              "attachVertexStructures", ",", "\[IndentingNewLine]", "  ", 
              "spinorVarianceAtEndpoint", ",", "\[IndentingNewLine]", "  ", 
              "symmetrizeIndices", ",", "\[IndentingNewLine]", "  ", 
              "edgeSpinMultiplicity", ",", "\[IndentingNewLine]", "  ", 
              "edgeSpinIndexData", ",", "\[IndentingNewLine]", "  ", 
              "makeVertexSpinIndicesExplicit", ",", "\[IndentingNewLine]", 
              "  ", "makeDiagramSpinIndicesExplicit", ",", 
              "\[IndentingNewLine]", "  ", "diagramAmplitude", ",", 
              "\[IndentingNewLine]", "  ", "diagramAmplitudes"}], 
            "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            
            RowBox[{"internalEdgeAssignments", "[", "\[IndentingNewLine]", 
              "  ", 
              
              RowBox[{"internalEdges_List", ",", "\[IndentingNewLine]", "  ", 
                "particleTypes_List", ",", "\[IndentingNewLine]", "  ", 
                "antiParticleRules_Association"}], "\[IndentingNewLine]", 
              "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "choicesPerEdge", "}"}], ",", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"choicesPerEdge", "=", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"edge", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"DeleteDuplicates", " ", "@", " ", 
                    RowBox[{"Flatten", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"Table", "[", "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"anti", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"antiParticleRules", ",", "particle", ",", 
                    RowBox[{"Missing", "[", "\"NotFound\"", "]"}]}], "]"}]}], 
                    "}"}], ",", "\[IndentingNewLine]", "          ", 
                    
                    RowBox[{"If", "[", "\[IndentingNewLine]", "            ", 
                    
                    RowBox[{
                    RowBox[{"MissingQ", "[", "anti", "]"}], ",", 
                    "\[IndentingNewLine]", "            ", 
                    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
                    "            ", 
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ends", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{"List", " ", "@@", " ", "edge"}], "]"}]}], "}"}], 
                    ",", "\[IndentingNewLine]", "              ", 
                    RowBox[{"{", "\[IndentingNewLine]", "                ", 
                    RowBox[{
                    RowBox[{"<|", "\[IndentingNewLine]", "                  ", 
                    RowBox[{
                    RowBox[{"\"EndpointLabels\"", "->", 
                    RowBox[{"AssociationThread", "[", 
                    RowBox[{"ends", ",", 
                    RowBox[{"{", 
                    RowBox[{"particle", ",", "anti"}], "}"}]}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"Particle\"", "->", "particle"}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"Antiparticle\"", "->", "anti"}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"ParticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"AntiparticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]",
                     "                ", "|>"}], ",", "\[IndentingNewLine]", 
                    "                ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "                  ", 
                    RowBox[{
                    RowBox[{"\"EndpointLabels\"", "->", 
                    RowBox[{"AssociationThread", "[", 
                    RowBox[{"ends", ",", 
                    RowBox[{"{", 
                    RowBox[{"anti", ",", "particle"}], "}"}]}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"Particle\"", "->", "particle"}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"Antiparticle\"", "->", "anti"}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"ParticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "                  ", 
                    RowBox[{"\"AntiparticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]",
                     "                ", "|>"}]}], "\[IndentingNewLine]", 
                    "              ", "}"}]}], "\[IndentingNewLine]", 
                    "            ", "]"}]}], "\[IndentingNewLine]", 
                    "          ", "]"}]}], "\[IndentingNewLine]", "        ", 
                    "]"}], ",", "\[IndentingNewLine]", "        ", 
                    RowBox[{"{", 
                    RowBox[{"particle", ",", "particleTypes"}], "}"}]}], 
                    "\[IndentingNewLine]", "      ", "]"}], ",", 
                    "\[IndentingNewLine]", "      ", "1"}], 
                    "\[IndentingNewLine]", "    ", "]"}]}]}], 
                    "\[IndentingNewLine]", "  ", "]"}], " ", "/@", " ", 
                    "internalEdges"}]}], ";", "\[IndentingNewLine]", "  ", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"AssociationThread", "[", 
                    RowBox[{"internalEdges", ",", "#"}], "]"}], " ", "&"}], 
                    " ", "/@", " ", 
                    RowBox[{"Tuples", "[", "choicesPerEdge", "]"}]}]}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            
            RowBox[{"internalEdgeOrientationData", "[", "\[IndentingNewLine]",
               "  ", "internalEdgeData_Association", "\[IndentingNewLine]", 
              "]"}], ":=", 
            RowBox[{"Association", " ", "@", " ", 
              RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"edge", ",", "data"}], "}"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"edge", "->", 
                    RowBox[{"KeyTake", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{"data", ",", "\[IndentingNewLine]", "      ", 
                    RowBox[{"{", 
                    
                    RowBox[{"\"Particle\"", ",", "\"Antiparticle\"", ",", 
                    "\"ParticleVertex\"", ",", "\"AntiparticleVertex\""}], 
                    "}"}]}], "\[IndentingNewLine]", "    ", "]"}]}]}], 
                    "\[IndentingNewLine]", "  ", "]"}], ",", 
                  "\[IndentingNewLine]", "  ", "internalEdgeData"}], 
                "\[IndentingNewLine]", "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"decorateTopology", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
               "graph_", ",", "\[IndentingNewLine]", "  ", 
                "externalParticles_List", ",", "\[IndentingNewLine]", "  ", 
                "model_", ",", "\[IndentingNewLine]", "  ", 
                "antiParticleRules_Association"}], "\[IndentingNewLine]", 
              "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  
                  RowBox[{
                   "particleTypes", ",", "\[IndentingNewLine]", "    ", 
                    "internalVerts", ",", "\[IndentingNewLine]", "    ", 
                    "leafVerts", ",", "\[IndentingNewLine]", "    ", 
                    "internalEdges", ",", "\[IndentingNewLine]", "    ", 
                    "extAssignments", ",", "\[IndentingNewLine]", "    ", 
                    "edgeAssignments"}], "\[IndentingNewLine]", "  ", "}"}], 
                ",", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"particleTypes", "=", 
                    RowBox[{"particleNames", "[", "model", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"internalVerts", "=", 
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"VertexList", "[", "graph", "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"VertexDegree", "[", 
                    RowBox[{"graph", ",", "#"}], "]"}], ">", "1"}], " ", 
                    "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{"leafVerts", "=", 
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"VertexList", "[", "graph", "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"VertexDegree", "[", 
                    RowBox[{"graph", ",", "#"}], "]"}], "==", "1"}], " ", 
                    "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"internalEdges", "=", 
                    RowBox[{"Select", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"EdgeList", "[", "graph", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"leafVerts", ",", 
                    RowBox[{"Alternatives", " ", "@@", " ", 
                    RowBox[{"(", 
                    RowBox[{"List", " ", "@@", " ", "#"}], ")"}]}]}], "]"}], 
                    " ", "&"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"extAssignments", "=", 
                    RowBox[{"externalAssignments", "[", 
                    RowBox[{"externalParticles", ",", "leafVerts"}], "]"}]}], 
                  ";", "\[IndentingNewLine]", "  ", 
