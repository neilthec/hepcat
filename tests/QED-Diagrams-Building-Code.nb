Cell[BoxData[
 RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "skeleton", ",", "leafVerts", ",", "extMap", ",", "internalEdges", ",", 
       "internalLabels", ",", "internalVerts", ",", "allowedVertices"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"skeleton", "=", 
