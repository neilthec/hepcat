       "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"candidateRows", "=", 
      RowBox[{"Select", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"model", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"modelRowParticles", "[", 
            RowBox[{"#", ",", "validParticles"}], "]"}], "]"}], "===", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Sort", "[", 
           RowBox[{"incidentLegs", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<Particle\>\""}], "]"}], "]"}], "]"}]}], 
         " ", "&"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
