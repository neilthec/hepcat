 RowBox[{
  RowBox[{"internalEdgeIndexLabels", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "graph_", ",", "\[IndentingNewLine]", "  ", "leafVerts_List", ",", 
    "\[IndentingNewLine]", "  ", "externalMap_Association"}], 
   "\[IndentingNewLine]", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", "internalEdges", "}"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"internalEdges", "=", 
      RowBox[{"Select", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"EdgeList", "[", "graph", "]"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"leafVerts", ",", 
           RowBox[{"Alternatives", " ", "@@", " ", 
            RowBox[{"(", 
             RowBox[{"List", " ", "@@", " ", "#"}], ")"}]}]}], "]"}], " ", 
         "&"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{"Association", " ", "@", " ", 
      RowBox[{"Map", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"edge", ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "u", ",", "v", ",", "comps", ",", "compU", ",", "compV", ",", 
              "leavesU", ",", "leavesV"}], "}"}], ",", "\[IndentingNewLine]", 
            "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"u", ",", "v"}], "}"}], "=", 
              RowBox[{"List", " ", "@@", " ", "edge"}]}], ";", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"comps", "=", 
              RowBox[{"ConnectedComponents", "[", 
               RowBox[{"EdgeDelete", "[", 
                RowBox[{"graph", ",", "edge"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"compU", "=", 
              RowBox[{"SelectFirst", "[", 
               RowBox[{"comps", ",", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"#", ",", "u"}], "]"}], " ", "&"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"compV", "=", 
              RowBox[{"SelectFirst", "[", 
               RowBox[{"comps", ",", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"#", ",", "v"}], "]"}], " ", "&"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", "        ", 
             RowBox[{"leavesU", "=", 
              RowBox[{"Sort", " ", "@", " ", 
               RowBox[{"Lookup", "[", "\[IndentingNewLine]", "          ", 
                RowBox[{
                 RowBox[{"externalMap", " ", "/@", " ", 
                  RowBox[{"Intersection", "[", 
                   RowBox[{"compU", ",", "leafVerts"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", "          ", "\"\<InputIndex\>\""}], 
                "\[IndentingNewLine]", "        ", "]"}]}]}], ";", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"leavesV", "=", 
              RowBox[{"Sort", " ", "@", " ", 
               RowBox[{"Lookup", "[", "\[IndentingNewLine]", "          ", 
                RowBox[{
                 RowBox[{"externalMap", " ", "/@", " ", 
                  RowBox[{"Intersection", "[", 
                   RowBox[{"compV", ",", "leafVerts"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", "          ", "\"\<InputIndex\>\""}], 
                "\[IndentingNewLine]", "        ", "]"}]}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", "        ", 
             RowBox[{"edge", "->", 
              RowBox[{"<|", "\[IndentingNewLine]", "          ", 
               RowBox[{
                RowBox[{"u", "->", 
                 RowBox[{"Apply", "[", 
                  RowBox[{"Multiparticle", ",", "leavesU"}], "]"}]}], ",", 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"v", "->", 
                 RowBox[{"Apply", "[", 
                  RowBox[{"Multiparticle", ",", "leavesV"}], "]"}]}]}], 
               "\[IndentingNewLine]", "        ", "|>"}]}]}]}], 
           "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
         "    ", "]"}], ",", "\[IndentingNewLine]", "    ", "internalEdges"}],
        "\[IndentingNewLine]", "  ", "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
