Cell[BoxData[
 RowBox[{
  RowBox[{"canonicalDiagram", "[", "diag_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"graph", ",", "automorphisms", ",", "representatives"}], "}"}], ",",
     "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
    RowBox[{
     RowBox[{"graph", "=", 
      RowBox[{"diag", "[", "\"\<Graph\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\t  ", 
     RowBox[{"automorphisms", "=", 
      RowBox[{"Normal", " ", "/@", " ", 
       RowBox[{"FindGraphIsomorphism", "[", 
        RowBox[{"graph", ",", "graph", ",", "All"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
     RowBox[{"representatives", "=", 
      RowBox[{"Map", "[", "\[IndentingNewLine]", "\t    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"ruleList", ",", "\[IndentingNewLine]", "\t      ", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "\t        ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"vertexRule", ",", "newExternal", ",", "newInternal"}], 
             "}"}], ",", "\[IndentingNewLine]", "\t        ", 
            "\[IndentingNewLine]", "\t        ", 
            RowBox[{
             RowBox[{"vertexRule", "=", 
              RowBox[{"Association", "[", "ruleList", "]"}]}], ";", 
             "\[IndentingNewLine]", "\t        ", "\[IndentingNewLine]", 
             "\t        ", 
             RowBox[{"newExternal", "=", 
              RowBox[{"KeySort", " ", "@", " ", 
               RowBox[{"Association", " ", "@", " ", 
                RowBox[{
                "KeyValueMap", "[", "\[IndentingNewLine]", "\t          ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"vertexRule", "[", "#1", "]"}], "->", "#2"}], " ",
                    "&"}], ",", "\[IndentingNewLine]", "\t          ", 
                  RowBox[{"diag", "[", "\"\<ExternalAssignment\>\"", "]"}]}], 
                 "\[IndentingNewLine]", "\t        ", "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", "\t        ", "\[IndentingNewLine]", 
             "\t        ", 
             RowBox[{"newInternal", "=", 
              RowBox[{"KeySort", " ", "@", " ", 
               RowBox[{"Association", " ", "@", " ", 
                RowBox[{
                "KeyValueMap", "[", "\[IndentingNewLine]", "\t          ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "With", "[", "\[IndentingNewLine]", "\t            ", 
                    RowBox[{
                    RowBox[{"{", "\[IndentingNewLine]", "\t              ", 
                    RowBox[{
                    RowBox[{"newEdge", "=", 
                    RowBox[{"UndirectedEdge", " ", "@@", " ", 
                    RowBox[{"Sort", "[", 
                    RowBox[{"vertexRule", " ", "/@", " ", 
                    RowBox[{"List", " ", "@@", " ", "#1"}]}], "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "\t              ", 
                    RowBox[{"newLabel", "=", 
                    RowBox[{"Association", " ", "@", " ", 
                    RowBox[{
                    "KeyValueMap", "[", "\[IndentingNewLine]", 
                    "\t                ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"vertexRule", "[", "#1", "]"}], "->", "#2"}], " ",
                     "&"}], ",", "\[IndentingNewLine]", "\t                ", 
                    "#2"}], "\[IndentingNewLine]", "\t              ", 
                    "]"}]}]}]}], "\[IndentingNewLine]", "\t            ", 
                    "}"}], ",", "\[IndentingNewLine]", "\t            ", 
                    RowBox[{"newEdge", "->", 
                    RowBox[{"KeySort", "[", "newLabel", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t          ", "]"}], " ", "&"}], 
                  ",", "\[IndentingNewLine]", "\t          ", 
                  RowBox[{"diag", "[", "\"\<InternalEdgeLabels\>\"", "]"}]}], 
                 "\[IndentingNewLine]", "\t        ", "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", "\t        ", "\[IndentingNewLine]", 
             "\t        ", 
             RowBox[{"<|", "\[IndentingNewLine]", "\t          ", 
              RowBox[{
               RowBox[{"\"\<Graph\>\"", "->", 
                RowBox[{"CanonicalGraph", "[", "graph", "]"}]}], ",", 
               "\[IndentingNewLine]", "\t          ", 
               RowBox[{"\"\<ExternalAssignment\>\"", "->", "newExternal"}], ",",
                "\[IndentingNewLine]", "\t          ", 
               RowBox[{"\"\<InternalEdgeLabels\>\"", "->", "newInternal"}]}], 
              "\[IndentingNewLine]", "\t        ", "|>"}]}]}], 
           "\[IndentingNewLine]", "\t      ", "]"}]}], "\[IndentingNewLine]", 
         "\t    ", "]"}], ",", "\[IndentingNewLine]", "\t    ", 
        "automorphisms"}], "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "\t  ", "\[IndentingNewLine]", "\t  ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"SortBy", "[", 
       RowBox[{"representatives", ",", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"InputForm", "[", "#", "]"}], "]"}], " ", "&"}]}], 
       "]"}]}]}]}], "\[IndentingNewLine]", "\t", "]"}]}]], "Input",
