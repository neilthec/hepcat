          Rational[2, 3], 0, 0]], {2.0183044118241598, 1.0032060218298384}], 
      InsetBox[
       StyleBox[
        RowBox[{
         RowBox[{"-", 
          SqrtBox["2"]}], " ", "EE", " ", 
         FormBox[
          SubscriptBox["\<\"x\"\>", "\<\"145,2\"\>"],
          TraditionalForm], " ", 
         FormBox[
          TemplateBox[{
            TemplateBox[{"\"\[LeftAngleBracket]\"", 
              StyleBox[
               SubscriptBox["\"P\"", 
                RowBox[{"1", ",", "4", ",", "5"}]], Bold, StripOnInput -> 
               False]}, "RowDefault"], 
            TemplateBox[{
              StyleBox["2", Bold, StripOnInput -> False], 
              "\"\[RightAngleBracket]\""}, "RowDefault"]},
           "RowDefault"],
          TraditionalForm]}],
        StripOnInput->False,
        LineColor->RGBColor[
          Rational[2, 3], 0, 0],
        FrontFaceColor->RGBColor[
          Rational[2, 3], 0, 0],
        BackFaceColor->RGBColor[
          Rational[2, 3], 0, 0],
        GraphicsColor->RGBColor[
          Rational[2, 3], 0, 0],
        FontSize->10,
        FontColor->RGBColor[
          Rational[2, 3], 0, 0]], {3.2050037581076163, 1.268580587330268}]}},
    ImagePadding->40,
    ImageSize->450,
    PlotRange->All]}], "}"}]], "Output",
 CellChangeTimes->{3.997189848425424*^9, 3.997190297986371*^9, 
  3.997191220471068*^9, 3.99719162128413*^9, 3.9972661175004272`*^9, 
  3.9972690020887203`*^9, 3.9972693805967207`*^9, 3.9972761825602837`*^9, 
  3.997276898099568*^9, 3.997278748627708*^9},
 CellLabel->
  "Out[107]=",ExpressionUUID->"04512ecf-666b-4be4-859b-f9a0423b6e17"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "diags", "]"}]], "Input",
 CellChangeTimes->{{3.9972766465671*^9, 3.9972766493077*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"bcc992b6-7dc7-4d89-9ba4-c30034cce856"],

Cell[BoxData["6"], "Output",
 CellChangeTimes->{3.997276898169608*^9, 3.997278748778535*^9},
 CellLabel->
  "Out[108]=",ExpressionUUID->"7d776019-75d3-4815-bcd7-aa450c364947"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
This code appears to work as intended, but is really, really slow.  Madgraph \
does this basically instantaneously for this process.\
\>", "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellLabel->
  "In[109]:=",ExpressionUUID->"6c33bfc7-7d50-4801-85af-2b1baf3133b0"],

Cell[TextData[{
 "Yes \[LongDash] the main bottleneck is combinatorics, not graph drawing.\n\n\
Your current pipeline does several expensive things:\n\n1. generates topology \
skeletons via ",
 StyleBox["all permutations",
  FontWeight->Bold],
 " of a Pr\[UDoubleDot]fer multiset,\n2. generates external assignments via \
",
 StyleBox["all permutations",
  FontWeight->Bold],
 " of tagged externals,\n3. generates internal labelings via ",
 StyleBox["all tuples",
  FontWeight->Bold],
 " of particle choices,\n4. then removes duplicates only ",
 StyleBox["after",
  FontWeight->Bold],
 " constructing full decorated diagrams,\n5. and repeatedly recomputes \
expensive structural data like connected components and vertex matches.\n\n\
That is why ",
 Cell[BoxData[
  TemplateBox[{
    Cell["2 \\to 3", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "b9d7969a-2775-4c0d-8165-be73a78cc0a9"],
 " already jumps to hundreds of seconds. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Where the blowup is\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3533ca55-805d-40dc-aea6-9637328c74ca"],
 "\nThe worst offenders are: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "1. ",
     Cell[BoxData[
      TemplateBox[{
        Cell["makeTopologySkeletons", Background -> None]},
       "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
      "533ebb62-4372-43c0-a081-ed9a0f04fdb2"]
    }],
     Background->None,ExpressionUUID->"26ab47e9-3caa-40fe-afee-06ce5445c20a"],
     "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d6a676c1-62a0-453e-b7f7-515385c29915"],
 "\nThis line is brutal: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"pruferSeqs", "=", 
          RowBox[{"Union", "[", 
            RowBox[{"Permutations", "[", "pruferMultiset", "]"}], "]"}]}], 
        ";"}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "f20e7a8c-e54b-4143-b78b-7eb729246562"],
 "\nEven with repeated elements, this is factorial growth. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "2. ",
     Cell[BoxData[
      TemplateBox[{
        Cell["externalAssignments", Background -> None]},
       "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
      "3d43ed90-0d9f-414d-b8c9-312242bf8fa9"]
    }],
     Background->None,ExpressionUUID->"c69cf389-b56b-4829-8512-2ff8da248a9f"],
     "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"521dd6ee-246b-4a0f-95ce-bcede90bcbfc"],
 "\nThis also does a factorial enumeration: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Permutations", "[", 
          RowBox[{"tagParticles", "[", "externalParticles", "]"}], "]"}], 
        "]"}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "19912c24-1f13-4146-94f3-274ba43c401e"],
 "\nFor identical photons this is still large, and you're doing it for every \
topology. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "3. ",
     Cell[BoxData[
      TemplateBox[{
        Cell["vertexStructureInstances", Background -> None]},
       "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
      "9a9cd200-ec5e-4768-895a-0b656dafcf6c"]
    }],
     Background->None,ExpressionUUID->"c64bbbd0-747e-4497-91c6-4586fac2cf68"],
     "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f338d194-5745-46fd-96f5-e87537f1509c"],
 "\nFor each candidate model row, you do: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"Permutations", "[", "incidentLegs", "]"}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "fa63731e-5e66-4914-9a7e-0c81cc625b6e"],
 "\nThat is another local factorial at every vertex. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "4. ",
     Cell[BoxData[
      TemplateBox[{
        Cell["internalEdgeIndexLabels", Background -> None]},
       "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
      "4ad2136b-6c75-4886-803a-a5fa042a1fd8"]
    }],
     Background->None,ExpressionUUID->"903daf99-d8fb-4f5c-8b97-fbcba5564c18"],
     "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b050921c-ee39-4389-bd03-214c41eec5e5"],
 "\nFor each internal edge, you do: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"ConnectedComponents", "[", 
        RowBox[{"EdgeDelete", "[", 
          RowBox[{"graph", ",", "edge"}], "]"}], "]"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "e9e88cf6-dc76-4f87-841c-1a79ee049e65"],
 "\nThat is expensive and repeated many times across assignments. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. canonicalization only at the end\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"54416623-df56-4b0c-b5ac-57c1e0d16d5c"],
 "\nYou allow many equivalent assignments to survive deep into the pipeline. \
\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"0ff38e40-f87e-4d43-973b-bf43eb4c391c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Big-picture fix\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d83427d0-361c-49f9-a4a5-530b5a4d43af"],
 "\nMadGraph is fast because it does ",
 StyleBox["constraint-driven generation",
  FontWeight->Bold],
 ", not brute-force decorate-and-deduplicate.\n\nYou want to move toward: \n\
",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "generate only a tiny set of nonisomorphic topologies,"
 }], "InlineItem",ExpressionUUID->"00002061-4c25-4ca5-89b9-d6103fa85f4a"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "assign externals in symmetry-reduced fashion,"
 }], "InlineItem",ExpressionUUID->"5d935e05-49c1-40e2-9a54-c5a45c88faa9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "propagate allowed internal particles by vertex constraints,"
 }], "InlineItem",ExpressionUUID->"2b0376ba-d129-4b81-9b55-2d6194f387ea"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "avoid ",
  Cell[BoxData[
   TemplateBox[{
    "Permutations", "paclet:ref/Permutations", 
     "https://reference.wolfram.com/language/ref/Permutations.html"},
    "TextRefLink"]],ExpressionUUID->"80c878e2-bb85-49b9-97f7-e11ec231aaae"],
  " whenever matching can be done by indexed lookup,"
 }], "InlineItem",ExpressionUUID->"e7a9845c-68a0-4c1a-b3cf-360a924aa81e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "cache everything topology-dependent,"
 }], "InlineItem",ExpressionUUID->"2d639c23-1816-4351-abed-a20c268aa155"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "canonicalize early."
 }], "InlineItem",ExpressionUUID->"ff500e5c-2262-46d5-974e-a3e04cf29842"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"54347e08-003a-4b7f-8090-af157b409a6a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Highest-impact changes\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"01789522-f733-4411-b8d7-b150f1e39325"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"1. Replace Pr\[UDoubleDot]fer multiset permutation \
generation\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e1014d72-2b7d-4172-8d34-57f25ea45c7c"],
 "\nFor tree topologies with prescribed degrees, Pr\[UDoubleDot]fer decoding \
is mathematically fine, but enumerating all multiset permutations is too \
expensive.\n\nFor your use case, the number of internal vertices is usually \
small. Better approaches: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "build trees recursively by attaching leaves/internal vertices under degree \
constraints,"
 }], "InlineItem",ExpressionUUID->"45758dd6-212a-4d66-b777-b3b9d971096e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "or generate unlabeled trees with given degree sequence directly,"
 }], "InlineItem",ExpressionUUID->"47226f3a-e009-43d3-a68f-c9ebdfa0dccb"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "or at minimum, generate labeled trees and quotient by isomorphism ",
  StyleBox["incrementally",
   FontWeight->Bold],
  ", not after ",
  Cell[BoxData[
   TemplateBox[{
    "Permutations", "paclet:ref/Permutations", 
     "https://reference.wolfram.com/language/ref/Permutations.html"},
    "TextRefLink"]],ExpressionUUID->"21e7e11c-f5d7-4329-aec5-16e6f3b67546"],
  "."
 }], "InlineItem",ExpressionUUID->"205de382-aeac-4538-b795-fe92cffaa3ce"],
 "\nIf you want a simple improvement without redesign, memoize by degree \
sequence and canonical graph: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "makeTopologySkeletons", "]"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"makeTopologySkeletons", "[", 
              RowBox[{"valenceCount_Association", ",", "nExternal_Integer"}], 
              "]"}], ":=", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"makeTopologySkeletons", "[", 
                RowBox[{"valenceCount", ",", "nExternal"}], "]"}], "=", 
              "\[IndentingNewLine]", "    ", 
              RowBox[{"Module", "[", "\[IndentingNewLine]", "      ", 
                RowBox[{
                  RowBox[{"{", "\[IndentingNewLine]", "        ", 
                    
                    RowBox[{
                    "internalDegrees", ",", "nInternal", ",", "internalVerts",
                     ",", "leafVerts", ",", "\[IndentingNewLine]", "        ",
                     "allVerts", ",", "targetDegrees", ",", "pruferMultiset", 
                    ",", "pruferSeqs"}], "\[IndentingNewLine]", "      ", 
                    "}"}], ",", "\[IndentingNewLine]", "      ", 
                  RowBox[{
                    RowBox[{"internalDegrees", "=", 
                    RowBox[{"Flatten", " ", "@", " ", 
                    RowBox[{"KeyValueMap", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"#1", ",", "#2"}], "]"}], " ", "&"}], ",", 
                    "valenceCount"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
                    "      ", 
                    RowBox[{"nInternal", "=", 
                    RowBox[{"Length", "[", "internalDegrees", "]"}]}], ";", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"internalVerts", "=", 
                    RowBox[{"Range", "[", "nInternal", "]"}]}], ";", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"leafVerts", "=", 
                    RowBox[{"Range", "[", 
                    RowBox[{
                    RowBox[{"nInternal", "+", "1"}], ",", 
                    RowBox[{"nInternal", "+", "nExternal"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"allVerts", "=", 
                    RowBox[{"Join", "[", 
                    RowBox[{"internalVerts", ",", "leafVerts"}], "]"}]}], ";",
                     "\[IndentingNewLine]", "      ", 
                    RowBox[{"targetDegrees", "=", 
                    RowBox[{"Join", "[", 
                    RowBox[{"internalDegrees", ",", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"1", ",", "nExternal"}], "]"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", "      ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Total", "[", "targetDegrees", "]"}], "=!=", 
                    RowBox[{
                    RowBox[{"2", " ", 
                    RowBox[{"Length", "[", "allVerts", "]"}]}], "-", "2"}]}], 
                    ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", "      ", 
                    RowBox[{"pruferMultiset", "=", 
                    RowBox[{"Flatten", " ", "@", " ", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{"ConstantArray", ",", 
                    RowBox[{"{", 
                    RowBox[{"allVerts", ",", 
                    RowBox[{"targetDegrees", "-", "1"}]}], "}"}]}], "]"}]}]}],
                     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    "      ", 
                    RowBox[{"pruferSeqs", "=", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"Permutations", "[", "pruferMultiset", "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", "      ", 
                    
                    RowBox[{
                    "DeleteDuplicatesBy", "[", "\[IndentingNewLine]", 
                    "        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Graph", "[", 
                    RowBox[{"allVerts", ",", 
                    RowBox[{"EdgeList", "[", 
                    RowBox[{"pruferDecode", "[", "#", "]"}], "]"}]}], "]"}], 
                    " ", "&"}], " ", "/@", " ", "pruferSeqs"}], ",", 
                    "\[IndentingNewLine]", "        ", "CanonicalGraph"}], 
                    "\[IndentingNewLine]", "      ", "]"}]}]}], 
                "\[IndentingNewLine]", "    ", "]"}]}]}], ";"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "5ed85036-af30-40f6-ab0c-a2465474493c"],
 "\nBut this only helps repeated calls. The real fix is to stop using full Pr\
\[UDoubleDot]fer multiset permutations. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"09b18cd7-d605-4b7e-9f4e-de08d8d9ecb8"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. Precompute topology metadata once per skeleton\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e50a5185-23c9-4d0b-9fb0-269fd5040700"],
 "\nA lot of your work depends only on the graph topology, not on particle \
labels.\n\nFor each graph, precompute: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["leafVerts", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "0fbae0c7-8223-4e87-812c-a5ee7bc8d1ae"]
 }], "InlineItem",ExpressionUUID->"d744adc0-7cd1-4f5a-8989-7b3023a87f6f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["internalVerts", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "5537bd08-796f-4926-a4a7-129ece8f54d2"]
 }], "InlineItem",ExpressionUUID->"f4ae0f54-e955-4eff-8cee-e9836dfb2e48"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["internalEdges", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "f4783f7a-93d8-48ca-b84e-1470c69e9cea"]
 }], "InlineItem",ExpressionUUID->"e62bc000-7493-4fe4-9e85-3b49ce87c750"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "for each internal edge and endpoint, the leaf set on the opposite side"
 }], "InlineItem",ExpressionUUID->"76029e1d-fb9b-4807-bbeb-fab5995e9a0e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "adjacency structure for internal vertices"
 }], "InlineItem",ExpressionUUID->"c7b9a61d-64c3-44f3-8080-7d26452c3192"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "automorphism group of the topology"
 }], "InlineItem",ExpressionUUID->"23d7bdcd-de20-4d1b-ae79-2b1a2300a96c"],
 "\nThis avoids recomputing connected components repeatedly.\n\nFor example: \
\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "topologyData", "]"}], "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"topologyData", "[", "graph_", "]"}], ":=", 
            RowBox[{
              RowBox[{"topologyData", "[", "graph", "]"}], "=", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"Module", "[", "\[IndentingNewLine]", "    ", 
                RowBox[{
                  RowBox[{"{", 
                    
                    RowBox[{
                    "leafVerts", ",", "internalVerts", ",", "internalEdges", 
                    ",", "splitLeafIndices"}], "}"}], ",", 
                  "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"leafVerts", "=", 
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"VertexList", "[", "graph", "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"VertexDegree", "[", 
                    RowBox[{"graph", ",", "#"}], "]"}], "==", "1"}], " ", 
                    "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", "    ", 
                    RowBox[{"internalVerts", "=", 
                    RowBox[{"Complement", "[", 
                    RowBox[{
                    RowBox[{"VertexList", "[", "graph", "]"}], ",", 
                    "leafVerts"}], "]"}]}], ";", "\[IndentingNewLine]", 
                    "    ", 
                    RowBox[{"internalEdges", "=", 
                    RowBox[{"Select", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"EdgeList", "[", "graph", "]"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"leafVerts", ",", 
                    RowBox[{"Alternatives", " ", "@@", " ", 
                    RowBox[{"(", 
                    RowBox[{"List", " ", "@@", " ", "#"}], ")"}]}]}], "]"}], 
                    " ", "&"}]}], "\[IndentingNewLine]", "    ", "]"}]}], ";",
                     "\[IndentingNewLine]", "\[IndentingNewLine]", "    ", 
                    RowBox[{"splitLeafIndices", "=", 
                    RowBox[{"Association", " ", "@", " ", 
                    RowBox[{"Map", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"edge", ",", "\[IndentingNewLine]", "        ", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"u", ",", "v", ",", "comps", ",", "compU", ",", 
                    "compV"}], "}"}], ",", "\[IndentingNewLine]", 
                    "          ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", "v"}], "}"}], "=", 
                    RowBox[{"List", " ", "@@", " ", "edge"}]}], ";", 
                    "\[IndentingNewLine]", "          ", 
                    RowBox[{"comps", "=", 
                    RowBox[{"ConnectedComponents", "[", 
                    RowBox[{"EdgeDelete", "[", 
                    RowBox[{"graph", ",", "edge"}], "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "          ", 
                    RowBox[{"compU", "=", 
                    RowBox[{"SelectFirst", "[", 
                    RowBox[{"comps", ",", 
                    RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"#", ",", "u"}], "]"}], " ", "&"}]}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "          ", 
                    RowBox[{"compV", "=", 
                    RowBox[{"SelectFirst", "[", 
                    RowBox[{"comps", ",", 
                    RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"#", ",", "v"}], "]"}], " ", "&"}]}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "          ", 
                    RowBox[{"edge", "->", 
                    RowBox[{"<|", "\[IndentingNewLine]", "            ", 
                    RowBox[{
                    RowBox[{"u", "->", 
                    RowBox[{"Intersection", "[", 
                    RowBox[{"compV", ",", "leafVerts"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "            ", 
                    RowBox[{"v", "->", 
                    RowBox[{"Intersection", "[", 
                    RowBox[{"compU", ",", "leafVerts"}], "]"}]}]}], 
                    "\[IndentingNewLine]", "          ", "|>"}]}]}]}], 
                    "\[IndentingNewLine]", "        ", "]"}]}], 
                    "\[IndentingNewLine]", "      ", "]"}], ",", 
                    "\[IndentingNewLine]", "      ", "internalEdges"}], 
                    "\[IndentingNewLine]", "    ", "]"}]}]}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"\"LeafVertices\"", "->", "leafVerts"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"InternalVertices\"", "->", "internalVerts"}], 
                    ",", "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"InternalEdges\"", "->", "internalEdges"}], ",",
                     "\[IndentingNewLine]", "      ", 
                    
                    RowBox[{
                    "\"SplitLeafVertices\"", "->", "splitLeafIndices"}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}]}]}], 
                "\[IndentingNewLine]", "  ", "]"}]}]}], ";"}]}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "0d1a2299-ad60-40d0-8ace-fda56ee5e42e"],
 "\nThen ",
 Cell[BoxData[
  TemplateBox[{
    Cell["internalEdgeIndexLabels", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "62d22e4d-e4ca-4609-83b8-cdcf1f86e960"],
 " becomes cheap: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "internalEdgeIndexLabels", "]"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"internalEdgeIndexLabels", "[", 
            RowBox[{"graph_", ",", "externalMap_Association"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"data", ",", "splitLeafVertices"}], "}"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"data", "=", 
                  RowBox[{"topologyData", "[", "graph", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"splitLeafVertices", "=", 
                  RowBox[{"data", "[", "\"SplitLeafVertices\"", "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
                RowBox[{"Association", " ", "@", " ", 
                  RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"edge", ",", "sideData"}], "}"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"edge", "->", 
                    RowBox[{"Association", " ", "@", " ", 
                    
                    RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", 
                    "        ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"v", ",", "leaves"}], "}"}], ",", 
                    "\[IndentingNewLine]", "          ", 
                    RowBox[{"v", "->", 
                    
                    RowBox[{"Apply", "[", "\[IndentingNewLine]", 
                    "            ", 
                    
                    RowBox[{"Multiparticle", ",", "\[IndentingNewLine]", 
                    "            ", 
                    RowBox[{"Sort", "[", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"externalMap", " ", "/@", " ", "leaves"}], ",", 
                    "\"InputIndex\""}], "]"}], "]"}]}], "\[IndentingNewLine]",
                     "          ", "]"}]}]}], "\[IndentingNewLine]", 
                    "        ", "]"}], ",", "\[IndentingNewLine]", "        ",
                     "sideData"}], "\[IndentingNewLine]", "      ", 
                    "]"}]}]}]}], "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", "splitLeafVertices"}], 
                    "\[IndentingNewLine]", "  ", "]"}]}]}]}], 
            "\[IndentingNewLine]", "]"}]}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "f30b7346-c2df-40e9-868e-a1ff3e1ab1c2"],
 "\nThis removes repeated calls to ",
 Cell[BoxData[
  TemplateBox[{
   "ConnectedComponents", "paclet:ref/ConnectedComponents", 
    "https://reference.wolfram.com/language/ref/ConnectedComponents.html"},
   "TextRefLink"]],ExpressionUUID->"89944b45-1889-4bb4-a4a7-0edd17e4fd74"],
 ". \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"1da11bc5-4414-4851-9c5f-7b52e67dd01b"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. Stop permuting incident legs at each vertex\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"dbc1681b-ec3a-4d0a-96c7-6930fc2c991d"],
 "\nThis is a major inefficiency: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"Select", "[", 
        RowBox[{
          RowBox[{"Permutations", "[", "incidentLegs", "]"}], ",", 
          RowBox[{
            RowBox[{"rowParticles", "===", 
              RowBox[{"#", "[", 
                RowBox[{"[", 
                  RowBox[{"All", ",", "\"Particle\""}], "]"}], "]"}]}], " ", 
            "&"}]}], "]"}]], "ChatCode", "Input", LanguageCategory -> "Input",
      ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "e3d5239b-0c88-4765-a41c-a0ca71c96bd7"],
 "\nYou do not need all permutations. You only need permutations consistent \
with repeated particle slots of a model row.\n\nA faster approach is: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "group incident legs by particle type,"
 }], "InlineItem",ExpressionUUID->"b6adac15-e565-4c27-bf94-d8a1ccc9feb3"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "group row slots by particle type,"
 }], "InlineItem",ExpressionUUID->"0290fc12-abfb-4055-9fe3-84dcbab56637"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "assign only within matching groups,"
 }], "InlineItem",ExpressionUUID->"11250333-6fee-46f4-969b-7193b75179e5"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "take product across particle groups."
 }], "InlineItem",ExpressionUUID->"6e62f8c1-eb31-4d82-9654-8256c39e8318"],
 "\nHere is a much faster replacement idea: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "vertexRowMatches", "]"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"vertexRowMatches", "[", 
            
            RowBox[{"incidentLegs_List", ",", "row_", ",", 
              "validParticles_List"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", 
                
                RowBox[{
                 "rowParticles", ",", "legGroups", ",", "rowPositions", ",", 
                  "assignmentsPerParticle"}], "}"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"rowParticles", "=", 
                  RowBox[{"modelRowParticles", "[", 
                    RowBox[{"row", ",", "validParticles"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "rowParticles", "]"}], "=!=", 
                    RowBox[{"Length", "[", "incidentLegs", "]"}]}], ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"If", "[", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"Sort", "[", "rowParticles", "]"}], "=!=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{"incidentLegs", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"Particle\""}], "]"}], "]"}], 
                    "]"}]}], ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
                RowBox[{"legGroups", "=", 
                  RowBox[{"GroupBy", "[", 
                    RowBox[{"incidentLegs", ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"Particle\"", "]"}], " ", "&"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                RowBox[{"rowPositions", "=", 
                  RowBox[{"GroupBy", "[", 
                    RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "rowParticles", "]"}], "]"}], ",", 
                    
                    RowBox[{
                    RowBox[{"rowParticles", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", "&"}]}], "]"}]}], 
                ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
                
                RowBox[{
                 "assignmentsPerParticle", "=", "\[IndentingNewLine]", "    ", 
                  RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"particle", ",", "positions"}], "}"}], ",", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Thread", "[", 
                    RowBox[{"positions", "->", "#"}], "]"}], " ", "&"}], " ", 
                    "/@", " ", 
                    RowBox[{"Permutations", "[", 
                    RowBox[{"legGroups", "[", "particle", "]"}], "]"}]}]}], 
                    "\[IndentingNewLine]", "      ", "]"}], ",", 
                    "\[IndentingNewLine]", "      ", "rowPositions"}], 
                    "\[IndentingNewLine]", "    ", "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
                RowBox[{"Map", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"rules", ",", "\[IndentingNewLine]", "      ", 
                    RowBox[{"ReplacePart", "[", 
                    RowBox[{
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"None", ",", 
                    RowBox[{"Length", "[", "rowParticles", "]"}]}], "]"}], 
                    ",", 
                    RowBox[{"Flatten", "[", "rules", "]"}]}], "]"}]}], 
                    "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"Tuples", "[", "assignmentsPerParticle", "]"}]}], 
                  "\[IndentingNewLine]", "  ", "]"}]}]}], 
            "\[IndentingNewLine]", "]"}]}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "265f38f8-ca37-49bd-94f2-58fd2b0a62b9"],
 "\nThis still uses permutations, but only within equal-particle groups \
rather than across the whole vertex. For many realistic vertices this is much \
smaller. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"c073d82a-f24f-4f59-8edd-37363d0b1046"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Filter internal edge assignments by vertex compatibility \
immediately\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f952a100-9a48-43f3-8afb-f07242c97ce3"],
 "\nRight now ",
 Cell[BoxData[
  TemplateBox[{
    Cell["internalEdgeAssignments", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "61dca16f-395a-4433-9c70-8fb837b6f2f0"],
 " generates all internal particle/orientation choices before checking \
whether any vertex can use them.\n\nInstead, for each internal edge, derive \
allowed particles from the adjacent vertex possibilities.\n\nFor a given \
topology and external assignment:\n\n1. compute each internal vertex\
\[CloseCurlyQuote]s required multiset patterns from the model,\n2. infer \
which internal particles can appear on each adjacent internal edge,\n3. \
intersect constraints from both ends of an internal edge,\n4. backtrack only \
over surviving possibilities.\n\nThis is the single biggest algorithmic \
shift.\n\nInstead of: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"edgeAssignments", "=", 
          RowBox[{"internalEdgeAssignments", "[", 
            
            RowBox[{"internalEdges", ",", "particleTypes", ",", 
              "antiParticleRules"}], "]"}]}], ";"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "707e50e1-f8f8-40ae-a727-ffd355ff08ef"],
 "\nyou want a recursive constraint solver.\n\nPseudo-structure: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"assignInternalEdges", "[", 
          
          RowBox[{"graph_", ",", "extMap_", ",", "model_", ",", 
            "antiRules_"}], "]"}], ":=", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
          RowBox[{
            RowBox[{"{", 
              RowBox[{"internalEdges", ",", "domains", ",", 
                RowBox[{"solutions", "=", 
                  RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"domains", "=", 
                RowBox[{"initialDomainsFromVertexConstraints", "[", 
                  
                  RowBox[{
                   "graph", ",", "extMap", ",", "model", ",", "antiRules"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              "  ", 
              RowBox[{
                RowBox[{"backtrack", "[", 
                  RowBox[{"currentDomains_", ",", "assigned_"}], "]"}], ":=", 
                
                RowBox[{"Module", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"{", 
                    RowBox[{"edge", ",", "choices", ",", "newState"}], "}"}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"allAssignedQ", "[", "currentDomains", "]"}], ",",
                     "\[IndentingNewLine]", "      ", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"solutions", ",", "assigned"}], "]"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"edge", "=", 
                    
                    RowBox[{"chooseMostConstrainedEdge", "[", 
                    "currentDomains", "]"}]}], ";", "\[IndentingNewLine]", 
                    "      ", 
                    RowBox[{"choices", "=", 
                    RowBox[{"currentDomains", "[", "edge", "]"}]}], ";", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"Do", "[", "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"newState", "=", 
                    RowBox[{"propagateChoice", "[", 
                    
                    RowBox[{"edge", ",", "choice", ",", "currentDomains", ",",
                     "assigned"}], "]"}]}], ";", "\[IndentingNewLine]", 
                    "        ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"newState", "=!=", "$Failed"}], ",", 
                    "\[IndentingNewLine]", "          ", 
                    RowBox[{"backtrack", "[", 
                    RowBox[{
                    RowBox[{"newState", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"newState", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], 
                    "\[IndentingNewLine]", "        ", "]"}]}], ",", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{"{", 
                    RowBox[{"choice", ",", "choices"}], "}"}]}], 
                    "\[IndentingNewLine]", "      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "]"}]}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
              RowBox[{"backtrack", "[", 
                RowBox[{"domains", ",", 
                  RowBox[{"<|", "|>"}]}], "]"}], ";", "\[IndentingNewLine]", 
              "  ", "solutions"}]}], "\[IndentingNewLine]", "]"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "39c335dd-a361-4b5c-a34f-5fd6648898bc"],
 "\nThis is much closer to what fast diagram generators do. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"54f69d7f-7508-4f4a-9d03-c5c3dcc45a41"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Canonicalize external assignments before deep \
decoration\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ff03090c-93e1-497d-975f-35fb227327ef"],
 "\nWhen externals include repeated particles like ",
 Cell[BoxData[
  TemplateBox[{
    Cell["{\"A.+\",\"A.+\",\"A.+\"}", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "9e342145-eaa0-4329-9ef7-83ca9856dd80"],
 ", many leaf assignments are graph-automorphism equivalent.\n\nInstead of \
all permutations of tagged particles over leaves, quotient by the \
automorphism group of the topology.\n\nYou already compute automorphisms in \
",
 Cell[BoxData[
  TemplateBox[{
    Cell["canonicalDiagram", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "e21b6539-84d4-4d78-82be-482478e79673"],
 ". Use them earlier.\n\nA practical quick fix: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"ClearAll", "[", "externalAssignmentsReduced", "]"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"externalAssignmentsReduced", "[", 
            RowBox[{"graph_", ",", "externalParticles_List"}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"leafVerts", ",", "raw", ",", "canonicalize"}], "}"}],
               ",", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"leafVerts", "=", 
                  RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"VertexList", "[", "graph", "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"VertexDegree", "[", 
                    RowBox[{"graph", ",", "#"}], "]"}], "==", "1"}], " ", 
                    "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                RowBox[{"raw", "=", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"AssociationThread", "[", 
                    RowBox[{"leafVerts", ",", "#"}], "]"}], " ", "&"}], " ", 
                    "/@", " ", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"Permutations", "[", 
                    RowBox[{"tagParticles", "[", "externalParticles", "]"}], 
                    "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"canonicalize", "[", "extMap_", "]"}], ":=", 
                  RowBox[{"First", " ", "@", " ", 
                    RowBox[{"SortBy", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"Map", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"iso", ",", "\[IndentingNewLine]", "        ", 
                    RowBox[{"KeySort", " ", "@", " ", 
                    RowBox[{"Association", " ", "@", " ", 
                    RowBox[{"KeyValueMap", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"iso", "[", "#1", "]"}], "->", "#2"}], ")"}], " ",
                     "&"}], ",", "extMap"}], "]"}]}]}]}], 
                    "\[IndentingNewLine]", "      ", "]"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"Association", " ", "/@", " ", 
                    RowBox[{"(", 
                    RowBox[{"Normal", " ", "/@", " ", 
                    RowBox[{"FindGraphIsomorphism", "[", 
                    RowBox[{"graph", ",", "graph", ",", "All"}], "]"}]}], 
                    ")"}]}]}], "\[IndentingNewLine]", "    ", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{"InputForm", "[", "#", "]"}], "]"}], " ", "&"}]}],
                     "\[IndentingNewLine]", "  ", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
                RowBox[{"DeleteDuplicatesBy", "[", 
                  RowBox[{"raw", ",", "canonicalize"}], "]"}]}]}], 
            "\[IndentingNewLine]", "]"}]}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "1697c4ab-5a53-4714-b44f-ac1d859b4439"],
 "\nThen use this instead of ",
 Cell[BoxData[
  TemplateBox[{
    Cell["externalAssignments", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "0b45e4bb-fbf1-43a9-9b3a-e25c29917de7"],
 ".\n\nFor repeated bosons this can reduce work a lot. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"e8301f0a-67f2-449b-bc1e-a4c4a0c78d8c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Replace string-based canonicalization keys\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0adf6612-337a-4a95-b648-29020ff833c6"],
 "\nThis is slow: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"SortBy", "[", 
        RowBox[{"...", ",", 
          RowBox[{
            RowBox[{"ToString", "[", 
              RowBox[{"InputForm", "[", "#", "]"}], "]"}], " ", "&"}]}], 
        "]"}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "8d102174-fb59-451d-821d-29472cde9f27"],
 "\nPrefer structural keys such as ",
 Cell[BoxData[
  TemplateBox[{
   "OrderedQ", "paclet:ref/OrderedQ", 
    "https://reference.wolfram.com/language/ref/OrderedQ.html"},
   "TextRefLink"]],ExpressionUUID->"db1e8bc6-5778-4505-ba56-910a1dc5fd7c"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "Sort", "paclet:ref/Sort", 
    "https://reference.wolfram.com/language/ref/Sort.html"},
   "TextRefLink"]],ExpressionUUID->"f2674552-00c8-4942-8940-8b5b0958fadf"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "CanonicalGraph", "paclet:ref/CanonicalGraph", 
    "https://reference.wolfram.com/language/ref/CanonicalGraph.html"},
   "TextRefLink"]],ExpressionUUID->"12fc8da7-41bc-46aa-8651-1887f16c6d27"],
 ", or explicit normalized associations/lists.\n\nFor example, instead of \
stringifying whole structures: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"canonicalVertexInstance", "[", "vs_", "]"}], ":=", 
        RowBox[{"{", "\[IndentingNewLine]", "  ", 
          RowBox[{
            RowBox[{"SortBy", "[", "\[IndentingNewLine]", "    ", 
              RowBox[{
                RowBox[{
                  RowBox[{"vs", "[", "\"IncidentLegs\"", "]"}], "[", 
                  RowBox[{"[", 
                    RowBox[{"All", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Particle\"", ",", "\"Index\"", ",", "\"Kind\""}], 
                    "}"}]}], "]"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
                RowBox[{
                  RowBox[{"{", 
                    RowBox[{"#Particle", ",", "#Kind", ",", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"#Index", ",", "InputForm"}], "]"}]}], "}"}], " ",
                   "&"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
            "\[IndentingNewLine]", "  ", 
            RowBox[{"HoldComplete", "[", 
              RowBox[{"vs", "[", "\"Expression\"", "]"}], "]"}]}], 
          "\[IndentingNewLine]", "}"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "a5363ea2-da33-4309-8fd1-07e44d52ab7e"],
 "\nand then use direct structural comparison.\n\nEven better, define a \
compact signature using only what determines uniqueness. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"4d7b0064-e7d3-4153-a4e8-a1cf3b372539"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"A concrete optimization plan\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"45956d5b-f21e-4653-8ae5-b5870819140b"],
 "\nIf you want the biggest speedup for the least rewrite effort, do these in \
order: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Step 1\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f5a3d15f-0b4b-4593-b4e9-1a7cb0ea11ad"],
 "\nMemoize topology-dependent computations: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["makeTopologySkeletons", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "1bd1520a-ab24-487a-92ac-694fdb471b06"]
 }], "InlineItem",ExpressionUUID->"fce4b3a3-7f11-4342-8933-8e9fb1bf75fa"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["topologyData", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "278b969b-64f0-48c2-8441-814e234897ee"]
 }], "InlineItem",ExpressionUUID->"b7469049-d33f-44a0-885e-7b0405002403"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["canonicalDiagram", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "e06f07ac-96e9-4ef0-b744-e066b4035e55"],
  " or better the topology automorphisms"
 }], "InlineItem",ExpressionUUID->"8e83e12a-fb56-46e9-9a1e-efce960e1a2f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "model-derived things:"
 }], "InlineItem",ExpressionUUID->"64d66696-5b07-4dfc-aa74-1cbc93240498"],
 "\n",
 Cell[TextData[{
  "  ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["particleNames[model]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "3f1dfece-686c-4553-a7b1-f16864c6b61e"]
 }], "InlineSubitem",ExpressionUUID->"5a32f54a-1c67-4888-bfb6-b34a399daf1b"],
 "\n",
 Cell[TextData[{
  "  ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["modelVertices[model]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "15d936fe-d134-4c21-aeb8-07a9041f5c21"]
 }], "InlineSubitem",ExpressionUUID->"094aa485-fd9b-4fdb-aad4-b8b5df985e75"],
 "\n",
 Cell[TextData[{
  "  ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["vertexValences[model]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "1ad3aaea-304d-45d1-a881-b7a5a5cbc40f"]
 }], "InlineSubitem",ExpressionUUID->"64e540e5-31d8-407b-91ee-bc973b3c3c24"],
 "\n",
 Cell[TextData[{
  "  ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["antiParticleRulesFromModel[model]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "9284ba7e-c244-4e4c-95b5-fde28d772577"]
 }], "InlineSubitem",ExpressionUUID->"75b83e25-396f-4222-aa38-7807ee317c35"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Step 2\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9bd8e676-6dd2-4131-98cf-1578248f831d"],
 "\nReplace ",
 Cell[BoxData[
  TemplateBox[{
    Cell["internalEdgeIndexLabels", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "02040b13-c741-4eee-85fb-53af31421fc0"],
 " with a version that uses cached edge-split data. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Step 3\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5299281b-0988-437e-beb0-c60784b22d32"],
 "\nReplace ",
 Cell[BoxData[
  TemplateBox[{
    Cell["vertexRowMatches", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "bd482aca-0aa6-4284-9254-b61f17b40ddf"],
 " so it does not permute all incident legs. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Step 4\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3a4030fe-0cab-4f62-9508-a55f7158f095"],
 "\nReduce external assignments modulo graph automorphisms. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Step 5\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e0c9765a-62a2-431c-930d-0bf1b3b18621"],
 "\nReplace brute-force ",
 Cell[BoxData[
  TemplateBox[{
    Cell["internalEdgeAssignments", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "42609d5d-60e1-4045-8806-4d27b7cac2fd"],
 " with backtracking + pruning.\n\nThat last step is where you'll go from \
\[OpenCurlyDoubleQuote]works\[CloseCurlyDoubleQuote] to \
\[OpenCurlyDoubleQuote]MadGraph-like.\[CloseCurlyDoubleQuote] \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"474996a7-caf4-4125-97b4-cabe03ff344f"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"A few immediate code-level memoizations\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d92e58f1-4c20-4de9-9de0-855567229de9"],
 "\nThese are easy wins. \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
            
            RowBox[{"particleNames", ",", "modelVertices", ",", 
              "vertexValences", ",", "\[IndentingNewLine]", "  ", 
              "antiParticleRulesFromModel"}], "\[IndentingNewLine]", "]"}], 
          ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"particleNames", "[", "model_", "]"}], ":=", 
            RowBox[{
              RowBox[{"particleNames", "[", "model", "]"}], "=", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"DeleteDuplicates", " ", "@", " ", 
                RowBox[{"Flatten", "[", 
                  RowBox[{"model", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "All", ",", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], 
                  "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"modelVertices", "[", "model_", "]"}], ":=", 
            RowBox[{
              RowBox[{"modelVertices", "[", "model", "]"}], "=", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"Module", "[", 
                RowBox[{
                  RowBox[{"{", "validParticles", "}"}], ",", 
                  "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"validParticles", "=", 
                    RowBox[{"particleNames", "[", "model", "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "DeleteDuplicates", "[", "\[IndentingNewLine]", "      ", 
                    
                    RowBox[{"Sort", " ", "/@", " ", 
                    
                    RowBox[{
                    "Select", "[", "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"vertexParticles", "[", 
                    RowBox[{"#", ",", "validParticles"}], "]"}], " ", "&"}], 
                    " ", "/@", " ", 
                    RowBox[{"model", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], ">=", "3"}], " ", 
                    "&"}]}], "\[IndentingNewLine]", "      ", "]"}]}], 
                    "\[IndentingNewLine]", "    ", "]"}]}]}], 
                "\[IndentingNewLine]", "  ", "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"vertexValences", "[", "model_", "]"}], ":=", 
            RowBox[{
              RowBox[{"vertexValences", "[", "model", "]"}], "=", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"Length", " ", "/@", " ", 
                  RowBox[{"modelVertices", "[", "model", "]"}]}], "]"}]}]}], 
          ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"antiParticleRulesFromModel", "[", "model_", "]"}], ":=", 
            
            RowBox[{
              RowBox[{"antiParticleRulesFromModel", "[", "model", "]"}], "=", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"Association", " ", "@", " ", 
                RowBox[{"Flatten", "[", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{
                    RowBox[{"model", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "All", ",", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], " ", "/.",
                     " ", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"particle_", ",", "antiParticle_"}], "}"}], ":>", 
                    
                    RowBox[{"{", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"particle", "->", "antiParticle"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"antiParticle", "->", "particle"}]}], 
                    "\[IndentingNewLine]", "    ", "}"}]}]}], ",", 
                    "\[IndentingNewLine]", "    ", "1"}], 
                  "\[IndentingNewLine]", "  ", "]"}]}]}]}], ";"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "fe5d03b6-23d2-48e3-be66-92d06ae4f1ca"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
