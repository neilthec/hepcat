 "\nIn ",
 Cell[BoxData[
  TemplateBox[{
    Cell["decorateTopology", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "58aa301c-ac65-4547-add8-b45f09867c4c"],
 ", instead of storing only: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"\"InternalEdgeLabels\"", "->", "internalEdgeLabels"}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "329de127-1f82-407f-9982-51711fba096c"],
 "\nstore both: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"\"InternalEdgeData\"", "->", "internalEdgeData"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"InternalEdgeLabels\"", "->", 
          RowBox[{"AssociationMap", "[", 
            RowBox[{
              RowBox[{
                RowBox[{"internalEdgeData", "[", 
                  RowBox[{"#", ",", "\"EndpointLabels\""}], "]"}], " ", "&"}],
               ",", 
              RowBox[{"Keys", "[", "internalEdgeData", "]"}]}], "]"}]}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "c45e773a-f3dc-460b-8f20-7a134d5227d2"],
 "\nor just derive ",
 Cell[BoxData[
  TemplateBox[{
    Cell["InternalEdgeLabels", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "04a85b23-a730-4859-9020-814cd7282180"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell["InternalEdgeData", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "ad993168-3da9-4701-a527-b44266efe138"],
 " for backward compatibility.\n\nFor example inside ",
 Cell[BoxData[
  TemplateBox[{
    Cell["decorateTopology", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "72961483-a390-4282-84a2-b297fadbcba4"],
 ": \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "\t  ", 
          RowBox[{
            RowBox[{"Module", "[", 
              RowBox[{
                RowBox[{"{", "edgeLabels", "}"}], ",", "\[IndentingNewLine]", 
                "\t    ", 
                RowBox[{
                  RowBox[{"edgeLabels", "=", 
                    
                    RowBox[{
                    "AssociationMap", "[", "\[IndentingNewLine]", "\t      ", 
                    
                    RowBox[{
                    RowBox[{
                    RowBox[{"internalEdgeData", "[", 
                    RowBox[{"#", ",", "\"EndpointLabels\""}], "]"}], " ", 
                    "&"}], ",", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"Keys", "[", "internalEdgeData", "]"}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}]}], ";", 
                  "\[IndentingNewLine]", "\t    ", "\[IndentingNewLine]", 
                  "\t    ", 
                  RowBox[{"If", "[", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    
                    RowBox[{
                    "validVertexAssignmentFastQ", "[", "\[IndentingNewLine]", 
                    "\t        ", 
                    
                    RowBox[{
                    "graph", ",", "\[IndentingNewLine]", "\t        ", 
                    "internalVerts", ",", "\[IndentingNewLine]", "\t        ",
                     "extMap", ",", "\[IndentingNewLine]", "\t        ", 
                    "edgeLabels", ",", "\[IndentingNewLine]", "\t        ", 
                    "model"}], "\[IndentingNewLine]", "\t      ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"\"Graph\"", "->", "graph"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"ExternalAssignment\"", "->", "extMap"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    
                    RowBox[{
                    "\"InternalEdgeData\"", "->", "internalEdgeData"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"InternalEdgeLabels\"", "->", "edgeLabels"}], 
                    ",", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"InternalVertices\"", "->", "internalVerts"}], 
                    ",", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"LeafVertices\"", "->", "leafVerts"}]}], 
                    "\[IndentingNewLine]", "\t      ", "|>"}], ",", 
                    "\[IndentingNewLine]", "\t      ", "Nothing"}], 
                    "\[IndentingNewLine]", "\t    ", "]"}]}]}], 
              "\[IndentingNewLine]", "\t  ", "]"}], ",", 
            "\[IndentingNewLine]", "\t  ", 
            RowBox[{"{", 
              RowBox[{"extMap", ",", "extAssignments"}], "}"}], ",", 
            "\[IndentingNewLine]", "\t  ", 
            RowBox[{"{", 
              RowBox[{"internalEdgeData", ",", "edgeAssignments"}], "}"}]}], 
          "\[IndentingNewLine]", "\t", "]"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "fb125cd9-a1c3-43bd-8fd0-832aaf434453"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
