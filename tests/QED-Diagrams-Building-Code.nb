Cell["\<\
sm = ReadModel[HEPCATBasePath <> \"/models\", 1];
qed = ReadModel[HEPCATBasePath <> \"/models\", 2];\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"bf69a17e-8d5e-4c42-aa36-1856ece05095"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Diagram counts", "Section",ExpressionUUID->"44216bf0-f6df-4428-8de2-a0ab6d5db793"],

Cell["\<\
Tree-level QED-like processes, plus a few SM processes that use additional \
vertices.\
\>", "Text",ExpressionUUID->"d2ee048f-9a0d-47af-9236-6bf807cacad1"],

Cell[CellGroupData[{

Cell["Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", sm] === 1", "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"67113557-3c90-4dcc-b521-c5263b9983e7"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447618333824*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"f9e9cfa0-0d7d-4255-8645-f1a6927d924f"]
}, Open  ]],

Cell["\<\
Two diagrams (t- and u-channel electron exchange).  Same-helicity photons \
have no s-channel because there is no three-photon vertex.\
\>", "Text",ExpressionUUID->"47d499f1-c99c-4bcd-8822-ec92d9163f30"],

Cell[CellGroupData[{

Cell["Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", sm] === 2", \
"Input",
 CellLabel->"In[7]:=",ExpressionUUID->"370dad4a-1b03-47f3-9253-e5674ddeaf33"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447624269794*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"7111e7a5-02cc-4508-993c-51a9c3e321de"]
}, Open  ]],

Cell["\<\
Six diagrams: the three photons can be attached along the fermion line in 3! \
orders.\
\>", "Text",ExpressionUUID->"c4409535-c7ce-46fd-b1d7-1c589737e92c"],

Cell[CellGroupData[{

Cell["\<\
Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", sm] === 6\
\>", "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"44cb9d2a-7b2b-4c3f-8caf-8ccfb9dbb06d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9974476283327208`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"0c1e8f0e-cf19-4c9d-a3b4-8431f7f2f5fa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
{
  Length @ CreateDiagrams[\"e\", \"E\", \"e\", \"E\", sm],
  Length @ CreateDiagrams[\"u\", \"U\", \"G.+\", \"G.+\", sm],
  Length @ CreateDiagrams[\"h\", \"h\", \"h\", \"h\", sm],
  Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.+\", sm]
} === {8, 3, 4, 24}\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"c60ed485-3b11-4970-8be1-8353e6b07f8f"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447631366517*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"4c9ba01c-3112-4d44-ac83-64ae0a419008"]
}, Open  ]],

Cell["\<\
QED has no Z, so e E -> e E has four diagrams rather than the SM's eight.\
\>", "Text",ExpressionUUID->"072c8064-c468-41c2-946e-2daa86938b1c"],

Cell[CellGroupData[{

Cell["\<\
{
  Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", qed],
  Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", qed],
  Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", qed],
  Length @ CreateDiagrams[\"e\", \"E\", \"e\", \"E\", qed]
} === {1, 2, 6, 4}\
\>", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"a34ff562-f382-4556-83d9-6a281a4ab6cc"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447639242395*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"2d9a807c-aeea-4dec-8c65-31702439c2d9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-point: e E \[Rule] A A", "Section",ExpressionUUID->"d558ce52-3760-403c-9119-c51dd4ebf6b5"],

Cell[CellGroupData[{

Cell["\<\
diags = CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", sm];
Length[diags] === 2\
\>", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"073f52f1-5917-478a-8dc1-e0fd779165c3"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447656382881*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"528f29d3-9713-42d6-9690-d5f52d553443"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
expectedKeys = {\"Graph\", \"ExternalAssignment\", \"InternalEdgeData\", \
\"InternalEdgeLabels\", \"InternalEdgeOrientation\", \"InternalVertices\", \
\"LeafVertices\", \"InternalEdgeIndices\", \"IncidentLegData\", \
\"VertexStructures\", \"Propagators\"};
Keys[diags[[1]]] === expectedKeys\
\>", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"b5e02827-ccde-4303-92f0-09c90fc3f664"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447680563562*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"fc2974d2-9260-4c45-8fb3-9dbe77bad7b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
And @@ {
  Sort[VertexList[diags[[1]][\"Graph\"]]] === Range[6],
  Length[EdgeList[diags[[1]][\"Graph\"]]] === 5,
  diags[[1]][\"InternalVertices\"] === {5, 6},
  diags[[1]][\"LeafVertices\"] === {1, 2, 3, 4},
  Length[Keys[diags[[1]][\"InternalEdgeLabels\"]]] === 1,
  diags[[1]][\"Propagators\"][UndirectedEdge[5, 6]][\"Particle\"] === \"e\",
  diags[[1]][\"Propagators\"][UndirectedEdge[5, 6]][\"Mass\"] === Me
}\
\>", "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"58bf9923-d70c-4cf4-b342-c969088a7ffc"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447686186968*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"8a251972-c599-4822-90f2-205c116f2d42"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
diags[[1]][\"ExternalAssignment\"] === <|
  1 -> <|\"Particle\" -> \"e\", \"ID\" -> 1, \"InputIndex\" -> 1|>,
  2 -> <|\"Particle\" -> \"E\", \"ID\" -> 1, \"InputIndex\" -> 2|>,
  3 -> <|\"Particle\" -> \"A.+\", \"ID\" -> 1, \"InputIndex\" -> 3|>,
  4 -> <|\"Particle\" -> \"A.+\", \"ID\" -> 2, \"InputIndex\" -> 4|>
|>\
\>", "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"289204bd-fa98-44a6-a2f4-6fe83c752064"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447690714487*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"2588e13d-be31-4385-a3fb-37e0e0e25f03"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
ampT = (-2 EE^2 SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Spin\", \
\"Lower\", \"Angle\", Multiparticle[2, 4], i1]] SpinorChain[Spinor[\"Spin\", \
\"Upper\", \"Angle\", Multiparticle[1, 3], i1], Spinor[\"Spin\", \"Angle\", \
2]] xFactor[1, Multiparticle[2, 4]] xFactor[Multiparticle[1, 3], \
2])/PropDen[Mom[Multiparticle[1, 3]], Me];
ampU = (-2 EE^2 SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Spin\", \
\"Lower\", \"Angle\", Multiparticle[2, 3], i1]] SpinorChain[Spinor[\"Spin\", \
\"Upper\", \"Angle\", Multiparticle[1, 4], i1], Spinor[\"Spin\", \"Angle\", \
2]] xFactor[1, Multiparticle[2, 3]] xFactor[Multiparticle[1, 4], \
2])/PropDen[Mom[Multiparticle[1, 4]], Me];
{diagramAmplitude[diags[[1]]], diagramAmplitude[diags[[2]]]} === {ampT, ampU}\
\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"01aa9717-f3ae-4709-80d5-1cc48e9c05db"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9974476955712852`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"26a2c4e8-31a6-46c3-8f0a-d4a2e7e0d568"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Length[diagramAmplitudes[diags]] === 2", "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"af32a12b-be96-49bd-a67e-aeaef47e1329"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447702100662*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"b4638bed-dc82-4e61-b6db-5c7f5b6eda2f"]
}, Open  ]],

