Cell[CellGroupData[{

Cell["Three-point and API edge cases", "Section",ExpressionUUID->"601b4af9-3b93-407f-a0d5-4489a0a7a53c"],

Cell[CellGroupData[{

Cell["\<\
d3 = CreateDiagrams[\"e\", \"E\", \"A.+\", sm];
And @@ {
  Length[d3] === 1,
  Sort[VertexList[d3[[1]][\"Graph\"]]] === Range[4],
  d3[[1]][\"InternalEdgeLabels\"] === <||>,
  diagramAmplitude[d3[[1]]] === -Sqrt[2] EE SpinorChain[Spinor[\"Spin\", \
\"Angle\", 1], Spinor[\"Spin\", \"Angle\", 2]] xFactor[1, 2]
}\
\>", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"6291b762-797d-4efc-acfd-a4f37a51f0f1"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.99744775325208*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"d8dbd451-a2c9-4bfc-ade4-0638952901a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
CreateDiagrams[{\"e\", \"E\", \"A.+\", \"A.+\"}, sm] === \
CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", sm]\
\>", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"34773a23-5311-4dd4-9025-afa48092b4e3"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447755319478*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"22370f1d-cc1f-463f-b963-8d770b435cdc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["CreateDiagrams[\"e\", \"E\", sm] === {}", "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"62b47722-acdc-4a30-975c-5382816c05a8"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447756481248*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"2556b7c5-4023-4b24-876c-cbddea8dece5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MatchQ[CreateArrowDiagrams[diags], {__Graphics}]", "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"1568bb03-a78e-4bef-a49c-5914a01d272a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447757607971*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"0f38af77-b805-466b-995b-9084a2241964"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Head @ CreateArrowDiagram[diags[[1]], \"ShowVertexExpressions\" -> True, \
\"ShowPropagatorExpressions\" -> True] === Graphics\
\>", "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"8b52915f-f21d-453f-b450-48d7b8c4e0f1"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447758693321*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"ad6f3c06-8869-4a24-83da-d4ec838eb427"]
}, Open  ]],

Cell["QED and SM agree on a pure-QED process.", "Text",ExpressionUUID->"afbe5d36-33ee-40c6-a0e7-3173dbb58a18"],

Cell[CellGroupData[{

Cell["\<\
Length @ CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", qed] === Length @ \
CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", sm]\
\>", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"1d01ddfe-1e74-4e5f-9607-3a46b909784d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447762151297*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"b6396837-008a-495d-bb35-700ad3fb22ec"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
