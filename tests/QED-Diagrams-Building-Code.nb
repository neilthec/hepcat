                    RowBox[{
                    RowBox[{"vertexRule", "[", "#1", "]"}], "->", "#2"}], " ",
                     "&"}], ",", "\[IndentingNewLine]", "\t                ", 
                    "#2"}], "\[IndentingNewLine]", "\t              ", 
                    "]"}]}]}]}], "\[IndentingNewLine]", "\t            ", 
                    "}"}], ",", "\[IndentingNewLine]", "\t            ", 
                    RowBox[{"newEdge", "->", 
                    RowBox[{"KeySort", "[", "newLabel", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t          ", "]"}], " ", "&"}], 
                  ",", "\[IndentingNewLine]", "\t          ", 
                  RowBox[{"diag", "[", "\"\<InternalEdgeLabels\>\"", "]"}]}], 
                 "\[IndentingNewLine]", "\t        ", "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", "\t        ", "\[IndentingNewLine]", 
             "\t        ", 
             RowBox[{"<|", "\[IndentingNewLine]", "\t          ", 
              RowBox[{
               RowBox[{"\"\<Graph\>\"", "->", 
                RowBox[{"CanonicalGraph", "[", "graph", "]"}]}], ",", 
               "\[IndentingNewLine]", "\t          ", 
               RowBox[{"\"\<ExternalAssignment\>\"", "->", "newExternal"}], ",",
                "\[IndentingNewLine]", "\t          ", 
               RowBox[{"\"\<InternalEdgeLabels\>\"", "->", "newInternal"}]}], 
              "\[IndentingNewLine]", "\t        ", "|>"}]}]}], 
           "\[IndentingNewLine]", "\t      ", "]"}]}], "\[IndentingNewLine]", 
         "\t    ", "]"}], ",", "\[IndentingNewLine]", "\t    ", 
        "automorphisms"}], "\[IndentingNewLine]", "\t  ", "]"}]}], ";", 
