 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Why MadGraph is so much faster\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"424f084c-963d-4fdd-8fa7-7afe66405df3"],
 "\nMadGraph does not: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "enumerate all external permutations blindly,"
 }], "InlineItem",ExpressionUUID->"c8c2b7d3-73fe-4fe5-9806-4978d8f8d7d7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "enumerate all internal particle assignments blindly,"
 }], "InlineItem",ExpressionUUID->"2a49bc78-efe0-4fc1-93f2-cfe1894b3514"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "match vertices by trying all local permutations,"
 }], "InlineItem",ExpressionUUID->"69b9e375-7df7-4fc0-ad25-52b2189e1e60"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "deduplicate only at the end."
 }], "InlineItem",ExpressionUUID->"7a521249-aa8c-454b-a2f9-23935b8a3c60"],
 "\nInstead it uses: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
