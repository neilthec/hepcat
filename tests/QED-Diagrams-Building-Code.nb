           "      ", "|>"}]}]}], "\[IndentingNewLine]", "    ", "]"}], ",", 
       "\[IndentingNewLine]", "    ", "particles"}], "\[IndentingNewLine]", 
      "  ", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
