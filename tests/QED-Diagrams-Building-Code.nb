      "\[IndentingNewLine]", "  ", 
      RowBox[{"DeleteDuplicates", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"Sort", " ", "/@", " ", 
        RowBox[{"Select", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
