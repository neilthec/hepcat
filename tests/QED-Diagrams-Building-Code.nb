              RowBox[{"internalEdgeLabels", "[", "edge", "]"}], "[", "vertex",
               "]"}]}]}], "\[IndentingNewLine]", "      ", "]"}]}], 
         "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
        "    ", "neighbors"}], "\[IndentingNewLine]", "  ", "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
