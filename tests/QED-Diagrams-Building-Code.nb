Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pruferDecode", "[", "seq_List", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "vertices", ",", "s", ",", 
       RowBox[{"edges", "=", 
        RowBox[{"{", "}"}]}], ",", "leaf"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{
        RowBox[{"Length", "[", "seq", "]"}], "+", "2"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"vertices", "=", 
       RowBox[{"Range", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"s", "=", "seq"}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"leaf", "=", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Complement", "[", 
            RowBox[{"vertices", ",", "s"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"edges", ",", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"leaf", ",", 
             RowBox[{"First", "[", "s", "]"}]}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"vertices", "=", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"vertices", ",", "leaf"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"s", "=", 
          RowBox[{"Rest", "[", "s", "]"}]}], ";"}], "\[IndentingNewLine]", 
        "    ", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "seq", "]"}], "}"}]}], "\[IndentingNewLine]", 
       "  ", "]"}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"edges", ",", 
        RowBox[{"UndirectedEdge", " ", "@@", " ", "vertices"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", "edges"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"makeTopologySkeletons", "[", 
   RowBox[{"valenceCount_Association", ",", "nExternal_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", "    ", 
     RowBox[{
     "internalDegrees", ",", "nInternal", ",", "internalVerts", ",", 
      "leafVerts", ",", "\[IndentingNewLine]", "    ", "allVerts", ",", 
      "targetDegrees", ",", "pruferMultiset", ",", "pruferSeqs"}], 
     "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"internalDegrees", "=", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"#1", ",", "#2"}], "]"}], " ", "&"}], ",", 
         "valenceCount"}], "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"nInternal", "=", 
      RowBox[{"Length", "[", "internalDegrees", "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"internalVerts", "=", 
      RowBox[{"Range", "[", "nInternal", "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"leafVerts", "=", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"nInternal", "+", "1"}], ",", 
        RowBox[{"nInternal", "+", "nExternal"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"allVerts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"internalVerts", ",", "leafVerts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"targetDegrees", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"internalDegrees", ",", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"1", ",", "nExternal"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", "targetDegrees", "]"}], "=!=", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"Length", "[", "allVerts", "]"}]}], "-", "2"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"pruferMultiset", "=", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{"ConstantArray", ",", 
         RowBox[{"{", 
          RowBox[{"allVerts", ",", 
           RowBox[{"targetDegrees", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"pruferSeqs", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Permutations", "[", "pruferMultiset", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"DeleteDuplicatesBy", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"pruferDecode", " ", "/@", " ", "pruferSeqs"}], ",", 
       "\[IndentingNewLine]", "    ", "CanonicalGraph"}], 
      "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"b1e09183-d59b-4229-b30f-7fea6ee6781c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeTopologySkeletons", "[", 
