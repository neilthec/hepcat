 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
         "internalEdgeOrientationData", "[", "\[IndentingNewLine]", "\t  ", 
          
          RowBox[{"internalEdgeLabels_Association", ",", 
            "\[IndentingNewLine]", "\t  ", "antiParticleRules_Association"}], 
          "\[IndentingNewLine]", "\t", "]"}], ":=", 
        RowBox[{"Association", " ", "@", " ", 
          RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"Function", "[", 
                RowBox[{
                  RowBox[{"{", 
                    RowBox[{"edge", ",", "labels"}], "}"}], ",", 
                  "\[IndentingNewLine]", "\t    ", 
                  RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", "v", ",", "pu", ",", "pv"}], "}"}], ",",
                     "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", "v"}], "}"}], "=", 
                    RowBox[{"List", " ", "@@", " ", "edge"}]}], ";", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"pu", "=", 
                    RowBox[{"labels", "[", "u", "]"}]}], ";", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"pv", "=", 
                    RowBox[{"labels", "[", "v", "]"}]}], ";", 
                    "\[IndentingNewLine]", "\t      ", "\[IndentingNewLine]", 
                    "\t      ", 
                    RowBox[{"edge", "->", 
                    RowBox[{"Which", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{"antiParticleRules", ",", "pu", ",", "None"}], 
                    "]"}], "===", "pv"}], ",", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t          ", 
                    RowBox[{
                    RowBox[{"\"Particle\"", "->", "pu"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"\"Antiparticle\"", "->", "pv"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
