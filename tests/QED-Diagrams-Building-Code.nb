Cell[CellGroupData[{

Cell["Five-point: e E \[Rule] A A A", "Section",ExpressionUUID->"9fb57092-6caa-43b8-aa37-857fa568573f"],

Cell[CellGroupData[{

Cell["\<\
diags5 = CreateDiagrams[\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", sm];
Length[diags5] === 6\
\>", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"a4fd5d9c-11c4-4924-9a1d-737ea2ef3269"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447718116296*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"acbee3e5-6267-44b5-addf-7754b6b15b75"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
amp5 = (-2 Sqrt[2] EE^3 SpinorChain[Spinor[\"Spin\", \"Angle\", 1], \
Spinor[\"Spin\", \"Lower\", \"Angle\", Multiparticle[2, 4, 5], i1]] \
SpinorChain[Spinor[\"Spin\", \"Upper\", \"Angle\", Multiparticle[1, 3], i1], \
Spinor[\"Spin\", \"Lower\", \"Angle\", Multiparticle[2, 5], i2]] \
SpinorChain[Spinor[\"Spin\", \"Upper\", \"Angle\", Multiparticle[1, 3, 4], \
i2], Spinor[\"Spin\", \"Angle\", 2]] xFactor[1, Multiparticle[2, 4, 5]] \
xFactor[Multiparticle[1, 3], Multiparticle[2, 5]] xFactor[Multiparticle[1, 3, \
4], 2])/(PropDen[Mom[Multiparticle[1, 3]], Me] PropDen[Mom[Multiparticle[1, \
3, 4]], Me]);
diagramAmplitude[diags5[[1]]] === amp5\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"f5cec008-b744-4cf7-9e4e-6bfedcdf47de"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997447721321212*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"10f5abbf-4196-44d3-8952-a9836de56a13"]
}, Open  ]],

