            RowBox[{"skeleton", ",", "#"}], "]"}], "==", "1"}], " ", "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"internalVerts", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "skeleton", "]"}], ",", "leafVerts"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", 
