 RowBox[{
  RowBox[{
   RowBox[{"tagParticles", "[", "particles_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"seen", "=", 
       RowBox[{"<|", "|>"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"seen", "[", "p", "]"}], "=", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"seen", ",", "p", ",", "0"}], "]"}], "+", "1"}]}], ";", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"<|", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"\"\<Particle\>\"", "->", "p"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<ID\>\"", "->", 
             RowBox[{"seen", "[", "p", "]"}]}], ",", "\[IndentingNewLine]", 
            "        ", 
            RowBox[{"\"\<InputIndex\>\"", "->", 
