Cell[BoxData[
 RowBox[{
  RowBox[{"makeTopologySkeletons", "[", 
   RowBox[{"valenceCount_Association", ",", "nExternal_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", "    ", 
     RowBox[{
     "internalDegrees", ",", "\[IndentingNewLine]", "    ", "nInternal", ",", 
      "\[IndentingNewLine]", "    ", "internalVerts", ",", 
      "\[IndentingNewLine]", "    ", "leafVerts", ",", "\[IndentingNewLine]", 
      "    ", "allVerts", ",", "\[IndentingNewLine]", "    ", "allEdges", ",",
       "\[IndentingNewLine]", "    ", "targetDegreeSorted"}], 
     "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"internalDegrees", "=", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"#1", ",", "#2"}], "]"}], " ", "&"}], ",", 
         "valenceCount"}], "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"nInternal", "=", 
      RowBox[{"Length", "[", "internalDegrees", "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"internalVerts", "=", 
      RowBox[{"Range", "[", "nInternal", "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"leafVerts", "=", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"nInternal", "+", "1"}], ",", 
        RowBox[{"nInternal", "+", "nExternal"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"allVerts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"internalVerts", ",", "leafVerts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"allEdges", "=", 
      RowBox[{"UndirectedEdge", " ", "@@@", " ", 
       RowBox[{"Subsets", "[", 
        RowBox[{"allVerts", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"targetDegreeSorted", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Join", "[", 
        RowBox[{"internalDegrees", ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", "nExternal"}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"DeleteDuplicatesBy", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Select", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Graph", "[", 
            RowBox[{"allVerts", ",", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"Subsets", "[", 
           RowBox[{"allEdges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", "allVerts", "]"}], "-", "1"}], "}"}]}], 
           "]"}]}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"Function", "[", 
          RowBox[{"g", ",", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"ConnectedGraphQ", "[", "g", "]"}], "&&", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"AcyclicGraphQ", "[", "g", "]"}], "&&", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"Sort", "[", 
              RowBox[{"VertexDegree", "[", "g", "]"}], "]"}], "===", 
             "targetDegreeSorted"}], "&&", "\[IndentingNewLine]", "        ", 
            
            RowBox[{"AllTrue", "[", 
             RowBox[{"leafVerts", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"VertexDegree", "[", 
                 RowBox[{"g", ",", "#"}], "]"}], "==", "1"}], " ", "&"}]}], 
             "]"}]}]}], "\[IndentingNewLine]", "      ", "]"}]}], 
        "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
       "    ", "CanonicalGraph"}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"e11e36a5-a331-4cb2-bfc6-57f9bdbabc04"],

