Cell[BoxData[
 RowBox[{
  RowBox[{"topologyVertexCounts", "[", 
   RowBox[{"nExternal_Integer", ",", "valences_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"countVars", ",", "solutions"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"countVars", "=", 
      RowBox[{"Array", "[", 
       RowBox[{"counts", ",", 
        RowBox[{"Length", "[", "valences", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"solutions", "=", 
      RowBox[{"Solve", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"countVars", ".", 
          RowBox[{"(", 
           RowBox[{"valences", "-", "2"}], ")"}]}], "==", 
         RowBox[{"nExternal", "-", "2"}]}], ",", "\[IndentingNewLine]", 
        "    ", "countVars", ",", "\[IndentingNewLine]", "    ", 
        "NonNegativeIntegers"}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"SortBy", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{"valences", ",", "countVars"}], "]"}], " ", "/.", " ", 
        "solutions"}], ",", "\[IndentingNewLine]", "    ", "Normal"}], 
      "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
  "In[325]:=",ExpressionUUID->"13f7d9f5-c300-4fc7-b7fb-ffc739efa5ae"],

