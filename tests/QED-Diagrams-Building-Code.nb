         RowBox[{"internalDegrees", ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", "nExternal"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "      ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", "targetDegrees", "]"}], "=!=", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"Length", "[", "allVerts", "]"}]}], "-", "2"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{"pruferMultiset", "=", 
        RowBox[{"Flatten", " ", "@", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{"ConstantArray", ",", 
           RowBox[{"{", 
            RowBox[{"allVerts", ",", 
             RowBox[{"targetDegrees", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "      ", 
       RowBox[{"pruferSeqs", "=", 
        RowBox[{"DeleteDuplicates", "[", 
