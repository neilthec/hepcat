 }], "InlineItem",ExpressionUUID->"bd539972-5d7b-452b-9403-f028e6dd5e1c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
