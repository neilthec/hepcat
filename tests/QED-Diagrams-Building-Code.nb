  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vertexParticles", "[", 
    RowBox[{"vertexRow_", ",", "validParticles_List"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
