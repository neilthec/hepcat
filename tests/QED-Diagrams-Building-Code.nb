    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"1a68bc68-e9c7-41cc-b518-ace3aef0a06f"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Better: create particle-antiparticle tags when assigning \
internal edges\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"702236b8-f5dd-4150-8e2f-0f98ef219120"],
 "\nYour ",
 Cell[BoxData[
  TemplateBox[{
    Cell["internalEdgeAssignments", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "81ae9e1d-8cf9-440b-84c4-5b905fd0dbfb"],
 " currently builds: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"<|", 
        RowBox[{"edge", "->", 
          RowBox[{"<|", 
            RowBox[{
              RowBox[{"u", "->", "particle"}], ",", 
              RowBox[{"v", "->", "anti"}]}], "|>"}]}], "|>"}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "a7259268-777c-48d3-a64a-c71a5f63e9a2"],
 "\nThat is exactly where the orientation is known. So instead of storing \
only endpoint labels, store richer endpoint data there.\n\nFor example: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"internalEdgeAssignments", "[", "\[IndentingNewLine]", "\t  ", 
          
          RowBox[{"internalEdges_List", ",", "\[IndentingNewLine]", "\t  ", 
            "particleTypes_List", ",", "\[IndentingNewLine]", "\t  ", 
            "antiParticleRules_Association"}], "\[IndentingNewLine]", "\t", 
          "]"}], ":=", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", "\t  ", 
          RowBox[{
            RowBox[{"{", "choicesPerEdge", "}"}], ",", "\[IndentingNewLine]", 
            "\t  ", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"choicesPerEdge", "=", 
                RowBox[{
                  RowBox[{"Function", "[", 
                    RowBox[{"edge", ",", "\[IndentingNewLine]", "\t    ", 
                    RowBox[{"DeleteDuplicates", " ", "@", " ", 
                    RowBox[{"Flatten", "[", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{"Table", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"anti", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"antiParticleRules", ",", "particle", ",", 
                    RowBox[{"Missing", "[", "\"NotFound\"", "]"}]}], "]"}]}], 
                    "}"}], ",", "\[IndentingNewLine]", "\t          ", 
                    
                    RowBox[{"If", "[", "\[IndentingNewLine]", 
                    "\t            ", 
                    RowBox[{
                    RowBox[{"MissingQ", "[", "anti", "]"}], ",", 
                    "\[IndentingNewLine]", "\t            ", 
                    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
                    "\t            ", 
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ends", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{"List", " ", "@@", " ", "edge"}], "]"}]}], "}"}], 
                    ",", "\[IndentingNewLine]", "\t              ", 
                    
                    RowBox[{"{", "\[IndentingNewLine]", "\t                ", 
                    
                    RowBox[{
                    
                    RowBox[{"<|", "\[IndentingNewLine]", 
                    "\t                  ", 
                    RowBox[{
                    RowBox[{"\"EndpointLabels\"", "->", 
                    RowBox[{"AssociationThread", "[", 
                    RowBox[{"ends", ",", 
                    RowBox[{"{", 
                    RowBox[{"particle", ",", "anti"}], "}"}]}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"Particle\"", "->", "particle"}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"Antiparticle\"", "->", "anti"}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"ParticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"AntiparticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]",
                     "\t                ", "|>"}], ",", "\[IndentingNewLine]",
                     "\t                ", 
                    
                    RowBox[{"<|", "\[IndentingNewLine]", 
                    "\t                  ", 
                    RowBox[{
                    RowBox[{"\"EndpointLabels\"", "->", 
                    RowBox[{"AssociationThread", "[", 
                    RowBox[{"ends", ",", 
                    RowBox[{"{", 
                    RowBox[{"anti", ",", "particle"}], "}"}]}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"Particle\"", "->", "particle"}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"Antiparticle\"", "->", "anti"}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"ParticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "\t                  ", 
                    RowBox[{"\"AntiparticleVertex\"", "->", 
                    RowBox[{"ends", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]",
                     "\t                ", "|>"}]}], "\[IndentingNewLine]", 
                    "\t              ", "}"}]}], "\[IndentingNewLine]", 
                    "\t            ", "]"}]}], "\[IndentingNewLine]", 
                    "\t          ", "]"}]}], "\[IndentingNewLine]", 
                    "\t        ", "]"}], ",", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{"{", 
                    RowBox[{"particle", ",", "particleTypes"}], "}"}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}], ",", 
                    "\[IndentingNewLine]", "\t      ", "1"}], 
                    "\[IndentingNewLine]", "\t    ", "]"}]}]}], 
                    "\[IndentingNewLine]", "\t  ", "]"}], " ", "/@", " ", 
                  "internalEdges"}]}], ";", "\[IndentingNewLine]", "\t  ", 
              "\[IndentingNewLine]", "\t  ", 
              RowBox[{
                RowBox[{
                  RowBox[{"AssociationThread", "[", 
                    RowBox[{"internalEdges", ",", "#"}], "]"}], " ", "&"}], 
                " ", "/@", " ", 
                RowBox[{"Tuples", "[", "choicesPerEdge", "]"}]}]}]}], 
          "\[IndentingNewLine]", "\t", "]"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "dcd6e099-853c-40b4-8b8b-ff9be095af2b"],
 "\nThen each edge assignment contains all the information you need. \n",
