           RowBox[{"VertexDegree", "[", 
            RowBox[{"g", ",", "v"}], "]"}], "==", "3"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"leafNeighbors", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", "degree3Vertex"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"VertexDegree", "[", 
            RowBox[{"g", ",", "#"}], "]"}], "==", "1"}], " ", "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"internalNeighbor", "=", 
