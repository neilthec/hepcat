            RowBox[{
             RowBox[{"vertexRule", "=", 
              RowBox[{"Association", "[", "ruleList", "]"}]}], ";", 
             "\[IndentingNewLine]", "\t        ", "\[IndentingNewLine]", 
             "\t        ", 
             RowBox[{"newExternal", "=", 
              RowBox[{"KeySort", " ", "@", " ", 
               RowBox[{"Association", " ", "@", " ", 
                RowBox[{
                "KeyValueMap", "[", "\[IndentingNewLine]", "\t          ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"vertexRule", "[", "#1", "]"}], "->", "#2"}], " ",
                    "&"}], ",", "\[IndentingNewLine]", "\t          ", 
                  RowBox[{"diag", "[", "\"\<ExternalAssignment\>\"", "]"}]}], 
                 "\[IndentingNewLine]", "\t        ", "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", "\t        ", "\[IndentingNewLine]", 
             "\t        ", 
             RowBox[{"newInternal", "=", 
              RowBox[{"KeySort", " ", "@", " ", 
               RowBox[{"Association", " ", "@", " ", 
                RowBox[{
                "KeyValueMap", "[", "\[IndentingNewLine]", "\t          ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "With", "[", "\[IndentingNewLine]", "\t            ", 
                    RowBox[{
                    RowBox[{"{", "\[IndentingNewLine]", "\t              ", 
                    RowBox[{
                    RowBox[{"newEdge", "=", 
                    RowBox[{"UndirectedEdge", " ", "@@", " ", 
                    RowBox[{"Sort", "[", 
                    RowBox[{"vertexRule", " ", "/@", " ", 
                    RowBox[{"List", " ", "@@", " ", "#1"}]}], "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "\t              ", 
                    RowBox[{"newLabel", "=", 
