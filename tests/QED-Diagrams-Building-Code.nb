 }], "InlineItem",ExpressionUUID->"e34a7aa1-7aa1-4c56-8f4a-e9c9f2415a51"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
