Cell[BoxData[
 RowBox[{
  RowBox[{"vertexIncidentParticles", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "graph_", ",", "\[IndentingNewLine]", "  ", "vertex_", ",", 
    "\[IndentingNewLine]", "  ", "externalMap_Association", ",", 
    "\[IndentingNewLine]", "  ", "internalEdgeLabels_Association"}], 
   "\[IndentingNewLine]", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"neighbors", ",", "edge"}], "}"}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{
     RowBox[{"neighbors", "=", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"graph", ",", "vertex"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"Map", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"neighbor", ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"If", "[", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"KeyExistsQ", "[", 
             RowBox[{"externalMap", ",", "neighbor"}], "]"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"externalMap", "[", 
             RowBox[{"neighbor", ",", "\"\<Particle\>\""}], "]"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"edge", "=", 
              RowBox[{"UndirectedEdge", " ", "@@", " ", 
               RowBox[{"Sort", "[", 
                RowBox[{"{", 
                 RowBox[{"vertex", ",", "neighbor"}], "}"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"internalEdgeLabels", "[", "edge", "]"}], "[", "vertex",
               "]"}]}]}], "\[IndentingNewLine]", "      ", "]"}]}], 
         "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
        "    ", "neighbors"}], "\[IndentingNewLine]", "  ", "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.996928423378137*^9, 3.9969284540091257`*^9}, {
