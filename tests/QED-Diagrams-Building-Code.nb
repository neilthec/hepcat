Cell[CellGroupData[{

Cell["\<\
The particle and antiparticle information should already be present in the \
diagram.  It can be obtained from the model.   In the model, the 2nd entry is \
the particle name and the third particle is the antiparticle name.  So, the \
code already knows this when it creates the diagram.  Perhaps we need to add \
some sort of tag in the diagram to help the amplitude construction.\
\>", "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellLabel->
  "In[318]:=",ExpressionUUID->"7d4ccc18-d122-47d0-b6ac-e5ce41706c58"],

Cell[TextData[{
 "Yes \[LongDash] that is the right fix.\n\nRather than re-deriving particle \
vs antiparticle during amplitude construction, you should store that \
information explicitly in the diagram when you build the internal edge \
labels. Then the amplitude code becomes simple and reliable. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Best approach\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"4a15715f-15c4-4a9d-be28-93c57a775669"],
 "\nAugment each internal edge in the diagram with metadata like: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "which endpoint is the ",
  StyleBox["particle",
   FontWeight->Bold],
  " end"
 }], "InlineItem",ExpressionUUID->"b3625fe1-1459-4e23-88c8-beb6ee82e147"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "which endpoint is the ",
  StyleBox["antiparticle",
   FontWeight->Bold],
  " end"
 }], "InlineItem",ExpressionUUID->"c90ac508-3ce6-42df-a391-0e450b8bee04"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "what the particle name is"
 }], "InlineItem",ExpressionUUID->"bc795bf6-29dc-4454-a9fe-6a468731568e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "what the antiparticle name is"
 }], "InlineItem",ExpressionUUID->"495d2ee3-8c56-4bf1-aad2-f69e545ed0d3"],
 "\nThen later the spinor-index code can just ask: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "is this vertex the particle end? ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Rule]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\to", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "f763fe6d-5157-4632-ba21-2506894c6d03"],
  " use ",
  Cell[BoxData["\"\<Upper\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "e0aa8ce7-323d-4d95-a04f-f7d38b2c5a2f"]
 }], "InlineItem",ExpressionUUID->"60d13639-70b7-46ca-a3a2-67e17db54668"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "is this vertex the antiparticle end? ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Rule]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\to", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "565a7412-a5f2-4ba0-9ac6-fd9370e2b54d"],
  " use ",
  Cell[BoxData["\"\<Lower\>\""], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "de71a080-7f24-442f-8bce-3724dc57e558"]
 }], "InlineItem",ExpressionUUID->"5ecdf978-74d2-43dd-977e-12e0a3b7e0c2"],
 "\nThat is much better than inferring it afterwards. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"5bc38dba-bf14-4b7f-9d2e-70979cc78811"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Suggested change: enrich propagator data\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ae1e9522-d064-40ee-926a-1846ed99f372"],
 "\nRight now your ",
 Cell[BoxData[
  TemplateBox[{
    Cell["internalPropagatorData", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "4a696dba-4a02-4a6f-9d43-abea61dd56f8"],
 " stores something like: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"<|", "\[IndentingNewLine]", "  ", 
        RowBox[{"edge", "->", 
          RowBox[{"<|", "\[IndentingNewLine]", "    ", 
            RowBox[{
              RowBox[{"\"Particle\"", "->", "particle"}], ",", 
              "\[IndentingNewLine]", "    ", 
              RowBox[{"\"Index\"", "->", "index"}], ",", 
              "\[IndentingNewLine]", "    ", 
              RowBox[{"\"Mass\"", "->", "mass"}], ",", "\[IndentingNewLine]", 
              "    ", 
              RowBox[{"\"Factor\"", "->", "..."}]}], "\[IndentingNewLine]", 
            "  ", "|>"}]}], "\[IndentingNewLine]", "|>"}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "4bf74390-4a66-427a-b755-72270a0453f3"],
 "\nModify it so it also stores endpoint orientation information from ",
 Cell[BoxData[
  TemplateBox[{
    Cell["internalEdgeLabels", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "a4a7ba2f-37bf-46ec-a27d-c867ed06cad6"],
 ": \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
         "internalPropagatorData", "[", "\[IndentingNewLine]", "\t  ", 
          
          RowBox[{"graph_", ",", "\[IndentingNewLine]", "\t  ", 
            "internalEdgeLabels_Association", ",", "\[IndentingNewLine]", 
            "\t  ", "internalEdgeIndices_Association", ",", 
            "\[IndentingNewLine]", "\t  ", "particleMassRules_Association"}], 
          "\[IndentingNewLine]", "\t", "]"}], ":=", 
        RowBox[{"Association", " ", "@", " ", 
          RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "\t  ", 
            RowBox[{
              RowBox[{"Function", "[", 
                RowBox[{
                  RowBox[{"{", 
                    RowBox[{"edge", ",", "endpointParticleLabels"}], "}"}], 
                  ",", "\[IndentingNewLine]", "\t    ", 
                  RowBox[{"Module", "[", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{"{", "\[IndentingNewLine]", "\t        ", 
                    
                    RowBox[{
                    "particle", ",", "antiParticle", ",", "index", ",", 
                    "mass", ",", "particleVertex", ",", 
                    "antiParticleVertex"}], "\[IndentingNewLine]", "\t      ",
                     "}"}], ",", "\[IndentingNewLine]", "\t      ", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{
                    RowBox[{"particle", "=", 
                    RowBox[{"First", "[", 
                    RowBox[{"Values", "[", "endpointParticleLabels", "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"antiParticle", "=", 
                    RowBox[{"Last", "[", 
                    RowBox[{"Values", "[", "endpointParticleLabels", "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"index", "=", 
                    RowBox[{"First", "[", 
                    RowBox[{"Values", "[", 
                    RowBox[{"internalEdgeIndices", "[", "edge", "]"}], "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"mass", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"particleMassRules", ",", "particle", ",", 
                    RowBox[{"Missing", "[", "\"MassNotFound\"", "]"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "\t      ", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"particleVertex", "=", 
                    
                    RowBox[{
                    "FirstCase", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"Keys", "[", "endpointParticleLabels", "]"}], ",",
                     "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"v_", " ", "/;", " ", 
                    RowBox[{
                    RowBox[{"endpointParticleLabels", "[", "v", "]"}], "===", 
                    "particle"}]}]}], "\[IndentingNewLine]", "\t      ", 
                    "]"}]}], ";", "\[IndentingNewLine]", "\t      ", 
                    "\[IndentingNewLine]", "\t      ", 
                    RowBox[{"antiParticleVertex", "=", 
                    
                    RowBox[{
                    "FirstCase", "[", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"Keys", "[", "endpointParticleLabels", "]"}], ",",
                     "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"v_", " ", "/;", " ", 
                    RowBox[{"v", "=!=", "particleVertex"}]}]}], 
                    "\[IndentingNewLine]", "\t      ", "]"}]}], ";", 
                    "\[IndentingNewLine]", "\t      ", "\[IndentingNewLine]", 
                    "\t      ", 
                    RowBox[{"edge", "->", 
                    RowBox[{"<|", "\[IndentingNewLine]", "\t        ", 
                    RowBox[{
                    RowBox[{"\"Particle\"", "->", "particle"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"Antiparticle\"", "->", "antiParticle"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"ParticleVertex\"", "->", "particleVertex"}], 
                    ",", "\[IndentingNewLine]", "\t        ", 
                    
                    RowBox[{"\"AntiparticleVertex\"", "->", 
                    "antiParticleVertex"}], ",", "\[IndentingNewLine]", 
                    "\t        ", 
                    RowBox[{"\"Index\"", "->", "index"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"Mass\"", "->", "mass"}], ",", 
                    "\[IndentingNewLine]", "\t        ", 
                    RowBox[{"\"Factor\"", "->", 
                    
                    RowBox[{"If", "[", "\[IndentingNewLine]", "\t          ", 
                    
                    RowBox[{
                    RowBox[{"MissingQ", "[", "mass", "]"}], ",", 
                    "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"Missing", "[", 
                    RowBox[{"\"MassNotFound\"", ",", "particle"}], "]"}], ",",
                     "\[IndentingNewLine]", "\t          ", 
                    RowBox[{"I", "/", 
                    RowBox[{"PropDen", "[", 
                    RowBox[{
                    RowBox[{"Mom", "[", "index", "]"}], ",", "mass"}], 
                    "]"}]}]}], "\[IndentingNewLine]", "\t        ", "]"}]}]}],
                     "\[IndentingNewLine]", "\t      ", "|>"}]}]}]}], 
                    "\[IndentingNewLine]", "\t    ", "]"}]}], 
                "\[IndentingNewLine]", "\t  ", "]"}], ",", 
              "\[IndentingNewLine]", "\t  ", "internalEdgeLabels"}], 
            "\[IndentingNewLine]", "\t", "]"}]}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "3c13d2b8-62b8-40f9-adda-dc1941f7f11b"],
 "\nBut this version is still slightly unsafe because ",
 Cell[BoxData[
  RowBox[{"First", "[", 
   RowBox[{"Values", "[", "...", "]"}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "bd88ec62-f5a5-4a0e-a7da-a57439e16d45"],
 " depends on association ordering.\n\nSo better is to explicitly derive \
particle/antiparticle using the model relation. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
