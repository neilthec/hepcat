Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"particleNames", "[", "model_", "]"}], ":=", 
   RowBox[{"DeleteDuplicates", " ", "@", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"model", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "All", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vertexParticles", "[", 
    RowBox[{"vertexRow_", ",", "validParticles_List"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"TakeWhile", "[", 
    RowBox[{"vertexRow", ",", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{"validParticles", ",", "#"}], "]"}], " ", "&"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modelVertices", "[", "model_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "validParticles", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"validParticles", "=", 
       RowBox[{"particleNames", "[", "model", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"DeleteDuplicates", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"Sort", " ", "/@", " ", 
        RowBox[{"Select", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"vertexParticles", "[", 
             RowBox[{"#", ",", "validParticles"}], "]"}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"model", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], ">=", "3"}], " ", "&"}]}], 
         "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ", 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
