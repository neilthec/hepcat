Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "topologyData", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"topologyData", "[", "graph_", "]"}], ":=", 
   RowBox[{
    RowBox[{"topologyData", "[", "graph", "]"}], "=", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "leafVerts", ",", "internalVerts", ",", "internalEdges", ",", 
        "splitLeafIndices"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"leafVerts", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "graph", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"VertexDegree", "[", 
             RowBox[{"graph", ",", "#"}], "]"}], "==", "1"}], " ", "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "    ", 
       RowBox[{"internalVerts", "=", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "graph", "]"}], ",", "leafVerts"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "    ", 
       RowBox[{"internalEdges", "=", 
        RowBox[{"Select", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"EdgeList", "[", "graph", "]"}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{
           RowBox[{"FreeQ", "[", 
            RowBox[{"leafVerts", ",", 
             RowBox[{"Alternatives", " ", "@@", " ", 
              RowBox[{"(", 
               RowBox[{"List", " ", "@@", " ", "#"}], ")"}]}]}], "]"}], " ", 
           "&"}]}], "\[IndentingNewLine]", "    ", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "    ", 
       RowBox[{"splitLeafIndices", "=", 
        RowBox[{"Association", " ", "@", " ", 
         RowBox[{"Map", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"edge", ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "u", ",", "v", ",", "comps", ",", "compU", ",", "compV"}], 
                "}"}], ",", "\[IndentingNewLine]", "          ", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"u", ",", "v"}], "}"}], "=", 
                 RowBox[{"List", " ", "@@", " ", "edge"}]}], ";", 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"comps", "=", 
                 RowBox[{"ConnectedComponents", "[", 
                  RowBox[{"EdgeDelete", "[", 
                   RowBox[{"graph", ",", "edge"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"compU", "=", 
                 RowBox[{"SelectFirst", "[", 
                  RowBox[{"comps", ",", 
                   RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"#", ",", "u"}], "]"}], " ", "&"}]}], "]"}]}], ";",
                 "\[IndentingNewLine]", "          ", 
                RowBox[{"compV", "=", 
                 RowBox[{"SelectFirst", "[", 
                  RowBox[{"comps", ",", 
                   RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"#", ",", "v"}], "]"}], " ", "&"}]}], "]"}]}], ";",
                 "\[IndentingNewLine]", "          ", 
                RowBox[{"edge", "->", 
                 RowBox[{"<|", "\[IndentingNewLine]", "            ", 
                  RowBox[{
                   RowBox[{"u", "->", 
                    RowBox[{"Intersection", "[", 
                    RowBox[{"compV", ",", "leafVerts"}], "]"}]}], ",", 
                   "\[IndentingNewLine]", "            ", 
                   RowBox[{"v", "->", 
                    RowBox[{"Intersection", "[", 
                    RowBox[{"compU", ",", "leafVerts"}], "]"}]}]}], 
                  "\[IndentingNewLine]", "          ", "|>"}]}]}]}], 
              "\[IndentingNewLine]", "        ", "]"}]}], 
            "\[IndentingNewLine]", "      ", "]"}], ",", 
           "\[IndentingNewLine]", "      ", "internalEdges"}], 
          "\[IndentingNewLine]", "    ", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"\"\<LeafVertices\>\"", "->", "leafVerts"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<InternalVertices\>\"", "->", "internalVerts"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<InternalEdges\>\"", "->", "internalEdges"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<SplitLeafVertices\>\"", "->", "splitLeafIndices"}]}], 
        "\[IndentingNewLine]", "    ", "|>"}]}]}], "\[IndentingNewLine]", 
     "  ", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"7bf89fb2-b886-46c8-84a4-77ed0e3b0eb7"],

