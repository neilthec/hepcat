Cell[CellGroupData[{

Cell["Export eeAAA to C++", "Section",ExpressionUUID->"274cde2f-9a1a-558e-917c-f3de4e3d1581"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"6386a579-cc77-535c-9756-b9fc3a4bc5fb"],

Cell[CellGroupData[{

Cell["\<\
eeAAAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeAAA\"}],
  {\"e\", \"E\"} -> {\"A\", \"A\", \"A\"},
  {
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\"}, qed5PPP},
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\"}, qed5PPM},
    {{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\"}, qed5PMM},
    {{\"e\", \"E\", \"A.-\", \"A.-\", \"A.-\"}, qed5MMM}
  }, factorizationModel,
  \"ProcessName\" -> \"eeAAA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
