Cell[CellGroupData[{

Cell["A Verified All-Physical Formula", "Section",
 CellTags->
  "QEDSixPointPPMMExplicitReference",ExpressionUUID->"9663237e-11d6-470d-84e2-\
b4737d9aee07"],

Cell["\<\
This explicit formula has complexity 2102. It is the simplest all-physical \
form currently retained for this example, with no claim of a global minimum. \
All 17 checks pass at the model electron mass and at twice that mass, \
including the 14 physical channels, high-energy behavior, reference \
independence and independent Feynman agreement; no spurious denominators \
remain. The assignment below supplies qed6PPMM to the later checks and C++ \
export. The automatic construction result remains displayed above.\
\>", "Text",ExpressionUUID->"bd439ad6-4e92-448d-90e6-a8436ff07390"],

Cell[CellGroupData[{

Cell["\<\
qed6PPMM = With[{modelMass = ModelParameter[factorizationModel, \"Me\"],
  modelCharge = ModelParameter[factorizationModel, \"EE\"]},
(-4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
     Spinor[\"Helicity\", \"Square\", 4]]^2*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 1], 
    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 2], 
    Spinor[\"Helicity\", \"Angle\", 5]])/(PropDen[Mom[Multiparticle[1, 3]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 6]], modelMass]*PropDen[Mom[Multiparticle[2, \
5]], modelMass]*
   PropDen[Mom[Multiparticle[1, 3, 4]], modelMass]) - 
 (4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
     Spinor[\"Helicity\", \"Square\", 4]]^2*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 1], 
    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 2], 
    Spinor[\"Helicity\", \"Angle\", 5]])/(PropDen[Mom[Multiparticle[1, 4]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 6]], modelMass]*PropDen[Mom[Multiparticle[2, \
5]], modelMass]*
   PropDen[Mom[Multiparticle[1, 3, 4]], modelMass]) + 
 (4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
     Spinor[\"Helicity\", \"Square\", 4]]^2*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 1], 
    Spinor[\"Helicity\", \"Angle\", 5]]*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 2], 
    Spinor[\"Helicity\", \"Angle\", 6]])/(PropDen[Mom[Multiparticle[1, 3]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 5]], modelMass]*PropDen[Mom[Multiparticle[2, \
6]], modelMass]*
   PropDen[Mom[Multiparticle[1, 3, 4]], modelMass]) + 
 (4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
     Spinor[\"Helicity\", \"Square\", 4]]^2*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 1], 
    Spinor[\"Helicity\", \"Angle\", 5]]*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 2], 
    Spinor[\"Helicity\", \"Angle\", 6]])/(PropDen[Mom[Multiparticle[1, 4]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 5]], modelMass]*PropDen[Mom[Multiparticle[2, \
6]], modelMass]*
   PropDen[Mom[Multiparticle[1, 3, 4]], modelMass]) - 
 (4*modelCharge^4*modelMass^2*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], \

    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
     Spinor[\"Helicity\", \"Square\", 4]]^2*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 2], 
    Spinor[\"Helicity\", \"Angle\", 6]]*
   (-(modelMass*SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Helicity\
\", \"Angle\", 5]]) + 
    SpinorChain[Spinor[\"Helicity\", \"Angle\", 3], Spinor[\"Helicity\", \
\"Angle\", 5]]*
     SpinorChain[Spinor[\"Spin\", \"Square\", 1], Spinor[\"Helicity\", \
\"Square\", 3]] + 
    SpinorChain[Spinor[\"Helicity\", \"Angle\", 4], Spinor[\"Helicity\", \
\"Angle\", 5]]*
     SpinorChain[Spinor[\"Spin\", \"Square\", 1], Spinor[\"Helicity\", \
\"Square\", 4]]))/
  (PropDen[Mom[Multiparticle[1, 3]], modelMass]*PropDen[Mom[Multiparticle[1, \
4]], modelMass]*
   PropDen[Mom[Multiparticle[1, 5]], modelMass]*PropDen[Mom[Multiparticle[2, \
6]], modelMass]*
   PropDen[Mom[Multiparticle[1, 3, 4]], modelMass]) + 
 (4*modelCharge^4*modelMass^2*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], \

    Spinor[\"Helicity\", \"Angle\", 6]]*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
     Spinor[\"Helicity\", \"Square\", 4]]^2*SpinorChain[Spinor[\"Spin\", \
\"Angle\", 2], 
    Spinor[\"Helicity\", \"Angle\", 5]]*
   (-(modelMass*SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Helicity\
\", \"Angle\", 6]]) + 
    SpinorChain[Spinor[\"Helicity\", \"Angle\", 3], Spinor[\"Helicity\", \
\"Angle\", 6]]*
     SpinorChain[Spinor[\"Spin\", \"Square\", 1], Spinor[\"Helicity\", \
\"Square\", 3]] + 
    SpinorChain[Spinor[\"Helicity\", \"Angle\", 4], Spinor[\"Helicity\", \
\"Angle\", 6]]*
     SpinorChain[Spinor[\"Spin\", \"Square\", 1], Spinor[\"Helicity\", \
\"Square\", 4]]))/
  (PropDen[Mom[Multiparticle[1, 3]], modelMass]*PropDen[Mom[Multiparticle[1, \
4]], modelMass]*
   PropDen[Mom[Multiparticle[1, 6]], modelMass]*PropDen[Mom[Multiparticle[2, \
5]], modelMass]*
   PropDen[Mom[Multiparticle[1, 3, 4]], modelMass]) - 
 (4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
     Spinor[\"Helicity\", \"Angle\", 6]]^2*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
    Spinor[\"Helicity\", \"Square\", 4]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 1], 
    Spinor[\"Helicity\", \"Square\", 4]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 2], 
    Spinor[\"Helicity\", \"Square\", 3]])/(PropDen[Mom[Multiparticle[1, 4]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 5]], modelMass]*PropDen[Mom[Multiparticle[2, \
3]], modelMass]*
   PropDen[Mom[Multiparticle[1, 5, 6]], modelMass]) - 
 (4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
     Spinor[\"Helicity\", \"Angle\", 6]]^2*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
    Spinor[\"Helicity\", \"Square\", 4]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 1], 
    Spinor[\"Helicity\", \"Square\", 4]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 2], 
    Spinor[\"Helicity\", \"Square\", 3]])/(PropDen[Mom[Multiparticle[1, 4]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 6]], modelMass]*PropDen[Mom[Multiparticle[2, \
3]], modelMass]*
   PropDen[Mom[Multiparticle[1, 5, 6]], modelMass]) + 
 (4*modelCharge^4*modelMass^2*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], \

     Spinor[\"Helicity\", \"Angle\", 6]]^2*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
    Spinor[\"Helicity\", \"Square\", 4]]*
   (-(SpinorChain[Spinor[\"Helicity\", \"Square\", 4], Spinor[\"Helicity\", \
\"Square\", 5]]*
      SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Helicity\", \
\"Angle\", 5]]) - 
    SpinorChain[Spinor[\"Helicity\", \"Square\", 4], Spinor[\"Helicity\", \
\"Square\", 6]]*
     SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Helicity\", \"Angle\
\", 6]] - 
    modelMass*SpinorChain[Spinor[\"Spin\", \"Square\", 1], \
Spinor[\"Helicity\", \"Square\", 4]])*
   SpinorChain[Spinor[\"Spin\", \"Square\", 2], Spinor[\"Helicity\", \"Square\
\", 3]])/
  (PropDen[Mom[Multiparticle[1, 4]], modelMass]*PropDen[Mom[Multiparticle[1, \
5]], modelMass]*
   PropDen[Mom[Multiparticle[1, 6]], modelMass]*PropDen[Mom[Multiparticle[2, \
3]], modelMass]*
   PropDen[Mom[Multiparticle[1, 5, 6]], modelMass]) + 
 (4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
     Spinor[\"Helicity\", \"Angle\", 6]]^2*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
    Spinor[\"Helicity\", \"Square\", 4]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 1], 
    Spinor[\"Helicity\", \"Square\", 3]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 2], 
    Spinor[\"Helicity\", \"Square\", 4]])/(PropDen[Mom[Multiparticle[1, 3]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 5]], modelMass]*PropDen[Mom[Multiparticle[2, \
4]], modelMass]*
   PropDen[Mom[Multiparticle[1, 5, 6]], modelMass]) + 
 (4*modelCharge^4*modelMass*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], 
     Spinor[\"Helicity\", \"Angle\", 6]]^2*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
    Spinor[\"Helicity\", \"Square\", 4]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 1], 
    Spinor[\"Helicity\", \"Square\", 3]]*SpinorChain[Spinor[\"Spin\", \
\"Square\", 2], 
    Spinor[\"Helicity\", \"Square\", 4]])/(PropDen[Mom[Multiparticle[1, 3]], \
modelMass]*
   PropDen[Mom[Multiparticle[1, 6]], modelMass]*PropDen[Mom[Multiparticle[2, \
4]], modelMass]*
   PropDen[Mom[Multiparticle[1, 5, 6]], modelMass]) - 
 (4*modelCharge^4*modelMass^2*SpinorChain[Spinor[\"Helicity\", \"Angle\", 5], \

     Spinor[\"Helicity\", \"Angle\", 6]]^2*SpinorChain[Spinor[\"Helicity\", \
\"Square\", 3], 
    Spinor[\"Helicity\", \"Square\", 4]]*
   (-(SpinorChain[Spinor[\"Helicity\", \"Square\", 3], Spinor[\"Helicity\", \
