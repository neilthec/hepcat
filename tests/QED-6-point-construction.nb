Cell[CellGroupData[{

Cell["e,E,E,e,A.+,A.-", "Chapter",ExpressionUUID->"eb7c60d5-0ceb-4038-8827-be7f816f410c"],

Cell["\<\
This family has diagram-preparation checks, but full automatic completion has \
not yet been established. This calculation runs the complete workflow and \
returns an expression only if every required check passes. An unresolved \
result remains visible as Failure.\
\>", "Text",ExpressionUUID->"7dd4ac2d-94d5-4c81-b192-f29a11cd990d"],

Cell[CellGroupData[{

Cell["\<\
qed6FourFermionsPM = ConstructAmplitude[
  {\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.-\"},
  diagramModel, factorizationModelSpurious,
  \"PolePreference\"->\"AllSpurious\",
  \"FeynmanModel\" -> qedFeynmanModel];\
\>", "Input",
