Cell[CellGroupData[{

Cell["Export eeAAA to C++", "Section",ExpressionUUID->"274cde2f-9a1a-558e-917c-f3de4e3d1581"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"6386a579-cc77-535c-9756-b9fc3a4bc5fb"],

Cell["The following assignments use the physical-pole expression for three photons and its parity partner.", "Text"],

Cell["With[{m = ModelParameter[factorizationModel, \"Me\"], e = ModelParameter[factorizationModel, \"EE\"]},\n  qed5PPM = CollectAmplitudeFactors[qedFiniteMixedPhotonAmplitude[{1, 2}, {3, 4}, 5,\n    m, e, \"AllPhysical\", False]];\n  qed5PMM = CollectAmplitudeFactors[qedFiniteMixedPhotonAmplitude[{1, 2}, {4, 5}, 3,\n    m, e, \"AllPhysical\", True]];\n];", "Input", CellTags->"QEDFiniteMixed5AllPhysical"],

Cell["CheckAmplitudes[\n  qed5PPM, FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\"}, factorizationModel],\n  factorizationModel, \"FeynmanAmplitudes\" -> DiagramAmplitudes[\n    CreateDiagrams[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\"}, qedFeynmanModel]],\n  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]", "Input", CellTags->"QEDFiniteMixed5AllPhysicalPPMCheck"],

Cell["CheckAmplitudes[\n  qed5PMM, FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\"}, factorizationModel],\n  factorizationModel, \"FeynmanAmplitudes\" -> DiagramAmplitudes[\n    CreateDiagrams[{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\"}, qedFeynmanModel]],\n  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]", "Input", CellTags->"QEDFiniteMixed5AllPhysicalPMMCheck"],

Cell["\<\
eeAAAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeAAA\"}],
  {\"e\", \"E\"} -> {\"A\", \"A\", \"A\"},
  {
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\"}, qed5PPP},
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\"}, qed5PPM},
    {{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\"}, qed5PMM},
    {{\"e\", \"E\", \"A.-\", \"A.-\", \"A.-\"}, qed5MMM}
  }, factorizationModel,
  \"ProcessName\" -> \"eeAAA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{4.002642740159778*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"6bd3f50d-ca6e-526d-9020-0b21d3304d76"],

Cell["\<\
The independent tests use the constructive expressions above. Full export and \
validation diagnostics remain in eeAAAExport; a reference formula is never \
substituted. If an export already exists, add \"Overwrite\" -> True \
deliberately to refresh it.\
\>", "Text",ExpressionUUID->"d44598a7-a970-587d-bca5-9fe84c7fec08"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["e,E,E,e,A.+", "Chapter",
 CellChangeTimes->{{4.0022769229285603`*^9, 
  4.002276923225134*^9}},ExpressionUUID->"46e98235-0600-4516-9c09-\
8e63f98d321c"],

Cell["\<\
This calculation now completes automatically. The apparent high-energy \
freedom consisted of expressions proved identically zero using external \
identities and momentum conservation. Final checks, including the independent \
Feynman comparison, passed. Evaluate the calculation below to obtain a fresh \
result.\
\>", "Text",ExpressionUUID->"5bf9b874-5178-451d-abc8-ca3270faac6e"],

Cell["\<\
qed5FourFermionsP = ConstructAmplitude[
  {\"e\", \"E\", \"E\", \"e\", \"A.+\"},
  diagramModel, factorizationModel,
  \"FeynmanModel\" -> qedFeynmanModel]\
\>", "Input",
 CellChangeTimes->{{4.002276925900463*^9, 4.002276926173473*^9}, {
  4.002277152791669*^9, 4.002277153936412*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"2259d8c0-2c8f-4c1b-8e7e-4bee6c5a852f"],

Cell["For the same amplitude, collect the common four-fermion numerator before summing the emissions from the two charged lines. The comparison below uses the full Feynman diagram sum.", "Text"],

Cell["(* For each fermion pairing, collect the scalar radiation multiplying the common Born tensor. *)
ClearAll[qedFourFermionRadiation];
qedFourFermionRadiation[{i_, j_, k_, l_}, photon_, helicity_, mass_, charge_] := Module[
  {angleType, squareType, spin, angle, square, pole, scalar, born, spinTerm, matching},
  {angleType, squareType} = If[helicity === \"+\", {\"Angle\", \"Square\"}, {\"Square\", \"Angle\"}];
  spin[type_, leg_] := Spinor[If[leg === photon, \"Helicity\", \"Spin\"], type, leg];
  angle[a_, b_] := SpinorChain[spin[angleType, a], spin[angleType, b]];
  square[a_, b_] := SpinorChain[spin[squareType, a], spin[squareType, b]];
  pole[a_, b_, m_] := PropDen[Mom[Multiparticle @@ Sort[{a, b}]], m];
  scalar[a_, b_] := SpinorChain[spin[squareType, photon], Mom[b], Mom[a], spin[squareType, photon]]/
    (pole[a, photon, mass] pole[b, photon, mass]);
  born[a_, b_, c_, d_] := angle[b, d] square[a, c] + angle[b, c] square[a, d] +
    angle[a, d] square[b, c] + angle[a, c] square[b, d];
  spinTerm[a_, b_, c_, d_] :=
    square[a, photon] (square[photon, d] angle[b, c] + square[photon, c] angle[b, d])/pole[a, photon, mass] -
    square[b, photon] (square[photon, d] angle[a, c] + square[photon, c] angle[a, d])/pole[b, photon, mass];
  matching[a_, b_, c_, d_] := born[a, b, c, d] (scalar[a, b]/pole[c, d, 0] + scalar[c, d]/pole[a, b, 0]) +
    spinTerm[a, b, c, d]/pole[c, d, 0] + spinTerm[c, d, a, b]/pole[a, b, 0];
  2 Sqrt[2] charge^3 (matching[i, j, l, k] - matching[i, k, l, j])
];", "Input"],

Cell["qed5FourFermionsPCompact = qedFourFermionRadiation[{1, 2, 3, 4}, 5, \"+\",
  ModelParameter[factorizationModel, \"Me\"], ModelParameter[factorizationModel, \"EE\"]];", "Input"],

Cell["With[{process = {\"e\", \"E\", \"E\", \"e\", \"A.+\"}},
  CheckAmplitudes[qed5FourFermionsPCompact,
    FactorizationAmplitudeChannels[process, factorizationModel], factorizationModel,
    \"FeynmanAmplitudes\" -> DiagramAmplitudes[CreateDiagrams[process, qedFeynmanModel]],
    \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]]", "Input"]
}, Open  ]],

