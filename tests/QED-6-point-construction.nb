Cell[CellGroupData[{

Cell["\<\
qed6MMMMMadGraph = If[
  ValueQ[qed6MMMM] && FreeQ[qed6MMMM, _Failure | _Missing | $Failed | \
$Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"A.-\", \"A.-\", \"A.-\", \"A.-\"}, qed6MMMM, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"33548d79-d152-56e6-8358-b2d086c515c7"],

