Cell[CellGroupData[{

Cell["Export eeAAA to C++", "Section",ExpressionUUID->"c4d53df1-d52a-48b9-9e19-546ec5f4f354"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"2ff1eb89-2ae7-484b-901e-cc4825fa10a2"],

Cell[CellGroupData[{

Cell["\<\
eeAAAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeAAA\"}],
  {\"e\", \"E\"} -> {\"A\", \"A\", \"A\"},
  {
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\"}, qed5PPP},
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\"}, qed5PPM},
    {{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\"}, qed5PMM},
    {{\"e\", \"E\", \"A.-\", \"A.-\", \"A.-\"}, qed5MMM}
  }, factorizationModel,
  \"ProcessName\" -> \"eeAAA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{4.002642740159778*^9},
 CellLabel->"In[41]:=",ExpressionUUID->"d0a55a6d-e554-4e30-a115-142464e2a1f2"],

