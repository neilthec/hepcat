Cell["\<\
This process has no massless-helicity branches. Every massive-fermion spin \
remains an argument of the generated amplitude.\
\>", "Text",ExpressionUUID->"2a9899a9-30b5-55dd-8e05-13529e1db2ce"],

Cell[CellGroupData[{

Cell["\<\
eeeeeeExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeeeee\"}],
  {\"e\", \"E\"} -> {\"E\", \"e\", \"E\", \"e\"},
  {
    {{\"e\", \"E\", \"e\", \"E\", \"e\", \"E\"}, qed6SixFermions}
  }, factorizationModel,
  \"ProcessName\" -> \"eeeeee\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
