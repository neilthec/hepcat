Cell[CellGroupData[{

Cell["Export eeAAAA to C++", "Section",ExpressionUUID->"7d2bd625-d3b4-40ab-b359-65b3195eb267"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"efdc8dc3-f134-4104-8309-1a207e3f5430"],

Cell["For four photons, the spurious-pole formula sums over the ways to assign the three like-helicity photons to the two ends of the fermion line. These assignments and their parity partners enter the checks and the process export.", "Text"],

Cell["With[{m = ModelParameter[factorizationModelSpurious, \"Me\"], e = ModelParameter[factorizationModelSpurious, \"EE\"]},\n  qed6PPPM = CollectAmplitudeFactors[qedFiniteMixedPhotonAmplitude[{1, 2}, {3, 4, 5}, 6,\n    m, e, \"AllSpurious\", False]];\n  qed6PMMM = CollectAmplitudeFactors[qedFiniteMixedPhotonAmplitude[{1, 2}, {4, 5, 6}, 3,\n    m, e, \"AllSpurious\", True]];\n];", "Input", CellTags->"QEDFiniteMixed6AllSpurious"],

Cell["CheckAmplitudes[\n  qed6PPPM, FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.-\"}, factorizationModelSpurious],\n  factorizationModelSpurious, \"FeynmanAmplitudes\" -> DiagramAmplitudes[\n    CreateDiagrams[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.-\"}, qedFeynmanModel]],\n  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]", "Input", CellTags->"QEDFiniteMixed6AllSpuriousPPPMCheck"],

Cell["CheckAmplitudes[\n  qed6PMMM, FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\", \"A.-\"}, factorizationModelSpurious],\n  factorizationModelSpurious, \"FeynmanAmplitudes\" -> DiagramAmplitudes[\n    CreateDiagrams[{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\", \"A.-\"}, qedFeynmanModel]],\n  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]", "Input", CellTags->"QEDFiniteMixed6AllSpuriousPMMMCheck"],

Cell["\<\
eeAAAAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeAAAA\"}],
  {\"e\", \"E\"} -> {\"A\", \"A\", \"A\", \"A\"},
  {
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.+\"}, qed6PPPP},
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.-\"}, qed6PPPM},
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"}, qed6PPMM},
    {{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\", \"A.-\"}, qed6PMMM},
    {{\"e\", \"E\", \"A.-\", \"A.-\", \"A.-\", \"A.-\"}, qed6MMMM}
  }, factorizationModelSpurious,
  \"ProcessName\" -> \"eeAAAA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{{4.002806291604042*^9, 4.002806296154274*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"8cbb4f6f-c72c-49a2-b491-6962adb6ea4f"],

Cell["\<\
The independent tests use the constructive expressions above. Full export and \
validation diagnostics remain in eeAAAAExport; a reference formula is never \
substituted. If an export already exists, add \"Overwrite\" -> True \
deliberately to refresh it.\
\>", "Text",ExpressionUUID->"df129965-5975-464f-a92f-ff4ad99b1eb6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["e,E,E,e,A.+,A.+", "Chapter",ExpressionUUID->"5a68ef0a-7cb0-4448-a8ce-83c101a7b2ee"],

Cell["\<\
This family has diagram-preparation checks, but full automatic completion has \
not yet been established. This calculation runs the complete workflow and \
returns an expression only if every required check passes. An unresolved \
result remains visible as Failure.\
\>", "Text",ExpressionUUID->"0965368c-d32c-4693-9dc1-763635c8283b"],

Cell["\<\
qed6FourFermionsPP = ConstructAmplitude[
  {\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.+\"},
  diagramModel, factorizationModelSpurious,
  \"PolePreference\"->\"AllSpurious\",
  \"FeynmanModel\" -> qedFeynmanModel];\
\>", "Input",
