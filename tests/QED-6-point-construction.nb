Cell["\<\
The independent tests use the constructive expressions above. Full export and \
validation diagnostics remain in eeeeeeExport; a reference formula is never \
substituted. If an export already exists, add \"Overwrite\" -> True \
deliberately to refresh it.\
\>", "Text",ExpressionUUID->"3a917793-31b1-4263-a251-16620fe23aa2"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["All-Positive Photons: General Formulas", "Title", ExpressionUUID->"649c7281-b702-4e7b-94cb-7fdee5f6a5a2"],

Cell["These formulas describe the massive QED process e, E and N positive-helicity photons, with all momenta incoming. They use the charge EE, the mass Me, and the normalization of the cubic QED model above. The formulas and their subset recurrences are defined here in the notebook.", "Text", ExpressionUUID->"c86408ff-7503-430a-80b4-d6e4f43f41ac"],

Cell["The constructive four- and five-point results suggest a common pattern. The four-point result is proportional to m ⟨12⟩ [34]², with just one photon pair. At five points the physical-pole expression sums the three choices of that pair. Each term carries [ab]² and a factor from the remaining photon i. In the spurious form the pair contributes [ab]/⟨ab⟩, and there are two choices of which member of the pair sets the reference for i. At larger N, collect the remaining emissions into a current. Schouten and the momentum-matrix determinant combine paired emissions, giving the recurrences below.", "Text", ExpressionUUID->"94bf8c67-0f6f-4d13-9d56-f1cee7301363"],

Cell["P is the full photon list {3, …, N+2}. Each sum over pairs counts an unordered pair once. The subscript on τ lists the momenta in an electron propagator, for example τ₁₃₄ = (p₁ + p₃ + p₄)² − m². All internal propagators stay off shell. The extension to unrestricted N is a conjecture supported by checks at finite multiplicity.", "Text", ExpressionUUID->"1159ad15-be89-425a-9857-5cfbdd7f6f65"],

Cell[CellGroupData[{

Cell["All-Positive Photons: A General AllPhysical Formula", "Section", ExpressionUUID->"33f759f6-2e18-419b-8599-06b906469926"],

Cell[BoxData[FormBox[RowBox[{SubscriptBox["ℳ", "phys, N"], "=", FractionBox[RowBox[{SuperscriptBox["(√2 e)", "N"], " m ⟨12⟩"}], RowBox[{UnderscriptBox["∏", "i ∈ P"], SubscriptBox["τ", "1i"]}]], UnderscriptBox["∑", "{a,b} ⊂ P"], SuperscriptBox["[ab]", "2"], SubscriptBox["F", "P"], "(P ∖ {a,b})"}], TraditionalForm]], "DisplayFormula", ExpressionUUID->"9e1e138b-5ebb-4b6b-ad11-556880b266dc"],

Cell["The remaining current F uses only electron propagators. Its empty value is 1, and for a single remaining photon i it gives [i12i]/τ₂ᵢ. For two or more photons, the code starts with the product of those single-photon factors and subtracts the mass-squared pair contribution. The auxiliary pair weight sums over removing one or two photons outside the fixed pair. A weight with only that pair left equals 1.", "Text", ExpressionUUID->"075d5630-b762-4991-8ebd-4da9d3429111"],

Cell["\<\
qedAllPositivePhysicalFormula[model_List, n_Integer /; n >= 2] := Module[
  {photons = Range[3, n + 2], mass = ModelParameter[model, \"Me\"],
   charge = ModelParameter[model, \"EE\"], square, angle, tau, sandwich,
   emission, pairWeight, current, amplitude},
  square[i_, j_] := SpinorChain[
    Spinor[\"Helicity\", \"Square\", i], Spinor[\"Helicity\", \"Square\", \
j]];
  angle = SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Spin\", \
\"Angle\", 2]];
  tau[leg_, subset_List] := PropDen[Mom[Multiparticle @@ Prepend[subset, \
leg]], mass];
  sandwich[i_] := SpinorChain[
    Spinor[\"Helicity\", \"Square\", i], Mom[1], Mom[2], Spinor[\"Helicity\", \
\"Square\", i]];
  emission[i_, j_] := square[i, j] SpinorChain[
    Spinor[\"Helicity\", \"Angle\", j], Mom[1], Spinor[\"Helicity\", \"Square\
\", i]];
  pairWeight[subset_List, pair_List] := pairWeight[subset, pair] = Module[
    {rest = Complement[subset, pair]},
    (Times @@ (sandwich /@ rest)) +
    Total[Function[i, Total[emission[i, #] & /@ Complement[photons, subset]]
      tau[2, {i}]/tau[2, DeleteCases[subset, i]]
      pairWeight[DeleteCases[subset, i], pair]] /@ rest] -
    mass^2 Total[Function[ij, (square @@ ij)^2
      (Times @@ (tau[2, {#}] & /@ ij))/tau[2, Complement[subset, ij]]
      pairWeight[Complement[subset, ij], pair]] /@ Subsets[rest, {2}]]
  ];
  current[subset_List] := current[subset] =
    (Times @@ (sandwich[#]/tau[2, {#}] & /@ subset)) -
    If[Length[subset] < 2, 0,
      mass^2 Total[Function[pair, (square @@ pair)^2
        (Times @@ (tau[1, {#}] & /@ pair)) pairWeight[subset, pair]] /@
        Subsets[subset, {2}]]/
        (tau[2, subset] (Times @@ (tau[2, {#}] & /@ subset)))];
  amplitude = (Sqrt[2] charge)^n mass angle/
    (Times @@ (tau[1, {#}] & /@ photons)) *
    Total[Function[pair, (square @@ pair)^2 current[Complement[photons, \
pair]]] /@
      Subsets[photons, {2}]];
  {Thread[Mass /@ Range[n + 2] -> Join[{mass, mass}, ConstantArray[0, n]]], \
amplitude}
];\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"ba9b41c1-3a98-4f09-8d9d-b7f60d875f8e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["All-Positive Photons: A General AllSpurious Formula", "Section",ExpressionUUID->"96bc8234-8e50-4c5e-845f-094cf3e9da24"],

Cell[BoxData[FormBox[RowBox[{SubscriptBox["ℳ", "spur, N"], "=", SuperscriptBox["(−√2 e)", "N"], " m ⟨12⟩ ", UnderscriptBox["∑", "{a,b} ⊂ P"], FractionBox["[ab]", "⟨ab⟩"], RowBox[{"(", FractionBox[RowBox[{SubscriptBox["J", "a"], "(P ∖ {a,b})"}], SubscriptBox["τ", "2a"]], "+", FractionBox[RowBox[{SubscriptBox["J", "b"], "(P ∖ {a,b})"}], SubscriptBox["τ", "2b"]], ")"}]}], TraditionalForm]], "DisplayFormula", ExpressionUUID->"d11216f4-d565-4853-b8ca-77ee8155abd3"],

Cell["The current J uses the indicated terminal photon as its spinor reference. Its empty value is 1, and its single-photon value is ⟨r|p₁|i]/(⟨ri⟩ τ₁ᵢ). For larger subsets, the pair weight collects the momentum determinant contributions. Momentum conservation lets the emission use the shorter of the two equivalent momentum sums. Every reference label belongs to an external photon, so only explicit photon brackets remain.", "Text", ExpressionUUID->"f37a0400-69ef-4e05-b77f-05d0afebdfa0"],

Cell["\<\
qedAllPositiveSpuriousFormula[model_List, n_Integer /; n >= 2] := Module[
  {photons = Range[3, n + 2], mass = ModelParameter[model, \"Me\"],
   charge = ModelParameter[model, \"EE\"], square, angle, massiveAngle, tau,
   ratio, leading, emission, pairWeight, current, amplitude},
  square[i_, j_] := SpinorChain[
    Spinor[\"Helicity\", \"Square\", i], Spinor[\"Helicity\", \"Square\", \
j]];
  angle[i_, j_] := SpinorChain[
    Spinor[\"Helicity\", \"Angle\", i], Spinor[\"Helicity\", \"Angle\", j]];
  massiveAngle = SpinorChain[Spinor[\"Spin\", \"Angle\", 1], Spinor[\"Spin\", \
\"Angle\", 2]];
  tau[leg_, subset_List] := PropDen[Mom[Multiparticle @@ Prepend[subset, \
leg]], mass];
  ratio[r_, p_, i_] := SpinorChain[
    Spinor[\"Helicity\", \"Angle\", r], Mom[p], Spinor[\"Helicity\", \"Square\
\", i]]/angle[r, i];
  leading[r_, subset_List] := Times @@ (ratio[r, 1, #] & /@ subset);
  emission[r_, subset_List, i_] := Module[
    {direct = Prepend[DeleteCases[subset, i], 1],
     complement = Prepend[DeleteCases[Complement[photons, subset], r], 2]},
    If[Length[complement] < Length[direct],
      -Total[ratio[r, #, i] & /@ complement],
      Total[ratio[r, #, i] & /@ direct]]
  ];
  pairWeight[r_, subset_List, pair_List] := pairWeight[r, subset, pair] =
    (leading[r, Complement[subset, pair]] + Total[Function[i,
      tau[1, {i}] emission[r, subset, i] pairWeight[r, DeleteCases[subset, \
i], pair]] /@
        Complement[subset, pair]])/tau[1, subset];
  current[r_, subset_List] := current[r, subset] =
    (leading[r, subset] - mass^2 Total[Function[pair,
      (square @@ pair)^2 pairWeight[r, subset, pair]] /@ Subsets[subset, \
{2}]])/
      (Times @@ (tau[1, {#}] & /@ subset));
  amplitude = (-Sqrt[2] charge)^n mass massiveAngle *
    Total[Function[pair, (square @@ pair)/(angle @@ pair) *
      Total[current[#, Complement[photons, pair]]/tau[2, {#}] & /@ pair]] /@
        Subsets[photons, {2}]];
  {Thread[Mass /@ Range[n + 2] -> Join[{mass, mass}, ConstantArray[0, n]]], \
amplitude}
];\
\>", "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"6ba01ade-8bff-4d1c-bdc8-7f8903e444db"]
}, Open  ]],

