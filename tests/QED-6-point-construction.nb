Cell[CellGroupData[{

Cell["\<\
qed6FourFermionsMMMadGraph = If[
  ValueQ[qed6FourFermionsMM] && FreeQ[qed6FourFermionsMM, _Failure | _Missing \
| $Failed | $Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"E\", \"e\", \"A.-\", \"A.-\"}, qed6FourFermionsMM, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"caf1c22c-9374-5540-9588-41e8213b5113"],

