Cell[CellGroupData[{

Cell["\<\
qed6SixFermionsMadGraph = If[
  ValueQ[qed6SixFermions] && FreeQ[qed6SixFermions, _Failure | _Missing | \
$Failed | $Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"e\", \"E\", \"e\", \"E\"}, qed6SixFermions, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
