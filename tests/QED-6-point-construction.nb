Cell[CellGroupData[{

Cell["Four-Point Amplitudes (Max Spurious)", "Title",
 CellChangeTimes->{{4.0028090504560547`*^9, 
  4.0028090536216516`*^9}},ExpressionUUID->"e47186dd-e0c8-4d33-85c0-\
9c48a3c11036"],

Cell["\<\
Five separate calculations: every two-photon helicity assignment and \
four-fermion scattering. Four-point factorization uses the same cubic model \
as the diagrams.\
\>", "Text",ExpressionUUID->"1af68b31-3a7f-4b27-a23f-874115e35e82"],

Cell[CellGroupData[{

Cell["e,E,A.+,A.+", "Chapter",ExpressionUUID->"3e2ed5ff-6b9c-4856-b2c3-c92aecb99d8f"],

Cell[CellGroupData[{

Cell["\<\
qed4PP = ConstructAmplitude[
  {\"e\", \"E\", \"A.+\", \"A.+\"},
  diagramModel, diagramModel,
  \"PolePreference\"->\"AllSpurious\",
  \"FeynmanModel\" -> qedFeynmanModel]\
\>", "Input",
