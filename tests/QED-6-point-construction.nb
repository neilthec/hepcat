Cell[CellGroupData[{

Cell["A Compact Spurious-Pole Formula", "Section",
 CellTags->
  "QEDSixPointPPMMExplicitSpurious",ExpressionUUID->"d652df54-d3ea-43bc-bae3-\
cbdbc7b57435"],

Cell["\<\
The automatic calculation above keeps its validated result in \
qed6PPMMAutomatic. This separate worked form groups the emissions into six \
blocks and retains the regular remainder. Its complexity is 1044. All four \
apparent spinor poles cancel. The assignment supplies qed6PPMM to the later \
C++ export.\
\>", "Text",ExpressionUUID->"9c23e958-a26a-4a53-af73-e8c556af502e"],

Cell[CellGroupData[{

Cell["\<\
Get[FileNameJoin[{hepcatDirectory, \"tests\", \"checks\", \"fixtures\", \"QED-5-point-residues.wl\"}]];
qed6PPMM = Last[QEDSixPointPPMMSpuriousExample[factorizationModelSpurious]]\
\>", "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"a54fa1e8-2a1c-472b-a690-de47949f83f5"],

