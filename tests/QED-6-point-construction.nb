4]], modelMass]*
   PropDen[Mom[Multiparticle[1, 6]], modelMass]*PropDen[Mom[Multiparticle[2, \
5]], modelMass]*
   PropDen[Mom[Multiparticle[1, 3, 6]], modelMass]) - 
 (4*modelCharge^4*SpinorChain[Spinor[\"Spin\", \"Square\", 2], \
Spinor[\"Helicity\", \"Square\", 3]]*
