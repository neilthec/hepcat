Cell[CellGroupData[{

Cell["Export eeAA to C++", "Section",ExpressionUUID->"0509d4c7-dc18-42d5-80bc-04a7946c79fc"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"cfdfe251-ce7a-428a-9ece-209ada9c9343"],

Cell[CellGroupData[{

Cell["\<\
eeAAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeAA\"}],
  {\"e\", \"E\"} -> {\"A\", \"A\"},
  {
    {{\"e\", \"E\", \"A.+\", \"A.+\"}, qed4PP},
    {{\"e\", \"E\", \"A.+\", \"A.-\"}, qed4PM},
    {{\"e\", \"E\", \"A.-\", \"A.+\"}, qed4MP},
    {{\"e\", \"E\", \"A.-\", \"A.-\"}, qed4MM}
  }, factorizationModel,
  \"ProcessName\" -> \"eeAA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{{4.002364063726721*^9, 4.0023640718600597`*^9}, {
  4.0023732466995077`*^9, 4.002373258398301*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"96578c75-09f9-4be7-b252-c051b1cdefdc"],

