Cell[CellGroupData[{

Cell["Export eeAAAA to C++", "Section",ExpressionUUID->"5f926e49-4832-5cb6-b3a6-365fae37b536"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"4b574378-b26a-5a3a-8d12-91a73921f519"],

Cell["The four-photon physical-pole formula sums over the three cyclic choices of the like-helicity photons. The following checks and export include its parity partner.", "Text"],

Cell["With[{m = ModelParameter[factorizationModel, \"Me\"], e = ModelParameter[factorizationModel, \"EE\"]},\n  qed6PPPM = CollectAmplitudeFactors[qedFiniteMixedPhotonAmplitude[{1, 2}, {3, 4, 5}, 6,\n    m, e, \"AllPhysical\", False]];\n  qed6PMMM = CollectAmplitudeFactors[qedFiniteMixedPhotonAmplitude[{1, 2}, {4, 5, 6}, 3,\n    m, e, \"AllPhysical\", True]];\n];", "Input", CellTags->"QEDFiniteMixed6AllPhysical"],

Cell["CheckAmplitudes[\n  qed6PPPM, FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.-\"}, factorizationModel],\n  factorizationModel, \"FeynmanAmplitudes\" -> DiagramAmplitudes[\n    CreateDiagrams[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.-\"}, qedFeynmanModel]],\n  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]", "Input", CellTags->"QEDFiniteMixed6AllPhysicalPPPMCheck"],

Cell["CheckAmplitudes[\n  qed6PMMM, FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\", \"A.-\"}, factorizationModel],\n  factorizationModel, \"FeynmanAmplitudes\" -> DiagramAmplitudes[\n    CreateDiagrams[{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\", \"A.-\"}, qedFeynmanModel]],\n  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]", "Input", CellTags->"QEDFiniteMixed6AllPhysicalPMMMCheck"],

Cell["\<\
eeAAAAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeAAAA\"}],
  {\"e\", \"E\"} -> {\"A\", \"A\", \"A\", \"A\"},
  {
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.+\"}, qed6PPPP},
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.+\", \"A.-\"}, qed6PPPM},
    {{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"}, qed6PPMM},
    {{\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\", \"A.-\"}, qed6PMMM},
    {{\"e\", \"E\", \"A.-\", \"A.-\", \"A.-\", \"A.-\"}, qed6MMMM}
  }, factorizationModel,
  \"ProcessName\" -> \"eeAAAA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{{4.002806291604042*^9, 4.002806296154274*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"d719600e-843c-511a-9e0c-a90505084be9"],

Cell["Reference run for the compact balanced form, seed 6182401. CalcHEP agreed at all 1,000 spin-summed points. MadGraph agreed at 1,000 points for each of the six permutations with two positive and two negative photons. The largest relative difference over these six helicities was 6.05 x 10^-12.", "Text"],

Cell["\<\
The independent tests use the constructive expressions above. Full export and \
validation diagnostics remain in eeAAAAExport; a reference formula is never \
substituted. If an export already exists, add \"Overwrite\" -> True \
deliberately to refresh it.\
\>", "Text",ExpressionUUID->"89146adb-27b9-53e9-9193-7b50447823b2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["e,E,E,e,A.+,A.+", "Chapter",ExpressionUUID->"dc2a7d10-2e26-54e3-ac32-91da653a12ee"],

Cell["\<\
This family has diagram-preparation checks, but full automatic completion has \
not yet been established. This calculation runs the complete workflow and \
returns an expression only if every required check passes. An unresolved \
result remains visible as Failure.\
\>", "Text",ExpressionUUID->"e00c9759-5843-5d08-8c90-bc17e87f6b19"],

Cell["\<\
qed6FourFermionsPP = ConstructAmplitude[
  {\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.+\"},
  diagramModel, factorizationModel,
  \"PolePreference\" -> \"AllPhysical\",
  \"FeynmanModel\" -> qedFeynmanModel]\
\>", "Input",
 CellChangeTimes->{{4.0022809867428913`*^9, 4.002280989061562*^9}, 
   4.002293011419918*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"43109671-29f3-53c2-8f3e-a7707a317999"],

Cell["The physical-pole form pairs the emission orders on each fermion line. Schouten's identity removes the photon reference spinor from each neutral-line emission factor. The tests below use this construction.", "Text"],

Cell["\<\
qed6FourFermionsPPMadGraph = If[
  ValueQ[qed6FourFermionsPP] && FreeQ[qed6FourFermionsPP, _Failure | _Missing \
| $Failed | $Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.+\"}, qed6FourFermionsPP, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"b04e4cf8-9218-5d25-ae3d-f0f0bff3dcd8"]
}, Open  ]],

