Cell[CellGroupData[{

Cell["\<\
qed6FourFermionsPMMadGraph = If[
  ValueQ[qed6FourFermionsPM] && FreeQ[qed6FourFermionsPM, _Failure | _Missing \
| $Failed | $Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.-\"}, qed6FourFermionsPM, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"2db9f6f3-e0c8-5d80-acc2-3816a5965b55"],

