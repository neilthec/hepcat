Cell[CellGroupData[{

Cell["Export eeeeA to C++", "Section",ExpressionUUID->"1b55db53-a74f-5ab1-b9ae-175b83ca16ea"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"f67afe05-bb0e-5b49-842d-b4654db3d559"],

Cell[CellGroupData[{

Cell["\<\
eeeeAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeeeA\"}],
  {\"e\", \"E\"} -> {\"e\", \"E\", \"A\"},
  {
    {{\"e\", \"E\", \"E\", \"e\", \"A.+\"}, qed5FourFermionsP},
    {{\"e\", \"E\", \"E\", \"e\", \"A.-\"}, qed5FourFermionsM}
  }, factorizationModel,
  \"ProcessName\" -> \"eeeeA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{{4.00280181929537*^9, 4.002801824085808*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"5dd35c09-5d03-5983-8e36-0784b236e701"],

