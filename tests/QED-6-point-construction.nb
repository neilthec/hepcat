Cell["\<\
This process has no massless-helicity branches. Every massive-fermion spin \
remains an argument of the generated amplitude.\
\>", "Text",ExpressionUUID->"7dab2719-e7e5-4360-8df7-432cd9c6460e"],

Cell[CellGroupData[{

Cell["\<\
eeeeExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeee\"}],
  {\"e\", \"E\"} -> {\"e\", \"E\"},
  {
    {{\"e\", \"E\", \"E\", \"e\"}, qed4FourFermions}
  }, factorizationModel,
  \"ProcessName\" -> \"eeee\",
