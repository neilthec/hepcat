Cell[CellGroupData[{

Cell["A Compact Spurious-Pole Formula", "Section",
 CellTags->
  "QEDSixPointPPMMExplicitSpurious",ExpressionUUID->"d652df54-d3ea-43bc-bae3-\
cbdbc7b57435"],

Cell["The explicit two-emission currents use one apparent denominator, [36]. The resulting amplitude supplies the Feynman, CalcHEP and MadGraph checks. The automatic result remains available in qed6PPMMAutomatic.", "Text"],

Cell["qed6PPMM = CollectAmplitudeFactors[qedBalancedPhotonCurrent[{1, 2}, {3, 4}, {5, 6},\n  ModelParameter[factorizationModelSpurious, \"Me\"], 4 ModelParameter[factorizationModelSpurious, \"EE\"]^4, \"SingleBracket\"], Infinity];", "Input", CellTags->"QEDBalancedSingleBracket"],

Cell["SpinorExpressionComplexity[qed6PPMM]", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"ab8db726-c51a-47a4-aaf0-783a3b7758bf"],

Cell["\<\
With[{particles = {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"}},
  CheckAmplitudes[qed6PPMM,
    FactorizationAmplitudeChannels[particles, factorizationModelSpurious],
    factorizationModelSpurious,
    \"FeynmanAmplitudes\" -> DiagramAmplitudes[CreateDiagrams[particles, \
qedFeynmanModel]],
    \"FeynmanModel\" -> qedFeynmanModel, \"TimeConstraint\" -> 180, \"RandomSeed\" -> 912681, \"Output\" -> \"Summary\"]]\
\>", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"826b1966-6557-436b-8f0b-7cf6358b0f07"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["e,E,A.+,A.-,A.-,A.-", "Chapter",ExpressionUUID->"97d26091-903e-4e7f-84ee-2dcc597d1793"],

Cell["\<\
qed6PMMM = ConstructAmplitude[
  {\"e\", \"E\", \"A.+\", \"A.-\", \"A.-\", \"A.-\"},
  diagramModel, factorizationModelSpurious,
  \"PolePreference\"->\"AllSpurious\",
  \"FeynmanModel\" -> qedFeynmanModel]\
\>", "Input",
 CellChangeTimes->{{4.002280971222344*^9, 4.002280973148941*^9}, 
   4.0022930045598*^9, {4.002815919598365*^9, 4.0028159205726223`*^9}, 
   4.002816029734478*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"2e090a7f-0518-48ef-bf8e-891781c005e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["e,E,A.-,A.-,A.-,A.-", "Chapter",ExpressionUUID->"d04d1963-afda-4947-a979-8ea1d362ef5d"],

Cell["\<\
Evaluate the construction cell to combine adjacent same-helicity emissions in \
pairs. The resulting expression has complexity 120 and passes all 23 checks.\
\>", "Text",ExpressionUUID->"a1ce9072-6b31-4bf4-95c7-67d2851278c4"],

Cell[CellGroupData[{

Cell["\<\
qed6MMMM = ConstructAmplitude[
  {\"e\", \"E\", \"A.-\", \"A.-\", \"A.-\", \"A.-\"},
  diagramModel, factorizationModelSpurious,
  \"PolePreference\"->\"AllSpurious\",
  \"FeynmanModel\" -> qedFeynmanModel]\
\>", "Input",
 CellChangeTimes->{
  4.0022930078627167`*^9, {4.0028159247230043`*^9, 4.002815925738881*^9}, 
   4.0028160335471582`*^9},
