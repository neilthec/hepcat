Cell["\<\
This cell repeats every standard check at the model parameters, including an \
independently generated Feynman amplitude. The compact summary counts all \
passing rows; change Output to Details when you want the individual residues \
and samples.\
\>", "Text",ExpressionUUID->"65812dd8-f148-4e99-bb06-dad2776b3481"],

Cell[CellGroupData[{

Cell["\<\
CheckAmplitudes[
  qed6PPMM,
  FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \
\"A.-\"}, factorizationModel],
  factorizationModel,
  \"FeynmanAmplitudes\" -> DiagramAmplitudes[CreateDiagrams[
    {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"}, qedFeynmanModel]],
  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]\
\>", "Input",
 CellTags->"QEDSixPointPPMMExplicitReferenceChecks",
 CellLabel->"In[43]:=",ExpressionUUID->"800d516e-fb45-409b-87ed-f3daa59f60e2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"\<\"PASS\"\>", "\[Rule]", "17"}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.00280313688656*^9, 4.0032457968481913`*^9},
 CellTags->"QEDSixPointPPMMExplicitReferenceChecks",
 CellLabel->"Out[43]=",ExpressionUUID->"37710cac-f818-41a4-acbf-bce1df5ba393"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
qed6PPMMMadGraph = If[
  ValueQ[qed6PPMM] && FreeQ[qed6PPMM, _Failure | _Missing | $Failed | \
$Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"}, qed6PPMM, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"9ab8260a-162c-546d-9d3d-56b4075f3f96"],

