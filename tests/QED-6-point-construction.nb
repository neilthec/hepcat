  ValueQ[qed6FourFermionsPP] && FreeQ[qed6FourFermionsPP, _Failure | _Missing \
| $Failed | $Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.+\"}, qed6FourFermionsPP, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
