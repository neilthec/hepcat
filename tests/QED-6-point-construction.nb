Cell[CellGroupData[{

Cell["Exact equality of the five-point equal-helicity forms", "Section"],

Cell["The six electron virtualities clear the physical propagator denominators. The polynomial remainder tests the difference of the two displayed amplitudes using the equal external masses.", "Text"],

Cell["(* Strip 2 Sqrt[2] e^3 m Angle[1,2] and compare the two displayed five-point formulas. *)\nModule[{u, v, g, x, y, b, c, angle, square, s, z, t, d, chain, closure,\n    labels = Range[3], pairs, physical, spurious, difference},\n  (* Matrix indices 1, 2, 3 stand for photon legs 3, 4, 5. *)\n  angle = {{0, 1, 1}, {-1, 0, -1}, {-1, 1, 0}};\n  square = g {{0, 1, v}, {-1, 0, -u}, {-v, u, 0}};\n  s = -angle square;\n  z = {{x, b, u x + v b}, {c, y, u c + v y},\n       {x + c, b + y, u (x + c) + v (b + y)}};\n  t = Diagonal[z];\n  d = -t - Total[s];\n  chain = Diagonal[square . z];\n  closure = Total[t] + Total[Flatten[UpperTriangularize[s, 1]]];\n  pairs = Subsets[labels, {2}];\n  physical = (square[[2, 3]]^2 chain[[1]]/d[[1]] +\n              square[[1, 3]]^2 chain[[2]]/d[[2]] +\n              square[[1, 2]]^2 chain[[3]]/d[[3]])/(Times @@ t);\n  spurious = -Total[Function[pair,\n      With[{i = First[pair], j = Last[pair], k = First[Complement[labels, pair]]},\n        square[[i, j]]/(angle[[i, j]] t[[k]]) (\n          z[[i, k]]/(angle[[i, k]] d[[i]]) +\n          z[[j, k]]/(angle[[j, k]] d[[j]]))]] /@ pairs];\n  difference = Cancel[(Times @@ t) (Times @@ d) (spurious - physical)];\n  PolynomialRemainder[difference, closure, c] === 0\n]", "Input", CellTags->"QEDFivePointDisplayedPoleIdentity"]
}, Open  ]],

