Cell[CellGroupData[{

Cell["e,E,A.+,A.+,A.-,A.-", "Chapter",
 CellChangeTimes->{{4.0022770269996853`*^9, 
  4.002277027281679*^9}},ExpressionUUID->"4c9a9a92-2150-4693-b9b9-\
e597fe32d90a"],

Cell["\<\
qed6PPMM = ConstructAmplitude[
  {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"},
  diagramModel, factorizationModel,
  \"PolePreference\" -> \"AllPhysical\",
  \"FeynmanModel\" -> qedFeynmanModel]\
\>", "Input",
 CellChangeTimes->{{4.002277030199769*^9, 4.002277030493498*^9}, {
   4.0022772373320007`*^9, 4.0022772379134703`*^9}, {4.00228096496786*^9, 
   4.00228096596343*^9}, 4.002292985841082*^9},
 CellLabel->"In[40]:=",ExpressionUUID->"9b381961-2543-4ac7-9b70-88063ccb97ed"],

Cell[CellGroupData[{

Cell["A Verified All-Physical Formula", "Section",
 CellTags->
  "QEDSixPointPPMMExplicitReference",ExpressionUUID->"9663237e-11d6-470d-84e2-\
b4737d9aee07"],

Cell["The following two-emission currents give the balanced four-photon amplitude using only physical propagator denominators. The six assignments of photons to the two ends of the line share one current. The remaining term sums the pairwise polarization contractions. The assignment supplies the formula directly to the Feynman, MadGraph and full-process CalcHEP checks below.", "Text"],

Cell["qed6PPMM = CollectAmplitudeFactors[qedBalancedPhotonCurrent[{1, 2}, {3, 4}, {5, 6},\n  ModelParameter[factorizationModel, \"Me\"], 4 ModelParameter[factorizationModel, \"EE\"]^4], Infinity];", "Input", CellTags->"QEDBalancedPhysicalGauge"],

Cell["SpinorExpressionComplexity[qed6PPMM]", "Input",
 CellTags->"QEDSixPointPPMMExplicitReferenceComplexity",
 CellLabel->"In[42]:=",ExpressionUUID->"ab6bfd2a-1749-43a6-bd4a-ab5a8f8e28cc"],

Cell["\<\
This cell repeats every standard check at the model parameters, including an \
independently generated Feynman amplitude. The compact summary counts all \
passing rows; change Output to Details when you want the individual residues \
and samples.\
\>", "Text",ExpressionUUID->"65812dd8-f148-4e99-bb06-dad2776b3481"],

Cell["\<\
CheckAmplitudes[
  qed6PPMM,
  FactorizationAmplitudeChannels[{\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \
\"A.-\"}, factorizationModel],
  factorizationModel,
  \"FeynmanAmplitudes\" -> DiagramAmplitudes[CreateDiagrams[
    {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"}, qedFeynmanModel]],
  \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]\
\>", "Input",
 CellTags->"QEDSixPointPPMMExplicitReferenceChecks",
 CellLabel->"In[43]:=",ExpressionUUID->"800d516e-fb45-409b-87ed-f3daa59f60e2"],

Cell["\<\
qed6PPMMMadGraph = If[
  ValueQ[qed6PPMM] && FreeQ[qed6PPMM, _Failure | _Missing | $Failed | \
$Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"A.+\", \"A.+\", \"A.-\", \"A.-\"}, qed6PPMM, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"9ab8260a-162c-546d-9d3d-56b4075f3f96"]
}, Open  ]]
}, Open  ]],

