Cell["\<\
qed6SixFermions = ConstructAmplitude[
  {\"e\", \"E\", \"e\", \"E\", \"e\", \"E\"},
  diagramModel, factorizationModel,
  \"PolePreference\" -> \"AllPhysical\",
  \"FeynmanModel\" -> qedFeynmanModel]\
\>", "Input",
 CellChangeTimes->{4.00228100615427*^9, 4.002293018369754*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"18e82e69-d9e2-5b59-a83b-c6b2e930b604"],

Cell["Antisymmetrizing the two three-fermion currents gives one contribution for each of the nine internal fermion momenta. The full Feynman, CalcHEP and MadGraph comparisons use this nine-channel form.", "Text"],

Cell["(* Antisymmetrize each three-fermion current before sewing the nine exchanges. *)
ClearAll[qedSixFermionCurrent];
qedSixFermionCurrent[electrons_List, positrons_List, mass_, charge_] := Module[
  {angle, square, sandwich, pole, photonPole, leftWeights, rightWeights, sew, channel},
  angle[i_, j_] := SpinorChain[Spinor[\"Spin\", \"Angle\", i], Spinor[\"Spin\", \"Angle\", j]];
  square[i_, j_] := SpinorChain[Spinor[\"Spin\", \"Square\", i], Spinor[\"Spin\", \"Square\", j]];
  sandwich[i_, cut_, j_] := SpinorChain[Spinor[\"Spin\", \"Square\", i],
    Mom[Multiparticle @@ Sort[cut]], Spinor[\"Spin\", \"Angle\", j]];
  pole[cut_, m_] := PropDen[Mom[Multiparticle @@ Sort[cut]], m];
  photonPole[i_, j_] := pole[{i, j}, 0];

  (* Coefficients of each external spinor in the antisymmetrized currents.
     The left basis has labels {a,b,x}; the right basis has labels {c,d,y}. *)
  leftWeights[bracket_, {a_, b_, x_}] := {
    bracket[b, x]/photonPole[a, b],
    bracket[a, x] (1/photonPole[a, b] + 1/photonPole[x, b]),
    -bracket[b, a]/photonPole[x, b]};
  rightWeights[bracket_, {c_, d_, y_}] := {
    bracket[y, d] (1/photonPole[c, d] + 1/photonPole[c, y]),
    bracket[y, c]/photonPole[c, d],
    -bracket[d, c]/photonPole[c, y]};
  sew[left_, right_] := Module[
    {leftAngle = leftWeights[square, left], leftSquare = leftWeights[angle, left],
     rightAngle = rightWeights[square, right], rightSquare = rightWeights[angle, right]},
    Sum[leftAngle[[u]] Sum[
          rightSquare[[v]] sandwich[right[[v]], left, left[[u]]] +
          mass rightAngle[[v]] angle[left[[u]], right[[v]]], {v, 3}] +
        leftSquare[[u]] Sum[
          rightAngle[[v]] sandwich[left[[u]], left, right[[v]]] +
          mass rightSquare[[v]] square[left[[u]], right[[v]]], {v, 3}], {u, 3}]];
  channel[{a_, x_}, b_] := Module[{c, d, y, matching},
    {c} = Complement[electrons, {a, x}];
    {d, y} = Complement[positrons, {b}];
    matching = Last /@ SortBy[{{a, b}, {x, y}, {c, d}}, First];
    Signature[Ordering[matching]] sew[{a, b, x}, {c, d, y}]/pole[{a, b, x}, mass]];
  -4 charge^4 Total[Flatten[Outer[channel, Subsets[Sort[electrons], {2}], positrons, 1]]]
];", "Input"],

Cell["qed6SixFermionsCompact = qedSixFermionCurrent[{1, 3, 5}, {2, 4, 6},
  ModelParameter[factorizationModel, \"Me\"], ModelParameter[factorizationModel, \"EE\"]];", "Input"],

Cell["With[{process = {\"e\", \"E\", \"e\", \"E\", \"e\", \"E\"}},
  CheckAmplitudes[qed6SixFermionsCompact,
    FactorizationAmplitudeChannels[process, factorizationModel], factorizationModel,
    \"FeynmanAmplitudes\" -> DiagramAmplitudes[CreateDiagrams[process, qedFeynmanModel]],
    \"HighEnergyTimeConstraint\" -> 180, \"RandomSeed\" -> 802633,
    \"FeynmanModel\" -> qedFeynmanModel, \"Output\" -> \"Summary\"]]", "Input"],

Cell["\<\
qed6SixFermionsMadGraph = If[
  ValueQ[qed6SixFermionsCompact] && FreeQ[qed6SixFermionsCompact, _Failure | _Missing | \
$Failed | $Aborted | _ConstructAmplitude],
  ValidateMadGraph[
    {\"e\", \"E\", \"e\", \"E\", \"e\", \"E\"}, qed6SixFermionsCompact, \
factorizationModel,
    Sequence @@ madGraphValidationOptions],
  Missing[\"NotAvailable\", \"No successful constructive result is available \
yet\"]
]\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"46dba57c-c9a8-54ad-ab9e-c51309115304"],

Cell[CellGroupData[{

Cell["Export eeeeee to C++", "Section",ExpressionUUID->"363a3aa7-a532-51bb-b647-be49ba0e375f"],

Cell["\<\
This process has no massless-helicity branches. Every massive-fermion spin \
remains an argument of the generated amplitude.\
\>", "Text",ExpressionUUID->"2a9899a9-30b5-55dd-8e05-13529e1db2ce"],

Cell["\<\
eeeeeeExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeeeee\"}],
  {\"e\", \"E\"} -> {\"E\", \"e\", \"E\", \"e\"},
  {
    {{\"e\", \"E\", \"e\", \"E\", \"e\", \"E\"}, qed6SixFermionsCompact}
  }, factorizationModel,
  \"ProcessName\" -> \"eeeeee\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{{4.002806399507154*^9, 4.0028064044639883`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"1cd8cf8b-2382-5dcc-b099-df3c520fc451"],

Cell["\<\
The independent tests use the constructive expressions above. Full export and \
validation diagnostics remain in eeeeeeExport; a reference formula is never \
substituted. If an export already exists, add \"Overwrite\" -> True \
deliberately to refresh it.\
\>", "Text",ExpressionUUID->"fd5ab068-16f8-5226-82ee-8fd5e6f5953a"]
}, Open  ]]
}, Open  ]]
}, Closed]],

