Cell[CellGroupData[{

Cell["Export eeeeAA to C++", "Section",ExpressionUUID->"056405cf-409c-4dae-a1c3-e3152d19369a"],

Cell["\<\
The helicity expressions above are combined in one C++ process. Equivalent \
placements of the identical photons are filled automatically.\
\>", "Text",ExpressionUUID->"6869cb93-77d7-40a6-89c6-b76981b906f4"],

Cell[CellGroupData[{

Cell["\<\
eeeeAAExport = WriteSPINASProcess[
  FileNameJoin[{spinasOutputDirectory, \"eeeeAA\"}],
  {\"e\", \"E\"} -> {\"e\", \"E\", \"A\", \"A\"},
  {
    {{\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.+\"}, qed6FourFermionsPP},
    {{\"e\", \"E\", \"E\", \"e\", \"A.+\", \"A.-\"}, qed6FourFermionsPM},
    {{\"e\", \"E\", \"E\", \"e\", \"A.-\", \"A.-\"}, qed6FourFermionsMM}
  }, factorizationModel,
  \"ProcessName\" -> \"eeeeAA\",
  \"Build\" -> True, \"RunExamples\" -> True,
  \"Overwrite\"->True,
  \"CalcHEPDirectory\" -> calcHEPDirectory,
  \"CalcHEPModel\" -> calcHEPModel,
  \"CalcHEPAllowedParticles\" -> referenceParticlePDGs,
  \"MadGraphDirectory\" -> madGraphDirectory,
  \"MadGraphModel\" -> madGraphModel,
  \"MadGraphAllowedParticles\" -> referenceParticlePDGs,
  \"CalcHEPPoints\" -> validationPoints,
  \"MadGraphPoints\" -> validationPoints,
  \"RunCalcHEPValidation\" -> True,
  \"RunMadGraphValidation\" -> True,
  \"ReturnDetails\" -> True];\
\>", "Input",
 CellChangeTimes->{{4.0028063500322523`*^9, 4.0028063552951527`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"4268494e-d87c-4182-a5a2-662ba676a52f"],

