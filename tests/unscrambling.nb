Cell[CellGroupData[{
Cell["Unscrambling amplitudes", "Title",ExpressionUUID->"4b32ec66-9b2b-4d9d-a278-e7a25824c03f"],

Cell["\<\
Each sample is one diagramAmplitudes element, {mass rules, simplified \
expression}. ComplicateAmplitude substitutes those rules before it does \
anything else, so every expression contains Me, MW, or MZ rather than \
Mass[i]. That is the expression the simplifier would see if it were the only \
input. Each step is chosen from that full expression alone: Schouten, \
reversal of a spinor product, a mass insertion, momentum conservation, or the \
on-shell condition of an internal line. The expression is then expanded. Only \
the final scrambled expression and the original expression are kept.\
\>", "Text",ExpressionUUID->"53d1be7a-a63c-4a90-9b89-08e0b814194c"],

Cell[CellGroupData[{

Cell["Load", "Section",ExpressionUUID->"5d988c4e-9234-48be-b61a-6b75107e748c"],

Cell[CellGroupData[{

Cell["\<\
HEPCATBasePath = \"/Users/neil/code/hepcat\";
$HEPCATpath = HEPCATBasePath <> \"/source/\";
Get[$HEPCATpath <> \"HEPCAT.wl\"];
Get[HEPCATBasePath <> \"/tests/unscrambling.wl\"];
unscrambleModel = \"CompactActions\"; (* Or \"CandidateScorer\". *)
SetOptions[UnscrambleSpinorAmplitudes, \"Model\" -> unscrambleModel];
SetOptions[UnscrambleTrace, \"Model\" -> unscrambleModel];
\
\>", "Input",
 CellLabel->
  "In[177]:=",ExpressionUUID->"08dbf5e5-9e48-48bf-96d6-d1623153cea0"],

