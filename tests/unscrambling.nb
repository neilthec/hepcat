Cell[CellGroupData[{

Cell["One amplitude", "Section",ExpressionUUID->"0010c6e2-ebd8-43c9-a225-5fdbc9fb7600"],

Cell[CellGroupData[{

Cell["\<\
scr = ComplicateAmplitude[sampleAmplitudes[[1]], 14, 3];
scr[\"Steps\"]
{FreeQ[scr[\"Expression\"], Mass], ! FreeQ[scr[\"Expression\"], Me | Mm]}
Expand[scr[\"Original\"] - Expand[sampleAmplitudes[[1, 2]] /. \
sampleAmplitudes[[1, 1]]]]

scrZ = ComplicateAmplitude[sampleAmplitudes[[4]], 8, 2];
Expand[scrZ[\"Original\"] - Expand[sampleAmplitudes[[4, 2]] /. \
sampleAmplitudes[[4, 1]]]]
\
\>", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"8bdb777d-59ab-4663-b431-efa5a0cfb5a0"],

