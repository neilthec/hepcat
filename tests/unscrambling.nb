Cell[CellGroupData[{

Cell["Reduce", "Section",ExpressionUUID->"b7e4c1a2-6d18-4a3e-9c4a-1a2d0e5c4e11"],

Cell["\<\
Scramble a few known amplitudes and let the trained net simplify them. Lower \
score is simpler.\
\>", "Text",ExpressionUUID->"c8f2a9b0-1e4d-4c55-9a10-7d6e2a11aa01"],

Cell[CellGroupData[{

Cell["\<\
Do[
  pair = sampleAmplitudes[[i]];
  scr = ComplicateAmplitude[pair, 8, i];
  back = UnscrambleSpinorAmplitudes[{pair[[1]], scr[\"Expression\"]}];
  before = SpinorExpressionComplexity[scr[\"Expression\"]];
  after = SpinorExpressionComplexity[back[[2]]];
  Print[{i, \"before\", before, \"after\", after, \"simpler\", after < \
before}],
  {i, Min[4, Length[sampleAmplitudes]]}
]
\
\>", "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"d4a8e1f0-2b91-4e55-8c17-6a0c9d77e221"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "\<\"before\"\>", ",", "28", ",", "\<\"after\"\>", ",", "4", 
   ",", "\<\"simpler\"\>", ",", "True"}], "}"}]], "Print",
 CellChangeTimes->{3.999349519925441*^9, 3.999352032745962*^9, 
  3.999610749615526*^9, 3.9996118329129143`*^9},
