 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Steps\"\>", "\[Rule]", "6"}], ",", 
   RowBox[{"\<\"Trail\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"ReverseSpinor\"\>", ",", "\<\"ReverseSpinor\"\>", 
      ",", "\<\"ReverseSpinor\"\>", ",", "\<\"ReverseSpinor\"\>", 
      ",", "\<\"ReverseSpinor\"\>", ",", "\<\"Mass\"\>"}], "}"}]}], ",", 
   RowBox[{"\<\"Restored\"\>", "\[Rule]", "True"}]}], 
