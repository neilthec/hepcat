   RowBox[{"\<\"Steps\"\>", "\[Rule]", "6"}], ",", 
   RowBox[{"\<\"OriginalKept\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Changed\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.999251293236611*^9, 3.999253723702182*^9, 
