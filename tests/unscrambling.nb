  "1", ",", "\<\"before\"\>", ",", "28", ",", "\<\"after\"\>", ",", "4", 
   ",", "\<\"simpler\"\>", ",", "True"}], "}"}]], "Print",
 CellChangeTimes->{3.999349519925441*^9, 3.999352032745962*^9},
 CellLabel->
