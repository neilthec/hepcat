Cell[CellGroupData[{

Cell["One amplitude", "Section",ExpressionUUID->"0010c6e2-ebd8-43c9-a225-5fdbc9fb7600"],

Cell["\<\
scr = ComplicateAmplitude[sampleAmplitudes[[1]], 14, 3];
scr[\"Steps\"]
{FreeQ[scr[\"Expression\"], Mass], ! FreeQ[scr[\"Expression\"], Me | Mm]}
Expand[scr[\"Original\"] - Expand[sampleAmplitudes[[1, 2]] /. sampleAmplitudes[[1, 1]]]]

scrZ = ComplicateAmplitude[sampleAmplitudes[[4]], 8, 2];
Expand[scrZ[\"Original\"] - Expand[sampleAmplitudes[[4, 2]] /. sampleAmplitudes[[4, 1]]]]
\
\>", "Input",
 CellLabel->
  "In[5941]:=",ExpressionUUID->"8bdb777d-59ab-4663-b431-efa5a0cfb5a0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reduce", "Section",ExpressionUUID->"b7e4c1a2-6d18-4a3e-9c4a-1a2d0e5c4e11"],

Cell["\<\
Scramble a few known amplitudes and let the trained net simplify them. \
Lower score is simpler.\
\>", "Text",ExpressionUUID->"c8f2a9b0-1e4d-4c55-9a10-7d6e2a11aa01"],

Cell["\<\
Do[
  pair = sampleAmplitudes[[i]];
  scr = ComplicateAmplitude[pair, 8, i];
  back = UnscrambleSpinorAmplitudes[{pair[[1]], scr[\"Expression\"]}];
  before = SpinorExpressionComplexity[scr[\"Expression\"]];
  after = SpinorExpressionComplexity[back[[2]]];
  Print[{i, \"before\", before, \"after\", after, \"simpler\", after < before}],
  {i, Min[4, Length[sampleAmplitudes]]}
]
\
\>", "Input",
 CellLabel->
  "In[5960]:=",ExpressionUUID->"d4a8e1f0-2b91-4e55-8c17-6a0c9d77e221"]
}, Open  ]],

