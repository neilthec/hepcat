Notebook[{

Cell[CellGroupData[{
Cell["Train the unscrambler", "Title",ExpressionUUID->"9394847e-fc2a-4cc9-b49e-2a979cd6f8f4"],

Cell["\<\
Edit only the parameters in the first input cell. The trained net is written \
to tests/unscramble.wlnet inside hepcatDirectory. The full state is encoded once per candidate group, in both training and inference. Training replaces the current model; Git keeps its history. From a terminal:

python3 /path/to/hepcat/tests/train-unscrambling.py --threads 4 --kernels 2\
\>", "Text",ExpressionUUID->"cfe808c0-0bfc-431a-83fe-5464c5e9e6a8"],

Cell[CellGroupData[{

Cell["Parameters", "Section",ExpressionUUID->"40a28c1e-7b6d-4739-8677-ff82c87b0ac9"],

Cell["\<\
(* Set these before running. *)
hepcatDirectory = Replace[Environment[\"HEPCAT_TRAIN_ROOT\"],
  Except[_String] :> DirectoryName[NotebookDirectory[]]];
Get[hepcatDirectory <> \"/tests/training-notebook-helpers.wl\"];

(* All reference amplitudes, or a count from the front of the list. *)
nAmplitudes = trainingAmplitudeSetting[];

(* Scrambles of each amplitude, and how many identities are applied in each \
scramble. *)
nScrambles = trainingIntegerSetting[\"SCRAMBLES\", 4];
nSteps = trainingIntegerSetting[\"STEPS\", 5];

(* Maximum identities per holdout attempt. Training uses reverse scrambling \
trajectories to label legal candidate edits. *)
episodeLength = trainingIntegerSetting[\"EPISODE_LENGTH\", 4];
nRounds = trainingIntegerSetting[\"ROUNDS\", 2];

(* Fresh scrambles per amplitude, used only to report whether the trained net \
makes them simpler. *)
nHoldOut = trainingIntegerSetting[\"HOLDOUT\", 1];

(* Independent data-generation and validation workers. The launcher can override this count. *)
nKernels = trainingIntegerSetting[\"KERNELS\", 2];
workerThreads = trainingIntegerSetting[\"WORKER_THREADS\", 1];
(* Increase after comparing training time and memory with the same data. *)
trainingBatchSize = trainingIntegerSetting[\"BATCH_SIZE\", 1];
trainingDevice = \"CPU\";
modelOverride = Environment[\"HEPCAT_TRAIN_MODEL_DIRECTORY\"];
modelDirectory = If[StringQ[modelOverride] && StringLength[modelOverride] > 0, modelOverride, Automatic];
dataCacheDirectory = hepcatDirectory <> \"/tests/.unscramble-cache\";
\
\>", "Input",
 CellChangeTimes->{
  3.999265308713935*^9, {3.999342515036016*^9, 3.9993425158433113`*^9}, {
   3.9993425489871063`*^9, 3.999342556044286*^9}, {3.999342649884529*^9, 
   3.999342649946834*^9}},ExpressionUUID->"ef089402-2cfd-453a-8595-\
c14b35fbebb7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Load", "Section",ExpressionUUID->"db49dacf-a3be-4e38-8e3c-3ea3de6bb87e"],

Cell["\<\
$HEPCATpath = hepcatDirectory <> \"/source/\";
Get[$HEPCATpath <> \"HEPCAT.wl\"];
Get[hepcatDirectory <> \"/tests/unscrambling.wl\"];
\
\>", "Input",ExpressionUUID->"1aff748e-3159-40f6-88af-2fe19727aabe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Known amplitudes", "Section",ExpressionUUID->"eca0ca6d-991e-47c6-b74a-edaf730dc5ed"],

Cell["\<\
amplitudeCatalog = Get[hepcatDirectory <> \"/tests/training-amplitudes.wl\"];
knownAmplitudes = ({#[\"Masses\"], #[\"Amplitude\"]} &) /@ amplitudeCatalog;

If[nAmplitudes === All || nAmplitudes > Length[knownAmplitudes],
  nAmplitudes = Length[knownAmplitudes]
];
trainingAmplitudes = Take[knownAmplitudes, nAmplitudes];
Print[\"Reference amplitudes selected: \", nAmplitudes, \" / \", Length[knownAmplitudes]];
\
\>", "Input",ExpressionUUID->"54484d36-b7d6-46be-baee-44ec7be3b474"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Train", "Section",ExpressionUUID->"4a30c803-2f43-4599-8da5-e0cb3583f4bd"],

Cell["\<\
report = TrainUnscrambleNet[trainingAmplitudes,
  Steps -> nSteps,
  Scrambles -> nScrambles,
  HoldOut -> nHoldOut,
  MaxTrainingRounds -> nRounds,
  EpisodeLength -> episodeLength,
  Kernels -> nKernels,
  \"WorkerThreads\" -> workerThreads,
  \"TrainingBatchSize\" -> trainingBatchSize,
  TargetDevice -> trainingDevice,
  \"DataCacheDirectory\" -> dataCacheDirectory,
  \"ModelDirectory\" -> modelDirectory
];
Print[trainingRunSummary[report, <|\"Amplitudes\" -> nAmplitudes,
  \"Scrambles\" -> nScrambles, \"Steps\" -> nSteps, \"Rounds\" -> nRounds|>]];
\
\>", "Input",ExpressionUUID->"a947d9a3-8e7b-4272-b240-2bc1870c6535"]
}, Open  ]]
}, Open  ]]
},
WindowSize->{808, 911},
WindowMargins->{{12, Automatic}, {Automatic, 24}},
