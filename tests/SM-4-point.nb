Cell[CellGroupData[{

Cell["compareAmps", "Section",
 CellChangeTimes->{{3.917172028575809*^9, 
  3.917172030303906*^9}},ExpressionUUID->"fae0d7a9-d240-4620-a0d1-\
6b1f191bb606"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"compareAmps", "[", 
    RowBox[{"amp_", ",", "ampTested_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"diff", "=", "0"}], ",", 
       RowBox[{"sum", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"diff", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"amp", "-", "ampTested"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"diff", "=!=", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"sum", "=", 
          RowBox[{"Simplify", "[", 
           RowBox[{"amp", "+", "ampTested"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"sum", "=!=", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<Difference detected:\>\"", "]"}], ";", 
            
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t amp=              \>\"", ",", "amp"}], "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t ampTested=\>\"", ",", "ampTested"}], "]"}], 
            ";"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<Opposite sign detected:\>\"", "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t amp=              \>\"", ",", "amp"}], "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\t ampTested=\>\"", ",", "ampTested"}], "]"}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.917172033289138*^9, 3.91717210691038*^9}, {
  3.917172176987441*^9, 3.9171723211849413`*^9}, {3.91717786966842*^9, 
  3.9171778767613173`*^9}, {3.917178056694068*^9, 3.917178059690837*^9}, {
  3.917178324612371*^9, 3.917178357568068*^9}},
 CellLabel->
  "In[232]:=",ExpressionUUID->"26bad88b-89f9-4867-8e66-ff1ec5de14cc"]
}, Closed]],

