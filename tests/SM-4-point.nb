Cell[BoxData[{
 RowBox[{
  RowBox[{"spPr", "[", "str_", "]"}], ":=", 
  RowBox[{"ConvertStringAmplitude", "[", 
   RowBox[{"str", ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Mass", "[", "1", "]"}], ",", 
       RowBox[{"Mass", "[", "2", "]"}], ",", 
       RowBox[{"Mass", "[", "3", "]"}], ",", 
       RowBox[{"Mass", "[", "4", "]"}]}], "}"}], "/.", "mReplacments"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rsp", "[", "str_", "]"}], ":=", 
  RowBox[{"ReduceSpinorProducts", "[", 
   RowBox[{"ConvertStringAmplitude", "[", 
    RowBox[{"str", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Mass", "[", "1", "]"}], ",", 
        RowBox[{"Mass", "[", "2", "]"}], ",", 
        RowBox[{"Mass", "[", "3", "]"}], ",", 
        RowBox[{"Mass", "[", "4", "]"}]}], "}"}], "/.", "mReplacments"}]}], 
    "]"}], "]"}]}]}], "Input",
 CellLabel->
  "In[1091]:=",ExpressionUUID->"60914877-2cd4-4199-9ba8-9394189e4a4d"]
}, Closed]],

