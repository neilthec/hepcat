    If[free =!= {}, Join[
      If[proofSummary["IdentityProofUnfinished"] > 0, {
        "Some retained correction directions have not been proved to vanish by ordinary external identities. An unfinished identity proof does not establish a missing interaction or a need for additional model information."}, {}],
      If[establishedNonzero > 0, {
        "The requested conditions leave established nonzero correction freedom. Its zero-parameter representative is retained for inspection; additional justified constraints or model information are required."}, {}],
      {proofSummary}], {}],
    If[!AllTrue[validations, completionHEAllPassQ[#["Report"]] &], {
      "The candidate failed or could not complete independent validation; no complete amplitude is claimed."}, {}],
    If[!familyValid, {"The remaining affine family did not satisfy every exact held-out constraint; the reported fit-only freedom is not a validated amplitude family."}, {}],
    If[Length[ruleSets] === 1, {
      "Only the supplied parameter assignment was validated; no generic parameter-independence claim is made."}, {
      "The fitted correction was also checked at additional parameter assignments supplied by the user or generated by a theory-safe validation rule."}],
    {"All fit constraints are exact at the recorded samples. Independent samples are supplementary checks, not a generic analytic proof or a universal contact reconstruction."}];
  completionProgress[callback, enabled, <|"Stage" -> "HighEnergy", "Phase" -> "Finished", "Status" -> status|>];
  Join[report, <|"Status" -> status, "Amplitude" -> candidate,
    "FamilyAmplitude" -> family, "FreeParameters" -> free,
    "RemainingBasis" -> (D[family, #] & /@ free),
    "SolutionRules" -> solution["SolutionRules"], "AfterReport" -> validation,
    "ValidationReports" -> validations, "FamilyValidation" -> familyValidations,
    "ValidationParameterRules" -> ruleSets,
    "Correction" -> candidate - original, "RetainedDirectionProofSummary" -> proofSummary,
    "Diagnostics" -> diagnostics|>]
];

(* A point-first fit may keep coordinates whose directions are exact zero.
   They must not permanently suppress the ordinary source family after an
   exact contradiction. Successful fits do not enter this bounded recovery. *)
completionHEExactInconsistencyWitnessQ[certificate_Association] := Module[{method, rows},
  method = Lookup[certificate, "Method", None];
  rows = Lookup[certificate, "ReachedEquations", {}];
  If[!ListQ[rows] || rows === {} || !FreeQ[rows, _Real] ||
      !AllTrue[rows, residueFiniteQ] ||
      !ListQ[Lookup[certificate, "OriginalCoordinates", None]] ||
      !ListQ[Lookup[certificate, "PriorAffineRestrictionRules", None]] ||
      !AllTrue[certificate["PriorAffineRestrictionRules"], MatchQ[#, _Rule] &], Return[False]];
  Switch[method,
    "ExactParameterFamilyIntersectionContradiction",
      Lookup[certificate, "UncheckedParameterAssignmentsClaimed", None] === False &&
        completionHEExactInconsistencyWitnessQ[Lookup[certificate, "ChartContradiction", None]],
    "ExactAffineLinearContradiction",
      ListQ[Lookup[certificate, "WorkingCoordinates", None]] &&
        Lookup[certificate, "UncheckedChartsClaimed", None] === False &&
        Lookup[Lookup[certificate, "LinearSystem", <||>], "Status", None] === "INCONSISTENT",
    _, False]
];
completionHEExactInconsistencyWitnessQ[___] := False;

completionHEZeroFamilyRetryEligibleQ[normalized_Association, report_Association,
    settings_Association, pointFirst_] := TrueQ[pointFirst] &&
  Lookup[settings, "CorrectionBasis", None] === Automatic &&
  ListQ[Lookup[normalized, "FreeParameters", None]] &&
  Lookup[normalized, "FreeParameters", {}] =!= {} &&
  Lookup[report, "Status", None] === "UNRESOLVED" &&
  completionHEExactInconsistencyWitnessQ[Lookup[report, "HighEnergyInconsistencyCertificate", None]] &&
  Lookup[Lookup[Lookup[report, "ConstraintData", <||>], "HighEnergy", <||>],
    "Status", None] === "INCONSISTENT";
completionHEZeroFamilyRetryEligibleQ[___] := False;

completionHEEntireInheritedFamilyZeroQ[proof_, parameters_List] := Module[{certificates},
  If[!AssociationQ[proof] || parameters === {} || !DuplicateFreeQ[parameters] ||
      !TrueQ[Lookup[proof, "AffineFamily", False]] ||
      Lookup[proof, "FreeParameters", None] =!= {} ||
      Lookup[proof, "RemainingBasis", None] =!= {} ||
      Sort[Lookup[proof, "RemovedParameters", {}]] =!= Sort[parameters] ||
      !TrueQ[Lookup[Lookup[proof, "FamilyRepresentationCertificate", <||>],
        "OnlyCertifiedZeroDirectionsRemoved", False]] ||
      !KeyExistsQ[proof, "FamilyAmplitude"] ||
      !residueFiniteQ[proof["FamilyAmplitude"]] ||
      !FreeQ[proof["FamilyAmplitude"], Alternatives @@ parameters], Return[False]];
  certificates = Lookup[proof, "Certificates", {}];
  ListQ[certificates] && Length[certificates] === Length[parameters] &&
    AllTrue[certificates, AssociationQ[#] && Lookup[#, "Status", None] === "PROVED_ZERO" &] &&
    Sort[Lookup[certificates, "Parameter", {}]] === Sort[parameters]
];
completionHEEntireInheritedFamilyZeroQ[___] := False;

completionHERecoverZeroInheritedFamily[normalized_Association, originalReport_Association,
    channels_List, model_List, settings_Association, seconds_, pointFirst_, automaticSamples_] := Module[
  {started = AbsoluteTime[], deadline, left, proofBudget, proof, reduced, retrySettings,
   retry, retained, record, parameters = Lookup[normalized, "FreeParameters", {}], selected},
  If[!completionHEZeroFamilyRetryEligibleQ[normalized, originalReport, settings, pointFirst],
    Return[Missing["NoSuppressedOrdinarySourceRecovery"]]];
  record = <|"Attempted" -> False, "Retried" -> False,
    "Trigger" -> "ExactHighEnergyContradictionWithInheritedCoordinates",
    "OriginalReport" -> originalReport, "OriginalInheritedParameters" -> parameters,
    "OriginalChannelsRetained" -> True, "OriginalRemaindersRetained" -> True,
    "IndependentInteractionAdded" -> False, "BenchmarkUsedForConstruction" -> False|>;
  If[!(NumericQ[seconds] && TrueQ[0 < seconds < Infinity]) || seconds < 4,
    Return[Join[record, <|"Status" -> "NOT_RETRIED", "Diagnostics" -> {
      "The finite stage allowance cannot fund a certified-zero family recovery."}|>]]];
  deadline = started + seconds; left[] := Max[0, deadline - AbsoluteTime[]];
  proofBudget = Min[60, seconds/4];
  completionProgress[settings["ProgressFunction"], settings["ProgressReporting"],
    <|"Stage" -> "HighEnergy", "Phase" -> "Checking rejected inherited directions exactly",
      "Terms" -> Length[parameters], "SecondsAvailable" -> proofBudget|>];
  proof = TimeConstrained[completionHEPruneIdentityFamily[
    Lookup[normalized, "FamilyAmplitude", normalized["Expression"]], parameters,
    normalized["ExternalMassRules"], Lookup[settings, "IdentityProofModel", model],
    proofBudget, Lookup[normalized, "RemainingBasis", Automatic],
    Function[event, completionProgress[settings["ProgressFunction"], settings["ProgressReporting"], event]]],
    Max[0.000001, proofBudget], Missing["InheritedFamilyProofTimeConstraint"]];
  record = Join[record, <|"Attempted" -> True, "IdentityReduction" -> proof,
    "IdentityProofTimeConstraint" -> proofBudget|>];
  If[!completionHEEntireInheritedFamilyZeroQ[proof, parameters],
    Return[Join[record, <|"Status" -> "NOT_RETRIED", "ElapsedSeconds" -> AbsoluteTime[] - started,
      "Diagnostics" -> {"At least one inherited direction lacks an exact zero certificate; the original family and failure remain unchanged."}|>]]];
  If[left[] < 1, Return[Join[record, <|"Status" -> "NOT_RETRIED",
    "ElapsedSeconds" -> AbsoluteTime[] - started, "Diagnostics" -> {
      "The identity proof consumed the available retry allowance; the original failure remains unchanged."}|>]]];
  reduced = Join[normalized, <|"FamilyAmplitude" -> proof["FamilyAmplitude"],
    "FreeParameters" -> {}, "RemainingBasis" -> {}|>];
  retrySettings = Join[settings, <|"TimeConstraint" -> left[],
    "BeforeReport" -> Lookup[originalReport, "BeforeReport", Missing["NoCachedInitialCheck"]]|>];
  record = Join[record, <|"Retried" -> True, "CertifiedRemovedCoordinates" -> Length[parameters],
    "OrdinaryBasisReenabled" -> True, "RetryTimeConstraint" -> retrySettings["TimeConstraint"]|>];
  completionProgress[settings["ProgressFunction"], settings["ProgressReporting"],
    <|"Stage" -> "HighEnergy", "Phase" -> "Retrying ordinary sources after exact zero proofs",
      "Terms" -> Length[parameters], "SecondsAvailable" -> left[]|>];
  retained = originalReport;
  retry = TimeConstrained[Block[{$completionHighEnergyPointFirst = TrueQ[pointFirst],
      $completionAutomaticFitSamples = TrueQ[automaticSamples]},
    completionHighEnergyWork[reduced, channels, model, retrySettings, reduced,
      Function[value, retained = value]]], Max[0.000001, left[]],
    Join[retained, <|"Status" -> "UNRESOLVED", "Diagnostics" -> {
      "The certified-zero ordinary-source retry exceeded the remaining stage allowance."}|>]];
  selected = AssociationQ[retry] && KeyExistsQ[retry, "Amplitude"] &&
    residueFiniteQ[retry["Amplitude"]] &&
    (Lookup[retry, "Status", None] === "COMPLETE" || TrueQ[Lookup[retry, "PointReady", False]]);
  Join[record, <|"Status" -> If[AssociationQ[retry], Lookup[retry, "Status", "UNRESOLVED"], "UNRESOLVED"],
    "PointReady" -> TrueQ[If[AssociationQ[retry], Lookup[retry, "PointReady", False], False]],
    "SelectedRetryReport" -> selected, "RetryReport" -> retry,
    "Report" -> If[selected, retry, originalReport], "ElapsedSeconds" -> AbsoluteTime[] - started|>]
];

completionHighEnergyStage[input_, channels_List, model_List, requestedSettings_Association,
    channelPreparation_: None] := Block[{$completionParallelSettings =
    KeyTake[requestedSettings, {"Parallelization", "MaxKernels"}]}, Module[
  {normalized, report, retained, remaining, rawExpression, started = AbsoluteTime[],
   resolution = amplitudeAutomaticSettings["HighEnergy", requestedSettings,
     completionHighEnergyResourceMetrics[input,
       If[AssociationQ[channelPreparation],channelPreparation,channels],
       requestedSettings["CorrectionBasis"]]], settings, seconds, output,
   rules = residueParameterRules[model, requestedSettings["ParameterRules"]], effectiveSettings,
   cubicSource, preferredBudget, preferredStarted, preferredReport,
   sourceAttempts = {}, preferredProvenance = Missing["NoPreferredSource"],
   wholeSource=Missing["NotRequested"],wholeBudget,wholeStarted,wholeReport,wholeRetained,
   initialCheck=Missing["NotRequested"],precheckProofBudget,zeroFamilyRecovery},
  settings = resolution["Settings"];
  settings["RandomSeed"] = amplitudeResolveRandomSeed[settings["RandomSeed"]];
  seconds = settings["TimeConstraint"]; output = settings["Output"];
  If[!MemberQ[{"Amplitude", "Expression", "Details"}, output] ||
      !(settings["CorrectionBasis"] === Automatic || ListQ[settings["CorrectionBasis"]]) ||
      !MemberQ[preparationReferenceChoices, settings["PolePreference"]] ||
      !completionParameterRulesQ[rules] ||
      !(settings["ValidationParameterRules"] === Automatic ||
        ListQ[settings["ValidationParameterRules"]] &&
          AllTrue[settings["ValidationParameterRules"],
            completionParameterRulesQ]) ||
      !AllTrue[{settings["Samples"], settings["ValidationSamples"], settings["MaxCorrectionTerms"]},
        IntegerQ[#] && # > 0 &] || !IntegerQ[settings["RandomSeed"]] ||
      !MemberQ[{True, False}, settings["ProgressReporting"]] ||
      !MemberQ[{Automatic, True, False}, settings["Parallelization"]] ||
      !(settings["MaxKernels"] === Automatic ||
        IntegerQ[settings["MaxKernels"]] && settings["MaxKernels"] >= 1) ||
      !(settings["ProgressFunction"] === Automatic ||
        MatchQ[settings["ProgressFunction"], _Function | _Symbol]) ||
      !(seconds === Infinity || NumericQ[seconds] &&
        TrueQ[Element[seconds, Reals] && 0 < seconds < Infinity]) ||
      !(settings["HighEnergyBound"] === Automatic || NumericQ[settings["HighEnergyBound"]] &&
        TrueQ[Element[settings["HighEnergyBound"], Reals] && Abs[settings["HighEnergyBound"]] < Infinity]) ||
      Complement[Keys[settings], First /@ Options[CompleteHighEnergy]] =!= {},
    Return[Failure["InvalidCompletionOptions", <|"MessageTemplate" -> "Invalid high-energy completion options."|>]]];
  rawExpression = completionInputExpression[input];
  normalized = TimeConstrained[completionNormalizeInput[input, channels, model],
    seconds, Missing["NormalizationTimeout"]];
  If[MissingQ[normalized], Return[completionFormat[<|"Stage" -> "HighEnergy",
    "Status" -> "UNRESOLVED", "Amplitude" -> rawExpression,
    "OriginalInput" -> input, "OriginalExpression" -> rawExpression,
    "RandomSeed" -> settings["RandomSeed"],
    "Correction" -> 0, "CorrectionBasis" -> {}, "RemainingBasis" -> {},
    "FamilyAmplitude" -> rawExpression, "FreeParameters" -> {},
    "ElapsedSeconds" -> (AbsoluteTime[] - started),
    "Diagnostics" -> {"Input normalization exceeded TimeConstraint. The original input is retained without claiming a normalized amplitude."}|>, output]]];
  If[FailureQ[normalized] || normalized === $Failed, Return[normalized]];
  If[AssociationQ[channelPreparation], normalized = Join[normalized,
    <|"ChannelRemainderData" -> Lookup[channelPreparation, "RemainderData", {}]|>]];
  effectiveSettings = Join[settings, <|"ParameterRules" -> rules,
    "AutomaticCorrectionTermCeiling"->If[requestedSettings["MaxCorrectionTerms"]===Automatic &&
      requestedSettings["CorrectionBasis"]===Automatic,resolution["ResourcePolicy"]["CorrectionTermCeiling"],None],
    "IdentityProofModel" -> completionIdentityModel[model, requestedSettings["ParameterRules"]],
    "ValidationParameterRules" -> completionValidationRuleSets[model,
      settings["ParameterRules"], settings["ValidationParameterRules"]]|>];
  retained = <|"Stage" -> "HighEnergy", "Status" -> "UNRESOLVED",
      "RandomSeed" -> settings["RandomSeed"],
      "Amplitude" -> normalized["Expression"], "OriginalExpression" -> normalized["OriginalExpression"],
      "ExternalMassRules" -> normalized["ExternalMassRules"],
      "Correction" -> 0, "CorrectionBasis" -> {},
      "RemainingBasis" -> Lookup[normalized, "RemainingBasis", {}],
      "FamilyAmplitude" -> Lookup[normalized, "FamilyAmplitude", normalized["Expression"]],
      "FreeParameters" -> Lookup[normalized, "FreeParameters", {}],
      "Diagnostics" -> {}|>;
  remaining = If[seconds === Infinity, Infinity, Max[0, seconds - (AbsoluteTime[] - started)]];
  If[remaining === 0, Return[completionFormat[Join[retained,
    <|"ElapsedSeconds" -> (AbsoluteTime[] - started), "Diagnostics" -> {
      "Input normalization exhausted TimeConstraint; the normalized input was retained."}|>], output]]];
  report = Missing["NoPreferredSourceResult"];
  If[settings["CorrectionBasis"] === Automatic && remaining >= 40,
    cubicSource = TimeConstrained[completionHECubicBilinearSource[normalized, model,
      completionPolePreference[settings["PolePreference"], input], Min[3, remaining/10]],
      Min[3, remaining/10], Missing["CubicCurrentBudget"]];
    If[AssociationQ[cubicSource] && cubicSource["Direction"] =!= 0,
      preferredProvenance = KeyDrop[cubicSource, "Direction"];
      preferredBudget = Min[45, Max[1, seconds - (AbsoluteTime[] - started)]/2];
      preferredStarted = AbsoluteTime[];
      preferredReport = TimeConstrained[Block[{$completionAutomaticFitSamples =
          requestedSettings["Samples"] === Automatic, $completionHighEnergyPointFirst = False},
        completionHighEnergyWork[input, channels, model, Join[effectiveSettings,
          <|"CorrectionBasis" -> {cubicSource["Direction"]}, "TimeConstraint" -> preferredBudget|>],
          normalized, Function[value, retained = value]]], preferredBudget,
        Join[retained, <|"Status" -> "UNRESOLVED", "Diagnostics" -> {
          "The preferred certified cubic-current fit exceeded its shared bounded allowance."}|>]];
      AppendTo[sourceAttempts, <|"Source" -> cubicSource["Source"],
        "Status" -> Lookup[preferredReport, "Status", "UNRESOLVED"],
        "ElapsedSeconds" -> AbsoluteTime[] - preferredStarted,
        "CorrectionDirections" -> 1, "OriginalInheritedFamilyRetained" -> True|>];
      If[Lookup[preferredReport, "Status", None] === "COMPLETE", report = preferredReport]]];
  remaining = If[seconds === Infinity, Infinity, Max[0, seconds - (AbsoluteTime[] - started)]];
  If[!AssociationQ[report] && settings["CorrectionBasis"]===Automatic && remaining>=60 &&
      completionHEWholeSourcePreflightQ[normalized,resolution["ResourcePolicy"]["Metrics"]],
    precheckProofBudget=remaining;
    initialCheck=If[AssociationQ[preferredReport],Lookup[preferredReport,"BeforeReport",Missing["NoInitialCheck"]],
      Missing["NoInitialCheck"]];
    If[!completionHEReusableInitialReportQ[initialCheck],
      completionProgress[settings["ProgressFunction"],settings["ProgressReporting"],
        <|"Stage"->"HighEnergy","Phase"->"InitialChecks"|>];
      initialCheck=TimeConstrained[completionHECheck[normalized["Expression"],normalized,channels,model,
        effectiveSettings,settings["RandomSeed"]],remaining,Missing["InitialCheckTimeConstraint"]]];
    If[completionHEReusableInitialReportQ[initialCheck],
      effectiveSettings=Join[effectiveSettings,<|"BeforeReport"->initialCheck|>,
        If[completionHEAllPassQ[initialCheck],
          <|"IdentityProofStageTimeConstraint"->precheckProofBudget|>,<||>]]];
    remaining=If[seconds===Infinity,Infinity,Max[0,seconds-(AbsoluteTime[]-started)]];
    wholeSource=If[completionHEReusableInitialReportQ[initialCheck] && !completionHEAllPassQ[initialCheck] && remaining>=30,
      completionHEWholeSourceRemainders[normalized,model,Min[3,remaining/20]],Missing["NoFailedInitialChecks"]];
    If[completionHEWholeSourceEligibleQ[wholeSource,resolution["ResourcePolicy"]["Metrics"]],
      remaining=If[seconds===Infinity,Infinity,Max[0,seconds-(AbsoluteTime[]-started)]];
      wholeBudget=Min[60,remaining/3];wholeStarted=AbsoluteTime[];wholeRetained=retained;
      completionProgress[settings["ProgressFunction"],settings["ProgressReporting"],
        <|"Stage"->"HighEnergy","Phase"->"Trying whole correlated remainders",
          "Terms"->Length[wholeSource["Basis"]],"InheritedCoordinates"->Length[Lookup[normalized,"FreeParameters",{}]],
          "SecondsAvailable"->wholeBudget|>];
      wholeReport=TimeConstrained[Block[{$completionAutomaticFitSamples=requestedSettings["Samples"]===Automatic,
          $completionHighEnergyPointFirst=False},
        completionHighEnergyWork[input,channels,model,Join[effectiveSettings,
          <|"CorrectionBasis"->wholeSource["Basis"],"TimeConstraint"->wholeBudget|>],normalized,
          Function[value,wholeRetained=value]]],wholeBudget,
        Join[wholeRetained,<|"Status"->"UNRESOLVED","Diagnostics"->{
          "The whole correlated remainder proposal exceeded its shared bounded allowance."}|>]];
      AppendTo[sourceAttempts,<|"Source"->"WholeCorrelatedShellDifferences",
        "Status"->Lookup[wholeReport,"Status","UNRESOLVED"],"ElapsedSeconds"->AbsoluteTime[]-wholeStarted,
        "Diagnostics"->Lookup[wholeReport,"Diagnostics",{}],
        "RemainingCoordinates"->Length[Lookup[wholeReport,"FreeParameters",{}]],
        "CompletedConstraintGroups"->Keys[Select[Lookup[wholeReport,"ConstraintData",<||>],
          AssociationQ[#] && Lookup[#,"Status",None]==="COMPLETE"&]],
        "CorrectionDirections"->Length[wholeSource["Basis"]],"OriginalInheritedFamilyRetained"->True,
        "FullOriginalSourcesRetainedForFallback"->True,"MaximumSeconds"->wholeBudget|>];
      If[Lookup[wholeReport,"Status",None]==="COMPLETE",report=wholeReport]]];
  remaining = If[seconds === Infinity, Infinity, Max[0, seconds - (AbsoluteTime[] - started)]];
  If[!AssociationQ[report],
  report = TimeConstrained[Block[{$completionAutomaticFitSamples =
      requestedSettings["Samples"] === Automatic},
    completionHighEnergyWork[input, channels, model,
      Join[effectiveSettings, <|"TimeConstraint" -> remaining|>], normalized,
      Function[value, retained = value]]], remaining,
    Join[retained, <|"Status" -> "UNRESOLVED", "Diagnostics" -> Append[
      Lookup[retained, "Diagnostics", {}],
      "High-energy completion exceeded TimeConstraint. The best retained candidate is provided for inspection, not claimed complete."]|>]]];
  remaining = If[seconds === Infinity, Infinity, Max[0, seconds - (AbsoluteTime[] - started)]];
  zeroFamilyRecovery = completionHERecoverZeroInheritedFamily[normalized, report, channels, model,
    effectiveSettings, remaining, TrueQ[$completionHighEnergyPointFirst],
    requestedSettings["Samples"] === Automatic];
  If[AssociationQ[zeroFamilyRecovery], report = Join[Lookup[zeroFamilyRecovery, "Report", report],
    <|"CertifiedZeroOrdinarySourceRetry" -> KeyDrop[zeroFamilyRecovery, "Report"]|>]];
  If[sourceAttempts =!= {}, report = Join[report, <|"AutomaticSourceAttempts" -> sourceAttempts,
    "PreferredCubicCurrentSource" -> preferredProvenance|>]];
  If[AssociationQ[wholeSource],report=Join[report,<|"WholeCorrelatedSourceProposal"->KeyDrop[wholeSource,"Basis"]|>]];
  completionFormat[Join[report, <|"RandomSeed" -> settings["RandomSeed"], "PolePreference" ->
      completionPolePreference[settings["PolePreference"], input], "ParameterRules" -> rules,
    "ResourcePolicy" -> Join[resolution["ResourcePolicy"], <|"Resolved" ->
      Join[resolution["ResourcePolicy"]["Resolved"],
        <|"Samples" -> Lookup[report, "FitSamples", settings["Samples"]],
          "MaxCorrectionTerms"->Lookup[report,"EffectiveMaxCorrectionTerms",settings["MaxCorrectionTerms"]]|>],
      "CapChanges"->Lookup[report,"CapChanges",{}]|>],
    "ElapsedSeconds" -> (AbsoluteTime[] - started)|>], output]
]];

End[];
End[];

(* ::Section::Closed:: *)
(*Amplitude Construction Workflow*)

Begin["ConstructiveDiagrams`"];

ConstructAmplitude::usage = "ConstructAmplitude[process, diagramModel, factorizationModel] generates and prepares diagrams and factorization channels, completes factorization and high-energy behavior, prepares each completed expression with external identities only, then checks the final amplitude. The ordinary result is the bare expression only when every required final check passes. Output -> Amplitude returns {externalMassRules, expression}; Details retains stage results, timings and diagnostics. ProgressReporting -> True displays the current stage, its elapsed time and total elapsed time. At the end PrintReport -> True prints total time, the final SpinorExpressionComplexity score and the test table before returning the expression. FeynmanModel -> None optionally supplies an independent model whose diagrams are prepared and compared too. PreparationOptions, ChannelPreparationOptions, FinalPreparationOptions, FactorizationOptions, HighEnergyOptions, CheckOptions and FeynmanPreparationOptions pass options to individual stages. TimeConstraint -> Automatic selects a finite overall budget from the process and workload; individual stages resolve their own automatic limits. Explicit values override those choices. PolePreference -> AllPhysical is the default; AllSpurious prefers massless-reference forms and uses eligible physical replacements when needed. Mixed admits both. Final expressions resolve auxiliary Xi unless Xi, IndependentXi or None is requested. These choices leave validation intact. ParameterRules, HighEnergyBound, Samples, ValidationSamples, RandomSeed, Parallelization and MaxKernels provide common settings. The original channels remain the residue targets, discarded preparation terms and affine completion freedom are retained, and final preparation never applies internal-shell identities. Failed, opposite-sign and unresolved checks never produce a validated amplitude. With AllSpurious and a FeynmanModel, supported massive fermion lines with one opposite-helicity massless vector can first try a compact common-reference current derived from the diagram vertices. The current must pass the same amplitude checks before it is selected. For mixed helicities on a supported cubic vector line, a bounded off-shell construction uses the model vertices and shared massless references and returns the first validated form. For supported diagrams with two massive fermion lines and two external massless vectors, AllSpurious can group the photon attachments and contract the currents before expanding their spinor products. The constructor verifies the original cuts and exchange signs and accepts the result after independent validation. For supported six-fermion trees with no external vector legs, AllSpurious can combine the ordered fermion exchanges over their common physical vector propagators. The candidate is returned only after the original channel checks and independent Feynman comparison pass. A supported line with four external vectors of the same helicity can combine adjacent emission orders in pairs before validation. For larger AllPhysical processes with a supplied FeynmanModel, a certified minimal massive fermion line with same-helicity colorless vectors can combine photon subsets through ordinary off-shell Dirac identities. Every original residue and independent Feynman comparison must pass before this candidate is returned. For larger AllSpurious results with a FeynmanModel, a bounded compound-pole exchange reduction can propose a shorter form for independent validation. When FeynmanModel is supplied, a fixed factorization or high-energy candidate can be selected after every mandatory check and independent Feynman comparison passes; its unclassified affine family remains in Details and no uniqueness is claimed. Without that independent benchmark, unresolved completion freedom remains a failure.";
ConstructAmplitude::usage = ConstructAmplitude::usage <>
  " RandomSeed -> Automatic chooses one time-based run seed. The stages derive their seeds from that value, with explicit stage overrides honored. Details records RandomSeed and PrintReport prints it with the final timing; an explicit integer reproduces the sample choices.";
ConstructAmplitude::usage = ConstructAmplitude::usage <>
  " For larger AllSpurious lines with equal-helicity colorless vectors and a supplied FeynmanModel, a bounded terminal-pair and subset current uses the certified cubic vertices, external Dirac identities and momentum conservation. It keeps every internal propagator off shell and resolves all auxiliary references. Every original residue, apparent spurious pole, high-energy condition and independent Feynman comparison must pass before the candidate is returned.";
ConstructAmplitude::usage = ConstructAmplitude::usage <>
  " If an automatic high-energy timeout retains a fully solved point with every affine coordinate classified, a separate Validating retained HE candidate stage may use the remaining overall budget. It rechecks every original parameter assignment with the normal independent seeds and sample counts, and leaves the original child UNRESOLVED in Details. Explicit high-energy limits, unfinished classifications and known failed held-out checks cannot use this recovery. Final preparation and final checking remain required.";
ConstructAmplitude::args = "Expected a process with at least four model particle names, a diagram model, a constructive factorization model, and valid construction options.";

Options[ConstructAmplitude] = {
  "PolePreference" -> "AllPhysical", "ParameterRules" -> Automatic, "HighEnergyBound" -> Automatic,
  "BoseSymmetryGroups" -> Automatic, "FermionSymmetryGroups" -> Automatic,
  "Samples" -> Automatic, "ValidationSamples" -> Automatic, "RandomSeed" -> Automatic,
  "Parallelization" -> Automatic, "MaxKernels" -> Automatic,
  "TimeConstraint" -> Automatic, "ProgressReporting" -> True,
  "ProgressFunction" -> Automatic, "PrintReport" -> True,
  "PreparationOptions" -> {}, "ChannelPreparationOptions" -> {},
  "FinalPreparationOptions" -> {}, "FactorizationOptions" -> {},
  "HighEnergyOptions" -> {}, "CheckOptions" -> {},
  "FeynmanModel" -> None, "FeynmanPreparationOptions" -> {},
  "Output" -> "Expression"};

Begin["ConstructiveDiagrams`Private`"];

constructRuleOptions[value_] := If[AssociationQ[value], value, Association[Reverse[value]]];
constructOptionBagQ[value_, function_] := (AssociationQ[value] || ListQ[value]) &&
  OptionQ[Normal[value]] && Complement[First /@ Normal[value], First /@ Options[function]] === {};
constructExternalMasses[process_List, model_] := Module[{parts, names, spin, resolved},
  If[!TrueQ[feynmanModelQ[model]], Return[physicalParticleMass[#, model[[1]]] & /@ process]];
  parts = List @@ model;
  names = DeleteDuplicates[Flatten[parts[[1, All, {2, 3}]]]];
  spin = Association[Flatten[({#[[2]] -> #[[5]], #[[3]] -> #[[5]]} &) /@ parts[[1]]]];
  resolved = feynmanExternalParticle[#, names, spin] & /@ process;
  Map[If[MissingQ[#], #, physicalParticleMass[First[#], parts[[1]]]] &, resolved]
];
constructSecondsQ[value_] := value === Infinity || NumericQ[value] &&
  TrueQ[Element[value, Reals] && 0 < value < Infinity];
constructDuration[seconds_] := ToString[NumberForm[N[seconds], {12, 1}], StandardForm] <> " s";
(* Reporting must not delay a validated large result indefinitely. A failed
   measurement is explicit; a leaf count is not the requested complexity. *)
constructComplexity[expr_] := TimeConstrained[MemoryConstrained[
  SpinorExpressionComplexity[expr], 268435456, Missing["ComplexityMemoryLimit"]],
  2, Missing["ComplexityTimeLimit"]];
constructFailure[stage_, diagnostics_List] := Failure["AmplitudeConstructionFailed", <|
  "MessageTemplate" -> "Amplitude construction stopped at `1`. No validated final expression was produced.",
  "MessageParameters" -> {stage}, "Stage" -> stage, "Status" -> "FAILED",
  "Diagnostics" -> diagnostics|>];

(* Ordinary output must not embed whole partial color fits in a notebook.
   Detailed output retains the original failure, reports and checkpoints. *)
constructFailureSummary[Failure[tag_, data_Association]] := Module[
  {child = Lookup[data, "Report", None], cause, causeData, base, stage, diagnostics},
  cause = Which[FailureQ[child], child,
    AssociationQ[child], Lookup[child, "Failure", None], True, None];
  causeData = If[FailureQ[cause] && AssociationQ[cause[[2]]], cause[[2]], <||>];
  base = Select[KeyTake[data, {"MessageTemplate", "ColorCoefficient", "ColorCoefficients",
    "CompletedColorCoefficients"}], StringQ[#] || IntegerQ[#] &];
  stage = Lookup[causeData, "Stage", Lookup[data, "Stage", "Constructing colored amplitude"]];
  If[!StringQ[stage], stage = "Constructing colored amplitude"];
  diagnostics = Cases[{Lookup[causeData, "Diagnostics", {}],
    If[AssociationQ[child], Lookup[child, "Diagnostics", {}], {}],
    Lookup[data, "Diagnostics", {}]}, _String, {1, 2}];
  diagnostics = Take[DeleteDuplicates[diagnostics], UpTo[4]];
  diagnostics = (If[StringLength[#] > 400, StringTake[#, 397] <> "...", #] &) /@ diagnostics;
  Failure[tag, Join[base, <|"Status" -> "FAILED", "Stage" -> stage,
    "Diagnostics" -> diagnostics,
    "Details" -> "Use \"Output\" -> \"Details\" to retain the complete partial report."|>]]
];
constructFailureSummary[failure_Failure] := failure;


(* Whole-amplitude preparation is an ordinary external identity. Shift the
   retained affine family by that same identity, preserving every free direction. *)
constructPreparedFamily[report_Association, pair_List] := Module[
  {old = report["Amplitude"], prepared = Last[pair], family},
  family = Lookup[report, "FamilyAmplitude", old] + prepared - old;
  Join[report, <|"Amplitude" -> prepared, "FamilyAmplitude" -> family,
    "ExternalMassRules" -> First[pair],
    "Correction" -> Lookup[report, "Correction", 0] + prepared - old|>]
];

(* A timed-out automatic child may have finished its entire exact fit and
   classified every coordinate, yet lack independent validation. Such a point
   can only be admitted to a NEW parent-budget validation stage. Its original
   child status remains UNRESOLVED. Use the recorded fit parameter assignments
   and the original independent seeds; resolving a full numerical parameter
   list again would freeze primitive variations and silently drop tests. *)
constructRetainedExactDerivativeClassification[h_Association, oldFree_List] := Module[
  {data,removed,certificates,linear,rules,coordinates,witness,trial,derivative,matching,
   verified,tag=Unique["exactDerivativeReplay"]},
  If[!KeyExistsQ[h,"ExactDerivativeZeroClassification"],
    Return[<|"RemovedParameters"->{},"Certificates"->{}|>]];
  data=h["ExactDerivativeZeroClassification"];linear=Lookup[h,"LinearSystem",<||>];
  If[!AssociationQ[data] || !AssociationQ[linear],Return[$Failed]];
  removed=Lookup[data,"RemovedParameters",None];certificates=Lookup[data,"Certificates",None];
  rules=Lookup[linear,"SolutionRules",None];coordinates=Lookup[data,"OriginalCoordinates",None];
  If[!ListQ[removed] || removed==={} || !DuplicateFreeQ[removed] ||
      !ContainsAll[oldFree,removed] || !ListQ[certificates] ||
      Lookup[data,"OriginalFreeParameters",None]=!=oldFree ||
      !ListQ[rules] || Lookup[data,"SolutionRules",None]=!=rules ||
      !ListQ[coordinates] || !DuplicateFreeQ[coordinates] || !ContainsAll[coordinates,oldFree] ||
      !KeyExistsQ[data,"OriginalSolvedFamilyWitness"] || !KeyExistsQ[data,"OriginalTrialWitness"] ||
      Lookup[data,"InternalOnShellConditions",None]=!={} ||
      Lookup[data,"NumericalParameterAssignments",None]=!={},Return[$Failed]];
  trial=data["OriginalTrialWitness"];witness=data["OriginalSolvedFamilyWitness"];
  If[!residueFiniteQ[{trial,witness}] || !SameQ[trial/.rules,witness],Return[$Failed]];
  verified=Catch[Do[
    matching=Select[certificates,AssociationQ[#] && Lookup[#,"Parameter",None]===parameter&];
    If[Length[matching]=!=1,Throw[False,tag]];
    matching=First[matching];derivative=D[witness,parameter];
    If[Lookup[matching,"Status",None]=!="PROVED_ZERO" ||
        Lookup[matching,"Method",None]=!="ExactRationalDerivativeZero" ||
        !KeyExistsQ[matching,"DerivativeWitness"] ||
        !SameQ[derivative,matching["DerivativeWitness"]] ||
        Lookup[matching,"ExactRationalDerivative",None]=!=0 ||
        Lookup[matching,"InternalOnShellConditions",None]=!={} ||
        Lookup[matching,"NumericalParameterAssignments",None]=!={} ||
        !residueExactZero[derivative],Throw[False,tag]],{parameter,removed}];True,tag];
  If[!TrueQ[verified],Return[$Failed]];
  data
];

constructRetainedHighEnergyCheckpoint[h_] := Module[
 {deny,policy,requested,resolved,groups,names={"Physical","HighEnergy","Spurious","Reference"},
  assignments,sets,linear,oldFree,prune,removed,certificates,knownChecks,failed,
  exactClassification,exactRemoved,allRemoved,witness},
 deny[reason_] := Failure["RetainedHECheckpointNotAdmitted",<|"Reason"->reason|>];
 If[!AssociationQ[h] || Lookup[h,"Stage",None]=!="HighEnergy" ||
    Lookup[h,"Status",None]=!="UNRESOLVED",Return[deny["NotUnresolvedHighEnergyStage"]]];
 policy=Lookup[h,"ResourcePolicy",<||>];requested=Lookup[policy,"Requested",<||>];resolved=Lookup[policy,"Resolved",<||>];
 If[Lookup[requested,"TimeConstraint",None]=!=Automatic,Return[deny["ExplicitHighEnergyTimeConstraint"]]];
 If[!MemberQ[Lookup[h,"Diagnostics",{}],
    "High-energy completion exceeded TimeConstraint. The best retained candidate is provided for inspection, not claimed complete."],
   Return[deny["NotRetainedStageTimeout"]]];
 If[Lookup[h,"FreeParameters",None]=!={} || Lookup[h,"RemainingBasis",None]=!={} ||
    !KeyExistsQ[h,"Amplitude"] || Lookup[h,"FamilyAmplitude",None]=!=h["Amplitude"] ||
    !residueFiniteQ[h["Amplitude"]] ||
    !preparationScalarExternalRulesQ[Lookup[h,"ExternalMassRules",{}]],
   Return[deny["NotFullyClassifiedFinitePoint"]]];
 groups=Lookup[h,"ConstraintData",<||>];
 If[!AssociationQ[groups] || !ContainsAll[Keys[groups],names] ||
    !AllTrue[Lookup[groups,names],AssociationQ[#]&&Lookup[#,"Status",None]==="COMPLETE"&],
   Return[deny["MissingCompletedConstraintGroup"]]];
 assignments=Lookup[#,"ParameterAssignments",{}]&/@Lookup[groups,names];
 If[AnyTrue[assignments,!ListQ[#]||#==={}||!AllTrue[#,AssociationQ[#]&&
      ListQ[Lookup[#,"ParameterRules",None]]&&AssociationQ[Lookup[#,"Report",None]]&&
      Lookup[#["Report"],"Status",None]==="COMPLETE"&]&],
   Return[deny["UnrecordedOrIncompleteParameterAssignments"]]];
 sets=Lookup[#,"ParameterRules"]&/@assignments;
 If[!AllTrue[Rest[sets],SameQ[#,First[sets]]&],Return[deny["DifferentConstraintParameterAssignments"]]];
 linear=Lookup[h,"LinearSystem",<||>];oldFree=Lookup[linear,"FreeParameters",None];
 If[!AssociationQ[linear] || !MemberQ[{"COMPLETE","UNDERDETERMINED"},Lookup[linear,"Status",None]] ||
    !ListQ[oldFree],Return[deny["NoSolvedExactLinearSystem"]]];
 If[oldFree=!={},
   exactClassification=constructRetainedExactDerivativeClassification[h,oldFree];
   If[exactClassification===$Failed,Return[deny["UnclassifiedOrUnprovedRemainingCoordinate"]]];
   exactRemoved=exactClassification["RemovedParameters"];
   prune=Lookup[h,"SolvedFamilyIdentityReduction",<||>];removed=Lookup[prune,"RemovedParameters",{}];
   certificates=Lookup[prune,"Certificates",{}];
   If[!ListQ[removed] || !ListQ[certificates] || Intersection[removed,exactRemoved]=!={},
     Return[deny["UnclassifiedOrUnprovedRemainingCoordinate"]]];
   allRemoved=Join[removed,exactRemoved];
   If[Sort[allRemoved]=!=Sort[oldFree],Return[deny["UnclassifiedOrUnprovedRemainingCoordinate"]]];
   If[removed=!={} && (!TrueQ[Lookup[prune,"AffineFamily",False]] ||
      Lookup[prune,"FreeParameters",None]=!={} ||
      !TrueQ[Lookup[Lookup[prune,"FamilyRepresentationCertificate",<||>],
       "OnlyCertifiedZeroDirectionsRemoved",False]] ||
      !AllTrue[removed,Function[parameter,AnyTrue[certificates,
        AssociationQ[#]&&Lookup[#,"Parameter",None]===parameter&&Lookup[#,"Status",None]==="PROVED_ZERO"&&
        Lookup[#,"InternalOnShellConditions",None]==={}&]]]),Return[deny["UnclassifiedOrUnprovedRemainingCoordinate"]]];
   If[exactRemoved=!={},
     witness=exactClassification["OriginalSolvedFamilyWitness"];
     If[!SameQ[witness/.Thread[allRemoved->0],h["FamilyAmplitude"]],
       Return[deny["UnclassifiedOrUnprovedRemainingCoordinate"]]]]];
 knownChecks=KeyTake[h,{"AfterReport","ValidationReports","FamilyValidation"}];
 failed=Cases[knownChecks,a_Association /; MemberQ[{"FAIL","Opp Sign"},Lookup[a,"Status",None]],Infinity];
 If[failed=!={},Return[deny["KnownFailedIndependentValidation"]]];
 If[!IntegerQ[Lookup[h,"RandomSeed",None]] || !IntegerQ[Lookup[resolved,"ValidationSamples",None]] ||
      resolved["ValidationSamples"]<=0 || !NumericQ[Lookup[h,"ExpectedPower",None]],
   Return[deny["MissingExactValidationSettings"]]];
 <|"Status"->"ELIGIBLE","Amplitude"->h["Amplitude"],"ExternalMassRules"->h["ExternalMassRules"],
   "ValidationParameterAssignments"->First[sets],"ValidationSamples"->resolved["ValidationSamples"],
   "HighEnergyBound"->h["ExpectedPower"],"RandomSeed"->h["RandomSeed"],
   "UniqueWithinRetainedSourceFamily"->True,"OriginalHighEnergyStatus"->h["Status"],
   "ValidationSeeds"->Table[h["RandomSeed"]+104729 i,{i,Length[First[sets]]}],
   "Certificate"-><|"AllFourFitGroupsComplete"->True,"EveryRetainedCoordinateClassified"->True,
     "RemovedCoordinatesProvedByOrdinaryExternalIdentities"->True,"NoKnownFailedIndependentCheck"->True,
     "OriginalFittedParameterAssignmentsRetained"->True,"NoChildCompletionClaimed"->True|>|>
];

constructValidateRetainedHighEnergy[h_,channels_List,model_List,seconds_,parallel_:Automatic,maxKernels_:Automatic,callback_:Automatic] := Module[
 {admission=constructRetainedHighEnergyCheckpoint[h],began=AbsoluteTime[],remaining,reports={},
  normalized,settings,report,seed,assignments,index=1,status="UNRESOLVED"},
 If[FailureQ[admission],Return[admission]];
 remaining[]:=Max[0,seconds-(AbsoluteTime[]-began)];
 normalized=<|"ExternalMassRules"->admission["ExternalMassRules"]|>;
 assignments=admission["ValidationParameterAssignments"];
 While[index<=Length[assignments]&&remaining[]>0.001,
   settings=<|"ParameterRules"->assignments[[index]],
     "ValidationSamples"->admission["ValidationSamples"],"HighEnergyBound"->admission["HighEnergyBound"],
     "Parallelization"->parallel,"MaxKernels"->maxKernels,"TimeConstraint"->remaining[]|>;
   seed=admission["ValidationSeeds"][[index]];
   completionProgress[callback,True,<|"Stage"->"RetainedHighEnergyValidation",
     "Phase"->"IndependentValidation","Completed"->index-1,"Total"->Length[assignments]|>];
   report=TimeConstrained[completionHECheck[admission["Amplitude"],
     normalized,channels,model,settings,seed],Max[0.000001,remaining[]],Missing["ParentValidationTimeConstraint"]];
   AppendTo[reports,<|"ParameterRules"->assignments[[index]],"RandomSeed"->seed,
     "Samples"->admission["ValidationSamples"],"Report"->report|>];
   If[!constructAllChecksPassQ[report,{admission["ExternalMassRules"],admission["Amplitude"]},
       channels,model,None],Break[]];index++];
 If[Length[reports]===Length[assignments] && AllTrue[reports,
    constructAllChecksPassQ[#["Report"],{admission["ExternalMassRules"],admission["Amplitude"]},
      channels,model,None]&],status="COMPLETE"];
 <|"Stage"->"Validating retained HE candidate","Status"->status,
   "OriginalHighEnergyStatus"->Lookup[h,"Status",None],"Amplitude"->admission["Amplitude"],
   "ExternalMassRules"->admission["ExternalMassRules"],"ValidationReports"->reports,
   "RequestedParameterAssignments"->Length[assignments],"CompletedParameterAssignments"->Length[reports],
   "CandidateAdmission"->KeyDrop[admission,{"Amplitude","ExternalMassRules","ValidationParameterAssignments"}],
   "TimeBudgetScope"->"RemainingOverallConstructionBudgetNotExpiredChildStage",
   "ElapsedSeconds"->AbsoluteTime[]-began|>
];

(* A bounded heuristic search need not finish to supply a valid snapshot.
   Conversion/reference failures and rejected reductions are different: those
   must stop the workflow. Final validation still has to pass every test. *)
constructPreparationUsableQ[report_] := Module[{items, keepReferences},
  If[!AssociationQ[report] ||
      !MemberQ[{"PREPARED", "PARTIAL"}, Lookup[report, "Status", None]] ||
      !ListQ[Lookup[report, "ItemReports", None]] ||
      !ListQ[Lookup[report, "PreparedAmplitudes", None]], Return[False]];
  items = report["ItemReports"];
  keepReferences = Lookup[Lookup[report, "Options", <||>], "PolePreference", Automatic] === None;
  Length[items] === Length[report["PreparedAmplitudes"]] && AllTrue[items,
    AssociationQ[#] && KeyExistsQ[#, "PreparedExpression"] &&
      residueFiniteQ[#["PreparedExpression"]] &&
      TrueQ[Lookup[#, "DenominatorsKeptOffShell", False]] &&
      !TrueQ[Lookup[#, "FeynmanConversionFailed", False]] &&
      !FailureQ[Lookup[#, "JointInvariantFailure", None]] &&
      (Lookup[#, "Status", None] === "PREPARED" ||
        Lookup[#, "Status", None] === "PARTIAL" && Lookup[#, "StopReason", None] === "TimeConstraint") &&
      (keepReferences || AssociationQ[Lookup[#, "PolePreference", None]] &&
        Lookup[#["PolePreference"], "Status", None] === "COMPLETE") &]
];

(* An unfinished default benchmark simplification is not an unfinished
   constructive fit. Retry only its complete independent diagram list, with
   ordinary off-shell conversion and the same per-leg references in every row.
   Literal preparation controls remain literal, including a caller's clock. *)
constructBenchmarkConversionRecoveryQ[report_, pairs_, requested_, seconds_] := Module[
  {items, controls},
  If[!AssociationQ[report] || Lookup[report, "Status", None] =!= "PARTIAL" ||
      constructPreparationUsableQ[report] || !constructSecondsQ[seconds] ||
      !ListQ[pairs] || pairs === {} || !AllTrue[pairs, preparationPairQ] ||
      !(AssociationQ[requested] || ListQ[requested]), Return[False]];
  controls = constructRuleOptions[requested];
  If[!AllTrue[Values[controls], # === Automatic &] ||
      Lookup[report, "OriginalAmplitudes", None] =!= pairs ||
      Lookup[Lookup[report, "Options", <||>], "InternalOnShell", True] =!= False,
    Return[False]];
  items = Lookup[report, "ItemReports", None];
  ListQ[items] && Length[items] === Length[pairs] && AllTrue[items,
    AssociationQ[#] && TrueQ[Lookup[#, "DenominatorsKeptOffShell", False]] &&
      Lookup[#, "InternalOnShellChannels", None] === {} &&
      !FailureQ[Lookup[#, "JointInvariantFailure", None]] &&
      (Lookup[#, "Status", None] === "PREPARED" ||
        Lookup[#, "Status", None] === "PARTIAL" &&
          MemberQ[{"TimeConstraint", "FeynmanConversionFailed"}, Lookup[#, "StopReason", None]]) &]
];

(* Conversion is accepted only for the complete ordered pair list. In
   particular, a finite proper subset or a retained raw tensor is not a
   usable independent benchmark. No internal mass replacement may be added. *)
constructBenchmarkConversionCompleteQ[pairs_, converted_] :=
  ListQ[pairs] && pairs =!= {} && AllTrue[pairs, preparationPairQ] &&
    ListQ[converted] && Length[converted] === Length[pairs] &&
    AllTrue[converted, preparationPairQ[#] && !feynmanRawExpressionQ[Last[#]] &] &&
    Map[First, converted] === Map[First, pairs];

(* Alternate validation assignments must override only values that changed
   from the caller's base assignment. Preserve each independent model's own
   defaults, and use name rules only for these deliberately shared changes. *)
constructValidationOverrides[model_List, overrides_, assignment_List] := Module[
  {base = residueParameterRules[model, overrides], changed, named, declared},
  If[!ListQ[base], Return[$Failed]];
  declared = DeleteDuplicates[Cases[model, _ModelParameter, Infinity]];
  changed = Select[assignment, !MemberQ[base, #] &];
  named = Map[Function[rule, With[{key = First[rule]},
    If[Head[key] === ModelParameter && MemberQ[declared, key],
      ModelParameterName[key], key] -> Last[rule]]], changed];
  If[named === {} && overrides === Automatic, Automatic,
    Join[named, Replace[overrides, Automatic -> {}]]]
];

constructAllChecksPassQ[report_, pair_, channels_List, model_List, benchmark_] := Module[
  {inputs, expected, actual, checks},
  If[!AssociationQ[report] || !ListQ[Lookup[report, "Checks", None]] ||
      !AssociationQ[Lookup[report, "HighEnergyCheck", None]] ||
      !AssociationQ[Lookup[report, "ReferenceCheck", None]] ||
      !TrueQ[Lookup[report, "AutomaticPoleDiscovery", False]], Return[False]];
  checks = report["Checks"];
  If[checks === {} || !AllTrue[checks, AssociationQ[#] && Lookup[#, "Status", None] === "PASS" &] ||
      report["HighEnergyCheck"]["Status"] =!= "PASS" ||
      report["ReferenceCheck"]["Status"] =!= "PASS", Return[False]];
  inputs = residueSimpleInputs[pair, channels, model];
  If[!AssociationQ[inputs] || FailureQ[inputs], Return[False]];
  expected = DeleteDuplicates[residueChannelKey /@ inputs["Targets"]];
  actual = residueChannelKey /@ Lookup[report, "Channels", {}];
  If[!ContainsAll[actual, expected], Return[False]];
  benchmark === None || AssociationQ[Lookup[report, "FeynmanCheck", None]] &&
    Lookup[report["FeynmanCheck"], "Status", None] === "PASS"
];

(* For four legs with two massless reference legs a,b, the crossed virtualities
   satisfy d1+d2 = -s_ab = <ab>[ab] when the external and internal mass squares
   balance. This is an external identity, with neither propagator on shell. *)
constructReciprocalPoleData[external_List, channels_List, model_List] := Module[
  {legs = externalIndices[external], null, massive, input, props, cuts, brackets},
  If[Length[legs] =!= 4 || !preparationScalarExternalRulesQ[external], Return[None]];
  null = Select[legs, (Mass[#] /. external) === 0 &];
  If[Length[null] =!= 2, Return[None]];
  massive = Complement[legs, null];
  input = residueSimpleInputs[{external, 0}, channels, model];
  If[!AssociationQ[input], Return[None]];
  props = DeleteDuplicates[residueCanonicalPropagators[
    Lookup[input["Targets"], "Propagator"], legs]];
  cuts = First[residuePropagatorKey[PropDen[Mom[Multiparticle[First[massive], #]], 0], legs]] & /@ null;
  If[Length[props] =!= 2 ||
      Sort[First[residuePropagatorKey[#, legs]] & /@ props] =!= Sort[cuts] ||
      !residueExactZero[Total[(Mass[#] /. external)^2 & /@ massive] - Total[(Last[#]^2 & /@ props)]],
    Return[None]];
  brackets = Function[kind, SpinorChain @@ (Spinor["Helicity", kind, #] & /@ null)] /@
    {"Angle", "Square"};
  <|"ExternalLegs" -> legs, "Propagators" -> props, "Brackets" -> brackets|>
];

constructSplitReciprocalSource[expression_, poleData_Association] := Module[
  {props = poleData["Propagators"], numerator},
  numerator = Cancel[residueCanonicalPropagators[expression, poleData["ExternalLegs"]] (Times @@ props)];
  If[!residueFiniteQ[numerator] || numerator === 0 || !FreeQ[numerator, _PropDen],
    Return[Nothing]];
  FactorTerms[numerator] Total[1/props]/(Times @@ poleData["Brackets"])
];

(* Bounded external-identity reduction for small shifted rational sums. *)
completionCompactShiftedNumerators[expression_, externalRules_List, model_List, seconds_] := Module[
  {original = <|"Amplitude" -> expression, "Status" -> "UNCHANGED"|>,
   started = AbsoluteTime[], remaining, rational, localFactor, termTrial,
   value, proof},
  If[!TrueQ[seconds > 0] || LeafCount[expression] > 3000 ||
      Head[expression] =!= Plus || Length[expression] > 8 ||
      !preparationScalarExternalRulesQ[externalRules] ||
      FreeQ[expression, Power[_SpinorChain, _Integer?Negative]],
    Return[original]];
  remaining[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  rational[body_, function_] := Module[{atoms, symbols},
    atoms = DeleteDuplicates[Cases[{body}, _SpinorChain | _SpinorTrace | _PropDen |
      _ModelParameter | _MomProd, Infinity]];
    symbols = Table[Unique["shiftedNumeratorAtom"], {Length[atoms]}];
    function[body /. Thread[atoms -> symbols]] /. Thread[symbols -> atoms]
  ];
  localFactor[body_Plus] := Module[{children = localFactor /@ body, factored},
    factored = TimeConstrained[rational[children, Factor], Min[0.3, remaining[]], children];
    If[LeafCount[factored] < LeafCount[children], factored, children]];
  localFactor[body_Times] := localFactor /@ body;
  localFactor[body : Power[base_, exponent_Integer?Positive]] := localFactor[base]^exponent;
  localFactor[body_] := body;
  termTrial[term_] := Module[{factors, inverse, num, divided, shell, contracted, dirac, choices},
    factors = If[Head[term] === Times, List @@ term, {term}];
    inverse = Times @@ Cases[factors, Power[_, _Integer?Negative]];
    num = Times @@ DeleteCases[factors, Power[_, _Integer?Negative]];
    If[FreeQ[num, _PropDen] || FreeQ[num, _SpinorChain], Return[term]];
    divided = rational[num, Function[body, With[{common = Together[body]},
      {Numerator[common], Denominator[common]}]]];
    shell = preparationPropagatorDefinitions[First[divided], externalRules];
    If[!rspExpansionBudgetQ[shell] || rspSandwichExpansionCount[shell] > 128, Return[term]];
    contracted = rspSandwichProducts[Expand[shell]] /. externalRules;
    dirac = rspDiracSchoutenReduction[Expand[contracted], externalRules,
      Min[1, remaining[]]]["Amplitude"];
    choices = Select[Join[{term}, inverse localFactor[#]/Last[divided] & /@
      {contracted, dirac}], residueFiniteQ];
    First[MinimalBy[choices, preparationSortKey]]
  ];
  value = TimeConstrained[MemoryConstrained[Total[termTrial /@ List @@ expression],
    134217728, expression], remaining[], expression];
  If[!preparationBetterQ[preparationRank[value], preparationRank[expression]], Return[original]];
  proof = TimeConstrained[completionHEZeroDirection[value - expression, externalRules, model,
    remaining[]], remaining[], Missing["TimeConstraint"]];
  If[AssociationQ[proof] && proof["Status"] === "PROVED_ZERO",
    <|"Amplitude" -> value, "Status" -> "IMPROVED", "Proof" -> proof,
      "InternalOnShellConditions" -> {}|>, original]
];

constructSpuriousShiftForms[normalized_Association, model_List, rules_List,
    seed_Integer, seconds_] := Module[
  {support, pair, expected, catalog, deadline = AbsoluteTime[] + seconds, forms = {}},
  support = completionNullPairSupport[normalized, model, Automatic];
  Do[
    If[AbsoluteTime[] >= deadline, Break[]];
    expected = Select[completionTargets[normalized["Targets"]],
      Count[#["Cut"], First[pair]] =!= Count[#["Cut"], Last[pair]] &];
    catalog = completionNullPairChannels[normalized, pair, rules, seed, 32,
      Max[0.000001, Min[6, deadline - AbsoluteTime[]]]];
    If[catalog["Status"] === "AVAILABLE" && Length[catalog["Basis"]] === Length[expected] &&
        AllTrue[catalog["SourceChecks"], #["Verification"]["Status"] === "PASS" &],
      AppendTo[forms, <|"Expression" -> Total[catalog["Basis"]],
        "Method" -> "CompleteShiftedChannelSum", "SourceChecks" -> catalog["SourceChecks"],
        "ShiftedLegs" -> pair|>]],
    {pair, Take[Lookup[support, "Pairs", {}], UpTo[2]]}];
  forms
];

(* Choose references consistently across a single signed exchange orbit of
   diagrams. Distinct canonical pole signatures certify that the orbit visits
   each supplied topology once. The gauge choice still needs full validation. *)
constructSpuriousOrbitForms[pairs_List, preparation_Association, plan_Association,
    external_List] := Module[{legs, signature, signatures, firstPoles, orbit, alternatives, forms},
  If[Length[pairs] < 2 || Length[pairs] =!= plan["Order"], Return[{}]];
  legs = externalIndices[external];
  signature[expression_] := Sort[DeleteDuplicates[
    Cases[residueCanonicalPropagators[expression, legs], _PropDen, Infinity]]];
  signatures = signature /@ (Last /@ pairs);
  If[!DuplicateFreeQ[signatures] || AnyTrue[signatures, # === {} &], Return[{}]];
  firstPoles = Times @@ First[signatures];
  orbit = signature[Fold[completionBoseCycle, firstPoles, #]] & /@ plan["Permutations"];
  If[Sort[orbit] =!= Sort[signatures], Return[{}]];
  alternatives = Lookup[Lookup[First[preparation["ItemReports"]], "PolePreference", <||>],
    "Alternatives", {}];
  forms = Function[alternative,
    <|"Expression" -> FactorTerms[canonicalChains[residueCanonicalPropagators[
      Length[pairs] completionBoseProject[alternative["ReducedExpression"], plan], legs]]],
      "Method" -> "DiagramReferenceOrbit", "ReferenceAssignments" -> alternative["Assignments"],
      "ExchangeProjected" -> True|>] /@ alternatives;
  SortBy[DeleteDuplicatesBy[forms, #["Expression"] &], preparationSortKey[#["Expression"]] &]
];

constructSpuriousBracketFormQ[expression_] :=
  FreeQ[expression, (Spinor | SpinorHat)["Xi", ___]] &&
  !FreeQ[expression, Power[chain_SpinorChain, _Integer?Negative] /;
    !FreeQ[chain, Spinor["Helicity", _, _Integer]]];

(* Schouten reduces two adjacent emission orders against the same reference
   leg. The remaining 2x2 determinant is the external endpoint mass squared.
   The central virtuality in the numerator is an ordinary off-shell identity. *)
spuriousCentralCutGroupReduction[expression_, externalRules_List, central_PropDen] := Module[
  {legs = externalIndices[externalRules], cut, sides, expanded, terms, profile,
   unchanged = <|"Amplitude" -> expression, "Status" -> "UNCHANGED"|>,
   rational, factors, groupKey, reduceGroup, reduceSide, candidates, best},
  cut = residueMomentumLegsFromExpression[First[central]];
  If[!ListQ[cut] || !SubsetQ[legs, cut] || LeafCount[expression] > 6000 ||
      !preparationScalarExternalRulesQ[externalRules], Return[unchanged]];
  sides = Select[{cut, Complement[legs, cut]}, Length[#] === 3 &&
    Count[(Mass /@ #) /. externalRules, 0] === 2 &];
  If[sides === {}, Return[unchanged]];
  profile = rspExpansionProfile[expression, 48, 12000];
  If[profile[[1]] > 48 || profile[[2]] > 12000, Return[unchanged]];
  expanded = canonicalChains[residueCanonicalPropagators[Expand[expression], legs]];
  terms = If[Head[expanded] === Plus, List @@ expanded, {expanded}];
  If[Length[terms] > 48, Return[unchanged]];
  factors[term_] := If[Head[term] === Times, List @@ term, {term}];
  rational[body_, operation_] := Module[{atoms, symbols},
    atoms = DeleteDuplicates[Cases[{body}, _SpinorChain | _PropDen | _ModelParameter |
      _MomProd, Infinity]];
    symbols = Table[Unique["spuriousCutAtom"], {Length[atoms]}];
    operation[body /. Thread[atoms -> symbols]] /. Thread[symbols -> atoms]];
  groupKey[term_, excluded_List] := Sort[Complement[
    Cases[factors[term], HoldPattern[Power[p_PropDen, -1]] :> p], excluded]];
  reduceGroup[inputGroup_List, endpoint_Integer, {a_Integer, b_Integer}, mass_, {u_PropDen, v_PropDen}] :=
    Module[{sum = Total[inputGroup], c, chirality, opposite, h, insert, same, ba, ca, cb,
      xa, xb, left, right, common, sensitive, target = Total[inputGroup], rewrite},
      If[Length[inputGroup] < 2 || !And[!FreeQ[sum, 1/u], !FreeQ[sum, 1/v]], Return[sum]];
      Do[
        opposite = If[chirality === "Angle", "Square", "Angle"];
        h[kind_, i_, j_] := SpinorChain[Spinor["Helicity", kind, i], Spinor["Helicity", kind, j]];
        insert[i_, j_] := SpinorChain[Spinor["Helicity", chirality, i], Mom[endpoint],
          Spinor["Helicity", opposite, j]];
        same = h[chirality, a, b]; ba = h[opposite, a, b];
        ca = h[opposite, a, c]; cb = h[opposite, b, c];
        xa = insert[a, c]; xb = insert[b, c];
        left = canonicalChains[((same + xa/cb) xb/(v ca) - (same - xb/ca) xa/(u cb))/central];
        right = canonicalChains[(-mass^2 same^2/central + xa xb/(ca cb))/(u v)];
        If[!AllTrue[Cases[canonicalChains[{xa, xb}], _SpinorChain, Infinity], !FreeQ[sum, #] &], Continue[]];
        (* Atomization tests a formal rational quotient. The spectator must
           be independent of the local brackets and virtualities. *)
        common = rational[sum/left, Together];
        sensitive = DeleteDuplicates[Join[{u, v, central}, Cases[canonicalChains[{same, ba, ca, cb, xa, xb}],
          _SpinorChain, Infinity]]];
        If[residueFiniteQ[common] && FreeQ[common, Alternatives @@ sensitive],
          rewrite = FactorTerms[common right];
          If[preparationBetterQ[preparationRank[rewrite], preparationRank[target]], target = rewrite]],
        {c, Select[Complement[legs, {a, b, endpoint}], (Mass[#] /. externalRules) === 0 &]},
        {chirality, {"Square", "Angle"}}];
      target
    ];
  reduceSide[side_List] := Module[{a, b, endpoint, mass, u, v, groups, reduced},
    {a, b} = Select[side, (Mass[#] /. externalRules) === 0 &];
    endpoint = First[Complement[side, {a, b}]];
    mass = Mass[endpoint] /. externalRules;
    If[!residueExactZero[mass^2 - Last[central]^2], Return[expression]];
    {u, v} = residueCanonicalPropagators[
      (PropDen[Mom[Multiparticle @@ Sort[{endpoint, #}]], mass] & /@ {a, b}), legs];
    groups = GatherBy[terms, groupKey[#, {u, v, central}] &];
    reduced = reduceGroup[#, endpoint, {a, b}, mass, {u, v}] & /@ groups;
    If[reduced === Total /@ groups, expression, FactorTerms[Total[reduced]]]];
  candidates = Select[reduceSide /@ sides,
    preparationBetterQ[preparationRank[#], preparationRank[expression]] &];
  If[candidates === {}, Return[unchanged]];
  best = First[MinimalBy[candidates, preparationSortKey]];
  <|"Amplitude" -> best, "Status" -> "IMPROVED",
    "Scope" -> "ExternalSchoutenAndMomentumDeterminant"|>
];

(* Reuse one reduced continuation only when the input compound poles form
   a complete signed exchange orbit. The global result still needs independent
   amplitude checks, since equal pole support does not imply equal regular terms. *)
constructSpuriousGroupOrbit[expression_, external_List, plan_Association,
    physicalPropagators_List] := Module[
  {legs = externalIndices[external], null, source, factors, sum, terms, cuts, byCut, physical,
   regular, centers, orbit, candidates, local, candidate},
  If[Length[legs] < 6 || plan["Order"] <= 1 || LeafCount[expression] > 12000 ||
      !constructSpuriousBracketFormQ[expression] || !preparationScalarExternalRulesQ[external],
    Return[Missing["UnsupportedSpuriousGroups"]]];
  null = Select[legs, (Mass[#] /. external) === 0 &];
  If[Length[null] < 3, Return[Missing["UnsupportedSpuriousGroups"]]];
  source = residueCanonicalPropagators[expression, legs];
  physical = DeleteDuplicates[residueCanonicalPropagators[physicalPropagators, legs]];
  terms = Which[Head[source] === Plus, List @@ source,
    Head[source] === Times,
    factors = List @@ source; sum = Cases[factors, _Plus];
    If[Length[sum] =!= 1 || !FreeQ[DeleteCases[factors, _Plus], _PropDen],
      Return[Missing["UnsupportedSpuriousGroups"]]];
    (Times @@ DeleteCases[factors, _Plus]) (List @@ First[sum]),
    True, Return[Missing["UnsupportedSpuriousGroups"]]];
  If[Length[terms] > 64, Return[Missing["UnsupportedSpuriousGroups"]]];
  cuts[term_] := Select[DeleteDuplicates[Cases[term,
    Power[p_PropDen, -1] :> p, {0, Infinity}]], Function[prop,
    With[{cut = residueMomentumLegsFromExpression[First[prop]]},
      MemberQ[physical, prop] && ListQ[cut] && AnyTrue[{cut, Complement[legs, cut]},
        Length[#] === 3 && Length[Intersection[#, null]] === 2 &]]]];
  byCut = GroupBy[terms, cuts];
  If[AnyTrue[Keys[byCut], Length[#] > 1 &], Return[Missing["UnsupportedSpuriousGroups"]]];
  regular = If[KeyExistsQ[byCut, {}], Total[byCut[{}]], 0];
  centers = Flatten[DeleteCases[Keys[byCut], {}], 1];
  If[Length[centers] < 2 || Length[centers] > 12, Return[Missing["UnsupportedSpuriousGroups"]]];
  orbit = DeleteDuplicates[residueCanonicalPropagators[
    Fold[completionBoseCycle, First[centers], #] & /@ plan["Permutations"], legs]];
  If[Sort[orbit] =!= Sort[centers], Return[Missing["UnsupportedSpuriousGroups"]]];
  candidates = Reap[Do[
    local = spuriousCentralCutGroupReduction[Total[byCut[{central}]], external, central];
    If[AssociationQ[local] && local["Status"] === "IMPROVED",
      candidate = FactorTerms[regular + canonicalChains[residueCanonicalPropagators[
        Length[centers] completionBoseProject[local["Amplitude"], plan], legs]]];
      If[constructSpuriousBracketFormQ[candidate] &&
          preparationBetterQ[preparationRank[candidate], preparationRank[expression]],
        Sow[<|"Amplitude" -> candidate, "Method" -> "ReducedCompoundPoleOrbit",
          "SourcePropagator" -> central, "OrbitSize" -> Length[centers],
          "LocalReduction" -> local|>]]],
    {central, Sort[centers]}]][[2]];
  If[candidates === {}, Missing["NoImprovingSpuriousGroup"],
    First[MinimalBy[First[candidates], preparationSortKey[#["Amplitude"]] &]]]
];

(* Lift a certified minimal vector line using ordinary off-shell Dirac
   propagator numerators. Lower tensors with independent Xi before using
   shared massless references, so Lorentz slots are contracted first. *)
constructOffShellVectorLineForm[orders_List, endpoints_List, helicities_Association,
    mass_, vertexFactors_List] := Module[
  {particle = First[endpoints], anti = Last[endpoints], n = Length[First[orders]],
   vectors, indices, references, polarizations, coefficient, contribution, raw, converted, expression},
  vectors = Sort[First[orders]];
  indices = AssociationThread[vectors, Table[Unique["lineLorentz"], {n}]];
  references = Function[leg, leg -> SelectFirst[vectors, helicities[#] === -helicities[leg] &]] /@ vectors;
  polarizations = Times @@ (ConstructiveDiagrams`PolarizationVector[#, indices[#], 0, helicities[#]] & /@ vectors);
  coefficient = (-1)^(n - 1) (Times @@ vertexFactors)/Sqrt[2]^n;
  contribution[order_List] := Module[{prefixes, internal, word},
    prefixes = Table[Sort[Prepend[Take[order, i], particle]], {i, n - 1}];
    internal = Mom[Multiparticle @@ #] & /@ prefixes;
    word = ConstructiveDiagrams`DiracWord[ConstructiveDiagrams`DiracGamma[indices[Last[order]]]];
    Do[word = feynmanMultiply[word, feynmanSlashWord[internal[[i]]] + mass ConstructiveDiagrams`DiracWord[]];
      word = feynmanMultiply[word, ConstructiveDiagrams`DiracWord[ConstructiveDiagrams`DiracGamma[indices[order[[i]]]]]], {i, n - 1, 1, -1}];
    polarizations feynmanChainPolynomial[word, ConstructiveDiagrams`FermionBar[anti, mass, "Dirac"],
      ConstructiveDiagrams`FermionKet[particle, mass, "Dirac"]]/(Times @@ (PropDen[#, mass] & /@ internal))];
  raw = contribution /@ orders;
  converted = ConstructiveDiagrams`FeynmanToSpinorProducts[raw, "ReferenceSpinors" -> Automatic,
    "ReduceSpinorProducts" -> False, "TimeConstraint" -> 35];
  If[FailureQ[converted] || !ListQ[converted], Return[converted]];
  expression = coefficient Total[converted] /. Spinor["Xi", kind_, leg_Integer] :>
    Spinor["Helicity", kind, leg /. references];
  expression = residueCanonicalPropagators[
    expression /. chain_SpinorChain :> linearChain[chain], Sort[Join[vectors, endpoints]]];
  If[!residueFiniteQ[expression] || !constructSpuriousBracketFormQ[expression],
    Return[Missing["UnsupportedVectorCurrent"]]];
  <|"Expression" -> expression, "Method" -> "OffShellVectorLine",
    "ReferenceAssignments" -> references|>
];

(* Lift a pair of massive Dirac currents when every participating vertex is
   certified to be the standard colorless vector coupling. The model and
   the original cut inventory determine the candidate. The separate
   Feynman benchmark is used only by the normal validation stage. *)
constructOffShellVectorCurrents[diagrams_List, process_List, model_List, external_List] := Module[
  {legs = externalIndices[external], vectors, matter, fermion, vector, photonNames,
   base, vertices, coupling, particles, lifted, liftedDiagrams, signatures,
   pairs, converted, references, expression},
  If[Length[legs] =!= 6 || diagrams === {} || Length[diagrams] > 64 ||
      !preparationScalarExternalRulesQ[external] || Length[model] < 4,
    Return[Missing["UnsupportedVectorCurrents"]]];
  vectors = Select[legs, (Mass[#] /. external) === 0 &];
  matter = Complement[legs, vectors];
  If[Length[vectors] =!= 2 || Length[DeleteDuplicates[process[[vectors]]]] =!= 1,
    Return[Missing["UnsupportedVectorCurrents"]]];
  fermion = SelectFirst[model[[1]], Length[#] === 11 && #[[5]] === 1 && #[[8]] === 1 &&
    #[[6]] =!= 0 && #[[2]] =!= #[[3]] && Sort[process[[matter]]] ===
      Sort[Join[#[[{2, 3}]], #[[{2, 3}]]]] &, None];
  vector = SelectFirst[model[[1]], Length[#] === 11 && #[[5]] === 2 &&
    #[[6]] === 0 && #[[8]] === 1 && MemberQ[#[[{2, 3}]], process[[First[vectors]]]] &, None];
  If[fermion === None || vector === None || !AllTrue[matter,
      (Mass[#] /. external) === fermion[[6]] &], Return[Missing["UnsupportedVectorCurrents"]]];
  photonNames = vector[[{2, 3}]];
  If[!StringEndsQ[First[photonNames], ".+"] ||
      Last[photonNames] =!= StringDrop[First[photonNames], -1] <> "-",
    Return[Missing["UnsupportedVectorCurrents"]]];
  base = StringDrop[First[photonNames], -2];
  If[!feynmanIdentifierQ[base] || MemberQ[fermion[[{2, 3}]], base],
    Return[Missing["UnsupportedVectorCurrents"]]];
  vertices = DeleteDuplicates[Lookup[Flatten[Values /@ Lookup[diagrams, "VertexStructures"], 2],
    "ModelRow", Missing["VertexModelRow"]]];
  coupling = constructVectorCoupling[vertices, fermion[[{2, 3}]], photonNames];
  If[MissingQ[coupling], Return[Missing["UnsupportedVectorCurrents"]]];
  coupling /= Sqrt[2];
  particles = {fermion, ReplacePart[vector, {2 -> base, 3 -> base, 9 -> "G"}]};
  lifted = ConstructiveDiagrams`FeynmanModel[particles,
    {{fermion[[3]], fermion[[2]], base, "", coupling,
      ConstructiveDiagrams`DiracWord[ConstructiveDiagrams`DiracGamma[ConstructiveDiagrams`LorentzIndex[3]]]}},
    model[[3]], model[[4]]];
  liftedDiagrams = CreateDiagrams[process, lifted];
  If[!ListQ[liftedDiagrams] || Length[liftedDiagrams] =!= Length[diagrams],
    Return[Missing["UnsupportedVectorCurrents"]]];
  signatures[data_] := Sort[Map[Function[diagram, Sort[Map[Function[prop,
    {Sort[{prop["Particle"], prop["Antiparticle"]} /. Thread[photonNames -> base]],
      residueCanonicalPropagators[PropDen[Mom[prop["Index"]], prop["Mass"]], legs]}],
      Values[diagram["Propagators"]]]]], data]];
  If[signatures[liftedDiagrams] =!= signatures[diagrams],
    Return[Missing["UnsupportedVectorCurrents"]]];
  pairs = DiagramAmplitudes[liftedDiagrams];
  If[!ListQ[pairs], Return[Missing["UnsupportedVectorCurrents"]]];
  converted = ConstructiveDiagrams`FeynmanToSpinorProducts[pairs, "ReferenceSpinors" -> Automatic,
    "ReduceSpinorProducts" -> False, "TimeConstraint" -> 25];
  If[!ListQ[converted], Return[Missing["UnsupportedVectorCurrents"]]];
  references = Thread[vectors -> Reverse[vectors]];
  expression = canonicalChains[residueCanonicalPropagators[
    Total[Last /@ converted] /. Spinor["Xi", kind_, leg_Integer] :>
      Spinor["Helicity", kind, leg /. references], legs]];
  expression = preparationGroupedPropagatorForm[FactorTerms[expression]];
  If[!residueFiniteQ[expression] || !constructSpuriousBracketFormQ[expression],
    Return[Missing["UnsupportedVectorCurrents"]]];
  <|"Expression" -> expression, "Method" -> "OffShellVectorCurrents",
    "ReferenceAssignments" -> references|>
];

(* The same vector vertex may be used in either helicity. Recover its
   constructive factor before converting to Dirac or two-spinor currents. *)
constructVectorCoupling[rows_List, species_List, helicities_List] := Module[{ordered},
  If[!AllTrue[rows, MatchQ[#, {_, _, _, "", _, _}] &] ||
      Sort[Take[#, 4] & /@ rows] =!= Sort[(Join[species, {#, ""}] &) /@ helicities],
    Return[Missing["UnsupportedVectorVertex"]]];
  ordered = (SelectFirst[rows, Function[row, row[[3]] === #]] &) /@ helicities;
  If[!AllTrue[ordered, standardFermionVectorVertexQ[<|"ModelRow" -> #|>] &] ||
      FreeQ[ordered[[1, -1]], _xFactor] || FreeQ[ordered[[2, -1]], _xTildeFactor] ||
      !residueExactZero[ordered[[1, -2]] - ordered[[2, -2]]] ||
      !FreeQ[ordered[[1, -2]], _Spinor | _SpinorChain | _Mom | _MomProd | _PropDen],
    Return[Missing["UnsupportedVectorVertex"]]];
  ordered[[1, -2]]
];

(* Pair the two emission orders on a line by external Dirac and Schouten
   identities before contracting the currents. Equal helicities share one
   reciprocal denominator on double-emission lines. The mixed form keeps
   the off-shell double-emission remainder and reciprocal spin-shift terms. *)
twoLinePhotonCurrentProduct[{leftLine_List, rightLine_List}, photons_List, polarizations_List,
    left_List, right_List, leftMass_, rightMass_] := Module[
  {same = SameQ @@ polarizations, angleType, squareType, spin, angle, square, sandwich,
   pole, contraction, firstPhoton = First[photons], positive, negative},
  angleType = If[same && First[polarizations] === 2, "Square", "Angle"];
  squareType = If[angleType === "Angle", "Square", "Angle"];
  spin[kind_, leg_] := Spinor[If[MemberQ[photons, leg], "Helicity", "Spin"], kind, leg];
  angle[i_, j_] := If[i === j, 0, SpinorChain[spin[angleType, i], spin[angleType, j]]];
  square[i_, j_] := If[i === j, 0, SpinorChain[spin[squareType, i], spin[squareType, j]]];
  sandwich[start_, i_, momenta_List, end_, j_] :=
    SpinorChain[spin[start, i], Sequence @@ (Mom /@ momenta), spin[end, j]];
  pole[mass_, leg_, emitted__Integer] := PropDen[Mom[Multiparticle @@ Sort[{leg, emitted}]], mass];
  (* A current entry is {coefficient, angle label, square label}. *)
  contraction[leftTerms_List, rightTerms_List] := Total[Flatten[Table[
    l[[1]] r[[1]] angle[l[[2]], r[[2]]] square[l[[3]], r[[3]]],
    {l, leftTerms}, {r, rightTerms}], 1]];
  If[same, Return[-Module[{soft, spinShift, triple, scalar, shifts, current},
    (* Use Schouten to cancel reference brackets in the scalar currents.
       When both photons are emitted from one line, one spin shift keeps
       the reciprocal denominator. *)
    soft[mass_, a_, b_, i_, split_] := If[i === firstPhoton || split,
      -sandwich[squareType, i, {b, a}, squareType, i]/(pole[mass, a, i] pole[mass, b, i]),
      (sandwich[squareType, i, {a}, angleType, firstPhoton]/pole[mass, a, i] -
        sandwich[squareType, i, {b}, angleType, firstPhoton]/pole[mass, b, i])/angle[i, firstPhoton]];
    spinShift[mass_, p_, i_] := square[i, p]/pole[mass, p, i];
    triple[mass_, p_, i_, j_] := pole[mass, p, i, j] pole[mass, p, i] pole[mass, p, j];
    scalar[mass_, a_, b_, {}] := 1;
    scalar[mass_, a_, b_, {i_}] := soft[mass, a, b, i, True];
    scalar[mass_, a_, b_, {i_, j_}] := soft[mass, a, b, i, True] soft[mass, a, b, j, True] -
      mass^2 square[i, j]^2 (1/triple[mass, a, i, j] + 1/triple[mass, b, i, j]);
    shifts[mass_, p_, q_, {}] := {};
    shifts[mass_, p_, q_, {i_}] := {{spinShift[mass, p, i], i}};
    shifts[mass_, p_, q_, {i_, j_}] := {
      {spinShift[mass, p, i] soft[mass, p, q, j, False] +
        mass square[i, j]^2 angle[i, p]/triple[mass, p, i, j], i},
      {spinShift[mass, p, j] soft[mass, p, q, i, False] +
        mass square[j, i]^2 angle[j, p]/triple[mass, p, j, i], j}};
    current[mass_, {a_, b_}, emitted_List] := With[{c = scalar[mass, a, b, emitted]},
      Join[{{c, a, b}, {c, b, a}}, ({#[[1]], b, #[[2]]} & /@ shifts[mass, a, b, emitted]),
        ({If[Length[emitted] === 1, -#[[1]], #[[1]]], a, #[[2]]} & /@ shifts[mass, b, a, emitted])]];
    contraction[current[leftMass, leftLine, left], current[rightMass, rightLine, right]]
  ]]];
  positive = photons[[FirstPosition[polarizations, 1][[1]]]];
  negative = photons[[FirstPosition[polarizations, 2][[1]]]];
  Module[{soft, softProduct, shift, current, remainder, leading},
    soft[{i_, j_}, mass_, photon_, cancel_] := If[cancel,
      If[photon === positive, -sandwich["Square", positive, {j, i}, "Square", positive],
        sandwich["Angle", negative, {j, i}, "Angle", negative]]/
        (pole[mass, i, photon] pole[mass, j, photon]),
      (sandwich["Square", positive, {i}, "Angle", negative]/pole[mass, i, photon] -
        sandwich["Square", positive, {j}, "Angle", negative]/pole[mass, j, photon])/
        If[photon === positive, angle[positive, negative], square[positive, negative]]];
    softProduct[line_, mass_, unshifted_, cancel_] :=
      Times @@ (soft[line, mass, #, cancel] & /@ unshifted);
    shift[endpoint_, mass_, photon_, sign_] := sign If[photon === positive,
      square[positive, endpoint], -angle[negative, endpoint]]/pole[mass, endpoint, photon];
    current[{u_, v_}, mass_, shifted_List] := Function[{i, j},
      {Times @@ (With[{endpoint = If[# === positive, j, i]},
          shift[endpoint, mass, #, If[endpoint === u, 1, -1]]] & /@ shifted),
       If[MemberQ[shifted, negative], negative, i], If[MemberQ[shifted, positive], positive, j]}] @@@
      {{u, v}, {v, u}};

    (* Only the line carrying both emissions has this off-shell remainder. *)
    remainder[{u_, v_}, mass_, otherLine_, otherMass_] := Total[Table[With[
      {chi = sandwich["Square", positive, {i}, "Angle", negative], j = If[i === u, v, u]},
      chi contraction[{{chi, i, j}, {chi, j, i},
          {-square[positive, negative] angle[negative, i], negative, j},
          {angle[positive, negative] square[positive, i], j, positive}},
        current[otherLine, otherMass, {}]]/
        (pole[mass, i, positive] pole[mass, i, negative] pole[mass, i, positive, negative])],
      {i, {u, v}}]];
    leading = Total[Flatten[Table[With[
      {cancel = Length[left] === 1 || leftShift === {} && rightShift === {}},
      softProduct[leftLine, leftMass, Complement[left, leftShift], cancel]
        softProduct[rightLine, rightMass, Complement[right, rightShift], cancel]
        contraction[current[leftLine, leftMass, leftShift], current[rightLine, rightMass, rightShift]]],
      {leftShift, Subsets[left]}, {rightShift, Subsets[right]}], 1]];
    leading + Which[Length[left] === 2, remainder[leftLine, leftMass, rightLine, rightMass],
      Length[right] === 2, remainder[rightLine, rightMass, leftLine, leftMass], True, 0]
  ]
];

(* Trace both oriented fermion lines from the actual diagrams, including
   the exchanged vector attachment. Require every allowed emission order
   before replacing the sum by the contracted pair of currents. *)
constructGroupedVectorCurrents[diagrams_List, process_List, model_List, external_List] := Module[
  {legs = externalIndices[external], unsupported = Missing["UnsupportedTwoLineCurrents"],
   vectors, matter, vector, helicities, base, fermionRows, species, speciesOf, modelRows,
   vertexRows, pole, topology, records, expectedMatchings, expected, groups, buildGroup,
   polarizations, expression},
  If[legs =!= Range[6] || Length[process] =!= 6 || Length[model] < 4 ||
      !MemberQ[{20, 40}, Length[diagrams]] || !preparationScalarExternalRulesQ[external],
    Return[unsupported]];
  vectors = Select[legs, (Mass[#] /. external) === 0 &];
  If[Length[vectors] =!= 2, Return[unsupported]];
  matter = Complement[legs, vectors];
  vector = SelectFirst[model[[1]], Length[#] === 11 && #[[5]] === 2 &&
    #[[6]] === 0 && #[[8]] === 1 && ContainsAll[#[[{2, 3}]], process[[vectors]]] &, None];
  If[vector === None, Return[unsupported]];
  helicities = vector[[{2, 3}]];
  If[!StringEndsQ[First[helicities], ".+"] || Last[helicities] =!= StringDrop[First[helicities], -1] <> "-",
    Return[unsupported]];
  base = StringDrop[First[helicities], -2];
  fermionRows = DeleteDuplicates[Function[leg, SelectFirst[model[[1]],
    Length[#] === 11 && #[[5]] === 1 && #[[8]] === 1 && #[[2]] =!= #[[3]] &&
      #[[6]] === (Mass[leg] /. external) && MemberQ[#[[{2, 3}]], process[[leg]]] &, None]] /@ matter];
  If[MemberQ[fermionRows, None], Return[unsupported]];
  species = #[[{2, 3}]] & /@ fermionRows;
  If[!DuplicateFreeQ[Flatten[species]] || MemberQ[Flatten[species], base], Return[unsupported]];
  speciesOf[line_List] := SelectFirst[species, process[[line]] === # &, None];
  modelRows = DeleteDuplicates[Lookup[Flatten[Values /@ Lookup[diagrams, "VertexStructures"], 2],
    "ModelRow", None]];
  vertexRows = Function[pair, Select[modelRows, ListQ[#] && Length[#] >= 2 && Take[#, 2] === pair &]] /@ species;
  If[Sort[Flatten[vertexRows, 1]] =!= Sort[modelRows] ||
      !AllTrue[MapThread[constructVectorCoupling[#1, #2, helicities] &, {vertexRows, species}],
        Function[value, !MissingQ[value] && rspScalarQ[value] && residueFiniteQ[value]]] ||
      !FreeQ[modelRows[[All, -1]], Spinor["Helicity", ___]], Return[unsupported]];
  pole[cut_List, mass_] := residueCanonicalPropagators[PropDen[Mom[Multiparticle @@ Sort[cut]], mass], legs];
  topology[diagram_Association] := Module[
    {graph = diagram["Graph"], vertices = diagram["VertexStructures"], props = diagram["Propagators"],
     exchanges, exchange, attachments, vertexAttachment, paths, lines, emissions, groups,
     fermionPoles, vectorPole, cuts, sign, factors, masses},
    If[diagram["ExternalParticles"] =!= process || !AssociationQ[vertices] || Length[vertices] =!= 4 ||
        !AssociationQ[props] || Length[props] =!= 3, Return[unsupported]];
    exchanges = Select[Keys[props], props[#]["Spin2"] === 2 && props[#]["Mass"] === 0 &&
      props[#]["Particle"] === base && props[#]["Antiparticle"] === base &];
    If[Length[exchanges] =!= 1 || diagram["HelicitySumEdges"] =!= exchanges, Return[unsupported]];
    exchange = First[exchanges];
    If[Sort[Lookup[diagram["HelicityAssignments"], exchange]] =!= Sort[helicities],
      Return[unsupported]];
    lines = Sort[ConstructiveDiagrams`diagramFermionLines[diagram]];
    If[!MatchQ[lines, {{_Integer, _Integer}, {_Integer, _Integer}}] ||
        Sort[Flatten[lines]] =!= matter || MemberQ[speciesOf /@ lines, None], Return[unsupported]];
    paths = (FindShortestPath[graph, First[#], Last[#]] &) /@ lines;
    If[!AllTrue[paths, 3 <= Length[#] <= 5 &], Return[unsupported]];
    paths = (Rest[Most[#]] &) /@ paths;
    If[Sort[Flatten[paths]] =!= Sort[Keys[vertices]], Return[unsupported]];
    If[!And @@ MapThread[Function[{path, pair, mass},
        AllTrue[(UndirectedEdge @@ Sort[#] &) /@ Partition[path, 2, 1],
          Function[edge, KeyExistsQ[props, edge] && props[edge]["Spin2"] === 1 &&
            props[edge]["Mass"] === mass &&
            Sort[Lookup[props[edge], {"Particle", "Antiparticle"}]] === Sort[pair]]]],
        {paths, speciesOf /@ lines, (Mass[First[#]] /. external &) /@ lines}],
      Return[unsupported]];
    vertexAttachment[vertex_, pair_] := Module[{structures, emitted, rows},
      structures = vertices[vertex];
      If[!ListQ[structures] || structures === {} ||
          !AllTrue[structures, Length[#["IncidentLegs"]] === 3 &], Return[unsupported]];
      rows = Lookup[structures, "ModelRow"];
      If[!AllTrue[rows, Take[#, 2] === pair &], Return[unsupported]];
      emitted = Last[#["IncidentLegs"]] & /@ structures;
      Which[
        MemberQ[List @@ exchange, vertex] && Length[emitted] === 2 &&
          AllTrue[emitted, #["Kind"] === "Internal" && #["Source"] === exchange &] &&
          Sort[rows[[All, 3]]] === Sort[helicities], 0,
        Length[emitted] === 1 && First[emitted]["Kind"] === "External" &&
          MemberQ[vectors, First[emitted]["Source"]] &&
          rows[[1, 3]] === process[[First[emitted]["Source"]]], First[emitted]["Source"],
        True, unsupported]
    ];
    attachments = MapThread[(Function[vertex, vertexAttachment[vertex, #2]] /@ #1) &,
      {paths, speciesOf /@ lines}];
    If[!AllTrue[attachments, Count[#, 0] === 1 &] ||
        Sort[DeleteCases[Flatten[attachments], 0]] =!= vectors, Return[unsupported]];
    emissions = DeleteCases[#, 0] & /@ attachments;
    groups = Sort /@ emissions;
    masses = (Mass[First[#]] /. external &) /@ lines;
    vectorPole = pole[Join[First[lines], First[emissions]], 0];
    fermionPoles = Flatten[MapThread[Function[{line, order, mass},
      Table[If[MemberQ[Take[order, n], 0],
        pole[Append[Drop[order, n], Last[line]], mass],
        pole[Prepend[Take[order, n], First[line]], mass]], {n, Length[order] - 1}]],
      {lines, attachments, masses}]];
    cuts = (residueCanonicalPropagators[PropDen[Mom[#["Index"]], #["Mass"]], legs] &) /@ Values[props];
    If[Sort[cuts] =!= Sort[Prepend[fermionPoles, vectorPole]] ||
        !AllTrue[Values[props], #["Factor"] === I/PropDen[Mom[#["Index"]], #["Mass"]] &],
      Return[unsupported]];
    factors = First[vertices[#]]["ModelRow"][[-2]] & /@ Keys[vertices];
    sign = ConstructiveDiagrams`diagramFermionSign[diagram];
    If[!MemberQ[{-1, 1}, sign], Return[unsupported]];
    <|"Lines" -> lines, "Attachments" -> attachments, "Emissions" -> groups,
      "Masses" -> masses, "VectorPole" -> vectorPole, "Coefficient" -> sign Times @@ factors|>
  ];
  records = topology /@ diagrams;
  If[!AllTrue[records, AssociationQ], Return[unsupported]];
  expectedMatchings = Map[Sort[Join @@ #] &, Tuples[Function[pair,
    With[{first = Flatten[Position[process, First[pair], {1}]],
        last = Flatten[Position[process, Last[pair], {1}]]},
      If[Length[first] =!= Length[last], {}, (Transpose[{first, #}] &) /@ Permutations[last]]]] /@ species]];
  expected = Flatten[Function[lines, Flatten[Function[left,
    ({lines, #} &) /@ Tuples[Permutations /@ (Append[#, 0] & /@ {left, Complement[vectors, left]})]]
      /@ Subsets[vectors], 1]] /@ expectedMatchings, 1];
  If[Sort[Lookup[#, {"Lines", "Attachments"}] & /@ records] =!= Sort[expected], Return[unsupported]];
  groups = GatherBy[records, Lookup[#, {"Lines", "Emissions"}] &];
  If[!AllTrue[groups, SameQ @@ (Lookup[#, {"Masses", "VectorPole", "Coefficient"}] & /@ #) &],
    Return[unsupported]];
  polarizations = (First[FirstPosition[helicities, #]] &) /@ process[[vectors]];
  buildGroup[record_] := Module[{linePair, left, right, leftMass, rightMass, numerator},
    linePair = record["Lines"];
    {left, right} = record["Emissions"];
    {leftMass, rightMass} = record["Masses"];
    numerator = twoLinePhotonCurrentProduct[linePair, vectors, polarizations,
      left, right, leftMass, rightMass];
    record["Coefficient"] numerator/record["VectorPole"]
  ];
  expression = Total[(buildGroup[First[#]] &) /@ groups];
  If[!residueFiniteQ[expression] || !constructSpuriousBracketFormQ[expression],
    Return[unsupported]];
  <|"Expression" -> expression, "Method" -> "GroupedVectorCurrents",
    "ReferenceAssignments" -> Thread[vectors -> Reverse[vectors]]|>
];

(* Contract two standard vector currents with a central off-shell Dirac
   numerator. The external Dirac equation and the Clifford anticommutator
   reduce the routed momentum p_a+p_b+p_x before the spin sum is expanded. *)
sixFermionOrderedCurrent[mass_, {a_, b_}, {x_, y_}, {c_, d_}] := Module[
  {spin, angle, square, sandwich, current, attachedSquare, attachedAngle},
  spin[kind_, leg_] := Spinor["Spin", kind, leg];
  angle[i_, j_] := SpinorChain[spin["Angle", i], spin["Angle", j]];
  square[i_, j_] := SpinorChain[spin["Square", i], spin["Square", j]];
  sandwich[i_, k_, j_] := SpinorChain[spin["Square", i], Mom[k], spin["Angle", j]];
  current[i_, j_] := angle[j, d] square[i, c] + angle[j, c] square[i, d];
  attachedSquare[j_] := square[b, x] (mass square[a, j] + sandwich[j, b, a]) +
    square[a, x] (mass square[b, j] + sandwich[j, a, b]);
  attachedAngle[j_] := angle[b, x] (mass angle[a, j] + sandwich[a, b, j]) +
    angle[a, x] (mass angle[b, j] + sandwich[b, a, j]);
  angle[y, d] attachedSquare[c] + angle[y, c] attachedSquare[d] +
    square[y, d] attachedAngle[c] + square[y, c] attachedAngle[d] -
    (current[x, y] + current[y, x]) (sandwich[a, x, b] + sandwich[b, x, a])
];

(* Read the actual graph, the four coupling factors and the exchange sign.
   Require the complete two-vector attachment inventory, including both
   orders, before using the contracted current representation. *)
constructOffShellFermionExchangeForm[diagrams_List, process_List, model_List, external_List] := Module[
  {legs = externalIndices[external], unsupported = Missing["UnsupportedSixFermionCurrents"],
   matter, mass, species, vertexFactor, topology, pole, records, expected, groups, expression},
  If[legs =!= Range[6] || Length[process] =!= 6 || Length[diagrams] =!= 36 ||
      !preparationScalarExternalRulesQ[external], Return[unsupported]];
  matter = SelectFirst[model[[1]], Length[#] === 11 && #[[5]] === 1 &&
    #[[6]] =!= 0 && #[[8]] === 1 && #[[2]] =!= #[[3]] &&
    Sort[process] === Sort[Flatten[ConstantArray[#[[{2, 3}]], 3]]] &, None];
  If[matter === None, Return[unsupported]];
  mass = matter[[6]]; species = matter[[{2, 3}]];
  If[(Mass /@ legs /. external) =!= ConstantArray[mass, 6], Return[unsupported]];
  pole[cut_List, m_] := residueCanonicalPropagators[PropDen[Mom[Multiparticle @@ Sort[cut]], m], legs];
  vertexFactor[structures_List, edge_, helicities_List] := Module[{rows, coupling},
    If[Length[structures] =!= 2 || !AllTrue[structures, AssociationQ], Return[unsupported]];
    rows = Lookup[structures, "ModelRow", None];
    If[!AllTrue[rows, MatchQ[#, {_, _, _, "", _, _}] && Take[#, 2] === species &&
        FreeQ[Last[#], Spinor["Helicity", ___]] &] ||
        Sort[rows[[All, 3]]] =!= Sort[helicities] ||
        Length[DeleteDuplicates[Take[#, 2] & /@ Lookup[structures, "IncidentLegs", {}]]] =!= 1 ||
        !AllTrue[structures, Length[#["IncidentLegs"]] === 3 &&
          Last[#["IncidentLegs"]]["Source"] === edge && standardFermionVectorVertexQ[#] &] ||
        !DuplicateFreeQ[FreeQ[#, _xFactor] & /@ rows] ||
        !residueExactZero[Subtract @@ rows[[All, -2]]], Return[unsupported]];
    coupling = rows[[1, -2]];
    If[!rspScalarQ[coupling] || !residueFiniteQ[coupling], unsupported, coupling]
  ];
  topology[diagram_Association] := Module[
    {graph = diagram["Graph"], photonEdges, fermionEdge, names, vector, helicities,
     structures = diagram["VertexStructures"], vertices = diagram["InternalVertices"], props, paths,
     center, sidePaths, ends, left, right, inner, outer, connections, factors, sign, cuts},
    If[diagram["ExternalParticles"] =!= process || !AssociationQ[structures] ||
        Length[vertices] =!= 4 || Sort[Keys[structures]] =!= Sort[vertices], Return[unsupported]];
    props = diagram["Propagators"];
    If[!AssociationQ[props] || Length[props] =!= 3, Return[unsupported]];
    photonEdges = Select[Keys[props], props[#]["Spin2"] === 2 && props[#]["Mass"] === 0 &&
      props[#]["Particle"] === props[#]["Antiparticle"] &];
    fermionEdge = Complement[Keys[props], photonEdges];
    If[Length[photonEdges] =!= 2 || Length[fermionEdge] =!= 1, Return[unsupported]];
    fermionEdge = First[fermionEdge];
    If[props[fermionEdge]["Spin2"] =!= 1 || props[fermionEdge]["Mass"] =!= mass ||
        Sort[Lookup[props[fermionEdge], {"Particle", "Antiparticle"}]] =!= Sort[species] ||
        Sort[diagram["HelicitySumEdges"]] =!= Sort[photonEdges], Return[unsupported]];
    names = DeleteDuplicates[props[#]["Particle"] & /@ photonEdges];
    If[Length[names] =!= 1 || !StringQ[First[names]], Return[unsupported]];
    names = First[names];
    vector = SelectFirst[model[[1]], Length[#] === 11 && #[[5]] === 2 &&
      #[[6]] === 0 && #[[8]] === 1 && Sort[#[[{2, 3}]]] === Sort[(names <> # &) /@ {".+", ".-"}] &, None];
    If[vector === None, Return[unsupported]];
    helicities = vector[[{2, 3}]];
    If[Sort[Lookup[#, photonEdges] & /@ diagram["HelicityAssignments"]] =!= Sort[Tuples[helicities, 2]],
      Return[unsupported]];
    paths = ConstructiveDiagrams`diagramFermionLines[diagram];
    If[!MatchQ[paths, {{_Integer, _Integer} ..}] || Length[paths] =!= 3 ||
        !AllTrue[paths, process[[#]] === species &], Return[unsupported]];
    paths = FindShortestPath[graph, First[#], Last[#]] & /@ paths;
    If[Sort[Length /@ paths] =!= {3, 3, 4}, Return[unsupported]];
    center = SelectFirst[paths, Length[#] === 4 &];
    sidePaths = Select[paths, Length[#] === 3 &];
    inner = center[[{2, 3}]]; outer = sidePaths[[All, 2]];
    If[UndirectedEdge @@ Sort[inner] =!= fermionEdge, Return[unsupported]];
    connections = Function[v, Select[photonEdges, MemberQ[List @@ #, v] &]] /@ inner;
    If[Length /@ connections =!= {1, 1} || !DuplicateFreeQ[Flatten[connections]], Return[unsupported]];
    connections = First /@ connections;
    ends = MapThread[First[Complement[List @@ #1, {#2}]] &, {connections, inner}];
    If[Sort[ends] =!= Sort[outer], Return[unsupported]];
    {left, right} = (#[[{1, -1}]] &) /@ (sidePaths[[First@FirstPosition[outer, #]]] & /@ ends);
    center = center[[{1, -1}]];
    cuts = {pole[left, 0], pole[right, 0], pole[Append[left, First[center]], mass]};
    If[Sort[cuts] =!= Sort[(residueCanonicalPropagators[PropDen[Mom[#["Index"]], #["Mass"]], legs] &) /@
        Values[props]], Return[unsupported]];
    factors = Flatten[MapThread[Function[{edge, endpoints},
      vertexFactor[structures[#], edge, helicities] & /@ endpoints], {connections, Transpose[{inner, ends}]}]];
    sign = ConstructiveDiagrams`diagramFermionSign[diagram];
    If[AnyTrue[factors, MissingQ] || !MemberQ[{-1, 1}, sign], Return[unsupported]];
    <|"Center" -> center, "Left" -> left, "Right" -> right,
      "PhotonPoles" -> Times @@ Take[cuts, 2], "FermionPole" -> Last[cuts],
      "Coefficient" -> -sign Times @@ factors|>
  ];
  records = topology /@ diagrams;
  If[!AllTrue[records, AssociationQ], Return[unsupported]];
  expected = Function[bars, With[{lines = Transpose[{Flatten[Position[process, First[species]]], bars}]},
    Flatten[Function[center, (Join[{center}, #] &) /@ Permutations[DeleteCases[lines, center]]] /@ lines, 1]]] /@
      Permutations[Flatten[Position[process, Last[species]]]];
  If[Sort[Lookup[#, {"Center", "Left", "Right"}] & /@ records] =!= Sort[Flatten[expected, 1]],
    Return[unsupported]];
  groups = GatherBy[records, {#["Center"], #["PhotonPoles"]} &];
  expression = Total[Function[group, Total[Function[record,
    record["Coefficient"] sixFermionOrderedCurrent[mass, record["Left"], record["Center"], record["Right"]]/
      record["FermionPole"]] /@ group]/First[group]["PhotonPoles"]] /@ groups];
  If[residueFiniteQ[expression],
    <|"Expression" -> expression, "Method" -> "OffShellFermionExchange"|>, unsupported]
];

(* A certified ordered four-vector line admits a pair split into two
   same-chirality emission currents. Combine the adjacent orders by
   external Schouten and the 2x2 momentum determinant before validation. *)
constructSameChiralPairSplit[endpoints_List, vectors_List, kind_Integer,
    mass_, vertexFactors_List] := Module[
  {left = First[endpoints], right = Last[endpoints], chirality, dual, spin,
   bracket, sandwich, ratio, pole, pair, block, coefficient, expression},
  chirality = {"Angle", "Square"}[[kind]];
  dual = {"Square", "Angle"}[[kind]];
  spin[type_, leg_] := Spinor[If[MemberQ[endpoints, leg], "Spin", "Helicity"], type, leg];
  bracket[type_, i_, j_] := SpinorChain[spin[type, i], spin[type, j]];
  sandwich[reference_, i_] := SpinorChain[spin[chirality, reference], Mom[left], spin[dual, i]];
  ratio[reference_, i_] := sandwich[reference, i]/bracket[chirality, reference, i];
  pole[indices__Integer] := PropDen[Mom[Multiparticle @@ Sort[{indices}]], mass];
  pair[reference_, a_, b_] := (ratio[reference, a] ratio[reference, b] -
    mass^2 bracket[dual, a, b]^2/pole[left, a, b]) / pole[right, reference];
  block[{a_, b_}] := With[{other = Complement[vectors, {a, b}]},
    bracket[dual, Sequence @@ other] Total[pair[#, a, b] & /@ other] /
      (bracket[chirality, Sequence @@ other] pole[left, a] pole[left, b])];
  coefficient = (Times @@ vertexFactors) mass bracket[chirality, left, right];
  expression = coefficient Total[block /@ Subsets[vectors, {2}]];
  If[!residueFiniteQ[expression] ||
      !constructSpuriousBracketFormQ[expression],
    Return[Missing["UnsupportedSameChiralityPairSplit"]]];
  <|"Expression" -> expression, "Method" -> "SameChiralPairSplit", "Chirality" -> chirality|>
];

(* Sum equal-chirality emissions by their terminal pair and the remaining
   scalar-like Dirac current. The pair contraction is the ordinary 2x2
   determinant identity, not a new scalar/contact interaction in the model.
   Extracting the eikonal product before recursion combines all leading
   orders once. Only external shells and total conservation enter. *)
constructSameChiralSpuriousSubsetCurrent[endpoints_List, vectors_List, kind_Integer,
    mass_, vertexFactors_List] := Module[
  {left, right, chirality, dual, spin, bracket, insertion, pole, ratio,
   emission, leading, weight, current, expression},
  If[Length[endpoints] =!= 2 || Length[vectors] < 2 ||
      !DuplicateFreeQ[Join[endpoints, vectors]] ||
      !AllTrue[Join[endpoints, vectors], IntegerQ] || !MemberQ[{1, 2}, kind] ||
      Length[vertexFactors] =!= Length[vectors] || 2^Length[vectors] > 128 ||
      TrueQ[mass === 0], Return[Missing["UnsupportedSpuriousChiralSubsets"]]];
  {left, right} = endpoints;
  chirality = {"Angle", "Square"}[[kind]];
  dual = {"Square", "Angle"}[[kind]];
  spin[type_, leg_] := Spinor[If[MemberQ[endpoints, leg], "Spin", "Helicity"], type, leg];
  bracket[type_, i_, j_] := If[i === j, 0, SpinorChain[spin[type, i], spin[type, j]]];
  insertion[reference_, p_, i_] := If[p === reference || p === i, 0,
    SpinorChain[spin[chirality, reference], Mom[p], spin[dual, i]]];
  pole[p_, subset_List] := PropDen[Mom[Multiparticle @@ Sort[Prepend[subset, p]]], mass];
  ratio[reference_, i_, p_] := insertion[reference, p, i]/bracket[chirality, reference, i];
  leading[reference_, subset_List] := Times @@ (ratio[reference, #, left] & /@ subset);
  emission[reference_, subset_List, i_] := Module[{direct, complement},
    direct = Prepend[DeleteCases[subset, i], left];
    complement = Prepend[DeleteCases[Complement[vectors, subset], reference], right];
    If[Length[complement] < Length[direct],
      -Total[ratio[reference, i, #] & /@ complement],
      Total[ratio[reference, i, #] & /@ direct]]
  ];
  weight[reference_, subset_List, pair_List] := weight[reference, subset, pair] =
    (leading[reference, Complement[subset, pair]] + Total[Function[i,
      pole[left, {i}] emission[reference, subset, i]
        weight[reference, DeleteCases[subset, i], pair]] /@ Complement[subset, pair]]) /
      pole[left, subset];
  current[reference_, subset_List] := current[reference, subset] =
    (leading[reference, subset] - mass^2 Total[Function[pair,
      bracket[dual, Sequence @@ pair]^2 weight[reference, subset, pair]] /@
        Subsets[subset, {2}]]) / (Times @@ (pole[left, {#}] & /@ subset));
  expression = (Times @@ vertexFactors) mass bracket[chirality, left, right] *
    Total[Function[pair, bracket[dual, Sequence @@ pair]/bracket[chirality, Sequence @@ pair] *
      Total[current[#, Complement[vectors, pair]]/pole[right, {#}] & /@ pair]] /@
        Subsets[vectors, {2}]];
  expression = canonicalChains[residueCanonicalPropagators[expression, Sort[Join[endpoints, vectors]]]];
  If[!residueFiniteQ[expression] || !constructSpuriousBracketFormQ[expression],
    Return[Missing["UnsupportedSpuriousChiralSubsets"]]];
  <|"Expression" -> expression, "Method" -> "SameChiralSpuriousSubsetCurrent",
    "Chirality" -> chirality, "CurrentSubsets" -> Length[DownValues[current]],
    "PairSubsets" -> Length[DownValues[weight]],
    "Scope" -> "OffShellDiracLineExternalIdentities"|>
];

(* Ordinary second-order Dirac algebra groups a same-chirality line by its
   first two-emission block. The apparent pair interaction is a rearrangement
   of the certified cubic diagrams, not an additional model vertex. Eikonal
   products are reduced by the two-dimensional momentum determinant before
   recursion. Only external shells and total momentum conservation are used. *)
constructPhysicalChiralCurrent[endpoints_List, vectors_List, kind_Integer, mass_, vertexFactors_List] := Module[
  {left = First[endpoints], right = Last[endpoints], chirality, dual, spin,
   spinorBracket, momentumInsertion, leftPropagator, rightPropagator,
   endpointSandwich, emissionSum, leadingProduct, pairWeight, subsetCurrent, expression},
  chirality = {"Angle", "Square"}[[kind]];
  dual = {"Square", "Angle"}[[kind]];
  spin[type_, leg_] := Spinor[If[MemberQ[endpoints, leg], "Spin", "Helicity"], type, leg];
  spinorBracket[i_, j_] := SpinorChain[spin[dual, i], spin[dual, j]];
  momentumInsertion[j_, i_] := SpinorChain[spin[chirality, j], Mom[left], spin[dual, i]];
  leftPropagator[i_] := PropDen[Mom[Multiparticle @@ Sort[{left, i}]], mass];
  rightPropagator[subset_List] := PropDen[Mom[Multiparticle @@ Sort[Prepend[subset, right]]], mass];
  endpointSandwich[i_] := SpinorChain[spin[dual, i], Mom[left], Mom[right], spin[dual, i]];
  emissionSum[i_, subset_List] := Total[(spinorBracket[i, #] momentumInsertion[#, i] &) /@ subset];
  leadingProduct[subset_List] := Times @@ (endpointSandwich[#]/rightPropagator[{#}] & /@ subset);
  pairWeight[subset_List, pair_List] := pairWeight[subset, pair] = Module[
    {rest = Complement[subset, pair]},
    (Times @@ (endpointSandwich /@ rest)) +
    Total[Function[i, emissionSum[i, Complement[vectors, subset]] rightPropagator[{i}]/
      rightPropagator[DeleteCases[subset, i]] pairWeight[DeleteCases[subset, i], pair]] /@ rest] -
    mass^2 Total[Function[ij, (spinorBracket @@ ij)^2 (Times @@ (rightPropagator[{#}] & /@ ij))/
      rightPropagator[Complement[subset, ij]] pairWeight[Complement[subset, ij], pair]] /@ Subsets[rest, {2}]]
  ];
  subsetCurrent[subset_List] := subsetCurrent[subset] = If[Length[subset] < 2, leadingProduct[subset],
    leadingProduct[subset] - mass^2 Total[Function[ij,
      (spinorBracket @@ ij)^2 (Times @@ (leftPropagator /@ ij)) pairWeight[subset, ij]] /@ Subsets[subset, {2}]]/
      (rightPropagator[subset] (Times @@ (rightPropagator[{#}] & /@ subset)))];
  expression = (Times @@ (-vertexFactors)) mass *
    SpinorChain[spin[chirality, left], spin[chirality, right]] /
    (Times @@ (leftPropagator /@ vectors)) *
    Total[Function[ij, (spinorBracket @@ ij)^2 subsetCurrent[Complement[vectors, ij]]] /@ Subsets[vectors, {2}]];
  <|"Expression" -> expression, "Method" -> "PhysicalChiralSubsetCurrent",
    "Chirality" -> chirality, "CurrentSubsets" -> Length[DownValues[subsetCurrent]],
    "Scope" -> "OffShellDiracLineExternalIdentities"|>
];

(* A cubic vector current on one Dirac line admits a common chiral reference:
   all majority polarizations and the opposite polarization have the same
   angle (or square) endpoint. In this gauge their pair contractions vanish.
   The second-order fermion line then has scalar emissions and one rank-one
   spin emission. The two adjacent equal-helicity orders are combined by
   the external Schouten/momentum determinant identity. *)
constructVectorLineForm[diagrams_List, process_List, model_List, external_List,
    polePreference_: "AllSpurious"] := Module[
  {legs = externalIndices[external], massive, null, fermion, vector, endpoints, mass,
   vertexCoupling, vertices, kinds, sameChirality, largerSameChirality, majority, opposite, common, ref, angle, square,
   bracket, insertion, spin, legSpin, angle12, spinTerm, x, reference, pole, plusPair,
   mixedPair, pairBlock, scalarCurrent, subsetTerm, propagatorOrder, orders, candidate, coefficient},
  If[Length[legs] < 6 || Length[diagrams] > 5040 ||
      !preparationScalarExternalRulesQ[external], Return[Missing["UnsupportedChiralLine"]]];
  null = Select[legs, (Mass[#] /. external) === 0 &];
  massive = Complement[legs, null];
  If[Length[massive] =!= 2 || Length[diagrams] =!= Factorial[Length[null]], Return[Missing["UnsupportedChiralLine"]]];
  fermion = SelectFirst[model[[1]], #[[5]] === 1 && #[[8]] === 1 &&
    #[[2]] =!= #[[3]] && Sort[#[[{2, 3}]]] === Sort[process[[massive]]] &, None];
  If[fermion === None, Return[Missing["UnsupportedChiralLine"]]];
  endpoints = (First[FirstPosition[process, #]] &) /@ fermion[[{2, 3}]];
  mass = fermion[[6]];
  If[!AllTrue[endpoints, (Mass[#] /. external) === mass &],
    Return[Missing["UnsupportedChiralLine"]]];
  vector[name_] := AnyTrue[model[[1]], MemberQ[#[[{2, 3}]], name] &&
    #[[5]] === 2 && #[[6]] === 0 && #[[8]] === 1 &];
  If[!AllTrue[process[[null]], vector], Return[Missing["UnsupportedChiralLine"]]];
  vertexCoupling[name_] := Module[{body, targets, factors, found},
    body = LookupAmplitude[{{fermion[[2]], 1}, {fermion[[3]], 2}, {name, 3}}, model,
      False, Table[Unique["chiralSpin"], {4}]];
    targets = {xFactor[1, 2] SpinorChain[Spinor["Spin", "Angle", 1], Spinor["Spin", "Angle", 2]],
      xTildeFactor[1, 2] SpinorChain[Spinor["Spin", "Square", 1], Spinor["Spin", "Square", 2]]};
    factors = Cancel[body/#] & /@ targets;
    found = Select[Range[2], residueFiniteQ[factors[[#]]] && factors[[#]] =!= 0 &&
      !residueUnmappedQ[factors[[#]]] &];
    If[Length[found] =!= 1, None, {First[found], factors[[First[found]]]}]];
  vertices = vertexCoupling /@ process[[null]];
  If[!AllTrue[vertices, MatchQ[#, {_Integer, _}] &], Return[Missing["UnsupportedChiralLine"]]];
  kinds = First /@ vertices;
  If[polePreference === "AllPhysical" &&
      (Length[null] < 5 || 2^Length[null] > 128 || !SameQ @@ kinds),
    Return[Missing["UnsupportedPhysicalChiralLine"]]];
  sameChirality = Length[null] === 4 && SameQ @@ kinds;
  largerSameChirality = Length[null] > 4 && 2^Length[null] <= 128 && SameQ @@ kinds;
  If[polePreference =!= "AllPhysical" && Length[diagrams] > 120 && !largerSameChirality,
    Return[Missing["UnsupportedChiralLine"]]];
  majority = SelectFirst[{1, 2}, Count[kinds, #] === Length[null] - 1 &, None];
  If[polePreference =!= "AllPhysical" && majority === None && !sameChirality && !largerSameChirality && (Length[diagrams] > 24 ||
      Min[Count[kinds, 1], Count[kinds, 2]] < 2), Return[Missing["UnsupportedChiralLine"]]];
  (* Every source must be an ordered cubic chain on the same Dirac line.
     Its successive cut differences are the emitted external vector legs. *)
  propagatorOrder[diagram_Association] := Module[{props, cuts, order, rows},
    props = Values[diagram["Propagators"]];
    rows = Values[diagram["VertexStructures"]];
    If[Length[props] =!= Length[null] - 1 || Length[rows] =!= Length[null] ||
        !AllTrue[rows, Length[#] === 1 && ListQ[First[#]["ModelRow"]] &&
          Length[physicalAmplitudeParticles[First[#]["ModelRow"]]] === 3 &&
          Count[Lookup[First[#]["IncidentLegs"], "Index"], _Integer?(MemberQ[null, #] &)] === 1 &] ||
        !AllTrue[props, #["Spin2"] === 1 && #["Mass"] === mass &&
          Sort[{#["Particle"], #["Antiparticle"]}] === Sort[fermion[[{2, 3}]]] &],
      Return[None]];
    cuts = (List @@ #["Index"]) & /@ props;
    If[!AllTrue[cuts, ListQ[#] && DuplicateFreeQ[#] && SubsetQ[legs, #] &&
        Count[#, First[endpoints]] + Count[#, Last[endpoints]] === 1 &], Return[None]];
    cuts = SortBy[If[MemberQ[#, First[endpoints]], Sort[#], Complement[legs, #]] & /@ cuts, Length];
    cuts = Join[{{First[endpoints]}}, cuts, {Complement[legs, {Last[endpoints]}]}];
    If[!AllTrue[Partition[cuts, 2, 1], SubsetQ[Last[#], First[#]] &&
        Length[Last[#]] === Length[First[#]] + 1 &], Return[None]];
    order = First[Complement[Last[#], First[#]]] & /@ Partition[cuts, 2, 1];
    order];
  orders = propagatorOrder /@ diagrams;
  If[Sort[orders] =!= Sort[Permutations[null]], Return[Missing["UnsupportedChiralLine"]]];
  If[polePreference === "AllPhysical",
    Return[constructPhysicalChiralCurrent[endpoints, null, First[kinds], mass, Last /@ vertices]]];
  If[sameChirality,
    Return[constructSameChiralPairSplit[endpoints, null, First[kinds], mass, Last /@ vertices]]];
  If[largerSameChirality,
    Return[constructSameChiralSpuriousSubsetCurrent[endpoints, null, First[kinds], mass, Last /@ vertices]]];
  If[majority === None,
    Return[constructOffShellVectorLineForm[orders, endpoints,
      AssociationThread[null, 3 - 2 kinds], mass, Last /@ vertices]]];
  common = Pick[null, kinds, majority]; ref = First[common];
  opposite = First[Complement[null, common]];
  angle = {"Angle", "Square"}[[majority]]; square = {"Square", "Angle"}[[majority]];
  legSpin[kind_, i_] := Spinor[If[MemberQ[endpoints, i], "Spin", "Helicity"], kind, i];
  bracket[kind_, i_, j_] := SpinorChain[legSpin[kind, i], legSpin[kind, j]];
  insertion[i_, p_] := SpinorChain[legSpin[square, i], Mom[p], legSpin[angle, opposite]];
  angle12 = bracket[angle, Sequence @@ endpoints];
  spinTerm = Times @@ (bracket[angle, #, opposite] & /@ endpoints);
  x[i_, p_] := insertion[i, p]/bracket[angle, i, opposite];
  reference[p_] := insertion[ref, p]/bracket[square, ref, opposite];
  pole[indices__] := PropDen[Mom[Multiparticle @@ Sort[{indices}]], mass];
  plusPair[p_, a_, b_] := (x[a, p] x[b, p] - mass^2 bracket[square, a, b]^2/pole[p, a, b])/
    (pole[p, a] pole[p, b]);
  (* With two emissions on the other end, square Schouten and the exact
     external virtuality difference put both mixed orders in one numerator. *)
  mixedPair[p_, c_, sign_, center_] := With[{chain = insertion[c, p]},
    (x[c, p] (angle12 reference[p] + sign spinTerm) center +
      chain (angle12 chain + sign spinTerm bracket[square, c, opposite]))/
    (pole[p, c] pole[p, opposite])];
  pairBlock[{a_, b_}] := With[{c = First[Complement[common, {a, b}]],
      left = First[endpoints], right = Last[endpoints]},
    plusPair[left, a, b] mixedPair[right, c, 1, pole[left, a, b]] +
    plusPair[right, a, b] mixedPair[left, c, -1, pole[right, a, b]]];
  (* At other bounded multiplicities, sum ordered scalar emissions by
     subsets on either side of the unique rank-one insertion. *)
  scalarCurrent[p_, subset_List] := scalarCurrent[p, subset] = Switch[Length[subset],
    0, 1,
    2, plusPair[p, Sequence @@ subset],
    _, Total[Function[leg, With[{earlier = DeleteCases[subset, leg]},
      scalarCurrent[p, earlier] Total[x[leg, #] & /@ Prepend[earlier, p]]]] /@ subset]/
      pole[p, Sequence @@ subset]];
  subsetTerm[subset_List] := With[{later = Complement[common, subset],
      left = First[endpoints], right = Last[endpoints]},
    (-1)^Length[later] scalarCurrent[left, subset] scalarCurrent[right, later]
      (angle12 Total[reference /@ Prepend[subset, left]] - spinTerm)];
  coefficient = (Times @@ (-Last[#] & /@ vertices))/mass;
  candidate = coefficient If[Length[common] === 3,
    Total[pairBlock /@ Subsets[common, {2}]], Total[subsetTerm /@ Subsets[common]]];
  candidate = residueCanonicalPropagators[
    candidate /. chain_SpinorChain :> linearChain[chain], legs];
  If[!residueFiniteQ[candidate] || !constructSpuriousBracketFormQ[candidate],
    Return[Missing["UnsupportedChiralLine"]]];
  <|"Expression" -> candidate, "Method" -> "CommonChiralVectorLine",
    "Chirality" -> angle, "ReferenceLegs" -> {opposite, ref}|>
];

ConstructAmplitude::usage = ConstructAmplitude::usage <>
  " With an independent FeynmanModel, supported five-leg color-singlet Dirac, declared chiral-fermion, vector and scalar processes can first propose covariant currents matched exactly to every used elementary vertex and ordered diagram. A supported existing metric quartic is calibrated only from the complete known lower amplitude. Internal lines stay off shell, masses and couplings remain symbolic, and no benchmark or sampled coefficient fit constructs the proposal. It is accepted only after the original channels and all independent checks pass at every requested validation assignment. Default distinct-fermion inputs also receive an equal-independent-mass probe; explicit parameter and validation choices remain authoritative. Rejected or unsupported proposals retain the ordinary completion path.";

ConstructAmplitude[process_List, diagramModel_, factorizationModel_List,
    opts : OptionsPattern[]] := Module[
  {options = Join[Association[Options[ConstructAmplitude]], Association[Reverse[{opts}]]],
   started = AbsoluteTime[], stageStarted, currentStage = "Starting", lastEvent = <||>,
   lastPrinted = 0., timings = {}, stages = <||>, output, enabled, callback, printReport,
   diagramData, diagramPairs, diagramPreparation, channels, channelPreparation,
   factorization, factorizedPair, highEnergy, highEnergyRecovery, recoveryAdmission,
   finalPair = Missing["NotConstructed"], lastPreparedPair = Missing["NotPrepared"],
   feynmanModel, feynmanDiagrams, feynmanPairs, feynmanPrepared,
   benchmark = None, checkReport = Missing["NotRun"], external, checkSettings,
   result, report, failure = None, tag = Unique["amplitudeConstruction"],
   save, emit, child, remaining, stageOptions, run, require, requirePreparation, prepareFinal, workflow,
   completed = False, resultStatus, totalTime, resourceResolution, requestedOptions,
   finalComplexity = Missing["NotValidated"],
   prepareBenchmark, benchmarkReady = False, benchmarkRecovery = False,
   validateRepresentative, tryRetainedFactorizationPoint, effectivePolePreference, tryCovariantSource, covariantExtraValidationSets,
   retainFinalReferences, resolveFinalReferences,
   completeEnergy, recoverReciprocalReferences, trySpuriousForms, tryCompactSpuriousResult,
   trySpuriousVectorLine, tryPhysicalVectorLine,
   finishConstruction,
   representativeSelection = <|"Attempted" -> False, "Selected" -> False|>,
   representativeAttempts = {},
   representationInputs, physicalRepresentation = Missing["NotValidated"], representationReason = None},
  output = options["Output"]; enabled = options["ProgressReporting"];
  callback = options["ProgressFunction"]; printReport = options["PrintReport"];
  feynmanModel = options["FeynmanModel"];
  requestedOptions = options;
  options["RandomSeed"] = amplitudeResolveRandomSeed[options["RandomSeed"]];
  If[Complement[First /@ {opts}, First /@ Options[ConstructAmplitude]] =!= {} ||
      Length[process] < 4 || !AllTrue[process, StringQ] ||
      !(completionModelQ[diagramModel] || TrueQ[feynmanModelQ[diagramModel]] &&
        completionModelQ[List @@ diagramModel]) ||
      !completionModelQ[factorizationModel] ||
      !(feynmanModel === None || TrueQ[feynmanModelQ[feynmanModel]] &&
        completionModelQ[List @@ feynmanModel]) ||
      !MemberQ[{"Expression", "Amplitude", "Details"}, output] ||
      !AllTrue[{enabled, printReport}, MemberQ[{True, False}, #] &] ||
      !(callback === Automatic || MatchQ[callback, _Function | _Symbol]) ||
      !MemberQ[{Automatic, True, False}, options["Parallelization"]] ||
      !(options["MaxKernels"] === Automatic || IntegerQ[options["MaxKernels"]] && options["MaxKernels"] > 0) ||
      !(options["TimeConstraint"] === Automatic || constructSecondsQ[options["TimeConstraint"]]) ||
      residueParameterRules[factorizationModel, options["ParameterRules"]] === $Failed ||
      !(options["HighEnergyBound"] === Automatic || NumericQ[options["HighEnergyBound"]] &&
