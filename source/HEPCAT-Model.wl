        highEnergy["Status"] =!= "UNRESOLVED" || highEnergy["FreeParameters"] =!= {} ||
        Lookup[constructRuleOptions[options["HighEnergyOptions"]], "CorrectionBasis", Automatic] =!= Automatic ||
        Lookup[constructRuleOptions[options["FactorizationOptions"]], "CorrectionBasis", Automatic] =!= Automatic,
      Return[highEnergy]];
    failedPoles = Lookup[Select[Lookup[Lookup[highEnergy, "BeforeReport", <||>], "SpuriousChecks", {}],
      Lookup[#, "Status", None] === "FAIL" &], "Pole", {}];
    poleData = constructReciprocalPoleData[First[factorizedPair], channels, factorizationModel];
    If[!AssociationQ[poleData] || !ContainsAll[failedPoles, poleData["Brackets"]] || remaining[] <= 1,
      Return[highEnergy]];
    deadline = AbsoluteTime[] + Min[30, remaining[]];
    prepLimit = Replace[Lookup[constructRuleOptions[options["PreparationOptions"]],
      "TimeConstraint", Automatic], Automatic -> Infinity];
    alternative = run["Preparing alternate reference sources",
      PrepareAmplitudes[diagramPairs, diagramModel, Sequence @@ stageOptions[PrepareAmplitudes,
        options["PreparationOptions"], <|"PolePreference" -> "AllPhysical", "ReturnDetails" -> True,
          "ExternalParticles" -> process, "TimeConstraint" -> Min[prepLimit, 10, deadline - AbsoluteTime[]]|>]]];
    If[!constructPreparationUsableQ[alternative], Return[highEnergy]];
    basis = TimeConstrained[
      constructSplitReciprocalSource[#, poleData] & /@ (Last /@ alternative["PreparedAmplitudes"]),
      Max[0.000001, deadline - AbsoluteTime[]], {}];
    If[basis === {} || AbsoluteTime[] >= deadline, Return[highEnergy]];
    (* Include the center as a direction so the solve can replace it when its
       residues agree but its off-cut continuation has genuine spurious poles. *)
    basis = DeleteDuplicates[Append[basis, Last[factorizedPair]]];
    energyLimit = Replace[Lookup[constructRuleOptions[options["HighEnergyOptions"]],
      "TimeConstraint", Automatic], Automatic -> Infinity];
    repaired = completeEnergy["Repairing reciprocal reference poles", <|"CorrectionBasis" -> basis,
      "TimeConstraint" -> Min[energyLimit, deadline - AbsoluteTime[]]|>, False];
    If[AssociationQ[repaired] && repaired["Status"] === "COMPLETE", repaired, highEnergy]
  ];
  trySpuriousForms[] := Module[
    {normalized, settings, rules, plan, forms, original, compact, chosen, proof, compaction, candidate,
     deadline, available, prepLimit, accepted = False, previousPair = finalPair},
    If[options["PolePreference"] =!= "AllSpurious" || Length[process] =!= 5 ||
        Count[Last /@ external, 0] =!= 3 || remaining[] <= 1, Return[False]];
    settings = constructRuleOptions[options["FactorizationOptions"]];
    If[Lookup[settings, "CorrectionBasis", Automatic] =!= Automatic ||
        Lookup[settings, "ChannelReferences", Automatic] =!= Automatic ||
        Lookup[settings, "PolePreference", "AllSpurious"] =!= "AllSpurious" ||
        !MemberQ[{Automatic, True}, Lookup[settings, "ShiftedChannelContinuations", Automatic]] ||
        Lookup[constructRuleOptions[options["HighEnergyOptions"]], "CorrectionBasis", Automatic] =!= Automatic,
      Return[False]];
    deadline = AbsoluteTime[] + Min[120, remaining[]];
    available[] := Max[0, deadline - AbsoluteTime[]];
    normalized = completionNormalizeInput[diagramPreparation, channels, factorizationModel];
    If[!AssociationQ[normalized], Return[False]];
    normalized = Join[normalized, <|"ExternalParticles" -> process|>];
    plan = completionExchangePlan[normalized, factorizationModel, options["BoseSymmetryGroups"],
      options["FermionSymmetryGroups"], process];
    rules = residueParameterRules[factorizationModel, options["ParameterRules"]];
    If[!AssociationQ[plan] || !ListQ[rules], Return[False]];
    forms = run["Proposing compact spurious forms", TimeConstrained[
      Join[constructSpuriousOrbitForms[diagramPairs, diagramPreparation, plan, external],
        constructSpuriousShiftForms[normalized, factorizationModel, rules,
          options["RandomSeed"], Min[12, available[]]]], Min[15, available[]], {}]];
    If[!ListQ[forms], Return[False]];
    prepLimit = Replace[Lookup[constructRuleOptions[options["FinalPreparationOptions"]],
      "TimeConstraint", Automatic], Automatic -> Infinity];
    Do[
      If[available[] <= 1, Break[]];
      original = {normalized["ExternalMassRules"], form["Expression"]};
      compact = If[TrueQ[Lookup[form, "ExchangeProjected", False]], original,
        run["Preparing compact spurious form",
          prepareFinal[original, <|"TimeConstraint" -> Min[prepLimit, 25, available[]]|>]]];
      chosen = If[preparationPairQ[compact] && constructSpuriousBracketFormQ[Last[compact]] &&
        preparationBetterQ[preparationRank[Last[compact]], preparationRank[Last[original]]],
        compact, original];
      If[!constructSpuriousBracketFormQ[Last[chosen]], Continue[]];
      If[plan["Order"] > 1 && (!TrueQ[Lookup[form, "ExchangeProjected", False]] || chosen =!= original),
        proof = run["Checking exchange symmetry of compact form", completionHEZeroDirection[
          Last[chosen] - completionCompactExchangeProject[Last[chosen], plan], First[chosen],
          factorizationModel, Min[30, available[]]]];
        If[!AssociationQ[proof] || proof["Status"] =!= "PROVED_ZERO", Continue[]]];
      If[form["Method"] === "CompleteShiftedChannelSum",
        compaction = run["Factoring shifted numerators", completionCompactShiftedNumerators[
          Last[chosen], First[chosen], factorizationModel, Min[15, available[]]]];
        If[AssociationQ[compaction] && compaction["Status"] === "IMPROVED" &&
            constructSpuriousBracketFormQ[compaction["Amplitude"]],
          chosen = {First[chosen], compaction["Amplitude"]}]];
      candidate = Join[KeyDrop[form, "Expression"], <|"Status" -> "COMPLETE",
        "Amplitude" -> Last[chosen], "ExternalMassRules" -> First[chosen],
        "FreeParameters" -> {}|>];
      If[available[] > 0.01 && validateRepresentative[candidate, "Compact spurious",
          available[], False],
        save["Compact spurious form", candidate];
        accepted = True; Break[]],
      {form, forms}];
    If[!accepted, finalPair = previousPair];
    accepted
  ];
  tryPhysicalVectorLine[] := Module[{proposal, checked, previousPair = finalPair,
      previousSelection = representativeSelection, validationBudget},
    If[!completionModelQ[diagramModel] || feynmanModel === None || remaining[] <= 5 ||
        options["BoseSymmetryGroups"] =!= Automatic || options["FermionSymmetryGroups"] =!= Automatic ||
        !AllTrue[{"PreparationOptions", "ChannelPreparationOptions", "FactorizationOptions",
          "HighEnergyOptions", "FinalPreparationOptions", "FeynmanPreparationOptions"},
          constructRuleOptions[options[#]] === <||> &], Return[False]];
    proposal = run["Combining physical chiral currents", TimeConstrained[MemoryConstrained[
      constructVectorLineForm[diagramData, process, diagramModel, external, "AllPhysical"],
      268435456, Missing["PhysicalCurrentMemoryLimit"]],
      Min[30, remaining[]], Missing["PhysicalCurrentTimeConstraint"]]];
    If[!AssociationQ[proposal], Return[False]];
    If[!ListQ[channels],
      channels = run["Generating factorization channels", FactorizationAmplitudeChannels[process, factorizationModel]];
      require[channels]];
    prepareBenchmark["SpinorProducts"];
    validationBudget = Min[remaining[], Max[180, 20 Length[channels]]];
    checked = validateRepresentative[Join[KeyDrop[proposal, "Expression"],
      <|"Status" -> "COMPLETE", "Amplitude" -> proposal["Expression"],
        "ExternalMassRules" -> external, "FreeParameters" -> {}|>],
      "Physical chiral current", validationBudget];
    If[checked, save["Physical chiral current", KeyDrop[proposal, "Expression"]],
      finalPair = previousPair; representativeSelection = previousSelection;
      save["Representative selection", previousSelection]];
    checked
  ];
  trySpuriousVectorLine[tryGrouped_: True] := Module[
    {proposal, checked, origin, allowance, previousPair = finalPair,
      previousSelection = representativeSelection},
    If[!completionModelQ[diagramModel] || feynmanModel === None || remaining[] <= 5 ||
        options["BoseSymmetryGroups"] =!= Automatic || options["FermionSymmetryGroups"] =!= Automatic ||
        !AllTrue[{"PreparationOptions", "ChannelPreparationOptions", "FactorizationOptions",
          "HighEnergyOptions", "FinalPreparationOptions", "FeynmanPreparationOptions"},
          constructRuleOptions[options[#]] === <||> &],
      Return[False]];
    proposal = run["Building vector-line candidate", TimeConstrained[
      With[{line = MemoryConstrained[
          constructVectorLineForm[diagramData, process, diagramModel, external],
          134217728, Missing["VectorCurrentMemoryLimit"]]},
        If[MissingQ[line], MemoryConstrained[
          Module[{currents = Missing["NoGroupedCurrents"]},
            If[tryGrouped, currents = TimeConstrained[
              constructGroupedVectorCurrents[diagramData, process, diagramModel, external],
              5, Missing["GroupedCurrentTimeConstraint"]]];
            If[MissingQ[currents],
              currents = constructOffShellVectorCurrents[diagramData, process, diagramModel, external]];
            If[MissingQ[currents],
              constructOffShellFermionExchangeForm[diagramData, process, diagramModel, external], currents]],
          268435456, Missing["VectorCurrentMemoryLimit"]], line]],
      Min[40, remaining[]], Missing["VectorCurrentTimeConstraint"]]];
    If[!AssociationQ[proposal], Return[False]];
    {origin, allowance} = Switch[proposal["Method"],
      "OffShellVectorLine", {"Off-shell vector line", 200},
      "SameChiralPairSplit", {"Same-chirality pair split", 120},
      "SameChiralSpuriousSubsetCurrent", {"Same-chirality spurious subsets", Infinity},
      "GroupedVectorCurrents", {"Grouped vector currents", 180},
      "OffShellVectorCurrents", {"Off-shell vector currents", 240},
      "OffShellFermionExchange", {"Off-shell fermion exchange", 240},
      _, {"Common-chirality current", 90}];
    If[!ListQ[channels],
      channels = run["Generating factorization channels", FactorizationAmplitudeChannels[process, factorizationModel]];
      require[channels]];
    prepareBenchmark[If[proposal["Method"] === "SameChiralSpuriousSubsetCurrent", "SpinorProducts", True]];
    If[proposal["Method"] === "SameChiralSpuriousSubsetCurrent",
      allowance = Max[180, 20 Length[channels]]];
    checked = validateRepresentative[Join[KeyDrop[proposal, "Expression"], <|"Status" -> "COMPLETE",
      "Amplitude" -> proposal["Expression"], "ExternalMassRules" -> external, "FreeParameters" -> {}|>],
      origin, Min[allowance, remaining[]]];
    If[checked, save[Switch[proposal["Method"],
      "OffShellVectorLine", "Off-shell vector form",
      "GroupedVectorCurrents", "Grouped vector currents",
      "OffShellVectorCurrents", "Off-shell vector currents",
      "OffShellFermionExchange", "Off-shell fermion exchange",
      _, "Compact spurious form"], KeyDrop[proposal, "Expression"]],
      finalPair = previousPair; representativeSelection = previousSelection;
      save["Representative selection", previousSelection]; benchmarkReady = False];
    If[!checked && proposal["Method"] === "GroupedVectorCurrents",
      trySpuriousVectorLine[False], checked]
  ];
  workflow[] := Catch[
    diagramData = run["Generating diagrams", If[TrueQ[$colorConstructingProjection],
      $colorConstructionInput["Diagrams"], CreateDiagrams[process, diagramModel]]];
    require[diagramData];
    diagramPairs = run["Building diagram amplitudes", If[TrueQ[$colorConstructingProjection],
      $colorConstructionInput["DiagramAmplitudes"], DiagramAmplitudes[diagramData]]];
    require[diagramPairs];
    If[diagramPairs === {}, diagramPairs = {{external, 0}}];
    If[options["PolePreference"] === "AllPhysical" && Length[process] > 6 &&
        tryPhysicalVectorLine[], completed = True; Throw[finalPair, tag]];
    If[options["PolePreference"] === "AllSpurious" && Length[process] >= 6 &&
        trySpuriousVectorLine[], completed = True; Throw[finalPair, tag]];
    diagramPreparation = run["Preparing diagrams", PrepareAmplitudes[diagramPairs, diagramModel,
      Sequence @@ stageOptions[PrepareAmplitudes, options["PreparationOptions"],
        <|"ReturnDetails" -> True, "ExternalParticles" ->
          If[TrueQ[feynmanModelQ[diagramModel]], Automatic, process]|>]]];
    requirePreparation[diagramPreparation];
    If[!ListQ[channels],
      channels = run["Generating factorization channels", If[TrueQ[$colorConstructingProjection],
        $colorConstructionInput["Channels"], FactorizationAmplitudeChannels[process, factorizationModel]]];
      require[channels]];
    channelPreparation = run["Preparing factorization channels", PrepareAmplitudes[channels, factorizationModel,
      Sequence @@ stageOptions[PrepareAmplitudes, options["ChannelPreparationOptions"],
        Join[<|"ReturnDetails" -> True|>, If[channels === {}, <|"ExternalParticles" -> Automatic|>, <||>]]]]];
    requirePreparation[channelPreparation];
    If[tryCovariantSource[], completed = True; Throw[finalPair, tag]];
    If[trySpuriousForms[], completed = True; Throw[finalPair, tag]];
    factorization = run["Completing factorization", CompleteFactorization[diagramPreparation,
      channelPreparation, factorizationModel, Sequence @@ stageOptions[CompleteFactorization,
        options["FactorizationOptions"], <|"ReturnDetails" -> True, "ExternalParticles" -> process|>]]];
    If[tryRetainedFactorizationPoint[], completed = True; Throw[finalPair, tag]];
    require[factorization, {"COMPLETE"}];
    finalPair = {factorization["ExternalMassRules"], factorization["Amplitude"]};
    factorizedPair = run["Preparing factorization result", prepareFinal[finalPair, <||>, False]];
    require[factorizedPair]; finalPair = factorizedPair;
    factorization = constructPreparedFamily[factorization, factorizedPair];
    If[feynmanModel =!= None && Lookup[factorization, "FreeParameters", {}] =!= {} &&
        validateRepresentative[factorization, "Factorization", Min[60, remaining[]/10]],
      completed = True; Throw[finalPair, tag]];
    highEnergy = completeEnergy["Completing high-energy behavior"];
    If[AssociationQ[highEnergy] && TrueQ[Lookup[highEnergy, "PointReady", False]],
      If[feynmanModel =!= None &&
          validateRepresentative[highEnergy, "HighEnergy", remaining[]],
        completed = True; Throw[finalPair, tag]];
      (* A rejected point never discards the original correction space or
         blocks the established strict completion and recovery paths. *)
      save["Rejected fitted high-energy representative", highEnergy];
      highEnergy = completeEnergy["Completing high-energy behavior after rejected representative",
        <||>, False]];
    highEnergy = recoverReciprocalReferences[];
    recoveryAdmission=If[Lookup[constructRuleOptions[options["HighEnergyOptions"]],
        "TimeConstraint",Automatic]===Automatic,
      constructRetainedHighEnergyCheckpoint[highEnergy],Missing["ExplicitHighEnergyLimit"]];
    If[AssociationQ[recoveryAdmission] && Lookup[recoveryAdmission,"Status",None]==="ELIGIBLE",
      highEnergyRecovery=run["Validating retained HE candidate",
        constructValidateRetainedHighEnergy[highEnergy,channels,factorizationModel,remaining[],
          Lookup[constructRuleOptions[options["HighEnergyOptions"]],"Parallelization",options["Parallelization"]],
          Lookup[constructRuleOptions[options["HighEnergyOptions"]],"MaxKernels",options["MaxKernels"]],child]];
      require[highEnergyRecovery,{"COMPLETE"}];
      finalPair={highEnergyRecovery["ExternalMassRules"],highEnergyRecovery["Amplitude"]},
      If[AssociationQ[highEnergy] && Lookup[highEnergy, "Status", None] =!= "COMPLETE" &&
          validateRepresentative[highEnergy, "HighEnergy", remaining[]],
        completed = True; Throw[finalPair, tag]];
      require[highEnergy, {"COMPLETE"}];
      finalPair = {highEnergy["ExternalMassRules"], highEnergy["Amplitude"]}];
    finalPair = run["Preparing final amplitude", prepareFinal[finalPair]];
    require[finalPair];
    If[!retainFinalReferences && !FreeQ[Last[finalPair], (Spinor | SpinorHat)["Xi", ___]],
      With[{resolved = run["Resolving final references", resolveFinalReferences[finalPair]]},
        require[resolved]; finalPair = resolved]];
    If[feynmanModel =!= None, prepareBenchmark[]];
    checkSettings = Join[constructRuleOptions[options["CheckOptions"]], <|
      "Output" -> "Details", "SpuriousPoles" -> Automatic,
      "HighEnergyCheck" -> True, "ReferenceCheck" -> True,
      "RandomSeed" -> Lookup[constructRuleOptions[options["CheckOptions"]],
        "RandomSeed", options["RandomSeed"] + 2000003] /.
          Automatic -> options["RandomSeed"] + 2000003|>,
      If[feynmanModel =!= None, <|"FeynmanAmplitudes" -> benchmark, "FeynmanModel" -> feynmanModel|>, <||>]];
    checkReport = run["Checking final amplitude", CheckAmplitudes[finalPair, channels, factorizationModel,
      Sequence @@ stageOptions[CheckAmplitudes, checkSettings]]];
    require[checkReport];
    benchmark = Lookup[checkSettings, "FeynmanAmplitudes", None];
    If[!constructAllChecksPassQ[checkReport, finalPair, channels, factorizationModel, benchmark],
      Throw[constructFailure[currentStage, {"The final amplitude did not pass every required check.",
        Lookup[checkReport, "Summary", Missing["NoTestSummary"]]}], tag]];
    completed = True; finalPair,
    tag];
  tryCompactSpuriousResult[] := Module[
    {proposal, selected, previousPair = finalPair, previousSelection = representativeSelection},
    If[!completed || options["PolePreference"] =!= "AllSpurious" || Length[process] < 6 ||
        feynmanModel === None || remaining[] <= 2 ||
        MemberQ[{"Off-shell vector line", "Grouped vector currents",
          "Off-shell vector currents", "Off-shell fermion exchange", "Same-chirality pair split",
          "Same-chirality spurious subsets"},
          Lookup[representativeSelection, "SourceStage", None]] ||
        LeafCount[Last[finalPair]] > 12000 ||
        !constructSpuriousBracketFormQ[Last[finalPair]], Return[False]];
    proposal = run["Reducing spurious compound-pole groups", TimeConstrained[
      MemoryConstrained[Module[{input, plan},
        input = completionNormalizeInput[finalPair, channels, factorizationModel];
        If[!AssociationQ[input], Return[Missing["UnsupportedSpuriousGroups"]]];
        plan = completionExchangePlan[input, factorizationModel, options["BoseSymmetryGroups"],
          options["FermionSymmetryGroups"], process];
        If[!AssociationQ[plan], Return[Missing["UnsupportedSpuriousGroups"]]];
        constructSpuriousGroupOrbit[Last[finalPair], First[finalPair], plan,
          Lookup[input["Targets"], "Propagator", {}]]],
        134217728, Missing["SpuriousGroupMemoryLimit"]],
      Min[8, remaining[]], Missing["SpuriousGroupTimeConstraint"]]];
    If[!AssociationQ[proposal], Return[False]];
    selected = validateRepresentative[Join[proposal, <|"Status" -> "COMPLETE",
      "ExternalMassRules" -> First[finalPair], "FreeParameters" -> {}|>],
      "Reduced compound-pole orbit", Min[45, remaining[]]];
    If[selected,
      save["Compact spurious form", proposal],
      finalPair = previousPair; representativeSelection = previousSelection;
      save["Representative selection", previousSelection]];
    selected
  ];
  (* Keep source and fit preparation on their established path. The extra
     exact support solve is reserved for preparing a completed candidate. *)
  finishConstruction[] := Block[{$deferExactTensorSupportPolish = True},
    Module[{value = workflow[]}, If[tryCompactSpuriousResult[], finalPair, value]]];
  result = If[TrueQ[enabled] && callback === Automatic && $FrontEnd =!= Null,
    Monitor[finishConstruction[], Refresh[Grid[{
      {"Stage", currentStage},
      {"Stage elapsed", constructDuration[AbsoluteTime[] - stageStarted]},
      {"Total elapsed", constructDuration[AbsoluteTime[] - started]},
      {"Progress", Row[{Lookup[lastEvent, "Stage", ""], " ", Lookup[lastEvent, "Operation", ""],
        " ", Lookup[lastEvent, "Completed", ""], If[KeyExistsQ[lastEvent, "Total"], "/", ""],
        Lookup[lastEvent, "Total", ""]}]}}, Alignment -> Left], UpdateInterval -> 1]], finishConstruction[]];
  failure = If[completed, None, If[FailureQ[result], result,
    constructFailure[currentStage, {"Construction ended without a validated amplitude."}]]];
  If[completed,
    physicalRepresentation = TimeConstrained[
      representationInputs = completionNormalizeInput[finalPair, channels, factorizationModel];
      If[AssociationQ[representationInputs],
        completionPhysicalDenominatorOnlyQ[Last[finalPair], representationInputs],
        Missing["RepresentationNotEstablished"]], 2, Missing["RepresentationClassificationTimeout"]];
    If[options["PolePreference"] === "AllPhysical" && physicalRepresentation =!= True,
      representationReason = If[physicalRepresentation === False,
        "AllPhysical was not achieved: the validated expression still displays apparent spurious denominators.",
        "The final physical-only denominator representation could not be established within its classification budget."]]];
  If[completed, finalComplexity = constructComplexity[Last[finalPair]]];
  totalTime = AbsoluteTime[] - started;
  If[TrueQ[printReport],
    If[StringQ[representationReason], Print[representationReason]];
    Print[Row[{"Random seed: ", options["RandomSeed"]}]];
    Print[Row[{"Total time: ", constructDuration[totalTime]}]];
    If[completed, Print[Row[{"Complexity: ", If[IntegerQ[finalComplexity], finalComplexity,
      "not measured within the reporting budget"]}]]];
    Print[If[AssociationQ[checkReport] && KeyExistsQ[checkReport, "Table"], checkReport["Table"],
      Dataset[{<|"Check" -> "Final amplitude tests", "Status" -> "NOT RUN",
        "StoppedAt" -> currentStage|>}]]]];
  report = <|"Status" -> If[completed, "COMPLETE", "FAILED"], "Process" -> process,
    "RandomSeed" -> options["RandomSeed"], "Complexity" -> finalComplexity,
    "Amplitude" -> If[completed, Last[finalPair], Missing["NotValidated"]],
    "AmplitudePair" -> If[completed, finalPair, Missing["NotValidated"]],
    "CandidateAmplitude" -> If[completed, Missing["NotNeeded"], finalPair],
    "Checks" -> checkReport, "TotalTime" -> totalTime, "StageTimings" -> timings,
    "RequestedPolePreference" -> options["PolePreference"],
    "AchievedPhysicalDenominators" -> physicalRepresentation,
    "PreferenceFallbackReason" -> representationReason,
    "Stages" -> stages, "ResourcePolicy" -> resourceResolution["ResourcePolicy"],
    "RepresentativeSelection" -> representativeSelection,
    "RepresentativeSelectionAttempts" -> representativeAttempts,
    "RequestedOptions" -> requestedOptions, "Failure" -> failure|>;
  If[output === "Details", Return[report]];
  If[!completed, Return[failure]];
  If[output === "Amplitude", finalPair, Last[finalPair]]
];
ConstructAmplitude[___] := (Message[ConstructAmplitude::args];
  Failure["InvalidConstructionArguments", <|"MessageTemplate" -> "Invalid process, model or construction options."|>]);

End[];
End[];
