                "EquationCount" -> Length[allEquations]|>];
              feedback = <|"Status" -> "COMPLETE", "Equations" -> {}, "Samples" -> {},
                "Diagnostics" -> {}|>; familyPass = True;
              Do[
                sparseValidation = completionSparseValidation[trial, unknowns, solution,
                  free, zeroFree, normalized, validationCount, validationSeed, validationSet,
                  seconds, callback, enabled];
                validation = sparseValidation["Report"];
                feedback = <|"Status" -> If[feedback["Status"] === "COMPLETE" &&
                    sparseValidation["Feedback"]["Status"] === "COMPLETE", "COMPLETE", "UNRESOLVED"],
                  "Equations" -> Join[feedback["Equations"], sparseValidation["Feedback"]["Equations"]],
                  "Samples" -> Join[feedback["Samples"], sparseValidation["Feedback"]["Samples"]],
                  "Diagnostics" -> Join[feedback["Diagnostics"], sparseValidation["Feedback"]["Diagnostics"]]|>;
                familyPass = familyPass && TrueQ[sparseValidation["FamilyPass"]];
                AppendTo[roundReports, <|"ParameterRules" -> validationSet,
                  "RandomSeed" -> validationSeed, "Round" -> round, "Report" -> validation|>];
                If[AssociationQ[fittedPointCheckpoint], fittedPointCheckpoint = Join[
                  fittedPointCheckpoint, <|"SparseValidationReports" -> roundReports|>]],
                {validationSet, validationSets}];
              validationReports = Join[validationReports, roundReports];
              AppendTo[history, <|"Round" -> round, "FitSeed" -> seed,
                "ValidationSeed" -> validationSeed, "ValidationSamples" -> validationCount,
                "EquationCount" -> Length[allEquations], "Rank" -> solution["Rank"],
                "FreeParameters" -> free, "RemovedZeroDirections" -> Length[zeroFree],
                "Status" -> If[AllTrue[roundReports,
                    completionPhysicalPassQ[#["Report"], normalized["Targets"]] &] &&
                  familyPass, "COMPLETE", "NeedsRefinement"]|>];
              If[AllTrue[roundReports,
                  completionPhysicalPassQ[#["Report"], normalized["Targets"]] &] && familyPass,
                completionProgress[callback, enabled,
                  <|"Stage" -> "Constructing validated factorization amplitude",
                    "Unknowns" -> Length[free]|>];
                weights = unknowns /. solution["SolutionRules"];
                candidate = (trial /. Thread[unknowns -> 0]) +
                  (weights /. Thread[free -> 0]).basis;
                remaining = (Function[parameter,
                  (Coefficient[#, parameter] & /@ weights).basis] /@ free);
                zeroFree = Pick[free, (# === 0 &) /@ remaining];
                free = Pick[free, (# =!= 0 &) /@ remaining];
                remaining = DeleteCases[remaining, 0];
                family = candidate + If[free === {}, 0, free.remaining];
                familyMaterialized = True;
                history[[-1]] = Join[Last[history], <|"FreeParameters" -> free,
                  "RemovedZeroDirections" -> Length[zeroFree]|>];
                status = "COMPLETE";
                Break[]];
              If[feedback["Status"] =!= "COMPLETE",
                diagnostics = Join[diagnostics, feedback["Diagnostics"]]; Break[]];
              If[round === refinements,
                AppendTo[diagnostics,
                  "Independent cut or affine-family validation still fails at MaxRefinements."];
                Break[]];
              allEquations = Join[allEquations, feedback["Equations"]];
              allSamples = Join[allSamples, feedback["Samples"]];
              constraints = Join[constraints, <|"Equations" -> allEquations,
                "Samples" -> allSamples|>];
              completionProgress[callback, enabled, <|"Stage" -> "Refining factorization",
                "Round" -> round + 1, "EquationCount" -> Length[allEquations],
                "Unknowns" -> Length[unknowns]|>],
              {round, 0, refinements}];
            constraints = Join[constraints, <|"Equations" -> allEquations,
              "Samples" -> allSamples|>]]]]]; True,
    If[seconds === Infinity, Infinity, Max[0.000001, seconds - (AbsoluteTime[] - start)]], False];
  If[!TrueQ[finished], status = "UNRESOLVED";
    AppendTo[diagnostics, "Factorization completion exceeded TimeConstraint."]];
  If[!familyMaterialized, free = {}; remaining = {}; family = candidate];
  (* Cosmetic reductions share one small budget after validation. A timeout
     must retain the validated family rather than invalidate its success. *)
  If[status === "COMPLETE" && history =!= {},
    remainingSeconds = If[seconds === Infinity, 2, Min[2, seconds - (AbsoluteTime[] - start)]];
    If[remainingSeconds > 0,
      postStarted = AbsoluteTime[]; postBudget = remainingSeconds;
      If[representativeOption === Automatic && free =!= {},
        completionProgress[callback, enabled, <|"Stage" -> "Choosing a compact amplitude",
          "Unknowns" -> Length[free]|>];
        representative = completionChooseFamilyPoint[candidate, remaining, free, 3 postBudget/4];
        If[representative["Status"] === "IMPROVED",
          representative = Join[representative, <|"OriginalCenter" -> candidate,
            "CoordinateOffset" -> Thread[free -> representative["Values"]]|>];
          candidate = representative["Amplitude"];
          family = candidate + free.remaining]];
      remainingSeconds = Max[0.000001, postBudget - (AbsoluteTime[] - postStarted)];
      cleaned = TimeConstrained[{cleanup[candidate], cleanup /@ remaining},
        remainingSeconds, $TimedOut];
      If[MatchQ[cleaned, {_, _List}],
        {candidate, remaining} = cleaned;
        zeroFree = Pick[free, (# === 0 &) /@ remaining];
        free = Pick[free, (# =!= 0 &) /@ remaining];
        remaining = DeleteCases[remaining, 0];
        family = candidate + If[free === {}, 0, free.remaining];
        history[[-1]] = Join[Last[history], <|"FreeParameters" -> free,
          "RemovedZeroDirections" -> Last[history]["RemovedZeroDirections"] + Length[zeroFree]|>]]]];
  report = <|"Stage" -> "Factorization", "Status" -> status, "RandomSeed" -> seed,
    "Amplitude" -> candidate, "OriginalExpression" -> original,
    "Correction" -> candidate - original, "CorrectionBasis" -> basis,
    "FamilyAmplitude" -> family, "RemainingBasis" -> remaining, "FreeParameters" -> free,
    "FittedPointCheckpoint" -> fittedPointCheckpoint,
    "ExternalMassRules" -> normalized["ExternalMassRules"],
    "InitialReport" -> initial, "ValidationReport" -> validation,
    "ParameterRules" -> rules,
    "ValidationReports" -> validationReports, "ValidationParameterRules" -> validationSets,
    "FitSamples" -> samples,
    "ConstraintData" -> <|"FitSeed" -> Which[MemberQ[{"PhysicalChannels", "PreferredReferences"}, space], physicalFitSeed,
        space === "PreparationRemainders", remainderFitSeed,
        space === "ShiftedChannels", shiftedFitSeed,
        space === "PeeledChannels", companionFitSeed,
        MemberQ[{"InputRescaling", "InputOverlap"}, space], inputAttempt["RegularExpression"],
        True, projectedSeed], "FitVariables" -> unknowns,
      "Fit" -> constraints, "LinearSolution" -> solution,
      "Validation" -> feedback|>, "RefinementHistory" -> history,
    "ChannelContinuations" -> continuations,
    "BoseSymmetry" -> completionExchangeDetails[exchangePlan, "Boson"],
    "FermionSymmetry" -> completionExchangeDetails[exchangePlan, "Fermion"],
    "ExchangeSymmetry" -> KeyDrop[exchangePlan, "Permutations"],
    "CorrectionSpace" -> space, "ReducedChannelSpace" -> reducedChannels,
    "SelectedChannelSpace" -> selectedChannels,
    "CorrectionSpaceCandidates" -> budgetSpaces,
    "InputFitAttempts" -> inputAttempts,
    "BasisNormalizationPolicy" -> "CanonicalExpandedProductsWithRetainedSources",
    "ProjectedSeedNormalization" -> projectedSeedNormalization,
    "ShiftedChannelContinuations" -> shiftedSpace,
    "ShiftedChannelAttempts" -> shiftedAttempts,
    "ShiftedChannelFit" -> If[AssociationQ[shiftedFit], KeyTake[shiftedFit,
      {"Status", "ElapsedTime", "RefinementHistory", "ValidationReports"}], shiftedFit],
    "RepresentativeSelection" -> representative,
    "PolePreference" -> polePreference, "PreferredPoleSpace" -> physicalSpace,
    "PhysicalSelectedChannelSpace" -> physicalSelected,
    "PhysicalPoleSpace" -> physicalSpace,
    "PhysicalSourceAttempts" -> physicalSourceAttempts,
    "StructuredPhysicalEligibility" -> structuredEligibility,
    "StructuredPhysicalSpace" -> structuredSpace, "StructuredPhysicalFit" -> structuredFit,
    "PreferredPoleFit" -> physicalFit, "PhysicalPoleFit" -> physicalFit,
    "MomentumConservationSpace" -> conservationSpace, "MomentumConservationFit" -> conservationFit,
    "ChannelCompanions" -> companionSpace,
    "ChannelCompanionFit" -> If[AssociationQ[companionFit],
      KeyTake[companionFit, {"Status", "ElapsedTime", "RefinementHistory", "ValidationReports"}], companionFit],
    "PreparationRemainders" -> remainderSpace,
    "PreparationRemainderFit" -> If[AssociationQ[remainderFit],
      KeyTake[remainderFit, {"Status", "ElapsedTime", "RefinementHistory", "ValidationReports"}], remainderFit],
    "ChannelPreparation" -> If[channelPreparation === <||>, Missing["NotSupplied"],
      <|"OriginalChannelsAreTargets" -> True, "PreparedChannels" -> channelPreparation["PreparedAmplitudes"]|>],
    "Scope" -> "BoundedAdaptiveLinearCompletionAtExactSampledCutsWithHeldOutValidation",
    "ElapsedTime" -> AbsoluteTime[] - start, "Diagnostics" -> Join[diagnostics, {
      "Factorization completion alone does not assert high-energy or reference independence. Remaining residue-preserving directions are retained for the next stage.",
      "A fitted sampled correction is not a generic analytic uniqueness proof."}]|>;
  If[status =!= "COMPLETE" && TrueQ[finished] && space === "ReducedChannels",
    remainingSeconds = If[seconds === Infinity, Infinity, seconds - (AbsoluteTime[] - start)];
    If[remainingSeconds > 0.01,
      fallbackBasis = TimeConstrained[completionAutomaticBasis[normalized, constructionLimit, continuations],
        remainingSeconds, $TimedOut];
      If[ListQ[fallbackBasis] && fallbackBasis =!= basis &&
          (seconds === Infinity || seconds - (AbsoluteTime[] - start) > 0.01),
        completionProgress[callback, enabled, <|"Stage" -> "Trying literal channel correction terms"|>];
        fallbackOptions = Join[Association[Options[CompleteFactorization]], Association[{opts}],
          <|"CorrectionBasis" -> fallbackBasis, "AlternativeChannels" -> {}, "ReturnDetails" -> True,
            "TimeConstraint" -> If[seconds === Infinity, Infinity,
              Max[0.000001, seconds - (AbsoluteTime[] - start)]]|>];
        attemptSummary = KeyTake[report, {"Status", "CorrectionSpace", "Diagnostics", "ElapsedTime",
          "RefinementHistory"}];
        fallbackReport = CompleteFactorization[input, channelInput, model,
          Sequence @@ Normal[completionChildResourceOptions[fallbackOptions]]];
        If[AssociationQ[fallbackReport],
          report = Join[fallbackReport, <|"CorrectionSpace" -> "LiteralTerms",
            "CorrectionSpaceAttempts" -> {attemptSummary,
              KeyTake[fallbackReport, {"Status", "Diagnostics", "ElapsedTime", "RefinementHistory"}]},
            "ReducedChannelSpace" -> reducedChannels, "ChannelContinuations" -> continuations,
            "ElapsedTime" -> AbsoluteTime[] - start|>];
          status = report["Status"]]]]];
  If[status =!= "COMPLETE" && basisOption === Automatic && references === Automatic &&
      remainderOption === Automatic && AssociationQ[remainderSpace],
    Do[
      remainingSeconds = If[seconds === Infinity, 12,
        Min[12, seconds - (AbsoluteTime[] - start)]];
      If[remainingSeconds <= 0.01, Break[]];
      completionProgress[callback, enabled, <|"Stage" -> "Trying retained reference continuation",
        "Operation" -> retainedReference["Mode"]|>];
      retainedReferenceBasis = TimeConstrained[
        {project[retainedReference["Expression"]] - projectedSeed},
        Min[2, remainingSeconds/4], Missing["ReferenceProjectionTimeout"]];
      If[MissingQ[retainedReferenceBasis],
        AppendTo[referenceAttempts, <|"Mode" -> retainedReference["Mode"],
          "Status" -> "UNRESOLVED", "Reason" -> "Retained-reference projection exceeded its budget."|>];
        Continue[]];
      remainingSeconds = If[seconds === Infinity, 12,
        Min[12, seconds - (AbsoluteTime[] - start)]];
      If[remainingSeconds <= 0.01, Break[]];
      fallbackOptions = Join[Association[Options[CompleteFactorization]], Association[{opts}],
        <|"CorrectionBasis" -> retainedReferenceBasis, "BoseSymmetryGroups" -> {}, "FermionSymmetryGroups" -> {},
          "InputReweighting" -> None, "PreparationRemainders" -> None,
          "ChannelCompanions" -> None, "AlternativeChannels" -> {}, "ReturnDetails" -> True,
          "TimeConstraint" -> remainingSeconds|>];
      fallbackReport = TimeConstrained[CompleteFactorization[
        {normalized["ExternalMassRules"], projectedSeed}, checkRows, model,
        Sequence @@ Normal[completionChildResourceOptions[fallbackOptions]]], remainingSeconds, Missing["RetainedReferenceTimeout"]];
      AppendTo[referenceAttempts, Join[KeyTake[retainedReference, {"Mode", "IsIdentity"}],
        If[AssociationQ[fallbackReport], KeyTake[fallbackReport,
          {"Status", "ElapsedTime", "Diagnostics"}], <|"Status" -> "UNRESOLVED"|>]]];
      If[AssociationQ[fallbackReport] && fallbackReport["Status"] === "COMPLETE",
        report = Join[fallbackReport, <|"CorrectionSpace" -> "RetainedReferences",
          "OriginalExpression" -> original, "Correction" -> fallbackReport["Amplitude"] - original,
          "BoseSymmetry" -> completionExchangeDetails[exchangePlan, "Boson"],
    "FermionSymmetry" -> completionExchangeDetails[exchangePlan, "Fermion"],
    "ExchangeSymmetry" -> KeyDrop[exchangePlan, "Permutations"],
          "ChannelPreparation" -> report["ChannelPreparation"],
          "ElapsedTime" -> AbsoluteTime[] - start|>];
        status = "COMPLETE"; Break[]],
      {retainedReference, Lookup[remainderSpace, "ReferenceAlternatives", {}]}]];
  If[status =!= "COMPLETE" && basisOption === Automatic && alternatives =!= {},
    remainingSeconds = If[seconds === Infinity, Infinity, seconds - (AbsoluteTime[] - start)];
    If[remainingSeconds > 0.01,
      completionProgress[callback, enabled, <|"Stage" -> "Checking alternative channel representations"|>];
      alternativeSpace = TimeConstrained[completionAlternativeChannelBasis[input, normalized,
        alternatives, model, rules, seed, constructionLimit, references],
        remainingSeconds, <|"Status" -> "UNRESOLVED", "Diagnostics" -> {
          "Alternative channel preparation exceeded the remaining TimeConstraint."}|>];
      report = Join[report, <|"AlternativeChannelFallback" -> alternativeSpace|>];
      If[alternativeSpace["Status"] === "COMPLETE" &&
          (seconds === Infinity || seconds - (AbsoluteTime[] - start) > 0.01),
        completionProgress[callback, enabled, <|"Stage" -> "Trying verified alternative channel directions"|>];
        fallbackOptions = Join[Association[Options[CompleteFactorization]], Association[{opts}],
          <|"CorrectionBasis" -> alternativeSpace["Basis"], "AlternativeChannels" -> {},
            "ReturnDetails" -> True, "TimeConstraint" -> If[seconds === Infinity, Infinity,
              Max[0.000001, seconds - (AbsoluteTime[] - start)]]|>];
        attemptSummary = KeyTake[report, {"Status", "CorrectionSpace", "Diagnostics", "ElapsedTime",
          "RefinementHistory"}];
        fallbackReport = CompleteFactorization[input, channelInput, model,
          Sequence @@ Normal[completionChildResourceOptions[fallbackOptions]]];
        If[AssociationQ[fallbackReport],
          report = Join[fallbackReport, <|"CorrectionSpace" -> "AlternativeChannels",
            "AlternativeChannelFallback" -> alternativeSpace,
            "CorrectionSpaceAttempts" -> Join[Lookup[report, "CorrectionSpaceAttempts", {attemptSummary}],
              {KeyTake[fallbackReport, {"Status", "Diagnostics", "ElapsedTime", "RefinementHistory"}]}],
            "ElapsedTime" -> AbsoluteTime[] - start|>];
          status = report["Status"]]]]];
  (* Normalize the certified particular solution by ordinary external identities.
     Keep the full affine family: changing its center by an exact identity does
     not delete or constrain any independent correction direction. *)
  remainingSeconds = If[seconds === Infinity, 12,
    Max[0, Min[12, seconds - (AbsoluteTime[] - start)]]];
  If[Lookup[report, "Status", "UNRESOLVED"] === "COMPLETE" && remainingSeconds > 0.01 &&
      500 <= LeafCount[report["Amplitude"]] <= 24000 &&
      !FreeQ[report["Amplitude"], chain_SpinorChain /; Length[chain] === 4 && First[chain] === Last[chain]],
    completionProgress[callback, enabled, <|"Stage" -> "Compacting ordinary pole identities",
      "Elapsed" -> AbsoluteTime[] - start|>];
    ordinaryCompaction = preparationOrdinaryPoleCompaction[report["Amplitude"],
      report["ExternalMassRules"], True, remainingSeconds];
    ordinaryCompaction = Join[ordinaryCompaction, <|"OriginalCenter" -> report["Amplitude"],
      "RetainedDirectionCount" -> Length[Lookup[report, "RemainingBasis", {}]],
      "CorrectionSpanChanged" -> False|>];
    If[Lookup[ordinaryCompaction, "Status", "UNCHANGED"] === "IMPROVED",
      trial = ordinaryCompaction["Amplitude"];
      report = Join[report, <|"Amplitude" -> trial,
        "Correction" -> trial - report["OriginalExpression"],
        "FamilyAmplitude" -> trial + If[Lookup[report, "FreeParameters", {}] === {}, 0,
          report["FreeParameters"].report["RemainingBasis"]]|>]];
    report = Join[report, <|"OrdinaryCompaction" -> ordinaryCompaction|>]];
  report = Join[report, <|"ElapsedTime" -> AbsoluteTime[] - start,
    "RandomSeed" -> seed, "EffectiveMaxCorrectionTerms" -> limit,
    "SourceConstructionLimit" -> constructionLimit,
    "CapChanges" -> DeleteDuplicates[Join[structuredCapChanges,
      If[AssociationQ[physicalSpace], Lookup[physicalSpace, "CapChanges", {}], {}], unionCapChanges]],
    "BoseSymmetry" -> completionExchangeDetails[exchangePlan, "Boson"],
    "FermionSymmetry" -> completionExchangeDetails[exchangePlan, "Fermion"],
    "ExchangeSymmetry" -> KeyDrop[exchangePlan, "Permutations"],
    "CorrectionSpace" -> completionExchangeSpaceName[Lookup[report, "CorrectionSpace", space], exchangePlan],
    "CorrectionSpaceCandidates" -> Map[Function[entry, If[AssociationQ[entry] &&
      KeyExistsQ[entry, "CorrectionSpace"], Join[entry, <|"CorrectionSpace" ->
        completionExchangeSpaceName[entry["CorrectionSpace"], exchangePlan]|>], entry]],
      Lookup[report, "CorrectionSpaceCandidates", {}]],
    "InputFitAttempts" -> inputAttempts,
    "BasisNormalizationPolicy" -> "CanonicalExpandedProductsWithRetainedSources",
    "ProjectedSeedNormalization" -> projectedSeedNormalization,
    "ShiftedChannelContinuations" -> shiftedSpace,
    "ShiftedChannelAttempts" -> shiftedAttempts,
    "ShiftedChannelFit" -> If[AssociationQ[shiftedFit], KeyTake[shiftedFit,
      {"Status", "ElapsedTime", "RefinementHistory", "ValidationReports"}], shiftedFit],
    "ChannelCompanions" -> companionSpace,
    "ChannelCompanionFit" -> If[AssociationQ[companionFit],
      KeyTake[companionFit, {"Status", "ElapsedTime", "RefinementHistory", "ValidationReports"}], companionFit],
    "PreparationRemainders" -> remainderSpace,
    "PreparationRemainderFit" -> If[AssociationQ[remainderFit],
      KeyTake[remainderFit, {"Status", "ElapsedTime", "Reason", "Preflight", "RefinementHistory", "ValidationReports"}], remainderFit],
    "PreparationReferenceAttempts" -> referenceAttempts,
    "PolePreference" -> polePreference, "PreferredPoleSpace" -> physicalSpace,
    "PhysicalSelectedChannelSpace" -> physicalSelected,
    "PhysicalPoleSpace" -> physicalSpace,
    "PhysicalSourceAttempts" -> physicalSourceAttempts,
    "StructuredPhysicalEligibility" -> structuredEligibility,
    "StructuredPhysicalSpace" -> structuredSpace, "StructuredPhysicalFit" -> structuredFit,
    "PreferredPoleFit" -> If[AssociationQ[physicalFit], KeyTake[physicalFit,
      {"Status", "ElapsedTime", "Diagnostics", "RefinementHistory", "ValidationReports"}], physicalFit],
    "PhysicalPoleFit" -> If[AssociationQ[physicalFit], KeyTake[physicalFit,
      {"Status", "ElapsedTime", "Diagnostics", "RefinementHistory", "ValidationReports"}], physicalFit],
    "MomentumConservationSpace" -> conservationSpace,
    "MomentumConservationFit" -> If[AssociationQ[conservationFit],KeyTake[conservationFit,
      {"Status","ElapsedTime","Diagnostics","RefinementHistory"}],conservationFit]|>];
  completionProgress[callback, enabled, <|"Stage" -> "Factorization " <> status,
    "Elapsed" -> report["ElapsedTime"], "Unknowns" -> If[ListQ[report["CorrectionBasis"]],
      Length[report["CorrectionBasis"]], Length[unknowns]]|>];
  If[ListQ[processNames], report = Join[report, <|"ExternalParticles" -> processNames|>]];
  (* Factorization can already pass while a discarded diagram-local shell
     remainder is still needed to restore the off-cut high-energy behavior.
     Keep the actual source differences available to the next stage. *)
  report = Join[report, <|"RemainderData" -> Lookup[normalized, "RemainderData", {}],
    "ChannelRemainderData" -> If[AssociationQ[channelPreparation],
      Lookup[channelPreparation, "RemainderData", {}], {}]|>];
  completionFormat[report, output, False]
]];
CompleteFactorization[___] := (Message[CompleteFactorization::args]; $Failed);

End[];
End[];


(* ::Section::Closed:: *)
(*Amplitude Preparation*)

Begin["ConstructiveDiagrams`"];

PrepareAmplitudes::usage = "PrepareAmplitudes[items, model] prepares diagram amplitude pairs or compact factorization-channel rows, preserving their input formats. Each element is prepared independently by ReduceSpinContractions, PolePreference replacement and ReduceSpinorProducts with physical propagators protected. AllSpurious compares eligible other-massless-particle references and uses a physical reference for any leg without one. AllPhysical compares momentum-insertion references giving physical poles outside that element's own cuts, and Mixed compares both types per external leg. Automatic compares admissible physical and spurious references and keeps the best completed trial. Cyclic and ReverseCyclic retain fixed reproducible spurious choices; Xi uses one common Xi0, IndependentXi one generic reference per external particle, and None retains input references. The best completed trial is ranked after ordinary spinor reduction and diagram-local numerator-shell reductions. MaxReferenceChoices -> Automatic resolves to a bounded 64-trial allowance; ReferenceTimeConstraint -> Automatic uses at most five seconds and one third of the remaining per-element TimeConstraint, shared with subsequent preparation. This is a bounded finite-reference search, not a global-minimum claim. ReturnDetails -> False is the default; True exposes inputs, assignments, tested alternatives, search limits, reductions and diagnostics. InternalOnShell -> True reduces known numerator scalar products using only that element's mass rules, including two-leg complements when MomentumConservation is True, before and after spinor reduction even at MaxSteps -> 0. False disables these internal-shell reductions and edits. Unknown invariants and denominators are not put on shell. A bounded improving identity search follows. Output -> \"Expression\" returns the prepared sum; \"Amplitudes\" preserves input formats; \"Details\" and ReturnDetails -> True request diagnostics. ReturnDetails takes precedence. Unavailable reference choices or an overall timeout remain PARTIAL. ProgressReporting, ProgressFunction, MaxSteps, MaxCandidates and MomentumConservation control preparation. No model vertices or factorization corrections are added.";
PrepareAmplitudes::args = "Expected diagram {massRules, expression} pairs or compact factorization-channel rows, a model, and valid preparation options. All elements must declare consistent external masses.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " Ordinary ReduceSpinorProducts acts on the whole expression, including auxiliary denominators, with PropDen protected. Only external mass replacements act globally; internal replacements remain numerator-only. With MomentumConservation -> True, the bounded identity search also tries consistent whole-numerator external momentum eliminations and composite complements. Each trial is reduced before a strictly improving whole-expression rank is required. These trials use only declared external mass labels, share MaxSteps, MaxCandidates and the per-element time limit, and protect inverse factors from conservation and internal-shell substitutions. MomentumConservation -> False disables them.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " Enabled internal numerator cuts also supply simultaneous linear scalar-product relations, including differences of adjacent cuts. External momentum-conservation equations enter only when enabled. Inconsistent exact constraints remain PARTIAL. Reference trials checkpoint completed factored reductions before optional whole-product exploration; an interrupted exploration is not marked exhaustive. Bounded reciprocal massless-reference choices are tried after the original first tuple without increasing the time or choice limits.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " Input elements are detected individually: diagram {massRules, expression} pairs or compact factorization rows {m1, ..., mn, Multiparticle[cut], exchangedMass, expression}. The default output preserves each input element's format and metadata. Factorization rows supply only external shells and their selected cut; other propagators do not introduce shell assumptions. Channel 1/z factors and sewing signs are unchanged. Cut-only reductions preserve the selected residue, not an off-cut identity. Details add InputType, ElementTypes, ItemReports and ChannelReports.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " An unavailable reference choice returns Failure for ordinary output, for diagrams and channels alike; detailed output retains PARTIAL expressions and diagnostics. With a single external photon, AllSpurious uses the same eligible physical references as AllPhysical.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " With a FeynmanModel, only diagram pairs are accepted. Raw Feynman tensors are converted to spinor products before reference replacement and reduction; FermionHelicities supplies the helicities of massless Dirac external fields. Feynman preparation defaults to ordinary reduction with effective MaxSteps -> 0 unless MaxSteps is supplied explicitly; eager identity-route generation for large chains is opt-in. Feynman preparation always keeps every internal numerator and denominator off shell, regardless of InternalOnShell, and returns external-only mass rules. Existing propagators supply a separate reference-choice inventory, never shell assumptions. All Feynman diagrams use the same reference assignment per external leg: Automatic uses a fixed massless-particle cycle, or independent generic Xi references when fewer than two massless particles are available. AllSpurious and cyclic choices are deterministic rather than optimized separately per diagram. AllSpurious falls back to a shared physical reference for each leg without a spurious choice. AllPhysical uses deterministic momentum-insertion references from the shared process pole inventory, preferring massive external targets; its reference poles may coincide with a diagram's existing propagators. Xi, IndependentXi and None retain their meanings. Shared Mixed Feynman choices remain unimplemented and PARTIAL. Failed or timed-out conversion, or an unavailable requested reference choice, remains PARTIAL in details and returns Failure for ordinary output.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " Detailed output also retains RemainderData for every item. It separates the fixed-reference reduction difference from reference-continuation choices and retains each completed reduction and identity-step remainder without expanding it. ShellRemainder is the exact algebraic difference between the selected fixed-reference expression and the returned prepared expression, not a claim of off-cut equality. ReferenceContinuations retain common-Xi and, when unambiguous, shared per-external-leg Xi source expressions before internal-shell reductions. These are proposed continuations requiring full-amplitude validation. Partial preparation and missing or ambiguous reference information remain explicit. Ordinary amplitude-pair and channel-row outputs stay unchanged; pass detailed preparation reports to completion to use the retained data.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " A single {massRules, expression} pair is also accepted directly and returns a single pair by default. A completed amplitude carries external mass rules only: preparation applies ordinary reductions and reference choices without any internal-shell condition. Its existing propagators provide a separate reference-choice inventory, never numerator shell assumptions. Output -> Expression still returns the bare expression; details retain one-item OriginalAmplitudes and PreparedAmplitudes lists for reuse by completion.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " ExternalParticles -> Automatic leaves unspecified particle identities uninferred. An ordered list of model particle or antiparticle names can be supplied to retain process information in detailed output for later completion. Its length and exact external masses must agree with every item. Ordinary amplitude pairs and channel rows are unchanged; no process cache or global model assignment is created.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " Completed external-only amplitudes also try bounded sparse physical-denominator grouping, spinor-coefficient collection, exact off-shell propagator definitions and single-insertion conservation followed by null-momentum splitting. These add no internal-shell conditions and remain enabled at MaxSteps -> 0. The best completed checkpoint is retained; representation size and weighted expanded complexity are compared separately. Ranking reuse is bounded and local to this call.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " Completed external amplitudes also compare bounded shared-momentum determinant identities and ordinary six-spinor cofactors within their existing denominator groups. Exact scalar collection and accepted identity witnesses remain in details; only a strictly simpler complete checkpoint is returned. All kinematic inverse factors remain fixed, and no internal shell is added.";
PrepareAmplitudes::usage = PrepareAmplitudes::usage <>
  " Parallelization -> Automatic prepares independent items on available local kernels; MaxKernels -> Automatic uses the available processor and license limit. Set Parallelization -> False or MaxKernels -> 1 for serial execution. Feynman references are fixed once for the complete input before dispatch. Results retain input order, progress callbacks run only on the main kernel, and detailed output includes execution and fallback diagnostics.";
PrepareDiagramAmplitudes::usage = "PrepareDiagramAmplitudes is a compatibility alias for PrepareAmplitudes. Use PrepareAmplitudes for both diagram amplitude pairs and compact factorization-channel rows.";

Options[PrepareAmplitudes] = {
  "PolePreference" -> Automatic,
  "ExternalParticles" -> Automatic,
  "FermionHelicities" -> {},
  "MaxReferenceChoices" -> Automatic, "ReferenceTimeConstraint" -> Automatic,
  "InternalOnShell" -> True, "MaxSteps" -> Automatic, "MaxCandidates" -> Automatic,
  "TimeConstraint" -> Automatic, "MomentumConservation" -> True,
  "Parallelization" -> Automatic, "MaxKernels" -> Automatic,
  "ProgressReporting" -> True, "ProgressFunction" -> Automatic,
  "ReturnDetails" -> False, "Output" -> "Amplitudes"};
Options[PrepareDiagramAmplitudes] = Options[PrepareAmplitudes];

Begin["ConstructiveDiagrams`Private`"];

preparationModelQ[model_] := ListQ[model] && Length[model] >= 2 &&
  ListQ[model[[1]]] && ListQ[model[[2]]] &&
  AllTrue[model[[1]], ListQ[#] && Length[#] >= 6 &&
    StringQ[#[[2]]] && StringQ[#[[3]]] &];

(* Particle identity is process data. Equal masses alone cannot identify a
   species, charge state or helicity, so retain only an explicit ordered list. *)
preparationExternalParticleNames[requested_, rules_List, model_List] := Module[
  {external, expected, masses},
  If[requested === Automatic, Return[Missing["ExternalParticlesNotSpecified"]]];
  external = Sort[Cases[rules, HoldPattern[Mass[leg_Integer] -> _] :> leg]];
  If[!ListQ[requested] || !AllTrue[requested, StringQ] ||
      Length[requested] =!= Length[external] || external =!= Range[Length[requested]],
    Return[Failure["InvalidExternalParticles", <|"MessageTemplate" ->
      "ExternalParticles must be an ordered list of model particle names, one for each declared external leg."|>]]];
  expected = physicalParticleMass[#, model[[1]]] & /@ requested;
  If[AnyTrue[expected, MissingQ], Return[Failure["UnknownExternalParticle", <|
    "MessageTemplate" -> "An ExternalParticles name is absent or ambiguous in the supplied model."|>]]];
  masses = (Mass /@ external) /. rules;
  If[!And @@ MapThread[residueExactZero[#1 - #2] &, {masses, expected}],
    Return[Failure["InconsistentExternalParticleMasses", <|"MessageTemplate" ->
      "ExternalParticles and the supplied amplitude's external mass rules disagree."|>]]];
  requested
];

preparationPairQ[pair_] := MatchQ[pair, {_List, _}] &&
  residueFiniteQ[Last[pair]] && AllTrue[First[pair],
    MatchQ[#, HoldPattern[Mass[_Integer | Multiparticle[__Integer]] -> _]] &&
      residueFiniteQ[Last[#]] &];

preparationChannelQ[row_] := Module[{n, cut},
  If[!ListQ[row] || Length[row] < 7 || !MatchQ[row[[-3]], Multiparticle[__Integer]], Return[False]];
  n = Length[row] - 3; cut = List @@ row[[-3]];
  residueFiniteQ[row] && DuplicateFreeQ[cut] && 2 <= Length[cut] <= n - 2 &&
    AllTrue[cut, 1 <= # <= n &] &&
    AllTrue[Join[Take[row, n], {row[[-2]]}], FreeQ[#,
      _List | _Rule | _RuleDelayed | _Multiparticle | _Mom | _Spinor | _SpinorChain | _PropDen] &]
];

preparationInputType[item_] := Which[
  preparationPairQ[item], "Diagram",
  preparationChannelQ[item], "FactorizationChannel",
  True, $Failed];

preparationInputPair[item_, "Diagram"] := item;
preparationInputPair[item_, "Amplitude"] := item;
preparationInputPair[row_, "FactorizationChannel"] := {
  Join[Thread[(Mass /@ Range[Length[row] - 3]) -> Drop[row, -3]],
    {Mass[row[[-3]]] -> row[[-2]]}], row[[-1]]};

preparationOutputItem[item_, "Diagram", expression_] := {First[item], expression};
preparationOutputItem[item_, "Amplitude", expression_] := {First[item], expression};
preparationOutputItem[item_, "FeynmanDiagram", expression_] := {
  feynmanExternalMassRules[First[item]], expression};
preparationOutputItem[row_, "FactorizationChannel", expression_] := ReplacePart[row, -1 -> expression];

(* This inventory controls references only, not numerator shell reductions. *)
preparationFeynmanReferencePairs[pairs_List] := Map[Function[pair,
  With[{external = Cases[First[pair], HoldPattern[Mass[i_Integer] -> _] :> i]},
    {Join[First[pair], (Mass[Multiparticle @@ First[#]] -> Last[#] &) /@
      DeleteDuplicates[DeleteMissing[residuePropagatorKey[#, external] & /@
        Cases[Last[pair], _PropDen, {0, Infinity}]]]], Last[pair]}]], pairs];

(* Resolve the common Feynman gauge choice on the main kernel. Only the
   external reference brackets are needed, not the full tensor conversion.
   The forced per-leg choices are reused in every independently prepared item. *)
preparationSharedReferenceAssignments[pairs_List, model_List, inventory_List, requested_,
    wholeAmplitude_ : False] := Module[{legs, references, probe, report, rules},
  If[pairs === {} || TrueQ[wholeAmplitude] || MemberQ[{None, "Xi"}, requested],
    Return[<|"Status" -> "COMPLETE", "Assignments" -> {}, "Diagnostics" -> {}|>]];
  legs = DeleteDuplicates[Join[
    Cases[pairs, HoldPattern[ConstructiveDiagrams`PolarizationVector[leg_Integer, _, 0, helicity : (1 | -1)]] :>
      {leg, If[helicity === 1, "Angle", "Square"]}, Infinity],
    Flatten[Cases[pairs,
      HoldPattern[Power[chain_SpinorChain, power_?NumericQ]] /; TrueQ[power < 0] :>
        Module[{parts = List @@ chain, xi, physical},
          If[Length[parts] =!= 2 || Count[parts, Spinor["Xi", ___]] =!= 1, Return[{}]];
          xi = SelectFirst[parts, MatchQ[#, Spinor["Xi", ___]] &];
          physical = SelectFirst[parts, !MatchQ[#, Spinor["Xi", ___]] &];
          If[!MatchQ[physical, _Spinor] || spinorType[physical] =!= xi[[2]] ||
              !IntegerQ[spinorLeg[physical]], {}, {{spinorLeg[physical], xi[[2]]}}]],
      Infinity], 1]]];
  If[legs === {}, Return[<|"Status" -> "COMPLETE", "Assignments" -> {}, "Diagnostics" -> {}|>]];
  rules = First[First[pairs]];
  references = (SpinorChain[Spinor["Xi", #[[2]], #[[1]]],
    Spinor["Helicity", #[[2]], #[[1]]]]^-1 &) /@ Sort[legs];
  probe = Times @@ references;
  report = preparationReferences[probe, rules, model, inventory, requested, {}, True];
  <|"Status" -> report["Status"],
    "Assignments" -> DeleteDuplicatesBy[
      KeyTake[#, {"Leg", "Mode", "Target"}] & /@ Lookup[report, "Assignments", {}],
      Lookup[#, "Leg", None] &], "Diagnostics" -> Lookup[report, "Diagnostics", {}]|>
];

preparationMassKey[Mass[Multiparticle[legs__Integer]]] := Mass[Multiparticle @@ Sort[{legs}]];
preparationMassKey[key_] := key;

preparationMassRulesConsistentQ[rules_List] := AllTrue[
  GatherBy[rules, preparationMassKey[First[#]] &], Function[group,
    AllTrue[Rest[group], residueExactZero[Last[#] - Last[First[group]]] &]]];

preparationCanonicalMassRules[rules_List] := DeleteDuplicatesBy[
  (preparationMassKey[First[#]] -> Last[#] & /@ rules), First];

preparationExternalRulesAgreeQ[first_List, second_List] := Module[{left, right},
  left = SortBy[first, First[#][[1]] &]; right = SortBy[second, First[#][[1]] &];
  (First /@ left) === (First /@ right) &&
    AllTrue[MapThread[Subtract, {Last /@ left, Last /@ right}], residueExactZero]
];

preparationExternalRules[rules_List] := Select[rules,
  MatchQ[#, HoldPattern[Mass[_Integer] -> _]] &];

preparationProtectedDenominators[expr_, function_] := withProtectedPropagators[expr,
  Function[body, Module[{denominators, tokens},
    denominators = DeleteDuplicates[Cases[{body},
      denominator : Power[_, exponent_] /; !TrueQ[exponent >= 0], Infinity]];
    tokens = Table[Unique["preparationDenominator"], {Length[denominators]}];
    function[body /. Thread[denominators -> tokens]] /. Thread[tokens -> denominators]
  ]]];

preparationNumerators[expr_, function_] := withProtectedPropagators[expr,
  Function[protected, Total[Function[term,
      preparationProtectedDenominators[Numerator[term], function]/Denominator[term]] /@
    If[Head[protected] === Plus, List @@ protected, {protected}]]]];

(* Relabeling can change the order of a composite mass emitted by a contraction.
   Canonicalize known lookup keys only; unknown masses retain their literal form. *)
preparationReplaceMasses[expr_, rules_List] := Module[
  {known = Association[preparationCanonicalMassRules[rules]]},
  expr /. mass_Mass :> Lookup[known, preparationMassKey[mass], mass]
];

(* Ordinary spinor algebra also acts on auxiliary denominators. Only external
   mass replacements are global; diagram-local replacements stay in numerators. *)
preparationSpinorProducts[expr_, rules_List] := Module[
  {external = preparationExternalRules[rules], ordinary, candidate},
  ordinary = preparationNumerators[expr, Function[num, preparationReplaceMasses[num, rules]]];
  (* The public reducer protects its own propagators and needs to see the
     rational amplitude structure when choosing its factored competitor. *)
  ordinary = ReduceSpinorProducts[ordinary];
  ordinary = withProtectedPropagators[ordinary,
    Function[body, preparationNumerators[body,
      Function[num, preparationReplaceMasses[num, rules]]] /. external]];
  (* Model-local external masses can license an ordinary sum contraction after
     normalization. Compare complete expressions with every inverse held opaque. *)
  candidate = preparationProtectedDenominators[ordinary,
    Function[rspMassiveSchoutenSums[#, external]]];
  If[candidate === ordinary, Return[ordinary]];
  If[candidate =!= ordinary && residueFiniteQ[candidate],
    candidate = preparationProtectedDenominators[candidate, rspCommonScalarContent]];
  If[residueFiniteQ[candidate] &&
      preparationBetterQ[preparationRank[candidate], preparationRank[ordinary]], candidate, ordinary]
];

(* Total momentum conservation is added only here, with the caller's declared
   external legs. Every inverse factor and complete propagator product stays fixed. *)
preparationMultilinearIdentityNormalize[expression_, externalRules_List,
    conserve_ : True, seconds_ : 12] := Module[
  {started = AbsoluteTime[], best, outcome, body, terms, groups, keys, numerators,
   cache = <||>, route = {}, key, signature, records, space, system, mcRows, legs,
   ang, sq, left, right, remainingAngle, remainingSquare, row, result, candidate,
   available, working, rank, i, normalizeKey},
  best = <|"Amplitude" -> expression, "Status" -> "UNCHANGED", "Route" -> {}|>;
  If[!TrueQ[seconds > 0] || LeafCount[expression] > 160000 ||
      rspSandwichExpansionCount[expression] > 4096 ||
      !preparationScalarExternalRulesQ[externalRules] ||
      FreeQ[expression, chain_SpinorChain /; Length[chain] === 3] ||
      !FreeQ[expression, _SpinorTrace | _SpinorHat | _MomHat | _MomQ | _sigma |
        _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace | _Dot | _NonCommutativeMultiply], Return[best]];
  available[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  key[term_] := Times @@ Select[If[Head[term] === Times, List @@ term, {term}],
    MatchQ[#, Power[_PropDen, n_Integer?Negative]] &];
  normalizeKey[value_] := With[{spinors = Sort[DeleteDuplicates[
      If[rspSpinorType[#] === "Angle", #, rspFlipSpinor[#]] & /@
        Cases[value, _Spinor, Infinity]]]}, HoldComplete[spinors]];
  outcome = TimeConstrained[MemoryConstrained[
    body = withProtectedPropagators[expression, Expand];
    terms = If[Head[body] === Plus, List @@ body, {body}];
    groups = GroupBy[terms, key];
    If[Length[groups] > 64, Return[best]];
    keys = Keys[groups]; numerators = MapThread[Expand[Total[#1]/#2] &,
      {Values[groups], keys}];
    Do[If[LeafCount[numerators[[i]]] > 3500 ||
        rspSandwichExpansionCount[numerators[[i]]] > 128, Continue[]];
      signature = normalizeKey[numerators[[i]]];
      system = Lookup[cache, signature, Missing["NotBuilt"]];
      If[!KeyExistsQ[cache, signature],
        space = rspMultilinearIdentitySpace[numerators[[i]], externalRules];
        If[MissingQ[space], Continue[]];
        mcRows = {};
        If[TrueQ[conserve], records = space["Records"]; legs = space["ExternalLegs"];
          Do[sq = Complement[Range[6], ang];
            Do[remainingAngle = Complement[ang, {left}]; remainingSquare = Complement[sq, {right}];
              row = SpinorChain @@ records[[remainingAngle]];
              row *= SpinorChain @@ (rspFlipSpinor /@ records[[remainingSquare]]);
              row *= Total[SpinorChain[records[[left]], Mom[#], rspFlipSpinor[records[[right]]]] & /@ legs];
              AppendTo[mcRows, space["ToFormal"][row]], {left, ang}, {right, sq}],
            {ang, Subsets[Range[6], {3}]}]];
        system = rspIdentityPrepareSystem[space, mcRows];
        (* Eligibility failures can depend on this numerator, so only cache a
           successfully built system for other pole groups with these records. *)
        If[AssociationQ[system], AssociateTo[cache, signature -> system]]];
      If[!AssociationQ[system], Continue[]];
      result = rspOptimizeIdentitySpace[numerators[[i]], system, Min[2, available[]]];
      If[result["Status"] =!= "IMPROVED", Continue[]];
      working = ReplacePart[numerators, i -> result["Amplitude"]];
      candidate = Total[keys working];
      If[!residueFiniteQ[candidate] ||
          !preparationBetterQ[preparationRank[candidate], preparationRank[best["Amplitude"]]], Continue[]];
      numerators = working;
      AppendTo[route, <|"Operation" -> "OrdinarySparseIdentityNormalization",
        "Denominator" -> keys[[i]], "MomentumConservation" -> TrueQ[conserve],
        "InternalOnShellIdentity" -> False, "ExactFormalReplay" -> True,
        "IdentityCounts" -> result["IdentityCounts"], "Certificate" -> result["Certificate"]|>];
      best = <|"Amplitude" -> candidate, "Status" -> "IMPROVED", "Route" -> route|>,
      {i, Length[numerators]}]; best, 512000000, best], seconds, best];
  Join[best, <|"ElapsedTime" -> AbsoluteTime[] - started,
    "TimedOut" -> (AbsoluteTime[] - started >= seconds)|>]
];

(* Peel at most two actual positive chain factors before using the audited
   six-slot ordinary identity space. Keep each existing fraction intact. *)
preparationPairedLiteralSpectators[expression_, externalRules_List,
    conserve_ : True, seconds_ : 12] := Module[
  {started = AbsoluteTime[], best, available, slotDegree, inverseQ, positiveChains,
   record, slotCounts, parts, sumPosition, outer, fractions, chosen, fractionParts,
   inverse, numerator, monomials, pairs, witnesses, firstWitness, secondWitness,
   core, coreTerms, records, space, normalized, coordinates, scalar, identitySum,
   liftedResidual, literalResidual, reconstructionResidual, proposal, proposalFractions, candidate, rank,
   eligible = 0, inspected = 0, maximumEligible = 24, maximumFractions = 96,
   route = {}, pair, index, outcome},
  best = <|"Amplitude" -> expression, "Status" -> "UNCHANGED", "Route" -> {}|>;
  slotDegree[_SpinorChain] := 2;
  slotDegree[value_Plus] := Max[slotDegree /@ List @@ value];
  slotDegree[value_Times] := Total[slotDegree /@ List @@ value];
  slotDegree[Power[base_, exponent_Integer?Positive]] := exponent slotDegree[base];
  slotDegree[_] := 0;
  If[!TrueQ[NumericQ[seconds] && seconds > 0] || LeafCount[expression] > 160000 ||
      FreeQ[expression, _Plus] || slotDegree[expression] < 10 ||
      rspSandwichExpansionCount[expression] > 4096 ||
      !preparationScalarExternalRulesQ[externalRules] ||
      !FreeQ[expression, _SpinorTrace | _SpinorHat | _MomHat | _MomQ |
        _SpinorZ | _SpinorEps | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace |
        _Dot | _NonCommutativeMultiply] ||
      !FreeQ[expression, Power[_, exponent_] /;
        !TrueQ[exponent >= 0] && !IntegerQ[exponent]], Return[best]];
  available[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  inverseQ[value_] := MatchQ[value, Power[_, exponent_] /; !TrueQ[exponent >= 0]];
  positiveChains[term_] := Flatten[Map[Which[
      Head[#] === SpinorChain, {#},
      MatchQ[#, Power[_SpinorChain, _Integer?Positive]],
        ConstantArray[First[#], Min[2, Last[#]]], True, {}] &,
    If[Head[term] === Times, List @@ term, {term}]], 1];
  record[spinor_] := If[rspSpinorType[spinor] === "Angle", spinor, rspFlipSpinor[spinor]];
  slotCounts[value_] := Counts[record /@ Cases[value, _Spinor, Infinity]];
  outcome = TimeConstrained[MemoryConstrained[
    parts = If[Head[expression] === Times, List @@ expression, {expression}];
    sumPosition = SelectFirst[Range[Length[parts]], Head[parts[[#]]] === Plus &,
      Missing["NoSingleOuterSum"]];
    Which[Head[expression] === Plus, outer = 1; fractions = List @@ expression,
      Count[parts, _Plus] === 1 && !MissingQ[sumPosition] &&
          FreeQ[Times @@ Delete[parts, sumPosition], _SpinorChain | _Mom | _MomProd],
        outer = Times @@ Delete[parts, sumPosition]; fractions = List @@ parts[[sumPosition]],
      True, outer = 1; fractions = {expression}];
    If[Length[fractions] > maximumFractions, Return[best]];
    chosen = fractions;
    Do[
      If[eligible >= maximumEligible, Break[]];
      fractionParts = If[Head[chosen[[index]]] === Times, List @@ chosen[[index]], {chosen[[index]]}];
      inverse = Times @@ Select[fractionParts, inverseQ];
      numerator = Times @@ Select[fractionParts, !inverseQ[#] &];
      If[LeafCount[numerator] > 6000 || FreeQ[numerator, _Plus] ||
          rspSandwichExpansionCount[numerator] > 128 ||
          !rspExpansionBudgetQ[numerator], Continue[]];
      monomials = With[{expanded = Expand[numerator]},
        If[Head[expanded] === Plus, List @@ expanded, {expanded}]];
      If[Length[monomials] > 128, Continue[]];
      pairs = DeleteDuplicates[Flatten[(Subsets[positiveChains[#], {2}] & /@ monomials), 1]];
      pairs = SortBy[pairs, LeafCount];
      Do[
        If[eligible >= maximumEligible, Break[]];
        inspected++;
        witnesses = Select[Map[Function[term,
          firstWitness = rspLiteralFactorCofactor[term, pair[[1]]];
          If[!AssociationQ[firstWitness], Return[Missing["NoFirstLiteralFactor"]]];
          secondWitness = rspLiteralFactorCofactor[firstWitness["Cofactor"], pair[[2]]];
          If[!AssociationQ[secondWitness], Return[Missing["NoSecondLiteralFactor"]]];
          <|"Term" -> term, "Cofactor" -> secondWitness["Cofactor"],
            "Witnesses" -> {firstWitness, secondWitness}|>], monomials], AssociationQ];
        If[Length[witnesses] < 2, Continue[]];
        core = Expand[Total[Lookup[witnesses, "Cofactor"]]];
        records = DeleteDuplicates[record /@ Cases[core, _Spinor, Infinity]];
        If[Length[records] =!= 6 || Length[DeleteDuplicates[rspSpinorLeg /@ records]] =!= 6,
          Continue[]];
        coreTerms = If[Head[core] === Plus, List @@ core, {core}];
        If[!AllTrue[coreTerms, Sort[Values[slotCounts[#]]] === ConstantArray[1, 6] &], Continue[]];
        space = rspMultilinearIdentitySpace[core, externalRules];
        If[!AssociationQ[space], Continue[]];
        eligible++;
        normalized = preparationMultilinearIdentityNormalize[core, externalRules,
          conserve, Min[1.5, available[]]];
        If[Lookup[normalized, "Status", "UNCHANGED"] =!= "IMPROVED", Continue[]];
        coordinates = space["Coordinates"][space["ToFormal"][core]];
        If[!AssociationQ[coordinates], Continue[]];
        scalar = coordinates["Scalar"];
        identitySum = Total[Map[Function[entry, With[{certificate = entry["Certificate"]},
          Total[MapThread[Times, {certificate["Coefficients"],
            certificate["OrdinaryIdentities"]}]]]], normalized["Route"]]];
        literalResidual = Expand[Total[Lookup[witnesses, "Term"]] - (Times @@ pair) core];
        liftedResidual = Expand[space["ToFormal"][normalized["Amplitude"] - core - scalar identitySum]];
        If[literalResidual =!= 0 || liftedResidual =!= 0, Continue[]];
        proposal = rspLocalFactorContent[Expand[numerator - Total[Lookup[witnesses, "Term"]] +
          (Times @@ pair) normalized["Amplitude"]]];
        reconstructionResidual = Expand[proposal - numerator -
          (Times @@ pair) (normalized["Amplitude"] - core)];
        If[reconstructionResidual =!= 0, Continue[]];
        proposalFractions = ReplacePart[chosen, index -> inverse proposal];
        candidate = outer Total[proposalFractions];
        If[!residueFiniteQ[candidate], Continue[]];
        rank = preparationRank[candidate];
        If[!preparationBetterQ[rank, preparationRank[best["Amplitude"]]], Continue[]];
        chosen = proposalFractions;
        AppendTo[route, <|"Operation" -> "PairedLiteralSpectatorOrdinaryIdentities",
          "Fraction" -> index, "InverseFactors" -> inverse, "OuterFactor" -> outer,
          "SpectatorFactors" -> pair, "LiteralFactorWitnesses" -> witnesses,
          "CoefficientScalar" -> scalar, "CoefficientRoute" -> normalized["Route"],
          "BeforeCoefficient" -> core, "AfterCoefficient" -> normalized["Amplitude"],
          "BeforeNumerator" -> numerator, "AfterNumerator" -> proposal,
          "ExactLiteralResidual" -> literalResidual, "ExactLiftedResidual" -> liftedResidual,
          "ExactNumeratorReconstructionResidual" -> reconstructionResidual,
          "ExactFormalReplay" -> True, "InternalOnShellIdentity" -> False,
          "MomentumConservation" -> TrueQ[conserve]|>];
        best = <|"Amplitude" -> candidate, "Status" -> "IMPROVED", "Route" -> route|>;
        Break[], {pair, pairs}],
      {index, Length[chosen]}]; True, 512000000, False], seconds, False];
  Join[best, <|"ElapsedTime" -> AbsoluteTime[] - started,
    "EligibleCores" -> eligible, "InspectedLiteralPairs" -> inspected,
    "TimedOut" -> !TrueQ[outcome]|>]
];

(* Compare complete numerator groups after a determinant-pair proposal exposes
   ordinary six-spinor cofactors. No propagator or inverse factor is changed. *)
preparationSharedMatrixCofactors[expression_, externalRules_List,
    conserve_ : True, seconds_ : 20] := Module[
  {started = AbsoluteTime[], best, available, body, terms, key, positive,
   groups, keys, numerators, workingNumerators, originalNumerator, expandedNumerator, working,
   pairs, factors, chains, positions, pair, rest, changed, matrixRoute,
   endpointCounts, endpointRecord, spectatorPriority, scalarPrefix, scalarCore, scalarFactors, inverseQ, records, slotDegree,
   spectators, witnesses, coefficient, remainder, reduced, normalized, result,
   candidateCoefficient, candidate, factorTrial, cofactorRoute, acceptedRoute = {},
   outcome, i, selected, position, beforeFactor, ruleRecord, pairedCandidate},
  best = <|"Amplitude" -> expression, "Status" -> "UNCHANGED", "Route" -> {}|>;
  slotDegree[_SpinorChain] := 2;
  slotDegree[value_Plus] := Max[slotDegree /@ List @@ value];
  slotDegree[value_Times] := Total[slotDegree /@ List @@ value];
  slotDegree[Power[base_, exponent_Integer?Positive]] := exponent slotDegree[base];
  slotDegree[_] := 0;
  If[!TrueQ[seconds > 0] || LeafCount[expression] > 160000 ||
      rspSandwichExpansionCount[expression] > 4096 ||
      !preparationScalarExternalRulesQ[externalRules] ||
      (slotDegree[expression] < 8 &&
        FreeQ[expression, chain_SpinorChain /; Length[chain] === 4 && First[chain] === Last[chain]]) ||
      !FreeQ[expression, _SpinorTrace | _SpinorHat | _MomHat | _MomQ |
        _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace | _Dot | _NonCommutativeMultiply], Return[best]];
  available[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  pairedCandidate = preparationPairedLiteralSpectators[expression, externalRules,
    conserve, Min[12, 2 available[]/3]];
  If[Lookup[pairedCandidate, "Status", "UNCHANGED"] === "IMPROVED" &&
      preparationBetterQ[preparationRank[pairedCandidate["Amplitude"]], preparationRank[best["Amplitude"]]],
    best = pairedCandidate];
  inverseQ[value_] := MatchQ[value, Power[_, exponent_] /; !TrueQ[exponent >= 0]];
  key[term_] := Times @@ Select[If[Head[term] === Times, List @@ term, {term}], inverseQ];
  positive[term_] := Times @@ Select[If[Head[term] === Times, List @@ term, {term}], !inverseQ[#] &];
  outcome = TimeConstrained[MemoryConstrained[
    body = withProtectedPropagators[expression, Expand];
    terms = If[Head[body] === Plus, List @@ body, {body}];
    groups = GroupBy[terms, key];
    If[Length[groups] > 192, Return[best]];
    keys = Keys[groups]; numerators = Total[positive /@ #] & /@ Values[groups];
    Do[
      factorTrial = TimeConstrained[rspLocalFactorContent[numerators[[i]]],
        Min[0.05, available[]], numerators[[i]]];
      If[residueFiniteQ[factorTrial] &&
          preparationBetterQ[preparationRank[factorTrial], preparationRank[numerators[[i]]]] &&
          TrueQ[Expand[factorTrial - numerators[[i]]] === 0],
        AppendTo[acceptedRoute, <|"Operation" -> "OrdinaryNumeratorScalarFactorCollection",
          "Denominator" -> keys[[i]], "Before" -> numerators[[i]], "After" -> factorTrial,
          "ExactFormalReplay" -> True, "InternalOnShellIdentity" -> False|>];
        numerators[[i]] = factorTrial], {i, Length[numerators]}];
    candidate = Total[keys numerators];
    If[preparationBetterQ[preparationRank[candidate], preparationRank[best["Amplitude"]]],
      best = <|"Amplitude" -> candidate, "Status" -> "IMPROVED", "Route" -> acceptedRoute|>];
    Do[
      originalNumerator = numerators[[i]];
      expandedNumerator = Expand[originalNumerator];
      If[LeafCount[originalNumerator] > 6000 ||
          rspSandwichExpansionCount[originalNumerator] > 256, Continue[]];
      matrixRoute = {}; cofactorRoute = {};
      changed = Table[
        factors = If[Head[term] === Times, List @@ term, {term}];
        chains = Map[Which[Head[#] === SpinorChain, {#, 1},
          MatchQ[#, Power[_SpinorChain, _Integer?Positive]], {First[#], Last[#]},
          True, Missing["NotPositiveChain"]] &, factors];
        positions = Select[Range[Length[chains]], ListQ[chains[[#]]] &];
        pair = Missing["NoPair"];
        Do[pair = rspSharedDiagonalPair[chains[[selected[[1]], 1]],
            chains[[selected[[2]], 1]], externalRules];
          If[AssociationQ[pair], position = selected; Break[]],
          {selected, Subsets[positions, {2}]}];
        If[!AssociationQ[pair], term,
          rest = factors;
          Do[rest[[position[[j]]]] = If[chains[[position[[j]], 2]] === 1, 1,
            chains[[position[[j]], 1]]^(chains[[position[[j]], 2]] - 1)], {j, 2}];
          rest = Times @@ rest;
          AppendTo[matrixRoute, Join[KeyDrop[pair, "Amplitude"],
            <|"Replacement" -> pair["Amplitude"], "Spectator" -> rest,
              "BeforeMonomial" -> term, "AfterMonomial" -> rest pair["Amplitude"]|>]];
          rest pair["Amplitude"]],
        {term, If[Head[expandedNumerator] === Plus, List @@ expandedNumerator, {expandedNumerator}]}];
      working = Expand[Total[changed]];
      spectators = DeleteDuplicates[Cases[working, chain_SpinorChain /;
        MemberQ[{3, 5}, Length[chain]] :> chain, Infinity]];
      endpointRecord[spinor_] := If[rspSpinorType[spinor] === "Angle", spinor, rspFlipSpinor[spinor]];
      endpointCounts = Counts[endpointRecord /@ Cases[working, _Spinor, Infinity]];
      spectatorPriority[chain_] := {Length[chain],
        Lookup[endpointCounts, endpointRecord[First[chain]], 0]
          Lookup[endpointCounts, endpointRecord[Last[chain]], 0]};
      spectators = Reverse[SortBy[spectators, spectatorPriority]];
      Do[
        witnesses = Select[rspLiteralFactorCofactor[#, spectator] & /@
          If[Head[working] === Plus, List @@ working, {working}], AssociationQ];
        If[witnesses === {}, Continue[]];
        coefficient = Expand[Total[Lookup[witnesses, "Cofactor"]]];
        records = DeleteDuplicates[If[rspSpinorType[#] === "Angle", #, rspFlipSpinor[#]] & /@
          Cases[coefficient, _Spinor, Infinity]];
        If[Length[records] =!= 6 || Length[DeleteDuplicates[rspSpinorLeg /@ records]] =!= 6, Continue[]];
        remainder = working - Total[Lookup[witnesses, "Term"]];
        reduced = TimeConstrained[preparationSpinorProducts[coefficient, externalRules],
          Min[0.5, available[]], coefficient];
        candidateCoefficient = reduced;
        ruleRecord = <|"Operation" -> "OrdinaryExternalSpinorProducts",
          "Before" -> coefficient, "After" -> reduced|>;
        scalarCore = TimeConstrained[rspLocalFactorContent[reduced], Min[0.15, available[]], reduced];
        scalarFactors = If[Head[scalarCore] === Times, List @@ scalarCore, {scalarCore}];
        scalarPrefix = Times @@ Select[scalarFactors, rspScalarQ];
        scalarCore = Times @@ Select[scalarFactors, !rspScalarQ[#] &];
        normalized = preparationMultilinearIdentityNormalize[scalarCore, externalRules,
          conserve, Min[2, available[]]];
        If[Lookup[normalized, "Status", "UNCHANGED"] === "IMPROVED",
          candidateCoefficient = scalarPrefix normalized["Amplitude"];
          ruleRecord = <|"Operation" -> "OrdinaryExternalSpinorAndSparseIdentity",
            "Before" -> coefficient, "Reduced" -> reduced,
            "ScalarPrefactor" -> scalarPrefix, "IdentityRoute" -> normalized["Route"]|>];
        candidate = Expand[remainder + spectator candidateCoefficient];
        If[residueFiniteQ[candidate] &&
            preparationBetterQ[preparationRank[candidate], preparationRank[working]],
          working = candidate;
          AppendTo[cofactorRoute, <|"Spectator" -> spectator,
            "LiteralFactorWitnesses" -> witnesses, "CoefficientRoute" -> ruleRecord|>]],
        {spectator, Take[spectators, UpTo[12]]}];
      beforeFactor = working;
      factorTrial = TimeConstrained[rspLocalFactorContent[working], Min[0.15, available[]], working];
      If[residueFiniteQ[factorTrial] &&
          preparationBetterQ[preparationRank[factorTrial], preparationRank[working]] &&
          TrueQ[Expand[factorTrial - working] === 0], working = factorTrial];
      If[!preparationBetterQ[preparationRank[working], preparationRank[originalNumerator]], Continue[]];
      workingNumerators = ReplacePart[numerators, i -> working];
      candidate = Total[keys workingNumerators];
      If[!residueFiniteQ[candidate], Continue[]];
      numerators = workingNumerators;
      AppendTo[acceptedRoute, <|"Operation" -> "SharedMatrixOrdinaryCofactors",
        "Denominator" -> keys[[i]], "MatrixIdentityRoute" -> matrixRoute,
        "CofactorRoute" -> cofactorRoute, "FactoredNumerator" -> working,
        "BeforeFactor" -> beforeFactor, "InternalOnShellIdentity" -> False,
        "MomentumConservation" -> TrueQ[conserve], "ExactLiteralFactorization" -> True|>];
      If[preparationBetterQ[preparationRank[candidate], preparationRank[best["Amplitude"]]],
        best = <|"Amplitude" -> candidate, "Status" -> "IMPROVED", "Route" -> acceptedRoute|>],
      {i, Reverse[SortBy[Range[Length[numerators]], LeafCount[numerators[[#]]] &]]}];
    best, 512000000, best], available[], best];
  Join[best, <|"ElapsedTime" -> AbsoluteTime[] - started,
    "TimedOut" -> (AbsoluteTime[] - started >= seconds)|>]
];

(* Reduce complete factors without expanding or mixing their surrounding
   product. The ordinary whole-product reducer remains a competing route. *)
preparationFactorizedSpinorProducts[expr_, rules_List] := withProtectedPropagators[
  preparationNumerators[expr, Function[num, preparationReplaceMasses[num, rules]]],
  Function[body, preparationNumerators[body /. {
      chain_SpinorChain :> ReduceSpinorProducts[chain],
      trace_SpinorTrace :> ReduceSpinorProducts[trace]},
    Function[num, preparationReplaceMasses[num, rules]]] /. preparationExternalRules[rules]]];

preparationFactorizedReferenceTrial[expr_, rules_List, dotRules_List,
    auxiliary_List, contractPairs_] := Module[{body},
  body = preparationFactorizedSpinorProducts[preparationReduceDots[expr, dotRules], rules];
  If[TrueQ[contractPairs],
    body = withProtectedPropagators[body, rspSandwichProducts];
    body = preparationFactorizedSpinorProducts[preparationReduceDots[body, dotRules], rules]];
  preparationCancelReferencePoles[preparationReduceDots[body, dotRules], rules, auxiliary]
];

(* External mass rules license rank-one momentum factors even when no helicity
   spinor witnessing that leg is visible. Splitting protects inverse factors;
   ordinary external-spinor normalization retains its existing inverse scope. *)
preparationMasslessMomentumTrial[expr_, rules_List, dotRules_List, auxiliary_List,
    better_ : (preparationBetterQ[preparationRank[#1], preparationRank[#2]] &)] := Module[
  {massless, split, body, best, expanded, changed, count = 0,
   splitTag = Unique["masslessMomentumSplit"]},
  massless = Cases[Select[preparationExternalRules[rules], residueExactZero[Last[#]] &],
    HoldPattern[Mass[leg_Integer] -> _] :> leg];
  If[massless === {}, Return[expr]];
  If[FreeQ[preparationProtectedDenominators[expr,
      Function[value, Cases[{value}, _SpinorChain, Infinity]]],
      Mom[label_] /; Intersection[massless, momentumMembers[label]] =!= {}], Return[expr]];
  body = preparationFactorizedSpinorProducts[expr, rules];
  split[chain_] := Module[{value}, Catch[
    Do[value = rspSplitMasslessMomentum[chain, leg];
      If[!MissingQ[value], changed = True; count++; Throw[value, splitTag]], {leg, massless}];
    chain, splitTag]];
  Do[
    changed = False;
    body = preparationNumerators[body, Function[num, num /. chain_SpinorChain :> split[chain]]];
    If[!changed, Break[]], {32}];
  If[count === 0, Return[expr]];
  body = preparationFactorizedSpinorProducts[body, rules];
  best = preparationCancelReferencePoles[preparationReduceDots[body, dotRules], rules, auxiliary];
  If[rspSandwichExpansionCount[best] <= 4096,
    (* Distribute around opaque inverses before pairing; whole-product legacy
       Schouten rules can otherwise hide the reducing bracket contraction. *)
    expanded = preparationProtectedDenominators[best, Expand];
    expanded = withProtectedPropagators[expanded, rspSandwichProducts];
    expanded = preparationReduceDots[preparationFactorizedSpinorProducts[expanded, rules], dotRules];
    If[rspSandwichExpansionCount[expanded] <= 4096,
      expanded = preparationCancelReferencePoles[
        preparationProtectedDenominators[expanded, Expand], rules, auxiliary];
      If[residueFiniteQ[expanded] &&
          TrueQ[better[expanded, best]], best = expanded]]];
  best
];

preparationDotRules[rules_List, conserve_] := Module[
  {channels = knownInternalChannels[rules], external = externalIndices[rules],
   pairs, complement, replacements, masses, value},
  pairs = Select[channels, Length[First[#]] === 2 &];
  If[TrueQ[conserve], Do[
    complement = Complement[external, First[channel]];
    If[ContainsAll[external, First[channel]] && Length[complement] === 2,
      AppendTo[pairs, {complement, Last[channel]}]], {channel, channels}]];
  replacements = Table[
    masses = massValue[rules, #] & /@ First[pair];
    If[AnyTrue[masses, MissingQ], Nothing,
      value = ((Last[pair]^2 - Total[masses^2])/2) /. rules;
      (orderedDot @@ First[pair]) -> value], {pair, pairs}];
  (* Conflicting declarations do not justify a definite pair invariant. *)
  First /@ Select[GatherBy[DeleteDuplicates[replacements], First], Length[#] === 1 &]
];

(* Solve the declared cut-invariant equations jointly. Row operations use only
   the exact integer coefficient matrix, never division by a model parameter.
   The caller supplies the internal-shell policy and protects all inverses. *)
preparationJointDotRules[rules_List, conserve_] := Module[
  {external = DeleteDuplicates[externalIndices[rules]], externalRules,
   channels = knownInternalChannels[rules], pairs, dots, massSquares,
   matrix = {}, constants = {}, transformed, coefficients, values, pivot,
   replacements = {}, inconsistent},
  If[Length[external] < 2, Return[{}]];
  externalRules = preparationExternalRules[rules];
  pairs = Subsets[external, {2}]; dots = orderedDot @@@ pairs;
  massSquares = AssociationThread[external,
    ((Mass[#] /. externalRules)^2 &) /@ external];
  Do[
    If[!ContainsAll[external, First[channel]], Continue[]];
    AppendTo[matrix, (Boole[ContainsAll[First[channel], #]] &) /@ pairs];
    AppendTo[constants,
      (Last[channel]^2 - Total[Lookup[massSquares, First[channel]]])/2],
    {channel, channels}];
  If[TrueQ[conserve], Do[
    AppendTo[matrix, (Boole[MemberQ[#, leg]] &) /@ pairs];
    AppendTo[constants, -massSquares[leg]], {leg, external}]];
  If[matrix === {}, Return[{}]];
  (* Approximate mass data cannot certify exact simultaneous identities. *)
  If[!FreeQ[constants, _Real], Return[{}]];
  (* The identity block retains a certificate for every original equation. *)
  transformed = RowReduce[Join[matrix, IdentityMatrix[Length[matrix]], 2]];
  coefficients = transformed[[All, 1 ;; Length[dots]]];
  values = Expand[transformed[[All, Length[dots] + 1 ;;]].constants];
  inconsistent = Select[Range[Length[coefficients]],
    AllTrue[coefficients[[#]], # === 0 &] && !residueExactZero[values[[#]]] &];
  If[inconsistent =!= {}, Return[Failure["InconsistentCutInvariants", <|
    "MessageTemplate" -> "The declared numerator cuts and external momentum constraints are inconsistent.",
    "Residuals" -> values[[inconsistent]]|>]]];
  Do[
    pivot = SelectFirst[Range[Length[dots]], coefficients[[row, #]] =!= 0 &,
      Missing["NoPivot"]];
    If[!MissingQ[pivot],
      AppendTo[replacements, dots[[pivot]] -> Expand[values[[row]] -
        Total[MapThread[Times, {ReplacePart[coefficients[[row]], pivot -> 0], dots}]]]]],
    {row, Length[coefficients]}];
  replacements
];

preparationReduceDots[expr_, replacements_List] := Module[{denominators, tokens},
  If[replacements === {}, Return[expr]];
  (* Protect inverse factors and unknown-sign powers inside unexpanded sums. *)
  denominators = DeleteDuplicates[Cases[{expr},
    denominator : Power[_, exponent_] /; !TrueQ[exponent >= 0], Infinity]];
  tokens = Table[Unique["preparationDenominator"], {Length[denominators]}];
  preparationNumerators[expr /. Thread[denominators -> tokens],
    Function[num, num /. replacements]] /. Thread[tokens -> denominators]
];

(* Only a reference-generated pole may cancel against its external pair
   invariant. Original propagators and every other inverse remain opaque. *)
preparationCancelReferencePoles[expr_, rules_List, auxiliary_List] := Module[
  {external = preparationExternalRules[rules], props, tokens, dotPairs,
   pair, masses, cancelTerm, polePower, body, result},
  props = Select[DeleteDuplicates[auxiliary],
    MatchQ[#, PropDen[Mom[Multiparticle[_Integer, _Integer]], _]] &];
  props = Select[props, Function[prop,
    pair = List @@ prop[[1, 1]]; masses = (Mass /@ pair) /. external;
    DuplicateFreeQ[pair] && FreeQ[masses, _Mass] && MemberQ[masses, 0] &&
      residueExactZero[Total[masses^2] - prop[[2]]^2]]];
  If[props === {}, Return[expr]];
  tokens = Table[Unique["referencePole"], {Length[props]}];
  dotPairs = (List @@ #[[1, 1]]) & /@ props;
  polePower[value_, allowed_List] := Total[Cases[{value},
    HoldPattern[Power[base_, power_Integer]] /; power < 0 && MemberQ[allowed, base] :> -power,
    Infinity]];
  cancelTerm[term_] := Module[
    {activeIndices, active, inverse, inverseTokens, replacements, originalPower,
     protected, canceled},
    activeIndices = Select[Range[Length[tokens]], !FreeQ[term,
      Power[tokens[[#]], exponent_Integer /; exponent < 0]] &];
    If[activeIndices === {}, Return[term]];
    active = tokens[[activeIndices]];
    inverse = DeleteDuplicates[Cases[{term}, power : Power[base_, exponent_] /;
      !TrueQ[exponent >= 0] && !MemberQ[active, base] :> power, Infinity]];
    inverseTokens = Table[Unique["keptInverse"], {Length[inverse]}];
    protected = term /. Thread[inverse -> inverseTokens];
    replacements = Flatten[Table[
      {MomProd @@ dotPairs[[i]] -> tokens[[i]]/2,
        MomProd @@ Reverse[dotPairs[[i]]] -> tokens[[i]]/2}, {i, activeIndices}]];
    originalPower = polePower[protected, active];
    canceled = Cancel[protected /. replacements];
    If[polePower[canceled, active] < originalPower,
      canceled /. Thread[inverseTokens -> inverse], term]];
  body = expr /. Thread[props -> tokens];
  result = If[Head[body] === Plus, Total[cancelTerm /@ List @@ body], cancelTerm[body]];
  result /. Thread[tokens -> props]
];

(* Measuring a completed candidate is cheaper than exploring its distributed
   identity routes. Keep this bounded measurement allowance separate from the
   reducer's expansion budget. The tag prevents incomparable leaf fallbacks
   from being accepted as improvements over measured weighted complexity. *)
preparationRank[expr_] := Module[
  {leaves = LeafCount[expr], groups, profile, score, metric},
  groups = If[Head[expr] === Plus, Length[expr], If[expr === 0, 0, 1]];
  score = TimeConstrained[MemoryConstrained[
    profile = rspExpansionProfile[expr, 4096, 200000];
    If[profile[[1]] <= 4096 && profile[[2]] <= 200000,
      SpinorExpressionComplexity[expr], Missing["RankingDistributionLimit"]],
    134217728, Missing["RankingMemoryLimit"]], 0.2, Missing["RankingTimeLimit"]];
  If[IntegerQ[score] && score >= 0,
    metric = "SpinorExpressionComplexity",
    score = leaves; metric = "LeafCountFallback"];
  {score, groups, leaves, metric}
];

preparationBetterQ[left_List, right_List] := Module[{a, b},
  If[Length[left] === 3 && Length[right] === 3,
    a = left[[{1, 3, 2}]]; b = right[[{1, 3, 2}]];
    Return[a =!= b && OrderedQ[{a, b}]]];
  If[Length[left] =!= 4 || Length[right] =!= 4 || Last[left] =!= Last[right] ||
      !MemberQ[{"SpinorExpressionComplexity", "LeafCountFallback"}, Last[left]], Return[False]];
  (* A smaller syntax tree is usually cheaper to reduce and certify than a
     single dense fraction. Additive grouping breaks ties only after size;
     the rank's public diagnostic field order remains unchanged. *)
  a = left[[{1, 3, 2}]]; b = right[[{1, 3, 2}]];
  a =!= b && OrderedQ[{a, b}]
];

preparationRankKey[rank_List] := If[Length[rank] === 4,
  rank[[{1, 3, 2, 4}]], If[Length[rank] === 3, rank[[{1, 3, 2}]], rank]];
preparationSortKey[expression_] := preparationRankKey[preparationRank[expression]];

(* Cancel a massless reference bracket through its ordinary scalar invariant.
   Only numerator propagators are expanded. Physical denominators and every
   nonzero polynomial remainder retain their original off-shell meaning. *)
preparationMasslessBracketCancellation[expression_, externalRules_List,
    conserve_ : True, seconds_ : 1] := Module[
  {external = preparationExternalRules[externalRules], legs, physicalSpinors, sourceLegs, targets,
   budget, started = AbsoluteTime[], checkpoint, outcome, inverse, inverseTokens,
   protected, atoms, tokens, forward, backward, together, originalNumerator,
   denominator, props, definitions, dots, matrix, transformed, coefficients,
   values, dotRules, pivot, targetDot, target, opposite, power, reducedDenominator,
   invariant, numerator, quotient, remainder, candidate, rank, reconstruction},
  checkpoint = <|"Amplitude" -> expression, "Route" -> {}, "Status" -> "UNCHANGED"|>;
  budget = If[seconds === Infinity, 1,
    If[NumericQ[seconds] && TrueQ[seconds > 0], Min[1, seconds], 0]];
  If[budget <= 0 || LeafCount[expression] > 8000 ||
      !preparationScalarExternalRulesQ[external] || !FreeQ[external, _Real] ||
      !rspExpansionBudgetQ[expression] ||
      !FreeQ[expression, _SpinorHat | _MomHat | _MomQ | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure |
        _ColorTrace | _Dot | _NonCommutativeMultiply], Return[checkpoint]];
  legs = externalIndices[external];
  If[Length[legs] < 2 || Length[legs] > 16, Return[checkpoint]];
  (* Physical endpoints can carry explicit variance or vector-spin slots.
     Use their typed leg accessor instead of assuming an argument count. *)
  physicalSpinors = DeleteDuplicates[Cases[{expression},
    spinor : Spinor["Spin" | "Helicity", ___] :> spinor, Infinity]];
  sourceLegs = rspSpinorLeg /@ physicalSpinors;
  If[!AllTrue[sourceLegs, IntegerQ], Return[checkpoint]];
  sourceLegs = Union[sourceLegs,
    Cases[{expression}, Mom[i_Integer] :> i, Infinity],
    Flatten[Cases[{expression}, Mom[Multiparticle[ii__Integer]] :> {ii}, Infinity]],
    Flatten[Cases[{expression}, MomProd[a_, b_] :> Cases[{a, b}, _Integer, Infinity], Infinity]],
    Flatten[Cases[{expression}, Mandelstahm[ii___] :> Cases[{ii}, _Integer, Infinity], Infinity]]];
  If[!ContainsAll[legs, sourceLegs], Return[checkpoint]];
  targets = DeleteDuplicates[Cases[expression,
    Power[chain_SpinorChain, _Integer?Negative] /;
      Length[chain] === 2 &&
      AllTrue[List @@ chain, MatchQ[#, Spinor["Helicity", "Angle" | "Square", _Integer]] &] &&
      rspSpinorType[First[chain]] === rspSpinorType[Last[chain]] &&
      rspSpinorLeg[First[chain]] =!= rspSpinorLeg[Last[chain]] &&
      AllTrue[List @@ chain, TrueQ[(Mass[rspSpinorLeg[#]] /. external) === 0] &] :> chain, Infinity]];
  If[targets === {}, Return[checkpoint]];
  outcome = TimeConstrained[MemoryConstrained[
    checkpoint = Join[checkpoint, <|"Rank" -> preparationRank[expression]|>];
    Do[
      (* Other inverse sums remain opaque even when their powers are large. *)
      inverse = DeleteDuplicates[Cases[{expression}, inv : Power[base_, exponent_] /;
        !TrueQ[exponent >= 0] && base =!= chain && Head[base] =!= PropDen :> inv, Infinity]];
      inverseTokens = Table[Unique["keptBracketCancellationInverse"], Length[inverse]];
      protected = expression /. Thread[inverse -> inverseTokens];
      atoms = DeleteDuplicates[Cases[protected, _SpinorChain | _SpinorTrace | _PropDen | _ModelParameter, Infinity]];
      tokens = Table[Unique["bracketCancellationAtom"], Length[atoms]];
      forward = Thread[atoms -> tokens];
      backward = Join[Thread[tokens -> atoms], Thread[inverseTokens -> inverse]];
      target = chain /. forward;
      If[!MemberQ[tokens, target], Continue[]];
      together = Together[protected /. forward];
      originalNumerator = Numerator[together]; denominator = Denominator[together];
      power = Exponent[denominator, target];
      If[!IntegerQ[power] || power < 1 || power > 4, Continue[]];
      props = Select[atoms, Head[#] === PropDen && Length[#] === 2 &&
        With[{members = residueMomentumLegsFromExpression[First[#]]},
          ListQ[members] && DuplicateFreeQ[members] && ContainsAll[legs, members]] &];
      definitions = (Rule[# /. forward,
        preparationPropagatorDefinitions[#, external] /. forward] &) /@ props;
      targetDot = orderedDot[rspSpinorLeg[First[chain]], rspSpinorLeg[Last[chain]]];
      dots = Append[DeleteCases[orderedDot @@@ Subsets[legs, {2}], targetDot], targetDot];
      dotRules = {};
      If[TrueQ[conserve] && Length[legs] >= 4,
        matrix = Table[Boole[MemberQ[List @@ dot, leg]], {leg, legs}, {dot, dots}];
        transformed = RowReduce[Join[matrix, IdentityMatrix[Length[legs]], 2]];
        coefficients = transformed[[All, 1 ;; Length[dots]]];
        values = Expand[transformed[[All, Length[dots] + 1 ;;]].
          (-((Mass /@ legs /. external)^2))] /. forward;
        Do[pivot = SelectFirst[Range[Length[dots]], coefficients[[row, #]] =!= 0 &, None];
          If[pivot =!= None, AppendTo[dotRules, dots[[pivot]] -> Expand[values[[row]] -
            Total[MapThread[Times, {ReplacePart[coefficients[[row]], pivot -> 0], dots}]]]]],
          {row, Length[coefficients]}]];
      numerator = Expand[(originalNumerator /. definitions) /. dotRules];
      If[!rspExpansionBudgetQ[numerator] || LeafCount[numerator] > 24000, Continue[]];
      invariant = Unique["canceledMasslessPairInvariant"];
      If[!PolynomialQ[numerator /. targetDot -> invariant, invariant], Continue[]];
      {quotient, remainder} = PolynomialQuotientRemainder[
        numerator /. targetDot -> invariant, (-2 invariant)^power, invariant];
      If[quotient === 0, Continue[]];
      reconstruction = Expand[(numerator /. targetDot -> invariant) -
        quotient (-2 invariant)^power - remainder];
      If[reconstruction =!= 0, Continue[]];
      reducedDenominator = Cancel[denominator/target^power];
      opposite = SpinorChain[rspFlipSpinor[First[chain]], rspFlipSpinor[Last[chain]]];
      candidate = ((quotient opposite^power + remainder/target^power)/reducedDenominator /.
        invariant -> targetDot) /. backward;
      If[!residueFiniteQ[candidate], Continue[]];
      rank = preparationRank[candidate];
      If[preparationBetterQ[rank, checkpoint["Rank"]],
        checkpoint = <|"Amplitude" -> candidate, "Rank" -> rank, "Status" -> "IMPROVED",
          "Route" -> {<|"Operation" -> "MasslessBracketInvariantCancellation",
            "Before" -> expression, "After" -> candidate, "Bracket" -> chain,
            "OppositeBracket" -> opposite, "Power" -> power,
            "NumeratorPropagatorDefinitions" -> (definitions /. backward),
            "ExternalConservationRules" -> (dotRules /. backward),
            "Quotient" -> (quotient /. invariant -> targetDot /. backward),
            "Remainder" -> (remainder /. invariant -> targetDot /. backward),
            "PolynomialDivisionZero" -> reconstruction,
            "ExternalMassRules" -> external, "MomentumConservation" -> TrueQ[conserve],
            "InternalOnShellConditions" -> {}|>}|>],
      {chain, Take[targets, UpTo[4]]}]; True, 134217728, False], budget, False];
  Join[checkpoint, <|"TimedOut" -> !TrueQ[outcome],
    "ElapsedTime" -> AbsoluteTime[] - started, "InternalOnShellConditions" -> {}|>]
];

(* Expose an existing propagator by its exact definition, not by putting it on
   shell. Only numerator scalar products and declared external masses are used. *)
preparationExternalVirtualities[expression_, externalRules_List] := Module[
  {external = externalIndices[externalRules], props, replacements, pair, mass, widthShift, trial},
  If[LeafCount[expression] > 24000 || FreeQ[expression, _MomProd] ||
      rspSandwichExpansionCount[expression] > 256, Return[expression]];
  props = DeleteDuplicates[Cases[expression, _PropDen, Infinity]];
  replacements = DeleteMissing[Map[Function[prop,
    pair = residueMomentumLegsFromExpression[prop[[1]]];
    If[!ListQ[pair] || Length[pair] =!= 2 || !DuplicateFreeQ[pair] ||
        !ContainsAll[external, pair], Missing["NotPairPole"],
      pair = Sort[pair]; mass = prop[[2]];
      (* PropDen includes +i m width; expose its real virtuality exactly. *)
      widthShift = If[Length[prop] === 3, I mass prop[[3]], 0];
      orderedDot @@ pair -> (prop + mass^2 - widthShift -
        (Mass[First[pair]] /. externalRules)^2 -
        (Mass[Last[pair]] /. externalRules)^2)/2]], props]];
  replacements = DeleteDuplicatesBy[replacements, First];
  If[replacements === {}, Return[expression]];
  trial = preparationNumerators[expression, Function[num, num /. replacements]];
  If[!rspExpansionBudgetQ[trial], Return[expression]];
  trial = withProtectedPropagators[trial, Expand];
  preparationSpinorProducts[trial, externalRules]
];

(* A numerator-polynomial identity for arbitrary P,Q and declared massless b,c.
   The angle dual reverses the momentum word and the overall determinant sign.
   Momentum squares remain virtualities unless an external mass rule fixes them.
   Search is bounded; the last expression and its edit log commit together. *)
preparationDeterminantPairs[expression_, externalRules_List, maxPairs_: 8, seconds_: 5] := Module[
  {started = AbsoluteTime[], checkpoint, external, canon, endpointQ, leg, powers, contains,
   outcome, memoryStop = Unique["determinantPairMemory"], remaining, body, terms,
   found, diagonal, parts, kind, other, otherCross, assignment, sign, word, b, c, p, q, bs, cs, oppositeB,
   oppositeC, otherDiagonal, cross, crossed, bracket, firstMonomial, secondMonomial,
   firstCoefficient, secondCoefficient, rhs, candidate, edit, i, j, step, initialLeaves},
  checkpoint = <|"Expression" -> expression, "Edits" -> {}|>;
  remaining[] := If[seconds === Infinity, Infinity, Max[0, seconds - (AbsoluteTime[] - started)]];
  If[!IntegerQ[maxPairs] || maxPairs < 0 ||
      !(seconds === Infinity || NumericQ[seconds] && TrueQ[seconds >= 0]),
    Return[Join[checkpoint, <|"Status" -> "SKIPPED", "TimedOut" -> False,
      "Reason" -> "InvalidBudget", "ElapsedTime" -> AbsoluteTime[] - started|>]]];
  If[maxPairs === 0 || TrueQ[seconds === 0],
    Return[Join[checkpoint, <|"Status" -> "UNCHANGED", "TimedOut" -> TrueQ[seconds === 0],
      "Reason" -> If[maxPairs === 0, "NoPairBudget", "TimeConstraint"],
      "ElapsedTime" -> AbsoluteTime[] - started|>]]];
  initialLeaves = LeafCount[expression];
  If[initialLeaves > 12000 ||
      !FreeQ[expression, _Dot | _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace] ||
      !FreeQ[expression, Power[base_, exponent_] /; !TrueQ[exponent >= 0] &&
        !FreeQ[base, _PropDen | _SpinorChain | _SpinorTrace | _Mom | _MomProd]] ||
      !rspExpansionBudgetQ[expression],
    Return[Join[checkpoint, <|"Status" -> "SKIPPED", "TimedOut" -> False,
      "Reason" -> "NumeratorPolynomialGuard", "ElapsedTime" -> AbsoluteTime[] - started|>]]];
  external = Select[externalRules, MatchQ[#, HoldPattern[Mass[_Integer] -> _]] &];
  If[!AllTrue[external, residueFiniteQ[Last[#]] && FreeQ[Last[#],
        _List | _Association | _Rule | _RuleDelayed | _Mass | _Mom | _MomProd |
        _Spinor | _SpinorChain | _SpinorTrace | _PropDen | _Dot | _NonCommutativeMultiply] &] ||
      !preparationMassRulesConsistentQ[external],
    Return[Join[checkpoint, <|"Status" -> "SKIPPED", "TimedOut" -> False,
      "Reason" -> "InvalidOrConflictingExternalMassRules", "ElapsedTime" -> AbsoluteTime[] - started|>]]];
  canon[value_] := canonicalChains[withProtectedPropagators[value, Expand]];
  endpointQ[value_] := MatchQ[value, Spinor["Helicity", "Angle" | "Square", _Integer]];
  leg[value_] := value[[3]];
  powers[value_] := Merge[Map[Function[factor,
    If[MatchQ[factor, Power[_, _Integer]], factor[[1]] -> factor[[2]], factor -> 1]],
    Select[If[Head[value] === Times, List @@ value, {value}], !NumericQ[#] &]], Total];
  contains[value_, monomial_] := Module[{available = powers[value], required = powers[monomial]},
    AllTrue[Keys[required], Lookup[available, #, 0] >= required[#] &]];
  outcome = TimeConstrained[MemoryConstrained[
    Do[
      body = canon[checkpoint["Expression"]]; terms = If[Head[body] === Plus, List @@ body, {body}];
      If[Length[terms] > 128, Break[]]; found = False;
      Catch[
        Do[
          Do[
            parts = List @@ diagonal; bs = First[parts]; b = leg[bs]; kind = bs[[2]];
            If[!TrueQ[(Mass[b] /. external) === 0], Continue[]];
            other = If[kind === "Square", "Angle", "Square"];
            word = parts[[2 ;; 3]];
            oppositeB = Spinor["Helicity", other, b];
            Do[
            {p, q, sign} = assignment;
            crossed = DeleteDuplicates[Cases[terms[[i]], chain_SpinorChain /;
              Length[chain] === 3 && chain[[2]] === Mom[p] &&
                ((endpointQ[First[chain]] && First[chain][[2]] === kind && Last[chain] === oppositeB) ||
                 (First[chain] === oppositeB && endpointQ[Last[chain]] && Last[chain][[2]] === kind)), Infinity]];
            Do[
              cs = If[endpointQ[First[cross]] && First[cross][[2]] === kind, First[cross], Last[cross]];
              c = leg[cs];
              If[c === b || !TrueQ[(Mass[c] /. external) === 0], Continue[]];
              oppositeC = Spinor["Helicity", other, c];
              otherDiagonal = SpinorChain[cs, Sequence @@ word, cs];
              bracket = SpinorChain[bs, cs];
              firstMonomial = canonicalChains[bracket MomProd[q, c] cross diagonal];
              If[!contains[terms[[i]], firstMonomial], Continue[]];
              firstCoefficient = Cancel[terms[[i]]/firstMonomial];
              Do[
                secondMonomial = canonicalChains[bracket MomProd[q, b] otherCross otherDiagonal];
                Do[
                  If[j === i || !contains[terms[[j]], secondMonomial], Continue[]];
                  secondCoefficient = Cancel[terms[[j]]/secondMonomial];
                  If[!TrueQ[Cancel[firstCoefficient + secondCoefficient] === 0], Continue[]];
                  rhs = sign (bracket^2 (MomProd[p, p] (2 MomProd[q, b]) (2 MomProd[q, c]) -
                    MomProd[q, q] (2 MomProd[p, b]) (2 MomProd[p, c])) +
                    2 MomProd[b, c] diagonal otherDiagonal);
                  candidate = canon[(Total[Delete[terms, List /@ {i, j}]] + firstCoefficient rhs/2) /. external];
                  If[!residueFiniteQ[candidate], Continue[]];
                  edit = <|"Momenta" -> {p, q}, "MasslessLegs" -> {b, c}, "Chirality" -> kind,
                    "Subtract" -> terms[[i]] + terms[[j]], "Insert" -> firstCoefficient rhs/2,
                    "Identity" -> "TwoByTwoDeterminantPair", "InternalOnShellConditions" -> {}|>;
                  checkpoint = <|"Expression" -> candidate, "Edits" -> Append[checkpoint["Edits"], edit]|>;
                  found = True; Throw[Null],
                  {j, Length[terms]}],
                {otherCross, {SpinorChain[bs, Mom[p], oppositeC], SpinorChain[oppositeC, Mom[p], bs]}}],
              {cross, crossed}],
            {assignment, {{word[[1, 1]], word[[2, 1]], 1},
              {word[[2, 1]], word[[1, 1]], -1}}}],
            {diagonal, DeleteDuplicates[Cases[terms[[i]], chain_SpinorChain /;
              Length[chain] === 4 && First[chain] === Last[chain] && endpointQ[First[chain]] &&
                MatchQ[chain[[2]], _Mom] && MatchQ[chain[[3]], _Mom], Infinity]]}],
          {i, Length[terms]}]];
      If[!found, Break[]], {step, maxPairs}]; True,
    268435456, memoryStop], remaining[], $TimedOut];
  Join[checkpoint, <|"Status" -> If[checkpoint["Edits"] === {}, "UNCHANGED", "REDUCED"],
    "TimedOut" -> (outcome === $TimedOut),
    "Reason" -> Which[outcome === $TimedOut, "TimeConstraint", outcome === memoryStop, "MemoryConstraint", True, "Completed"],
    "ElapsedTime" -> AbsoluteTime[] - started|>]
];

(* Sparse Laurent content, not a new spinor or on-shell identity. Keep small
   groups with shared physical denominators instead of making one dense fraction. *)
preparationSparsePoleContent[expression_, seconds_: 0.5] := Module[
  {props, propTokens, body, terms, atoms, atomTokens, content, rationalContent,
   common, inner, counts, thresholds, selected, denominator, remaining, groups,
   block, candidate, restored, best = expression, bestRank, rank},
  If[LeafCount[expression] > 24000 || rspSandwichExpansionCount[expression] > 128 ||
      !FreeQ[expression, Power[base_, exponent_] /; !TrueQ[exponent >= 0] &&
        !FreeQ[base, _SpinorChain | _SpinorTrace | _SpinorHat]] ||
      !FreeQ[expression, _Dot | _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace],
    Return[expression]];
  props = DeleteDuplicates[Cases[expression, _PropDen, Infinity]];
  If[Length[props] < 2 || Length[props] > 64, Return[expression]];
  bestRank = preparationRank[expression];
  TimeConstrained[
    propTokens = Table[Unique["sparsePhysicalPole"], {Length[props]}];
    body = expression /. Thread[props -> propTokens];
    terms = With[{expanded = Expand[body]}, If[Head[expanded] === Plus, List @@ expanded, {expanded}]];
    atoms = Join[DeleteDuplicates[Cases[body,
      _SpinorChain | _SpinorTrace | _ModelParameter |
        (value : Power[_Integer | _Rational, _Rational] /; NumericQ[value]), Infinity]], propTokens];
    atomTokens = Table[Unique["sparseContentAtom"], {Length[atoms]}];
    rationalContent[items_List] := Module[{coefficients},
      coefficients = Times @@ Select[If[Head[#] === Times, List @@ #, {#}],
        MatchQ[#, _Integer | _Rational] &] & /@ items;
      If[MemberQ[coefficients, 0], 1,
        If[AllTrue[coefficients, # < 0 &], -1, 1] *
          (GCD @@ (Numerator /@ coefficients))/(LCM @@ (Denominator /@ coefficients))]];
    content[items_List] := Module[{powers, commonPowers},
      powers = Table[Exponent[#, token] & /@ (items /. Thread[atoms -> atomTokens]),
        {token, atomTokens}];
      commonPowers = Map[Which[Min[#] > 0, Min[#], Max[#] < 0, Max[#], True, 0] &, powers];
      rationalContent[items] Times @@ MapThread[Power, {atoms, commonPowers}]];
    common = content[terms]; inner = Cancel[#/common] & /@ terms;
    counts = Count[inner, term_ /; !FreeQ[Denominator[term], #]] & /@ propTokens;
    thresholds = Prepend[Take[Reverse[Sort[DeleteDuplicates[Select[counts,
      # >= Length[terms]/2 &]]]], UpTo[4]], Length[terms] + 1];
    block[items_List] := With[{unit = content[items]},
      unit Total[Cancel[#/unit] & /@ items]];
    Do[
      selected = Pick[propTokens, # >= threshold & /@ counts];
      denominator = Times @@ selected;
      remaining = Complement[Pick[propTokens, # >= Length[terms]/2 & /@ counts], selected];
      groups = GatherBy[Cancel[# denominator] & /@ inner,
        Function[term, Select[remaining, !FreeQ[Denominator[term], #] &]]];
      candidate = common Total[block /@ groups]/denominator;
      restored = candidate /. Thread[propTokens -> props];
      If[residueFiniteQ[restored] && LeafCount[restored] < LeafCount[best],
        rank = preparationRank[restored];
        If[preparationBetterQ[rank, bestRank], best = restored; bestRank = rank]],
      {threshold, thresholds}], seconds, Null];
  best
];

(* Expose ordinary Schouten and external Dirac reductions hidden behind
   spectator factors. Each complete inverse monomial remains a separate group;
   no denominator, internal shell or new correction direction is introduced. *)
preparationNumeratorSpectatorSums[expression_, seconds_ : 1, externalRules_List : {}] := Module[
  {best = expression, bestRank, external = preparationExternalRules[externalRules],
   inverseFactors, inverseTokens, protected, profile, expanded, terms, groups,
   key, numerator, records, tokenFactorQ, spinorSupport, atomSupport,
   allChains, chains, excluded, supports, collections, selected,
   collected, coefficient, proposal, restored, rank, index, candidate,
   maximumGroups = 24, maximumCollections = 16, maximumGroupLeaves = 10000,
   maximumAtoms = 64, maximumBranches = 1024},
  If[!TrueQ[seconds > 0] || LeafCount[expression] > 60000 || FreeQ[expression, _Plus] ||
      !FreeQ[expression, _Dot | _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace |
        _SpinorHat | _SpinorZ | _SpinorEps], Return[expression]];
  bestRank = preparationRank[best];
  TimeConstrained[MemoryConstrained[
    inverseFactors = DeleteDuplicates[Cases[{expression}, power : Power[_, exponent_] /;
      !TrueQ[exponent >= 0], Infinity]];
    inverseTokens = Table[Unique["spectatorInverse"], {Length[inverseFactors]}];
    protected = expression /. Thread[inverseFactors -> inverseTokens];
    profile = rspExpansionProfile[protected, maximumBranches, 100000];
    If[profile[[1]] > maximumBranches || profile[[2]] > 100000, Return[best]];
    expanded = Expand[protected];
    terms = If[Head[expanded] === Plus, List @@ expanded, {expanded}];
    tokenFactorQ[value_] := MemberQ[inverseTokens, value] ||
      MatchQ[value, Power[token_, n_Integer?Positive] /; MemberQ[inverseTokens, token]];
    key[term_] := Times @@ Select[If[Head[term] === Times, List @@ term, {term}], tokenFactorQ];
    groups = GatherBy[terms, key];
    records = ({key[First[#]], Total[(Times @@ Select[
      If[Head[#] === Times, List @@ #, {#}], !tokenFactorQ[#] &]) & /@ #]} &) /@ groups;
    spinorSupport[chain_] := DeleteDuplicates[Cases[chain,
      spinor_Spinor :> rspSpinorLeg[spinor], Infinity]];
    Do[
      numerator = records[[index, 2]];
      If[LeafCount[numerator] > maximumGroupLeaves || FreeQ[numerator, _Plus], Continue[]];
      allChains = DeleteDuplicates[Cases[numerator, _SpinorChain, Infinity]];
      chains = Select[allChains, FreeQ[#, _Mom | _MomHat] &];
      If[Length[chains] < 2 || Length[allChains] > maximumAtoms, Continue[]];
      atomSupport = spinorSupport /@ chains;
      supports = DeleteDuplicates[Flatten[Table[
        If[Intersection[atomSupport[[i]], atomSupport[[j]]] === {}, {},
          {Union[atomSupport[[i]], atomSupport[[j]]]}],
        {i, Length[chains]}, {j, i + 1, Length[chains]}], 2]];
      collections = DeleteDuplicates[Table[
        selected = Pick[chains, (Intersection[#, excluded] === {} & /@ atomSupport)];
        If[Length[selected] >= 2, selected, Nothing], {excluded, supports}]];
      collections = Take[SortBy[collections, {Length, LeafCount}], UpTo[maximumCollections]];
      coefficient[value_] := If[LeafCount[value] > maximumGroupLeaves, value,
        Factor[ReduceSpinorProducts[Expand[value]] /. external]];
      Do[
        collected = Collect[numerator, selected, coefficient];
        proposal = Factor[collected];
        If[!residueFiniteQ[proposal] || !FreeQ[proposal, Power[_, exponent_] /;
            !TrueQ[exponent >= 0]] || !FreeQ[proposal, Alternatives @@ inverseTokens], Continue[]];
        candidate = ReplacePart[records, {index, 2} -> proposal];
        restored = Total[(First[#] Last[#] & /@ candidate)] /. Thread[inverseTokens -> inverseFactors];
        If[residueFiniteQ[restored], rank = preparationRank[restored];
          If[preparationBetterQ[rank, bestRank],
            best = restored; bestRank = rank; records = candidate]],
        {selected, collections}],
      {index, Min[Length[records], maximumGroups]}];
    True, 268435456, False], seconds, False];
  best
];

(* Compact a completed rational sum by collecting its spinor atoms. Physical
   propagators remain independent off-shell quantities. Literal and inverse-
   protected collections compete; large factored products are not expanded. *)
preparationCompactExternalSums[expression_, seconds_: 5, externalRules_List : {}] := Module[
  {best = expression, bestRank, inverses, inverseTokens,
   protected, atoms, coefficient, trial, rank, reverse,
   maximumAtoms = 512, maximumBranches = 2048, maximumLeaves = 200000},
  If[LeafCount[expression] > maximumLeaves || FreeQ[expression, _Plus] ||
      rspSandwichExpansionCount[expression] > maximumBranches ||
      !FreeQ[expression, _Dot | _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace],
    Return[expression]];
  best = preparationSparsePoleContent[expression, Min[0.5, seconds/3]];
  bestRank = preparationRank[best];
  If[externalRules =!= {},
    trial = TimeConstrained[preparationExternalVirtualities[expression, externalRules],
      Min[1.5, seconds/2], expression];
    If[residueFiniteQ[trial], rank = preparationRank[trial];
      If[preparationBetterQ[rank, bestRank], best = trial; bestRank = rank]]];
  trial = preparationNumeratorSpectatorSums[best, Min[1, seconds/4], externalRules];
  If[residueFiniteQ[trial], rank = preparationRank[trial];
    If[preparationBetterQ[rank, bestRank], best = trial; bestRank = rank]];
  TimeConstrained[MemoryConstrained[
    Do[
      trial = Function[body,
        inverses = DeleteDuplicates[Cases[{body}, power : Power[base_, exponent_] /;
          !TrueQ[exponent >= 0] && !FreeQ[base, _SpinorChain | _SpinorTrace | _SpinorHat], Infinity]];
        inverseTokens = Table[Unique["compactSpinorInverse"], {Length[inverses]}];
        protected = If[TrueQ[reverse], body /. Thread[inverses -> inverseTokens], body];
        atoms = DeleteDuplicates[Cases[protected, _SpinorChain | _SpinorTrace, Infinity]];
        If[atoms === {} || Length[atoms] > maximumAtoms, body,
          coefficient[value_] := If[LeafCount[value] > 20000, value, Factor[value]];
          Collect[protected, If[TrueQ[reverse], Reverse[atoms], atoms], coefficient] /.
            Thread[inverseTokens -> inverses]]][expression];
      If[residueFiniteQ[trial] && FreeQ[trial, _Collect | _Factor | _Cancel] &&
          LeafCount[trial] < LeafCount[best],
        rank = preparationRank[trial];
        If[preparationBetterQ[rank, bestRank], best = trial; bestRank = rank]],
      {reverse, {False, True}}], 268435456, Null], seconds, Null];
  best
];

(* Exact scalar factoring within unchanged propagator groups. The proof
   path may prefer this algebraically equal form even when a presentation rank
   prefers fewer top-level groups. No spinor or internal-shell identity is used. *)
preparationGroupedPropagatorForm[expression_, seconds_: 2] := Module[
  {profile, expanded, terms, groups, key, result},
  If[!TrueQ[seconds > 0] || LeafCount[expression] > 150000 ||
      !FreeQ[expression, _Dot | _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace],
    Return[expression]];
  profile = rspExpansionProfile[expression, 2048, 160000];
  If[profile[[1]] > 2048 || profile[[2]] > 160000, Return[expression]];
  result = TimeConstrained[MemoryConstrained[
    key[term_] := Times @@ Select[If[Head[term] === Times, List @@ term, {term}],
      MatchQ[#, Power[_PropDen, n_Integer?Negative]] &];
    expanded = withProtectedPropagators[expression, Expand];
    terms = If[Head[expanded] === Plus, List @@ expanded, {expanded}];
    groups = GroupBy[terms, key];
    Total[KeyValueMap[#1 rspLocalFactorContent[Expand[Total[#2]/#1]] &, groups]],
    268435456, expression], seconds, expression];
  If[residueFiniteQ[result] && LeafCount[result] < LeafCount[expression], result, expression]
];

(* Try ordinary Schouten edits while an existing rational numerator is still
   intact. Expanding the surrounding amplitude first can cancel a positive
   virtuality against its denominator and scatter one useful identity across
   several denominator groups. Virtualities stay inert scalar coefficients;
   only declared external Dirac identities are used by the forward reducer. *)
preparationWholeFractionSchouten[expression_, externalRules_List, seconds_ : 12] := Module[
  {started = AbsoluteTime[], external = preparationExternalRules[externalRules],
   bestRecord, terms, props, tokens, restore, replacements, fractions, numerators,
   denominators, chosen, order, available, reduced, moves, original,
   next, nextRank, edit, trial, value, proposal, localFinished, finished = True,
   contractionCount, priority, index, move, localBudget, inspected = 0, attempted = 0,
   fractionRoute, proposedRoutes, groupTimeouts = 0, factored, factors, sums, cofactor, core},
  bestRecord = <|"Amplitude" -> expression, "Rank" -> preparationRank[expression],
    "Route" -> {}, "Status" -> "UNCHANGED"|>;
  If[!TrueQ[NumericQ[seconds] && seconds > 0] || LeafCount[expression] > 24000 ||
      !preparationScalarExternalRulesQ[external] ||
      !FreeQ[expression, _Dot | _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace |
        _SpinorHat | _MomHat | _MomQ | Spinor["Xi" | "Zeta", ___]], Return[bestRecord]];
  terms = If[Head[expression] === Plus, List @@ expression, {expression}];
  If[Length[terms] > 64, Return[bestRecord]];
  props = DeleteDuplicates[Cases[expression, _PropDen, Infinity]];
  tokens = Table[Unique["wholeFractionVirtuality"], {Length[props]}];
  replacements = Thread[props -> tokens]; restore = Thread[tokens -> props];
  fractions = terms /. replacements;
  numerators = Numerator /@ fractions; denominators = Denominator /@ fractions;
  chosen = fractions;
  bestRecord = Join[bestRecord, <|"ChosenFractions" -> chosen,
    "FractionRoutes" -> ConstantArray[None, Length[terms]]|>];
  available[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  (* Favor inexpensive blocks before a large regular remainder. Within each
     block, expose external Dirac contractions before unrelated chain swaps. *)
  order = SortBy[Range[Length[terms]],
    {Length[DeleteDuplicates[Cases[numerators[[#]], _SpinorChain, Infinity]]],
      LeafCount[numerators[[#]]]} &];
  contractionCount[body_] := Total[Cases[body,
    chain_SpinorChain /; Length[chain] >= 3 :>
      Boole[chain[[2]] === Mom[rspSpinorLeg[First[chain]]]] +
      Boole[chain[[-2]] === Mom[rspSpinorLeg[Last[chain]]]], Infinity]];
  priority[record_] := {-contractionCount[record["Insert"]], LeafCount[record["Insert"]]};
  finished = TimeConstrained[MemoryConstrained[
    Do[
      If[seconds - (AbsoluteTime[] - started) <= 0, Break[]];
      If[FreeQ[numerators[[index]], _Plus] || LeafCount[numerators[[index]]] > 3000 ||
          !rspExpansionBudgetQ[numerators[[index]]] ||
          rspSandwichExpansionCount[numerators[[index]]] > 64, Continue[]];
      original = Expand[numerators[[index]]];
      next = original; nextRank = preparationRank[original /. restore]; edit = None;
      factored = Factor[original]; factors = If[Head[factored] === Times, List @@ factored, {factored}];
      sums = Select[factors, Head[#] === Plus &];
      {cofactor, core} = If[Length[sums] === 1,
        {Times @@ Select[factors, Head[#] =!= Plus &], First[sums]}, {1, original}];
      localBudget = Min[3, available[]]; attempted++;
      localFinished = TimeConstrained[
        moves = Take[SortBy[SchoutenCandidates[core], priority], UpTo[96]];
        Do[
          inspected++;
          trial = Expand[original - cofactor move["Subtract"] + cofactor move["Insert"]];
          reduced = canonicalChains[preparationSpinorProducts[trial, external]];
          If[!residueFiniteQ[reduced], Continue[]];
          value = preparationRank[reduced /. restore];
          If[preparationBetterQ[value, nextRank],
            next = reduced; nextRank = value; edit = move;
            chosen = ReplacePart[bestRecord["ChosenFractions"],
              index -> rspLocalFactorContent[next]/denominators[[index]]];
            proposal = Total[chosen] /. restore;
            If[preparationBetterQ[preparationRank[proposal], bestRecord["Rank"]],
              fractionRoute = <|"Operation" -> "WholeFractionSchouten",
                "Fraction" -> index,
                "Denominator" -> (denominators[[index]] /. restore),
                "OriginalNumerator" -> (original /. restore), "Numerator" -> (next /. restore),
                "Edit" -> (edit /. restore), "Cofactor" -> (cofactor /. restore),
                "ExternalMassRules" -> external,
                "ForwardReduction" -> "SpinorProductsAndExternalDiracSchouten",
                "InternalOnShellConditions" -> {}|>;
              proposedRoutes = ReplacePart[bestRecord["FractionRoutes"], index -> fractionRoute];
              bestRecord = <|"Amplitude" -> proposal, "Rank" -> preparationRank[proposal],
                "ChosenFractions" -> chosen, "FractionRoutes" -> proposedRoutes,
                "Route" -> DeleteCases[proposedRoutes, None], "Status" -> "IMPROVED"|>]];
          (* A strong completed reduction is retained immediately, leaving
             the shared allowance for the other original fractions. *)
          If[First[nextRank] <= First[preparationRank[original /. restore]]/4, Break[]],
          {move, moves}]; True,
        Max[0.000001, localBudget], False];
      If[!TrueQ[localFinished], groupTimeouts++],
      {index, order}]; True,
    268435456, False], available[], False];
  Join[KeyDrop[bestRecord, {"ChosenFractions", "FractionRoutes"}],
    <|"TimedOut" -> (!TrueQ[finished] || groupTimeouts > 0), "GroupTimeouts" -> groupTimeouts,
    "AttemptedFractions" -> attempted,
    "InspectedCandidates" -> inspected, "ElapsedTime" -> AbsoluteTime[] - started,
    "InternalOnShellConditions" -> {}|>]
];

(* Continue from completed ordinary fraction checkpoints, rather than rerunning
   contraction expansion between useful edits. Every pass has its own short
   search allowance and all passes share the caller's remaining deadline. *)
preparationWholeFractionContinuation[expression_, externalRules_List, seconds_ : 36,
    checkpoint_ : None] := Module[
  {started = AbsoluteTime[], best, remaining, trial, before, route = {}, attempts = {},
   finished = True, stop = "NoImprovingCheckpoint", pass = 0, maximumPasses = 8},
  best = <|"Amplitude" -> expression, "Rank" -> preparationRank[expression],
    "Route" -> {}, "Status" -> "UNCHANGED"|>;
  If[!TrueQ[NumericQ[seconds] && seconds > 0],
    Return[Join[best, <|"Iterations" -> {}, "TimedOut" -> False,
      "StopReason" -> "NoSearchBudget", "ElapsedTime" -> AbsoluteTime[] - started,
      "InternalOnShellConditions" -> {}|>]]];
  remaining[] := Max[0, seconds - (AbsoluteTime[] - started)];
  finished = TimeConstrained[
    While[pass < maximumPasses && remaining[] > 0.01,
      pass++; before = best["Amplitude"];
      trial = preparationWholeFractionSchouten[before, externalRules, Min[12, remaining[]]];
      AppendTo[attempts, If[AssociationQ[trial],
        Join[KeyTake[trial, {"Status", "TimedOut", "ElapsedTime", "AttemptedFractions",
          "InspectedCandidates"}], <|"Pass" -> pass|>],
        <|"Pass" -> pass, "Status" -> "UnavailableCheckpoint"|>]];
      If[!AssociationQ[trial] || !KeyExistsQ[trial, "Amplitude"] ||
          !residueFiniteQ[trial["Amplitude"]] ||
          !preparationBetterQ[preparationRank[trial["Amplitude"]], best["Rank"]],
        stop = "NoImprovingCheckpoint"; Break[]];
      AppendTo[route, <|"Operation" -> "WholeFractionContinuation",
        "Before" -> before, "After" -> trial["Amplitude"],
        "IdentityRoute" -> Lookup[trial, "Route", {}],
        "InternalOnShellConditions" -> {}|>];
      (* Commit the complete expression and replay together. A later timeout
         must not expose an incomplete edit or lose this accepted checkpoint. *)
      best = <|"Amplitude" -> trial["Amplitude"], "Rank" -> preparationRank[trial["Amplitude"]],
        "Route" -> route, "Status" -> "IMPROVED"|>;
      If[Head[checkpoint] === Function, checkpoint[best]];
      stop = If[pass === maximumPasses, "IterationLimit", "SharedTimeBudget"]]; True,
    seconds, False];
  Join[best, <|"Iterations" -> attempts, "TimedOut" -> !TrueQ[finished] || remaining[] <= 0.01,
    "StopReason" -> If[!TrueQ[finished], "SharedTimeBudget", stop],
    "ElapsedTime" -> AbsoluteTime[] - started, "InternalOnShellConditions" -> {}|>]
];

(* Compact ordinary external spinor identities within unchanged propagator
   groups. No diagram-local shell assumption is used. Keep only a strict
   whole-expression improvement, including completed checkpoints on timeout. *)
preparationDenominatorSchouten[expression_, externalRules_List, seconds_: 15] := Module[
  {started = AbsoluteTime[], expanded, terms, groups, denominators, numerators,
   chosen, originalNumerators, route, order, best = expression, bestRank,
   key, reduce, better, assemble, moves, trial, reduced, next, nextEdit,
   proposal, outcome, i, move, pass, checkpoint, bestChosen, bestRoute, bestRecord},
  bestRank = preparationRank[best];
  If[!TrueQ[seconds > 0] || LeafCount[expression] > 24000 ||
      !rspExpansionBudgetQ[expression] || rspSandwichExpansionCount[expression] > 256 ||
      !FreeQ[expression, _Dot | _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace],
    Return[<|"Amplitude" -> best, "Route" -> {}, "Status" -> "UNCHANGED",
      "ElapsedTime" -> AbsoluteTime[] - started|>]];
  key[term_] := Times @@ Select[If[Head[term] === Times, List @@ term, {term}],
    MatchQ[#, Power[_PropDen, n_Integer?Negative]] &];
  reduce[value_] := canonicalChains[ReduceSpinorProducts[value] /. externalRules];
  better[left_, right_] := preparationBetterQ[preparationRank[left], preparationRank[right]];
  expanded = withProtectedPropagators[expression, Expand];
  terms = If[Head[expanded] === Plus, List @@ expanded, {expanded}];
  groups = GroupBy[terms, key];
  denominators = Keys[groups];
  numerators = MapThread[Expand[Total[#1]/#2] &, {Values[groups], denominators}];
  originalNumerators = numerators;
  chosen = rspLocalFactorContent /@ numerators;
  route = ConstantArray[{}, Length[numerators]];
  bestChosen = chosen; bestRoute = route;
  bestRecord = <|"Amplitude" -> best, "Rank" -> bestRank,
    "Chosen" -> bestChosen, "Route" -> bestRoute|>;
  checkpoint[index_, value_, edit_] := Module[{saved = chosen[[index]], proposedRoute},
    chosen[[index]] = rspLocalFactorContent[value]; proposal = assemble[];
    If[better[proposal, best],
      proposedRoute = route; AppendTo[proposedRoute[[index]], edit];
      (* Commit amplitude and replay data together, even if the clock expires
         immediately after this assignment. *)
      bestRecord = <|"Amplitude" -> proposal, "Rank" -> preparationRank[proposal],
        "Chosen" -> chosen, "Route" -> proposedRoute|>;
      best = proposal; bestRank = bestRecord["Rank"];
      bestChosen = chosen; bestRoute = proposedRoute];
    chosen[[index]] = saved
  ];
  assemble[] := Total[denominators chosen];
  proposal = assemble[];
  If[better[proposal, best],
    bestRecord = <|"Amplitude" -> proposal, "Rank" -> preparationRank[proposal],
      "Chosen" -> chosen, "Route" -> route|>;
    best = proposal; bestRank = bestRecord["Rank"]];
  (* Large sum numerators offer the useful cross-term cancellation first. *)
  order = Reverse[SortBy[Range[Length[numerators]],
    {If[Head[numerators[[#]]] === Plus, Length[numerators[[#]]], 1], LeafCount[numerators[[#]]]} &]];
  outcome = TimeConstrained[MemoryConstrained[
    Do[
      Do[
        moves = SchoutenCandidates[numerators[[i]]]; next = numerators[[i]]; nextEdit = None;
        Do[
          trial = Expand[numerators[[i]] - move["Subtract"] + move["Insert"]];
          If[better[trial, next], next = trial; nextEdit = move; checkpoint[i, next, move]];
          If[LeafCount[trial] < 2 LeafCount[numerators[[i]]],
            reduced = reduce[trial];
            If[better[reduced, next], next = reduced; nextEdit = move; checkpoint[i, next, move]]],
          {move, moves}];
        If[nextEdit === None, Break[]];
        AppendTo[route[[i]], nextEdit]; numerators[[i]] = next;
        chosen[[i]] = rspLocalFactorContent[next]; proposal = assemble[];
        If[better[proposal, best],
          bestRecord = <|"Amplitude" -> proposal, "Rank" -> preparationRank[proposal],
            "Chosen" -> chosen, "Route" -> route|>;
          best = proposal; bestRank = bestRecord["Rank"]; bestChosen = chosen; bestRoute = route],
        {pass, 1}],
      {i, order}]; True,
    268435456, False], Max[0.000001, seconds - (AbsoluteTime[] - started)], False];
  <|"Amplitude" -> bestRecord["Amplitude"],
    "Status" -> If[bestRecord["Amplitude"] === expression, "UNCHANGED", "IMPROVED"],
    "Rank" -> bestRecord["Rank"], "TimedOut" -> !TrueQ[outcome],
    "Route" -> MapThread[<|"Denominator" -> #1, "OriginalNumerator" -> #2,
      "Numerator" -> #3, "Edits" -> #4|> &, {denominators, originalNumerators,
        bestRecord["Chosen"], bestRecord["Route"]}],
    "ElapsedTime" -> AbsoluteTime[] - started|>
];

(* These ordinary scalar identities require scalar external masses. Invalid
   declarations cannot license either a fixed virtuality or a null spinor. *)
preparationScalarExternalRulesQ[rules_List] := Module[{external = preparationExternalRules[rules]},
  preparationMassRulesConsistentQ[external] && AllTrue[external,
    residueFiniteQ[Last[#]] && FreeQ[Last[#], _List | _Association | _Rule | _RuleDelayed | _Spinor | _SpinorChain |
      _SpinorTrace | _Mom | _MomProd | _PropDen | _Mandelstahm | _Mass | _Dot |
      _NonCommutativeMultiply | _sigma | _ColorGenerator | _ColorDelta | _ColorStructure | _ColorTrace | Indeterminate |
      ComplexInfinity | _DirectedInfinity] &]
];

(* Exact virtuality definitions. A positive propagator atom is retained on the
   right-hand side; this never substitutes an internal mass-shell condition. *)
preparationPropagatorDefinitions[expression_, externalRules_List] := Module[
  {massSquare, legs},
  If[!preparationScalarExternalRulesQ[externalRules], Return[expression]];
  massSquare[i_] := With[{mass = Mass[i] /. externalRules},
    If[FreeQ[mass, _Mass], mass^2, orderedDot[i, i]]];
  expression /. prop_PropDen :> If[Length[prop] =!= 2, prop,
    legs = residueMomentumLegsFromExpression[First[prop]];
    If[ListQ[legs] && DuplicateFreeQ[legs], Total[massSquare /@ legs] +
      2 Total[orderedDot @@@ Subsets[legs, {2}]] - prop[[2]]^2, prop]]
];

preparationVirtualityTrials[expression_, externalRules_List, inventory_List,
    conserve_ : False] := Module[
  {props, external, records = {}, trials = {}, legs, complement, rest, choices,
   massSquare, add, rhs, constant, pivot, coefficient, identity, target},
  If[!preparationScalarExternalRulesQ[externalRules], Return[{}]];
  props = DeleteDuplicates[Cases[{inventory}, prop_PropDen /; Length[prop] === 2 :> prop, Infinity]];
  props = Select[props, With[{parts = residueMomentumLegsFromExpression[First[#]]},
    ListQ[parts] && DuplicateFreeQ[parts]] &];
  external = Sort[DeleteDuplicates[externalIndices[externalRules]]];
  massSquare[i_] := With[{mass = Mass[i] /. externalRules},
    If[FreeQ[mass, _Mass], mass^2, orderedDot[i, i]]];
  Do[legs = Sort[residueMomentumLegsFromExpression[First[prop]]];
    If[Length[legs] >= 2, AppendTo[records, <|"Propagator" -> prop,
      "Legs" -> legs, "MomentumConservationUsed" -> False|>]];
    If[TrueQ[conserve] && ContainsAll[external, legs],
      complement = Complement[external, legs];
      If[Length[complement] >= 2, AppendTo[records, <|"Propagator" -> prop,
        "Legs" -> complement, "MomentumConservationUsed" -> True|>]]], {prop, props}];
  add[record_, right_, kind_] := Module[{dots},
    target = record["Propagator"]; identity = Expand[right - target];
    dots = DeleteDuplicates[Cases[identity, _MomProd, Infinity]];
    Do[coefficient = Coefficient[identity, pivot];
      If[coefficient =!= 0 && FreeQ[coefficient, _MomProd] && !FreeQ[expression, pivot],
        AppendTo[trials, Join[record, <|"Rule" -> (pivot -> Expand[pivot - identity/coefficient]),
          "Identity" -> identity, "Kind" -> kind|>]]], {pivot, dots}]];
  Do[legs = record["Legs"];
    If[Length[legs] >= 3,
      Do[rest = DeleteCases[legs, center];
        choices = Table[Select[props,
          Sort[residueMomentumLegsFromExpression[First[#]]] === Sort[{center, leg}] &], {leg, rest}];
        If[AnyTrue[choices, # === {} &] || Times @@ (Length /@ choices) > 32, Continue[]];
        Do[constant = (2 - Length[legs]) massSquare[center] +
            Total[(#[[2]]^2 &) /@ selected] - record["Propagator"][[2]]^2;
          rhs = Total[selected] + 2 Total[orderedDot @@@ Subsets[rest, {2}]] + constant;
          add[record, rhs, "CenteredPairDefinition"], {selected, Tuples[choices]}], {center, legs}]];
    rhs = Total[massSquare /@ legs] + 2 Total[orderedDot @@@ Subsets[legs, {2}]] -
      record["Propagator"][[2]]^2;
    add[record, rhs, "DirectDefinition"], {record, records}];
  Take[DeleteDuplicatesBy[trials, Lookup[#, "Rule"] &], UpTo[256]]
];

