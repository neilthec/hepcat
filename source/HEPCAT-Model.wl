        expression = after;
        AppendTo[reductions, <|"Operation" -> "OrdinaryPoleDisplayGrouping", "Before" -> before,
          "After" -> expression, "InternalOnShellIdentity" -> False, "OnShellChannels" -> {},
          "IdentityRoute" -> Lookup[displayCompaction, "Route", {}],
          "SearchTimedOut" -> Lookup[displayCompaction, "TimedOut", False]|>];
        rememberCompleted[expression, "OrdinaryPoleDisplayGrouping"]]]];
  event[Which[TrueQ[outcome], "Prepared", referenceFailure, "Reference choice unavailable",
    conversionFailure, "Feynman conversion unavailable",
    invalid, "Invalid reduction retained previous state",
    True, "Time limit reached"]];
  Join[<|"ItemIndex" -> index, "InputType" -> kind|>,
    If[MemberQ[{"Diagram", "FeynmanDiagram"}, kind], <|"DiagramIndex" -> index|>, <||>],
  <|"Status" -> If[TrueQ[outcome], "PREPARED", "PARTIAL"],
    "MassRules" -> First[pair], "ExternalMassRules" -> preparationExternalRules[rules],
    "OriginalExpression" -> original, "PreparedExpression" -> expression,
    "PreparedRank" -> snapshotRank[expression],
    "OriginalCandidateEligible" -> eligibleOriginal, "OriginalCandidateAdmitted" -> admittedOriginal,
    "InternalOnShellChannels" -> channels,
    "JointOnShellDotReplacements" -> jointRules, "JointInvariantFailure" -> jointRuleFailure,
    "InternalOnShellConditions" -> ((PropDen[Mom[Multiparticle @@ First[#]], Last[#]] == 0) & /@
      Select[knownInternalChannels[rules], MemberQ[channels, First[#]] &]),
    "DenominatorsKeptOffShell" -> True,
    "FeynmanConversionFailed" -> conversionFailure,
    "PolePreference" -> referenceReport,
    "RemainderData" -> preparationRemainderData[expression, reductions, history,
      referenceReport, rules, channels, kind, TrueQ[outcome]],
    "Reductions" -> reductions, "IdentitySteps" -> history,
    "GeneratedCandidates" -> generated, "InspectedCandidates" -> inspected,
    "IdentitySearchCompleted" -> identityStageComplete, "StopReason" -> stop,
    "ElapsedTime" -> AbsoluteTime[] - started, "Diagnostics" -> diagnostics|>]
];

(* Starting a local pool costs more than ordinary reduction of a small
   batch. Do not initialize the parallel tools for cold, tiny Automatic
   preparation; an existing package pool remains reusable. Explicit True
   and larger batches retain the processor and license based worker limit. *)
preparationParallelSettings[pairs_List, options_Association] := Module[
  {settings = KeyTake[options, {"Parallelization", "MaxKernels"}], leaves, small, warm},
  leaves = Total[LeafCount[Last[#]] & /@ pairs];
  small = leaves < 4000;
  warm = ListQ[$amplitudeParallelKernels] && Length[$amplitudeParallelKernels] >= 2;
  If[Lookup[settings, "Parallelization", Automatic] === Automatic && small,
    settings = Join[settings, <|"WarmOnly" -> True|>];
    If[!TrueQ[warm], settings["Parallelization"] = False]];
  settings
];

PrepareAmplitudes[items_List, model_, opts : OptionsPattern[]] := Module[
  {options, reports, prepared, external, diagnostics, details, types, pairs, inputType, process,
   feynman = TrueQ[feynmanModelQ[model]], engineModel, referencePairs,
   sourceItems = items, single = preparationPairQ[items], externalAmplitude = False,
   output = OptionValue["Output"], dispatch, worker, workerOptions, sharedReferences = None,
   jobs, completedItems = 0, resourceResolution, requestedOptions},
  If[single,
    sourceItems = {items};
    externalAmplitude = First[items] =!= {} && AllTrue[First[items],
      MatchQ[#, HoldPattern[Mass[_Integer] -> _]] &]];
  types = preparationInputType /@ sourceItems;
  If[MemberQ[types, $Failed], Message[PrepareAmplitudes::args]; Return[$Failed]];
  If[externalAmplitude && !feynman, types = {"Amplitude"}];
  pairs = MapThread[preparationInputPair, {sourceItems, types}];
  inputType = Which[types === {} || AllTrue[types, # === "Diagram" &], "Diagrams",
    types === {"Amplitude"}, "Amplitude",
    AllTrue[types, # === "FactorizationChannel" &], "FactorizationChannels", True, "Mixed"];
  options = Association[Map[Function[name, name -> OptionValue[name]],
    First /@ Options[PrepareAmplitudes]]];
  requestedOptions = options;
  resourceResolution = amplitudeAutomaticSettings["Preparation", options,
    amplitudeResourceMetrics[items, {}, options["ExternalParticles"]]];
  options = resourceResolution["Settings"];
  engineModel = If[feynman, List @@ model, model];
  If[!AllTrue[pairs, preparationPairQ] ||
      !AllTrue[pairs, preparationMassRulesConsistentQ[First[#]] &] || !preparationModelQ[engineModel] ||
      (feynman && !AllTrue[types, # === "Diagram" &]) ||
      !(AssociationQ[options["FermionHelicities"]] ||
        MatchQ[options["FermionHelicities"], {(_Rule | _RuleDelayed) ...}]) ||
      !MemberQ[{Automatic, None, "AllSpurious", "AllPhysical", "Mixed", "Xi", "Cyclic",
        "ReverseCyclic", "IndependentXi"}, options["PolePreference"]] ||
      !IntegerQ[options["MaxReferenceChoices"]] || options["MaxReferenceChoices"] < 1 ||
      !(options["ReferenceTimeConstraint"] === Automatic || options["ReferenceTimeConstraint"] === Infinity ||
        TrueQ[NumericQ[options["ReferenceTimeConstraint"]] && options["ReferenceTimeConstraint"] > 0]) ||
      !MemberQ[{True, False}, options["InternalOnShell"]] ||
      !MemberQ[{True, False}, options["MomentumConservation"]] ||
      !MemberQ[{Automatic, True, False}, options["Parallelization"]] ||
      !(options["MaxKernels"] === Automatic ||
        (IntegerQ[options["MaxKernels"]] && options["MaxKernels"] >= 1)) ||
      !MemberQ[{True, False}, options["ProgressReporting"]] ||
      !MemberQ[{True, False}, options["ReturnDetails"]] ||
      !IntegerQ[options["MaxSteps"]] || options["MaxSteps"] < 0 ||
      !IntegerQ[options["MaxCandidates"]] || options["MaxCandidates"] < 1 ||
      !(options["TimeConstraint"] === Infinity ||
        TrueQ[NumericQ[options["TimeConstraint"]] && options["TimeConstraint"] > 0]) ||
      !MemberQ[{"Amplitudes", "Expression", "Details"}, output] ||
      !(MemberQ[{Automatic, None}, options["ProgressFunction"]] ||
        MatchQ[options["ProgressFunction"], _Function | _Symbol]) ||
      Complement[First /@ {opts}, First /@ Options[PrepareAmplitudes]] =!= {},
    Message[PrepareAmplitudes::args]; Return[$Failed]];
  If[feynman,
    pairs = {feynmanExternalMassRules[First[#]], Last[#]} & /@ pairs;
    types = ConstantArray["FeynmanDiagram", Length[pairs]];
    inputType = "FeynmanDiagrams";
    If[!MemberQ[First /@ {opts}, "MaxSteps"], options["MaxSteps"] = 0];
    options["InternalOnShell"] = False];
  If[externalAmplitude, options["InternalOnShell"] = False];
  referencePairs = If[feynman || externalAmplitude,
    preparationFeynmanReferencePairs[pairs], pairs];
  external = preparationExternalRules /@ (preparationCanonicalMassRules /@ First /@ pairs);
  If[external =!= {} && !AllTrue[Rest[external], preparationExternalRulesAgreeQ[First[external], #] &],
    Message[PrepareAmplitudes::args]; Return[$Failed]];
  process = preparationExternalParticleNames[options["ExternalParticles"],
    If[external === {}, {}, First[external]], engineModel];
  If[FailureQ[process], Return[process]];
  (* Capture the constructor's current preparation phase for every worker. *)
  workerOptions = Join[options, <|"DeferExactTensorSupportPolish" ->
    TrueQ[$deferExactTensorSupportPolish]|>];
  If[feynman,
    sharedReferences = preparationSharedReferenceAssignments[pairs, engineModel,
      referencePairs, options["PolePreference"], externalAmplitude];
    If[sharedReferences["Status"] === "COMPLETE",
      AssociateTo[workerOptions, "SharedReferenceAssignments" -> sharedReferences["Assignments"]]]];
  (* Capture inert model and process data explicitly. Callback definitions are
     never distributed; subkernels receive a silent option set. The local
     fallback retains the established per-operation progress display. *)
  jobs = MapThread[Function[{index, pair, kind, source}, {index, pair, kind,
    If[kind === "FactorizationChannel",
      <|"Channel" -> source[[-3]], "Cut" -> List @@ source[[-3]], "Mass" -> source[[-2]]|>,
      <||>]}], {Range[Length[pairs]], pairs, types, sourceItems}];
  worker = With[{localOptions = workerOptions,
      silentOptions = Join[workerOptions, <|"ProgressReporting" -> False, "ProgressFunction" -> None|>],
      total = Length[pairs], localModel = engineModel,
      localInventory = ({First[#], 0} & /@ referencePairs), whole = externalAmplitude},
    Function[job, Block[{$deferExactTensorSupportPolish =
        localOptions["DeferExactTensorSupportPolish"]},
      Join[preparationOneAmplitude[job[[2]], job[[1]], total,
        If[$KernelID === 0, localOptions, silentOptions], localModel, localInventory,
        job[[3]], whole], <|"WorkerKernel" -> $KernelID|>, job[[4]]]]]];
  dispatch = amplitudeParallelMap[worker, jobs,
    preparationParallelSettings[pairs, options],
    Function[{report, index, total},
      completedItems++;
      If[Lookup[report, "WorkerKernel", 0] =!= 0,
        completionProgress[options["ProgressFunction"], options["ProgressReporting"],
          <|"Stage" -> "Preparation", "Operation" -> "Prepared item",
            "Item" -> index, "Items" -> total, "Completed" -> completedItems,
            "InputType" -> types[[index]], "WorkerKernel" -> report["WorkerKernel"],
            "Complexity" -> First[report["PreparedRank"]],
            "Terms" -> report["PreparedRank"][[2]]|>]]]];
  reports = dispatch["Results"];
  If[ListQ[process], reports = Map[Function[item, Join[item,
    <|"ExternalParticles" -> process,
      "RemainderData" -> Join[item["RemainderData"], <|"ExternalParticles" -> process|>]|>]], reports]];
  prepared = MapThread[preparationOutputItem[#1, #2, #3["PreparedExpression"]] &, {sourceItems, types, reports}];
  If[!TrueQ[options["ReturnDetails"]],
    If[output =!= "Details" && AnyTrue[reports, TrueQ[#["FeynmanConversionFailed"]] &],
      Return[Failure["FeynmanPreparation", <|"MessageTemplate" ->
        "Feynman-to-spinor conversion did not complete. Supply massless-fermion helicities if needed, or request ReturnDetails -> True for diagnostics."|>]]];
    If[output =!= "Details" &&
        AnyTrue[reports, #["StopReason"] === "ReferenceChoiceUnavailable" &],
      Return[Failure[If[feynman, "FeynmanReferences", "AmplitudeReferences"], <|"MessageTemplate" ->
        "The requested reference-spinor choice could not be applied. Use Automatic to allow a physical-reference fallback, or request ReturnDetails -> True for diagnostics.",
        "PolePreference" -> options["PolePreference"]|>]]];
    Switch[output, "Amplitudes", Return[If[single, First[prepared], prepared]],
      "Expression", Return[Total[Last /@ prepared]]]];
  diagnostics = DeleteDuplicates[Join[Flatten[Lookup[reports, "Diagnostics", {}], 1],
    Lookup[dispatch["Execution"], "Diagnostics", {}],
    If[AssociationQ[sharedReferences], sharedReferences["Diagnostics"], {}]]];
  details = <|"Status" -> If[AnyTrue[reports, #["Status"] === "PARTIAL" &], "PARTIAL", "PREPARED"],
    "InputType" -> inputType, "ElementTypes" -> types,
    "InputForm" -> If[single, "SinglePair", "List"],
    "OriginalAmplitudes" -> sourceItems, "PreparedAmplitudes" -> prepared,
    "Amplitude" -> Total[Last /@ prepared],
    "ExternalMassRules" -> If[external === {}, {}, First[external]],
    "ItemReports" -> reports,
    "RemainderData" -> Lookup[reports, "RemainderData", {}],
    "DiagramReports" -> Select[reports, MemberQ[{"Diagram", "FeynmanDiagram"}, #["InputType"]] &],
    "ChannelReports" -> Select[reports, #["InputType"] === "FactorizationChannel" &],
    "Model" -> model, "Options" -> options, "RequestedOptions" -> requestedOptions,
    "ResourcePolicy" -> resourceResolution["ResourcePolicy"], "Execution" -> dispatch["Execution"],
    "Diagnostics" -> diagnostics|>;
  If[AssociationQ[sharedReferences],
    details = Join[details, <|"SharedReferences" -> sharedReferences|>]];
  If[ListQ[process], details = Join[details, <|"ExternalParticles" -> process|>]];
  details
];
PrepareAmplitudes[___] := (Message[PrepareAmplitudes::args]; $Failed);
PrepareDiagramAmplitudes[args___] := PrepareAmplitudes[args];

End[];
End[];

(* ::Subsection::Closed:: *)
(*High-Energy Completion*)

Begin["ConstructiveDiagrams`"];

CompleteHighEnergy::usage = "CompleteHighEnergy[input, channels, model] fits a bounded set of residue-preserving correction directions to the high-energy, spurious-pole and explicit-reference conditions, then validates the complete candidate on independent samples. It uses remaining directions from CompleteFactorization details or an explicit CorrectionBasis. Automatic never invents an unrestricted contact-operator basis. ParameterRules -> Automatic uses the supplied model's variables and dependent functions; an explicit rule list overrides selected parameters without changing the symbolic amplitude. Output -> Details retains the candidate, affine family, fit equations and validation report. An incomplete result returns Failure unless Details is requested.";
CompleteHighEnergy::usage = CompleteHighEnergy::usage <>
  " RandomSeed -> Automatic chooses a time-based seed once per stage. Details records the resolved RandomSeed; an explicit integer retains reproducible sample choices. The default Output -> Amplitude returns {externalMassRules, expression}, with external mass replacements only, ready for PrepareAmplitudes or CheckAmplitudes. Output -> Expression returns the bare expression; Output -> Details is unchanged. Channels may be a channel list or a PrepareAmplitudes details report; original channel expressions remain the authoritative residue targets.";
CompleteHighEnergy::usage = CompleteHighEnergy::usage <>
  " Detailed FamilyIdentityReduction and SolvedFamilyIdentityReduction entries retain bounded exact proofs for discarded affine directions. Only ordinary external identities or a dense symbolic rational external-kinematics identity certificate remove a direction; finite samples, unsupported structures and proof timeouts never do. Genuine undetermined contact freedom remains UNDERDETERMINED, and sampled validation is not a generic uniqueness proof.";
CompleteHighEnergy::usage = CompleteHighEnergy::usage <>
  " Detailed preparation/factorization inputs preserve discarded diagram and channel shell remainders as bounded source-derived correction proposals. Their channel contour factors and sewing signs follow the residue checker. Automatic alternate parameter assignments vary independent model inputs, recompute dependent definitions and preserve explicit overrides; the fit uses the same correction coefficients across those assignments. No independent contact interaction is inferred from an unfinished or inconsistent fit.";

Options[CompleteHighEnergy] = {"CorrectionBasis" -> Automatic, "PolePreference" -> Automatic,
  "ParameterRules" -> Automatic, "Samples" -> Automatic, "ValidationSamples" -> Automatic,
  "RandomSeed" -> Automatic, "TimeConstraint" -> Automatic,
  "HighEnergyBound" -> Automatic, "MaxCorrectionTerms" -> Automatic,
  "Parallelization" -> Automatic, "MaxKernels" -> Automatic,
  "ValidationParameterRules" -> Automatic,
  "ProgressReporting" -> True, "ProgressFunction" -> Automatic,
  "Output" -> "Amplitude"};

CompleteHighEnergy[input_, channelInput : (_List | _Association), model_List,
    opts : OptionsPattern[]] := Module[{channels = channelInput},
  If[AssociationQ[channelInput],
    If[!ConstructiveDiagrams`Private`completionPreparedChannelsQ[channelInput],
      Return[ConstructiveDiagrams`Private`completionHighEnergyArgumentsFailure[
        {input, channelInput, model}]]];
    channels = channelInput["OriginalAmplitudes"]];
  ConstructiveDiagrams`Private`completionHighEnergyStage[input, channels, model,
    Join[Association[Options[CompleteHighEnergy]], Association[Reverse[{opts}]]], channelInput]
];
CompleteHighEnergy[args___] :=
  ConstructiveDiagrams`Private`completionHighEnergyArgumentsFailure[{args}];

Begin["ConstructiveDiagrams`Private`"];

(* Report argument structure without embedding an amplitude or a full model.
   Prepared channels retain their original rows as authoritative cut targets. *)
completionHighEnergyArgumentsFailure[arguments_List] := Module[
  {count = Length[arguments], invalid = {}},
  If[count < 3, invalid = Range[count + 1, 3]];
  If[count >= 2 && !(ListQ[arguments[[2]]] || completionPreparedChannelsQ[arguments[[2]]]),
    AppendTo[invalid, 2]];
  If[count >= 3 && !ListQ[arguments[[3]]], AppendTo[invalid, 3]];
  If[invalid === {} && count > 3, invalid = Range[4, count]];
  Failure["InvalidCompletionArguments", <|
    "MessageTemplate" ->
      "Expected an amplitude or completion report, a factorization-channel list or its preparation report, and a constructive model list. Inspect InvalidArgumentPositions and ArgumentHeads.",
    "ArgumentCount" -> count, "ArgumentHeads" -> (Head /@ arguments),
    "ArgumentLengths" -> (If[AtomQ[#] && !AssociationQ[#],
      Missing["NotApplicable"], Length[#]] & /@ arguments),
    "InvalidArgumentPositions" -> Sort[DeleteDuplicates[invalid]]|>]
];

completionHEMetadata[normalized_Association] := Module[{metadata, rules, legs},
  metadata = poleDiscoveryMetadata[Lookup[normalized, "Targets", {}],
    Lookup[normalized, "Records", {}]];
  If[AssociationQ[metadata], Return[metadata]];
  rules = Lookup[normalized, "ExternalMassRules", {}];
  legs = Sort[Cases[rules, HoldPattern[Mass[leg_Integer] -> _] :> leg]];
  If[Length[legs] < 4, Missing["ExternalMassMetadata"],
    <|"ExternalLegs" -> legs, "ExternalMassRules" -> rules|>]
];

completionHECoherentChart[chart_Association] := Module[
  {angle = chart["Angle"], square = chart["Square"], vectors = <||>, variables = {}, vector},
  Do[
    vector = {1, Unique["completionSpin"]};
    AppendTo[variables, Last[vector]];
    AssociateTo[vectors, leg -> vector];
    AssociateTo[angle, leg -> (chart["AngleBasis"][leg].vector)];
    AssociateTo[square, leg -> (chart["SquareBasis"][leg].vector)],
    {leg, Keys[Lookup[chart, "AngleBasis", <||>]]}];
  Join[chart, <|"Angle" -> angle, "Square" -> square,
    "ExternalSpinVectors" -> vectors, "SpinVariables" -> variables|>]
];

completionHEPolynomialRows[expression_, variables_List] := Module[{numerator, denominator, rational},
  rational = Cancel[Together[expression]];
  numerator = Expand[Numerator[rational]];
  denominator = Denominator[rational];
  If[!residueFiniteQ[numerator] || !residueFiniteQ[denominator] ||
      (variables =!= {} &&
        (!PolynomialQ[numerator, variables] || !PolynomialQ[denominator, variables])),
    Return[Failure["NonPolynomialConstraint", <||>]]];
  If[variables === {}, {numerator}, Last /@ CoefficientRules[numerator, variables]]
];

(* Keep coefficients affine in the unknown corrections. The Laurent variable
   and all coherent spin variables are eliminated, never fitted numerically. *)
(* A large coherent-spin tensor can be polynomial in correction variables
   while a generic PolynomialQ/Series first expands its kinematic coefficient
   field. Split all tensor and correction monomials exactly, then reconstruct
   the complete affine polynomial before the existing spin/Laurent row pass. *)
completionHELaurentSeries[mapped_, variable_Symbol, spinVariables_List,
    unknowns_List, order_Integer] := Module[
  {variables = Join[spinVariables, unknowns], expansion, polynomial, monomials, scaled, degree,
   scaling = Unique["laurentUnknownScale"], series},
  If[Length[spinVariables] >= 4 && unknowns =!= {} && LeafCount[mapped] >= 5000,
    expansion = highEnergyScalarCoefficientSeries[mapped, variable, variables, order];
    If[AssociationQ[expansion] && Lookup[expansion, "Status", None] === "COMPLETE",
      polynomial = Lookup[expansion, "Polynomial", <||>];
      If[!AssociationQ[polynomial], Return[Failure["UnverifiedLaurentPolynomial", <||>]]];
      monomials = Lookup[polynomial, "ComponentMonomials", Missing["NotVerified"]];
      If[!TrueQ[Lookup[polynomial, "FullCoefficientCoverage", False]] ||
          !TrueQ[Lookup[polynomial, "ReconstructionVerified", False]] ||
          !TrueQ[Lookup[polynomial, "ConstantCoefficientIncluded", False]] ||
          !ListQ[monomials] || Lookup[expansion, "CompletedComponents", None] =!= Length[monomials] ||
          Lookup[expansion, "ComponentCount", None] =!= Length[monomials] ||
          Lookup[polynomial, "ComponentCount", None] =!= Length[monomials] || !AllTrue[monomials,
          ListQ[#] && Length[#] === Length[variables] && AllTrue[#, IntegerQ[#] && # >= 0 &] &],
        Return[Failure["UnverifiedLaurentPolynomial", <||>]]];
      If[AnyTrue[monomials, Total[Drop[#, Length[spinVariables]]] > 1 &],
        Return[Failure["NonlinearCorrectionFamily", <||>]]];
      Return[<|"Series" -> expansion["Series"],
        "Method" -> "ExactSparseCoherentAndCorrectionCoefficientsBeforeLaurent",
        "FullAffineReconstruction" -> True,
        "CoefficientExpansion" -> KeyDrop[expansion, "Series"]|>]]];
  (* Preserve the legacy route for small, unsupported or nonpolynomial spin
     sectors. Unknowns may never occur in denominators or nonlinear products. *)
  If[unknowns =!= {},
    If[!PolynomialQ[mapped, unknowns], Return[Failure["UnsupportedLinearKinematics", <||>]]];
    scaled = mapped /. Thread[unknowns -> (scaling unknowns)];
    degree = If[scaled === 0, 0, Exponent[scaled, scaling]];
    If[!IntegerQ[degree] || degree > 1, Return[Failure["NonlinearCorrectionFamily", <||>]]]];
  series = highEnergyCertifiedScalarSeries[mapped, variable, order];
  If[!AssociationQ[series], Return[Failure["UnsupportedLaurentExpansion", <||>]]];
  If[Lookup[series, "Status", None] =!= "COMPLETE",
    Return[Failure["UnsupportedLaurentExpansion",
      <|"ScalarSeriesDiagnostic" -> KeyDrop[series, "Series"]|>]]];
  <|"Series" -> series["Series"], "Method" -> "ExactWholeLaurentExpansion",
    "FullAffineReconstruction" -> True,
    "ZeroAssumptionCertificates" -> series["ZeroAssumptionCertificates"]|>
];

(* Estimate tensor work without expanding its kinematic coefficient field.
   Three spin-one legs have 27 components, exceeding four spin-half legs. *)
completionHECoherentComponentDegrees[expression_, variables_List] := Module[
  {zero = ConstantArray[0,Length[variables]], degree, result, tag = Unique["spinDegree"]},
  degree[value_] /; FreeQ[value,Alternatives@@variables] := zero;
  degree[value_Symbol] /; MemberQ[variables,value] :=
    ReplacePart[zero,First[FirstPosition[variables,value]]->1];
  degree[value_Plus] := Max /@ Transpose[degree /@ (List@@value)];
  degree[value_Times] := Total[degree /@ (List@@value)];
  degree[Power[value_,n_Integer]] /; n>=0 := n degree[value];
  degree[_] := Throw[Missing["NonpolynomialSpinDependence"],tag];
  Catch[degree[expression],tag]
];

completionHECoherentComponentBound[expression_, variables_List] := Module[{degrees},
  degrees=completionHECoherentComponentDegrees[expression,variables];
  If[MissingQ[degrees],degrees,Times@@(degrees+1)]
];

(* Keep the sparse spin/correction polynomial separated through Laurent
   extraction. Reconstructing its whole multivariate rational expression and
   applying Together again can cost far more than all scalar series combined.
   Rows are grouped by spin monomial AND Laurent power; correction parameters
   stay coupled in each row, including the constant affine coefficient. *)
completionHEStreamingLaurentRows[mapped_, variable_Symbol, spinVariables_List,
    unknowns_List, threshold_] := Module[
  {arrays, affineParts, affineMonomials, polynomial, components={}, monomials,
   polynomialProofs={},
   order=Max[0,Ceiling[threshold]], rows=<||>, scalar, value, lowest, key, affine,
   previous, completed=0, certificates={}, tag=Unique["streamingLaurent"]},
  Catch[
  (* CoefficientArrays separates only the affine correction coordinates. It
     neither mixes their equations nor expands the large spin tensor in the
     same convolution. Indexed free coefficients remain valid coordinates. *)
  arrays=If[unknowns==={}, {mapped},
    TimeConstrained[Quiet[Check[CoefficientArrays[mapped,unknowns],$Failed]],10,$TimedOut]];
  If[!ListQ[arrays] || arrays==={} || Length[arrays]>2,
    Return[Failure["UnsupportedStreamingAffineDecomposition",<||>]]];
  affineParts=Prepend[If[Length[arrays]===2,Normal[arrays[[2]]],
    ConstantArray[0,Length[unknowns]]],Normal[First[arrays]]];
  If[Length[affineParts]=!=Length[unknowns]+1 ||
      !FreeQ[affineParts,Alternatives@@unknowns],
    Return[Failure["UnverifiedStreamingAffineCoverage",<||>]]];
  affineMonomials=Prepend[IdentityMatrix[Length[unknowns]],ConstantArray[0,Length[unknowns]]];
  Do[
    polynomial=amplitudeCoherentPolynomialRules[affineParts[[i]],spinVariables,10];
    If[Lookup[polynomial,"Status",None]=!="COMPLETE" ||
        !TrueQ[Lookup[polynomial,"FullCoefficientCoverage",False]] ||
        !TrueQ[Lookup[polynomial,"ReconstructionVerified",False]] ||
        !TrueQ[Lookup[polynomial,"ConstantCoefficientIncluded",False]],
      Throw[Failure["UnsupportedStreamingPolynomial",<|"Polynomial"->KeyDrop[polynomial,"CoefficientRules"]|>],tag]];
    monomials=First/@polynomial["CoefficientRules"];
    If[Length[monomials]=!=polynomial["ComponentCount"] ||
        monomials=!=polynomial["ComponentMonomials"] ||
        !AllTrue[monomials,ListQ[#] && Length[#]===Length[spinVariables] &&
          AllTrue[#,IntegerQ[#] && #>=0&]&],
      Throw[Failure["UnverifiedStreamingAffineCoverage",<||>],tag]];
    components=Join[components,({Join[First[#],affineMonomials[[i]]],Last[#]}& /@
      polynomial["CoefficientRules"])];
    AppendTo[polynomialProofs,KeyDrop[polynomial,"CoefficientRules"]],
    {i,Length[affineParts]}];
  If[Length[polynomialProofs]=!=Length[affineParts],
    Return[Failure["IncompleteStreamingAffineCoverage",<||>]]];
  Do[
    scalar=highEnergyCertifiedScalarSeries[Last[component],variable,order];
    If[Lookup[scalar,"Status",None]=!="COMPLETE",
      Throw[Failure["UncertifiedStreamingScalarSeries",<|
        "ScalarSeriesDiagnostic"->KeyDrop[scalar,"Series"],"CompletedComponents"->completed|>],tag]];
    value=Expand[Normal[scalar["Series"]]];
    If[!residueFiniteQ[value] || !FreeQ[value,_Series|_ConditionalExpression],
      Throw[Failure["UnsupportedStreamingLaurentExpansion",<||>],tag]];
    If[scalar["ZeroAssumptionCertificates"]=!={},AppendTo[certificates,
      <|"Monomial"->First[component],"Certificates"->scalar["ZeroAssumptionCertificates"]|>]];
    If[value=!=0,
      lowest=Exponent[value,variable,Min];
      If[!IntegerQ[lowest] || !PolynomialQ[Expand[value variable^Max[0,-lowest]],variable],
        Throw[Failure["NonintegerStreamingLaurentExpansion",<||>],tag]];
      affine=Times@@MapThread[Power,{unknowns,Drop[First[component],Length[spinVariables]]}];
      Do[
        key={power,Take[First[component],Length[spinVariables]]};
        previous=If[KeyExistsQ[rows,key],rows[[Key[key]]],0];
        AssociateTo[rows,key->(previous+affine Coefficient[value,variable,power])],
        {power,lowest,Ceiling[threshold]-1}]];
    completed++,{component,components}];
  rows=Select[rows,#=!=0&];
  <|"Status"->"COMPLETE","Rows"->Values[rows],
    "Method"->"ExactStreamingAffineSpinLaurentCoefficients",
    "ComponentCount"->Length[components],"CompletedComponents"->completed,
    "FullCoefficientCoverage"->True,"FullAffineReconstruction"->True,
    "RowKeys"->Keys[rows],"ZeroAssumptionCertificates"->certificates,
    "AffineDecompositionCertificate"-><|"Method"->"ExactCoefficientArrays",
      "DegreeAtMostOne"->True,"OriginalCoordinates"->unknowns,
      "ConstantCoefficientIncluded"->True,"CoefficientIndependenceVerified"->True|>,
    "PolynomialCertificates"->polynomialProofs|>,tag]
];

completionHELaurentRows[mapped_, variable_, spinVariables_List, unknowns_List,
    threshold_] := Catch[Module[{order, series, polynomial, lowest, rows = {}, coefficients, seriesReport,
      streaming, componentBound, jets},
  If[!residueFiniteQ[mapped] || residueUnmappedQ[mapped],
    Return[Failure["UnsupportedLinearKinematics", <||>]]];
  If[highEnergyLaurentJetEligibleQ[mapped,spinVariables],
    jets=completionHELaurentJetRows[mapped,variable,spinVariables,unknowns,threshold];
    If[AssociationQ[jets] && Lookup[jets,"Status",None]==="COMPLETE",Return[jets["Rows"]]];
    If[MatchQ[jets,Failure["JetUncertifiedAtomSeries",_Association]],Return[jets]]];
  If[spinVariables=!={} && unknowns=!={} && LeafCount[mapped]>=5000,
    componentBound=If[Length[spinVariables]>=4,16,
      completionHECoherentComponentBound[mapped,spinVariables]];
    If[IntegerQ[componentBound] && componentBound>=16,
      streaming=completionHEStreamingLaurentRows[mapped,variable,spinVariables,unknowns,threshold];
      If[AssociationQ[streaming] && Lookup[streaming,"Status",None]==="COMPLETE",
        Return[streaming["Rows"]]];
      (* A rejected scalar-series certificate must not be hidden by fallback. *)
      If[MatchQ[streaming,Failure["UncertifiedStreamingScalarSeries",_Association]],Return[streaming]]]];
  order = Max[0, Ceiling[threshold]];
  seriesReport = completionHELaurentSeries[mapped, variable, spinVariables, unknowns, order];
  If[FailureQ[seriesReport], Return[seriesReport]];
  series = seriesReport["Series"];
  If[!residueFiniteQ[series] || !FreeQ[series, _Series | _ConditionalExpression],
    Return[Failure["UnsupportedLaurentExpansion", <||>]]];
  polynomial = Expand[Normal[series]];
  lowest = If[polynomial === 0, order + 1, Exponent[polynomial, variable, Min]];
  If[!IntegerQ[lowest] || !PolynomialQ[Expand[polynomial variable^Max[0, -lowest]], variable],
    Return[Failure["NonintegerLaurentExpansion", <||>]]];
  Do[
    coefficients = completionHEPolynomialRows[Coefficient[polynomial, variable, power],
      spinVariables];
    If[FailureQ[coefficients], Throw[coefficients]];
    rows = Join[rows, coefficients], {power, lowest, Ceiling[threshold] - 1}];
  If[unknowns === {}, Select[rows, highEnergyZeroState[#] =!= "Zero" &],
    (* Unsolved affine coefficients are not algebraic numbers. Defer exact
       coefficient zero tests until the common linear solver separates them. *)
    DeleteCases[rows, 0]]
]];

(* A later high-energy chart only needs the affine family left by earlier
   exact charts. Keep those earlier equations in their original coordinates;
   the restricted new equations then define the same simultaneous intersection. *)
completionHEEnergyAffineRestriction[originalTrial_, originalVariables_List,
    previous_Association, equations_List, retainedEquations_List, seconds_: 2] := Module[
  {fallback = Missing["NoCertifiedAffineRestriction"], work},
  If[!TrueQ[seconds > 0] || equations === {}, Return[fallback]];
  work[] := Module[{fit, free, rules, pivots, mapped, arrays, replay},
    fit = completionRefineLinear[previous, equations, seconds];
    If[AssociationQ[fit] && Lookup[fit, "Status", None] === "INCONSISTENT",
      Return[<|"Status" -> "INCONSISTENT", "LinearSystem" -> fit,
        "InconsistencyCertificate" -> <|"Method" -> "ExactAffineLinearContradiction",
          "OriginalCoordinates" -> originalVariables,
          "PriorAffineRestrictionRules" -> Lookup[previous, "SolutionRules", {}],
          "WorkingCoordinates" -> Lookup[previous, "FreeParameters", {}],
          "ReachedEquations" -> retainedEquations, "LinearSystem" -> fit,
          "UncheckedChartsClaimed" -> False|>|>]];
    If[!AssociationQ[fit] || !MemberQ[{"COMPLETE", "UNDERDETERMINED"},
        Lookup[fit, "Status", None]], Return[fallback]];
    free = Lookup[fit, "FreeParameters", {}]; rules = Lookup[fit, "SolutionRules", {}];
    If[Length[free] >= Length[previous["FreeParameters"]] || !ListQ[rules] ||
        !AllTrue[rules, MatchQ[#, _Rule] &], Return[fallback]];
    pivots = First /@ rules;
    If[!DuplicateFreeQ[pivots] ||
        Select[originalVariables, !MemberQ[pivots, #] &] =!= free ||
        (free /. rules) =!= free || Lookup[fit, "Rank", None] =!= Length[pivots],
      Return[fallback]];
    mapped = originalVariables /. rules;
    If[pivots =!= {} && !FreeQ[mapped, Alternatives @@ pivots], Return[fallback]];
    arrays = Quiet[Check[CoefficientArrays[mapped, free], $Failed]];
    If[!ListQ[arrays] || Length[arrays] > 2, Return[fallback]];
    (* Replay every retained equation over every free coordinate, never just
       at the representative with free coefficients set to zero. The exact
       solver's pivot rank and identity free-coordinate projection retain its
       complete nullspace in the original coefficient coordinates. *)
    replay = retainedEquations /. rules;
    If[!AllTrue[replay, completionPolynomialZeroQ[#, free] &], Return[fallback]];
    <|"FamilyAmplitude" -> (originalTrial /. rules), "FreeParameters" -> free,
      "LinearSystem" -> fit,
      "Certificate" -> <|"Method" -> "ExactSequentialAffineSolveAndWholeFamilyReplay",
        "OriginalCoordinates" -> originalVariables, "PivotCoordinates" -> pivots,
        "FreeCoordinates" -> free, "SolutionRules" -> rules, "Rank" -> fit["Rank"],
        "RetainedEquationCount" -> Length[retainedEquations],
        "EveryRetainedEquationVerified" -> True,
        "AffineMapDegreeAtMostOne" -> True,
        "FreeCoordinateProjectionIdentityVerified" -> True,
        "FullNullspaceRetained" -> True, "UnknownCoordinatesChanged" -> False|>|>
  ];
  TimeConstrained[work[], seconds, fallback]
];

(* Expand the typed affine sources before substituting an energy chart. This
   shares repeated short spinor monomials without changing their coefficients
   or assigning independent correction parameters to the expanded atoms. *)
completionHEAffineAtomLaurentEligibleQ[trial_, unknowns_List, metadata_Association] := Module[
  {metrics, degrees},
  If[Length[unknowns] <= 16 || LeafCount[trial] < 30000 || !FreeQ[trial, _Real], Return[False]];
  metrics = amplitudeResourceMetrics[<|"Amplitude" -> trial,
    "ExternalMassRules" -> Lookup[metadata, "ExternalMassRules", {}]|>];
  degrees = Values[Lookup[metrics, "CoherentSpinDegrees", <||>]];
  Lookup[metrics, "CoherentComponents", 1] >= 27 && AnyTrue[degrees, # >= 2 &]
];

completionHEAffineAtomLaurentRows[trial_, chart_Association, rules_List,
    unknowns_List, threshold_, seconds_:60] := Module[
  {started = AbsoluteTime[], tag = Unique["affineAtomLaurent"], remaining, result,
   scalar, monomial, work, sourceParts = 0, completed = 0, scalarCacheReport,
   chartSeconds = Min[seconds, 240], workloadBudget = Min[seconds, 240]},
  remaining[] := Max[0, chartSeconds - (AbsoluteTime[] - started)];
  work[] := Catch[Module[
    {arrays, parts, expanded, terms, atoms, positions, coefficients, entries, sourceMap,
     reconstruction, variable = chart["PoleVariable"], spins = chart["SpinVariables"],
     order = Max[0, Ceiling[threshold]], atomJets = {}, atomCertificates = {}, atom,
     mapped, report, record, coefficientRows = {}, keys, keyPositions, atomMatrix,
     matrix, canonical, selected, rows, certificates = {}, finite, data, power, value,
     jetStarted, jetSeconds, composeStarted, composeSeconds, exactMap = True,
     protected, masses, massRules, specializedTrial, specialization},
    (* This is one fixed fitting assignment, not a symbolic rewrite of the
       retained amplitude family. Substitute typed external masses and the
       supplied scalar parameters before affine expansion. Reject a rule that
       touches a correction coordinate or chart variable before mapping. *)
    protected = Join[unknowns, {variable}, spins];
    If[!AllTrue[rules, MatchQ[#, Rule[_Symbol | _ModelParameter, _]] &] ||
        !FreeQ[rules, Alternatives @@ protected] || (protected /. rules) =!= protected,
      Throw[Missing["TypedAtomParameterCoordinateCollision"], tag]];
    masses = Lookup[chart, "Masses", <||>];
    If[!AssociationQ[masses], Throw[Missing["TypedAtomExternalMassMetadata"], tag]];
    massRules = KeyValueMap[(Mass[#1] -> #2) &, KeySelect[masses, IntegerQ]];
    If[!FreeQ[massRules, Alternatives @@ protected] || (protected /. massRules) =!= protected,
      Throw[Missing["TypedAtomMassCoordinateCollision"], tag]];
    If[!AllTrue[Last /@ Join[rules, massRules], NumericQ[#] &&
        FreeQ[#, _Real] && residueFiniteQ[#] &],
      Throw[Missing["NonNumericTypedAtomFittingAssignment"], tag]];
    specializedTrial = (trial /. massRules) /. rules;
    If[!FreeQ[specializedTrial, _Real] || !residueFiniteQ[specializedTrial],
      Throw[Missing["InexactTypedAtomFittingAssignment"], tag]];
    specialization = <|"Method" -> "ExactTypedScalarSubstitutionAtOneFitAssignment",
      "ScopedParameterRules" -> rules, "TypedExternalMassRules" -> massRules,
      "OriginalInputLeaves" -> LeafCount[trial],
      "SpecializedInputLeaves" -> LeafCount[specializedTrial],
      "OriginalCoordinates" -> unknowns, "CoordinateCollisionRejected" -> True,
      "NoGlobalIntegerReplacement" -> True,
      "SymbolicFamilyOutsideFitterUnchanged" -> True,
      "AcrossParameterAssignmentIdentityClaimed" -> False|>;
    If[specializedTrial === 0, Return[<|"Status"->"COMPLETE", "Rows"->{}, "RowKeys"->{},
      "Method"->"ExactTypedAffineAtomsBeforeEnergyMapping",
      "OriginalCoordinates"->unknowns, "SourceParts"->Length[unknowns]+1,
      "AtomCount"->0, "CompletedAtoms"->0, "ExactAffineReconstruction"->True,
      "FullCoefficientCoverage"->True, "FittingParameterSpecialization"->specialization,
      "ChartTimeConstraint"->Min[seconds,240], "ZeroAssumptionCertificates"->{},
      "Certificate"-><|"EveryOriginalAffinePartReconstructed"->True,
        "EverySpecializedAffinePartReconstructed"->True,
        "ReconstructionScope"->"OriginalAffineFamilyAtRecordedFittingAssignment",
        "SpecializedInputLiterallyZero"->True, "ConstantPartIncluded"->True,
        "AllOriginalCoordinatesRetained"->True, "NoNonzeroRowScaling"->True|>|>]];
    arrays = Quiet[Check[CoefficientArrays[specializedTrial, unknowns], $Failed]];
    If[!ListQ[arrays] || arrays === {} || Length[arrays] > 2,
      Throw[Missing["NoAffineTypedAtomMap"], tag]];
    parts = Prepend[If[Length[arrays] === 2, Normal[arrays[[2]]],
      ConstantArray[0, Length[unknowns]]], Normal[First[arrays]]];
    sourceParts = Length[parts];
    If[Length[parts] =!= Length[unknowns]+1 || !FreeQ[parts, Alternatives @@ unknowns] ||
        LeafCount[parts] > 4000000, Throw[Missing["TypedAtomAffineGuard"], tag]];
    expanded = Expand /@ parts;
    terms = If[Head[#] === Plus, List @@ #, If[# === 0, {}, {#}]] & /@ expanded;
    If[Total[Length /@ terms] > 65536 || !FreeQ[terms, _Real],
      Throw[Missing["TypedAtomExpansionGuard"], tag]];
    scalar[term_] := scalar[term] = Times @@ Select[
      If[Head[term] === Times, List @@ term, {term}], NumericQ[#] &&
        Precision[#] === Infinity && residueFiniteQ[#] &];
    monomial[term_] := monomial[term] = Cancel[term/scalar[term]];
    atoms = DeleteDuplicates[monomial /@ Flatten[terms, 1]];
    If[Length[atoms] > 4096 || atoms === {}, Throw[Missing["TypedAtomCatalogGuard"], tag]];
    (* Match the local chart allowance to the certified catalog workload. The
       caller's outer stage deadline still bounds all work, and explicit
       shorter chart limits are never enlarged. *)
    workloadBudget = Min[seconds, 240, Max[60, 20 + 2 Length[atoms]/25]];
    chartSeconds = workloadBudget;
    positions = AssociationThread[atoms, Range[Length[atoms]]];
    coefficients = GroupBy[({positions[[Key[monomial[#]]]], scalar[#]} &) /@ #,
      First -> Last, Total] & /@ terms;
    entries = Flatten[MapIndexed[Function[{row,index}, KeyValueMap[
      ({First[index],#1} -> #2) &, row]], coefficients], 1];
    sourceMap = SparseArray[entries, {Length[parts], Length[atoms]}];
    reconstruction = MapThread[TrueQ[Expand[#1-#2] === 0] &, {parts, sourceMap.atoms}];
    If[!And @@ reconstruction, Throw[Missing["UnverifiedTypedAtomReconstruction"], tag]];
    jetStarted = AbsoluteTime[];
    Do[If[remaining[] <= 0, Throw[Missing["TypedAtomTimeConstraint"], tag]];
      mapped = residueEvaluateChart[atom, chart, rules];
      report = highEnergyLaurentJetCoefficients[mapped, variable, spins, {}, order,
        Max[12,order+8], Min[5, Max[0.000001,remaining[]]]];
      If[MatchQ[report, Failure["JetUncertifiedAtomSeries", _Association]], Throw[report, tag]];
      If[!highEnergyLaurentJetVerifiedQ[report, variable, spins, {}, order],
        Throw[Missing["UnverifiedTypedAtomJet"], tag]];
      AppendTo[atomJets, First[report["CoefficientJets"]]];
      certificates = Join[certificates, Lookup[report,"ZeroAssumptionCertificates",{}]];
      AppendTo[atomCertificates, KeyTake[report, {"ComponentCount", "RequestedOrder",
        "FullCoefficientCoverage", "FullAffineReconstruction", "Certificate"}]];
      completed++, {atom, atoms}];
    jetSeconds = AbsoluteTime[] - jetStarted;
    (* Every atom's complete jet has passed before any finite coefficient is
       extracted. Fractional powers remain unsupported, rather than ignored. *)
    finite[jetRecord_Association] := Module[{out = <||>},
      KeyValueMap[Function[{spin,jet},
        If[Head[jet] === SeriesData,
          data = List @@ jet;
          Do[power = (data[[4]]+j-1)/data[[6]]; value = data[[3,j]];
            If[value =!= 0 && !IntegerQ[power], Throw[Missing["NonIntegerTypedAtomLaurentPower"], tag]];
            If[value =!= 0 && power < Ceiling[threshold], AssociateTo[out,{power,spin}->value]],
            {j,Length[data[[3]]]}],
          If[jet =!= 0,
            If[!FreeQ[jet,variable], Throw[Missing["UnexpandedTypedAtomJet"], tag]];
            If[0 < Ceiling[threshold], AssociateTo[out,{0,spin}->jet]]]]], jetRecord]; out];
    coefficientRows = finite /@ atomJets;
    keys = Union @@ (Keys /@ coefficientRows);
    If[keys === {}, Return[<|"Status"->"COMPLETE", "Rows"->{}, "RowKeys"->{},
      "Method"->"ExactTypedAffineAtomsBeforeEnergyMapping",
      "OriginalCoordinates"->unknowns, "AtomCount"->Length[atoms],
      "FittingParameterSpecialization"->specialization, "ChartTimeConstraint"->Min[seconds, 240], "ChartWorkloadBudget"->workloadBudget,
      "ChartWorkloadEstimate"-><|"AtomCount"->Length[atoms], "BaseSeconds"->20,
        "SecondsPerAtom"->2/25, "MinimumSeconds"->60, "MaximumSeconds"->240,
        "RequestedChartTimeConstraint"->seconds|>,
      "ExactAffineReconstruction"->True, "FullCoefficientCoverage"->True,
      "ZeroAssumptionCertificates"->certificates|>]];
    keyPositions = AssociationThread[keys,Range[Length[keys]]];
    atomMatrix = SparseArray[Flatten[MapIndexed[Function[{row,index},KeyValueMap[
      ({First[index],keyPositions[[Key[#1]]]}->#2)&,row]],coefficientRows],1],
      {Length[atoms],Length[keys]}];
    composeStarted = AbsoluteTime[];
    matrix = Transpose[Normal[sourceMap.atomMatrix]];
    composeSeconds = AbsoluteTime[]-composeStarted;
    canonical = completionCanonicalNumericCoefficientMatrix[matrix, Max[0.000001,remaining[]]];
    If[!AssociationQ[canonical] || Lookup[canonical,"Status",None] =!= "COMPLETE",
      Throw[Missing["UncertifiedTypedAtomNumericComposition"],tag]];
    matrix = canonical["Matrix"];
    rows = Map[First[#]+Rest[#].unknowns&,matrix];
    selected = Flatten[Position[rows,Except[0],{1},Heads->False]];
    <|"Status"->"COMPLETE", "Rows"->rows[[selected]], "RowKeys"->keys[[selected]],
      "Method"->"ExactTypedAffineAtomsBeforeEnergyMapping",
      "OriginalCoordinates"->unknowns, "SourceParts"->Length[parts], "AtomCount"->Length[atoms],
      "FittingParameterSpecialization"->specialization, "ChartTimeConstraint"->Min[seconds, 240], "ChartWorkloadBudget"->workloadBudget,
      "ChartWorkloadEstimate"-><|"AtomCount"->Length[atoms], "BaseSeconds"->20,
        "SecondsPerAtom"->2/25, "MinimumSeconds"->60, "MaximumSeconds"->240,
        "RequestedChartTimeConstraint"->seconds|>,
      "CompletedAtoms"->completed, "ExactAffineReconstruction"->True,
      "FullCoefficientCoverage"->True, "AtomJetSeconds"->jetSeconds,
      "ExactCompositionSeconds"->composeSeconds,
      "ZeroAssumptionCertificates"->certificates,
      "NumericComposition"->KeyDrop[canonical,"Matrix"],
      "Certificate"-><|"EveryOriginalAffinePartReconstructed"->And@@reconstruction,
        "ReconstructionScope"->"OriginalAffineFamilyAtRecordedFittingAssignment",
        "EverySpecializedAffinePartReconstructed"->And@@reconstruction,
        "ConstantPartIncluded"->True, "AllOriginalCoordinatesRetained"->True,
        "NoIndependentAtomCorrectionParameters"->True,
        "AllAtomJetCertificatesVerified"->True, "NormalOnlyAfterFullCoverage"->True,
        "SameConservedEnergyChartForAllAtoms"->True,
        "NumericCoefficientReplay"->canonical["Certificate"]|>|>
  ],tag];
  (* Each call describes one fixed chart and parameter assignment. Block
     restores prior state on completion, timeout and abort; nothing is shared
     with the next chart, model or construction. *)
  result = Block[{$highEnergyScalarSeriesCache = <||>,
      $highEnergyScalarSeriesCacheStatistics = <|"Hits" -> 0, "Misses" -> 0, "Stores" -> 0|>},
    With[{answer = Internal`WithLocalSettings[Null,
        TimeConstrained[MemoryConstrained[work[],805306368,Missing["TypedAtomMemoryGuard"]],
          Min[seconds, 240],Missing["TypedAtomTimeConstraint"]], Clear[scalar,monomial]]},
      scalarCacheReport = Join[$highEnergyScalarSeriesCacheStatistics,
        <|"Entries" -> Length[$highEnergyScalarSeriesCache], "EntryLimit" -> 4096,
          "ExactExpressionVariableOrderKeys" -> True,
          "OnlyCompleteCertifiedSeries" -> True, "Scope" -> "SingleEnergyChart"|>];
      answer]];
  If[AssociationQ[result],Join[result,<|"ElapsedTime"->AbsoluteTime[]-started,
    "ScalarSeriesCache" -> scalarCacheReport|>],result]
];

(* A guarded affine tensor can exceed the coefficient-array size bound while
   each coordinate block remains small. Keep one center and every original
   coordinate, then sum exact Laurent coefficients before solving anything. *)
completionHEAffineChunkLaurentRows[trial_, chart_Association, rules_List,
    unknowns_List, threshold_, seconds_:240, chunkSize_:32] := Module[
  {started=AbsoluteTime[], limit=Min[seconds,240], groups, center, chunks, degree,
   allowed=Alternatives@@unknowns, tag=Unique["affineChunk"], replay, reports={},
   remaining, rows=<||>, key, value, report, inputDegree, work, result,
   freeze, token, positions=<||>, restoreRules={}, frozen, frozenChunks, roundTrip},
  remaining[]:=Max[0,limit-(AbsoluteTime[]-started)];
  degree[value_] /; MemberQ[unknowns,value] := 1;
  degree[value_] /; FreeQ[value,allowed] := 0;
  degree[value_Plus] := Max[degree /@ (List@@value)];
  degree[value_Times] := Total[degree /@ (List@@value)];
  degree[Power[base_,n_Integer]] /; n>=0 := n degree[base];
  degree[_] := Throw[Missing["NonAffineChunkInput"],tag];
  work[]:=Catch[
    If[!IntegerQ[chunkSize] || chunkSize<1 || !TrueQ[limit>0] || unknowns==={} ||
        !DuplicateFreeQ[unknowns], Throw[Missing["AffineChunkArguments"],tag]];
    inputDegree=TimeConstrained[degree[trial],Min[5,remaining[]],Missing["AffineDegreeBudget"]];
    If[!MemberQ[{0,1},inputDegree],Throw[Missing["NonAffineChunkInput"],tag]];
    groups=Partition[unknowns,UpTo[chunkSize]];
    If[Flatten[groups]=!=unknowns,Throw[Missing["AffineChunkCoordinateCoverage"],tag]];
    (* Freeze only maximal coefficients independent of all formal unknowns.
       Projection and its proof then occur in a small exact polynomial ring;
       no spinor or propagator coefficient is expanded or changed. *)
    token[coefficient_]:=Module[{held=HoldComplete[coefficient],symbol},
      If[KeyExistsQ[positions,held],positions[[Key[held]]],
        symbol=Unique["affineChunkCoefficient"];
        AssociateTo[positions,held->symbol];AppendTo[restoreRules,symbol->coefficient];symbol]];
    freeze[value_] /; MemberQ[unknowns,value] := value;
    freeze[value_?NumberQ] := value;
    freeze[value_] /; FreeQ[value,allowed] := token[value];
    freeze[value_Plus] := Plus@@(freeze /@ (List@@value));
    freeze[value_Times] := Times@@(freeze /@ (List@@value));
    freeze[Power[base_,n_Integer]] /; n>=0 := freeze[base]^n;
    freeze[_] := Throw[Missing["UnsupportedAffineChunkProjection"],tag];
    frozen=freeze[trial];roundTrip=(frozen/.restoreRules)===trial;
    If[!TrueQ[roundTrip],Throw[Missing["UnverifiedAffineCoefficientRoundTrip"],tag]];
    center=frozen/.Thread[unknowns->0];
    frozenChunks=MapIndexed[Function[{group,index},
      (frozen/.Thread[Select[unknowns,!MemberQ[group,#]&]->0])-
        If[First[index]===1,0,center]],groups];
    replay=TimeConstrained[Expand[frozen-Total[frozenChunks]],Min[15,remaining[]],
      Missing["AffineChunkReconstructionBudget"]];
    If[replay=!=0,Throw[Missing["UnverifiedWholeChunkReconstruction"],tag]];
    chunks=frozenChunks/.restoreRules;
    Do[
      If[remaining[]<=0,Throw[Missing["AffineChunkTimeConstraint"],tag]];
      report=completionHEAffineAtomLaurentRows[chunks[[i]],chart,rules,
        groups[[i]],threshold,remaining[]];
      If[MissingQ[report] || FailureQ[report],Throw[report,tag]];
      If[!AssociationQ[report] || Lookup[report,"Status",None]=!="COMPLETE",
        Throw[Missing["IncompleteAffineChunk"],tag]];
      If[Lookup[report,"OriginalCoordinates",None]=!=groups[[i]] ||
          !TrueQ[Lookup[report,"ExactAffineReconstruction",False]] ||
          !TrueQ[Lookup[report,"FullCoefficientCoverage",False]] ||
          Length[Lookup[report,"Rows",{}]]=!=Length[Lookup[report,"RowKeys",{}]],
        Throw[Missing["UnverifiedAffineChunk"],tag]];
      If[report["Rows"]=!={} && !TrueQ[Lookup[Lookup[Lookup[report,
          "NumericComposition",<||>],"Certificate",<||>],"NoNonzeroRowScaling",False]],
        Throw[Missing["UnverifiedChunkRowUnits"],tag]];
      Do[key=report["RowKeys"][[j]];value=report["Rows"][[j]];
        AssociateTo[rows,key->(Lookup[rows,Key[key],0]+value)],
        {j,Length[report["Rows"]]}];
      AppendTo[reports,KeyDrop[report,{"Rows","RowKeys"}]],{i,Length[groups]}];
    rows=Select[Map[Together,rows],#=!=0&];
    <|"Status"->"COMPLETE","Method"->"ExactCoordinateBlocksBeforeEnergyMapping",
      "Rows"->Values[rows],"RowKeys"->Keys[rows],"OriginalCoordinates"->unknowns,
      "ExactAffineReconstruction"->True,"FullCoefficientCoverage"->True,
      "ChunkSize"->chunkSize,"ChunkCount"->Length[groups],"CompletedChunks"->Length[reports],
      "Chunks"->reports,"ChartTimeConstraint"->limit,
      "Certificate"-><|"OriginalInputAffineDegree"->inputDegree,
        "WholeChunkReconstructionResidual"->replay,
        "WholeChunkReconstructionMethod"->"ExactReversibleOpaqueCoefficientProjection",
        "OpaqueCoefficientRoundTripVerified"->roundTrip,
        "OpaqueCoefficientRules"->restoreRules,"FrozenFamily"->frozen,
        "FrozenChunks"->frozenChunks,
        "CenterIncludedOnce"->True,
        "EveryCoordinateRetainedExactlyOnce"->True,"OriginalCoordinateOrderRetained"->True,
        "AllBlocksComplete"->True,"NoNonzeroRowScaling"->True,
        "LaurentKeysSummedBeforeSolve"->True,"NoIndependentChunkCorrectionParameters"->True,
        "OneSharedDeadline"->True|>|>,tag];
  result=TimeConstrained[MemoryConstrained[work[],805306368,
    Missing["AffineChunkMemoryGuard"]],Max[0,limit],Missing["AffineChunkTimeConstraint"]];
  If[AssociationQ[result],Join[result,<|"ElapsedTime"->AbsoluteTime[]-started|>],result]
];

completionHEEnergyConstraints[trial_, unknowns_List, metadata_Association,
    samples_Integer, seed_Integer, rules_List, bound_, callback_, enabled_] := Catch[Module[
  {rows = {}, charts = {}, chart, mapped, coefficients, workingTrial = trial,
   workingUnknowns = unknowns, partial, restriction, priorRules, reductions = {}, atomic, atomicStarted, atomicChunkAttempted=False},
  partial = <|"Status" -> If[unknowns === {}, "COMPLETE", "UNDERDETERMINED"],
    "SolutionRules" -> {}, "FreeParameters" -> unknowns, "Rank" -> 0, "Diagnostics" -> {}|>;
  Do[
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
      "Phase" -> "EnergyConstraints", "Current" -> sample, "Total" -> samples,
      "Unknowns" -> Length[workingUnknowns]|>];
    priorRules = partial["SolutionRules"];
    chart = highEnergyConstraintChart[workingTrial, metadata, sample, seed, rules];
    If[FailureQ[chart], Throw[<|"Status" -> "UNRESOLVED", "Equations" -> rows,
      "Samples" -> charts, "Diagnostics" -> {chart}|>]];
    atomicStarted = AbsoluteTime[]; atomicChunkAttempted=False;
    atomic = If[completionHEAffineAtomLaurentEligibleQ[workingTrial,workingUnknowns,metadata],
      completionHEAffineAtomLaurentRows[workingTrial,chart,rules,workingUnknowns,-2 bound,240],
      Missing["ExistingEnergyExpansionPreferred"]];
    If[MatchQ[atomic,Missing["TypedAtomAffineGuard"]],
      atomicChunkAttempted=True;
      atomic=completionHEAffineChunkLaurentRows[workingTrial,chart,rules,workingUnknowns,
        -2 bound,Max[0,240-(AbsoluteTime[]-atomicStarted)],32]];
    (* A colliding scalar rule may not enter the whole-family fallback. *)
    If[MatchQ[atomic,Missing["TypedAtomParameterCoordinateCollision" |
        "TypedAtomMassCoordinateCollision"]],
      Throw[<|"Status"->"UNRESOLVED", "Equations"->rows, "Samples"->charts,
        "Diagnostics"->{Failure["FittingCoordinateCollision",<|"Cause"->atomic,
          "NoWholeFamilyMappingAttempted"->True,
          "OriginalCorrectionCoordinates"->unknowns|>]}|>]];
    If[MatchQ[atomic,Failure["JetUncertifiedAtomSeries",_Association]],
      Throw[<|"Status"->"UNRESOLVED","Equations"->rows,"Samples"->charts,"Diagnostics"->{atomic}|>]];
    (* An exhausted guarded block fit must not repeat the known oversized
       whole-family route. Keep its cause and all original coordinates. *)
    If[TrueQ[atomicChunkAttempted] &&
        (!AssociationQ[atomic] || Lookup[atomic,"Status",None]=!="COMPLETE"),
      Throw[<|"Status"->"UNRESOLVED", "Equations"->rows, "Samples"->charts,
        "Diagnostics"->{Failure["IncompleteAffineBlockFitting",<|"Cause"->atomic,
          "NoWholeFamilyMappingAttempted"->True,
          "OriginalCorrectionCoordinates"->unknowns|>]}|>]];
    coefficients = If[AssociationQ[atomic] && Lookup[atomic,"Status",None]==="COMPLETE",
      atomic["Rows"],
      mapped = residueEvaluateChart[workingTrial, chart, rules];
      completionHELaurentRows[mapped, chart["PoleVariable"],
        chart["SpinVariables"], workingUnknowns, -2 bound]];
    If[FailureQ[coefficients], Throw[<|"Status" -> "UNRESOLVED", "Equations" -> rows,
      "Samples" -> charts, "Diagnostics" -> {coefficients}|>]];
    rows = Join[rows, coefficients];
    AppendTo[charts, <|"Sample" -> sample, "Chart" -> chart,
      "EquationCount" -> Length[coefficients], "OriginalCorrectionCoordinates" -> unknowns,
      "WorkingCorrectionCoordinates" -> workingUnknowns,
      "PriorAffineRestrictionRules" -> priorRules,
      "LaurentExpansion" -> If[AssociationQ[atomic],KeyDrop[atomic,{"Rows","RowKeys"}],
        <|"Method"->"ExistingWholeMappedFamily","TypedAtomAttempt"->atomic|>]|>];
    restriction = completionHEEnergyAffineRestriction[trial, unknowns, partial,
      coefficients, rows, 2];
    If[AssociationQ[restriction] && Lookup[restriction, "Status", None] === "INCONSISTENT",
      Throw[<|"Status" -> "INCONSISTENT", "Equations" -> rows, "Samples" -> charts,
        "SequentialAffineReductions" -> reductions, "OriginalCorrectionCoordinates" -> unknowns,
        "RejectedAfterSample" -> sample, "UnvisitedSampleCount" -> samples - sample,
        "AllRequestedChartsRetained" -> (sample === samples),
        "InconsistencyCertificate" -> restriction["InconsistencyCertificate"],
        "Diagnostics" -> {"The reached exact high-energy equations contradict this bounded affine source family. Additional charts cannot repair an exact linear inconsistency."}|>]];
    If[AssociationQ[restriction],
      workingTrial = restriction["FamilyAmplitude"];
      workingUnknowns = restriction["FreeParameters"];
      partial = restriction["LinearSystem"];
      AppendTo[reductions, Join[<|"AfterSample" -> sample|>, restriction["Certificate"]]]];
    If[TrueQ[$completionHighEnergyPointFirst] &&
        (AssociationQ[restriction] || AllTrue[rows /. partial["SolutionRules"],
          completionPolynomialZeroQ[#, workingUnknowns] &]),
      Throw[<|"Status" -> "UNRESOLVED", "PointReady" -> True,
        "FamilyAmplitude" -> workingTrial, "FreeParameters" -> workingUnknowns,
        "SolutionRules" -> partial["SolutionRules"], "Equations" -> rows, "Samples" -> charts,
        "SequentialAffineReductions" -> reductions, "OriginalCorrectionCoordinates" -> unknowns,
        "AllRequestedChartsRetained" -> (sample === samples),
        "PointReadyCheckpoint" -> <|"CompletedEnergyCharts" -> sample,
          "RequestedEnergyChartsPerAssignment" -> samples, "UnvisitedEnergyCharts" -> samples-sample,
          "ReachedEnergyEquationsVerified" -> True, "FullAffineNullspaceRetained" -> True,
          "UnvisitedChartsClaimedValidated" -> False|>, "Diagnostics" -> {}|>]],
    {sample, samples}];
  <|"Status" -> "COMPLETE", "Equations" -> rows, "Samples" -> charts,
    "SequentialAffineReductions" -> reductions,
    "OriginalCorrectionCoordinates" -> unknowns,
    "AllRequestedChartsRetained" -> True,
    "Diagnostics" -> {}|>
]];

(* The same correction coefficients must satisfy every model-consistent input
   assignment. Carry only certified affine restrictions between assignments;
   all earlier equations and every later chart remain in their intersection. *)
completionHEEnergyConstraintSets[trial_, unknowns_List, metadata_Association,
    samples_Integer, seed_Integer, assignments_List, bound_, callback_, enabled_] := Catch[Module[
  {reports = {}, rows = {}, charts = {}, diagnostics = {}, workingTrial = trial,
   workingUnknowns = unknowns, partial, report, restriction, reductions = {},
   valid, first, priorRules, rejection = None},
  partial = <|"Status" -> If[unknowns === {}, "COMPLETE", "UNDERDETERMINED"],
    "SolutionRules" -> {}, "FreeParameters" -> unknowns, "Rank" -> 0, "Diagnostics" -> {}|>;
  Do[
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
      "Phase" -> "EnergyParameterSet", "Current" -> index, "Total" -> Length[assignments],
      "Unknowns" -> Length[workingUnknowns]|>];
    priorRules = partial["SolutionRules"];
    report = completionHEEnergyConstraints[workingTrial, workingUnknowns, metadata,
      samples, seed + 104729 (index - 1), assignments[[index]], bound, callback, enabled];
    AppendTo[reports, <|"ParameterRules" -> assignments[[index]],
      "OriginalCorrectionCoordinates" -> unknowns,
      "WorkingCorrectionCoordinates" -> workingUnknowns,
      "PriorAffineRestrictionRules" -> priorRules, "Report" -> report|>];
    If[!AssociationQ[report], Continue[]];
    If[TrueQ[$completionHighEnergyPointFirst] && TrueQ[Lookup[report, "PointReady", False]],
      Throw[Join[report, <|"ParameterReports" -> reports,
        "OriginalCorrectionCoordinates" -> unknowns,
        "PointReadyCheckpoint" -> Join[report["PointReadyCheckpoint"], <|
          "PartiallyVisitedParameterAssignment" -> index,
          "RequestedParameterAssignments" -> Length[assignments],
          "UnvisitedParameterAssignments" -> Length[assignments]-index,
          "AllRequestedParameterAssignmentsFit" -> False|>]|>],
        "HEPCATPointReadyEnergyAssignments"]];
    rows = Join[rows, Lookup[report, "Equations", {}]];
    charts = Join[charts, Lookup[report, "Samples", {}]];
    diagnostics = Join[diagnostics, Lookup[report, "Diagnostics", {}]];
    If[Lookup[report, "Status", None] === "INCONSISTENT",
      rejection = <|"RejectedAfterParameterSet" -> index,
        "UnvisitedParameterAssignmentCount" -> Length[assignments] - index,
        "InconsistencyCertificate" -> <|"Method" -> "ExactParameterFamilyIntersectionContradiction",
          "OriginalCoordinates" -> unknowns, "PriorAffineRestrictionRules" -> priorRules,
          "ReachedEquations" -> rows, "ChartContradiction" -> Lookup[report, "InconsistencyCertificate", <||>],
          "UncheckedParameterAssignmentsClaimed" -> False|>|>; Break[]];
    If[index < Length[assignments] && Lookup[report, "Status", None] === "COMPLETE",
      restriction = completionHEEnergyAffineRestriction[trial, unknowns, partial,
        Lookup[report, "Equations", {}], rows, 2];
      If[AssociationQ[restriction] && Lookup[restriction, "Status", None] === "INCONSISTENT",
        rejection = <|"RejectedAfterParameterSet" -> index,
          "UnvisitedParameterAssignmentCount" -> Length[assignments] - index,
          "InconsistencyCertificate" -> restriction["InconsistencyCertificate"]|>; Break[]];
      If[AssociationQ[restriction],
        workingTrial = restriction["FamilyAmplitude"];
        workingUnknowns = restriction["FreeParameters"];
        partial = restriction["LinearSystem"];
        AppendTo[reductions, Join[<|"AfterParameterSet" -> index|>, restriction["Certificate"]]]]],
    {index, Length[assignments]}];
  valid = Select[Lookup[reports, "Report", {}], AssociationQ];
  first = If[valid === {}, <||>, First[valid]];
  Join[first, If[AssociationQ[rejection], rejection, <||>],
    <|"Status" -> If[AssociationQ[rejection], "INCONSISTENT", If[Length[valid] === Length[assignments] &&
      AllTrue[valid, Lookup[#, "Status", None] === "COMPLETE" &], "COMPLETE", "UNRESOLVED"]],
    "Equations" -> rows, "Samples" -> charts, "Diagnostics" -> DeleteDuplicates[diagnostics],
    "ParameterAssignments" -> reports, "SequentialParameterAffineReductions" -> reductions,
    "OriginalCorrectionCoordinates" -> unknowns,
    "AllRequestedParameterAssignmentsRetained" -> Length[reports] === Length[assignments]|>]
], "HEPCATPointReadyEnergyAssignments"];

completionHESpuriousConstraints[trial_, unknowns_List, normalized_Association,
    metadata_Association, samples_Integer, seed_Integer, rules_List,
    callback_, enabled_, seconds_: 60] := Catch[Module[
  {targets = Lookup[normalized, "Targets", {}], discovery, rows = {}, charts = {},
   candidates, specification, chart, coefficients, mapped, factor, targetsForMetadata,
   effectiveSamples, minimumSamples, chartMetadata, specified, compound, curveResult},
  targetsForMetadata = If[targets =!= {}, targets,
    {Join[metadata, <|"Cut" -> Take[metadata["ExternalLegs"], 2],
      "Complement" -> Drop[metadata["ExternalLegs"], 2], "Mass" -> 0,
      "KinematicMetadataOnly" -> True|>]}];
  chartMetadata = If[targets =!= {}, Join[metadata,
    KeyTake[First[targets], {"Cut", "Complement", "Mass", "Propagator"}]],
    First[targetsForMetadata]];
  discovery = poleDiscoverDenominators[trial, targetsForMetadata,
    Lookup[normalized, "Records", {}]];
  If[!ListQ[discovery] || AnyTrue[discovery, Lookup[#, "Classification"] === "Unclassified" &],
    Return[<|"Status" -> "UNRESOLVED", "Equations" -> {}, "Samples" -> {},
      "Diagnostics" -> {"A candidate denominator could not be classified for spurious-pole constraints."}|>]];
  candidates = Select[discovery, Lookup[#, "Classification"] === "Spurious" &];
  specified = Map[Function[candidate, <|"Candidate" -> candidate,
    "Specification" -> spuriousPoleSpecification[candidate["CanonicalFactor"] /. rules,
      Join[metadata, <|"ExternalMassRules" -> (metadata["ExternalMassRules"] /. rules)|>]]|>], candidates];
  If[AnyTrue[specified, MissingQ[#["Specification"]] &],
    Return[<|"Status" -> "UNRESOLVED", "Equations" -> rows, "Samples" -> charts,
      "Diagnostics" -> {"A spurious denominator has no supported transverse chart."}|>]];
  compound = Select[specified, Lookup[#["Specification"], "Mode", ""] === "RationalCurve" &];
  If[compound =!= {},
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
      "Phase" -> "CompoundSpuriousConstraints", "Poles" -> Length[compound]|>];
    curveResult = spuriousCompoundConstraints[trial, unknowns,
      (#["Candidate"]["CanonicalFactor"] & /@ compound), targets, metadata,
      samples, seed, rules, seconds];
    If[!AssociationQ[curveResult] || Lookup[curveResult, "Status", ""] =!= "COMPLETE",
      Return[<|"Status" -> "UNRESOLVED", "Equations" -> Lookup[curveResult, "Equations", {}],
        "Samples" -> Lookup[curveResult, "Samples", {}],
        "Diagnostics" -> Lookup[curveResult, "Diagnostics", {"Compound spurious constraints did not complete."}]|>]];
    rows = Join[rows, curveResult["Equations"]]; charts = Join[charts, curveResult["Samples"]]];
  specified = Select[specified, Lookup[#["Specification"], "Mode", ""] =!= "RationalCurve" &];
  Do[
    factor = item["Candidate"]["CanonicalFactor"]; specification = item["Specification"];
    minimumSamples = If[Lookup[specification, "Mode", ""] === "Invariant",
      Switch[Count[Lookup[specification, "MasslessPairSides", {}], True],
        1, 2, 2, 4, _, 1], 1];
    effectiveSamples = Max[samples, minimumSamples];
    Do[
      completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
        "Phase" -> "SpuriousConstraints", "Pole" -> factor,
        "Current" -> sample, "Total" -> effectiveSamples|>];
      chart = spuriousAutomaticChart[specification, chartMetadata, sample, seed, rules];
      If[FailureQ[chart], Throw[<|"Status" -> "UNRESOLVED", "Equations" -> rows,
        "Samples" -> charts, "Diagnostics" -> {chart}|>]];
      chart = completionHECoherentChart[chart];
      If[!spuriousPhysicalGenericQ[trial, targets, chart, rules],
        Throw[<|"Status" -> "UNRESOLVED", "Equations" -> rows, "Samples" -> charts,
          "Diagnostics" -> {"A spurious constraint chart coincides with a physical pole."}|>]];
      mapped = residueEvaluateChart[trial, chart, rules];
      coefficients = completionHELaurentRows[mapped, chart["PoleVariable"],
        chart["SpinVariables"], unknowns, 0];
      If[FailureQ[coefficients], Throw[<|"Status" -> "UNRESOLVED", "Equations" -> rows,
        "Samples" -> charts, "Diagnostics" -> {coefficients}|>]];
      rows = Join[rows, coefficients];
      AppendTo[charts, <|"Sample" -> sample, "Pole" -> factor, "Chart" -> chart,
        "EquationCount" -> Length[coefficients]|>], {sample, effectiveSamples}],
    {item, specified}];
  <|"Status" -> "COMPLETE", "Equations" -> rows, "Samples" -> charts,
    "Diagnostics" -> {}|>
]];

(* Separate the affine correction coordinates before collecting coherent spin
   monomials. Every column keeps its original coefficient; reference differences
   are still recombined into one coupled equation for each spin monomial. *)
completionHEReferenceAffineSpinCoefficients[mapped_, unknowns_List,
    spinVariables_List, seconds_: 10] := Module[
  {work, failure, tag = Unique["referenceAffineSpin"]},
  failure[reason_] := <|"Status" -> "UNRESOLVED", "Reason" -> reason,
    "FullCoefficientCoverage" -> False, "ReconstructionVerified" -> False|>;
  If[unknowns === {} || !DuplicateFreeQ[unknowns] ||
      !AllTrue[unknowns, MatchQ[#, _Symbol] &] ||
      !FreeQ[spinVariables, Alternatives @@ unknowns] ||
      !residueFiniteQ[mapped], Return[failure["UnsupportedAffineInput"]]];
  work[] := Catch[Module[
    {arrays, parts, replay, polynomials, coefficientSets, powers, vectors, value},
    arrays = Quiet[Check[CoefficientArrays[mapped, unknowns], $Failed]];
    If[!ListQ[arrays] || Length[arrays] > 2 || arrays === {},
      Throw[failure["NonAffineCorrectionDependence"], tag]];
    parts = If[Length[arrays] === 1,
      Prepend[ConstantArray[0, Length[unknowns]], First[arrays]],
      Prepend[Normal[arrays[[2]]], First[arrays]]];
    If[Length[parts] =!= Length[unknowns] + 1 ||
        !AllTrue[parts, residueFiniteQ[#] && FreeQ[#, Alternatives @@ unknowns] &],
      Throw[failure["UnsupportedAffineCoefficients"], tag]];
    replay = Quiet[Check[CoefficientArrays[
      mapped - Prepend[unknowns, 1].parts, unknowns], $Failed]];
    If[!ListQ[replay] || !AllTrue[Flatten[Normal /@ replay], residueExactZero],
      Throw[failure["AffineReconstructionNotVerified"], tag]];
    polynomials = amplitudeCoherentPolynomialRules[#, spinVariables, seconds] & /@ parts;
    If[!AllTrue[polynomials, AssociationQ[#] && Lookup[#, "Status", None] === "COMPLETE" &&
        TrueQ[Lookup[#, "FullCoefficientCoverage", False]] &&
        TrueQ[Lookup[#, "ReconstructionVerified", False]] &],
      Throw[failure["IncompleteCoherentPolynomial"], tag]];
    coefficientSets = Association[#["CoefficientRules"]] & /@ polynomials;
    powers = Union[Flatten[(First /@ #["CoefficientRules"] &) /@ polynomials, 1]];
    vectors = Map[Function[power, power -> Map[Function[coefficients,
      If[KeyExistsQ[coefficients, power], coefficients[power], 0]], coefficientSets]], powers];
    <|"Status" -> "COMPLETE", "CoefficientVectors" -> vectors,
      "AffineVariables" -> unknowns, "AffinePartCount" -> Length[parts],
      "CoherentComponentCount" -> Length[powers], "FullCoefficientCoverage" -> True,
      "ReconstructionVerified" -> True, "AffineReconstructionMethod" -> "ExactCoefficientArraysReplay",
      "CoherentReconstructionMethod" -> "ExactOpaqueScalarPolynomialArithmetic",
      "UnknownDegreeAtMostOne" -> True, "CoupledCorrectionCoordinates" -> True,
      "InternalOnShellConditions" -> {}|>
  ], tag];
  TimeConstrained[MemoryConstrained[work[], 536870912,
    failure["AffinePolynomialMemoryLimit"]], seconds, failure["AffinePolynomialTimeLimit"]]
];

(* This is a sufficient regularity certificate for the ORIGINAL full
   expression, not a different reference baseline. Every syntactic inverse
   base must be nonzero; uncertain cases keep the original full check. *)
completionHEReferenceArithmeticDomain[mapped_, allowed_List] := Module[
  {atoms, invalidHeads, invalidPowers, bases},
  If[!residueFiniteQ[mapped] || !DuplicateFreeQ[allowed] ||
      !AllTrue[allowed, MatchQ[#, _Symbol] &],
    Return[<|"Status" -> "NOT_CERTIFIED", "Reason" -> "UnsupportedArithmeticInput"|>]];
  atoms = DeleteDuplicates[Cases[mapped, _?AtomQ, {0, Infinity}]];
  If[!AllTrue[atoms, NumberQ[#] || MemberQ[allowed, #] &],
    Return[<|"Status" -> "NOT_CERTIFIED", "Reason" -> "UnsupportedArithmeticAtom"|>]];
  invalidHeads = Cases[mapped,
    head_[___] /; !MemberQ[{Plus, Times, Power, Rational, Complex}, head], {0, Infinity}, 1];
  invalidPowers = Cases[mapped, Power[_, exponent_] /;
    !MatchQ[exponent, _Integer | _Rational], {0, Infinity}, 1];
  If[invalidHeads =!= {} || invalidPowers =!= {},
    Return[<|"Status" -> "NOT_CERTIFIED", "Reason" -> "UnsupportedArithmeticOperation"|>]];
  bases = DeleteDuplicates[Cases[mapped, Power[base_, exponent_] /;
    MatchQ[exponent, _Integer | _Rational] && exponent < 0 :> base, {0, Infinity}]];
  <|"Status" -> "CERTIFIED", "InverseBases" -> bases,
    "FullExpressionArithmeticVerified" -> True,
    "AllowedSymbols" -> allowed, "NegativeRationalPowersIncluded" -> True|>
];

completionHEReferenceRegularBaseline[domain_Association, baselineRules_List,
    genericSpinRules_List] := Module[{values, states},
  If[Lookup[domain, "Status", None] =!= "CERTIFIED" ||
      !TrueQ[Lookup[domain, "FullExpressionArithmeticVerified", False]] ||
      !TrueQ[Lookup[domain, "NegativeRationalPowersIncluded", False]] ||
      !ListQ[Lookup[domain, "InverseBases", None]],
    Return[<|"Status" -> "NOT_CERTIFIED"|>]];
  values = domain["InverseBases"] /. baselineRules /. genericSpinRules;
  If[!AllTrue[values, NumericQ[#] && residueFiniteQ[#] &],
    Return[<|"Status" -> "NOT_CERTIFIED", "Reason" -> "UnresolvedInverseBase"|>]];
  states = highEnergyZeroState /@ values;
  If[!AllTrue[states, # === "Nonzero" &],
    Return[<|"Status" -> "NOT_CERTIFIED", "Reason" -> "UnprovedNonzeroInverseBase"|>]];
  <|"Status" -> "PROVED_REGULAR", "Method" -> "EveryOriginalSyntacticInverseBaseNonzero",
    "FullExpressionArithmeticVerified" -> True, "InverseBases" -> domain["InverseBases"],
    "ExactBaseValues" -> values, "ExactNonzeroStates" -> states,
    "SameFullExpressionBaseline" -> True, "InternalOnShellConditions" -> {}|>
];

(* Generate linear equations directly. Classifying coefficients containing
   unsolved correction parameters would repeat expensive algebraic-number
   reductions only to conclude that those parameters are still unknown. *)
completionHEReferenceRows[trial_, chart_Association, references_List,
    sample_Integer, seed_Integer, rules_List, unknowns_List: {}] := BlockRandom[Catch[Module[
  {coordinates, referenceVariables, symbolicChart, mapped, spinVariables,
   spinComponents, assignments, baselineRules, baselinePoint, genericSpin,
   found = False, rows = {}, coefficients, differences = {}, affine = Missing["NotRequested"],
   affineRoute = False, referencePattern, differenceVector,
   baselineDomain = Missing["OriginalRoute"], baselineRegularity = Missing["OriginalRoute"]},
  coordinates = Association[(# -> Table[Unique["completionReference"], {4}]) & /@ references];
  referenceVariables = Flatten[Values[coordinates]];
  symbolicChart = Join[chart, <|"ReferenceOverrides" -> referenceOverrideVectors[coordinates]|>];
  mapped = residueEvaluateChart[Rationalize[trial, 0], symbolicChart, Rationalize[rules, 0]];
  spinVariables = Lookup[chart, "SpinVariables", {}];
  If[!residueFiniteQ[mapped] || residueUnmappedQ[mapped] ||
      (spinVariables =!= {} && !PolynomialQ[mapped, spinVariables]),
    Return[Failure["UnsupportedReferenceSpinPolynomial", <||>]]];
  If[Length[unknowns] >= 16 && LeafCount[mapped] >= 5000,
    affine = completionHEReferenceAffineSpinCoefficients[mapped, unknowns, spinVariables, 10];
    affineRoute = AssociationQ[affine] && Lookup[affine, "Status", None] === "COMPLETE" &&
      TrueQ[Lookup[affine, "FullCoefficientCoverage", False]] &&
      TrueQ[Lookup[affine, "ReconstructionVerified", False]]];
  spinComponents = If[TrueQ[affineRoute], affine["CoefficientVectors"],
    If[spinVariables === {}, {{} -> mapped}, CoefficientRules[mapped, spinVariables]]];
  If[TrueQ[affineRoute],
    baselineDomain = TimeConstrained[completionHEReferenceArithmeticDomain[mapped,
      Join[unknowns, referenceVariables, spinVariables]], 2, Missing["BaselineDomainTimeLimit"]]];
  Do[
    SeedRandom[Hash[{seed, sample, attempt, "ReferenceBaseline"}, "CRC32"]];
    assignments = Association[(# -> RandomChoice[DeleteCases[Range[-7, 7], 0], 4]) & /@ references];
    baselineRules = Thread[referenceVariables -> Flatten[Values[assignments]]];
    genericSpin = Thread[spinVariables -> Range[Length[spinVariables]]];
    If[AssociationQ[baselineDomain],
      baselineRegularity = TimeConstrained[completionHEReferenceRegularBaseline[
        baselineDomain, baselineRules, genericSpin], 2, Missing["BaselineCertificateTimeLimit"]];
      If[AssociationQ[baselineRegularity] &&
          Lookup[baselineRegularity, "Status", None] === "PROVED_REGULAR",
        found = True; Break[]]];
    baselineRegularity = Missing["OriginalFullBaselineCheck"];
    baselinePoint = Quiet[Check[Cancel[Together[mapped /. baselineRules /. genericSpin]], $Failed]];
    If[residueFiniteQ[baselinePoint] &&
        highEnergyZeroState[Denominator[baselinePoint]] === "Nonzero",
      found = True; Break[]], {attempt, 0, 5}];
  If[!found, Return[Failure["NoRegularReferenceBaseline", <||>]]];
  referencePattern = Alternatives @@ referenceVariables;
  Do[
    coefficients = If[TrueQ[affineRoute],
      differenceVector = Map[If[FreeQ[#, referencePattern], 0,
        Cancel[Together[# - (# /. baselineRules)]]] &, Last[component]];
      (* The scalar simplifications above are ordinary identities. Never turn
         the columns into separate constraints: their cancellations matter. *)
      completionHEPolynomialRows[Prepend[unknowns, 1].differenceVector, referenceVariables],
      completionHEPolynomialRows[
        Last[component] - (Last[component] /. baselineRules), referenceVariables]];
    If[FailureQ[coefficients], Throw[coefficients]];
    (* Exact algebraic zero tests and row reduction belong to the common
       linear solver, after the unknown coefficients have been separated. *)
    coefficients = DeleteCases[coefficients, 0];
    rows = Join[rows, coefficients];
    AppendTo[differences, <|"SpinMonomial" -> First[component],
      "Equations" -> coefficients|>], {component, spinComponents}];
  <|"Equations" -> rows, "Sample" -> sample, "Status" -> "CONSTRAINTS",
    "Chart" -> chart, "ReferenceCoordinates" -> coordinates,
    "BaselineAssignments" -> assignments, "SpinVariables" -> spinVariables,
    "SpinComponents" -> differences, "EquationCount" -> Length[rows],
    "Method" -> "ExactReferenceDifferenceBySpinComponent",
    "CoefficientExtraction" -> If[TrueQ[affineRoute],
      KeyDrop[affine, "CoefficientVectors"], <|"Method" -> "OriginalWholeSpinPolynomial"|>],
    "BaselineRegularityCertificate" -> baselineRegularity|>
]]];

(* Reference independence is an algebraic condition on external on-shell
   kinematics. A rational complex chart avoids nested energy-normalization
   radicals while retaining every coherent massive-spin coefficient. These are
   fitting samples; the final checker still uses independent physical charts. *)
completionHEReferenceFitChart[metadata_Association, targets_List,
    sample_Integer, seed_Integer, rules_List] := BlockRandom[Module[
  {template, coordinates, assignment, chart, external, masses, valid,
   result = Missing["NoGenericRationalReferenceChart"]},
  template = completionHESymbolicExternalChart[metadata["ExternalMassRules"] /. rules];
  If[!AssociationQ[template], Return[Missing["UnsupportedRationalReferenceChart"]]];
  coordinates = template["ExternalIdentityCoordinates"];
  external = Keys[template["Momenta"]]; masses = template["Masses"];
  Do[
    SeedRandom[Hash[{seed, sample, attempt, "RationalReferenceFit"}, "CRC32"]];
    assignment = Thread[coordinates -> RandomChoice[DeleteCases[Range[-9, 9], 0], Length[coordinates]]];
    chart = template /. assignment;
    valid = AllTrue[Values[chart["Momenta"]], MatrixQ[#, NumericQ] && residueFiniteQ[#] &] &&
      residueExactZero[Total[Values[chart["Momenta"]]]] &&
      AllTrue[external, residueExactZero[Det[chart["Momenta"][#]] - chart["Masses"][#]^2] &] &&
      AllTrue[Keys[chart["AngleBasis"]], Function[leg,
        residueExactZero[chart["AngleBasis"][leg].{{0, 1}, {-1, 0}}.
          Transpose[chart["SquareBasis"][leg]] - chart["Momenta"][leg]]]];
    If[TrueQ[valid] && referencePhysicalGenericQ[chart, targets, rules],
      result = Join[chart, <|"ReferenceFitMethod" -> "RationalExternalShellFullSpinSample",
        "CoordinateAssignments" -> assignment, "InternalOnShellConditions" -> {},
        "ExternalMassShellsValidated" -> True, "ExternalSpinorBasesValidated" -> True,
        "MomentumConservationValidated" -> True|>]; Break[]], {attempt, 0, 5}];
  result
]];

completionHEReferenceConstraints[trial_, unknowns_List, normalized_Association,
    metadata_Association, samples_Integer, seed_Integer, rules_List,
    callback_, enabled_] := Catch[Module[
  {references, rows = {}, charts = {}, chart, t, validation, sampleData},
  If[!FreeQ[trial, _xFactor | _xTildeFactor], Return[<|"Status" -> "UNRESOLVED",
    "Equations" -> {}, "Samples" -> {}, "Diagnostics" -> {"Unexpanded x factors are unsupported."}|>]];
  references = referenceExpressionMetadata[trial]["References"];
  If[references === {}, Return[<|"Status" -> "COMPLETE", "Equations" -> {},
    "Samples" -> {}, "Diagnostics" -> {}|>]];
  Do[
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
      "Phase" -> "ReferenceConstraints", "Current" -> sample, "Total" -> samples|>];
    chart = completionHEReferenceFitChart[metadata, Lookup[normalized, "Targets", {}], sample, seed, rules];
    If[!AssociationQ[chart],
      chart = highEnergyAutomaticChart[trial, metadata, sample, seed, rules];
      If[FailureQ[chart], Throw[<|"Status" -> "UNRESOLVED", "Equations" -> rows,
        "Samples" -> charts, "Diagnostics" -> {chart}|>]];
      t = chart["PoleVariable"]; validation = chart["KinematicChecks"]["ValidationParameter"];
      chart = Join[chart /. t -> validation, <|"PoleVariable" -> Unique["completionReferencePole"]|>]];
    If[!referencePhysicalGenericQ[chart, Lookup[normalized, "Targets", {}], rules],
      Throw[<|"Status" -> "UNRESOLVED", "Equations" -> rows, "Samples" -> charts,
        "Diagnostics" -> {"A reference constraint sample lies on a physical pole."}|>]];
    sampleData = completionHEReferenceRows[trial, chart, references, sample, seed, rules, unknowns];
    If[FailureQ[sampleData], Throw[<|"Status" -> "UNRESOLVED",
      "Equations" -> rows, "Samples" -> charts,
      "Diagnostics" -> {sampleData}|>]];
    rows = Join[rows, sampleData["Equations"]];
    AppendTo[charts, sampleData], {sample, samples}];
  <|"Status" -> "COMPLETE", "Equations" -> rows, "Samples" -> charts,
    "Diagnostics" -> {}|>
]];

completionHEReusableInitialReportQ[report_] := AssociationQ[report] &&
  ListQ[Lookup[report,"Checks",None]] && report["Checks"]=!={} &&
  AllTrue[report["Checks"],AssociationQ[#] && MemberQ[{"PASS","FAIL","Opp Sign"},Lookup[#,"Status",None]]&] &&
  KeyExistsQ[report,"HighEnergyCheck"] && KeyExistsQ[report,"ReferenceCheck"];

completionHEAllPassQ[report_] := AssociationQ[report] &&
  AllTrue[Lookup[report, "Checks", {}], Lookup[#, "Status"] === "PASS" &] &&
  KeyExistsQ[report, "HighEnergyCheck"] && KeyExistsQ[report, "ReferenceCheck"];

completionHECheck[expression_, normalized_Association, channels_List, model_List,
    settings_Association, seed_Integer] := CheckAmplitudes[
  {normalized["ExternalMassRules"], expression}, channels, model,
  "Output" -> "Details", "ParameterRules" -> settings["ParameterRules"],
  "Samples" -> settings["ValidationSamples"], "RandomSeed" -> seed,
  "HighEnergySamples" -> settings["ValidationSamples"],
  "ReferenceSamples" -> settings["ValidationSamples"],
  "HighEnergyBound" -> settings["HighEnergyBound"],
  "HighEnergyCheck" -> True, "ReferenceCheck" -> True, "SpuriousPoles" -> Automatic,
  "HighEnergyTimeConstraint" -> settings["TimeConstraint"],
  "ReferenceTimeConstraint" -> settings["TimeConstraint"],
  "KinematicMap" -> Automatic, "KinematicKind" -> "Sample",
  "TimeConstraint" -> settings["TimeConstraint"], "Tolerance" -> 0,
  "Parallelization" -> settings["Parallelization"], "MaxKernels" -> settings["MaxKernels"]];

completionHEAutomaticBasis[expression_, metadata_Association,
    settings_Association, bound_] := Module[{terms},
  terms = Expand[expression];
  terms = If[Head[terms] === Plus, List @@ terms, {terms}];
  Select[terms, !FreeQ[Denominator[#], _PropDen | _SpinorChain | _MomProd |
        _Mandelstahm | _Mom | _xFactor | _xTildeFactor] ||
    Lookup[highEnergyCheckReport[#, metadata, 1, settings["RandomSeed"],
      settings["ParameterRules"], settings["TimeConstraint"], bound], "Status"] === "FAIL" &]
];

(* The determinant of an arbitrary two-component momentum matrix. Unlike the
   massless endpoint contraction, this proposal also applies to four unrelated
   massive spinors. It does not impose the shared momentum's mass shell. *)
completionSharedMomentumDeterminantPair[first_, second_] := Module[
  {a, b, c, d, momentum, virtuality, supported},
  supported[value_] := MatchQ[value,
    Spinor["Spin" | "Helicity" | "Xi", "Angle" | "Square", _] |
    Spinor["Spin", "Upper" | "Lower", "Angle" | "Square", _, _]];
  If[Head[first] =!= SpinorChain || Head[second] =!= SpinorChain ||
      Length[first] =!= 3 || Length[second] =!= 3 || first[[2]] =!= second[[2]],
    Return[Missing["NoSharedMomentumPair"]]];
  {a, b, c, d} = {First[first], Last[first], First[second], Last[second]};
  If[!AllTrue[{a, b, c, d}, supported],
    Return[Missing["UnsupportedSharedMomentumEndpoints"]]];
  (* A chain with one insertion is unchanged by reversing its endpoints.
     Canonical chain ordering may present the two factors in opposite ways. *)
  If[rspSpinorType[a] =!= rspSpinorType[c], {c, d} = {d, c}];
  If[rspSpinorType[a] =!= rspSpinorType[c] ||
      rspSpinorType[b] =!= rspSpinorType[d] || rspSpinorType[a] === rspSpinorType[b],
    Return[Missing["UnsupportedSharedMomentumEndpoints"]]];
  momentum = first[[2]]; virtuality = rspOrdinaryMomentumDot[momentum, momentum];
  If[MissingQ[virtuality], Return[virtuality]];
  <|"Expression" -> SpinorChain[a, momentum, d] SpinorChain[c, momentum, b] -
      virtuality SpinorChain[a, c] SpinorChain[b, d],
    "OriginalProduct" -> first second, "Momentum" -> momentum,
    "Virtuality" -> virtuality, "Identity" -> "TwoComponentSharedMomentumDeterminant",
    "InternalOnShellConditions" -> {}|>
];

completionHESharedMomentumRemainders[record_Association, seconds_] := Module[
  {source = Lookup[record, "ReferenceInputExpression",
      Lookup[record, "FixedReferenceExpression", Missing[]]], rules, dots, terms,
   chains, positions, pair, replacement, candidate, reduced, remainder, directions = {},
   started = AbsoluteTime[], available, tried = 0, limit = 8, i, j, term, factor,
   external, canonicalMomentum},
  If[MissingQ[source] || !residueFiniteQ[source] ||
      !FreeQ[source, _xFactor | _xTildeFactor] ||
      rspSandwichExpansionCount[source] > 128, Return[{}]];
  rules = Lookup[record, "MassRules", {}]; dots = preparationDotRules[rules, True];
  external = Sort[Cases[preparationExternalRules[rules], HoldPattern[Mass[leg_Integer] -> _] :> leg]];
  canonicalMomentum[momentum_Mom] := Module[{labels = residueMomentumLegs[First[momentum]], other},
    If[!ListQ[labels] || labels === {} || !DuplicateFreeQ[labels] ||
        !ContainsAll[external, labels], Return[momentum]];
    other = Complement[external, labels];
    If[other =!= {} && OrderedQ[{{Length[other], other}, {Length[labels], labels}}],
      -Mom[If[Length[other] === 1, First[other], Multiparticle @@ other]], momentum]];
  source = preparationProtectedDenominators[source, Function[body,
    body /. chain_SpinorChain :> linearChain[chain /. momentum_Mom :> canonicalMomentum[momentum]]]];
  terms = preparationProtectedDenominators[source, Expand];
  terms = If[Head[terms] === Plus, List @@ terms, {terms}];
  available[] := Max[0, seconds - (AbsoluteTime[] - started)];
  Catch[Do[
    chains = Select[If[Head[term] === Times, List @@ term, {term}],
      Head[#] === SpinorChain && Length[#] === 3 &];
    Do[
      If[tried >= limit || available[] <= 0, Throw[Null]];
      pair = completionSharedMomentumDeterminantPair[chains[[i]], chains[[j]]];
      If[!AssociationQ[pair], Continue[]]; tried++;
      replacement = pair["Expression"]; factor = term/(chains[[i]] chains[[j]]);
      candidate = source - term + factor replacement;
      reduced = TimeConstrained[
        preparationConservedMomentumChains[candidate, rules, True, dots],
        Min[1, available[]], candidate];
      If[available[] > 0,
        reduced = TimeConstrained[preparationFactorizedReferenceTrial[reduced, rules, dots, {}, True],
          Min[1, available[]], reduced]];
      remainder = source - reduced;
      If[remainder =!= 0 && residueFiniteQ[remainder] && !MemberQ[directions, remainder],
        AppendTo[directions, remainder]], {i, Length[chains]}, {j, i + 1, Length[chains]}], {term, terms}]];
  directions
];

completionHECommonReferenceRemainder[normalized_Association, model_List, choice_, seconds_] := Module[
  {records = Lookup[normalized, "RemainderData", {}], common, sources, prepared, expression},
  If[records === {} || !TrueQ[seconds > 0], Return[Missing["NoRetainedCommonReference"]]];
  common = Map[Function[record, SelectFirst[Lookup[record, "ReferenceContinuations", {}],
      Lookup[#, "Mode", None] === "Xi" &, Missing["ReferenceSourceUnavailable"]]], records];
  If[!AllTrue[common, AssociationQ[#] && KeyExistsQ[#, "Expression"] &],
    Return[Missing["IncompleteRetainedReferenceSources"]]];
  sources = Lookup[common, "Expression"];
  If[!AllTrue[sources, residueFiniteQ], Return[Missing["InvalidRetainedReferenceSources"]]];
  (* One shared gauge choice is made on the complete restored sum. Only
     external shells are supplied, so no discarded internal-shell identity is
     applied again to the full amplitude. *)
  prepared = TimeConstrained[PrepareAmplitudes[
    {normalized["ExternalMassRules"], Total[sources]}, model,
    "InternalOnShell" -> False, "PolePreference" -> choice,
    "MaxSteps" -> 0, "TimeConstraint" -> seconds,
    "ProgressReporting" -> False], seconds, $TimedOut];
  If[FailureQ[prepared] || !preparationPairQ[prepared],
    Return[Missing["RetainedReferencePreparationIncomplete"]]];
  expression = Last[prepared];
  If[!residueFiniteQ[expression] || !FreeQ[expression, _xFactor | _xTildeFactor |
      (Spinor | SpinorHat)["Xi", ___]], Return[Missing["UnresolvedRetainedReferences"]]];
  <|"Direction" -> expression - normalized["Expression"],
    "Source" -> "CompleteRetainedCommonReferenceDiagramSum",
    "SourceCount" -> Length[sources], "PolePreference" -> choice,
    "InternalOnShellConditions" -> {}, "RequiresFullAmplitudeValidation" -> True|>
];
completionHECommonReferenceRemainder[___] := Missing["NoRetainedCommonReferenceModel"];

completionHEFamilyReferenceDirections[normalized_Association, model_List, choice_, seconds_] := Module[
  {family = Lookup[normalized, "FamilyAmplitude", Missing["NoAffineSource"]],
   parameters = Lookup[normalized, "FreeParameters", {}], prepared, expression,
   components, directions},
  If[parameters === {} || MissingQ[family] || !TrueQ[seconds > 0] ||
      FreeQ[family, Spinor["Xi", ___]] || MemberQ[{None, "Xi", "IndependentXi"}, choice] ||
      LeafCount[family] > 200000, Return[Missing["NoEligibleAffineReferenceContinuation"]]];
  prepared = TimeConstrained[PrepareAmplitudes[
    {normalized["ExternalMassRules"], family}, model,
    "InternalOnShell" -> False, "PolePreference" -> choice,
    "MaxSteps" -> 0, "TimeConstraint" -> seconds, "ProgressReporting" -> False], seconds, $TimedOut];
  If[FailureQ[prepared] || !preparationPairQ[prepared],
    Return[Missing["AffineReferencePreparationIncomplete"]]];
  expression = Last[prepared];
  If[!residueFiniteQ[expression] || !FreeQ[expression, _xFactor | _xTildeFactor | Spinor["Xi", ___]],
    Return[Missing["AffineReferencesRemainUnresolved"]]];
  components = completionLinearComponents[expression, parameters, False];
  If[!ListQ[components] || Length[components] =!= Length[parameters] + 1 ||
      !residueExactZero[Expand[expression - First[components] - parameters.Rest[components]]],
    Return[Missing["AffineReferenceComponentsNotEstablished"]]];
  directions = Prepend[Rest[components], First[components] - normalized["Expression"]];
  <|"Basis" -> DeleteDuplicates[DeleteCases[directions, 0]],
    "Source" -> "RetainedAffineChannelFamilyReferenceContinuation",
    "OriginalFamily" -> family, "PreparedFamily" -> expression,
    "OriginalParameters" -> parameters, "PolePreference" -> choice,
    "InternalOnShellConditions" -> {}, "OffCutIdentityClaimed" -> False,
    "RequiresFullAmplitudeValidation" -> True|>
];
completionHEFamilyReferenceDirections[___] := Missing["NoRetainedAffineReferenceModel"];

(* A supported renormalizable cubic bilinear has an ordinary Dirac-current
   continuation. Recover both scalar and pseudoscalar coefficients from the
   supplied three-point amplitude, with an exact symbolic vertex certificate.
   This is a proposed minimal continuation of those vertices, never a fitted
   benchmark amplitude or an additional independent contact interaction. *)
completionHECubicBilinearSource[normalized_Association, model_List, choice_, seconds_] := Module[
  {process = Lookup[normalized, "ExternalParticles", {}], fermion, scalar, vector,
   scalars, vectors, species, photonNames, base, vectorRows, vectorCoupling,
   target, angle, square, aa = Unique["scalarAngle"], bb = Unique["scalarSquare"],
   polynomial, ca, cb, scalarCoupling, pseudoscalarCoupling, unit, gamma5, matched,
   particles, lifted, diagrams, liftedDiagrams, signature, pairs, converted,
   expression, prepared, external = normalized["ExternalMassRules"],
   sourceModel = model, colorScale = 1, colorCertificate = Missing["ColorSingletSource"], representations},
  If[Length[process] =!= 4 || !AllTrue[process, StringQ] || !TrueQ[seconds > 0] ||
      MemberQ[{None, "Xi", "IndependentXi"}, choice], Return[Missing["UnsupportedCubicBilinearSource"]]];
  representations = colorParticleRepresentation[#, model] & /@ process;
  If[AnyTrue[representations, # =!= 1 &],
    If[!TrueQ[$colorConstructingProjection] || !AssociationQ[$colorConstructionInput],
      Return[Missing["UncertifiedColoredCubicSource"]]];
    colorCertificate = Lookup[$colorConstructionInput, "ColorProjectionCertificate", <||>];
    If[!AssociationQ[colorCertificate] || !TrueQ[Lookup[colorCertificate, "Certified", False]] ||
        Lookup[colorCertificate, "Method", None] =!= "ExactRankOneFundamentalColorFlow" ||
        Lookup[colorCertificate, "Representations", {}] =!= representations ||
        !KeyExistsQ[colorCertificate, "Basis"] ||
        !MatchQ[Lookup[colorCertificate, "CanonicalTensor", None], _ColorDelta | _ColorGenerator],
      Return[Missing["UncertifiedColoredCubicSource"]]];
    colorScale = Lookup[colorCertificate, "CommonDiagramCoordinate", Missing[]];
    If[!NumericQ[colorScale] || !residueFiniteQ[colorScale] || residueExactZero[colorScale],
      Return[Missing["UncertifiedColoredCubicCoordinate"]]];
    sourceModel = ReplacePart[model, 1 -> (ReplacePart[#, 8 -> 1] & /@ model[[1]])]];
  fermion = SelectFirst[sourceModel[[1]], ListQ[#] && Length[#] === 11 && #[[5]] === 1 &&
    #[[8]] === 1 && #[[6]] =!= 0 && MemberQ[{0, "0"}, #[[7]]] && #[[2]] =!= #[[3]] &&
    Count[process, #[[2]]] === 1 && Count[process, #[[3]]] === 1 &, None];
  If[fermion === None, Return[Missing["UnsupportedCubicBilinearSource"]]];
  species = fermion[[{2, 3}]];
  scalars = Select[sourceModel[[1]], ListQ[#] && Length[#] === 11 && #[[5]] === 0 &&
    #[[8]] === 1 && AnyTrue[#[[{2, 3}]], MemberQ[process, #] &] &];
  vectors = Select[sourceModel[[1]], ListQ[#] && Length[#] === 11 && #[[5]] === 2 &&
    #[[6]] === 0 && #[[8]] === 1 && AnyTrue[#[[{2, 3}]], MemberQ[process, #] &] &];
  If[Length[scalars] =!= 1 || Length[vectors] =!= 1, Return[Missing["UnsupportedCubicBilinearSource"]]];
  scalar = First[scalars]; vector = First[vectors]; photonNames = vector[[{2, 3}]];
  If[!StringEndsQ[First[photonNames], ".+"] ||
      Last[photonNames] =!= StringDrop[First[photonNames], -1] <> "-", Return[Missing["UnsupportedCubicBilinearSource"]]];
  base = StringDrop[First[photonNames], -2];
  If[!feynmanIdentifierQ[base] || MemberQ[Join[species, scalar[[{2, 3}]]], base],
    Return[Missing["UnsupportedCubicBilinearSource"]]];
  vectorRows = Select[sourceModel[[2]], Length[#] === 6 && #[[4]] === "" &&
    MemberQ[photonNames, #[[3]]] && Take[#, 2] === species &];
  vectorCoupling = constructVectorCoupling[vectorRows, species, photonNames];
  If[MissingQ[vectorCoupling], Return[Missing["NonminimalCubicVectorVertex"]]];
  target = Block[{$colorFactorizationEnabled = False}, LookupAmplitude[
    {{First[species], 1}, {Last[species], 2},
      {SelectFirst[scalar[[{2, 3}]], MemberQ[process, #] &], 3}}, sourceModel, False,
    {Unique["cubicSpin"], Unique["cubicSpin"], Unique["cubicSpin"], Unique["cubicSpin"]}]];
  angle = SpinorChain[Spinor["Spin", "Angle", 1], Spinor["Spin", "Angle", 2]];
  square = SpinorChain[Spinor["Spin", "Square", 1], Spinor["Spin", "Square", 2]];
  target = canonicalChains[target]; polynomial = Expand[target /. {angle -> aa, square -> bb}];
  If[!PolynomialQ[polynomial, {aa, bb}] || !FreeQ[polynomial, _Spinor | _SpinorChain |
      _Mom | _MomProd | _PropDen | _xFactor | _xTildeFactor],
    Return[Missing["NonminimalCubicScalarVertex"]]];
  ca = Coefficient[polynomial, aa]; cb = Coefficient[polynomial, bb];
  If[!residueExactZero[polynomial - ca aa - cb bb] || ca === cb === 0,
    Return[Missing["NonminimalCubicScalarVertex"]]];
  scalarCoupling = (ca + cb)/2; pseudoscalarCoupling = (cb - ca)/2;
  unit = ConstructiveDiagrams`FeynmanToSpinorProducts[ConstructiveDiagrams`DiracChain[
    ConstructiveDiagrams`FermionBar[2, fermion[[6]], "Dirac"], ConstructiveDiagrams`DiracWord[],
    ConstructiveDiagrams`FermionKet[1, fermion[[6]], "Dirac"]]];
  gamma5 = ConstructiveDiagrams`FeynmanToSpinorProducts[ConstructiveDiagrams`DiracChain[
    ConstructiveDiagrams`FermionBar[2, fermion[[6]], "Dirac"],
    ConstructiveDiagrams`DiracWord[ConstructiveDiagrams`DiracGamma5],
    ConstructiveDiagrams`FermionKet[1, fermion[[6]], "Dirac"]]];
  matched = canonicalChains[scalarCoupling unit + pseudoscalarCoupling gamma5];
  If[!residueExactZero[Expand[matched - target]], Return[Missing["CubicVertexMatchNotCertified"]]];
  particles = {fermion, ReplacePart[vector, {2 -> base, 3 -> base, 9 -> "G"}], scalar};
  lifted = ConstructiveDiagrams`FeynmanModel[particles, {
    {Last[species], First[species], base, "", vectorCoupling/Sqrt[2],
      ConstructiveDiagrams`DiracWord[ConstructiveDiagrams`DiracGamma[ConstructiveDiagrams`LorentzIndex[3]]]},
    {Last[species], First[species], SelectFirst[scalar[[{2, 3}]], MemberQ[process, #] &], "", 1,
      scalarCoupling ConstructiveDiagrams`DiracWord[] +
        pseudoscalarCoupling ConstructiveDiagrams`DiracWord[ConstructiveDiagrams`DiracGamma5]}}, model[[3]], model[[4]]];
  diagrams = If[AssociationQ[colorCertificate], $colorConstructionInput["Diagrams"],
    CreateDiagrams[process, model]];
  liftedDiagrams = CreateDiagrams[process, lifted];
  If[!ListQ[diagrams] || !ListQ[liftedDiagrams] || Length[diagrams] =!= 2 ||
      Length[liftedDiagrams] =!= Length[diagrams], Return[Missing["CubicDiagramInventoryMismatch"]]];
  signature[data_] := Sort[Map[Function[diagram, Sort[Map[Function[prop,
    {Sort[{prop["Particle"], prop["Antiparticle"]}],
      residueCanonicalPropagators[PropDen[Mom[prop["Index"]], prop["Mass"]], Range[4]]}],
    Values[diagram["Propagators"]]]]], data]];
  If[signature[diagrams] =!= signature[liftedDiagrams], Return[Missing["CubicPoleInventoryMismatch"]]];
  pairs = DiagramAmplitudes[liftedDiagrams];
  converted = ConstructiveDiagrams`FeynmanToSpinorProducts[pairs,
    "ReferenceSpinors" -> Automatic, "ReduceSpinorProducts" -> False, "TimeConstraint" -> seconds];
  If[!ListQ[converted] || !AllTrue[converted, preparationPairQ], Return[Missing["CubicCurrentConversionIncomplete"]]];
  expression = Total[Last /@ converted];
  prepared = PrepareAmplitudes[{external, expression}, sourceModel, "InternalOnShell" -> False,
    "PolePreference" -> choice, "MaxSteps" -> 0, "TimeConstraint" -> seconds, "ProgressReporting" -> False];
  If[!preparationPairQ[prepared] || !FreeQ[Last[prepared], Spinor["Xi", ___]],
    Return[Missing["CubicCurrentReferencesUnresolved"]]];
  <|"Direction" -> colorScale Last[prepared] - normalized["Expression"],
    "Source" -> "CertifiedMinimalScalarPseudoscalarAndVectorCubicCurrents",
    "ScalarVertexMatch" -> <|"OriginalAmplitude" -> target, "ReconstructedAmplitude" -> matched,
      "ExactSymbolicMatch" -> True, "NumericalParameterAssignments" -> {}, "InternalOnShellConditions" -> {}|>,
    "VectorVertexMatch" -> "ExactStandardConstructiveVectorBilinearStructure",
    "PoleInventoryMatched" -> True, "InternalOnShellConditions" -> {},
    "ColorProjectionCertificate" -> colorCertificate, "ColorProjectionCoordinate" -> colorScale,
    "ContinuationAssumption" -> "MinimalRenormalizableCubicDiracCurrent",
    "RequiresFullAmplitudeValidation" -> True|>
];
completionHECubicBilinearSource[___] := Missing["NoCubicBilinearSourceModel"];

(* These are exact differences retained from a specified diagram or channel,
   not new independent contact interactions. They can contain regular pieces
   which an ansatz that only reweights the prepared pole terms cannot span.
   No internal shell condition is reapplied to the assembled correction. *)
(* Try complete correlated shell differences before assigning separate
   coefficients to their expanded numerator terms. These are finite proposals
   from retained diagram/channel sources, never independent new interactions. *)
completionHEWholeSourceRemainders[normalized_Association,model_List,seconds_] := Module[
  {records,candidates,directions={},sources={},skipped={},record,value,contour,plan,basis={},
   atomic=0,completed=False,started=AbsoluteTime[],tag=Unique["wholeRemainders"]},
  records=Join[Lookup[normalized,"RemainderData",{}],Lookup[normalized,"ChannelRemainderData",{}]];
  candidates=Select[records,AssociationQ[#] && TrueQ[Lookup[#,"HasInternalConditions",False]] &&
    !MissingQ[Lookup[#,"ShellRemainder",Missing[]]]&];
  If[candidates==={} || !TrueQ[seconds>0],Return[Missing["NoWholeRemainderProposal"]]];
  completed=TimeConstrained[Catch[
    Do[value=record["ShellRemainder"];
      If[!residueFiniteQ[value] || value===0 ||
          !FreeQ[value,_xFactor|_xTildeFactor|(Spinor|SpinorHat)["Xi",___]],
        AppendTo[skipped,Join[KeyTake[record,{"InputType","OnShellChannels"}],
          <|"Reason"->"ZeroOrUnsupportedWholeShellDifference"|>]];Continue[]];
      contour=If[Lookup[record,"InputType",None]==="FactorizationChannel",
        -If[FreeQ[Lookup[record,"FixedReferenceExpression",0],ConstructiveDiagrams`z],1,ConstructiveDiagrams`z],1];
      value=completionCanonicalReduce[contour value,normalized["ExternalMassRules"]];
      If[!residueFiniteQ[value] || value===0,Continue[]];
      If[!MemberQ[directions,value],AppendTo[directions,value];
        atomic+=rspSandwichExpansionCount[value];
        AppendTo[sources,Join[KeyTake[record,{"InputType","OnShellChannels","Scope",
          "DenominatorsKeptOffShell","OffCutIdentityClaimed"}],
          <|"Grouping"->"WholeCorrelatedShellDifference","OriginalShellRemainder"->record["ShellRemainder"],
            "ContourMultiplier"->contour,"InternalConditionsReapplied"->False,
            "ModelCouplingsPreserved"->True,"NewIndependentInteraction"->False|>]]],
      {record,candidates}];
    plan=completionInheritedExchangePlan[normalized,model];
    If[FailureQ[plan],Throw[False,tag]];
    basis=completionExchangeBasis[directions,plan,normalized["ExternalMassRules"]];
    basis=completionIndependentBasis[basis,Max[0.000001,Min[1,seconds-(AbsoluteTime[]-started)]]];
    True,tag],seconds,False];
  <|"Status"->If[TrueQ[completed],"AVAILABLE","UNAVAILABLE"],
    "Basis"->If[TrueQ[completed],basis,{}],"Sources"->sources,
    "SourceCatalogComplete"->TrueQ[completed],"SourceRecords"->Length[candidates],
    "SkippedSources"->skipped,"CatalogScope"->"AllRecordedCandidatesExamined;OnlySupportedWholeDifferencesProposed",
    "WholeDirections"->Length[basis],"EstimatedAtomicDirections"->atomic,
    "ElapsedTime"->AbsoluteTime[]-started,
    "Scope"->"WholeRetainedShellDifferencesRequiringAllOriginalAmplitudeChecks"|>
];
completionHEWholeSourcePreflightQ[normalized_Association,metrics_Association] :=
  Lookup[metrics,"CoherentComponents",1]>=16 && AnyTrue[
    Join[Lookup[normalized,"RemainderData",{}],Lookup[normalized,"ChannelRemainderData",{}]],
    AssociationQ[#] && TrueQ[Lookup[#,"HasInternalConditions",False]] &&
      !MissingQ[Lookup[#,"ShellRemainder",Missing[]]]&];
completionHEWholeSourceEligibleQ[proposal_,metrics_Association] := AssociationQ[proposal] &&
  Lookup[proposal,"Status",None]==="AVAILABLE" && TrueQ[Lookup[proposal,"SourceCatalogComplete",False]] &&
  ListQ[Lookup[proposal,"Basis",None]] && 0<Length[proposal["Basis"]]<=16 &&
  Lookup[metrics,"CoherentComponents",1]>=16 &&
  Lookup[proposal,"EstimatedAtomicDirections",0]>=Max[32,4 Length[proposal["Basis"]]];

completionHESourceRemainders[normalized_Association, seconds_, model_: None, choice_: Automatic] := Module[
  {records, candidates, directions = {}, provenance = {}, started = AbsoluteTime[], value,
   external = normalized["ExternalMassRules"], allowance, degree, terms, groups, item, alternatives,
   sources, contour, common, referenceSources, referenceDirection, affineReferences, cubicSource},
  cubicSource = TimeConstrained[completionHECubicBilinearSource[normalized, model, choice, Min[3, seconds]],
    Min[3, seconds], Missing["CubicCurrentBudget"]];
  If[AssociationQ[cubicSource] && cubicSource["Direction"] =!= 0,
    AppendTo[directions, cubicSource["Direction"]]; AppendTo[provenance, KeyDrop[cubicSource, "Direction"]]];
  affineReferences = completionHEFamilyReferenceDirections[normalized, model, choice, Min[3, seconds]];
  If[AssociationQ[affineReferences],
    directions = Join[directions, affineReferences["Basis"]];
    provenance = Join[provenance, ConstantArray[
      KeyDrop[affineReferences, {"Basis", "OriginalFamily", "PreparedFamily"}], Length[affineReferences["Basis"]]]]];
  common = completionHECommonReferenceRemainder[normalized, model, choice, Min[3, seconds]];
  If[AssociationQ[common] && common["Direction"] =!= 0,
    AppendTo[directions, common["Direction"]]; AppendTo[provenance, KeyDrop[common, "Direction"]]];
  records = Join[Lookup[normalized, "RemainderData", {}],
    Lookup[normalized, "ChannelRemainderData", {}]];
  (* Channel preparation retains the public sewn-product convention, including
     its contour factor. Convert source differences exactly as the residue
     checker converts the original channels before treating them as amplitudes. *)
  records = Map[Function[record,
    If[!AssociationQ[record] || Lookup[record, "InputType", None] =!= "FactorizationChannel",
      record,
      sources = KeyTake[record, {"ShellRemainder", "FixedReferenceExpression", "ReferenceInputExpression"}];
      contour = If[FreeQ[Lookup[record, "FixedReferenceExpression", 0], ConstructiveDiagrams`z],
        1, ConstructiveDiagrams`z];
      Join[record, Map[If[MissingQ[#], #, Cancel[-contour #]] &, sources],
        <|"ReferenceContinuations" -> Map[Function[continuation,
          If[AssociationQ[continuation] && KeyExistsQ[continuation, "Expression"],
            Join[continuation, <|"Expression" -> Cancel[-contour continuation["Expression"]]|>],
            continuation]], Lookup[record, "ReferenceContinuations", {}]]|>]]], records];
  candidates = Select[records, AssociationQ[#] &&
    TrueQ[Lookup[#, "HasInternalConditions", False]] &&
    !MissingQ[Lookup[#, "ShellRemainder", Missing[]]] &];
  degree[chain_SpinorChain] := Count[List @@ chain, _Mom];
  degree[trace_SpinorTrace] := Count[List @@ trace, _Mom];
  degree[product_Times] := Total[degree /@ List @@ product];
  degree[Power[base_, exponent_Integer?Positive]] := exponent degree[base];
  degree[_] := 0;
  Do[
    allowance = Max[0, seconds - (AbsoluteTime[] - started)];
    If[allowance <= 0, Break[]];
    referenceSources = Select[Lookup[record, "ReferenceContinuations", {}],
      AssociationQ[#] && Lookup[#, "Mode", None] === "Xi" && KeyExistsQ[#, "Expression"] &];
    If[!MissingQ[Lookup[record, "ReferenceInputExpression", Missing[]]],
      referenceSources = {
        <|"Mode" -> "OriginalReferenceLabels", "Expression" -> record["ReferenceInputExpression"]|>}];
    If[!MissingQ[Lookup[record, "FixedReferenceExpression", Missing[]]],
      Do[
        referenceDirection = source["Expression"] - record["FixedReferenceExpression"];
        If[referenceDirection =!= 0 && residueFiniteQ[referenceDirection] &&
            !FreeQ[referenceDirection, Spinor["Xi", ___]] &&
            FreeQ[referenceDirection, _xFactor | _xTildeFactor],
          groups = If[rspSandwichExpansionCount[referenceDirection] <= 256,
            terms = preparationProtectedDenominators[referenceDirection, Expand];
            Values[GroupBy[If[Head[terms] === Plus, List @@ terms, {terms}], degree, Total]],
            {referenceDirection}];
          Do[If[item =!= 0 && !MemberQ[directions, item],
            AppendTo[directions, item];
            AppendTo[provenance, Join[KeyTake[record, {"InputType", "OnShellChannels", "Scope"}],
              <|"Grouping" -> "RetainedReferenceChange", "ReferenceMode" -> source["Mode"],
                "MomentumDegree" -> degree[item], "InternalOnShellConditions" -> {},
                "OffCutIdentityClaimed" -> False, "RequiresFullAmplitudeValidation" -> True|>]]],
            {item, DeleteDuplicates[groups]}]],
        {source, referenceSources}]];
    alternatives = completionHESharedMomentumRemainders[record, Min[2, allowance]];
    Do[If[!MemberQ[directions, item], AppendTo[directions, item];
      AppendTo[provenance, Join[KeyTake[record, {"InputType", "OnShellChannels", "Scope"}],
        <|"Grouping" -> "SharedMomentumDeterminantContinuation"|>]]], {item, alternatives}];
    value = record["ShellRemainder"];
    If[!residueFiniteQ[value] || value === 0 ||
        !FreeQ[value, _xFactor | _xTildeFactor | (Spinor | SpinorHat)["Xi", ___]], Continue[]];
    allowance = Max[0, seconds - (AbsoluteTime[] - started)];
    If[allowance <= 0, Break[]];
    value = TimeConstrained[completionCanonicalReduce[value, external], Min[2, allowance], value];
    If[value === 0, Continue[]];
    (* Keep the complete momentum-degree groups from the actual difference.
       A whole remainder can combine a regular descendant with pole terms;
       requiring their coefficients to move together can hide the repair. *)
    groups = If[rspSandwichExpansionCount[value] <= 256,
      terms = preparationProtectedDenominators[value, Expand];
      Values[GroupBy[If[Head[terms] === Plus, List @@ terms, {terms}], degree, Total]], {value}];
    Do[If[item =!= 0 && !MemberQ[directions, item],
      AppendTo[directions, item];
      AppendTo[provenance, Join[KeyTake[record, {"InputType", "OnShellChannels", "Scope",
        "DenominatorsKeptOffShell", "OffCutIdentityClaimed"}],
        <|"Grouping" -> "CompleteMomentumDegree", "MomentumDegree" -> degree[item]|>]]],
      {item, groups}], {record, candidates}];
  <|"Basis" -> directions, "Sources" -> provenance, "SourceRecords" -> Length[candidates],
    "ElapsedTime" -> (AbsoluteTime[] - started),
    "Scope" -> "RetainedDiagramAndChannelShellDifferencesWithoutNewInteractions"|>
];

(* A dense rational external chart is an algebraic identity certificate, not
   another finite kinematic sample. Lorentz transformations put either two
   nonzero-mass momenta in rest/diagonal form, or two noncollinear null momenta
   in the two coordinate directions. The remaining axial rotation makes one
   free shell matrix symmetric. These gauge choices cover a dense complex
   Lorentz orbit; two final mass shells are solved rationally by fixing their
   first row, as in residueSplitTwoBody. No internal invariant is constrained.
   Independent coherent spin variables retain every external tensor component.
   Fixed spin components and auxiliary references are excluded from this proof. *)
(* A representation choice for the same dense external chart. Opposite
   nonzero massless little-group weights place one angle-dominated and one
   square-dominated leg on the two coordinate axes. No model or multiplicity
   is hard-coded. Missing or homogeneous weights retain the existing axes. *)
completionHEPreferredNullPivots[expression_, rules_List] := Module[
  {external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]],
   null, weights, byLeg, opposite},
  null = Select[external, TrueQ[(Mass[#] /. rules) === 0] &];
  If[Length[null] < 2, Return[Automatic]];
  weights = completionExternalSpinWeights[expression, rules];
  If[!ListQ[weights] || Length[weights] =!= Length[external] ||
      !AllTrue[weights, NumberQ], Return[Take[null, 2]]];
  byLeg = AssociationThread[external, weights];
  opposite = SelectFirst[Subsets[null, {2}],
    TrueQ[Times @@ (Lookup[byLeg, #]) < 0] &, Missing["NoOppositeWeights"]];
  If[MissingQ[opposite], Take[null, 2], opposite]
];

completionHESymbolicExternalChart[rules_List, nullPivots_: Automatic, dependentShells_: Automatic] := Module[
  {external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]],
   masses, null, massive, momenta = <||>, variables = {}, variable, new, shell,
   free, final, total, a, b, k, x, y, first, angle = <||>, square = <||>,
   angleBasis = <||>, squareBasis = <||>, spins = {}, basis, vector, chart},
  If[Length[external] < 4 || !DuplicateFreeQ[external], Return[$Failed]];
  masses = AssociationThread[external, (Mass /@ external) /. rules];
  If[!FreeQ[Values[masses], _Mass], Return[$Failed]];
  null = Select[external, masses[#] === 0 &]; massive = Complement[external, null];
  If[nullPivots =!= Automatic,
    If[!MatchQ[nullPivots, {_Integer, _Integer}] || !DuplicateFreeQ[nullPivots] ||
        !ContainsAll[null, nullPivots], Return[$Failed]];
    null = Join[nullPivots, Complement[null, nullPivots]]];
  new[] := (variable = Unique["externalIdentityCoordinate"];
    AppendTo[variables, variable]; variable);
  shell[mass_, symmetric_] := Module[{aa = new[], bb = new[], cc},
    cc = If[TrueQ[symmetric], bb, new[]]; {{aa, bb}, {cc, (mass^2 + bb cc)/aa}}];
  Which[
    Length[null] >= 2,
      AssociateTo[momenta, {null[[1]] -> {{1, 0}, {0, 0}},
        null[[2]] -> {{0, 0}, {0, new[]}}}],
    null =!= {} && massive =!= {},
      AssociateTo[momenta, {First[massive] -> masses[First[massive]] IdentityMatrix[2],
        First[null] -> {{new[], 0}, {0, 0}}}],
    Length[massive] >= 2,
      variable = new[];
      AssociateTo[momenta, {massive[[1]] -> masses[massive[[1]]] IdentityMatrix[2],
        massive[[2]] -> {{variable, 0}, {0, masses[massive[[2]]]^2/variable}}}],
    True, Return[$Failed]];
  free = Complement[external, Keys[momenta]];
  If[dependentShells === Automatic,
    final = Take[free, -2]; free = Drop[free, -2],
    If[!MatchQ[dependentShells, {_Integer, _Integer}] || !DuplicateFreeQ[dependentShells] ||
        !ContainsAll[free, dependentShells], Return[$Failed]];
    final = dependentShells; free = Complement[free, final]];
  Do[AssociateTo[momenta, leg -> shell[masses[leg], leg === First[free]]], {leg, free}];
  total = -Total[Values[momenta]]; {a, b} = {new[], new[]};
  k = Det[total] + masses[First[final]]^2 - masses[Last[final]]^2;
  If[residueExactZero[total[[1, 1]]] ||
      residueExactZero[a total[[1, 2]] - b total[[1, 1]]], Return[$Failed]];
  x = Cancel[(masses[First[final]]^2 total[[1, 1]] -
      a (k - total[[2, 2]] a + total[[2, 1]] b))/
      (a total[[1, 2]] - b total[[1, 1]])];
  y = Cancel[(k - total[[2, 2]] a + total[[2, 1]] b + total[[1, 2]] x)/total[[1, 1]]];
  first = {{a, b}, {x, y}};
  AssociateTo[momenta, {First[final] -> first, Last[final] -> (total - first)}];
  If[!residueExactZero[Total[Values[momenta]]] ||
      !AllTrue[external, residueExactZero[Det[momenta[#]] - masses[#]^2] &], Return[$Failed]];
  Do[
    If[masses[leg] === 0,
      If[momenta[leg][[1, 1]] === 0,
        If[residueExactZero[momenta[leg][[2, 2]]], Return[$Failed]];
        AssociateTo[angle, leg -> momenta[leg][[All, 2]]];
        AssociateTo[square, leg -> {momenta[leg][[2, 1]]/momenta[leg][[2, 2]], 1}],
        AssociateTo[angle, leg -> momenta[leg][[All, 1]]];
        AssociateTo[square, leg -> {1, momenta[leg][[1, 2]]/momenta[leg][[1, 1]]}]],
      basis = {{masses[leg], 0}, {0, 1}}; vector = Unique["externalIdentitySpin"];
      AppendTo[spins, vector]; AssociateTo[angleBasis, leg -> basis];
      AssociateTo[squareBasis, leg -> ({{0, 1}, {-1, 0}}.residueAdjugate[momenta[leg]].basis/masses[leg])];
      AssociateTo[angle, leg -> basis.{1, vector}];
      AssociateTo[square, leg -> squareBasis[leg].{1, vector}]], {leg, external}];
  chart = <|"Momenta" -> momenta, "Masses" -> masses, "Angle" -> angle, "Square" -> square,
    "AngleBasis" -> angleBasis, "SquareBasis" -> squareBasis,
    "SpinVariables" -> spins,
    "NullAxisLegs" -> If[Length[null] >= 2, Take[null, 2], {}],
    "DependentShellLegs" -> final,
    "PoleVariable" -> Unique["unusedIdentityPole"],
    "ReferenceSeed" -> 0, "CoherentVectorSpinIndices" -> True,
    "ExternalIdentityCoordinates" -> variables, "ExternalMassShellsValidated" -> True,
    "MomentumConservationValidated" -> True, "InternalOnShellConditions" -> {}|>;
  chart
];

(* Frame fixing is valid only for Lorentz-covariant typed scalars. In
   particular, an angle--square product without an odd momentum word is not
   an invariant and must never acquire an identity certificate in one frame. *)
completionHECovariantScalarQ[expression_, external_List, allowReferences_: False] := Module[
  {scalar, vector, endpoint, chain, index, argument},
  index[value_] := With[{labels = residueMomentumLegs[value]},
    ListQ[labels] && labels =!= {} && ContainsAll[external, labels]];
  vector[Mom[value_]] := index[value];
  vector[value_Plus] := AllTrue[List @@ value, vector];
  vector[Times[coefficient_?NumericQ, momentum_]] := vector[momentum];
  vector[_] := False;
  endpoint[spinor_Spinor] := Module[{data = List @@ spinor, position, label, indices},
    position = FirstPosition[data, "Angle" | "Square", Missing["Type"]];
    If[MissingQ[position], Return[False]]; position = First[position];
    If[position >= Length[data], Return[False]]; label = data[[position + 1]];
    If[First[data] === "Xi", Return[TrueQ[allowReferences] &&
      MatchQ[data, {"Xi", "Angle" | "Square", _}]]];
    If[!MemberQ[external, label], Return[False]]; indices = Drop[data, position + 1];
    Which[
      First[data] === "Helicity", position === 2 && indices === {},
      First[data] === "Spin", MemberQ[{2, 3}, position] &&
        (position === 2 || MemberQ[{"Upper", "Lower"}, data[[2]]]) &&
        MatchQ[indices, {} | {VectorSpinIndex[label, 1 | 2]}],
      True, False]];
  endpoint[_] := False;
  chain[value_SpinorChain] := Module[{items = List @@ value, first, last, count},
    If[Length[items] < 2 || !endpoint[First[items]] || !endpoint[Last[items]], Return[False]];
    first = rspSpinorType[First[items]]; last = rspSpinorType[Last[items]]; count = Length[items] - 2;
    AllTrue[Take[items, {2, -2}], vector] &&
      last === If[EvenQ[count], first, If[first === "Angle", "Square", "Angle"]]];
  scalar[value_?NumberQ] := True;
  scalar[_Symbol] := True;
  scalar[_ModelParameter] := True;
  scalar[Mass[label_Integer]] := MemberQ[external, label];
  scalar[value : (_Plus | _Times)] := AllTrue[List @@ value, scalar];
  scalar[Power[momentum_Mom, exponent_Integer?EvenQ]] := vector[momentum];
  scalar[Power[base_, exponent_Integer]] := scalar[base];
  (* Noninteger powers of kinematics carry branch information which a
     Lorentz/little-group frame choice must not silently fix. *)
  scalar[Power[base_, exponent_Rational]] := scalar[base] &&
    FreeQ[base, _SpinorChain | _SpinorTrace | _MomProd | _PropDen | _Mandelstahm | _Mom | _Spinor];
  scalar[value_SpinorChain] := chain[value];
  scalar[value_SpinorTrace] := EvenQ[Length[value]] && AllTrue[List @@ value, vector];
  argument[value : (_Integer | _Multiparticle)] := Mom[value];
  argument[value_] := value;
  scalar[MomProd[left_, right_]] := vector[argument[left]] && vector[argument[right]];
  scalar[value_Mandelstahm] := Length[value] >= 1 && AllTrue[List @@ value, MemberQ[external, #] &];
  scalar[value_PropDen] := MemberQ[{2, 3}, Length[value]] && vector[First[value]] &&
    AllTrue[Rest[List @@ value], scalar];
  scalar[_] := False;
  TrueQ[scalar[expression]]
];

(* This structural bound may overestimate degree. Native symbolic derivatives
   independently certify it before every Taylor coefficient is checked. *)
completionHECoherentPolynomialDegreeBounds[expression_, variables_List] := Module[
  {visit, count = Length[variables], zero, invalid = $Failed},
  If[!DuplicateFreeQ[variables] || !AllTrue[variables, MatchQ[#, _Symbol] &], Return[invalid]];
  zero = ConstantArray[0, count];
  visit[value_] := visit[value] = Which[
    MemberQ[variables, value], UnitVector[count, First[FirstPosition[variables, value]]],
    FreeQ[value, Alternatives @@ variables], zero,
    Head[value] === Plus, With[{children = visit /@ (List @@ value)},
      If[MemberQ[children, invalid], invalid, Max /@ Transpose[children]]],
    Head[value] === Times, With[{children = visit /@ (List @@ value)},
      If[MemberQ[children, invalid], invalid, Total[children]]],
    Head[value] === Power && IntegerQ[value[[2]]] && value[[2]] >= 0,
      With[{base = visit[value[[1]]]}, If[base === invalid, invalid, value[[2]] base]],
    True, invalid];
  visit[expression]
];

completionHECoherentComponentCertificate[mapped_, variables_List, seconds_: Infinity] := Module[
  {work, invalid = <|"Status" -> "NOT_PROVED", "Method" -> "TimeConstraint"|>},
  If[!(seconds === Infinity || NumericQ[seconds] && TrueQ[seconds > 0]), Return[invalid]];
  work[] := Module[{bounds, boundChecks, orders, expected, coefficient,
      checked = {}, exactZero, record, unsupportedCoefficient = False,
      sparse, sparseRules, sparseRecord, sparseChecked, sparseComplete},
    If[!DuplicateFreeQ[variables] || !AllTrue[variables, MatchQ[#, _Symbol] &] ||
        !residueFiniteQ[mapped] || residueUnmappedQ[mapped] || !FreeQ[mapped, _Real],
      Return[<|"Status" -> "NOT_PROVED", "Method" -> "UnsupportedCoherentPolynomial"|>]];
    If[LeafCount[mapped] > 50000,
      sparse = amplitudeCoherentPolynomialRules[mapped, variables,
        If[seconds === Infinity, 10, Min[10, seconds/3]]];
      If[Lookup[sparse, "Status", None] === "COMPLETE" &&
          TrueQ[sparse["FullCoefficientCoverage"]] && TrueQ[sparse["ReconstructionVerified"]],
        sparseRules = sparse["CoefficientRules"]; sparseChecked = {};
        sparseRecord = <|"PolynomialQ" -> True, "DegreeUpperBounds" -> sparse["DegreeUpperBounds"],
          "DegreeBoundsVerified" -> True,
          "DegreeBoundVerificationMethod" -> "ExactRecursivePolynomialReconstruction",
          "CoefficientMethod" -> "ExactSparseCoherentCoefficients",
          "ComponentCount" -> Length[sparseRules], "ComponentMonomials" -> First /@ sparseRules,
          "SpinVariables" -> variables, "ConstantCoefficientIncluded" -> True,
          "NumericalKinematicSamples" -> 0, "CoherentSpinSamples" -> 0,
          "PolynomialExtraction" -> KeyDrop[sparse, "CoefficientRules"],
          "InternalOnShellConditions" -> {}|>;
        Do[
          coefficient = Last[sparseRule];
          exactZero = TrueQ[Cancel[Together[coefficient], Extension -> Automatic] === 0];
          AppendTo[sparseChecked, <|"Monomial" -> First[sparseRule], "ExactZero" -> exactZero|>];
          If[!exactZero, Break[]], {sparseRule, sparseRules}];
        sparseComplete = Length[sparseChecked] === Length[sparseRules];
        Return[Join[sparseRecord, <|"Status" -> If[sparseComplete &&
              AllTrue[sparseChecked, TrueQ[#["ExactZero"]] &], "PROVED_ZERO", "NOT_PROVED"],
          "Method" -> If[sparseComplete && AllTrue[sparseChecked, TrueQ[#["ExactZero"]] &],
            "CoherentPolynomialComponents", "NonzeroCoherentPolynomialComponent"],
          "ComponentProofs" -> sparseChecked, "ComponentsChecked" -> Length[sparseChecked],
          "FullCoefficientCoverage" -> sparseComplete,
          "ReconstructionVerified" -> sparseComplete,
          "ReconstructionMethod" -> "ExactSparsePolynomialCoverage",
          "AllComponentsZero" -> (sparseComplete && AllTrue[sparseChecked, TrueQ[#["ExactZero"]] &])|>]]]];
    If[!TrueQ[PolynomialQ[mapped, variables]], Return[<|"Status" -> "NOT_PROVED",
      "Method" -> "NonPolynomialCoherentSpins", "PolynomialQ" -> False|>]];
    bounds = completionHECoherentPolynomialDegreeBounds[mapped, variables];
    If[!ListQ[bounds] || Length[bounds] =!= Length[variables] ||
        !AllTrue[bounds, IntegerQ[#] && # >= 0 &], Return[<|"Status" -> "NOT_PROVED",
      "Method" -> "UnsupportedCoherentPolynomialDegree", "PolynomialQ" -> True|>]];
    expected = Times @@ (bounds + 1);
    If[expected > 4096, Return[<|"Status" -> "NOT_PROVED", "Method" -> "CoherentComponentLimit",
      "PolynomialQ" -> True, "DegreeUpperBounds" -> bounds,
      "ComponentCount" -> expected, "MaximumComponents" -> 4096|>]];
    boundChecks = MapThread[Function[{variable, bound},
      TrueQ[D[mapped, {variable, bound + 1}] === 0]], {variables, bounds}];
    If[!AllTrue[boundChecks, TrueQ], Return[<|"Status" -> "NOT_PROVED",
      "Method" -> "CoherentPolynomialDegreeBoundFailed", "PolynomialQ" -> True,
      "DegreeUpperBounds" -> bounds, "DegreeBoundDerivativesZero" -> boundChecks,
      "DegreeBoundsVerified" -> False|>]];
    orders = Tuples[Range[0, #] & /@ bounds];
    record = <|"PolynomialQ" -> True, "DegreeUpperBounds" -> bounds,
      "DegreeBoundsVerified" -> True, "DegreeBoundDerivativesZero" -> boundChecks,
      "CoefficientMethod" -> "ExactSymbolicTaylorCoefficients",
      "ComponentCount" -> expected, "ComponentMonomials" -> orders,
      "SpinVariables" -> variables, "ConstantCoefficientIncluded" -> True,
      "NumericalKinematicSamples" -> 0, "CoherentSpinSamples" -> 0,
      "InternalOnShellConditions" -> {}|>;
    Do[
      (* Taylor coefficients are symbolic derivatives, not sampled spin states.
         Substituting one variable at a time preserves scalar factoring. *)
      coefficient = Fold[Function[{polynomial, index},
        (D[polynomial, {variables[[index]], order[[index]]}]/Factorial[order[[index]]]) /.
          variables[[index]] -> 0], mapped, Range[Length[variables]]];
      If[!FreeQ[coefficient, Alternatives @@ variables] || !residueFiniteQ[coefficient],
        unsupportedCoefficient = True; Break[]];
      exactZero = TrueQ[Cancel[Together[coefficient], Extension -> Automatic] === 0];
      AppendTo[checked, <|"Monomial" -> order, "ExactZero" -> exactZero|>];
      If[!exactZero, Break[]], {order, orders}];
    If[unsupportedCoefficient, Return[Join[record, <|"Status" -> "NOT_PROVED",
      "Method" -> "UnsupportedCoherentTaylorCoefficient", "ComponentProofs" -> checked,
      "ComponentsChecked" -> Length[checked], "FullCoefficientCoverage" -> False,
      "ReconstructionVerified" -> False, "AllComponentsZero" -> False|>]]];
    (* Polynomiality plus the independently certified degree bounds makes the
       complete Taylor grid an exact reconstruction theorem. Partial traversal
       or even one nonzero coefficient must never produce a zero certificate. *)
    If[Length[checked] =!= expected || !AllTrue[checked, TrueQ[#["ExactZero"]] &],
      Return[Join[record, <|"Status" -> "NOT_PROVED",
        "Method" -> "NonzeroCoherentPolynomialComponent", "ComponentProofs" -> checked,
        "ComponentsChecked" -> Length[checked], "FullCoefficientCoverage" -> (Length[checked] === expected),
        "ReconstructionVerified" -> (Length[checked] === expected), "AllComponentsZero" -> False|>]]];
    Join[record, <|"Status" -> "PROVED_ZERO", "Method" -> "CoherentPolynomialComponents",
      "ComponentProofs" -> checked, "ComponentsChecked" -> Length[checked],
      "FullCoefficientCoverage" -> True, "ReconstructionVerified" -> True,
      "ReconstructionMethod" -> "VerifiedPolynomialTaylorCoverage", "AllComponentsZero" -> True|>]
  ];
  If[seconds === Infinity, work[], TimeConstrained[work[], seconds, invalid]]
];

(* Coordinate choices change only the rational parametrization. Prefer solving
   two remaining massive shells when available; retain the original chart too. *)
completionHEIdentityChartChoices[expression_, rules_List] := Module[
  {external, null, massive, axes, fixed, available, dependent, legacy},
  external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]];
  null = Select[external, TrueQ[(Mass[#] /. rules) === 0] &];
  massive = Complement[external, null];
  axes = completionHEPreferredNullPivots[expression, rules];
  fixed = Which[Length[null] >= 2, If[ListQ[axes], axes, Take[null, 2]],
    null =!= {} && massive =!= {}, {First[massive], First[null]},
    Length[massive] >= 2, Take[massive, 2], True, {}];
  available = Complement[external, fixed];
  legacy = <|"NullAxisLegs" -> axes, "DependentShellLegs" -> Automatic|>;
  dependent = Intersection[available, massive];
  If[Length[available] < 2 || Length[dependent] < 2, Return[{legacy}]];
  dependent = Take[dependent, 2];
  If[dependent === Take[available, -2], {legacy},
    {<|"NullAxisLegs" -> axes, "DependentShellLegs" -> dependent|>, legacy}]
];

(* Helicity spinors use the massless Dirac identities in Base. A massive
   coherent chart must not silently reinterpret a malformed helicity tag. *)
completionHEMasslessHelicityTagsQ[expression_, rules_List] := Module[{legs, external},
  external = preparationExternalRules[rules];
  legs = Cases[expression, spinor : Spinor["Helicity", ___] :> rspSpinorLeg[spinor], {0, Infinity}];
  AllTrue[legs, IntegerQ[#] && TrueQ[(Mass[#] /. external) === 0] &]
];

completionHEReferenceIdentityCertificate[expression_, rules_List, seconds_] := Module[
  {references = referenceExpressionMetadata[expression]["References"], external,
   unsupported, weights, work, started = AbsoluteTime[]},
  external = Sort[Cases[rules, HoldPattern[Mass[leg_Integer] -> _] :> leg]];
  unsupported = !FreeQ[expression, _Real | _SpinorHat | _MomHat | _xFactor | _xTildeFactor |
    Spinor["Zeta", ___]] || AnyTrue[Cases[expression, spinor_Spinor /;
      First[List @@ spinor] === "Spin", Infinity], Function[spinor,
        With[{data = List @@ spinor}, With[{position = First[FirstPosition[data, "Angle" | "Square"]]},
          !MatchQ[Drop[data, position + 1], {} | {VectorSpinIndex[_, 1 | 2]}]]]]];
  weights = completionExternalSpinWeights[expression, rules];
  If[references === {} || unsupported || !ListQ[weights] || !TrueQ[seconds > 0] ||
      !completionHEMasslessHelicityTagsQ[expression, rules] ||
      !completionHECovariantScalarQ[expression, external, True],
    Return[<|"Status" -> "NOT_PROVED", "Method" -> "UnsupportedAuxiliaryReferenceIdentity"|>]];
  work[] := Module[{chart, coordinates, mapped, rational, numerator},
    chart = completionHESymbolicExternalChart[rules];
    If[!AssociationQ[chart], Return[<|"Status" -> "NOT_PROVED", "Method" -> "UnsupportedExternalChart"|>]];
    coordinates = Association[(# -> Table[Unique["identityReference"], {4}]) & /@ references];
    chart = Join[chart, <|"ReferenceOverrides" -> referenceOverrideVectors[coordinates]|>];
    mapped = spuriousEvaluateCurve[expression, chart, {}];
    If[!residueFiniteQ[mapped] || residueUnmappedQ[mapped] || ListQ[mapped] ||
        !FreeQ[mapped, _Missing | _Failure],
      Return[<|"Status" -> "NOT_PROVED", "Method" -> "UnsupportedReferenceEvaluation"|>]];
    rational = Cancel[Together[mapped]]; numerator = Numerator[rational];
    If[numerator =!= 0, Return[<|"Status" -> "NOT_PROVED", "Method" -> "NonzeroSymbolicReferenceChart"|>]];
    <|"Status" -> "PROVED_ZERO", "Method" -> "DenseSymbolicExternalAndReferenceChart",
      "Chart" -> chart, "ReferenceCoordinates" -> coordinates,
      "FullAuxiliaryReferenceCoordinates" -> True, "CovariantTypedScalar" -> True,
      "ExternalSpinHomogeneity" -> weights, "NumericalKinematicSamples" -> 0,
      "NumericalParameterAssignments" -> {}, "InternalOnShellConditions" -> {},
      "ExactRationalNumerator" -> 0|>
  ];
  Join[TimeConstrained[MemoryConstrained[work[], 268435456,
      <|"Status" -> "NOT_PROVED", "Method" -> "ReferenceIdentityMemoryLimit"|>],
    Min[12, seconds], <|"Status" -> "NOT_PROVED", "Method" -> "ReferenceIdentityTimeLimit"|>],
    <|"ElapsedTime" -> AbsoluteTime[] - started|>]
];

(* A nonzero value at one exact point proves that a cleared denominator is not
   identically zero on this same dense chart. It never proves amplitude zero. *)
completionHERawDenominatorWitness[denominator_, chart_Association, seconds_] := Module[
  {mapped, patches, parameters, placeholders, forward, backward, scalar, scalarPatches,
   variables, assignment, value, patchValues, result = Missing["UncertifiedClearedDenominator"]},
  If[!TrueQ[seconds > 0] || !TrueQ[Lookup[chart, "ExternalMassShellsValidated", False]] ||
      !TrueQ[Lookup[chart, "MomentumConservationValidated", False]], Return[result]];
  TimeConstrained[
    mapped = spuriousEvaluateCurve[denominator, chart, {}];
    If[!residueFiniteQ[mapped] || residueUnmappedQ[mapped] || !FreeQ[mapped, _Real], Return[result]];
    patches = DeleteDuplicates[Join[DeleteCases[Values[chart["Masses"]], 0],
      Denominator[Together[#]] & /@ Flatten[Values /@ Lookup[chart,
        {"Momenta", "AngleBasis", "SquareBasis"}, <||>]]]];
    parameters = DeleteDuplicates[Cases[{mapped, patches}, _ModelParameter, {0, Infinity}]];
    placeholders = Table[Unique["rawDenominatorParameter"], {Length[parameters]}];
    forward = Thread[parameters -> placeholders]; backward = Thread[placeholders -> parameters];
    scalar = mapped /. forward; scalarPatches = patches /. forward;
    variables = DeleteDuplicates[Cases[{scalar, scalarPatches}, symbol_Symbol /; Context[symbol] =!= "System`", {0, Infinity}]];
    Do[
      assignment = Thread[variables -> Table[offset + index, {index, Length[variables]}]];
      value = scalar /. assignment;
      If[NumericQ[value] && FreeQ[value, _Real] && residueFiniteQ[value],
        value = RootReduce[value]; patchValues = scalarPatches /. assignment;
        If[AllTrue[patchValues, NumericQ[#] && FreeQ[#, _Real] && residueFiniteQ[#] &],
          patchValues = RootReduce /@ patchValues,
          patchValues = {0}];
        If[TrueQ[Element[value, Algebraics]] && value =!= 0 &&
            AllTrue[patchValues, TrueQ[Element[#, Algebraics]] && # =!= 0 &],
          result = <|"Status" -> "PROVED_NONZERO", "Method" -> "ExactAlgebraicNonzeroWitness",
            "Denominator" -> denominator, "MappedDenominator" -> mapped,
            "ExactWitnessRules" -> (assignment /. backward), "ExactWitnessValue" -> value,
            "ChartDomainExpressions" -> patches, "ExactDomainValues" -> patchValues,
            "WitnessOnDenseChartDomain" -> True,
            "Purpose" -> "NonemptyGenericDenominatorDomainOnly", "AmplitudeZeroSamples" -> 0,
            "ModelDefinitionsUsed" -> {}, "InternalOnShellConditions" -> {}|>; Break[]]],
      {offset, 1, 3}], seconds, Null]; result
];

completionHERawParameterIdentityProof[expression_, rules_List, model_List, seconds_] := Module[
  {started = AbsoluteTime[], left, reduction, candidate = expression, fraction, replay,
   proof, chart, denominatorProof, result},
  left[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  result = <|"Status" -> "NOT_PROVED", "Method" -> "RawParameterProofTimeConstraint"|>;
  If[!TrueQ[seconds > 0] || !completionHECovariantScalarQ[expression,
      Sort[Cases[rules, HoldPattern[Mass[leg_Integer] -> _] :> leg]]] ||
      !completionHEMasslessHelicityTagsQ[expression, rules], Return[result]];
  TimeConstrained[
    reduction = completionHEOrdinarySourceColumn[expression, rules, Min[5, left[]/6]];
    If[AssociationQ[reduction] && TrueQ[Lookup[reduction, "ExactFormalRegrouping", False]],
      candidate = reduction["Expression"]];
    fraction = TimeConstrained[Together[candidate], Min[2, left[]/8], $Failed];
    If[fraction === $Failed || !residueFiniteQ[fraction], Return[result]];
    replay = TimeConstrained[TrueQ[Together[candidate - fraction] === 0], Min[2, left[]/8], False];
    If[!replay, Return[result]];
    proof = Block[{$completionHEKeepRawModelParameters = True},
      completionHEZeroDirection[Numerator[fraction], rules, model, Max[0.000001, left[] - 2]]];
    If[Lookup[proof, "Status", None] =!= "PROVED_ZERO", Return[proof]];
    chart = Lookup[proof, "Chart", Missing["NoChart"]];
    If[!AssociationQ[chart], chart = completionHESymbolicExternalChart[rules]];
    If[!AssociationQ[chart], Return[result]];
    denominatorProof = completionHERawDenominatorWitness[Denominator[fraction], chart, Min[2, left[]]];
    If[!AssociationQ[denominatorProof] || Lookup[denominatorProof, "Status", None] =!= "PROVED_NONZERO",
      Return[<|"Status" -> "NOT_PROVED", "Method" -> "UncertifiedClearedDenominator"|>]];
    result = Join[proof, <|"RawModelParameterProof" -> <|
      "OriginalExpression" -> expression, "GroupedExpression" -> candidate,
      "ProofExpression" -> Numerator[fraction], "ClearedDenominator" -> Denominator[fraction],
      "ExactRationalRegrouping" -> replay, "DenominatorNonzeroCertificate" -> denominatorProof,
      "OrdinaryReduction" -> If[AssociationQ[reduction], KeyDrop[reduction, "Expression"], reduction],
      "IndependentScalarParameters" -> True, "ModelDefinitionsUsed" -> {},
      "NumericalParameterAssignments" -> {}, "InternalOnShellConditions" -> {},
      "RemovalRequiresIndependentExactZeroCertificate" -> True|>,
      "InternalOnShellConditions" -> {}, "ElapsedTime" -> AbsoluteTime[] - started|>],
    seconds, Null]; result
];

(* The raw prefix already has its own deadline. Do not fraction its
   best-ranked chart a second time; complete tensor proofs need that allowance.
   Other portfolios retain their established reserve for alternative charts. *)
completionHEPreferredChartAllowance[left_, firstChoice_, choices_Integer] :=
  If[TrueQ[firstChoice] && choices > 1 && !TrueQ[$completionHEKeepRawModelParameters],
    2 left/3, left];

completionHEZeroDirection[expression_, rules_List, model_List, seconds_] := Module[
  {started = AbsoluteTime[], candidate = expression, prepared, result,
   unsupported, remaining, ordinaryBudget, weights, grouped, work, symbolicProof,
   symbolicPortfolio, chartForChoice, charts = <||>, earlyChoices, primitiveCount, coherentWork, compactEligible,
   compactStarted, compactBudget, compactLeft, compactValue, compactRecord,
   earlyCompacted = False, earlyBudget, earlyStarted, earlyBefore,
   compactRetry = Missing["NotRequested"], modelExpression, modelRules, modelProof, referenceProof,
   ordinarySource, ordinarySourceProof, ordinarySourceBudget, rawWeights, rawCoherentWork,
   rawProof = Missing["NotAttempted"], rawBudget, tensorProof, tensorSeconds},
  If[residueExactZero[expression], Return[<|"Status" -> "PROVED_ZERO",
    "Method" -> "ExactRationalAlgebra", "InternalOnShellConditions" -> {},
    "ElapsedTime" -> (AbsoluteTime[] - started)|>]];
  (* Try a short ordinary tensor proof with scalar parameters still symbolic.
     A lower complexity is not a zero certificate: only a completed literal
     zero endpoint with its exact identity replay can remove a direction. *)
  tensorSeconds = Min[2, Max[0, seconds - (AbsoluteTime[] - started)]/5];
  If[tensorSeconds > 0.005 && Length[preparationExternalRules[rules]] === 4 &&
      LeafCount[expression] <= 28000,
    tensorProof = rspFourLegTensorReduction[expression,
      preparationExternalRules[rules], True, tensorSeconds, None];
    If[AssociationQ[tensorProof] && Lookup[tensorProof, "Status", None] === "IMPROVED" &&
        Lookup[tensorProof, "Amplitude", None] === 0 &&
        Lookup[tensorProof, "InternalOnShellConditions", None] === {} &&
        ListQ[Lookup[tensorProof, "Route", None]] && tensorProof["Route"] =!= {},
      Return[<|"Status" -> "PROVED_ZERO", "Method" -> "OrdinaryExternalIdentities",
        "ProofInput" -> "ExactFourLegTensorQuotient", "OriginalDirection" -> expression,
        "OrdinaryTensorIdentityProof" -> tensorProof,
        "NumericalParameterAssignments" -> {}, "NumericalKinematicSamples" -> 0,
        "InternalOnShellConditions" -> {}, "ElapsedTime" -> AbsoluteTime[] - started|>]]];
  modelExpression = If[TrueQ[$completionHEKeepRawModelParameters], expression,
    modelExpandParameterDefinitions[expression, model]];
  If[!FailureQ[modelExpression] && modelExpression =!= expression,
    (* Model identities are a fallback. First try the stronger ordinary
       identity with every scalar model parameter still independent. Expanding
       dependent masses too early can introduce avoidable radical fields. *)
    rawWeights = completionExternalSpinWeights[expression, rules];
    If[ListQ[rawWeights] &&
        Length[rawWeights] === Length[Cases[rules, HoldPattern[Mass[_Integer] -> _]]],
      rawCoherentWork = Times @@ MapThread[
        If[TrueQ[(Mass[#1] /. rules) === 0], 1, 1 + Max[0, #2]] &,
        {Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]], rawWeights}];
      If[completionHEOrdinaryProofEligibleQ[expression, rules, rawWeights, rawCoherentWork] &&
          seconds - (AbsoluteTime[] - started) > 3,
        rawBudget = Min[30, (seconds - (AbsoluteTime[] - started))/2];
        rawProof = completionHERawParameterIdentityProof[expression, rules, model, rawBudget];
        If[Lookup[rawProof, "Status", None] === "PROVED_ZERO",
          Return[Join[rawProof, <|"ElapsedTime" -> AbsoluteTime[] - started|>]]]]];
    modelRules = modelExpandParameterDefinitions[rules, model];
    If[!FailureQ[modelRules],
      modelProof = completionHEZeroDirection[modelExpression, modelRules, model,
        Max[0, seconds - (AbsoluteTime[] - started)]];
      Return[Join[modelProof, <|"ModelDefinitionExpansion" -> <|
        "Definitions" -> (First[#] -> #[[2]] & /@ model[[4]]),
        "OriginalExpression" -> expression, "ExpandedExpression" -> modelExpression,
        "NumericalParameterAssignments" -> {}, "InternalOnShellConditions" -> {}|>,
        "RawParameterProofAttempt" -> If[AssociationQ[rawProof],
          KeyTake[rawProof, {"Status", "Method", "ElapsedTime"}], rawProof],
        "ElapsedTime" -> (AbsoluteTime[] - started)|>]]]];
  If[!FreeQ[expression, Spinor["Xi", ___]],
    referenceProof = completionHEReferenceIdentityCertificate[expression, rules,
      Max[0, seconds - (AbsoluteTime[] - started)]];
    If[Lookup[referenceProof, "Status", None] === "PROVED_ZERO", Return[referenceProof]]];
  unsupported = !FreeQ[expression, _SpinorHat | _MomHat | _xFactor | _xTildeFactor |
    Spinor["Xi" | "Zeta", ___]] || AnyTrue[Cases[expression, s_Spinor /;
      First[List @@ s] === "Spin", Infinity], Function[spinor,
        With[{data = List @@ spinor}, With[{position = First[FirstPosition[data, "Angle" | "Square"]]},
          !MatchQ[Drop[data, position + 1], {} | {VectorSpinIndex[_, 1 | 2]}]]]]];
  unsupported = unsupported || !completionHEMasslessHelicityTagsQ[expression, rules];
  weights = completionExternalSpinWeights[expression, rules];
  If[unsupported || !ListQ[weights] ||
      !completionHECovariantScalarQ[expression,
        Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]]] ||
      FreeQ[expression, _SpinorChain | _SpinorTrace | _MomProd | _PropDen | _Mandelstahm | _Mom] ||
      !TrueQ[seconds > 0],
    Return[<|"Status" -> "NOT_PROVED", "Method" -> "PreservedDirection"|>]];
  coherentWork = Times @@ MapThread[If[TrueQ[(Mass[#1] /. rules) === 0], 1, 1 + Max[0, #2]] &,
    {Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]], weights}];
  remaining[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  (* Ordinary grouping is a proof preconditioner, not a new zero test. Keep
     the full original direction and require the existing exact portfolio to
     certify its shorter ordinary representative before removing a coordinate. *)
  If[completionHEOrdinaryProofEligibleQ[expression, rules, weights, coherentWork] &&
      remaining[] > 3,
    ordinarySourceBudget = Min[2, remaining[]/6];
    ordinarySource = completionHEOrdinarySourceColumn[expression, rules, ordinarySourceBudget];
    If[AssociationQ[ordinarySource] && TrueQ[ordinarySource["ExactFormalRegrouping"]] &&
        LeafCount[ordinarySource["Expression"]] <= LeafCount[expression]/3,
      ordinarySourceProof = completionHEZeroDirection[ordinarySource["Expression"], rules, model,
        Min[10, remaining[]/3]];
      If[Lookup[ordinarySourceProof, "Status", None] === "PROVED_ZERO",
        Return[Join[ordinarySourceProof, <|"OrdinarySourcePreconditioning" -> <|
          "OriginalExpression" -> expression, "ReducedExpression" -> ordinarySource["Expression"],
          "Reduction" -> KeyDrop[ordinarySource,"Expression"],
          "OriginalCoefficientCoordinatePreserved" -> True,
          "PreconditionerMomentumConservation" -> False,
          "InternalOnShellConditions" -> {},
          "RemovalRequiresIndependentExactZeroCertificate" -> True|>,
          "InternalOnShellConditions" -> {},
          "ElapsedTime" -> AbsoluteTime[]-started|>]]]]];
  chartForChoice[choice_Association] := Module[
    {key = ToString[choice, InputForm], chart, massive, angle, square,
     angleBasis, squareBasis, mass, basis, vector, leg,
     epsilon = {{0, 1}, {-1, 0}}, basisChecks},
    chart = Lookup[charts, key, Missing["NotBuilt"]];
    If[!MissingQ[chart], Return[chart]];
    chart = completionHESymbolicExternalChart[rules,
      choice["NullAxisLegs"], choice["DependentShellLegs"]];
    If[!AssociationQ[chart], Return[chart]];
    If[Lookup[choice, "MassiveSpinorBasis", "Angle"] === "Square",
      (* Both bases cover the complete massive spin tensor. Fixing square
         instead of angle coordinates is an invertible little-group basis
         change, not a helicity sample or an internal on-shell identity. *)
      massive = Keys[chart["AngleBasis"]];
      angle = chart["Angle"]; square = chart["Square"];
      angleBasis = chart["AngleBasis"]; squareBasis = chart["SquareBasis"];
      Do[
        leg = massive[[index]]; mass = chart["Masses"][leg];
        basis = {{mass, 0}, {0, 1}};
        vector = {1, chart["SpinVariables"][[index]]};
        AssociateTo[squareBasis, leg -> basis];
        AssociateTo[angleBasis, leg -> (-chart["Momenta"][leg].epsilon.basis/mass)];
        AssociateTo[angle, leg -> angleBasis[leg].vector];
        AssociateTo[square, leg -> basis.vector], {index, Length[massive]}];
      basisChecks = AllTrue[massive, Function[particle,
        residueExactZero[Det[angleBasis[particle]] - chart["Masses"][particle]] &&
          residueExactZero[Det[squareBasis[particle]] - chart["Masses"][particle]] &&
          residueExactZero[angleBasis[particle].epsilon.Transpose[squareBasis[particle]] -
            chart["Momenta"][particle]] &&
          residueExactZero[squareBasis[particle] - epsilon.residueAdjugate[
            chart["Momenta"][particle]].angleBasis[particle]/chart["Masses"][particle]]]];
      If[!TrueQ[basisChecks], Return[$Failed]];
      chart = Join[chart, <|"Angle" -> angle, "Square" -> square,
        "AngleBasis" -> angleBasis, "SquareBasis" -> squareBasis,
        "MassiveSpinorBasis" -> "Square", "ExternalSpinorBasesValidated" -> True|>],
      chart = Join[chart, <|"MassiveSpinorBasis" -> "Angle"|>]];
    AssociateTo[charts, key -> chart]; chart
  ];
  symbolicProof[value_, allowance_, choice_Association] := TimeConstrained[
    MemoryConstrained[Module[{chart, mapped, key, componentProof = None, zero},
      chart = chartForChoice[choice];
      If[!AssociationQ[chart], Return[<|"Status" -> "NOT_PROVED", "Method" -> "UnsupportedExternalChart"|>]];
      (* This maps each distinct typed primitive once before inserting it
         into the rational sum. The cache and chart stay local to this proof. *)
      mapped = spuriousEvaluateCurve[value, chart, {}];
      If[residueUnmappedQ[mapped] || !residueFiniteQ[mapped] || ListQ[mapped] ||
          !FreeQ[mapped, _Missing | _Failure],
        Return[<|"Status" -> "NOT_PROVED", "Method" -> "UnsupportedExternalChart"|>]];
      If[LeafCount[mapped] > 50000 ||
          (Length[chart["SpinVariables"]] >= 4 && LeafCount[mapped] >= 5000),
        componentProof = completionHECoherentComponentCertificate[mapped, chart["SpinVariables"]];
        If[Lookup[componentProof, "Status", None] =!= "PROVED_ZERO",
          Return[<|"Status" -> "NOT_PROVED", "Method" ->
            If[Lookup[componentProof, "Method", None] === "NonzeroCoherentPolynomialComponent",
              "NonzeroSymbolicExternalChart", Lookup[componentProof, "Method", "UnsupportedExternalChart"]],
            "ChartChoice" -> choice, "ComponentProof" -> componentProof|>]];
        zero = True,
        zero = TrueQ[Cancel[Together[mapped]] === 0]];
      If[zero,
        Join[<|"Status" -> "PROVED_ZERO", "Method" -> "DenseSymbolicExternalChart",
          "Chart" -> chart, "ChartChoice" -> choice, "NumericalKinematicSamples" -> 0,
          "InternalOnShellConditions" -> {}, "CovariantTypedScalar" -> True,
          "ReducedLeafCount" -> LeafCount[value]|>,
          If[AssociationQ[componentProof], <|"ComponentProof" -> componentProof|>, <||>]],
        <|"Status" -> "NOT_PROVED", "Method" -> "NonzeroSymbolicExternalChart",
          "ChartChoice" -> choice|>]], 268435456,
      <|"Status" -> "NOT_PROVED", "Method" -> "SymbolicChartMemoryLimit"|>],
    Max[0.000001, allowance], <|"Status" -> "NOT_PROVED", "Method" -> "TimeConstraint"|>];
  symbolicPortfolio[value_, allowance_] := Module[
    {choices = Take[completionHEIdentityChartChoices[value, rules], UpTo[2]],
     began = AbsoluteTime[], left, proof = <|"Status" -> "NOT_PROVED", "Method" -> "TimeConstraint"|>, attempts = {},
     primitives, costs = {}, cost, chart, key},
    If[coherentWork >= 16,
      choices = Flatten[Table[Join[choice, <|"MassiveSpinorBasis" -> basis|>],
        {choice, choices}, {basis, {"Angle", "Square"}}], 1]];
    (* Choosing coordinates is representation work, not a kinematic sample.
       A small primitive map predicts tensor coefficient growth much more
       cheaply than expanding the complete coherent rational expression. *)
    If[coherentWork >= 16 && Length[choices] > 1 && remaining[] > 2,
      primitives = DeleteDuplicates[Cases[value,
        _SpinorChain | _SpinorTrace | _PropDen | _MomProd | _Mandelstahm |
          HoldPattern[Mom[_]^2], {0, Infinity}]];
      If[Length[primitives] <= 64,
        costs = Table[
          cost = TimeConstrained[
            chart = chartForChoice[choice];
            If[AssociationQ[chart],
              Total[LeafCount[spuriousEvaluateCurve[#, chart, {}]] & /@ primitives], Infinity],
            Min[1, remaining[]/12], Infinity];
          <|"Choice" -> choice, "MappedPrimitiveLeaves" -> cost|>, {choice, choices}];
        choices = Lookup[SortBy[costs, #["MappedPrimitiveLeaves"] &], "Choice"]]];
    Do[
      left = Min[remaining[], Max[0, allowance - (AbsoluteTime[] - began)]];
      If[left <= 0.000001, Break[]];
      proof = symbolicProof[value, completionHEPreferredChartAllowance[
        left, index === 1, Length[choices]], choices[[index]]];
      AppendTo[attempts, Join[choices[[index]], KeyTake[proof, {"Status", "Method"}]]];
      If[proof["Status"] === "PROVED_ZERO" || proof["Method"] === "NonzeroSymbolicExternalChart",
        Return[Join[proof, <|"ChartAttempts" -> attempts, "ChartPlanning" -> costs|>]]], {index, Length[choices]}];
    Join[proof, <|"ChartAttempts" -> attempts, "ChartPlanning" -> costs|>]
  ];
  work[] := Module[{proof},
    (* Try the original grouped form before display-oriented transformations.
       Repeated primitives are cheap to map even when the sum is long. *)
    candidate = preparationGroupedPropagatorForm[expression, Min[2, seconds/12]];
    primitiveCount = Length[DeleteDuplicates[Cases[candidate,
      _SpinorChain | _SpinorTrace | _PropDen | _MomProd | _Mandelstahm |
        HoldPattern[Mom[_]^2], {0, Infinity}]]];
    compactEligible = NumericQ[seconds] && TrueQ[10 <= seconds < Infinity] &&
      1000 <= LeafCount[candidate] <= 24000 && coherentWork >= 16;
    (* Cheap ordinary collections come before a dense tensor proof. They
       retain every propagator off shell and do not require a full public
       preparation report, identity search or any internal-shell condition. *)
    If[compactEligible && remaining[] > 2,
      earlyStarted = AbsoluteTime[];
      earlyBudget = Min[4, remaining[]/If[TrueQ[$completionHEKeepRawModelParameters], 4, 8]];
      compactRetry = <|"Status" -> "UNCHANGED", "Input" -> candidate,
        "Amplitude" -> candidate, "Route" -> {}, "CoherentComponentEstimate" -> coherentWork,
        "NumericalKinematicSamples" -> 0, "InternalOnShellConditions" -> {}|>;
      Do[
        earlyBefore = candidate;
        compactValue = preparationCompactExternalSums[candidate, earlyBudget/2, rules];
        If[residueFiniteQ[compactValue] &&
            preparationBetterQ[preparationRank[compactValue], preparationRank[candidate]],
          candidate = compactValue; earlyCompacted = True;
          compactRetry = Join[compactRetry, <|"Status" -> "IMPROVED", "Amplitude" -> candidate,
            "Route" -> Append[compactRetry["Route"], <|
              "Operation" -> "EarlyExternalTensorCollection", "Before" -> earlyBefore,
              "After" -> candidate, "ExternalMassRules" -> preparationExternalRules[rules],
              "InternalOnShellConditions" -> {}|>]|>]], {2}];
      compactRetry = Join[compactRetry, <|"EarlyElapsedTime" -> AbsoluteTime[] - earlyStarted|>]];
    If[LeafCount[candidate] <= 150000 && primitiveCount <= 256 && remaining[] > 1,
      proof = symbolicPortfolio[candidate, If[TrueQ[earlyCompacted], Min[20, 2 remaining[]/3], If[compactEligible,
        Min[5, seconds/10], Min[60, 2 remaining[]/3]]]];
      If[proof["Status"] === "PROVED_ZERO" || proof["Method"] === "NonzeroSymbolicExternalChart",
        Return[Join[proof, <|"ProofInput" -> If[TrueQ[earlyCompacted], "OrdinaryCompacted", "OriginalGrouped"],
          "DistinctPrimitives" -> primitiveCount|>]]]];
    If[compactEligible && remaining[] > 2,
      compactStarted = AbsoluteTime[]; compactBudget = Min[10, remaining[]/3];
      If[MissingQ[compactRetry], compactRetry = <|"Status" -> "UNCHANGED", "Input" -> candidate,
        "Amplitude" -> candidate, "Route" -> {}, "CoherentComponentEstimate" -> coherentWork,
        "NumericalKinematicSamples" -> 0, "InternalOnShellConditions" -> {}|>];
      compactValue = preparationNumeratorSpectatorSums[candidate, Min[2, compactBudget/4], rules];
      If[residueFiniteQ[compactValue] &&
          preparationBetterQ[preparationRank[compactValue], preparationRank[candidate]],
        compactRetry = Join[compactRetry, <|"Status" -> "IMPROVED", "Amplitude" -> compactValue,
          "Route" -> Append[compactRetry["Route"], <|"Operation" -> "NumeratorSpectatorCollection",
            "Before" -> candidate, "After" -> compactValue,
            "ForwardReduction" -> "CollectNumeratorCoefficientsThenOrdinarySpinorProductsAndFactor",
            "ExternalMassRules" -> preparationExternalRules[rules],
            "InverseFactorsProtected" -> True, "InternalOnShellConditions" -> {}|>]|>]];
      compactLeft = Max[0, Min[remaining[], compactBudget - (AbsoluteTime[] - compactStarted)]];
      If[compactLeft > 0.01,
        compactRecord = preparationOrdinaryPoleCompaction[compactRetry["Amplitude"], rules, True, compactLeft];
        If[AssociationQ[compactRecord] && Lookup[compactRecord, "Status", None] === "IMPROVED" &&
            residueFiniteQ[Lookup[compactRecord, "Amplitude", $Failed]] &&
            preparationBetterQ[preparationRank[compactRecord["Amplitude"]],
              preparationRank[compactRetry["Amplitude"]]],
          compactRetry = Join[compactRetry, <|"Status" -> "IMPROVED",
            "Amplitude" -> compactRecord["Amplitude"],
            "Route" -> Join[compactRetry["Route"], Lookup[compactRecord, "Route", {}]],
            "PoleCompaction" -> compactRecord|>]]];
      candidate = compactRetry["Amplitude"];
      compactRetry = Join[compactRetry, <|"ElapsedTime" -> AbsoluteTime[] - compactStarted|>];
      If[residueExactZero[candidate], Return[<|"Status" -> "PROVED_ZERO",
        "Method" -> "OrdinaryExternalIdentities", "ProofInput" -> "OrdinaryCompacted"|>]];
      If[compactRetry["Status"] === "IMPROVED" && remaining[] > 1,
        proof = symbolicPortfolio[candidate, Min[20, remaining[]/2]];
        If[proof["Status"] === "PROVED_ZERO" || proof["Method"] === "NonzeroSymbolicExternalChart",
          Return[Join[proof, <|"ProofInput" -> "OrdinaryCompacted"|>]]]]];
    If[1000 <= LeafCount[candidate] <= 24000 && remaining[] > 2,
      grouped = preparationDenominatorSchouten[candidate, rules, Min[15, remaining[]/3]];
      candidate = Lookup[grouped, "Amplitude", candidate]];
    If[residueExactZero[candidate], Return[<|"Status" -> "PROVED_ZERO",
      "Method" -> "OrdinaryExternalIdentities", "ProofInput" -> "OriginalGrouped"|>]];
    If[LeafCount[candidate] <= 6000 && remaining[] > 2,
      proof = symbolicPortfolio[candidate, Min[20, remaining[]/2]];
      If[proof["Status"] === "PROVED_ZERO" || proof["Method"] === "NonzeroSymbolicExternalChart",
        Return[Join[proof, <|"ProofInput" -> "OriginalGrouped"|>]]]];
    ordinaryBudget = Min[Max[6, Ceiling[LeafCount[candidate]/4000]], remaining[]/3];
    prepared = PrepareAmplitudes[{rules, candidate}, model,
      "PolePreference" -> None, "InternalOnShell" -> False, "MaxSteps" -> 0,
      "TimeConstraint" -> ordinaryBudget, "Parallelization" -> False,
      "ProgressReporting" -> False, "ReturnDetails" -> True];
    If[AssociationQ[prepared] && residueFiniteQ[Lookup[prepared, "Amplitude", $Failed]] &&
        completionHECovariantScalarQ[prepared["Amplitude"],
          Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]]],
      candidate = prepared["Amplitude"]];
    If[3000 <= LeafCount[candidate] <= 24000 && remaining[] > 2,
      grouped = preparationDenominatorSchouten[candidate, rules, Min[15, remaining[]/3]];
      candidate = Lookup[grouped, "Amplitude", candidate]];
    If[residueExactZero[candidate], Return[<|"Status" -> "PROVED_ZERO",
      "Method" -> "OrdinaryExternalIdentities", "ProofInput" -> "ExternalPrepared"|>]];
    If[LeafCount[candidate] > 24000, Return[<|"Status" -> "NOT_PROVED",
      "Method" -> "DenseChartSizeGuard", "ReducedLeafCount" -> LeafCount[candidate]|>]];
    Join[symbolicPortfolio[candidate, remaining[]], <|"ProofInput" -> "ExternalPrepared"|>]
  ];
  result = TimeConstrained[work[], seconds,
    <|"Status" -> "NOT_PROVED", "Method" -> "TimeConstraint"|>];
  Join[result, <|"OriginalDirection" -> expression, "OrdinaryCompactionRetry" -> compactRetry,
    "ElapsedTime" -> (AbsoluteTime[] - started)|>]
];

(* A proof may be much easier after subtracting identities already certified in
   the same affine family. This is exact rational-coordinate row reduction,
   not a new kinematic condition or a numerical relation search. *)
completionHECertifiedZeroRemainder[target_, known_List, seconds_: 20] := Module[
  {started = AbsoluteTime[], fallback, work, result},
  fallback = <|"Status" -> "UNCHANGED", "Method" -> "CertifiedZeroSpanNotReduced",
    "ReducedInput" -> target, "OriginalLeafCount" -> LeafCount[target],
    "ReducedLeafCount" -> LeafCount[target], "ExactFormalReconstruction" -> False,
    "ExactGroupingReconstruction" -> False|>;
  If[!TrueQ[seconds > 0] || known === {} || Length[known] > 128 ||
      LeafCount[{target, known}] > 1000000, Return[fallback]];
  work[] := Module[{profiles, split, scalar, columns, keys, count, size, matrix,
      targetVector, costs, order, reducedRows, pivots, vector, coefficients,
      coefficient, inverseOrder, remainder, grouped, groupedMap, exact, grouping,
      used},
    profiles = rspExpansionProfile[#, 32768, 2500000] & /@ Join[known, {target}];
    If[Total[profiles[[All, 1]]] > 32768 ||
        Total[profiles[[All, 2]]] > 2500000, Return[fallback]];
    scalar[term_] := Times @@ Select[
      If[Head[term] === Times, List @@ term, {term}], MatchQ[#, _Integer | _Rational] &];
    split[expression_] := Module[{expanded, terms},
      expanded = withProtectedPropagators[expression, Expand];
      terms = If[Head[expanded] === Plus, List @@ expanded,
        If[expanded === 0, {}, {expanded}]];
      Merge[(With[{factor = scalar[#]}, Association[(#/factor) -> factor]] & /@ terms), Total]];
    columns = split /@ Join[known, {target}];
    keys = DeleteDuplicates[Flatten[Keys /@ columns]];
    count = Length[known]; size = Length[keys];
    If[size === 0 || size > 8192, Return[fallback]];
    matrix = Lookup[#, keys, 0] & /@ Take[columns, count];
    targetVector = Lookup[Last[columns], keys, 0];
    If[!AllTrue[Flatten[{matrix, targetVector}], MatchQ[#, _Integer | _Rational] &],
      Return[fallback]];
    (* Prefer eliminating monomials actually present in this target, with the
       shorter momentum words first. Every column remains in the calculation. *)
    costs = ({Count[Numerator[#], _Mom, Infinity], LeafCount[#]} & /@ keys);
    order = SortBy[Range[size], {If[targetVector[[#]] === 0, 1, 0],
      costs[[#, 1]], costs[[#, 2]]} &];
    reducedRows = RowReduce[Join[matrix[[All, order]], IdentityMatrix[count], 2]];
    pivots = Table[SelectFirst[Range[size], reducedRows[[index, #]] =!= 0 &, None],
      {index, count}];
    vector = targetVector[[order]]; coefficients = ConstantArray[0, count];
    Do[If[pivots[[index]] === None, Continue[]];
      coefficient = vector[[pivots[[index]]]];
      If[coefficient === 0, Continue[]];
      vector = vector - coefficient reducedRows[[index, 1 ;; size]];
      coefficients = coefficients + coefficient reducedRows[[index, size + 1 ;;]],
      {index, count}];
    inverseOrder = Ordering[order];
    exact = AllTrue[targetVector - coefficients.matrix - vector[[inverseOrder]], # === 0 &];
    If[!TrueQ[exact] || !AllTrue[coefficients, MatchQ[#, _Integer | _Rational] &], Return[fallback]];
    remainder = Total[vector keys[[order]]];
    grouped = preparationGroupedPropagatorForm[remainder, Min[1,
      Max[0.000001, seconds - (AbsoluteTime[] - started)]]];
    groupedMap = split[grouped];
    grouping = Complement[Keys[groupedMap], keys] === {} &&
      AllTrue[Lookup[groupedMap, keys, 0] - vector[[inverseOrder]], # === 0 &];
    If[!TrueQ[grouping] || LeafCount[grouped] >= LeafCount[target], Return[fallback]];
    used = Select[Range[count], coefficients[[#]] =!= 0 &];
    <|"Status" -> "REDUCED", "Method" -> "ExactRationalCertifiedZeroSpan",
      "ReducedInput" -> grouped, "OriginalLeafCount" -> LeafCount[target],
      "ReducedLeafCount" -> LeafCount[grouped], "KnownZeroCoefficients" -> coefficients,
      "UsedKnownZeroPositions" -> used, "KnownZeroCount" -> count,
      "FormalMonomialCount" -> size, "RetainedMonomialCount" -> Count[vector, Except[0]],
      "ExactFormalReconstruction" -> True, "ExactGroupingReconstruction" -> True,
      "NumericalKinematicSamples" -> 0, "InternalOnShellConditions" -> {}|>
  ];
  result = TimeConstrained[MemoryConstrained[work[], 268435456, fallback], seconds, fallback];
  If[!AssociationQ[result], result = fallback];
  Join[result, <|"ElapsedTime" -> (AbsoluteTime[] - started)|>]
];

(* Exact serial fallback: a dense complex Lorentz chart in either chirality.
   The chosen null spinor lines are placed on e1/e2 using the corresponding
   SL(2) factor and little groups. The independent other SL(2) factor sends
   one massive momentum to m I. Conservation fixes the remaining null rows
   (Angle axes) or columns (Square axes). All other shell matrices remain
   unrestricted on their nonzero a patches. One residual gauge is harmless;
   no internal line is constrained. *)
completionHERestNullSymbolicChart[rules_List, nullPivots_: Automatic, nullChirality_: "Angle"] := Module[
  {external, masses, null, massive, pivot, momenta = <||>, angle = <||>, square = <||>,
   angleBasis = <||>, squareBasis = <||>, variables = {}, spins = {}, patches = {},
   new, shell, a, b, c, p, total, basis, sBasis, spin, rows, rowPatches,
   j = {{0, 1}, {-1, 0}}, zero, shells, conservation, bases, nullProducts, chart},
  If[!MemberQ[{"Angle", "Square"}, nullChirality], Return[$Failed]];
  external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]];
  If[Length[external] < 4 || !DuplicateFreeQ[external], Return[$Failed]];
  masses = AssociationThread[external, (Mass /@ external) /. rules];
  If[!FreeQ[Values[masses], _Mass | _Real | _Missing | _Failure] ||
      !residueFiniteQ[Values[masses]], Return[$Failed]];
  null = Select[external, masses[#] === 0 &]; massive = Complement[external, null];
  If[Length[null] < 2 || massive === {}, Return[$Failed]];
  If[nullPivots =!= Automatic,
    If[!MatchQ[nullPivots, {_Integer, _Integer}] || !DuplicateFreeQ[nullPivots] ||
        !ContainsAll[null, nullPivots], Return[$Failed]];
    null = Join[nullPivots, Complement[null, nullPivots]]];
  pivot = First[massive];
  new[] := With[{value = Unique["restNullIdentityCoordinate"]}, AppendTo[variables, value]; value];
  shell[mass_] := (a = new[]; b = new[]; c = new[]; AppendTo[patches, a];
    {{a, b}, {c, (mass^2 + b c)/a}});
  AssociateTo[momenta, pivot -> masses[pivot] IdentityMatrix[2]];
  Do[AssociateTo[momenta, leg -> shell[masses[leg]]],
    {leg, Complement[external, {pivot, null[[1]], null[[2]]}]}];
  total = -Total[Values[momenta]];
  rows = If[nullChirality === "Angle", {total[[1]], total[[2]]}, Transpose[total]];
  zero[value_] := TrueQ[Cancel[Together[value]] === 0];
  rowPatches = Map[SelectFirst[#, !zero[#] &, Missing["ZeroNullRow"]] &, rows];
  If[AnyTrue[rowPatches, MissingQ], Return[$Failed]];
  If[nullChirality === "Angle",
    AssociateTo[momenta, {null[[1]] -> {{total[[1, 1]], total[[1, 2]]}, {0, 0}},
      null[[2]] -> {{0, 0}, {total[[2, 1]], total[[2, 2]]}}}];
    AssociateTo[angle, {null[[1]] -> {1, 0}, null[[2]] -> {0, 1}}];
    AssociateTo[square, {null[[1]] -> rows[[1]], null[[2]] -> rows[[2]]}],
    AssociateTo[momenta, {null[[1]] -> {{total[[1, 1]], 0}, {total[[2, 1]], 0}},
      null[[2]] -> {{0, total[[1, 2]]}, {0, total[[2, 2]]}}}];
    AssociateTo[square, {null[[1]] -> {1, 0}, null[[2]] -> {0, 1}}];
    AssociateTo[angle, {null[[1]] -> rows[[1]], null[[2]] -> rows[[2]]}]];
  Do[p = momenta[leg];
    If[masses[leg] === 0,
      If[!MemberQ[Take[null, 2], leg],
        AssociateTo[angle, leg -> p[[All, 1]]];
        AssociateTo[square, leg -> {1, p[[1, 2]]/p[[1, 1]]}]],
      basis = {{masses[leg], 0}, {0, 1}};
      sBasis = j.residueAdjugate[p].basis/masses[leg];
      spin = Unique["restNullIdentitySpin"]; AppendTo[spins, spin];
      AssociateTo[angleBasis, leg -> basis]; AssociateTo[squareBasis, leg -> sBasis];
      AssociateTo[angle, leg -> basis.{1, spin}]; AssociateTo[square, leg -> sBasis.{1, spin}]],
    {leg, external}];
  shells = AssociationThread[external, zero[Det[momenta[#]] - masses[#]^2] & /@ external];
  conservation = AllTrue[Flatten[Total[Values[momenta]]], zero];
  nullProducts = AssociationThread[null,
    AllTrue[Flatten[Outer[Times, angle[#], square[#]] - momenta[#]], zero] & /@ null];
  bases = AssociationThread[massive, Function[leg,
      zero[Det[angleBasis[leg]] - masses[leg]] && zero[Det[squareBasis[leg]] - masses[leg]] &&
      AllTrue[Flatten[squareBasis[leg] - j.residueAdjugate[momenta[leg]].angleBasis[leg]/masses[leg]], zero] &&
      AllTrue[Flatten[angle[leg] - angleBasis[leg].{1, spins[[First[FirstPosition[massive, leg]]]]}], zero]
    ] /@ massive];
  If[!And @@ Join[Values[shells], Values[nullProducts], Values[bases], {conservation}], Return[$Failed]];
  chart = <|"Momenta" -> momenta, "Masses" -> masses, "Angle" -> angle, "Square" -> square,
    "AngleBasis" -> angleBasis, "SquareBasis" -> squareBasis, "SpinVariables" -> spins,
    "NullAxisLegs" -> Take[null, 2], "NullAxisChirality" -> nullChirality, "RestFrameLeg" -> pivot, "DependentShellLegs" -> Take[null, 2],
    "PoleVariable" -> Unique["unusedRestNullIdentityPole"], "ReferenceSeed" -> 0,
    "CoherentVectorSpinIndices" -> True, "ExternalIdentityCoordinates" -> variables,
    "ExternalMassShellsValidated" -> True, "ExternalMassShellChecks" -> shells,
    "MomentumConservationValidated" -> True, "ExternalSpinorBasesValidated" -> bases,
    "NullSpinorProductsValidated" -> nullProducts, "InternalOnShellConditions" -> {},
    "DenseDomainNonzeroExpressions" -> Join[Lookup[masses, massive], patches, rowPatches],
    "CoverageMethod" -> "IndependentUndottedDottedSL2AndNullLittleGroups",
    "OriginalNullSpinorBracketRequiredNonzero" -> <|"Chirality" -> nullChirality, "Legs" -> Take[null, 2]|>,
    "ResidualGaugeDimension" -> 1, "NumericalKinematicSamples" -> 0|>;
  Join[chart, If[nullChirality === "Angle",
    <|"OriginalNullAngleBracketRequiredNonzero" -> Take[null, 2]|>,
    <|"OriginalNullSquareBracketRequiredNonzero" -> Take[null, 2]|>]]
];

(* Use the typed expression, not a particle or process name, to avoid fixing
   the expensive chirality of the two null external spinors. *)
completionHENativeNullAxisChoice[expression_, rules_List] := Module[
  {null, count, counts},
  null = Cases[preparationExternalRules[rules], HoldPattern[Mass[leg_Integer] -> 0] :> leg];
  count[spinor_Spinor] := If[MemberQ[{"Spin", "Helicity"}, First[spinor]] &&
      MemberQ[null, rspSpinorLeg[spinor]],
    {Boole[rspSpinorType[spinor] === "Angle"], Boole[rspSpinorType[spinor] === "Square"]}, {0, 0}];
  count[Power[base_, exponent_Integer]] := Abs[exponent] count[base];
  count[value_] := If[AtomQ[value], {0, 0}, Total[Prepend[count /@ List @@ value, {0, 0}]]];
  counts = count[expression];
  <|"Chirality" -> If[counts[[2]] > counts[[1]], "Square", "Angle"],
    "Counts" -> <|"Angle" -> counts[[1]], "Square" -> counts[[2]]|>,
    "Method" -> "TypedDeclaredMasslessSpinorOccurrences"|>
];

(* Setting a common mass and removable common scalar factors to one is valid
   only after these exact syntactic homogeneity proofs. Every typed momentum
   scales by lambda and each external spinor by sqrt(lambda); other scalar
   parameters are held fixed. No model parameter is guessed from its name. *)
completionHECommonMassNormalization[expression_, rules_List] := Module[
  {external, masses, nonzero, mass, resolved, couplings, bare, degree, scalarWeight, bareScalars,
   dimensions, couplingPowers, normalized, unitRules, failure, validMomentum, scalarSymbols,
   tag = Unique["typedMassHomogeneity"]},
  failure[reason_] := <|"Status" -> "UNSUPPORTED", "Reason" -> reason|>;
  external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]];
  If[Length[external] < 4 || !DuplicateFreeQ[external], Return[failure["ExternalMassMetadata"]]];
  masses = (Mass /@ external) /. rules;
  If[!FreeQ[masses, _Mass | _Real] || !residueFiniteQ[masses], Return[failure["InexactOrUnresolvedMass"]]];
  nonzero = DeleteDuplicates[DeleteCases[masses, 0]];
  If[Length[nonzero] =!= 1 || !MatchQ[First[nonzero], _Symbol | _ModelParameter],
    Return[failure["NoSingleFormalCommonMass"]]];
  mass = First[nonzero]; resolved = expression /. preparationExternalRules[rules];
  If[!FreeQ[resolved, _Mass | _Real] || !residueFiniteQ[resolved] ||
      !completionHECovariantScalarQ[resolved, external], Return[failure["UnsupportedTypedExpression"]]];
  validMomentum[value_] := Module[{labels = If[Head[value] === Mom, residueMomentumLegs[First[value]], $Failed]},
    ListQ[labels] && labels =!= {} && ContainsAll[external, labels]];
  dimensions = Catch[
    degree[value_] := Which[
      SameQ[value, mass], 1,
      NumberQ[value], If[FreeQ[value, _Real], 0, Throw[$Failed, tag]],
      MatchQ[value, _ModelParameter | _Symbol], 0,
      Head[value] === SpinorChain,
        If[completionHECovariantScalarQ[value, external], Length[value] - 1, Throw[$Failed, tag]],
      Head[value] === SpinorTrace,
        If[completionHECovariantScalarQ[value, external], Length[value], Throw[$Failed, tag]],
      Head[value] === Mom, If[validMomentum[value], 1, Throw[$Failed, tag]],
      MemberQ[{MomProd, Mandelstahm}, Head[value]],
        If[completionHECovariantScalarQ[value, external], 2, Throw[$Failed, tag]],
      Head[value] === PropDen,
        If[Length[value] === 2 && validMomentum[First[value]] &&
          MemberQ[{0, mass, -mass}, Last[value]], 2, Throw[$Failed, tag]],
      Head[value] === Plus, With[{parts = DeleteDuplicates[degree /@ List @@ value]},
        If[Length[parts] === 1, First[parts], Throw[$Failed, tag]]],
      Head[value] === Times, Total[degree /@ List @@ value],
      Head[value] === Power && IntegerQ[Last[value]], Last[value] degree[First[value]],
      True, Throw[$Failed, tag]];
    degree[resolved], tag];
  If[!IntegerQ[dimensions], Return[failure["NonhomogeneousMassDimension"]]];
  couplings = DeleteDuplicates[DeleteCases[Cases[resolved, _ModelParameter, {0, Infinity}], mass]];
  bareScalars[value_] := Which[
    MatchQ[value, _SpinorChain | _SpinorTrace | _MomProd | _Mandelstahm | _PropDen | _Mom | _ModelParameter], {},
    Head[value] === Symbol, {value},
    MemberQ[{Plus, Times}, Head[value]], Flatten[bareScalars /@ List @@ value],
    Head[value] === Power, bareScalars[First[value]], True, {}];
  bare = DeleteDuplicates[bareScalars[resolved]];
  couplings = DeleteDuplicates[Join[couplings, DeleteCases[bare, mass]]];
  scalarWeight[value_, parameter_] /; SameQ[value, parameter] := 1;
  scalarWeight[value_, parameter_] /; FreeQ[value, parameter] := 0;
  scalarWeight[value_Plus, parameter_] := With[{parts = DeleteDuplicates[scalarWeight[#, parameter] & /@ List @@ value]},
    If[Length[parts] === 1 && IntegerQ[First[parts]], First[parts], $Failed]];
  scalarWeight[value_Times, parameter_] := With[{parts = scalarWeight[#, parameter] & /@ List @@ value},
    If[AllTrue[parts, IntegerQ], Total[parts], $Failed]];
  scalarWeight[Power[value_, exponent_Integer], parameter_] := With[{part = scalarWeight[value, parameter]},
    If[IntegerQ[part], exponent part, $Failed]];
  scalarWeight[_, _] := $Failed;
  couplingPowers = scalarWeight[resolved, #] & /@ couplings;
  If[!AllTrue[couplingPowers, IntegerQ], Return[failure["NonliteralScalarFactor"]]];
  unitRules = Join[Thread[couplings -> 1], {mass -> 1}]; normalized = resolved /. unitRules;
  If[!FreeQ[normalized, _ModelParameter | _Mass | _Real], Return[failure["UnresolvedNormalizedCoefficient"]]];
  <|"Status" -> "COMPLETE", "Amplitude" -> normalized,
    "ExternalMassRules" -> (preparationExternalRules[rules] /. unitRules),
    "CommonMass" -> mass, "CommonMassRequiredNonzero" -> True,
    "HomogeneousMassDimension" -> dimensions,
    "TypedHomogeneityMethod" -> "ExactRecursiveTypedMomentumAndSpinorScaling",
    "ScalarFactorRules" -> Thread[couplings -> couplingPowers],
    "ScalarFactor" -> Times @@ MapThread[Power, {couplings, couplingPowers}],
    "ScalarFactorMethod" -> "ExactRecursiveCommonLiteralPower",
    "UnitRules" -> unitRules, "RestorationMethod" -> "DenseNonzeroMassDilationAndScalarHomogeneity",
    "ExternalSpinWeights" -> completionExternalSpinWeights[resolved, rules],
    "NumericalKinematicSamples" -> 0, "InternalOnShellConditions" -> {}|>
];

(* Export only exact rational Laurent syntax. Each node is rebuilt from its
   already restored children and must be SameQ to its original Wolfram subtree.
   Complete root order is retained, including an explicit zero constant term. *)
completionHELaurentDAG[expressions_List, variables_List, seconds_: 5] := Module[
  {started = AbsoluteTime[], tag = Unique["laurentDAG"], failure, work, result},
  failure[reason_] := <|"Status" -> "UNSUPPORTED", "Reason" -> reason|>;
  If[variables === {} || Length[variables] > 16 || !DuplicateFreeQ[variables] ||
      !AllTrue[variables, MatchQ[#, _Symbol] &] || expressions === {} ||
      !FreeQ[expressions, _Real] || !residueFiniteQ[expressions], Return[failure["UnsupportedLaurentInput"]]];
  work[] := Module[{count = 0, edges = 0, lines, restored = <||>, node, roots},
    lines = {"HEPCAT_LAURENT_DAG 1", "Variables " <> ToString[Length[variables]]};
    node[value_] := node[value] = Module[{id, children, record, rebuilt, position},
      Which[
        IntegerQ[value] || Head[value] === Rational,
          If[Max[IntegerLength[Abs[Numerator[value]], 2], IntegerLength[Denominator[value], 2]] > 4096,
            Throw[failure["LaurentCoefficientBitLimit"], tag]];
          id = ++count; record = "Constant " <> ToString[id] <> " " <>
            ToString[Numerator[value], InputForm] <> " " <> ToString[Denominator[value], InputForm]; rebuilt = value,
        MemberQ[variables, value], position = First[FirstPosition[variables, value]];
          id = ++count; record = "Variable " <> ToString[id] <> " " <> ToString[position]; rebuilt = variables[[position]],
        Head[value] === Plus || Head[value] === Times,
          children = node /@ List @@ value; edges += Length[children]; id = ++count;
          record = If[Head[value] === Plus, "Add ", "Multiply "] <> ToString[id] <> " " <>
            ToString[Length[children]] <> " " <> StringRiffle[ToString /@ children, " "];
          rebuilt = Apply[Head[value], Lookup[restored, children]],
        Head[value] === Power && IntegerQ[Last[value]] && Abs[Last[value]] <= 1000000,
          children = node[First[value]]; edges++; id = ++count;
          record = "Power " <> ToString[id] <> " " <> ToString[children] <> " " <> ToString[Last[value]];
          rebuilt = restored[children]^Last[value],
        True, Throw[failure["UnsupportedLaurentNode"], tag]];
      If[count > 250000 || edges > 2000000, Throw[failure["LaurentNodeLimit"], tag]];
      If[!SameQ[rebuilt, value], Throw[failure["LaurentRoundTripFailed"], tag]];
      AssociateTo[restored, id -> rebuilt]; AppendTo[lines, record]; id];
    roots = node /@ expressions;
    lines = Join[lines, ("Root " <> ToString[#]) & /@ roots, {"End"}];
    <|"Status" -> "COMPLETE", "Text" -> StringRiffle[lines, "\n"] <> "\n",
      "NodeCount" -> count, "EdgeCount" -> edges, "RootNodes" -> roots,
      "RootCount" -> Length[roots], "Variables" -> variables,
      "ExactStructuralRoundTrip" -> True, "EveryNodeRoundTrip" -> True,
      "RootOrderPreserved" -> True, "NumericalKinematicSamples" -> 0|>
  ];
  result = TimeConstrained[MemoryConstrained[Catch[work[], tag], 268435456,
      failure["LaurentExportMemoryLimit"]], seconds, failure["LaurentExportTimeLimit"]];
  Join[result, <|"ElapsedTime" -> AbsoluteTime[] - started|>]
];

completionHEClearTypedDenominators[expression_] := Module[
  {atoms, tokens, opaque, together, numerator, denominator, restore, factorQ,
   denominators, exact},
  atoms = DeleteDuplicates[Cases[expression,
    _SpinorChain | _SpinorTrace | _MomProd | _Mandelstahm | _PropDen | _Mom, {0, Infinity}]];
  tokens = Table[Unique["nativeIdentityPrimitive"], {Length[atoms]}];
  opaque = expression /. Dispatch[Thread[atoms -> tokens]];
  restore = Dispatch[Thread[tokens -> atoms]];
  If[!SameQ[opaque /. restore, expression], Return[<|"Status" -> "UNSUPPORTED", "Reason" -> "PrimitiveRoundTrip"|>]];
  together = Together[opaque]; numerator = Numerator[together]; denominator = Denominator[together];
  exact = TrueQ[Cancel[Together[opaque - numerator/denominator]] === 0];
  If[!exact, Return[<|"Status" -> "UNSUPPORTED", "Reason" -> "DenominatorReconstruction"|>]];
  numerator = numerator /. restore; denominator = denominator /. restore;
  factorQ[value_] := Which[
    IntegerQ[value] || Head[value] === Rational, value =!= 0,
    Head[value] === PropDen, Length[value] === 2 && MatchQ[First[value], _Mom] && MemberQ[{0, 1, -1}, Last[value]],
    Head[value] === Times, AllTrue[List @@ value, factorQ],
    Head[value] === Power && IntegerQ[Last[value]] && Last[value] > 0, factorQ[First[value]],
    True, False];
  If[!factorQ[denominator], Return[<|"Status" -> "UNSUPPORTED", "Reason" -> "UntypedInverseFactor"|>]];
  denominators = DeleteDuplicates[Cases[denominator, _PropDen, {0, Infinity}]];
  <|"Status" -> "COMPLETE", "Numerator" -> numerator, "Denominator" -> denominator,
    "DenominatorFactors" -> denominators, "ExactRationalReconstruction" -> True,
    "PrimitiveRestorationExact" -> True, "Method" -> "OpaqueTypedPrimitiveTogether",
    "DenominatorNonzeroProofRequired" -> True, "InternalOnShellConditions" -> {}|>
];

completionHEPrepareNativeIdentity[expression_, rules_List, seconds_: 30] := Module[
  {started = AbsoluteTime[], failure, left, work, result, rationalPrepared = Missing["NotAttempted"],
   restPrepared = Missing["NotAttempted"], tag = Unique["nativeIdentityPreparation"]},
  failure[reason_] := <|"Status" -> "NOT_PROVED", "Method" -> reason|>;
  If[!(NumericQ[seconds] && TrueQ[0 < seconds < Infinity]), Return[failure["NativePreparationBudget"]]];
  If[Count[preparationExternalRules[rules], HoldPattern[Mass[_Integer] -> 0]] === 1,
    Return[completionHEPrepareSingleNullNativeIdentity[expression, rules, seconds]]];
  left[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  If[Lookup[completionHEMixedNullAxisChoice[expression, rules], "Status", None] === "AVAILABLE",
    rationalPrepared = completionHEPrepareMixedNullNativeIdentity[expression, rules, left[]];
    If[Lookup[rationalPrepared, "Status", None] === "PREPARED" ||
        AbsoluteTime[] - started >= seconds, Return[rationalPrepared]];
    (* A mixed-axis polynomial can be larger than its same-chirality form.
       Try the existing dense null axes with the same rational certificates
       before the older normalized Laurent exporter, within this clock. *)
    restPrepared = completionHEPrepareRestNullNativeIdentity[expression, rules, left[]];
    If[Lookup[restPrepared, "Status", None] === "PREPARED" ||
        AbsoluteTime[] - started >= seconds,
      Return[Join[restPrepared, <|"MixedRationalAttempt" ->
        KeyTake[rationalPrepared, {"Status", "Method", "PreparationSeconds"}]|>]]]];
  work[] := Module[{external, weights, normalized, chart, cleared, mapped, coefficients,
      denominators, roots, dag, pivots, axisChoice, unsupported},
    external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]];
    unsupported = !FreeQ[expression, _Real | _SpinorHat | _MomHat | _xFactor | _xTildeFactor |
      Spinor["Xi" | "Zeta", ___]] || AnyTrue[Cases[expression, s_Spinor /;
        First[List @@ s] === "Spin", Infinity], Function[spinor,
          With[{data = List @@ spinor}, With[{position = First[FirstPosition[data, "Angle" | "Square"]]},
            !MatchQ[Drop[data, position + 1], {} | {VectorSpinIndex[_, 1 | 2]}]]]]];
    unsupported = unsupported || !completionHEMasslessHelicityTagsQ[expression, rules];
    weights = completionExternalSpinWeights[expression, rules];
    If[unsupported || !ListQ[weights] || Length[weights] =!= Length[external] ||
        !AllTrue[weights, IntegerQ] || !completionHECovariantScalarQ[expression, external],
      Throw[failure["UnsupportedCovarianceOrSpinHomogeneity"], tag]];
    normalized = completionHECommonMassNormalization[expression, rules];
    If[Lookup[normalized, "Status", None] =!= "COMPLETE",
      Throw[Join[failure["UnsupportedMassNormalization"], <|"Normalization" -> normalized|>], tag]];
    pivots = completionHEPreferredNullPivots[expression, rules];
    axisChoice = completionHENativeNullAxisChoice[expression, rules];
    chart = completionHERestNullSymbolicChart[normalized["ExternalMassRules"], pivots, axisChoice["Chirality"]];
    If[!AssociationQ[chart], Throw[failure["UnsupportedRestNullChart"], tag]];
    cleared = completionHEClearTypedDenominators[normalized["Amplitude"]];
    If[Lookup[cleared, "Status", None] =!= "COMPLETE",
      Throw[Join[failure["UnsupportedDenominatorClearing"], <|"DenominatorClearing" -> cleared|>], tag]];
    mapped = spuriousEvaluateCurve[cleared["Numerator"], chart, {}];
    denominators = spuriousEvaluateCurve[#, chart, {}] & /@ cleared["DenominatorFactors"];
    If[residueUnmappedQ[{mapped, denominators}] || !residueFiniteQ[{mapped, denominators}] ||
        !FreeQ[{mapped, denominators}, _Real | _Missing | _Failure],
      Throw[failure["UnsupportedRestNullMapping"], tag]];
    coefficients = amplitudeCoherentPolynomialRules[mapped, chart["SpinVariables"], Min[10, left[]]];
    If[Lookup[coefficients, "Status", None] =!= "COMPLETE" ||
        !TrueQ[coefficients["FullCoefficientCoverage"]] || !TrueQ[coefficients["ReconstructionVerified"]],
      Throw[Join[failure["IncompleteCoherentPolynomial"], <|"PolynomialExtraction" -> KeyDrop[coefficients, "CoefficientRules"]|>], tag]];
    roots = Join[Last /@ coefficients["CoefficientRules"], denominators];
    dag = completionHELaurentDAG[roots, chart["ExternalIdentityCoordinates"], Min[10, left[]]];
    If[Lookup[dag, "Status", None] =!= "COMPLETE" || !TrueQ[dag["EveryNodeRoundTrip"]],
      Throw[Join[failure["UnsupportedLaurentExport"], <|"LaurentExport" -> dag|>], tag]];
    <|"Status" -> "PREPARED", "Method" -> "DenseRestNullTypedLaurentIdentity",
      "DAG" -> dag, "CoefficientRootCount" -> coefficients["ComponentCount"],
      "DenominatorRootIndices" -> Range[coefficients["ComponentCount"] + 1, Length[roots]],
      "CoefficientMonomials" -> coefficients["ComponentMonomials"],
      "ExternalSpinWeights" -> weights, "MassNormalization" -> normalized,
      "Chart" -> chart, "NullAxisChiralitySelection" -> axisChoice, "DenominatorClearing" -> cleared,
      "PolynomialExtraction" -> KeyDrop[coefficients, "CoefficientRules"],
      "NumericalKinematicSamples" -> 0, "CoherentSpinSamples" -> 0,
      "InternalOnShellConditions" -> {}|>
  ];
  result = TimeConstrained[MemoryConstrained[Catch[work[], tag], 536870912,
      failure["NativePreparationMemoryLimit"]], left[], failure["NativePreparationTimeConstraint"]];
  Join[result, <|"PreparationSeconds" -> AbsoluteTime[] - started,
    "MixedRationalAttempt" -> If[AssociationQ[rationalPrepared],
      KeyTake[rationalPrepared, {"Status", "Method", "PreparationSeconds"}], rationalPrepared]|>]
];


(* Keep opposite massless spinor types constant on a dense mixed-axis patch.
   After putting one massive momentum at rest, an undotted null line and a
   dotted null line can both be e1 when their rest-momentum pairing is nonzero.
   Conservation then fixes one entry of another massive shell linearly. The
   two remaining null momenta share one free entry, so no physical invariant
   or internal virtuality is fixed. *)
completionHERestMixedNullSymbolicChart[rules_List, nullPivots_: Automatic,
    massiveKind_: "Angle"] := Module[
  {external, masses, null, massive, anchor, dependent, free, momenta = <||>,
   angle = <||>, square = <||>, angleBasis = <||>, squareBasis = <||>,
   variables = {}, spins = {}, patches = {}, new, shell, a, b, c, p, total, rest,
   shared, angleLeg, squareLeg, pivots, basis, sBasis, spin,
   epsilon = {{0, 1}, {-1, 0}}, zero, shells, conservation, bases, nullProducts},
  external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]];
  If[Length[external] < 4 || !DuplicateFreeQ[external] ||
      !MemberQ[{"Angle", "Square"}, massiveKind], Return[$Failed]];
  masses = AssociationThread[external, (Mass /@ external) /. rules];
  If[!FreeQ[Values[masses], _Mass | _Real | _Missing | _Failure] ||
      !residueFiniteQ[Values[masses]], Return[$Failed]];
  null = Select[external, masses[#] === 0 &]; massive = Complement[external, null];
  If[Length[null] < 2 || Length[massive] < 2, Return[$Failed]];
  pivots = If[nullPivots === Automatic, Take[null, 2], nullPivots];
  If[!MatchQ[pivots, {_Integer, _Integer}] || !DuplicateFreeQ[pivots] ||
      !ContainsAll[null, pivots], Return[$Failed]];
  {angleLeg, squareLeg} = pivots;
  anchor = First[massive]; dependent = Last[massive];
  new[] := With[{value = Unique["mixedNullIdentityCoordinate"]},
    AppendTo[variables, value]; value];
  shell[mass_] := (a = new[]; b = new[]; c = new[]; AppendTo[patches, a];
    {{a, b}, {c, (mass^2 + b c)/a}});
  AssociateTo[momenta, anchor -> masses[anchor] IdentityMatrix[2]];
  free = Complement[external, {anchor, dependent, angleLeg, squareLeg}];
  Do[AssociateTo[momenta, leg -> shell[masses[leg]]], {leg, free}];
  rest = Total[Values[momenta]];
  a = new[]; b = new[]; shared = new[]; AppendTo[patches, b];
  p = {{a, b}, {(-a rest[[2, 2]] - masses[dependent]^2)/b, -rest[[2, 2]]}};
  AssociateTo[momenta, dependent -> p]; total = -rest - p;
  AssociateTo[momenta, {
    angleLeg -> {{shared, total[[1, 2]]}, {0, 0}},
    squareLeg -> {{total[[1, 1]] - shared, 0}, {total[[2, 1]], 0}}}];
  AssociateTo[angle, angleLeg -> {1, 0}];
  AssociateTo[square, angleLeg -> {shared, total[[1, 2]]}];
  AssociateTo[square, squareLeg -> {1, 0}];
  AssociateTo[angle, squareLeg -> {total[[1, 1]] - shared, total[[2, 1]]}];
  zero[value_] := TrueQ[Cancel[Together[value]] === 0];
  Do[
    p = momenta[leg];
    If[masses[leg] === 0,
      If[!MemberQ[pivots, leg],
        AssociateTo[angle, leg -> p[[All, 1]]];
        AssociateTo[square, leg -> {1, p[[1, 2]]/p[[1, 1]]}]],
      basis = {{masses[leg], 0}, {0, 1}};
      If[massiveKind === "Angle",
        sBasis = epsilon.residueAdjugate[p].basis/masses[leg],
        sBasis = basis; basis = -p.epsilon.sBasis/masses[leg]];
      spin = Unique["mixedNullIdentitySpin"]; AppendTo[spins, spin];
      AssociateTo[angleBasis, leg -> basis]; AssociateTo[squareBasis, leg -> sBasis];
      AssociateTo[angle, leg -> basis.{1, spin}];
      AssociateTo[square, leg -> sBasis.{1, spin}]],
    {leg, external}];
  shells = AssociationThread[external,
    zero[Det[momenta[#]] - masses[#]^2] & /@ external];
  conservation = AllTrue[Flatten[Total[Values[momenta]]], zero];
  nullProducts = AssociationThread[null, AllTrue[
    Flatten[Outer[Times, angle[#], square[#]] - momenta[#]], zero] & /@ null];
  bases = AssociationThread[massive, Function[leg,
    zero[Det[angleBasis[leg]] - masses[leg]] && zero[Det[squareBasis[leg]] - masses[leg]] &&
      AllTrue[Flatten[angleBasis[leg].epsilon.Transpose[squareBasis[leg]] - momenta[leg]], zero] &&
      AllTrue[Flatten[squareBasis[leg] - epsilon.residueAdjugate[momenta[leg]].
        angleBasis[leg]/masses[leg]], zero]] /@ massive];
  If[!And @@ Join[Values[shells], Values[nullProducts], Values[bases], {conservation}],
    Return[$Failed]];
  <|"Momenta" -> momenta, "Masses" -> masses, "Angle" -> angle, "Square" -> square,
    "AngleBasis" -> angleBasis, "SquareBasis" -> squareBasis, "SpinVariables" -> spins,
    "NullAxisLegs" -> pivots, "NullAxisChirality" -> "Mixed",
    "MassiveSpinorBasis" -> massiveKind, "RestFrameLeg" -> anchor,
    "DependentShellLegs" -> {dependent, angleLeg, squareLeg},
    "PoleVariable" -> Unique["unusedMixedNullIdentityPole"], "ReferenceSeed" -> 0,
    "CoherentVectorSpinIndices" -> True, "ExternalIdentityCoordinates" -> variables,
    "ExternalMassShellsValidated" -> True, "ExternalMassShellChecks" -> shells,
    "MomentumConservationValidated" -> True, "ExternalSpinorBasesValidated" -> bases,
    "NullSpinorProductsValidated" -> nullProducts, "InternalOnShellConditions" -> {},
    "DenseDomainNonzeroExpressions" -> Join[Lookup[masses, massive], patches,
      {shared, total[[1, 1]] - shared}],
    "CoverageMethod" -> "MassiveRestAndMixedNullLinesOnNonzeroMixedSandwichPatch",
    "OriginalMixedNullSandwichRequiredNonzero" -> {angleLeg, anchor, squareLeg},
    "ResidualGaugeDimension" -> 1, "NumericalKinematicSamples" -> 0|>
];

(* A coordinate preference, not a restriction on the allowed identity. Only
   opposite nonzero homogeneous massless weights favor this chart; their
   inexpensive spinor types are fixed independently. *)
completionHEMixedNullAxisChoice[expression_, rules_List] := Module[
  {external, null, massive, weights, byLeg, angles, squares},
  external = Sort[Cases[preparationExternalRules[rules], HoldPattern[Mass[i_Integer] -> _] :> i]];
  null = Select[external, TrueQ[(Mass[#] /. rules) === 0] &];
  massive = Complement[external, null];
  If[Length[massive] < 2 || Length[null] < 2,
    Return[<|"Status" -> "UNAVAILABLE", "Reason" -> "MixedNullMassInventory"|>]];
  weights = completionExternalSpinWeights[expression, rules];
  If[!ListQ[weights] || Length[weights] =!= Length[external] || !AllTrue[weights, IntegerQ],
    Return[<|"Status" -> "UNAVAILABLE", "Reason" -> "MasslessSpinHomogeneity"|>]];
  byLeg = AssociationThread[external, weights];
  angles = Select[null, TrueQ[byLeg[#] > 0] &];
  squares = Select[null, TrueQ[byLeg[#] < 0] &];
  If[angles === {} || squares === {},
    Return[<|"Status" -> "UNAVAILABLE", "Reason" -> "NoOppositeMasslessSpinWeights"|>]];
  <|"Status" -> "AVAILABLE", "NullAxisLegs" -> {First[angles], First[squares]},
    "AngleAxisLeg" -> First[angles], "SquareAxisLeg" -> First[squares],
    "ExternalSpinWeights" -> weights,
    "Method" -> "OppositeHomogeneousMasslessWeights"|>
];

(* One massive rest momentum and one nonzero null axis leave a residual axial
   rotation. Keeping it avoids a square root in the two dependent shell solve.
   The two shell equations are linear in the second-row entries once the first
   row is free; their Jacobian is K11 b - K12 a. Only external shells are used. *)
completionHERestSingleNullSymbolicChart[rules_List, rest_: Automatic,
    nullLeg_: Automatic, dependent_: Automatic, nullKind_: "Angle", massiveKind_: "Angle"] := Module[
  {external, masses, null, massive, anchor, photon, final, free, momenta = <||>,
   angle = <||>, square = <||>, angleBasis = <||>, squareBasis = <||>, variables = {},
   spins = {}, patches = {}, new, shell, z, a, b, c, d, total, delta, denominator,
   first, mass, basis, conjugate, spin, epsilon = {{0, 1}, {-1, 0}}, zero,
   shells, conservation, bases, nullProducts, linearWitness, domain},
  external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]];
  If[Length[external] < 4 || Length[external] > 8 || !DuplicateFreeQ[external] ||
      !MemberQ[{"Angle", "Square"}, nullKind] || !MemberQ[{"Angle", "Square"}, massiveKind], Return[$Failed]];
  masses = AssociationThread[external, (Mass /@ external) /. rules];
  If[!FreeQ[Values[masses], _Mass | _Real | _Missing | _Failure] ||
      !residueFiniteQ[Values[masses]], Return[$Failed]];
  null = Select[external, masses[#] === 0 &]; massive = Complement[external, null];
  If[Length[null] =!= 1 || Length[massive] < 3, Return[$Failed]];
  anchor = Replace[rest, Automatic -> First[massive]];
  photon = Replace[nullLeg, Automatic -> First[null]];
  If[!MemberQ[massive, anchor] || !MemberQ[null, photon], Return[$Failed]];
  final = Replace[dependent, Automatic -> Take[Complement[massive, {anchor}], -2]];
  If[!MatchQ[final, {_Integer, _Integer}] || !DuplicateFreeQ[final] ||
      !ContainsAll[Complement[massive, {anchor}], final], Return[$Failed]];
  new[] := With[{value = Unique["singleNullIdentityCoordinate"]}, AppendTo[variables, value]; value];
  shell[m_] := Module[{aa = new[], bb = new[], cc = new[]},
    AppendTo[patches, aa]; {{aa, bb}, {cc, (m^2 + bb cc)/aa}}];
  z = new[]; AppendTo[patches, z];
  AssociateTo[momenta, {anchor -> masses[anchor] IdentityMatrix[2], photon -> {{z, 0}, {0, 0}}}];
  If[nullKind === "Angle", AssociateTo[angle, photon -> {1, 0}]; AssociateTo[square, photon -> {z, 0}],
    AssociateTo[angle, photon -> {z, 0}]; AssociateTo[square, photon -> {1, 0}]];
  free = Complement[external, {anchor, photon}, final];
  Do[AssociateTo[momenta, leg -> shell[masses[leg]]], {leg, free}];
  total = Total[Values[momenta]]; a = new[]; b = new[];
  delta = masses[final[[2]]]^2 - Det[total] - masses[final[[1]]]^2;
  denominator = total[[1, 1]] b - total[[1, 2]] a;
  c = (delta a - total[[2, 2]] a^2 - total[[1, 1]] masses[final[[1]]]^2 +
      total[[2, 1]] a b)/denominator;
  d = (masses[final[[1]]]^2 + b c)/a; first = {{a, b}, {c, d}};
  patches = Join[patches, {a, denominator}];
  AssociateTo[momenta, {final[[1]] -> first, final[[2]] -> (-total - first)}];
  zero[value_] := TrueQ[Cancel[Together[value]] === 0];
  linearWitness = zero[denominator c - (delta a - total[[2, 2]] a^2 -
    total[[1, 1]] masses[final[[1]]]^2 + total[[2, 1]] a b)];
  Do[
    mass = masses[leg]; basis = {{mass, 0}, {0, 1}};
    If[massiveKind === "Angle", conjugate = epsilon.residueAdjugate[momenta[leg]].basis/mass,
      conjugate = basis; basis = -momenta[leg].epsilon.conjugate/mass];
    spin = Unique["singleNullIdentitySpin"]; AppendTo[spins, spin];
    AssociateTo[angleBasis, leg -> basis]; AssociateTo[squareBasis, leg -> conjugate];
    AssociateTo[angle, leg -> basis.{1, spin}]; AssociateTo[square, leg -> conjugate.{1, spin}],
    {leg, massive}];
  shells = AssociationThread[external, zero[Det[momenta[#]] - masses[#]^2] & /@ external];
  conservation = AllTrue[Flatten[Total[Values[momenta]]], zero];
  nullProducts = <|photon -> AllTrue[Flatten[Outer[Times, angle[photon], square[photon]] - momenta[photon]], zero]|>;
  bases = AssociationThread[massive, Function[leg,
      zero[Det[angleBasis[leg]] - masses[leg]] && zero[Det[squareBasis[leg]] - masses[leg]] &&
      AllTrue[Flatten[angleBasis[leg].epsilon.Transpose[squareBasis[leg]] - momenta[leg]], zero] &&
      AllTrue[Flatten[squareBasis[leg] - epsilon.residueAdjugate[momenta[leg]].angleBasis[leg]/masses[leg]], zero]
    ] /@ massive];
  domain = DeleteDuplicates[Join[Lookup[masses, massive], patches]];
  If[!And @@ Join[Values[shells], Values[bases], Values[nullProducts], {conservation, linearWitness}] ||
      AnyTrue[domain, zero], Return[$Failed]];
  <|"Momenta" -> momenta, "Masses" -> masses, "Angle" -> angle, "Square" -> square,
    "AngleBasis" -> angleBasis, "SquareBasis" -> squareBasis, "SpinVariables" -> spins,
    "NullAxisLegs" -> {photon}, "NullAxisChirality" -> nullKind, "RestFrameLeg" -> anchor,
    "DependentShellLegs" -> final, "MassiveSpinorBasis" -> massiveKind,
    "PoleVariable" -> Unique["unusedSingleNullIdentityPole"], "ReferenceSeed" -> 0,
    "CoherentVectorSpinIndices" -> True, "AllowCutSpinors" -> False,
    "ExternalIdentityCoordinates" -> variables, "ExternalMassShellsValidated" -> True,
    "ExternalMassShellChecks" -> shells, "MomentumConservationValidated" -> conservation,
    "ExternalSpinorBasesValidated" -> bases, "NullSpinorProductsValidated" -> nullProducts,
    "DenseDomainNonzeroExpressions" -> domain,
    "CoverageMethod" -> "MassiveRestAndSingleNullAxisOnNonzeroRestNullInvariantPatch",
    "OriginalRestNullInvariantRequiredNonzero" -> {anchor, photon},
    "DependentShellLinearReconstruction" -> linearWitness,
    "DependentShellJacobian" -> denominator, "ResidualGaugeDimension" -> 1,
    "NumericalKinematicSamples" -> 0, "InternalOnShellConditions" -> {}|>
];

(* Replace exact scalar atoms by independent indeterminates, retaining every
   mass and coupling. Positive rational radicals use common prime-root units;
   e.g. Sqrt[2] and 1/Sqrt[2] become u and u/2, with u restored to Sqrt[2].
   A polynomial zero in these independent variables is a stronger statement.
   No algebraic relation is guessed and no mass is set to a numerical value. *)
completionHEExactScalarVariables[expression_, rules_List: {}, seconds_: 3] := Module[
  {started = AbsoluteTime[], failure, work, result, tag = Unique["exactScalarVariables"]},
  failure[reason_] := <|"Status" -> "UNSUPPORTED", "Reason" -> reason|>;
  If[!TrueQ[NumericQ[seconds] && seconds > 0] || LeafCount[{expression, rules}] > 100000,
    Return[failure["ScalarMappingBudget"]]];
  work[] := Module[{collect, scalars, radicals, plain, supportedRadicalQ, data, orders,
      primeVariables, ordinaryVariables, variables, forward, backward, rootRule, witnesses,
      mapped, mappedRules, numericBackward, source},
    collect[value_] := Which[
      Head[value] === ModelParameter, {value},
      Head[value] === PropDen, Flatten[collect /@ Rest[List @@ value]],
      MatchQ[value, _SpinorChain | _SpinorTrace | _MomProd | _Mandelstahm | _Mom], {},
      IntegerQ[value] || Head[value] === Rational, {},
      MemberQ[{Plus, Times}, Head[value]], Flatten[collect /@ List @@ value],
      Head[value] === Power && IntegerQ[Last[value]], collect[First[value]],
      NumericQ[value] && FreeQ[value, _Real], {value},
      Head[value] === Symbol, {value}, True, Throw[failure["UnsupportedScalarNode"], tag]];
    source = expression /. rules;
    scalars = DeleteDuplicates[Join[collect[source], Flatten[collect /@ (Last /@ rules)]]];
    If[Length[scalars] > 16, Throw[failure["ScalarVariableLimit"], tag]];
    supportedRadicalQ[value_] := MatchQ[value, Power[_Integer | _Rational, _Rational]] &&
      TrueQ[First[value] > 0] && Denominator[Last[value]] <= 16 && Abs[Numerator[Last[value]]] <= 4096 &&
      Max[IntegerLength[Numerator[First[value]], 2], IntegerLength[Denominator[First[value]], 2]] <= 32;
    radicals = Select[scalars, supportedRadicalQ]; plain = Complement[scalars, radicals];
    data = Function[root, Association[Rule @@@ Map[
        {#[[1]], #[[2]] Last[root]} &, FactorInteger[First[root]]]]] /@ radicals;
    orders = If[data === {}, <||>, Merge[Map[Map[Denominator, #] &, data], Apply[LCM]]];
    If[AnyTrue[Values[orders], # > 16 &], Throw[failure["SharedRadicalOrderLimit"], tag]];
    primeVariables = AssociationThread[Keys[orders], Table[Unique["exactRadicalUnit"], {Length[orders]}]];
    ordinaryVariables = Table[Unique["exactScalarVariable"], {Length[plain]}];
    variables = Join[ordinaryVariables, Values[primeVariables]];
    If[Length[variables] > 16, Throw[failure["ScalarVariableLimit"], tag]];
    backward = Join[Thread[ordinaryVariables -> plain], KeyValueMap[
      #2 -> #1^(1/orders[#1]) &, primeVariables]];
    rootRule[root_] := Module[{powers = data[[First[FirstPosition[radicals, root]]]]},
      root -> Times @@ KeyValueMap[Function[{prime, exponent}, With[
        {whole = Floor[exponent], order = orders[prime]},
        prime^whole primeVariables[prime]^((exponent - whole) order)]], powers]];
    forward = Join[Thread[plain -> ordinaryVariables], rootRule /@ radicals];
    witnesses = Function[rule, Module[{restored = Last[rule] /. backward, same, algebraic},
      same = SameQ[restored, First[rule]];
      algebraic = !same && NumericQ[First[rule]] && FreeQ[First[rule], _Real] &&
        TrueQ[RootReduce[restored - First[rule]] === 0];
      <|"Rule" -> rule, "ExactSameQ" -> same, "ExactNumericRootReduce" -> algebraic,
        "Verified" -> (same || algebraic)|>]] /@ forward;
    If[!AllTrue[witnesses, TrueQ[# ["Verified"]] &], Throw[failure["ScalarRoundTripFailed"], tag]];
    mapped = source /. Dispatch[forward]; mappedRules = rules /. Dispatch[forward];
    numericBackward = Select[backward, NumericQ[Last[#]] && FreeQ[Last[#], _Real] &];
    <|"Status" -> "COMPLETE", "Expression" -> mapped, "ExternalMassRules" -> mappedRules,
      "Variables" -> variables, "ForwardRules" -> forward, "BackwardRules" -> backward,
      "ExternalMassDefinitionsApplied" -> rules, "ResolvedExpression" -> source,
      "NumericRestorationRules" -> numericBackward, "RuleWitnesses" -> witnesses,
      "PrimeRootOrders" -> orders, "PrimeRootVariables" -> primeVariables,
      "ExactScalarRoundTrip" -> True, "SharedRationalRootUnits" -> True,
      "IndependentScalarIndeterminates" -> True, "MassNormalizationUsed" -> False,
      "NumericalParameterSubstitutions" -> {}, "NumericalKinematicSamples" -> 0|>
  ];
  result = TimeConstrained[MemoryConstrained[Catch[work[], tag], 134217728,
      failure["ScalarMappingMemoryLimit"]], seconds, failure["ScalarMappingTimeLimit"]];
  Join[result, <|"ElapsedTime" -> AbsoluteTime[] - started|>]
];

(* Fraction-free lifting avoids expanding the large coherent coefficients.
   The denominator of every child is a map of actual positive factors. Plus
   nodes verify the common-denominator powers locally; inverse nodes retain
   every newly inverted numerator as a nonzero obligation. *)
completionHEClearRationalRoots[roots_List, variables_List, seconds_: 5] := Module[
  {started = AbsoluteTime[], failure, work, result, tag = Unique["rationalRootLift"]},
  failure[reason_] := <|"Status" -> "UNSUPPORTED", "Reason" -> reason|>;
  If[!TrueQ[NumericQ[seconds] && seconds > 0] || roots === {} ||
      Length[roots] > 512 || Length[variables] > 16 || !DuplicateFreeQ[variables] ||
      !AllTrue[variables, MatchQ[#, _Symbol] &] || !FreeQ[roots, _Real] ||
      !residueFiniteQ[roots], Return[failure["UnsupportedRationalRootInput"]]];
  work[] := Module[{fraction, factors, product, powerMap, positive, records = {}, inversions = {},
      nodeCount = 0, degrees, degree, pairs, additional, rootNodes, inputVariables, checked = True},
    product[association_] := Times @@ KeyValueMap[Power, association];
    positive[association_] := AllTrue[Values[association], IntegerQ[#] && # >= 0 &];
    powerMap[association_, power_] := Map[power # &, association];
    factors[value_] := Which[value === 1, <||>, Head[value] === Times,
      Merge[factors /@ List @@ value, Total],
      Head[value] === Power && IntegerQ[Last[value]] && Last[value] > 0,
      powerMap[factors[First[value]], Last[value]], True, <|value -> 1|>];
    degree[value_] := degree[value] = Which[
      IntegerQ[value] || Head[value] === Rational, 0, MemberQ[variables, value], 1,
      Head[value] === Plus, Max[Prepend[degree /@ List @@ value, 0]],
      Head[value] === Times, Total[degree /@ List @@ value],
      Head[value] === Power && IntegerQ[Last[value]] && Last[value] >= 0,
        Last[value] degree[First[value]], True, Throw[failure["NonPolynomialLift"], tag]];
    fraction[value_] := fraction[value] = Module[
      {id = ++nodeCount, parts, pair, common, missing, local = True, power, atomFactors, childIds = {}, operation},
      If[nodeCount > 50000, Throw[failure["RationalLiftNodeLimit"], tag]];
      Which[
        IntegerQ[value] || Head[value] === Rational,
          If[Max[IntegerLength[Abs[Numerator[value]], 2], IntegerLength[Denominator[value], 2]] > 4096,
            Throw[failure["RationalLiftCoefficientLimit"], tag]];
          pair = {value, <||>}; operation = "ExactRational",
        MemberQ[variables, value], pair = {value, <||>}; operation = "DeclaredVariable",
        Head[value] === Times,
          parts = fraction /@ List @@ value; childIds = parts[[All, 3]];
          pair = {Times @@ parts[[All, 1]], Merge[parts[[All, 2]], Total]};
          local = SameQ[Times @@ (product /@ parts[[All, 2]]), product[pair[[2]]]];
          operation = "Product",
        Head[value] === Plus,
          parts = fraction /@ List @@ value; childIds = parts[[All, 3]];
          common = Merge[parts[[All, 2]], Max];
          missing = Function[part, Association @ KeyValueMap[
              #1 -> (#2 - Lookup[part[[2]], #1, 0]) &, common]] /@ parts;
          local = AllTrue[missing, positive] && AllTrue[MapThread[
            SameQ[product[#1] product[#2[[2]]], product[common]] &, {missing, parts}], TrueQ];
          pair = {Total[MapThread[#1[[1]] product[#2] &, {parts, missing}]], common};
          operation = "CommonDenominatorSum",
        Head[value] === Power && IntegerQ[Last[value]] && Abs[Last[value]] <= 1000000,
          parts = fraction[First[value]]; childIds = {parts[[3]]}; power = Last[value];
          If[power >= 0,
            pair = {parts[[1]]^power, powerMap[parts[[2]], power]};
            local = SameQ[product[parts[[2]]]^power, product[pair[[2]]]]; operation = "NonnegativeIntegerPower",
            If[parts[[1]] === 0, Throw[failure["ZeroInvertedNumerator"], tag]];
            atomFactors = factors[parts[[1]]];
            local = SameQ[product[atomFactors], parts[[1]]];
            AppendTo[inversions, parts[[1]]];
            pair = {product[parts[[2]]]^(-power), powerMap[atomFactors, -power]};
            operation = "IntegerInverse"],
        True, Throw[failure["UnsupportedRationalLiftNode"], tag]];
      local = TrueQ[local] && positive[pair[[2]]]; checked = checked && local;
      If[!local, Throw[failure["LocalDenominatorReconstructionFailed"], tag]];
      If[degree[pair[[1]]] > 4096 || degree[product[pair[[2]]]] > 4096,
        Throw[failure["RationalLiftDegreeLimit"], tag]];
      AppendTo[records, <|"Node" -> id, "Operation" -> operation, "Children" -> childIds,
        "DenominatorPowers" -> pair[[2]], "LocalFactorReconstruction" -> local,
        "PositiveDenominatorPowers" -> positive[pair[[2]]]|>];
      {pair[[1]], pair[[2]], id}];
    pairs = fraction /@ roots;
    additional = DeleteDuplicates[Join[Flatten[Keys /@ pairs[[All, 2]]], inversions]];
    If[AnyTrue[additional, # === 0 &], Throw[failure["ZeroClearingFactor"], tag]];
    inputVariables = DeleteDuplicates[Cases[{roots}, symbol_Symbol /; !MemberQ[{Plus, Times, Power}, symbol], Infinity]];
    <|"Status" -> "COMPLETE", "Numerators" -> pairs[[All, 1]],
      "RootDenominatorPowers" -> pairs[[All, 2]], "RootNodes" -> pairs[[All, 3]],
      "AdditionalNonzeroFactors" -> additional, "NodeCount" -> nodeCount,
      "LocalWitnesses" -> records, "LocalFactorReconstruction" -> checked,
      "ReconstructionVerified" -> checked, "AllPowersNonnegative" -> True,
      "AllVariablesDeclared" -> True, "MaximumTotalDegree" -> Max[degree /@ Join[pairs[[All, 1]], additional]],
      "NumericalKinematicSamples" -> 0, "InternalOnShellConditions" -> {}|>
  ];
  result = TimeConstrained[MemoryConstrained[Catch[work[], tag], 268435456,
      failure["RationalLiftMemoryLimit"]], seconds, failure["RationalLiftTimeLimit"]];
  Join[result, <|"ElapsedTime" -> AbsoluteTime[] - started|>]
];

(* Exact scalar specializations must not turn a generically nonzero clearing
   factor into the zero polynomial. One nonzero exact coefficient suffices;
   no kinematic or parameter point is sampled. *)
completionHEScalarNonzeroWitnesses[factors_List, variables_List, scalarMap_Association, seconds_] := Module[
  {started = AbsoluteTime[], numeric = Lookup[scalarMap, "NumericRestorationRules", {}],
   free, witnesses = {}, value, coefficients, witness, result, failure,
   tag = Unique["singleNullNonzeroWitness"]},
  failure[reason_] := <|"Status" -> "UNSUPPORTED", "Reason" -> reason|>;
  free = Complement[variables, First /@ numeric];
  result = TimeConstrained[MemoryConstrained[Catch[
    Do[
      value = factor /. Dispatch[numeric];
      coefficients = If[free === {}, {value}, Last /@ CoefficientRules[Expand[value], free]];
      witness = SelectFirst[coefficients, Function[coefficient,
        NumericQ[coefficient] && FreeQ[coefficient, _Real] &&
          With[{algebraic = RootReduce[coefficient]},
            TrueQ[Element[algebraic, Algebraics]] && TrueQ[algebraic != 0]]],
        Missing["NoExactNonzeroCoefficient"]];
      If[MissingQ[witness], Throw[failure["ScalarSpecializationMayVanish"], tag]];
      AppendTo[witnesses, <|"Factor" -> factor, "ExactNonzeroCoefficient" -> witness,
        "AlgebraicMembershipVerified" -> True,
        "NumericConstantsRestored" -> True, "KinematicSamples" -> 0|>], {factor, factors}];
    If[Length[witnesses] =!= Length[factors], Throw[failure["IncompleteScalarWitnessSet"], tag]];
    <|"Status" -> "COMPLETE", "Witnesses" -> witnesses,
      "FactorCount" -> Length[factors], "WitnessCount" -> Length[witnesses],
      "EveryFactorNonzeroAfterNumericRestoration" -> True, "NumericalKinematicSamples" -> 0|>, tag],
    134217728, failure["ScalarSpecializationMemoryLimit"]], seconds, failure["ScalarSpecializationTimeLimit"]];
  Join[result, <|"ElapsedTime" -> AbsoluteTime[] - started|>]
];

completionHEPrepareSingleNullNativeIdentity[expression_, rules_List, seconds_: 20] :=
  completionHEPrepareRationalNativeIdentity[expression, rules, seconds, "SingleNull"];

completionHEPrepareMixedNullNativeIdentity[expression_, rules_List, seconds_: 20] :=
  completionHEPrepareRationalNativeIdentity[expression, rules, seconds, "MixedNull"];

completionHEPrepareRestNullNativeIdentity[expression_, rules_List, seconds_: 20] :=
  completionHEPrepareRationalNativeIdentity[expression, rules, seconds, "Null"];

completionHEPrepareRationalNativeIdentity[expression_, rules_List, seconds_, chartKind_] := Module[
  {started = AbsoluteTime[], failure, remaining, work, result, tag = Unique["singleNullNativePreparation"]},
  failure[reason_] := <|"Status" -> "NOT_PROVED", "Method" -> reason|>;
  If[!TrueQ[NumericQ[seconds] && 0 < seconds < Infinity] ||
      !MemberQ[{"SingleNull", "MixedNull", "Null"}, chartKind], Return[failure["NativePreparationBudget"]]];
  remaining[] := Max[0.000001, seconds - (AbsoluteTime[] - started)];
  work[] := Module[{external, weights, unsupported, scalarMap, resolved, mappedRules, chart,
      axisChoice, atoms, tokens, opaque, restore, together, numerator, denominator,
      factorQ, denominatorFactors, typedReconstruction, mapped, mappedDenominators,
      coefficients, roots, lifted, variables, nonzeroWitnesses, dag, denominatorClearing, mixedChoice},
    external = Sort[Cases[rules, HoldPattern[Mass[i_Integer] -> _] :> i]];
    unsupported = !FreeQ[expression, _Real | _SpinorHat | _MomHat | _xFactor | _xTildeFactor |
      Spinor["Xi" | "Zeta", ___]] || AnyTrue[Cases[expression, spinor_Spinor /;
        First[List @@ spinor] === "Spin", Infinity], Function[spinor,
          With[{data = List @@ spinor}, With[{position = First[FirstPosition[data, "Angle" | "Square"]]},
            !MatchQ[Drop[data, position + 1], {} | {VectorSpinIndex[_, 1 | 2]}]]]]];
    unsupported = unsupported || !completionHEMasslessHelicityTagsQ[expression, rules];
    weights = completionExternalSpinWeights[expression, rules];
    If[unsupported || !ListQ[weights] || Length[weights] =!= Length[external] ||
        !AllTrue[weights, IntegerQ] || !completionHECovariantScalarQ[expression, external],
      Throw[failure["UnsupportedCovarianceOrSpinHomogeneity"], tag]];
    scalarMap = completionHEExactScalarVariables[expression, preparationExternalRules[rules], Min[3, remaining[]]];
    If[Lookup[scalarMap, "Status", None] =!= "COMPLETE",
      Throw[Join[failure["UnsupportedExactScalarMapping"], <|"ScalarVariableCertificate" -> scalarMap|>], tag]];
    resolved = scalarMap["Expression"]; mappedRules = scalarMap["ExternalMassRules"];
    axisChoice = completionHENativeNullAxisChoice[expression, rules];
    Which[chartKind === "SingleNull",
      chart = completionHERestSingleNullSymbolicChart[mappedRules, Automatic, Automatic, Automatic,
        axisChoice["Chirality"], axisChoice["Chirality"]],
      chartKind === "MixedNull",
      mixedChoice = completionHEMixedNullAxisChoice[expression, rules];
      If[Lookup[mixedChoice, "Status", None] =!= "AVAILABLE",
        Throw[Join[failure["UnsupportedMixedNullWeights"], <|"MixedNullAxisSelection" -> mixedChoice|>], tag]];
      chart = completionHERestMixedNullSymbolicChart[mappedRules,
        mixedChoice["NullAxisLegs"], axisChoice["Chirality"]],
      True, chart = completionHERestNullSymbolicChart[mappedRules,
        completionHEPreferredNullPivots[expression, rules], axisChoice["Chirality"]]];
    If[!AssociationQ[chart], Throw[failure["UnsupportedRest" <> chartKind <> "Chart"], tag]];
    variables = Join[chart["ExternalIdentityCoordinates"], scalarMap["Variables"]];
    If[Length[variables] > 16 || !DuplicateFreeQ[variables], Throw[failure["NativeVariableLimit"], tag]];
    atoms = DeleteDuplicates[Cases[resolved, _SpinorChain | _SpinorTrace | _MomProd |
      _Mandelstahm | _PropDen | _Mom, {0, Infinity}]];
    tokens = Table[Unique["singleNullPrimitive"], {Length[atoms]}]; restore = Dispatch[Thread[tokens -> atoms]];
    opaque = resolved /. Dispatch[Thread[atoms -> tokens]];
    If[!SameQ[opaque /. restore, resolved], Throw[failure["PrimitiveRoundTripFailed"], tag]];
    together = Together[opaque];
    typedReconstruction = TrueQ[Cancel[Together[opaque - Numerator[together]/Denominator[together]]] === 0];
    If[!typedReconstruction, Throw[failure["TypedDenominatorReconstructionFailed"], tag]];
    numerator = Numerator[together] /. restore; denominator = Denominator[together] /. restore;
    factorQ[value_] := Which[
      IntegerQ[value] || Head[value] === Rational, value =!= 0,
      MemberQ[scalarMap["Variables"], value], True,
      Head[value] === PropDen, Length[value] === 2 && MatchQ[First[value], _Mom] &&
        FreeQ[Last[value], _SpinorChain | _SpinorTrace | _Mom | _MomProd | _PropDen],
      Head[value] === Times, AllTrue[List @@ value, factorQ],
      Head[value] === Power && IntegerQ[Last[value]] && Last[value] > 0, factorQ[First[value]],
      True, False];
    If[!factorQ[denominator], Throw[failure["UnsupportedTypedDenominator"], tag]];
    denominatorFactors = DeleteDuplicates[Join[Cases[denominator, _PropDen, {0, Infinity}],
      Select[scalarMap["Variables"], !FreeQ[denominator, #] &]]];
    denominatorClearing = <|"Numerator" -> numerator, "Denominator" -> denominator,
      "DenominatorFactors" -> denominatorFactors, "ExactRationalReconstruction" -> typedReconstruction,
      "PrimitiveRestorationExact" -> True, "InternalOnShellConditions" -> {}|>;
    mapped = spuriousEvaluateCurve[numerator, chart, {}];
    mappedDenominators = spuriousEvaluateCurve[#, chart, {}] & /@ denominatorFactors;
    If[residueUnmappedQ[{mapped, mappedDenominators}] || !residueFiniteQ[{mapped, mappedDenominators}] ||
        !FreeQ[{mapped, mappedDenominators}, _Real | _Missing | _Failure],
      Throw[failure["UnsupportedSingleNullMapping"], tag]];
    coefficients = amplitudeCoherentPolynomialRules[mapped, chart["SpinVariables"],
      Min[If[chartKind === "MixedNull", 12, 6], remaining[]]];
    If[Lookup[coefficients, "Status", None] =!= "COMPLETE" ||
        !TrueQ[coefficients["FullCoefficientCoverage"]] || !TrueQ[coefficients["ReconstructionVerified"]],
      Throw[Join[failure["IncompleteCoherentPolynomial"],
        <|"PolynomialExtraction" -> KeyDrop[coefficients, "CoefficientRules"]|>], tag]];
    roots = Join[Last /@ coefficients["CoefficientRules"], mappedDenominators,
      chart["DenseDomainNonzeroExpressions"]];
    lifted = completionHEClearRationalRoots[roots, variables, Min[5, remaining[]]];
    If[Lookup[lifted, "Status", None] =!= "COMPLETE" || !TrueQ[lifted["ReconstructionVerified"]],
      Throw[Join[failure["IncompleteRationalLifting"], <|"RationalLiftCertificate" -> lifted|>], tag]];
    roots = Join[lifted["Numerators"], lifted["AdditionalNonzeroFactors"]];
    nonzeroWitnesses = completionHEScalarNonzeroWitnesses[
      Drop[roots, coefficients["ComponentCount"]], variables, scalarMap, Min[3, remaining[]]];
    If[Lookup[nonzeroWitnesses, "Status", None] =!= "COMPLETE",
      Throw[Join[failure["UnverifiedScalarSpecialization"],
        <|"ScalarSpecializationCertificate" -> nonzeroWitnesses|>], tag]];
    dag = completionHELaurentDAG[roots, variables, Min[6, remaining[]]];
    If[Lookup[dag, "Status", None] =!= "COMPLETE" || !TrueQ[dag["EveryNodeRoundTrip"]],
      Throw[Join[failure["UnsupportedLaurentExport"], <|"LaurentExport" -> dag|>], tag]];
    <|"Status" -> "PREPARED", "Method" -> ("DenseRest" <> chartKind <> "TypedPolynomialIdentity"),
      "DAG" -> dag, "CoefficientRootCount" -> coefficients["ComponentCount"],
      "DenominatorRootIndices" -> Range[coefficients["ComponentCount"] + 1, Length[roots]],
      "CoefficientMonomials" -> coefficients["ComponentMonomials"], "ExternalSpinWeights" -> weights,
      "Chart" -> chart, "NullAxisChiralitySelection" -> axisChoice,
      "MixedNullAxisSelection" -> If[chartKind === "MixedNull", mixedChoice, Missing["NotRequested"]],
      "ScalarVariableCertificate" -> scalarMap, "RationalLiftCertificate" -> KeyDrop[lifted, "Numerators"],
      "ScalarSpecializationCertificate" -> nonzeroWitnesses, "DenominatorClearing" -> denominatorClearing,
      "PolynomialExtraction" -> KeyDrop[coefficients, "CoefficientRules"],
      "MassNormalizationUsed" -> False, "NumericalParameterSubstitutions" -> {},
      "NumericalKinematicSamples" -> 0, "CoherentSpinSamples" -> 0, "InternalOnShellConditions" -> {}|>
  ];
  result = TimeConstrained[MemoryConstrained[Catch[work[], tag], 536870912,
      failure[chartKind <> "PreparationMemoryLimit"]], seconds, failure[chartKind <> "PreparationTimeConstraint"]];
  Join[result, <|"PreparationSeconds" -> AbsoluteTime[] - started|>]
];

completionHENativeRuntimeSources[] := Module[{directory, names, paths},
  directory = If[StringQ[Global`$HEPCATpath],
    FileNameJoin[{Global`$HEPCATpath, "internal", "proofs"}], ""];
  names = {"laurent-proof-runtime.cpp", "laurent-proof-runtime.py", "laurent-proof-factor.py", "laurent-proof-verify.py"};
  paths = FileNameJoin[{directory, #}] & /@ names;
  If[directory === "" || !AllTrue[paths, FileExistsQ], Return[$Failed]];
  AssociationThread[names, IntegerString[FileHash[#, "SHA256"], 16, 64] & /@ paths]
];

completionHENativeRuntimeResultQ[result_Association, dag_Association, expectedNonzero_List,
    sourceHashes_Association, directory_String, input_String] := Module[
  {rows, roots = dag["RootNodes"], factored, hashes, expected, rowValid, fingerprintFile,
   fingerprintText, fingerprint},
  rows = Lookup[result, "Roots", None]; factored = Lookup[result, "FactoredRoots", None];
  hashes = Lookup[result, "SourceHashes", None];
  If[Lookup[result, "RunStatus", None] =!= "COMPLETE" ||
      !MemberQ[{"PROVED_ZERO", "PROVED_EXPECTATIONS"}, Lookup[result, "Status", None]] ||
      !TrueQ[Lookup[result, "AllExpectedStatuses", False]] ||
      Lookup[result, "RootCount", None] =!= Length[roots] ||
      Lookup[result, "OriginalRoots", None] =!= roots || !ListQ[rows] || Length[rows] =!= Length[roots] ||
      !ListQ[factored] || Length[factored] =!= Length[roots] || !AllTrue[factored, IntegerQ[#] && # > 0 &] ||
      !AssociationQ[hashes] || KeySort[hashes] =!= KeySort[sourceHashes] ||
      Lookup[result, "ExpectedNonzeroRoots", None] =!= Sort[expectedNonzero] ||
      !AllTrue[FileNameJoin[{directory, #}] & /@ {"factored.dag", "factor-witnesses.json"}, FileExistsQ], Return[False]];
  expected = If[MemberQ[expectedNonzero, #], "NONZERO", "ZERO"] & /@ Range[Length[roots]];
  rowValid = MapIndexed[Function[{row, index}, With[{i = First[index]},
    AssociationQ[row] && Lookup[row, "Index", None] === i && Lookup[row, "InputNode", None] === roots[[i]] &&
      Lookup[row, "OutputNode", None] === factored[[i]] && Lookup[row, "ExpectedStatus", None] === expected[[i]] &&
      Lookup[row, "Status", None] === expected[[i]] && IntegerQ[Lookup[row, "Terms", None]] &&
      If[expected[[i]] === "ZERO", row["Terms"] === 0, row["Terms"] > 0]]], rows];
  If[!AllTrue[rowValid, TrueQ], Return[False]];
  If[Lookup[result, "InputSHA256", None] =!= IntegerString[FileHash[input, "SHA256"], 16, 64] ||
      Lookup[result, "OutputSHA256", None] =!= IntegerString[FileHash[FileNameJoin[{directory, "factored.dag"}], "SHA256"], 16, 64] ||
      Lookup[result, "FactorWitnessSHA256", None] =!= IntegerString[FileHash[FileNameJoin[{directory, "factor-witnesses.json"}], "SHA256"], 16, 64] ||
      Lookup[Lookup[result, "ExactFactorVerification", <||>], "Status", None] =!= "PASS", Return[False]];
  fingerprintText = StringRiffle[(# <> FromCharacterCode[0] <> sourceHashes[#]) & /@ Sort[Keys[sourceHashes]], "\n"];
  fingerprintFile = FileNameJoin[{directory, "source-fingerprint.txt"}];
  Export[fingerprintFile, fingerprintText, "Text"];
  fingerprint = IntegerString[FileHash[fingerprintFile, "SHA256"], 16, 64];
  Lookup[result, "SourceFingerprint", None] === fingerprint
];
completionHENativeRuntimeResultQ[___] := False;

completionHENativeLaurentRun[prepared_Association, seconds_] := Module[
  {started = AbsoluteTime[], failure, hashes, python, path, paths, runtime, directory,
   input, arguments, process = None, output = "", piece, left, result, status, code,
   expected, dag = Lookup[prepared, "DAG", <||>], available, cleanup, run},
  failure[reason_] := <|"Status" -> "NOT_PROVED", "Method" -> reason,
    "ElapsedTime" -> AbsoluteTime[] - started|>;
  If[!TrueQ[$KernelID === 0] || !(NumericQ[seconds] && TrueQ[0 < seconds < Infinity]) ||
      Lookup[prepared, "Status", None] =!= "PREPARED" || Lookup[dag, "Status", None] =!= "COMPLETE",
    Return[failure["UnsupportedSerialNativeLaunch"]]];
  hashes = completionHENativeRuntimeSources[];
  If[!AssociationQ[hashes], Return[failure["NativeRuntimeUnavailable"]]];
  path = Replace[Environment["PATH"], Except[_String] -> ""];
  paths = Join[FileNameJoin[{#, If[$OperatingSystem === "Windows", "python.exe", "python3"]}] & /@
      Select[StringSplit[path, If[$OperatingSystem === "Windows", ";", ":"]], # =!= "" &],
    If[$OperatingSystem === "Windows", {}, {"/opt/homebrew/bin/python3", "/usr/local/bin/python3", "/usr/bin/python3"}]];
  python = SelectFirst[DeleteDuplicates[paths], FileExistsQ[#] && !DirectoryQ[#] &, ""];
  If[python === "", Return[failure["NativePythonUnavailable"]]];
  runtime = FileNameJoin[{Global`$HEPCATpath, "internal", "proofs", "laurent-proof-runtime.py"}];
  directory = CreateDirectory[FileNameJoin[{$TemporaryDirectory, "hepcat-identity-proof-" <> CreateUUID[]}]];
  input = FileNameJoin[{directory, "input.dag"}]; Export[input, dag["Text"], "Text"];
  expected = prepared["DenominatorRootIndices"];
  available[] := Max[0, seconds - (AbsoluteTime[] - started)];
  arguments = Join[{python, "-I", runtime, input, "--seconds", ToString[N[available[]], InputForm],
      "--evaluation-seconds", ToString[N[Min[90, available[]]], InputForm],
      "--cache-directory", FileNameJoin[{$TemporaryDirectory, "hepcat-native-laurent-cache"}],
      "--artifact-directory", directory}, Flatten[({"--expect-nonzero-root", ToString[#]} &) /@ expected]];
  cleanup[] := If[MatchQ[process, _ProcessObject] && Quiet[Check[ProcessStatus[process], "Finished"]] === "Running",
    Quiet[Check[KillProcess[process], Null]]];
  run[] := Internal`WithLocalSettings[Null,
    process = Quiet[Check[StartProcess[arguments], $Failed]];
    If[!MatchQ[process, _ProcessObject], Return[failure["NativeProcessUnavailable"]]];
    While[Quiet[Check[ProcessStatus[process], "Finished"]] === "Running" && available[] > 0,
      piece = Quiet[Check[ReadString[process, EndOfBuffer], ""]];
      If[StringQ[piece], output = output <> piece];
      If[StringLength[output] > 1000000, Return[failure["NativeOutputLimit"]]];
      Pause[Min[0.05, available[]]]];
    If[Quiet[Check[ProcessStatus[process], "Finished"]] === "Running", Return[failure["NativeTimeConstraint"]]];
    piece = Quiet[Check[ReadString[process, EndOfBuffer], ""]]; If[StringQ[piece], output = output <> piece];
    If[StringLength[output] > 1000000, Return[failure["NativeOutputLimit"]]];
    code = Quiet[Check[ProcessInformation[process, "ExitCode"], Missing["ExitCodeUnavailable"]]];
    If[code =!= 0, Return[failure["NativeProcessFailed"]]];
    result = Quiet[Check[ImportString[output, "RawJSON"], $Failed]];
    If[!AssociationQ[result], Return[failure["IncompleteNativeResult"]]];
    Export[FileNameJoin[{directory, "result.json"}], result, "RawJSON"];
    status = If[completionHENativeRuntimeSources[] === hashes &&
        completionHENativeRuntimeResultQ[result, dag, expected, hashes, directory, input], "PROVED_ZERO", "NOT_PROVED"];
    <|"Status" -> status, "Method" -> "VerifiedNativeExactLaurentRoots",
      "NativeCertificate" -> result, "ArtifactDirectory" -> directory,
      "RequestedTotalSeconds" -> seconds, "ElapsedTime" -> AbsoluteTime[] - started,
      "CompleteCoherentCoefficientCoverage" -> (status === "PROVED_ZERO"),
      "DenominatorFactorsProvedNonzero" -> (status === "PROVED_ZERO"),
      "NumericalKinematicSamples" -> 0, "CoherentSpinSamples" -> 0,
      "InternalOnShellConditions" -> {}|>, cleanup[]];
  CheckAbort[TimeConstrained[run[], Max[0.000001, available[]], cleanup[]; failure["NativeTimeConstraint"]],
    cleanup[]; Abort[]]
];

completionHENativeZeroDirection[expression_, rules_List, model_List, seconds_] := Module[
  {started = AbsoluteTime[], prepared, proof, allowance},
  allowance = If[NumericQ[seconds] && TrueQ[0 < seconds < Infinity], Min[120, seconds], 0];
  If[!TrueQ[$KernelID === 0] || allowance <= 0, Return[<|"Status" -> "NOT_PROVED",
    "Method" -> "SerialNativeBudgetUnavailable"|>]];
  (* The single-null chart spends most of its time constructing polynomial
     roots; the native evaluation is short. Reserve one third of the existing
     total for verification without increasing that total or the family clock. *)
  prepared = completionHEPrepareNativeIdentity[expression, rules,
    Min[30, If[Count[preparationExternalRules[rules], HoldPattern[Mass[_Integer] -> 0]] === 1 ||
        Lookup[completionHEMixedNullAxisChoice[expression, rules], "Status", None] === "AVAILABLE",
      2 allowance/3, allowance/3]]];
  If[Lookup[prepared, "Status", None] =!= "PREPARED", Return[Join[prepared,
    <|"OriginalDirection" -> expression, "NativeProofBudget" -> allowance,
      "ElapsedTime" -> AbsoluteTime[] - started|>]]];
  proof = completionHENativeLaurentRun[prepared, Max[0, allowance - (AbsoluteTime[] - started)]];
  Join[proof, <|"Method" -> If[Lookup[proof, "Status", None] === "PROVED_ZERO",
      Switch[Lookup[prepared, "Method", None],
        "DenseRestSingleNullTypedPolynomialIdentity", "DenseRestSingleNullNativePolynomialIdentity",
        "DenseRestMixedNullTypedPolynomialIdentity", "DenseRestMixedNullNativePolynomialIdentity",
        "DenseRestNullTypedPolynomialIdentity", "DenseRestNullNativePolynomialIdentity",
        _, "DenseRestNullNativeLaurentIdentity"],
      Lookup[proof, "Method", "NativeProofUnfinished"]],
    "OriginalDirection" -> expression,
    "PreparationCertificate" -> Join[KeyDrop[prepared, "DAG"],
      <|"DAG" -> KeyDrop[prepared["DAG"], "Text"]|>],
    "NativeProofBudget" -> allowance, "ElapsedTime" -> AbsoluteTime[] - started|>]
];

(* Remove only directions proved to be ordinary external identities. A failed
   certificate, a deadline, or nonzero local contact freedom is retained. *)
completionHEPruneIdentityFamily[family_, parameters_List, rules_List, model_List, seconds_,
    knownDirections_:Automatic, progress_:None] := Module[
  {started = AbsoluteTime[], directions, certificates = {}, kept = {}, removed = {},
   center, arrays, settings, jobs, deadline, allowance, worker, dispatch, results, resultByIndex,
   completed = 0, proved = 0, executionSettings, observe, zeroIndices, retrySummary,
   retryEntries, retryJobs, retryWorker, retryObserve, retryDispatch, retryResults, left, reduction,
   nativeSummary, nativeJobs, nativeProof, previousCertificate, nativeAttempted = 0, nativeCertified = 0,
   earlyNativeSummary, earlyNativeCertificates = <||>, earlyNativeRecords = {}, earlyNativeJobs,
   earlyNativeStarted, earlyNativeDeadline, earlyNativeBudget, earlyNativeProof, earlyNativeLeft,
   earlyNativeSingleNull, earlyNativeMixedNull, earlyNativePerDirection},
  center = family /. Thread[parameters -> 0];
  If[ListQ[knownDirections] && Length[knownDirections] === Length[parameters] &&
      FreeQ[knownDirections, Alternatives @@ parameters] &&
      SameQ[family, center + If[parameters === {}, 0, parameters.knownDirections]],
    (* Completion already carries these exact affine coefficients. A literal
       reconstruction check avoids expanding the full spinor expressions in
       CoefficientArrays, then repeatedly differentiating them again. *)
    directions = knownDirections,
    arrays = Quiet[Check[CoefficientArrays[family, parameters], $Failed]];
    If[!ListQ[arrays] || Length[arrays] > 2,
      Return[<|"FamilyAmplitude" -> family, "FreeParameters" -> parameters,
        "RemainingBasis" -> (D[family, #] & /@ parameters), "RemovedParameters" -> {},
        "Certificates" -> {}, "AffineFamily" -> False,
        "Diagnostics" -> {"The supplied correction family is not affine; it was retained unchanged."},
        "ElapsedTime" -> (AbsoluteTime[] - started)|>]];
    directions = D[family, #] & /@ parameters];
  settings = If[AssociationQ[$completionParallelSettings], $completionParallelSettings,
    <|"Parallelization" -> False, "MaxKernels" -> Automatic|>];
  jobs = SortBy[Range[Length[parameters]], LeafCount[directions[[#]]] &];
  deadline = If[seconds === Infinity, Infinity, started + Max[0, seconds]];
  allowance = If[seconds === Infinity, 90, Min[90, Max[8, seconds]]];
  (* A dense rest-frame chart with one declared null leg can certify a large
     coherent identity much faster as exact polynomial arithmetic. Try that
     optional backend on the master before spending the worker-proof budget.
     Every unproved coordinate still enters the original proof/fitting paths. *)
  earlyNativeStarted = AbsoluteTime[];
  earlyNativeSingleNull = Count[preparationExternalRules[rules], HoldPattern[Mass[_Integer] -> 0]] === 1;
  earlyNativeMixedNull = TrueQ[$KernelID === 0] && !earlyNativeSingleNull &&
    TrueQ[seconds > 0] && AnyTrue[Take[jobs, UpTo[8]], Function[index,
      With[{choice = completionHEMixedNullAxisChoice[directions[[index]], rules]},
        AssociationQ[choice] && Lookup[choice, "Status", None] === "AVAILABLE"]]];
  earlyNativePerDirection = If[earlyNativeMixedNull, 45, 20];
  earlyNativeBudget = If[seconds === Infinity, If[earlyNativeMixedNull, 90, 30],
    Max[0, Min[If[earlyNativeMixedNull, 90, 30], seconds/3]]];
  earlyNativeDeadline = Min[deadline, earlyNativeStarted + earlyNativeBudget];
  earlyNativeJobs = If[TrueQ[$KernelID === 0] && earlyNativeBudget > 3 &&
      (earlyNativeSingleNull || earlyNativeMixedNull) &&
      Length[preparationExternalRules[rules]] >= 4 &&
      AssociationQ[completionHENativeRuntimeSources[]],
    Take[Select[jobs, 5000 <= LeafCount[directions[[#]]] <= 50000 &],
      UpTo[If[earlyNativeMixedNull, 8, 4]]], {}];
  Do[
    earlyNativeLeft = Max[0, Min[earlyNativePerDirection, earlyNativeDeadline - AbsoluteTime[]]];
    If[earlyNativeLeft <= 3, Break[]];
    If[progress =!= None, progress[<|"Stage" -> "HighEnergy",
      "Phase" -> "Certifying coherent identities with exact polynomial arithmetic",
      "Operation" -> "Early exact identity proof", "Completed" -> Length[earlyNativeRecords],
      "Total" -> Length[earlyNativeJobs], "ProofSecondsAvailable" -> earlyNativeLeft|>]];
    earlyNativeProof = completionHENativeZeroDirection[directions[[index]], rules, model, earlyNativeLeft];
    AppendTo[earlyNativeRecords, Join[<|"Index" -> index|>,
      KeyTake[earlyNativeProof, {"Status", "Method", "ElapsedTime"}]]];
    If[AssociationQ[earlyNativeProof] && Lookup[earlyNativeProof, "Status", None] === "PROVED_ZERO",
      AssociateTo[earlyNativeCertificates, index -> Join[earlyNativeProof,
        <|"ProofScheduling" -> "EarlySerialMasterSingleNull"|>]]],
    {index, earlyNativeJobs}];
  earlyNativeSummary = <|"Attempted" -> Length[earlyNativeRecords],
    "Certified" -> Length[earlyNativeCertificates], "Records" -> earlyNativeRecords,
    "Execution" -> "SerialMasterOnly", "MaximumTotalSeconds" -> earlyNativeBudget,
    "MaximumSecondsPerDirection" -> earlyNativePerDirection,
    "RemainingPortfolioBudgetReserved" -> True,
    "SharedDeadline" -> deadline, "ElapsedTime" -> AbsoluteTime[] - earlyNativeStarted|>;
  jobs = Select[jobs, !KeyExistsQ[earlyNativeCertificates, #] &];
  completed = Length[earlyNativeCertificates]; proved = completed;
  worker = With[{d = directions, p = parameters, r = rules, m = model,
      until = deadline, perDirection = allowance,
      deferPolish = TrueQ[$deferExactTensorSupportPolish]}, Function[index, Module[{left, proof},
    left = If[until === Infinity, perDirection, Max[0, Min[perDirection, until - AbsoluteTime[]]]];
    proof = If[left <= 0, <|"Status" -> "NOT_PROVED", "Method" -> "BoundedFamilyBudget"|>,
      TimeConstrained[Block[{$deferExactTensorSupportPolish = deferPolish},
        completionHEZeroDirection[d[[index]], r, m, left]], left,
        <|"Status" -> "NOT_PROVED", "Method" -> "TimeConstraint"|>]];
    <|"Index" -> index, "Parameter" -> p[[index]], "Certificate" -> proof|>]]];
  (* A short tail can contain the most expensive proofs. Reuse a warm worker
     pool for two or three jobs instead of serially exhausting their shared
     deadline. Automatic does not start a cold pool just for that tail. *)
  executionSettings = If[TrueQ[seconds > 0] && Length[jobs] >= 2,
    If[Length[jobs] < 4 && Lookup[settings, "Parallelization", Automatic] === Automatic,
      Join[settings, <|"WarmOnly" -> True|>], settings],
    Join[settings, <|"Parallelization" -> False|>]];
  observe[result_, index_, total_] := (
    completed++;
    If[AssociationQ[result] && AssociationQ[Lookup[result, "Certificate", None]] &&
        Lookup[result["Certificate"], "Status", None] === "PROVED_ZERO", proved++];
    If[progress =!= None, progress[<|"Stage" -> "HighEnergy",
      "Phase" -> "Proving identity-zero family directions",
      "Operation" -> "Certifying ordinary identities", "Completed" -> completed,
      "Total" -> Length[parameters], "ProvedZero" -> proved,
      "RetainedDirections" -> completed - proved|>]]);
  dispatch = amplitudeParallelMap[worker, jobs, executionSettings, observe];
  results = Lookup[dispatch, "Results", {}];
  resultByIndex = Join[earlyNativeCertificates, Association[Map[Function[result,
    If[AssociationQ[result] && IntegerQ[Lookup[result, "Index", None]] &&
        AssociationQ[Lookup[result, "Certificate", None]],
      result["Index"] -> result["Certificate"], Nothing]], results]]];
  certificates = MapIndexed[Function[{parameter, index}, Join[
    <|"Parameter" -> parameter|>, Lookup[resultByIndex, First[index],
      <|"Status" -> "NOT_PROVED", "Method" -> "ProofWorkerUnavailable"|>]]], parameters];
  kept = Select[Range[Length[parameters]], certificates[[#]]["Status"] =!= "PROVED_ZERO" &];
  (* Retry only after the first batch has established independent identities.
     Exact formal subtraction can expose a much smaller proof problem while
     preserving the original affine coordinates and every unproved direction. *)
  zeroIndices = Select[Range[Length[parameters]], certificates[[#]]["Status"] === "PROVED_ZERO" &];
  retrySummary = <|"Attempted" -> 0, "Certified" -> 0,
    "PrerequisitesFromInitialBatch" -> zeroIndices|>;
  retryEntries = <||>;
  If[zeroIndices =!= {} && kept =!= {} && Length[zeroIndices] <= 128,
    Do[
      left = If[deadline === Infinity, Infinity, deadline - AbsoluteTime[]];
      If[!TrueQ[left > 2], Break[]];
      reduction = completionHECertifiedZeroRemainder[directions[[index]], directions[[zeroIndices]],
        If[left === Infinity, 20, Min[20, left/4]]];
      If[AssociationQ[reduction] && Lookup[reduction, "Status", None] === "REDUCED" &&
          TrueQ[Lookup[reduction, "ExactFormalReconstruction", False]] &&
          TrueQ[Lookup[reduction, "ExactGroupingReconstruction", False]] &&
          ListQ[Lookup[reduction, "KnownZeroCoefficients", None]] &&
          Length[reduction["KnownZeroCoefficients"]] === Length[zeroIndices] &&
          AllTrue[reduction["KnownZeroCoefficients"], MatchQ[#, _Integer | _Rational] &] &&
          ListQ[Lookup[reduction, "UsedKnownZeroPositions", None]] &&
          AllTrue[reduction["UsedKnownZeroPositions"], IntegerQ[#] && 1 <= # <= Length[zeroIndices] &],
        AssociateTo[retryEntries, index -> reduction]],
      {index, kept}]];
  retryJobs = Keys[retryEntries];
  If[retryJobs =!= {},
    completed = 0; proved = 0;
    retryWorker = With[{entries = retryEntries, initial = certificates,
        prerequisites = zeroIndices, p = parameters, r = rules, m = model,
        until = deadline, perDirection = allowance,
        deferPolish = TrueQ[$deferExactTensorSupportPolish]}, Function[index,
      Module[{entry = entries[index], left, proof, usedIndices, dependencies, accepted},
        left = If[until === Infinity, perDirection, Max[0, Min[perDirection, until - AbsoluteTime[]]]];
        proof = If[left <= 0,
          <|"Status" -> "NOT_PROVED", "Method" -> "BoundedFamilyBudget"|>,
          TimeConstrained[Block[{$deferExactTensorSupportPolish = deferPolish},
            completionHEZeroDirection[entry["ReducedInput"], r, m, left]], left,
            <|"Status" -> "NOT_PROVED", "Method" -> "TimeConstraint"|>]];
        usedIndices = prerequisites[[entry["UsedKnownZeroPositions"]]];
        dependencies = (<|"Index" -> #, "Parameter" -> p[[#]],
          "Status" -> initial[[#]]["Status"], "Method" -> Lookup[initial[[#]], "Method", None]|> & /@ usedIndices);
        accepted = TrueQ[entry["ExactFormalReconstruction"]] &&
          TrueQ[entry["ExactGroupingReconstruction"]] &&
          AllTrue[dependencies, #["Status"] === "PROVED_ZERO" &] &&
          Lookup[proof, "Status", None] === "PROVED_ZERO";
        <|"Index" -> index, "Parameter" -> p[[index]],
          "Certificate" -> If[accepted,
            Join[<|"Status" -> "PROVED_ZERO", "Method" -> "CertifiedZeroSpanRemainder",
              "PrerequisiteCertifiedDirections" -> dependencies,
              "ReusedCertificate" -> proof, "OriginalDirectionProof" -> initial[[index]],
              "NumericalKinematicSamples" -> 0, "InternalOnShellConditions" -> {}|>,
              KeyTake[entry, {"ReducedInput", "OriginalLeafCount", "ReducedLeafCount",
                "KnownZeroCoefficients", "UsedKnownZeroPositions", "KnownZeroCount",
                "FormalMonomialCount", "RetainedMonomialCount", "ExactFormalReconstruction",
                "ExactGroupingReconstruction"}]],
            Join[initial[[index]], <|"CertifiedZeroSpanRetry" -> Join[
              KeyDrop[entry, {"ReducedInput"}], <|"PrerequisiteCertifiedDirections" -> dependencies,
                "ReusedCertificate" -> proof, "OriginalDirectionRetained" -> True|>]|>]]|>
      ]]];
    retryObserve[result_, index_, total_] := (
      completed++;
      If[AssociationQ[result] && AssociationQ[Lookup[result, "Certificate", None]] &&
          Lookup[result["Certificate"], "Status", None] === "PROVED_ZERO", proved++];
      If[progress =!= None, progress[<|"Stage" -> "HighEnergy",
        "Phase" -> "Retrying identity proofs with certified identities",
        "Operation" -> "Reusing certified ordinary identities", "Completed" -> completed,
        "Total" -> total, "ProvedZero" -> proved,
        "RetainedDirections" -> completed - proved|>]]);
    executionSettings = If[Length[retryJobs] < 4 &&
        Lookup[settings, "Parallelization", Automatic] === Automatic,
      Join[settings, <|"WarmOnly" -> True|>], settings];
    retryDispatch = amplitudeParallelMap[retryWorker, retryJobs, executionSettings, retryObserve];
    retryResults = Lookup[retryDispatch, "Results", {}];
    Do[If[AssociationQ[result] && IntegerQ[Lookup[result, "Index", None]] &&
        AssociationQ[Lookup[result, "Certificate", None]],
      certificates[[result["Index"]]] = result["Certificate"]], {result, retryResults}];
    retrySummary = <|"Attempted" -> Length[retryJobs],
      "Certified" -> Count[Lookup[Lookup[retryResults, "Certificate", <||>], "Status", None], "PROVED_ZERO"],
      "PrerequisitesFromInitialBatch" -> zeroIndices,
      "Execution" -> Lookup[retryDispatch, "Execution", <||>]|>;
    kept = Select[Range[Length[parameters]], certificates[[#]]["Status"] =!= "PROVED_ZERO" &]];

  (* Remaining exact native retries run on the master after
     both small-memory worker batches. Its compiler, preprocessing, exact
     verification and evaluation share the original family deadline. A failed
     or unavailable backend retains the original coordinate and its history. *)
  nativeSummary = <|"Attempted" -> 0, "Certified" -> 0, "Execution" -> "SerialMasterOnly",
    "MaximumTotalSecondsPerDirection" -> 120, "SharedDeadline" -> deadline|>;
  nativeJobs = Select[kept, 1000 <= LeafCount[directions[[#]]] <= 50000 &&
      Lookup[certificates[[#]], "Method", None] =!= "NonzeroSymbolicExternalChart" &];
  If[TrueQ[$KernelID === 0] && nativeJobs =!= {} && AssociationQ[completionHENativeRuntimeSources[]],
    Do[
      left = If[deadline === Infinity, 120, Max[0, Min[120, deadline - AbsoluteTime[]]]];
      If[left <= 3, Break[]];
      If[progress =!= None, progress[<|"Stage" -> "HighEnergy",
        "Phase" -> "Certifying retained identities exactly",
        "Operation" -> "Serial exact Laurent coefficient proof", "Completed" -> nativeAttempted,
        "Total" -> Length[nativeJobs], "ProofSecondsAvailable" -> left|>]];
      nativeAttempted++; previousCertificate = certificates[[index]];
      nativeProof = completionHENativeZeroDirection[directions[[index]], rules, model, left];
      If[AssociationQ[nativeProof] && Lookup[nativeProof, "Status", None] === "PROVED_ZERO",
        nativeCertified++;
        certificates[[index]] = Join[<|"Parameter" -> parameters[[index]],
          "OriginalDirectionProof" -> previousCertificate|>, nativeProof],
        certificates[[index]] = Join[previousCertificate,
          <|"NativeLaurentRetry" -> nativeProof, "OriginalDirectionRetained" -> True|>]],
      {index, SortBy[nativeJobs, LeafCount[directions[[#]]] &]}]];
  nativeSummary = Join[nativeSummary, <|"Attempted" -> nativeAttempted, "Certified" -> nativeCertified|>];
  kept = Select[Range[Length[parameters]], certificates[[#]]["Status"] =!= "PROVED_ZERO" &];
  removed = parameters[[Complement[Range[Length[parameters]], kept]]];
  (* Removing a certified zero derivative only fixes that affine coordinate.
     Keep the original factored source expression. Rebuilding the family from
     all derivatives can duplicate every shared source once per free variable. *)
  <|"FamilyAmplitude" -> If[removed === {},family,family /. Thread[removed -> 0]],
    "FreeParameters" -> parameters[[kept]], "RemainingBasis" -> directions[[kept]],
    "RemovedParameters" -> removed, "Certificates" -> certificates, "AffineFamily" -> True,
    "FamilyRepresentationCertificate" -> <|"Method" -> "OriginalAffineExpressionWithCertifiedZeroCoordinatesRemoved",
      "OriginalAffineFactoringPreserved" -> True,"RemovedCoordinateRules" -> Thread[removed -> 0],
      "RemovedCertificatePositions" -> Complement[Range[Length[parameters]],kept],
      "OnlyCertifiedZeroDirectionsRemoved" -> True|>,
    "Execution" -> Lookup[dispatch, "Execution", <||>],
    "CertifiedZeroSpanRetry" -> retrySummary, "NativeLaurentRetry" -> nativeSummary,
    "EarlyNativeIdentityProofs" -> earlyNativeSummary,
    "ElapsedTime" -> (AbsoluteTime[] - started)|>
];

(* Proof effort depends on the size of the affine directions as well as their
   count. A small family can contain one large identity; dividing a fixed short
   allowance between chart alternatives can otherwise time out every proof.
   This allocates time only. Certificates and all acceptance tests are unchanged. *)
completionHEIdentityProofBudget[family_, parameters_List, directions_, seconds_] := Module[
  {count = Length[parameters], largest, baseline, work, allocated},
  largest = If[ListQ[directions] && Length[directions] === count,
    Max[Prepend[LeafCount /@ directions, 0]], LeafCount[family]];
  baseline = Max[45, 10 count];
  work = 15 Ceiling[largest/2500];
  allocated = If[count === 0, 0, Min[Max[baseline, work], 3 seconds/4]];
  <|"DirectionCount" -> count, "LargestDirectionLeafCount" -> largest,
    "BaselineSeconds" -> baseline, "ComplexitySeconds" -> work,
    "StageTimeConstraint" -> seconds, "AllocatedSeconds" -> allocated|>
];

(* A complete projected source union may exceed a lightweight initial cap.
   Reuse it only under the public Automatic ceiling, after exact formal
   dependency removal. No sampled rank or discarded physical direction enters. *)
(* A source coordinate can contain hundreds of ordinary mass partners. Reduce
   complete groups before fitting it, rather than promoting its expanded terms
   to independent unknowns. Group keys preserve every inverse propagator and
   every non-mass coupling. Only declared EXTERNAL masses are omitted from the
   key; they are never omitted from the expression passed to the reducer. *)
completionHEOrdinarySourceGroupKey[term_, externalRules_List] := Module[
  {factors, propagators, scalar, masses, spectator, pieces},
  factors = If[Head[term] === Times, List @@ term, {term}];
  propagators = Times @@ Select[factors, MatchQ[#, Power[_PropDen, _Integer?Negative]] &];
  scalar = Times @@ Select[factors, rspScalarQ[#] && FreeQ[#, _PropDen] &];
  masses = DeleteCases[DeleteDuplicates[Last /@ preparationExternalRules[externalRules]], _?NumberQ];
  spectator = If[masses === {}, scalar, scalar /. Thread[masses -> 1]];
  pieces = If[Head[spectator] === Times, List @@ spectator, {spectator}];
  {propagators, Times @@ DeleteCases[pieces, _?NumberQ]}
];

completionHEOrdinarySourceColumn[expression_, rules_List, seconds_] := Module[
  {external = preparationExternalRules[rules], started = AbsoluteTime[], expanded, terms,
   groups, sums, current, candidate = expression, completed = 0, replay = False,
   outcome, remaining, count = 0, originalLeaves = LeafCount[expression], report, acceptedGroups = {}},
  remaining[] := Max[0, seconds - (AbsoluteTime[] - started)];
  report[] := <|"Expression" -> candidate,
    "Status" -> If[candidate === expression, "UNCHANGED", "IMPROVED"],
    "OriginalLeaves" -> originalLeaves, "ReducedLeaves" -> LeafCount[candidate],
    "Groups" -> count, "CompletedGroups" -> completed,
    "ExactFormalRegrouping" -> replay,
    "ExternalMassRules" -> external, "InternalOnShellConditions" -> {},
    "CoefficientCoordinatesSplit" -> False,
    "GroupReductions" -> If[count > 0 && Length[acceptedGroups] === count,
      DeleteCases[MapIndexed[Function[{value,index}, If[value === sums[[First[index]]], Nothing,
        <|"OriginalGroup" -> sums[[First[index]]], "ReducedGroup" -> value,
          "Transformation" -> "preparationSpinorProducts",
          "ExternalMassRules" -> external, "InternalOnShellConditions" -> {}|>]],acceptedGroups],Nothing], {}],
    "Reduction" -> "OrdinarySpinorProductsAndDeclaredExternalMassPartners",
    "TimedOut" -> TrueQ[remaining[] <= 0], "ElapsedTime" -> AbsoluteTime[] - started|>;
  If[!TrueQ[seconds > 0] || external === {} ||
      !preparationMassRulesConsistentQ[external] || !residueFiniteQ[expression] ||
      originalLeaves > 200000 || rspSandwichExpansionCount[expression] > 4096,
    Return[report[]]];
  outcome = TimeConstrained[MemoryConstrained[
    expanded = preparationProtectedDenominators[expression, Expand];
    terms = If[Head[expanded] === Plus, List @@ expanded, If[expanded === 0, {}, {expanded}]];
    If[Length[terms] <= 4096,
      groups = Values[GroupBy[terms, completionHEOrdinarySourceGroupKey[#, external] &]];
      count = Length[groups];
      If[count <= 64,
        sums = Total /@ groups;
        replay = TrueQ[Expand[expanded - Total[sums]] === 0];
        If[replay,
          current = sums;
          Do[If[remaining[] <= 0, Break[]];
            If[rspSandwichExpansionCount[sums[[i]]] <= 256,
              current[[i]] = TimeConstrained[MemoryConstrained[
                preparationSpinorProducts[sums[[i]], external], 268435456, sums[[i]]],
                Min[3, Max[0.000001, remaining[]]], sums[[i]]];
              If[!residueFiniteQ[current[[i]]], current[[i]] = sums[[i]]]];
            completed++;
            With[{proposal = Total[current]},
              If[residueFiniteQ[proposal] && LeafCount[proposal] < LeafCount[candidate],
                candidate = proposal; acceptedGroups = current]], {i, count}]]]];
    True, 805306368, False], seconds, False];
  report[]
];

completionHEOrdinarySourceEligibleQ[basis_List, metrics_Association] :=
  Length[basis] > 0 && Lookup[metrics, "CoherentComponents", 1] >= 27 &&
    AnyTrue[Values[Lookup[metrics, "CoherentSpinDegrees", <||>]], # >= 2 &] &&
    Total[LeafCount /@ basis] >= 100000 && Max[LeafCount /@ basis] >= 2500;

completionHEOrdinaryProofEligibleQ[expression_, rules_List, weights_List, coherentWork_] := Module[
  {external = Sort[Cases[rules, HoldPattern[Mass[leg_Integer] -> _] :> leg]], massiveDegrees},
  If[Length[external] =!= Length[weights] || !TrueQ[coherentWork >= 27] ||
      LeafCount[expression] < 1000, Return[False]];
  massiveDegrees = MapThread[If[TrueQ[(Mass[#1] /. rules) === 0], 0, #2] &,
    {external, weights}];
  AnyTrue[massiveDegrees, TrueQ[# >= 2] &]
];

completionHEOrdinarySourceColumns[basis_List, rules_List, seconds_, callback_: None] := Module[
  {started = AbsoluteTime[], result = basis, leaves = LeafCount /@ basis,
   indices, records = {}, item, remaining, count = 0},
  remaining[] := Max[0, seconds - (AbsoluteTime[] - started)];
  indices = SortBy[Select[Range[Length[basis]], leaves[[#]] >= 2500 &], -leaves[[#]] &];
  Do[If[remaining[] <= 0, Break[]]; count++;
    If[callback =!= None, callback[<|"Phase" -> "Normalizing retained source columns",
      "Current" -> count, "Total" -> Length[indices], "Column" -> index|>]];
    item = completionHEOrdinarySourceColumn[basis[[index]], rules, Min[8, remaining[]]];
    If[AssociationQ[item] && residueFiniteQ[item["Expression"]], result[[index]] = item["Expression"]];
    AppendTo[records, Join[<|"Column" -> index|>, KeyDrop[item, "Expression"]]], {index, indices}];
  <|"Basis" -> result, "OriginalBasis" -> basis,
    "Status" -> If[result === basis, "UNCHANGED", "IMPROVED"],
    "OriginalColumns" -> Length[basis], "RetainedColumns" -> Length[result],
    "OriginalLeaves" -> Total[leaves], "ReducedLeaves" -> Total[LeafCount /@ result],
    "ColumnRecords" -> records, "ColumnCoordinatesPreserved" -> True,
    "ExpandedTermsAssignedIndependentCoefficients" -> False,
    "InternalOnShellConditions" -> {}, "Fallback" -> "OriginalColumnOnGuardOrTimeout",
    "ElapsedTime" -> AbsoluteTime[] - started|>
];

completionHEMaterializedBasisAdmission[basis_List,inherited_List,limit_Integer,ceiling_,seconds_] := Module[
  {reduced=basis,admission,before=Length[basis]},
  If[IntegerQ[ceiling] && Length[basis]+Length[inherited]>limit && TrueQ[seconds>0],
    reduced=completionIndependentBasis[basis,seconds]];
  admission=completionMaterializedBasisCap[Join[inherited,reduced],Automatic,limit,ceiling];
  Join[admission,<|"Basis"->reduced,"OriginalNewDirections"->before,
    "ProjectedNewDirections"->Length[reduced],"InheritedDirections"->Length[inherited],
    "NumericalKinematicsUsed"->False,"TruncatedDirections"->0,
    "BasisReduction"->"ExactFormalLinearDependenceOnly"|>]
];

(* Classify exact scalar-arithmetic redundancies before the more expensive
   ordinary-identity portfolio. Retain the ORIGINAL solved family and each
   actual derivative; differentiating an already fixed final point is not a
   certificate for a discarded coordinate. *)
completionHEExactDerivativeClassification[family_, parameters_List] := Module[
  {kept={},removed={},certificates={},derivative,reduced},
  Do[
    derivative=D[family,parameter];
    reduced=Quiet[Check[Cancel[Together[derivative]],$Failed]];
    If[TrueQ[reduced===0],AppendTo[removed,parameter];
      AppendTo[certificates,<|"Status"->"PROVED_ZERO","Parameter"->parameter,
        "Method"->"ExactRationalDerivativeZero","DerivativeWitness"->derivative,
        "ExactRationalDerivative"->0,"NumericalParameterAssignments"->{},
        "NumericalKinematicSamples"->0,"InternalOnShellConditions"->{}|>],
      AppendTo[kept,parameter]],{parameter,parameters}];
  Join[<|"Method"->"ExactRationalAffineDerivativeClassification",
    "OriginalFreeParameters"->parameters,"FreeParameters"->kept,
    "RemovedParameters"->removed,"Certificates"->certificates,
    "InternalOnShellConditions"->{},"NumericalParameterAssignments"->{}|>,
    If[removed==={},<||>,<|"OriginalSolvedFamilyWitness"->family|>]]
];

completionHighEnergyWork[input_, channels_List, model_List, settings_Association,
    normalized_Association, retain_] := Module[
  {original = normalized["Expression"], metadata, before, basis, inheritedBasis,
   inheritedParameters, unknowns, trial, extra, bound, physical, energy,
   physicalSolution, physicalCandidate, spurious, reference, groups,
   equations, solution, family, free, candidate, exactDerivativeClassification,
   validation, validations, familyValidations = {}, familyValid = True,
   fitSamples = settings["Samples"], ruleSets, status, diagnostics = {}, callback = settings["ProgressFunction"],
   enabled = settings["ProgressReporting"], report, exchangePlan, familyReduction,
   retainedProofs, proofReasons, establishedNonzero, proofSummary, familyProofBudget,
   sourceRemainders, automaticBasis = Missing["ExplicitBasis"], proofModel,
   sequentialReduction, sequentialReductions = <||>, retainCurrentFamily, reciprocalFirst = False,
   beforeChecks, reciprocalData, basisAdmission, effectiveLimit=settings["MaxCorrectionTerms"],
   sourceNormalization, sourceMetrics},
  report = <|"Stage" -> "HighEnergy", "Status" -> "UNRESOLVED",
    "Amplitude" -> original, "OriginalExpression" -> Lookup[normalized, "OriginalExpression", original],
    "ExternalMassRules" -> normalized["ExternalMassRules"],
    "FamilyAmplitude" -> original, "FreeParameters" -> {}, "CorrectionBasis" -> {}, "RemainingBasis" -> {},
    "Correction" -> 0, "Diagnostics" -> {}, "Scope" -> "BoundedSampledExactLinearCompletion"|>;
  exchangePlan = completionInheritedExchangePlan[normalized, model];
  If[FailureQ[exchangePlan], Return[Join[report, <|"Diagnostics" -> {exchangePlan}|>]]];
  If[Lookup[exchangePlan, "Order", 1] > 1,
    report = Join[report, <|"ExchangeSymmetry" -> KeyDrop[exchangePlan, "Permutations"],
      "BoseSymmetry" -> completionExchangeDetails[exchangePlan, "Boson"],
      "FermionSymmetry" -> completionExchangeDetails[exchangePlan, "Fermion"]|>]];
  retain[report];
  retainCurrentFamily[] := (
    report = completionHEFamilyReport[report, trial, unknowns, original];
    retain[report]);
  proofModel = Lookup[settings, "IdentityProofModel", model];
  metadata = completionHEMetadata[normalized];
  If[!AssociationQ[metadata], Return[Join[report, <|"Diagnostics" -> {
    "Complete external mass metadata is required for high-energy completion."}|>]]];
  bound = Replace[settings["HighEnergyBound"], Automatic -> (4 - Length[metadata["ExternalLegs"]])];
  inheritedParameters = Lookup[normalized, "FreeParameters", {}];
  inheritedBasis = Lookup[normalized, "RemainingBasis", {}];
  trial = Lookup[normalized, "FamilyAmplitude", original];
  If[inheritedParameters =!= {} && !TrueQ[$completionHighEnergyPointFirst],
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
      "Phase" -> "Proving identity-zero family directions", "Terms" -> Length[inheritedParameters]|>];
    familyProofBudget = completionHEIdentityProofBudget[trial, inheritedParameters,
      inheritedBasis, Lookup[settings,"IdentityProofStageTimeConstraint",settings["TimeConstraint"]]];
    report = Join[report, <|"FamilyIdentityProofBudget" -> familyProofBudget|>]; retain[report];
    familyReduction = completionHEPruneIdentityFamily[trial, inheritedParameters,
      normalized["ExternalMassRules"], proofModel, familyProofBudget["AllocatedSeconds"], inheritedBasis,
      Function[event, completionProgress[callback, enabled, event]]];
    If[!TrueQ[familyReduction["AffineFamily"]], Return[Join[report,
      <|"FamilyIdentityReduction" -> familyReduction,
        "Diagnostics" -> familyReduction["Diagnostics"]|>]]];
    trial = familyReduction["FamilyAmplitude"];
    inheritedParameters = familyReduction["FreeParameters"];
    inheritedBasis = familyReduction["RemainingBasis"];
    report = Join[report, <|"FamilyIdentityReduction" -> familyReduction,
      "FamilyAmplitude" -> trial, "FreeParameters" -> inheritedParameters,
      "RemainingBasis" -> inheritedBasis|>]; retain[report]];
  completionProgress[callback, enabled, <|"Stage" -> "HighEnergy", "Phase" -> "InitialChecks"|>];
  before = If[completionHEReusableInitialReportQ[Lookup[settings,"BeforeReport",None]],settings["BeforeReport"],
    completionHECheck[original, normalized, channels, model, settings, settings["RandomSeed"]]];
  report = Join[report, <|"BeforeReport" -> before, "ExpectedPower" -> bound|>];
  retain[report];
  If[completionHEAllPassQ[before] && inheritedParameters === {},
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy", "Phase" -> "IndependentValidation"|>];
    ruleSets = completionValidationRuleSets[model, settings["ParameterRules"],
      settings["ValidationParameterRules"]];
    If[!ListQ[ruleSets] || ruleSets === {}, Return[Join[report,
      <|"Diagnostics" -> {"Independent validation parameter assignments are invalid or unavailable."}|>]]];
    validations = MapIndexed[Function[{parameterRules, index},
      <|"ParameterRules" -> parameterRules, "Report" -> completionHECheck[original,
        normalized, channels, model, Join[settings, <|"ParameterRules" -> parameterRules|>],
        settings["RandomSeed"] + 104729 First[index]]|>], ruleSets];
    Return[Join[report, <|"Status" -> If[
        AllTrue[validations, completionHEAllPassQ[#["Report"]] &], "COMPLETE", "UNRESOLVED"],
      "AfterReport" -> First[validations]["Report"], "ValidationReports" -> validations,
      "ValidationParameterRules" -> ruleSets,
      "Diagnostics" -> {"The supplied amplitude was not changed and was independently rechecked.",
        If[Length[ruleSets] === 1, "Only the supplied parameter assignment was validated; no generic parameter-independence claim is made.",
          "Additional supplied or theory-safe parameter assignments were also checked."]}|>]]];
  unknowns = inheritedParameters;
  basis = settings["CorrectionBasis"];
  If[basis === Automatic,
    beforeChecks = Lookup[before, "Checks", {}];
    If[Length[metadata["ExternalLegs"]] === 4 &&
        completionPolePreference[settings["PolePreference"], input] === "AllSpurious" &&
        AnyTrue[beforeChecks, Lookup[#, "Type", None] === "Spurious" && Lookup[#, "Status", None] === "FAIL" &] &&
        AllTrue[Select[beforeChecks, !MemberQ[{"Spurious", "HighEnergy"}, Lookup[#, "Type", None]] &],
          Lookup[#, "Status", None] === "PASS" &],
      reciprocalData = constructReciprocalPoleData[normalized["ExternalMassRules"], channels, model];
      reciprocalFirst = AssociationQ[reciprocalData]];
    sourceRemainders = If[reciprocalFirst,
      <|"Basis" -> {}, "Sources" -> {}, "SourceRecords" -> 0,
        "Admission" -> "The certified reciprocal-pole repair is tried first because the physical residues and reference check already pass."|>,
      completionHESourceRemainders[Join[normalized,
        <|"FamilyAmplitude" -> trial, "FreeParameters" -> inheritedParameters|>],
        Min[8, settings["TimeConstraint"]/15], model,
        completionPolePreference[settings["PolePreference"], input]]];
    automaticBasis = If[inheritedParameters =!= {}, {},
      completionHEAutomaticBasis[original, metadata, settings, bound]];
    basis = DeleteDuplicates[Join[sourceRemainders["Basis"], automaticBasis]];
    report = Join[report, <|"PreparationRemainderCorrections" -> sourceRemainders|>]];
  If[Lookup[exchangePlan, "Order", 1] > 1 && basis =!= {},
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
      "Phase" -> "Preserving identical-particle exchange symmetry", "Terms" -> Length[basis]|>]];
  basis = completionExchangeBasis[basis, exchangePlan, normalized["ExternalMassRules"]];
  basisAdmission=completionHEMaterializedBasisAdmission[basis,inheritedBasis,effectiveLimit,
    Lookup[settings,"AutomaticCorrectionTermCeiling",None],Min[5,settings["TimeConstraint"]/20]];
  basis=basisAdmission["Basis"];effectiveLimit=basisAdmission["EffectiveMaxCorrectionTerms"];
  If[settings["CorrectionBasis"] === Automatic && basis =!= {},
    sourceMetrics = amplitudeResourceMetrics[<|"Amplitude" -> Total[basis],
      "ExternalMassRules" -> normalized["ExternalMassRules"]|>];
    If[completionHEOrdinarySourceEligibleQ[basis, sourceMetrics],
      sourceNormalization = completionHEOrdinarySourceColumns[basis,
        normalized["ExternalMassRules"], Min[120, settings["TimeConstraint"]/5],
        Function[event, completionProgress[callback, enabled, Join[<|"Stage" -> "HighEnergy"|>, event]]]];
      basis = sourceNormalization["Basis"];
      report = Join[report, <|"OrdinarySourceNormalization" -> KeyDrop[sourceNormalization, "Basis"]|>];
      retain[report]]];
  report=Join[report,<|"EffectiveMaxCorrectionTerms"->effectiveLimit,
    "BasisAdmission"->KeyDrop[basisAdmission,"Basis"],
    "CapChanges"->(basisAdmission["CapChanges"] /. "ReuseCompleteExchangeUnion"->"ReuseCompleteHighEnergyUnion")|>];
  If[basisAdmission["CapChanges"] =!= {},completionProgress[callback,enabled,
    <|"Stage"->"HighEnergy","Phase"->"Reusing complete high-energy correction space",
      "Terms"->Length[basis]+Length[inheritedParameters],"MaxCorrectionTerms"->effectiveLimit|>]];
  If[Length[basis] + Length[inheritedParameters] > effectiveLimit &&
      ListQ[automaticBasis] && Length[automaticBasis] + Length[inheritedParameters] <= effectiveLimit,
    basis = completionExchangeBasis[automaticBasis, exchangePlan, normalized["ExternalMassRules"]];
    report = Join[report, <|"PreparationRemainderCorrections" -> Join[sourceRemainders,
      <|"Admission" -> "Source proposal exceeds MaxCorrectionTerms; the established automatic space is retained."|>]|>]];
  If[Length[basis] + Length[inheritedParameters] > effectiveLimit,
    Return[Join[report, <|"Diagnostics" -> {"The correction family exceeds MaxCorrectionTerms; no directions were silently discarded."}|>]]];
  If[basis =!= {}, extra = Table[Unique["highEnergyCorrection"], {Length[basis]}];
    unknowns = Join[unknowns, extra]; trial = trial + Total[MapThread[Times, {extra, basis}]]];
  report = Join[report, <|"CorrectionBasis" -> Join[inheritedBasis, basis],
    "FamilyAmplitude" -> trial, "FreeParameters" -> unknowns|>];
  If[TrueQ[$completionHighEnergyPointFirst], report = Join[report, <|
    "PointFirstOriginalFamilyWitness" -> trial,
    "PointFirstOriginalCorrectionCoordinates" -> unknowns|>]];
  retain[report];
  If[unknowns === {}, Return[Join[report, <|"Diagnostics" -> {
    "The checks fail, but no supported residue-preserving correction directions are available. Supply a bounded CorrectionBasis or factorization-completion details with RemainingBasis; no independent contact operators were invented."}|>]]];
  If[TrueQ[$completionAutomaticFitSamples],
    fitSamples = amplitudeAutomaticFitSamples[amplitudeResourceMetrics[
      normalized, normalized, Automatic, Length[unknowns]]]];
  report = Join[report, <|"FitSamples" -> fitSamples|>];
  ruleSets = completionValidationRuleSets[model, settings["ParameterRules"],
    settings["ValidationParameterRules"]];
  If[!ListQ[ruleSets] || ruleSets === {}, Return[Join[report,
    <|"Diagnostics" -> {"Model-consistent fit parameter assignments are unavailable."}|>]]];
  completionProgress[callback, enabled, <|"Stage" -> "HighEnergy", "Phase" -> "PhysicalConstraints"|>];
  physical = completionParameterConstraintSets[Function[{parameterRules, fitSeed},
    completionResidueConstraints[trial, unknowns, normalized, fitSamples,
      fitSeed, parameterRules, settings["TimeConstraint"], callback, enabled]],
    ruleSets, settings["RandomSeed"]];
  If[AssociationQ[physical] && Lookup[physical, "Status"] === "COMPLETE",
    physicalSolution = completionSolveLinear[physical["Equations"], unknowns];
    report = Join[report, <|"ConstraintData" -> <|"Physical" -> physical|>,
      "PhysicalLinearSystem" -> physicalSolution|>];
    retain[report];
    If[!MemberQ[{"COMPLETE", "UNDERDETERMINED"}, Lookup[physicalSolution, "Status"]],
      Return[Join[report, <|"Diagnostics" -> Join[{
        "No correction in this bounded family establishes the required physical residues; later conditions cannot repair an inconsistent physical system."},
        Lookup[physicalSolution, "Diagnostics", {}]]|>]]];
    If[physicalSolution["FreeParameters"] =!= {} &&
        Length[physicalSolution["FreeParameters"]] < Length[unknowns],
      (* Eliminate the coefficients already fixed by every physical cut before
         expanding the high-energy/coherent-spin tensor. Keeping all original
         columns here repeats that expensive work for dependent coordinates. *)
      trial = trial /. physicalSolution["SolutionRules"];
      report = Join[report, <|"PhysicalReduction" -> <|
        "OriginalUnknownCount" -> Length[unknowns],
        "RemainingUnknownCount" -> Length[physicalSolution["FreeParameters"]],
        "SolutionRules" -> physicalSolution["SolutionRules"],
        "AllOriginalPhysicalEquationsRetained" -> True|>|>];
      unknowns = physicalSolution["FreeParameters"];
      physical = Join[physical, <|"UnreducedEquations" -> physical["Equations"],
        "Equations" -> (physical["Equations"] /. physicalSolution["SolutionRules"])|>];
      retainCurrentFamily[],
    If[physicalSolution["FreeParameters"] === {},
      physicalCandidate = trial /. physicalSolution["SolutionRules"];
      report = Join[report, <|"Amplitude" -> physicalCandidate,
        "FamilyAmplitude" -> physicalCandidate, "FreeParameters" -> {}, "RemainingBasis" -> {},
        "Correction" -> physicalCandidate - original,
        "SolutionRules" -> physicalSolution["SolutionRules"]|>];
      retain[report];
      If[residueExactZero[physicalCandidate - original] && !completionHEAllPassQ[before],
        completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
          "Phase" -> "Finished", "Status" -> "UNRESOLVED"|>];
        Return[Join[report, <|"Diagnostics" -> {
          "The fitted physical residues uniquely fix every available correction coefficient, leaving the input amplitude unchanged. No nonzero residue-preserving correction is available in this bounded family.",
          "The existing complete-check report is retained; its failed or unresolved checks were not repaired. A larger justified correction space is required."}|>]]];
      physical = Join[physical, <|"Equations" ->
        (physical["Equations"] /. physicalSolution["SolutionRules"])|>];
      trial = physicalCandidate; unknowns = {}; retainCurrentFamily[]]]];
  If[!TrueQ[$completionHighEnergyPointFirst] && Length[unknowns] > 1 &&
      AssociationQ[Lookup[report, "PhysicalReduction", None]],
    familyReduction = completionHEPruneIdentityFamily[trial, unknowns,
      normalized["ExternalMassRules"], proofModel, Min[20, settings["TimeConstraint"]/8],
      Automatic, Function[event, completionProgress[callback, enabled, event]]];
    If[TrueQ[familyReduction["AffineFamily"]],
      trial = familyReduction["FamilyAmplitude"]; unknowns = familyReduction["FreeParameters"];
      physical = completionSubstituteConstraintFamily[physical,
        Thread[Lookup[familyReduction, "RemovedParameters", {}] -> 0]];
      report = Join[report, <|"PhysicalFamilyIdentityReduction" -> familyReduction|>]; retainCurrentFamily[]]];
  energy = completionHEEnergyConstraintSets[trial, unknowns, metadata, fitSamples,
    settings["RandomSeed"], ruleSets, bound, callback, enabled];
  If[TrueQ[$completionHighEnergyPointFirst] &&
      Lookup[physical, "Status", None] === "COMPLETE" && AssociationQ[energy] &&
      TrueQ[Lookup[energy, "PointReady", False]],
    family = energy["FamilyAmplitude"]; free = energy["FreeParameters"];
    candidate = family /. Thread[free -> 0];
    report = Join[report, <|"Status" -> "UNRESOLVED", "PointReady" -> True,
      "Amplitude" -> candidate, "FamilyAmplitude" -> family, "FreeParameters" -> free,
      "RemainingBasis" -> (D[family, #] & /@ free),
      "SolutionRules" -> Lookup[energy, "SolutionRules", {}],
      "Correction" -> candidate - original,
      "ConstraintData" -> <|"Physical" -> physical, "HighEnergy" -> energy,
        "Spurious" -> Missing["NotFitForPointProposal"],
        "Reference" -> Missing["NotFitForPointProposal"]|>,
      "PointReadyCheckpoint" -> Join[energy["PointReadyCheckpoint"], <|
        "Method" -> "FirstCompleteEnergyChartPointProposal",
        "AllFitGroupsComplete" -> False,
        "CompletedFitGroups" -> {"Physical"}, "PartiallyVisitedFitGroups" -> {"HighEnergy"},
        "UnvisitedFitGroups" -> {"Spurious", "Reference"},
        "FamilyUniquenessEstablished" -> False, "IndependentPointValidationPerformed" -> False,
        "IndependentFamilyValidationPerformed" -> False, "BenchmarkUsedForConstruction" -> False,
        "AllUnclassifiedAffineCoordinatesRetained" -> True,
        "OriginalCorrectionCoordinates" -> Lookup[report,
          "PointFirstOriginalCorrectionCoordinates", unknowns],
        "OriginalFamilyWitness" -> Lookup[report, "PointFirstOriginalFamilyWitness", trial],
        "PhysicalSolutionRules" -> Lookup[Lookup[report, "PhysicalLinearSystem", <||>],
          "SolutionRules", {}],
        "ReachedEnergySolutionRules" -> Lookup[energy, "SolutionRules", {}],
        "IdentityClassificationDeferred" -> {"Initial", "PostPhysical", "SolvedFamily"}|>],
      "Diagnostics" -> {"One complete energy chart supplied a certified affine restriction. Its zero-coordinate point is a proposal for ordinary final preparation and every normal independent check by the constructor. Unvisited fit charts and groups are not claimed complete. The full unclassified family is retained; no complete amplitude is claimed by this child checkpoint."}|>];
    retain[report];
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy",
      "Phase" -> "Fitted candidate ready for independent validation",
      "Status" -> "UNRESOLVED", "RemainingCoordinates" -> Length[free]|>];
    Return[report]];
  If[AssociationQ[energy] && Lookup[energy, "Status", None] === "INCONSISTENT",
    report = Join[report, <|"ConstraintData" -> <|"Physical" -> physical, "HighEnergy" -> energy|>,
      "HighEnergyInconsistencyCertificate" -> Lookup[energy, "InconsistencyCertificate", <||>]|>];
    retain[report];
    Return[Join[report, <|"Diagnostics" -> {
      "The reached exact high-energy equations contradict the current bounded source family. Unvisited charts cannot repair this certified inconsistency; no complete amplitude is claimed."}|>]]];
  sequentialReduction = completionReduceConstraintFamily[trial, unknowns, energy];
  If[TrueQ[sequentialReduction["Reduced"]],
    trial = sequentialReduction["FamilyAmplitude"]; unknowns = sequentialReduction["FreeParameters"];
    energy = sequentialReduction["ConstraintData"];
    physical = completionSubstituteConstraintFamily[physical,
      sequentialReduction["LinearSystem"]["SolutionRules"]];
    AssociateTo[sequentialReductions, "HighEnergy" -> sequentialReduction["LinearSystem"]];
    retainCurrentFamily[]];
  spurious = completionParameterConstraintSets[Function[{parameterRules, fitSeed},
    completionHESpuriousConstraints[trial, unknowns, normalized, metadata,
      fitSamples, fitSeed, parameterRules, callback, enabled,
      settings["TimeConstraint"]]], ruleSets, settings["RandomSeed"]];
  sequentialReduction = completionReduceConstraintFamily[trial, unknowns, spurious];
  If[TrueQ[sequentialReduction["Reduced"]],
    trial = sequentialReduction["FamilyAmplitude"]; unknowns = sequentialReduction["FreeParameters"];
    spurious = sequentialReduction["ConstraintData"];
    physical = completionSubstituteConstraintFamily[physical,
      sequentialReduction["LinearSystem"]["SolutionRules"]];
    energy = completionSubstituteConstraintFamily[energy,
      sequentialReduction["LinearSystem"]["SolutionRules"]];
    AssociateTo[sequentialReductions, "Spurious" -> sequentialReduction["LinearSystem"]];
    retainCurrentFamily[]];
  reference = completionParameterConstraintSets[Function[{parameterRules, fitSeed},
    completionHEReferenceConstraints[trial, unknowns, normalized, metadata,
      fitSamples, fitSeed, parameterRules, callback, enabled]], ruleSets, settings["RandomSeed"]];
  groups = <|"Physical" -> physical, "HighEnergy" -> energy,
    "Spurious" -> spurious, "Reference" -> reference|>;
  report = Join[report, <|"ConstraintData" -> groups,
    "SequentialConstraintReductions" -> sequentialReductions|>];
  retain[report];
  If[AnyTrue[Values[groups], !AssociationQ[#] || Lookup[#, "Status"] =!= "COMPLETE" &],
    Return[Join[report, <|"Diagnostics" -> Join[{
      "The supported exact constraint set could not be completed; the input amplitude was retained."},
      Flatten[Lookup[Values[groups], "Diagnostics", {}]]]|>]]];
  equations = Flatten[Lookup[Values[groups], "Equations", {}]];
  completionProgress[callback, enabled, <|"Stage" -> "HighEnergy", "Phase" -> "Solve",
    "EquationCount" -> Length[equations], "UnknownCount" -> Length[unknowns]|>];
  solution = completionSolveLinear[equations, unknowns];
  report = Join[report, <|"LinearSystem" -> solution|>];
  retain[report];
  If[!MemberQ[{"COMPLETE", "UNDERDETERMINED"}, Lookup[solution, "Status"]],
    Return[Join[report, <|"Diagnostics" -> Join[{
      "No supported simultaneous correction was established within this bounded family."},
      Lookup[solution, "Diagnostics", {}]]|>]]];
  family = trial /. solution["SolutionRules"];
  exactDerivativeClassification=completionHEExactDerivativeClassification[
    family,Lookup[solution,"FreeParameters",{}]];
  free=exactDerivativeClassification["FreeParameters"];
  If[exactDerivativeClassification["RemovedParameters"]=!={},
    exactDerivativeClassification=Join[exactDerivativeClassification,<|
      "OriginalTrialWitness"->trial,"OriginalCoordinates"->unknowns,
      "SolutionRules"->solution["SolutionRules"]|>];
    family=family/.Thread[exactDerivativeClassification["RemovedParameters"]->0];
    report=Join[report,<|"ExactDerivativeZeroClassification"->exactDerivativeClassification|>]];
  If[free =!= {},
    familyReduction = completionHEPruneIdentityFamily[family, free,
      normalized["ExternalMassRules"], proofModel, Min[Max[30, 10 Length[free]], settings["TimeConstraint"]/2],
      Automatic, Function[event, completionProgress[callback, enabled, event]]];
    family = familyReduction["FamilyAmplitude"]; free = familyReduction["FreeParameters"];
    report = Join[report, <|"SolvedFamilyIdentityReduction" -> familyReduction|>]];
  candidate = family /. Thread[free -> 0];
  report = Join[report, <|"Amplitude" -> candidate, "FamilyAmplitude" -> family,
    "FreeParameters" -> free, "SolutionRules" -> solution["SolutionRules"],
    "RemainingBasis" -> (D[family, #] & /@ free), "Correction" -> candidate - original|>];
  retain[report];
  completionProgress[callback, enabled, <|"Stage" -> "HighEnergy", "Phase" -> "IndependentValidation"|>];
  ruleSets = completionValidationRuleSets[model, settings["ParameterRules"],
    settings["ValidationParameterRules"]];
  If[!ListQ[ruleSets] || ruleSets === {}, Return[Join[report,
    <|"Diagnostics" -> {"Independent validation parameter assignments are invalid or unavailable."}|>]]];
  validations = MapIndexed[Function[{parameterRules, index},
    <|"ParameterRules" -> parameterRules, "Report" -> completionHECheck[candidate,
      normalized, channels, model, Join[settings, <|"ParameterRules" -> parameterRules|>],
      settings["RandomSeed"] + 104729 First[index]]|>], ruleSets];
  validation = First[validations]["Report"];
  If[free =!= {},
    completionProgress[callback, enabled, <|"Stage" -> "HighEnergy", "Phase" -> "IndependentFamilyValidation"|>];
    familyValidations = MapIndexed[Function[{parameterRules, index}, Module[
      {validationSeed = settings["RandomSeed"] + 104729 First[index], checks},
      checks = <|"Physical" -> completionResidueConstraints[family, free, normalized,
          settings["ValidationSamples"], validationSeed, parameterRules,
          settings["TimeConstraint"], callback, False],
        "HighEnergy" -> completionHEEnergyConstraints[family, free, metadata,
          settings["ValidationSamples"], validationSeed, parameterRules, bound, callback, False],
        "Spurious" -> completionHESpuriousConstraints[family, free, normalized, metadata,
          settings["ValidationSamples"], validationSeed, parameterRules, callback, False,
          settings["TimeConstraint"]],
        "Reference" -> completionHEReferenceConstraints[family, free, normalized, metadata,
          settings["ValidationSamples"], validationSeed, parameterRules, callback, False]|>;
      <|"ParameterRules" -> parameterRules, "Checks" -> checks|>]], ruleSets];
    familyValid = AllTrue[familyValidations, AllTrue[Values[#["Checks"]],
      AssociationQ[#] && Lookup[#, "Status"] === "COMPLETE" &&
        AllTrue[Lookup[#, "Equations", {}], highEnergyZeroState[#] === "Zero" &] &] &]];
  status = Which[!AllTrue[validations, completionHEAllPassQ[#["Report"]] &] || !familyValid, "UNRESOLVED",
    free =!= {}, "UNDERDETERMINED", True, "COMPLETE"];
  retainedProofs = Select[Lookup[Lookup[report, "SolvedFamilyIdentityReduction",
      Lookup[report, "FamilyIdentityReduction", <||>]], "Certificates", {}],
    MemberQ[free, Lookup[#, "Parameter", None]] &];
  proofReasons = Counts[Lookup[#, "Method", "UnreportedProof"] & /@ retainedProofs];
  If[Length[retainedProofs] < Length[free],
    AssociateTo[proofReasons, "UnreportedProof" ->
      (Lookup[proofReasons, "UnreportedProof", 0] + Length[free] - Length[retainedProofs])]];
  establishedNonzero = Count[Lookup[#, "Method", None] & /@ retainedProofs, "NonzeroSymbolicExternalChart"];
  proofSummary = <|"RetainedDirections" -> Length[free],
    "EstablishedNonzeroDirections" -> establishedNonzero,
    "IdentityProofUnfinished" -> (Length[free] - establishedNonzero),
    "ProofReasons" -> proofReasons|>;
