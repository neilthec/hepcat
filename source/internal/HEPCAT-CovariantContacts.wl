   "Angle"-><|3->angleBasis[3].Take[coordinates,2],4->angleBasis[4].Take[coordinates,-2]|>,
   "Square"-><|3->squareBasis[3].Take[coordinates,2],4->squareBasis[4].Take[coordinates,-2]|>,
