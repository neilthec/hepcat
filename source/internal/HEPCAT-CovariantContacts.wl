(* Source-only, portable calibration of an existing metric quartic continuation.
   Load HEPCAT and covariant-current-sources.wl first. The complete lower amplitude
   determines the contact after the chosen cubic continuation; no benchmark is read. *)
Begin["HEPCATCovariantContactCalibration`Private`"];
HEPCATCovariantContactCalibration`Private`reject[tag_String,data_:<||>]:=Failure[tag,data];
HEPCATCovariantContactCalibration`Private`objectSHA[value_]:=IntegerString[Hash[value,"SHA256"],16,64];
HEPCATCovariantContactCalibration`Private`rowParticles[row_List]:=DeleteCases[Drop[row,-2],""];
HEPCATCovariantContactCalibration`Private`coherent[expression_]:=expression/.
 Spinor["Spin","Upper",kind:("Angle"|"Square"),leg_Integer,VectorSpinIndex[leg_Integer,1|2]]:>Spinor["Spin",kind,leg];
(* A name map is admitted only between declared keys of matching parameter roles.
   Independent numerical defaults do not enter this symbolic identification. *)
HEPCATCovariantContactCalibration`Private`parameterTransport[expression_,source_List,lower_List]:=Module[
 {sourceKeys,lowerKeys,used,previous={},functions,map={},matches,p,key,sourceKey,lowerExpanded,sourceExpanded,
  differences={},lowerIndependent,sourceIndependent,declaredNames},
 sourceKeys=First/@Join[source[[3]],source[[4]]];lowerKeys=First/@Join[lower[[3]],lower[[4]]];
 If[!AllTrue[Join[sourceKeys,lowerKeys],MatchQ[#,_ModelParameter]&],Return[HEPCATCovariantContactCalibration`Private`reject["MalformedParameterOwnership"]]];
 used=DeleteDuplicates[Cases[expression,_ModelParameter,{0,Infinity}]];
 If[Complement[used,lowerKeys]=!={},Return[HEPCATCovariantContactCalibration`Private`reject["ForeignLowerModelParameter"]]];
 functions=First[#]->#[[2]]&/@lower[[4]];
 While[used=!=previous,previous=used;used=DeleteDuplicates[Join[used,Flatten[Cases[#, _ModelParameter,{0,Infinity}]&/@
  Cases[functions,Rule[p_,body_]/;MemberQ[used,p]:>body]]]]];
 Do[matches=Select[sourceKeys,ModelParameterName[#]===ModelParameterName[p]&];
  If[Length[matches]=!=1,Return[HEPCATCovariantContactCalibration`Private`reject["MissingOrAmbiguousSourceParameter",<|"Name"->ModelParameterName[p]|>]]];
  sourceKey=First[matches];
  If[Last[List@@p]=!=Last[List@@sourceKey]||MemberQ[First/@lower[[3]],p]=!=MemberQ[First/@source[[3]],sourceKey],
   Return[HEPCATCovariantContactCalibration`Private`reject["ParameterRoleMismatch",<|"Name"->ModelParameterName[p]|>]]];
  AppendTo[map,p->sourceKey],{p,used}];
 Do[If[MemberQ[First/@lower[[4]],p],
   lowerExpanded=ConstructiveDiagrams`Private`modelExpandParameterDefinitions[p,lower]/.map;
   sourceExpanded=ConstructiveDiagrams`Private`modelExpandParameterDefinitions[p/.map,source];
   If[!FreeQ[{lowerExpanded,sourceExpanded},_ModelFunction|_Failure],Return[HEPCATCovariantContactCalibration`Private`reject["UnsupportedParameterDependency"]]];
   AppendTo[differences,ModelParameterName[p]->Cancel[Together[Rationalize[lowerExpanded-sourceExpanded,0]]]]],{p,used}];
 If[!AllTrue[Last/@differences,#===0&],Return[HEPCATCovariantContactCalibration`Private`reject["DifferentModelParameterDefinitions",<|"Differences"->differences|>]]];
 <|"Expression"->(expression/.map),"ParameterMap"->map,"DependentDefinitionDifferences"->differences,
   "NumericalDefaultsUsed"->False|>
];
Options[HEPCATCovariantContactCalibration`Private`metricContactCalibration]={"TimeConstraint"->30};
HEPCATCovariantContactCalibration`Private`metricContactCalibration[diagramModel_List,lowerModel_List,
 vectorNames:{_String,_String},scalarName_String,OptionsPattern[]]:=Module[
