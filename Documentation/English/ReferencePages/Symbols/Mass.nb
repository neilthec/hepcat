Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Mass", "ObjectName"],
  Cell[TextData[{"Represents an external-particle mass or the assigned mass \
of an internal channel."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Mass", "[", "i", "]"}]],
      "InlineFormula"], "  ",
     "denotes the on-shell mass assigned to external particle i."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Mass[i] is the kinematic mass placeholder for external leg \
i. It is distinct from a model parameter such as the electron mass: the \
model's replacement list connects the placeholder to the appropriate \
parameter."}], "Notes"], Cell[TextData[{"Mass[Multiparticle[1, 3]] labels the \
mass assigned to the channel carrying p1+p3. A diagram may therefore contain \
both external mass replacements and a replacement for this channel mass."}],
   "Notes"], Cell[TextData[{"The replacement Mass[Multiparticle[1, 3]] -> m \
does not, on its own, assert that every occurrence of p1+p3 has invariant \
mass m. ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " uses the \
declared channel information only within the permitted numerator scope. It \
keeps the actual ", ButtonBox["PropDen", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PropDen"], " off shell."}], "Notes"],
  Cell[TextData[{"Use ", ButtonBox["ParticleMass", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ParticleMass"],
     " to ask a model for a particle's mass, and ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"],
     " when you need the model's numerical parameter values."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Compare the external mass label for particle 1 with the \
channel-mass label for p1+p3. They are separate placeholders even when a \
particular model assigns them the same parameter."}], "ExampleText"],
  Cell[BoxData[RowBox[{"{", "Mass", "[", "1", "]", ",", " ", "Mass", "[",
      "Multiparticle", "[", "1", ",", " ", "3", "]", "]", "}"}]], "Input"],
  Cell[BoxData[RowBox[{"{", RowBox[{SubscriptBox["M", "1"], ",",
        SubscriptBox["M", RowBox[{"1", ",", "3"}]]}], "}"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ParticleMass", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ParticleMass"], "  \[Bullet]  ",
     ButtonBox["MomProd", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/MomProd"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "Mass - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/Mass", "title" -> "Mass", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" -> "Represents an external-particle mass or the assigned mass \
of an internal channel.", "keywords" -> {"HEPCAT", "Mass",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]