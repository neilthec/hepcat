  Cell[TextData[{Cell[BoxData[RowBox[{"ReadAmplitudes", "[", "file", ",",
         " ", "particles", "]"}]], "InlineFormula"], "  ", "Read an ampsN.mdl \
table using the particle declarations for spin and mass information."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["An amplitude row contains \
the external particle names, optional empty padding columns, an overall \
factor and the expression divided by that factor. The last two entries are \
therefore multiplied to obtain the full stored amplitude.", "Notes"],
  Cell["The reader uses ConvertAmplitude to translate compact bracket \
notation into typed HEPCAT expressions. It does not automatically invent \
missing opposite-helicity amplitudes.", "Notes"],
  Cell["The factorization code treats an unlisted lower-point amplitude as \
zero. Populate the model with the complete lower-point results needed by the \
intended calculation.", "Notes"], Cell["ReadModel normally reads the matching \
particle and amplitude files together and should be preferred for routine \
use.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Read the QED vertex-amplitude rows explicitly.", "ExampleText"],
