          OverscriptBox["1", "^"]}, "RowDefault"],
        TemplateBox[{OverscriptBox["2", "^"], "\"\[RightAngleBracket]\""},
         "RowDefault"]}, "RowDefault"]}]], "Output"],
  Cell["Mark a selected pair of shift legs.", "ExampleText"],
