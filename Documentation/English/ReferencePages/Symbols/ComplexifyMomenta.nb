   "AnchorBarGrid"], Cell["ComplexifyMomenta", "ObjectName"],
  Cell["Marks supported momenta and spinors for a legacy complex \
deformation.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "expr",
         "]"}]], "InlineFormula"], "  ",
     "marks all supported Spinor, Mom and scalar-product occurrences."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "expr", ",",
         " ", "i", ",", " ", "j", "]"}]], "InlineFormula"], "  ", "marks the \
square spinor of leg i, angle spinor of leg j, and the supported shifted \
momentum factors."}], "Usage"], Cell["Details", "NotesSection"],
  Cell["This is a symbolic marking step, not a complete general complex \
shift. ExpandComplexMomenta implements the supported continuation cases.",
   "Notes"], Cell["The two-leg form distinguishes scalar products with one or \
both deformed momenta. Do not assume that arbitrary reference or mixed hatted \
objects have been transformed.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Mark every supported object.", "ExampleText"],
  Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", " ", "MomProd", "[", "1", ",", " ", "3", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{SubscriptBox[OverscriptBox["p", "^"], "1"],
        ".", SubscriptBox[OverscriptBox["p", "^"], "3"]}], " ",
