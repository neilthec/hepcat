Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ComplexifyMomenta", "ObjectName"],
  Cell[TextData[
    {
     "Marks supported momenta and spinors for a legacy complex deformation."}]\
, "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "expr",
         "]"}]], "InlineFormula"], "  ",
     "marks all supported Spinor, Mom and scalar-product occurrences."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "expr", ",",
         " ", "i", ",", " ", "j", "]"}]], "InlineFormula"], "  ", "marks the \
square spinor of leg i, angle spinor of leg j, and the supported shifted \
momentum factors."}], "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this at the symbolic marking stage of an earlier \
complex-shift derivation. It changes the supported ordinary spinor and \
momentum heads into their shifted counterparts, leaving the actual supported \
shift expansion to ", ButtonBox["ExpandComplexMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExpandComplexMomenta"], "."}],
   "Notes"],
  Cell[TextData[
    {"This is a symbolic marking step, not a complete general complex shift. \
", ButtonBox["ExpandComplexMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExpandComplexMomenta"],
     " implements the supported continuation cases."}], "Notes"],
  Cell[TextData[{"The two-leg form distinguishes scalar products with one or \
both deformed momenta. Do not assume that arbitrary reference or mixed hatted \
objects have been transformed."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Mark every supported object."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", " ", "MomProd", "[", "1", ",", " ", "3", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{SubscriptBox[OverscriptBox["p", "^"], "1"],
        ".", SubscriptBox[OverscriptBox["p", "^"], "3"]}], " ",
      TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
          OverscriptBox["1", "^"]}, "RowDefault"],
        TemplateBox[{OverscriptBox["2", "^"], "\"\[RightAngleBracket]\""},
         "RowDefault"]}, "RowDefault"]}]], "Output"],
  Cell[TextData[{"Mark a selected pair of shift legs."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1",
      "]", ",", " ", "Mom", "[", "2", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3", "]", "]", ",",
      " ", "1", ",", " ", "3", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"[\"", OverscriptBox["1", "^"]},
       "RowDefault"], "\"|\"", SubscriptBox["p", "2"], "\"|\"",
      TemplateBox[{OverscriptBox["3", "^"], "\"\[RightAngleBracket]\""},
       "RowDefault"]}, "RowDefault"]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ExpandComplexMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExpandComplexMomenta"],
     "  \[Bullet]  ", ButtonBox["UnhatMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/UnhatMomenta"], "  \[Bullet]  ",
     ButtonBox["SpinorHat", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorHat"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ComplexifyMomenta - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
