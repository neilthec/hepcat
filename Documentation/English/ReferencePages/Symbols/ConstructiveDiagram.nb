   "AnchorBarGrid"], Cell["ConstructiveDiagram", "ObjectName"],
  Cell[
   "Evaluate an older three-point vertex or a selected four-point exchange.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ConstructiveDiagram", "[",
         "particles", ",", " ", "model", "]"}]], "InlineFormula"], "  ",
     "Match one three-point constructive amplitude."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ConstructiveDiagram", "[",
         "particles", ",", " ", "internalParticle", ",", " ", "model", ",",
         " ", "channel", "]"}]], "InlineFormula"], "  ", "Evaluate the \
selected four-point exchange with channel labels such as {1,2}."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This historical helper supports a \
three-particle vertex and a four-particle exchange. It is not the general \
tree generator for higher multiplicity.", "Notes"],
  Cell["The selected channel identifies which two of the four external \
particles meet on one side. The internal particle name must be present in the \
supplied particle table.", "Notes"], Cell["Use CreateDiagrams followed by \
diagramAmplitudes for new calculations. That route handles generic internal \
photon/gluon helicities, external x factors and per-diagram mass-rule pairs \
consistently.", "Notes"], Cell["The historical helper can return zero when no \
matching vertex or exchange exists and may print a diagnostic for \
unrecognized names. A zero here is not a full-process physical validation.",
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Evaluate one QED three-point vertex.", "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "ConstructiveDiagram",
      "[", "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", "}", ",",
      " ", "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"-", RowBox[{"(", RowBox[{SqrtBox["2"], " ",
          InterpretationBox["EE", ModelParameter["EE",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], " ", TemplateBox[
           {TemplateBox[{"\"\[LeftAngleBracket]\"", StyleBox["1", Bold,
               StripOnInput -> False]}, "RowDefault"], TemplateBox[
             {StyleBox["2", Bold, StripOnInput -> False],
              "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
          " ", SubscriptBox["\"x\"", "\"1,2\""]}], ")"}]}]], "Output"],
  Cell["Use the modern route for a complete four-point process.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
