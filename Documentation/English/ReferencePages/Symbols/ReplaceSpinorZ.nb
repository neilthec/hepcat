           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ReplaceSpinorZ", "ObjectName"],
  Cell[TextData[
    {
     "Replaces a two-index auxiliary z object in a supported massive shift."}]\
, "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReplaceSpinorZ", "[", "expr", ",",
         " ", "{", "i", ",", " ", "mi", "}", ",", " ", "{", "j", ",", " ",
         "mj", "}", ",", " ", "k", "]"}]], "InlineFormula"], "  ", "rewrites \
SpinorZ[\"Both\",I,J] when both specified masses are nonzero."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"This helper belongs to the supported massive complex-shift \
calculation. It replaces the two-index auxiliary object associated with the \
specified massive legs and companion leg; it is not a general identity for \
arbitrary reference spinors."}], "Notes"],
  Cell[TextData[
    {"The result is a sum of a massive spinor bracket and a chain with ",
     Cell[BoxData[RowBox[{"Mom", "[", "k", "]"}]], "InlineFormula"], ", \
divided by mi mj. The original upper/lower little-group indices are \
retained."}], "Notes"], Cell[TextData[{"If either mass is zero, this \
particular replacement is not applied. It is not a generic rule for all \
SpinorZ forms."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Expand a two-index z object."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReplaceSpinorZ", "[", "SpinorZ", "[", "\"Both\"",
      ",", " ", "i", ",", " ", "j", "]", ",", " ", "{", "1", ",", " ", "m1",
      "}", ",", " ", "{", "2", ",", " ", "m2", "}", ",", " ", "3", "]"}]],
   "Input"], Cell[BoxData[FractionBox[
     RowBox[{RowBox[{"m1", " ", TemplateBox[
          {TemplateBox[{"\"[\"", SubscriptBox[StyleBox["1", Bold,
               StripOnInput -> False], "i"]}, "RowDefault"],
           TemplateBox[{TemplateBox[{StyleBox["2", Bold, StripOnInput ->
                 False], "j"}, "Superscript", SyntaxForm -> SuperscriptBox],
             "\"]\""}, "RowDefault"]}, "RowDefault"]}], "+",
       TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
           SubscriptBox[StyleBox["1", Bold, StripOnInput -> False], "i"]},
          "RowDefault"], "\"|\"", SubscriptBox["p", "3"], "\"|\"",
         TemplateBox[{TemplateBox[{StyleBox["2", Bold, StripOnInput ->
               False], "j"}, "Superscript", SyntaxForm -> SuperscriptBox],
           "\"]\""}, "RowDefault"]}, "RowDefault"]}],
     RowBox[{"m1", " ", "m2"}]]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
