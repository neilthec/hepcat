Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["MakeIndicesImplicit", "ObjectName"],
  Cell[TextData[{"Removes the supported explicit upper massive-spin indices \
from spinor chains."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"MakeIndicesImplicit", "[", "expr",
         "]"}]], "InlineFormula"], "  ", "replaces explicit upper-index \
massive Spinor occurrences with their implicit form."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"This restores the compact external-state notation after an \
explicit-index calculation. The supported upper-index ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], " factors are replaced by the \
corresponding massive spinors with their indices omitted."}], "Notes"],
  Cell[TextData[{"Omitting an index does not perform a sum over it and does \
not undo a physical spin projection. If the index was needed to distinguish \
components, preserve the explicit expression before suppressing that \
information."}], "Notes"], Cell[TextData[{"For the opposite operation, use ",
     ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"],
     ". To sew repeated indices by a spin-sum identity, use ",
     ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"], "."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Remove an uncontracted upper index."}], "ExampleText"],
  Cell[BoxData[RowBox[{"MakeIndicesImplicit", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Spin\"", ",", " ", "\"Upper\"", ",", " ",
      "\"Angle\"", ",", " ", "1", ",", " ", "j", "]", ",", " ", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3", "]", "]",
      "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", StyleBox["1", Bold,
           StripOnInput -> False]}, "RowDefault"],
        TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"], ShowStringCharacters -> False],
     SpinorChain[Spinor["Spin", "Angle", 1], Spinor["Helicity", "Angle", 3]],
     Editable -> False]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinContractions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinContractions"], "  \[Bullet]  ",
     ButtonBox["SymmetrizeSpin", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpin"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
  "MakeIndicesImplicit - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
