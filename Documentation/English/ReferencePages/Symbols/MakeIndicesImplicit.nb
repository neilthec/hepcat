  Cell[TextData[{Cell[BoxData[RowBox[{"MakeIndicesImplicit", "[", "expr",
         "]"}]], "InlineFormula"], "  ", "replaces explicit upper-index \
massive Spinor occurrences with their implicit form."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This legacy helper prints a warning: \
it assumes that all indices to be removed are upper and uncontracted. It is \
not a safe inverse of an arbitrary contraction or spin sum.", "Notes"],
  Cell["Lower indices and already contracted structures require the correct \
algebra rather than erasing their labels.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
