Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PolarizationVector", "ObjectName"],
  Cell[TextData[{"Records an external vector wavefunction and its Lorentz \
index in a Feynman diagram."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PolarizationVector", "[", "leg", ",",
         " ", "index", ",", " ", "mass", ",", " ", "helicity", "]"}]],
      "InlineFormula"], "  ",
     "represents an external vector wavefunction in the Feynman backend."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PolarizationVector", "[", "leg", ",",
         "index", ",", "mass", ",", "helicity", "]"}]], "InlineFormula"], " \
identifies the external momentum, the Lorentz contraction index, its mass and \
the massless helicity when applicable. Diagram generation normally supplies \
this object from the process and the model."}], "Notes"],
  Cell[TextData[{"For a massless vector, the helicity is ",
     Cell[BoxData[RowBox[{"+", "1"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "or", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"-", "1"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "In", " ", "a", " ", "photon", " ",
         "process", " ", "these", " ", "correspond", " ", "to", " ", "the",
         " ", "names", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"A.+\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"A.-\""}]], "InlineFormula"], ". A generic \
massless polarization needs one of these choices before it can be converted \
to spinor products."}], "Notes"],
  Cell[TextData[{"For a massive vector, use ",
     Cell[BoxData[RowBox[{"Automatic"}]], "InlineFormula"],
     " in the last argument. ", ButtonBox["FeynmanToSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     " then retains the two symmetric little-group slots as ",
     ButtonBox["VectorSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/VectorSpinIndex"],
     " labels, so the expression describes the vector spin tensor."}],
   "Notes"], Cell[TextData[{"Massless wavefunctions introduce auxiliary \
reference spinors. Choose the same reference for a given external gauge leg \
throughout the full Feynman sum. ", ButtonBox["PrepareAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PrepareAmplitudes"], " does this collectively for \
Feynman diagrams, allowing the gauge-dependent diagram contributions to \
combine consistently."}], "Notes"],
  Cell[TextData[{"Reference choices can simplify intermediate expressions, \
but they do not change the physical amplitude. A reference giving an \
identically zero denominator is rejected."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Represent photon leg 3 with positive helicity and Lorentz index mu."}],
   "ExampleText"], Cell[BoxData[RowBox[{"PolarizationVector", "[", "3", ",",
      " ", "mu", ",", " ", "0", ",", " ", "1", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"PolarizationVector", "[", "3", ",", " ", "mu", ",",
      " ", "0", ",", " ", "1", "]"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["VectorSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/VectorSpinIndex"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "PolarizationVector - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/PolarizationVector",
     "title" -> "PolarizationVector", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" -> "Records an external vector wavefunction and its Lorentz \
index in a Feynman diagram.", "keywords" -> {"HEPCAT", "PolarizationVector",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]