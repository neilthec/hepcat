   "AnchorBarGrid"], Cell["PolarizationVector", "ObjectName"],
  Cell["Represents an external vector wavefunction in the Feynman backend.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PolarizationVector", "[", "leg", ",",
         " ", "index", ",", " ", "mass", ",", " ", "helicity", "]"}]],
      "InlineFormula"], "  ",
     "represents an external vector wavefunction in the Feynman backend."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The leg labels the \
external momentum, index is its Lorentz slot, and mass distinguishes massive \
from massless wavefunctions.", "Notes"], Cell["For a photon, helicity +1 or \
-1 selects its wavefunction. The corresponding process names use A.+ or A.-."\
, "Notes"], Cell["A massive vector retains two symmetric VectorSpinIndex \
labels during conversion. Distinct Feynman diagrams must use a common \
reference choice for a given external gauge particle.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Construct the symbolic object.", "ExampleText"],
  Cell[BoxData[RowBox[{"PolarizationVector", "[", "3", ",", " ", "mu", ",",
