   "AnchorBarGrid"], Cell["ExtractMandelstahm", "ObjectName"],
  Cell["Rewrites scalar momentum products and supported two-particle \
propagators using s invariants.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "expr",
         "]"}]], "InlineFormula"], "  ",
     "uses the historical four-point convention."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "expr", ",",
         " ", "n", "]"}]], "InlineFormula"], "  ", "uses n-point kinematics, \
applying complementary-pair identifications only when n is 4."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["For i different from j, MomProd[i,j] \
becomes (Mandelstahm[i,j]-Mass[i]^2-Mass[j]^2)/2.", "Notes"],
  Cell["The default four-point mode identifies s34=s12, s24=s13 and s23=s14. \
These equalities require four-point momentum conservation; specify the actual \
higher multiplicity when they do not apply.", "Notes"],
  Cell["This is an explicit representation conversion. It need not make an \
expression simpler, and differs from diagram-local internal on-shell \
reduction.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Convert one scalar product without four-point pair identifications.",
   "ExampleText"], Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "2", " ",
      "MomProd", "[", "3", ",", " ", "4", "]", ",", " ", "5", "]"}]],
   "Input"], Cell[BoxData[RowBox[{SubscriptBox["\"s\"", "\"34\""], "-",
      SubsuperscriptBox["M", "3", "2"], "-", SubsuperscriptBox["M", "4",
       "2"]}]], "Output"],
  Cell["Observe the historical four-point complement convention.",
   "ExampleText"], Cell[BoxData[RowBox[{"ExtractMandelstahm", "[",
      "Mandelstahm", "[", "3", ",", " ", "4", "]", "]"}]], "Input"],
  Cell[BoxData[SubscriptBox["\"s\"", "\"12\""]], "Output"],
