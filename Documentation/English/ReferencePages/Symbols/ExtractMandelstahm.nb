            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ExtractMandelstahm", "ObjectName"],
  Cell[TextData[{"Rewrites supported scalar momentum products and \
two-particle propagators in terms of s invariants."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "expr",
         "]"}]], "InlineFormula"], "  ",
     "uses the historical four-point convention."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "expr", ",",
         " ", "n", "]"}]], "InlineFormula"], "  ", "uses n-point kinematics, \
applying complementary-pair identifications only when n is 4."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"This is useful when you want to display a result in \
conventional channel invariants or compare it with a formula written that \
way. For distinct labels i and j, the conversion uses ",
     Cell[BoxData[RowBox[{"2", " ", "MomProd", "[", "i", ",", "j", "]", "=",
         "Mandelstahm", "[", "i", ",", "j", "]", "-", "Mass", "[", "i", "]",
         "^", "2", "-", "Mass", "[", "j", "]", "^", "2"}]], "InlineFormula"],
     "."}], "Notes"], Cell[TextData[{"The one-argument form assumes \
four-point kinematics. At four points it also identifies complementary \
invariants, such as s34=s12. For a five- or six-point expression, supply the \
actual multiplicity as the second argument to avoid those four-point \
identifications."}], "Notes"],
  Cell[TextData[{"A supported ", ButtonBox["PropDen", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PropDen"],
     "[Mom[Multiparticle[i,j]],m] becomes ", ButtonBox["Mandelstahm",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/Mandelstahm"], "[\
i,j]-m^2. Its pole is retained. The conversion does not set s_ij to an \
internal mass squared."}], "Notes"],
  Cell[TextData[
    {"This representation is not always the easiest one to simplify further. \
", ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"], " and ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"],
     " can work with momentum products left in their typed form."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Convert one scalar product without four-point pair identifications."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "2", " ",
      "MomProd", "[", "3", ",", " ", "4", "]", ",", " ", "5", "]"}]],
   "Input"], Cell[BoxData[RowBox[{SubscriptBox["\"s\"", "\"34\""], "-",
      SubsuperscriptBox["M", "3", "2"], "-", SubsuperscriptBox["M", "4",
       "2"]}]], "Output"],
  Cell[TextData[
    {"Observe the historical four-point complement convention."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ExtractMandelstahm", "[",
      "Mandelstahm", "[", "3", ",", " ", "4", "]", "]"}]], "Input"],
  Cell[BoxData[SubscriptBox["\"s\"", "\"12\""]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Mandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mandelstahm"], "  \[Bullet]  ",
     ButtonBox["MomProd", BaseStyle -> "Link", ButtonData ->
