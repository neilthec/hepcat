Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PermuteParticles", "ObjectName"],
  Cell["Cyclically relabels the specified external particles in typed \
amplitude expressions.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PermuteParticles", "[", "expr", ",",
         " ", "{", "i1", ",", " ", "i2", ",", " ", "...", ",", " ", "in",
         "}", "]"}]], "InlineFormula"], "  ",
     "maps i1 to i2, i2 to i3, and the last label back to i1."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This function applies one cycle. It \
does not sum all permutations and does not automatically multiply by a \
fermion-exchange sign.", "Notes"], Cell["Typed momentum, mass, invariant, \
spinor and x-factor labels are relabeled. Numerical coefficients and explicit \
little-group indices are preserved. Xi reference labels are not treated as \
external particles.", "Notes"], Cell["Apply a sequence of cycles or construct \
the appropriate exact replacement when a different permutation is required.",
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Cycle three momentum labels.", "ExampleText"],
  Cell[BoxData[RowBox[{"PermuteParticles", "[", "Mom", "[", "1", "]", " ",
      "+", " ", "2", " ", "Mom", "[", "2", "]", " ", "+", " ", "3", " ",
      "Mom", "[", "3", "]", ",", " ", "{", "1", ",", " ", "2", ",", " ", "3",
      "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"3", " ", SubscriptBox["p", "1"]}], "+",
      SubscriptBox["p", "2"], "+", RowBox[{"2", " ", SubscriptBox["p",
         "3"]}]}]], "Output"], Cell["Preserve an explicit spin index.",
   "ExampleText"], Cell[BoxData[RowBox[{"PermuteParticles", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Upper\"",
      ",", " ", "\"Angle\"", ",", " ", "2", ",", " ", "7", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "11",
      "]", "]", ",", " ", "{", "2", ",", " ", "7", ",", " ", "11", "}",
      "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
        TemplateBox[{StyleBox["7", Bold, StripOnInput -> False], "7"},
         "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
      TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"], "  \[Bullet]  ",
     ButtonBox["SymmetrizeSpins", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpins"], "  \[Bullet]  ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "PermuteParticles - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
