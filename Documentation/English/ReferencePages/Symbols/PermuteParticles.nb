Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PermuteParticles", "ObjectName"],
  Cell[TextData[{"Cyclically relabels selected external particles in typed \
spinor and momentum expressions."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PermuteParticles", "[", "expr", ",",
         " ", "{", "i1", ",", " ", "i2", ",", " ", "...", ",", " ", "in",
         "}", "]"}]], "InlineFormula"], "  ",
     "maps i1 to i2, i2 to i3, and the last label back to i1."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"The list {1,3,4} means 1 goes to 3, 3 goes to 4, and 4 goes \
to 1. Labels not in the list retain their values. Use a two-element list to \
interchange two legs."}], "Notes"],
  Cell[TextData[{"The function changes supported particle labels in spinors, \
momenta, masses, momentum products, scalar invariants and x-factors. A \
little-group spin index is not a particle number and is left intact. Use this \
typed relabeling rather than replacing every integer in an expression."}],
   "Notes"], Cell[TextData[{"A relabeling does not reverse a momentum and \
does not by itself supply the statistics sign required when comparing \
amplitudes under exchange of identical fermions. Apply ",
     ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"], " for crossing, and \
keep the process's Bose or Fermi exchange convention explicit when testing a \
physical symmetry."}], "Notes"],
  Cell[TextData[{"When relabeling a whole diagram or process, keep its \
particle list, external mass assignments, channel rules and expression \
consistent. An expression with newly numbered legs must be compared against \
the correspondingly numbered process."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Cycle three momentum labels."}], "ExampleText"],
  Cell[BoxData[RowBox[{"PermuteParticles", "[", "Mom", "[", "1", "]", " ",
      "+", " ", "2", " ", "Mom", "[", "2", "]", " ", "+", " ", "3", " ",
      "Mom", "[", "3", "]", ",", " ", "{", "1", ",", " ", "2", ",", " ", "3",
      "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"3", " ", SubscriptBox["p", "1"]}], "+",
      SubscriptBox["p", "2"], "+", RowBox[{"2", " ", SubscriptBox["p",
         "3"]}]}]], "Output"],
  Cell[TextData[{"Preserve an explicit spin index."}], "ExampleText"],
  Cell[BoxData[RowBox[{"PermuteParticles", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Spin\"", ",", " ", "\"Upper\"", ",", " ", "\"Angle\"", ",",
      " ", "2", ",", " ", "7", "]", ",", " ", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "11", "]", "]", ",", " ", "{", "2",
      ",", " ", "7", ",", " ", "11", "}", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[TemplateBox[
      {TemplateBox[{"\"\[LeftAngleBracket]\"", TemplateBox[
          {StyleBox["7", Bold, StripOnInput -> False], "7"}, "Superscript",
          SyntaxForm -> SuperscriptBox]}, "RowDefault"],
       TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
      "RowDefault"], SpinorChain[Spinor["Spin", "Upper", "Angle", 7, 7],
      Spinor["Helicity", "Angle", 2]], Editable -> False]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"], "  \[Bullet]  ",
     ButtonBox["SymmetrizeSpins", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpins"], "  \[Bullet]  ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "PermuteParticles - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/PermuteParticles", "title" -> "PermuteParticles",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" -> "Cyclically relabels selected external \
particles in typed spinor and momentum expressions.",
     "keywords" -> {"HEPCAT", "PermuteParticles", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]