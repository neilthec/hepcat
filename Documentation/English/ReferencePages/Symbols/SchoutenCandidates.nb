Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SchoutenCandidates", "ObjectName"],
  Cell[TextData[{"Finds the generalized Schouten replacements that can be \
applied to products of chains in an expression."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SchoutenCandidates", "[", "expr",
         "]"}]], "InlineFormula"], "  ",
     "returns edit associations for eligible pairs of chains and splits."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when a cancellation seems to require rearranging \
spinor pairings but you do not want to choose the chain pair and split \
positions by hand. The function searches the supported products and returns a \
list of edit associations."}], "Notes"],
  Cell[TextData[{"Each edit records Name, Subtract, Insert, Chains and \
Splits. Its local algebraic action replaces the Subtract expression by Insert \
at the selected location. These records let you inspect both the identity and \
the chains to which it applies."}], "Notes"],
  Cell[TextData[{"The list is a list of possibilities, not a simplification \
ranking. A valid Schouten move can initially make the expression longer. \
Compare the resulting whole expression, including cancellations with its \
other terms, rather than the inserted piece alone."}], "Notes"],
  Cell[TextData[
    {"For a wider set of legal identities and application-time validation, \
use ", ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     " together with ", ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"],
     ". Schouten generation itself uses no internal-shell assumption."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Inspect the available Schouten identities."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SchoutenCandidates", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4", "]", "]", "]"}]],
   "Input"],
  Cell[BoxData[RowBox[{"{", RowBox[{"Association", "[",
        RowBox[{RowBox[{"\"Name\"", "\[Rule]", "\"Schouten\""}], ",",
          RowBox[{"\"Subtract\"", "\[Rule]", RowBox[{InterpretationBox[
               TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
                  "RowDefault"], TemplateBox[{"2",
                   "\"\[RightAngleBracket]\""}, "RowDefault"]},
                "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 1],
                Spinor["Helicity", "Angle", 2]], Editable -> False], " ",
              InterpretationBox[TemplateBox[{TemplateBox[
                  {"\"\[LeftAngleBracket]\"", "3"}, "RowDefault"],
                 TemplateBox[{"4", "\"\[RightAngleBracket]\""},
                  "RowDefault"]}, "RowDefault"], SpinorChain[Spinor[
                 "Helicity", "Angle", 3], Spinor["Helicity", "Angle", 4]],
               Editable -> False]}]}], ",", RowBox[{"\"Insert\"", "\[Rule]",
            RowBox[{RowBox[{"-", RowBox[{"(", RowBox[{InterpretationBox[
                     TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
                         "1"}, "RowDefault"], TemplateBox[{"4",
                         "\"\[RightAngleBracket]\""}, "RowDefault"]},
                      "RowDefault"], SpinorChain[Spinor["Helicity", "Angle",
                       1], Spinor["Helicity", "Angle", 4]], Editable ->
                      False], " ", InterpretationBox[TemplateBox[
                      {TemplateBox[{"\"\[LeftAngleBracket]\"", "2"},
                        "RowDefault"], TemplateBox[{"3",
                         "\"\[RightAngleBracket]\""}, "RowDefault"]},
                      "RowDefault"], SpinorChain[Spinor["Helicity", "Angle",
                       2], Spinor["Helicity", "Angle", 3]], Editable ->
                      False]}], ")"}]}], "+", RowBox[{InterpretationBox[
                 TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
                    "RowDefault"], TemplateBox[{"3",
                     "\"\[RightAngleBracket]\""}, "RowDefault"]},
                  "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 1],
                  Spinor["Helicity", "Angle", 3]], Editable -> False], " ",
                InterpretationBox[TemplateBox[{TemplateBox[
                    {"\"\[LeftAngleBracket]\"", "2"}, "RowDefault"],
                   TemplateBox[{"4", "\"\[RightAngleBracket]\""},
                    "RowDefault"]}, "RowDefault"], SpinorChain[Spinor[
                   "Helicity", "Angle", 2], Spinor["Helicity", "Angle", 4]],
                 Editable -> False]}]}]}], ",", RowBox[{"\"Chains\"",
            "\[Rule]", RowBox[{"{", RowBox[{InterpretationBox[TemplateBox[
                  {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
                    "RowDefault"], TemplateBox[{"2",
                     "\"\[RightAngleBracket]\""}, "RowDefault"]},
                  "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 1],
                  Spinor["Helicity", "Angle", 2]], Editable -> False], ",",
                InterpretationBox[TemplateBox[{TemplateBox[
                    {"\"\[LeftAngleBracket]\"", "3"}, "RowDefault"],
                   TemplateBox[{"4", "\"\[RightAngleBracket]\""},
                    "RowDefault"]}, "RowDefault"], SpinorChain[Spinor[
                   "Helicity", "Angle", 3], Spinor["Helicity", "Angle", 4]],
                 Editable -> False]}], "}"}]}], ",",
          RowBox[{"\"Splits\"", "\[Rule]", RowBox[{"{", RowBox[{"0", ",",
                "0"}], "}"}]}]}], "]"}], "}"}]], "Output"],
  Cell[TextData[{"Verify that a candidate records its replacement fields."}],
   "ExampleText"], Cell[BoxData[RowBox[{"Keys", "[", "First", "[",
      "SchoutenCandidates", "[", "SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2",
      "]", "]", " ", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",",
      " ", "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4", "]", "]", "]",
      "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "\"Name\"", ",", " ", "\"Subtract\"", ",", " ",
      "\"Insert\"", ",", " ", "\"Chains\"", ",", " ", "\"Splits\"", "}"}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SchoutenRewrite", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SchoutenRewrite"], "  \[Bullet]  ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     "  \[Bullet]  ", ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SchoutenCandidates - HEPCAT Documentation",
