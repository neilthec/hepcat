  Cell["Lists exact generalized Schouten edits available in an expression.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SchoutenCandidates", "[", "expr",
         "]"}]], "InlineFormula"], "  ",
     "returns edit associations for eligible pairs of chains and splits."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["Each edit includes its \
Name, Subtract, Insert, Chains and Splits. The Subtract and Insert \
expressions include the appropriate spectator factors.", "Notes"],
  Cell["The function does not choose the best edit and does not use a neural \
model. No internal on-shell condition is assumed.", "Notes"],
  Cell["Inspect an edit by applying expr-edit[\"Subtract\"]+edit[\"Insert\"]. \
For the modern context-validated editing API, use SpinorIdentityCandidates \
and ApplySpinorIdentity.", "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Inspect the available Schouten identities.", "ExampleText"],
  Cell[BoxData[RowBox[{"SchoutenCandidates", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", " ", "SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4",
      "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", RowBox[{"Association", "[",
        RowBox[{RowBox[{"\"Name\"", "\[Rule]", "\"Schouten\""}], ",",
          RowBox[{"\"Subtract\"", "\[Rule]", RowBox[
             {TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
                 "RowDefault"], TemplateBox[{"2",
                  "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
              " ", TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "3"},
                 "RowDefault"], TemplateBox[{"4",
                  "\"\[RightAngleBracket]\""}, "RowDefault"]},
               "RowDefault"]}]}], ",", RowBox[{"\"Insert\"", "\[Rule]",
            RowBox[{RowBox[{"-", RowBox[{"(", RowBox[{TemplateBox[
                     {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
                       "RowDefault"], TemplateBox[{"4",
                        "\"\[RightAngleBracket]\""}, "RowDefault"]},
                     "RowDefault"], " ", TemplateBox[{TemplateBox[
                       {"\"\[LeftAngleBracket]\"", "2"}, "RowDefault"],
                      TemplateBox[{"3", "\"\[RightAngleBracket]\""},
                       "RowDefault"]}, "RowDefault"]}], ")"}]}], "+",
              RowBox[{TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
                    "1"}, "RowDefault"], TemplateBox[{"3",
                    "\"\[RightAngleBracket]\""}, "RowDefault"]},
                 "RowDefault"], " ", TemplateBox[{TemplateBox[
                   {"\"\[LeftAngleBracket]\"", "2"}, "RowDefault"],
                  TemplateBox[{"4", "\"\[RightAngleBracket]\""},
                   "RowDefault"]}, "RowDefault"]}]}]}], ",",
          RowBox[{"\"Chains\"", "\[Rule]", RowBox[{"{", RowBox[{TemplateBox[
                 {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
                   "RowDefault"], TemplateBox[{"2",
                    "\"\[RightAngleBracket]\""}, "RowDefault"]},
                 "RowDefault"], ",", TemplateBox[{TemplateBox[
                   {"\"\[LeftAngleBracket]\"", "3"}, "RowDefault"],
                  TemplateBox[{"4", "\"\[RightAngleBracket]\""},
                   "RowDefault"]}, "RowDefault"]}], "}"}]}], ",",
          RowBox[{"\"Splits\"", "\[Rule]", RowBox[{"{", RowBox[{"0", ",",
                "0"}], "}"}]}]}], "]"}], "}"}]], "Output"],
