Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["FeynmanToSpinorProducts", "ObjectName"],
  Cell["Converts contracted Feynman amplitudes to spinor products without \
imposing internal mass shells.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[",
         "expression", "]"}]], "InlineFormula"], "  ",
     "converts a contracted Feynman tensor expression."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[", "{",
         "massRules", ",", " ", "expression", "}", "]"}]], "InlineFormula"],
     "  ", "preserves the external mass-rule pair."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[",
         "amplitudes", "]"}]], "InlineFormula"], "  ",
     "converts a list of amplitude pairs."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The external convention is u = \
(-|p>,|p]), bar v = (<p|,-[p|), gamma5 = diag(-1,+1). All momenta remain \
incoming in the symbolic result.", "Notes"], Cell["Lorentz indices must be \
fully contracted. Unsupported tensors, free indices and unsupported fields \
return Failure rather than a partially converted amplitude.", "Notes"],
  Cell["Internal Feynman slashes and propagators remain off shell. Conversion \
applies ordinary algebra and external wavefunction conventions only.",
   "Notes"], Cell["Use the string option \"FermionHelicities\" for massless \
Dirac external fields. \"ReferenceSpinors\" supplies per-leg references; \
Automatic retains independent generic Xi references.", "Notes"],
  Cell["Raw diagrams can also be passed directly to PrepareAmplitudes with \
their FeynmanModel. That route performs conversion before reference selection \
and reduction.", "Notes"], Cell["For gauge invariance, use one reference \
assignment per external gauge leg for the entire Feynman sum, rather than \
optimizing separate Feynman diagrams independently.", "Notes"],
  Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FermionHelicities\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell["Leg-to-helicity rules or an association \
specifying massless Dirac external states for Feynman conversion. Required \
missing massless-fermion helicities are reported rather than guessed.",
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReferenceSpinors\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"], Cell["Explicit leg-to-reference \
rules or an association for Feynman-to-spinor conversion. Automatic \
introduces independent Xi references; use another eligible massless leg or an \
explicit Spinor. This lower-level conversion option is separate from the \
workflow's PolePreference.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReduceSpinorProducts\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell["Whether Feynman-to-spinor conversion applies \
ordinary ReduceSpinorProducts identities after converting the tensor \
structure. These identities do not impose internal-line on-shell conditions."\
, "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxExpandedTerms\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"100000"}]], "InlineFormula"]}],
        "TableText"], Cell["Maximum number of expanded tensor terms allowed \
during Feynman-to-spinor conversion. Exceeding the bound reports failure \
rather than returning an unsupported partial conversion.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"TimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"60"}]], "InlineFormula"]}],
        "TableText"], Cell["Maximum elapsed time allowed by the operation or \
stage. Where Automatic is supported it selects a finite workload-dependent \
budget; explicit seconds or supported Infinity override it. A timeout is \
reported, never treated as a successful amplitude.", "TableText"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Left, Left}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.23], Scaled[0.19],
         Scaled[0.58]}}, GridBoxDividers ->
      {"Rows" -> {False, True, {False}, False}}]], "3ColumnTableMod"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Convert a scalar massive-fermion bilinear.", "ExampleText"],
  Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[", "DiracChain", "[",
      "FermionBar", "[", "1", ",", " ", "m", ",", " ", "\"Dirac\"", "]", ",",
      " ", "DiracWord", "[", "]", ",", " ", "FermionKet", "[", "2", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {RowBox[{"-", TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
            StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"],
          TemplateBox[{StyleBox["2", Bold, StripOnInput -> False],
            "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"]}],
      "-", TemplateBox[{TemplateBox[{"\"[\"", StyleBox["1", Bold,
           StripOnInput -> False]}, "RowDefault"],
        TemplateBox[{StyleBox["2", Bold, StripOnInput -> False], "\"]\""},
         "RowDefault"]}, "RowDefault"]}]], "Output"],
  Cell["Generate and convert the four-point QED diagrams.", "ExampleText"],
  Cell[BoxData[RowBox[{"fm", " ", "=", " ", "ReadModel", "[",
      "feynmanModelDirectory", ",", " ", "2", "]", ";", "\n",
      "feynmanDiagrams", " ", "=", " ", "CreateDiagrams", "[", "{", "\"e\"",
      ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ", "\"A.-\"", "}", ",",
      " ", "fm", "]", ";", "\n", "feynmanPairs", " ", "=", " ",
      "diagramAmplitudes", "[", "feynmanDiagrams", "]", ";", "\n", "Head",
      " ", "/@", " ", "FeynmanToSpinorProducts", "[", "feynmanPairs", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"{", "List", ",", " ", "List", "}"}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"], "  \[Bullet]  ",
     ButtonBox["DiracChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracChain"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "  \[Bullet]  ",
     ButtonBox["diagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/diagramAmplitudes"], "  \[Bullet]  ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
