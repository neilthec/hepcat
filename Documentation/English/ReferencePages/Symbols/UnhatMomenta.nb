   "AnchorBarGrid"], Cell["UnhatMomenta", "ObjectName"],
  Cell[TextData[{"Removes the standard complex-deformation markers."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"UnhatMomenta", "[", "expr", "]"}]],
      "InlineFormula"], "  ", "replaces SpinorHat, MomHat and MomProdHat12 by \
Spinor, Mom and MomProd."}], "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when a derivation has reached the stage at which \
its complex-deformation labels should be removed. It replaces the standard ",
     ButtonBox["SpinorHat", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorHat"], ", ",
     ButtonBox["MomHat", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/MomHat"], " and ", ButtonBox["MomProdHat12",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/MomProdHat12"],
     " heads by their ordinary counterparts."}], "Notes"],
  Cell[TextData[{"This is a head replacement, not an evaluation of a shift \
parameter. It does not automatically remove the one-slot ",
     ButtonBox["MomProdHat1", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomProdHat1"], " or ",
     ButtonBox["MomProdHat2", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomProdHat2"], " markers."}],
   "Notes"], Cell[TextData[{"Use it only when the mathematical operation \
being performed justifies returning those objects to their unshifted form."}]\
, "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Undo the all-object marking operation."}], "ExampleText"],
  Cell[BoxData[RowBox[{"UnhatMomenta", "[", "ComplexifyMomenta", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", " ",
      "Mom", "[", "3", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{SubscriptBox["p", "3"], " ",
      InterpretationBox[StyleBox[TemplateBox[
         {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
          TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
         "RowDefault"], ShowStringCharacters -> False],
       SpinorChain[Spinor["Helicity", "Angle", 1], Spinor["Helicity",
         "Angle", 2]], Editable -> False]}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
