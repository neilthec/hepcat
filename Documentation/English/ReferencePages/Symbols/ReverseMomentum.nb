Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ReverseMomentum", "ObjectName"],
  Cell[TextData[{"Crosses selected external momenta, including their spinor \
signs, in a complete amplitude expression."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReverseMomentum", "[", "expr", ",",
         " ", "i", "]"}]], "InlineFormula"], "  ",
     "reverses external momentum i."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReverseMomentum", "[", "expr", ",",
         " ", "{", "i1", ",", " ", "i2", ",", " ", "...", "}", "]"}]],
      "InlineFormula"], "  ", "crosses the listed legs in sequence."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"HEPCAT derives analytic amplitudes with every external \
momentum incoming. If the numerical scattering process treats legs 3, 4 and 5 \
as outgoing, ReverseMomentum[expression, {3,4,5}] converts the supported \
typed momentum and spinor occurrences for those legs."}], "Notes"],
  Cell[TextData[{"In HEPCAT's convention the angle spinor of a crossed leg \
changes sign while its square spinor does not. Explicit momentum insertions \
also change sign. The function counts every affected occurrence, including \
repeated insertions in a chain, and transforms composite momentum sums inside \
chains and propagators."}], "Notes"],
  Cell[TextData[{"Apply crossing to the complete expression, including its \
denominators. A label permutation is a different operation and is handled by \
", ButtonBox["PermuteParticles", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PermuteParticles"], "."}], "Notes"],
  Cell[TextData[
    {"When exporting a physical incoming -> outgoing process through ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], ", supply the \
analytic all-incoming expression. The exporter performs this conversion \
itself. Pre-crossing that expression and asking the exporter to cross it \
again would count the signs twice."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"], Cell["Crossing spinors",
   "ExampleSubsection"],
  Cell[TextData[{"Cross leg 2 in <12>. Its angle spinor changes sign."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReverseMomentum", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", ",",
      " ", "2", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"-", InterpretationBox[TemplateBox[
        {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
         TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
        "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 1],
        Spinor["Helicity", "Angle", 2]], Editable -> False]}]], "Output"],
  Cell["Crossing momentum insertions", "ExampleSubsection"],
  Cell[TextData[{"Cross the momentum inserted on leg 2 in [1|p2|3>, without \
crossing either endpoint."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReverseMomentum", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1", "]", ",",
      " ", "Mom", "[", "2", "]", ",", " ", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "3", "]", "]", ",", " ", "2", "]"}]],
   "Input"],
  Cell[BoxData[RowBox[{"-", InterpretationBox[TemplateBox[
        {TemplateBox[{"\"[\"", "1"}, "RowDefault"], "2",
         TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
        "RowDefault"], SpinorChain[Spinor["Helicity", "Square", 1], Mom[2],
        Spinor["Helicity", "Angle", 3]], Editable -> False]}]], "Output"],
  Cell["Crossing propagators", "ExampleSubsection"],
  Cell[TextData[{"Cross a propagator momentum."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReverseMomentum", "[", "1", "/", "PropDen", "[",
      "Mom", "[", "1", "]", " ", "+", " ", "Mom", "[", "3", "]", ",", " ",
      "m", "]", ",", " ", "3", "]"}]], "Input"],
  Cell[BoxData[FractionBox["1", InterpretationBox[
      RowBox[{"(", RowBox[{RowBox[{"-", SuperscriptBox["m", "2"]}], "+",
          SuperscriptBox[RowBox[{"(", RowBox[{SubscriptBox["p", "1"], "-",
               SubscriptBox["p", "3"]}], ")"}], "2"]}], ")"}],
      PropDen[Mom[1] - Mom[3], m], Editable -> False]]], "Output"],
  Cell["Crossing several legs", "ExampleSubsection"],
  Cell[TextData[{"Cross both leg 2 and leg 3 in the same chain. The momentum \
insertion and the angle endpoint each contribute a sign."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReverseMomentum", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1", "]", ",",
      " ", "Mom", "[", "2", "]", ",", " ", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "3", "]", "]", ",", " ", "{", "2",
      ",", " ", "3", "}", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["PermuteParticles", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PermuteParticles"], "  \[Bullet]  ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], "  \[Bullet]  ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ReverseMomentum - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ReverseMomentum", "title" -> "ReverseMomentum",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" -> "Crosses selected external momenta, \
including their spinor signs, in a complete amplitude expression.",
     "keywords" -> {"HEPCAT", "ReverseMomentum", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]