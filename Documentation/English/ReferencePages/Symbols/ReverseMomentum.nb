        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ReverseMomentum", "ObjectName"],
  Cell[
   "Crosses selected external legs in complete spinor amplitude expressions."\
, "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReverseMomentum", "[", "expr", ",",
         " ", "i", "]"}]], "InlineFormula"], "  ",
     "reverses external momentum i."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReverseMomentum", "[", "expr", ",",
         " ", "{", "i1", ",", " ", "i2", ",", " ", "...", "}", "]"}]],
      "InlineFormula"], "  ", "crosses the listed legs in sequence."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["HEPCAT constructs all \
momenta incoming. Crossing an outgoing leg changes each angle spinor on that \
leg by a minus sign, leaves its square spinors unchanged, and reverses its \
explicit momentum insertions.", "Notes"], Cell["Every repeated occurrence in \
a chain is counted. Scalar products and propagator momenta are crossed \
consistently, while coefficients, powers, mass labels and spin-index labels \
are retained.", "Notes"], Cell["The operation targets supported amplitude \
structures, including chains, traces, scalar products and propagators. A \
standalone Mom[i] or Spinor object is not crossed by this legacy interface; \
use complete expressions.", "Notes"], Cell["Reference Xi labels and \
complex-shift hats are not ordinary external-leg occurrences. Do not use \
ReverseMomentum as a general relabeling function.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Cross an angle-bracket leg.", "ExampleText"],
  Cell[BoxData[RowBox[{"ReverseMomentum", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",",
      " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ",
      "2", "]", "]", ",", " ", "2", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"-", TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
        TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"]}]], "Output"],
  Cell["Cross the explicit momentum in a chain.", "ExampleText"],
  Cell[BoxData[RowBox[{"ReverseMomentum", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1", "]", ",",
      " ", "Mom", "[", "2", "]", ",", " ", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "3", "]", "]", ",", " ", "2", "]"}]],
   "Input"],
  Cell[BoxData[RowBox[{"-", TemplateBox[{TemplateBox[{"\"[\"", "1"},
         "RowDefault"], "\"|\"", SubscriptBox["p", "2"], "\"|\"",
        TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"]}]], "Output"], Cell["Cross a propagator momentum.",
   "ExampleText"], Cell[BoxData[RowBox[{"ReverseMomentum", "[", "1", "/",
      "PropDen", "[", "Mom", "[", "1", "]", " ", "+", " ", "Mom", "[", "3",
      "]", ",", " ", "m", "]", ",", " ", "3", "]"}]], "Input"],
  Cell[BoxData[FractionBox["1",
     RowBox[{RowBox[{"-", SuperscriptBox["m", "2"]}], "+",
       SuperscriptBox[RowBox[{"(", RowBox[{SubscriptBox["p", "1"], "-",
            SubscriptBox["p", "3"]}], ")"}], "2"]}]]], "Output"],
