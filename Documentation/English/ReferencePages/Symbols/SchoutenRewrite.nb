Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SchoutenRewrite", "ObjectName"],
  Cell[TextData[{"Rewrites a product of two spinor chains using a chosen \
generalized Schouten identity."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SchoutenRewrite", "[", "c1", ",", " ",
         "c2", ",", " ", "{", "m", ",", " ", "n", "}", "]"}]],
      "InlineFormula"], "  ", "returns an equivalent two-product expression \
when the split chiralities agree."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Supply two chains and the split positions {m,n}. Each \
number counts the momentum insertions before the split in its chain: zero \
means next to the first endpoint, and the full insertion count means next to \
the last endpoint."}], "Notes"],
  Cell[TextData[{"For chains without momentum insertions, {0,0} gives the \
familiar two-component Schouten relation between products of angle brackets \
or products of square brackets. With longer chains, the split determines \
which matrix strings accompany the recombined endpoints."}], "Notes"],
  Cell[TextData[{"The result is an expression equal to the product of the \
original two chains. To use it inside a larger amplitude, replace that \
product there. ", ButtonBox["SchoutenCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SchoutenCandidates"], " finds eligible \
locations and packages the corresponding edits for you."}], "Notes"],
  Cell[TextData[{"The split chiralities must agree. Invalid chains, \
incompatible chiralities, and out-of-range positions return $Failed. This \
identity does not need momentum conservation or an internal on-shell \
condition, and it may increase the displayed number of terms."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Construct the ordinary angle-bracket Schouten identity."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SchoutenRewrite", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", ",",
      " ", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4", "]", "]", ",",
      " ", "{", "0", ",", " ", "0", "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {RowBox[{"-", RowBox[{"(", RowBox[{TemplateBox[
             {TemplateBox[{"\"\[LeftAngleBracket]\"", "3"}, "RowDefault"],
              TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
             "RowDefault"], " ", TemplateBox[{TemplateBox[{
                "\"\[LeftAngleBracket]\"", "4"}, "RowDefault"],
              TemplateBox[{"1", "\"\[RightAngleBracket]\""}, "RowDefault"]},
             "RowDefault"]}], ")"}]}], "+",
      RowBox[{TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "3"},
           "RowDefault"], TemplateBox[{"1", "\"\[RightAngleBracket]\""},
           "RowDefault"]}, "RowDefault"], " ", TemplateBox[
         {TemplateBox[{"\"\[LeftAngleBracket]\"", "4"}, "RowDefault"],
          TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
         "RowDefault"]}]}]], "Output"],
  Cell[TextData[{"Reject a split beyond the chain length."}], "ExampleText"],
  Cell[BoxData[RowBox[{"SchoutenRewrite", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",",
      " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ",
      "2", "]", "]", ",", " ", "SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4",
      "]", "]", ",", " ", "{", "1", ",", " ", "0", "}", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SchoutenCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SchoutenCandidates"], "  \[Bullet]  ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SchoutenRewrite - HEPCAT Documentation",
