Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SquareAmplitude", "ObjectName"],
  Cell["Forms the amplitude times its Hermitian conjugate with explicit \
massive indices.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SquareAmplitude", "[", "expr", ",",
         " ", "spins", "]"}]], "InlineFormula"], "  ",
     "constructs the conjugate product using the per-particle spins."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The input should have \
implicit, uncontracted external massive spin indices, with internal \
contractions already reduced. The supported spin magnitudes are 0,1/2,1,3/2 \
and 2.", "Notes"], Cell["The function makes indices explicit in one copy, \
symmetrizes the other and conjugates the first. It returns their product; \
further ReduceSpinContractions and ReduceSpinorProducts may be required.",
   "Notes"], Cell["This helper does not perform an initial spin average or \
multiply identical-particle phase-space factors. It is not intended for \
complex-shifted external states.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Square a scalar amplitude with no spin indices.", "ExampleText"],
  Cell[BoxData[RowBox[{"SquareAmplitude", "[", "g", ",", " ", "{", "0", ",",
      " ", "0", "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"g", "*", "Conjugate", "[", "g", "]"}]], "Output"],
  Cell["Inspect the unsimplified massive spin product.", "ExampleText"],
  Cell[BoxData[RowBox[{"SquareAmplitude", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Spin\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"", ",", " ", "2", "]",
      "]", ",", " ", "{", "1", "/", "2", ",", " ", "1", "/", "2", "}",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {TemplateBox[{TemplateBox[{"\"[\"", SubscriptBox[StyleBox["2", Bold,
            StripOnInput -> False], "i2"]}, "RowDefault"],
        TemplateBox[{SubscriptBox[StyleBox["1", Bold, StripOnInput -> False],
           "i1"], "\"]\""}, "RowDefault"]}, "RowDefault"], " ",
      TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
          TemplateBox[{StyleBox["1", Bold, StripOnInput -> False], "i1"},
           "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
        TemplateBox[{TemplateBox[{StyleBox["2", Bold, StripOnInput -> False],
            "i2"}, "Superscript", SyntaxForm -> SuperscriptBox],
          "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"]}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["SymmetrizeSpins", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpins"], "  \[Bullet]  ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SquareAmplitude - HEPCAT Documentation",
