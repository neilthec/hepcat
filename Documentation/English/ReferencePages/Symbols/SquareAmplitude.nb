Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SquareAmplitude", "ObjectName"],
  Cell[TextData[{"Constructs an amplitude times its Hermitian conjugate, \
retaining the massive-spin contractions to be reduced."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SquareAmplitude", "[", "expr", ",",
         " ", "spins", "]"}]], "InlineFormula"], "  ",
     "constructs the conjugate product using the per-particle spins."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Supply an expression with implicit external massive indices \
and a list of physical spin magnitudes in particle order. The supported \
values are 0, 1/2, 1, 3/2 and 2. Internal spin contractions should already \
have been reduced."}], "Notes"],
  Cell[TextData[{"The function makes one copy's massive indices explicit, \
symmetrizes the corresponding indices in the other copy, conjugates the \
first, and multiplies the two. The result can still contain spin \
contractions; follow it with ", ButtonBox["ReduceSpinContractions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinContractions"], " and ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     " as needed."}], "Notes"],
  Cell[TextData[{"Scalar couplings are conjugated as part of the Hermitian \
conjugate. A symbolic coupling g is therefore not assumed real unless that \
property has been established separately."}], "Notes"],
  Cell[TextData[{"No initial-state spin average, identical-particle \
phase-space divisor, or external color sum is inserted here. ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], " provides \
explicit spin sums and the declared scattering normalization for numerical \
work. Complex-shifted external-state expressions are outside this helper's \
intended scope."}], "Notes"],
  Cell[TextData[{"Canonical color tensors retain Hermitian conjugation. \
Internally contracted color labels in the conjugate amplitude receive \
independent dummy names, so their sums are not accidentally tied to the \
original copy. External ColorIndex labels are retained; use ",
     ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"], " with ",
     Cell[BoxData[RowBox[{"\"SumExternalColors\"", " ", "->", " ", "True"}]],
      "InlineFormula"], " when a squared-color sum is wanted."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Square a scalar amplitude with no spin indices."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SquareAmplitude", "[", "g", ",",
      " ", "{", "0", ",", " ", "0", "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"g", "*", "Conjugate", "[", "g", "]"}]], "Output"],
  Cell[TextData[{"Inspect the unsimplified massive spin product."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SquareAmplitude", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", ",", " ", "Spinor", "[", "\"Spin\"", ",", " ",
      "\"Angle\"", ",", " ", "2", "]", "]", ",", " ", "{", "1", "/", "2",
      ",", " ", "1", "/", "2", "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{InterpretationBox[TemplateBox[
        {TemplateBox[{"\"[\"", SubscriptBox[StyleBox["2", Bold,
             StripOnInput -> False], "i2"]}, "RowDefault"],
         TemplateBox[{SubscriptBox[StyleBox["1", Bold, StripOnInput ->
              False], "i1"], "\"]\""}, "RowDefault"]}, "RowDefault"],
       SpinorChain[Spinor["Spin", "Lower", "Square", 2, i2],
        Spinor["Spin", "Lower", "Square", 1, i1]], Editable -> False], " ",
      InterpretationBox[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
           TemplateBox[{StyleBox["1", Bold, StripOnInput -> False], "i1"},
            "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
         TemplateBox[{TemplateBox[{StyleBox["2", Bold, StripOnInput ->
               False], "i2"}, "Superscript", SyntaxForm -> SuperscriptBox],
           "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
       SpinorChain[Spinor["Spin", "Upper", "Angle", 1, i1],
        Spinor["Spin", "Upper", "Angle", 2, i2]], Editable -> False]}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["SymmetrizeSpins", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpins"], "  \[Bullet]  ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SquareAmplitude - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/SquareAmplitude", "title" -> "SquareAmplitude",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" -> "Constructs an amplitude times its \
Hermitian conjugate, retaining the massive-spin contractions to be reduced.",
     "keywords" -> {"HEPCAT", "SquareAmplitude", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]