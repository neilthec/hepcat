   "AnchorBarGrid"], Cell["SimplifyFactorizationChannels", "ObjectName"],
  Cell["Apply the historical spinor simplifier separately to compact channel \
rows.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SimplifyFactorizationChannels", "[",
         "channels", "]"}]], "InlineFormula"], "  ", "Retain each channel row \
and simplify its last expression using its selected cut."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This historical helper builds \
external mass rules from each row and treats only that row's selected \
internal line as on shell. It then calls SimplifySpinorProducts with the \
corresponding momenta and mass replacements.", "Notes"],
  Cell["Simplifying on a cut preserves that channel residue while changing \
the continuation away from the cut. Do not combine the shell assumptions of \
several different rows.", "Notes"], Cell["PrepareAmplitudes is the preferred \
modern interface. It accepts the same compact rows, provides bounded effort \
and reference choices, and can preserve discarded remainders and original \
targets with \"ReturnDetails\" -> True.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["The historical helper leaves an empty channel list unchanged.",
   "ExampleText"], Cell[BoxData[RowBox[{"SimplifyFactorizationChannels", "[",
      "{", "}", "]"}]], "Input"], Cell[BoxData[RowBox[{"{", "}"}]],
   "Output"], Cell["Prepare real channels using the current interface.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "process", " ", "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "\"A.+\"", "}", ";", "\n", "channels", " ", "=",
      " ", "FactorizationAmplitudeChannels", "[", "process", ",", " ",
      "qedModel", "]", ";", "\n", "PrepareAmplitudes", "[", "channels", ",",
      " ", "qedModel", ",", " ", "\"ReturnDetails\"", " ", "->", " ", "True",
      "]"}]], "Input"], Cell["This example writes files, starts a longer \
calculation, or requires an optional external tool. Evaluate it when you want \
to perform that operation.", "ExampleText"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["FactorizationAmplitudeChannels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
