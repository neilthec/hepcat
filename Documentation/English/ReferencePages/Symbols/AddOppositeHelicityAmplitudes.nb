Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["AddOppositeHelicityAmplitudes", "ObjectName"],
  Cell["Mechanically add angle-square conjugate rows with reversed massless \
helicities.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"AddOppositeHelicityAmplitudes", "[",
         "rows", "]"}]], "InlineFormula"], "  ", "Retain each row and add its \
helicity-reversed bracket partner when applicable."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["For a row containing particle names \
ending in .+ or .-, the added row reverses all of those suffixes, \
interchanges angle and square spinors, and interchanges xFactor with \
xTildeFactor. The separate factor is retained.", "Notes"],
  Cell["This is a mechanical model-building operation, not a proof of a \
model's parity properties or coupling conjugation conventions. Verify the \
resulting amplitude and normalization for the theory being entered.",
   "Notes"], Cell["ReadAmplitudes does not currently call this operation \
automatically. Explicitly listed helicity amplitudes remain the clearest way \
to specify a complete model.", "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Inspect the two helicity names in a small row pair.", "ExampleText"],
  Cell[BoxData[RowBox[{"rows", " ", "=", " ", "{", "{", "\"e\"", ",", " ",
      "\"E\"", ",", " ", "\"A.+\"", ",", " ", "1", ",", " ", "SpinorChain",
      "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"", ",",
      " ", "2", "]", "]", "}", "}", ";", "\n", "variants", " ", "=", " ",
      "AddOppositeHelicityAmplitudes", "[", "rows", "]", ";", "\n",
      "variants", "[", "[", "All", ",", " ", "3", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "\"A.+\"", ",", " ", "\"A.-\"", "}"}]],
   "Output"], Cell["Inspect the converted square-bracket partner.",
   "ExampleText"], Cell[BoxData[RowBox[{"Last", "[", "variants", "]"}]],
   "Input"],
  Cell[BoxData[RowBox[{"{", RowBox[{"\"e\"", ",", "\"E\"", ",", "\"A.-\"",
        ",", "1", ",", TemplateBox[{TemplateBox[{"\"[\"", StyleBox["1", Bold,
             StripOnInput -> False]}, "RowDefault"], TemplateBox[
           {StyleBox["2", Bold, StripOnInput -> False], "\"]\""},
           "RowDefault"]}, "RowDefault"]}], "}"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadAmplitudes"], "  \[Bullet]  ",
     ButtonBox["ConvertAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConvertAmplitude"], "  \[Bullet]  ",
     ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
  "AddOppositeHelicityAmplitudes - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
