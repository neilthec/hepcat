Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ReadModel", "ObjectName"],
  Cell[
   "Read a constructive amplitude model or an imported CalcHEP Feynman \
model.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReadModel", "[", "directory", ",",
         " ", "number", "]"}]], "InlineFormula"], "  ",
     "Read the numbered model files from a directory."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["A constructive model is the \
four-element list {particles, amplitudes, variables, functions}. Its data \
come from prtclsN.mdl, ampsN.mdl, varsN.mdl and funcN.mdl. Keep this list and \
pass it to other HEPCAT functions.", "Notes"], Cell["When lgrngN.mdl is \
present and ampsN.mdl is absent, the reader recognizes a CalcHEP model and \
returns FeynmanModel[particles, vertices, variables, functions]. Bare Feynman \
vertices are not complete lower-point amplitudes for constructive \
factorization.", "Notes"], Cell["Parameters are inert model-local \
ModelParameter objects. Reading two models does not assign global symbols \
such as Me or EE, and one model cannot silently change another model's \
values.", "Notes"], Cell["Use the QED model containing three-point vertices \
for diagrams. Use a model containing complete four-point amplitudes when \
factorizing a five-point process, and complete five-point amplitudes when \
factorizing a six-point process. An amplitude missing from the supplied \
factorization model is treated as zero.", "Notes"],
  Cell["The reader reports malformed, unavailable or unterminated model \
tables as failures rather than executing arbitrary expressions from model \
text.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Read the bundled QED three-point model and see its four sections.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "Length", "[", "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"4"}]], "Output"],
  Cell["Retrieve a mass and its locally resolved numerical value.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "me", " ", "=", " ", "ModelParameter", "[", "qedModel", ",", " ",
      "\"Me\"", "]", ";", "\n", "me", " ", "/.", " ", "ModelParameterRules",
      "[", "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"1", "/", "2000"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], "  \[Bullet]  ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"],
     "  \[Bullet]  ", ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], "  \[Bullet]  ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"],
     "  \[Bullet]  ", ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ReadModel - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
