Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SpinorEps", "ObjectName"],
  Cell[TextData[{"Represents the antisymmetric tensor used to raise and lower \
massive little-group indices."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorEps", "[", "variance", ",", " ",
         "i", ",", " ", "j", "]"}]], "InlineFormula"], "  ", "represents the \
antisymmetric little-group tensor with the given index variance."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"The variance argument is \"Upper\" or \"Lower\". The other \
two arguments are little-group index labels, not external-particle labels. \
These tensors arise when explicit massive spinor indices are contracted."}],
   "Notes"], Cell[TextData[{"For ordinary amplitude calculations, start with \
implicit massive spinors and use ", ButtonBox["MakeIndicesExplicit",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/MakeIndicesExplicit"], " or ",
     ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"],
     " as needed. Apply ", ButtonBox["ReduceSpinContractions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinContractions"], " to sew the supported \
repeated indices rather than replacing their signs by hand."}], "Notes"],
  Cell[TextData[{"Little-group index contraction and permutation of identical \
external particles are different operations. Symmetrizing the indices of one \
massive particle is handled by ", ButtonBox["SymmetrizeSpin",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpin"],
     "."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Write a lower little-group epsilon tensor with the two \
symbolic spin indices i and j."}], "ExampleText"],
  Cell[BoxData[RowBox[{"InputForm", "[", "SpinorEps", "[", "\"Lower\"", ",",
      " ", "i", ",", " ", "j", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"InputForm", "[", "SpinorEps", "[", "\"Lower\"", ",",
      " ", "i", ",", " ", "j", "]", "]"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     "  \[Bullet]  ", ButtonBox["Spinor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Spinor"], "  \[Bullet]  ",
     ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SpinorEps - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
