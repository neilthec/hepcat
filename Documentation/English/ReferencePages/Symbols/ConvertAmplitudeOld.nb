  Cell[TextData[{Cell[BoxData[RowBox[{"ConvertAmplitudeOld", "[", "string",
         ",", " ", "particles", "]"}]], "InlineFormula"], "  ", "Use the \
older string-replacement converter; new code should use ConvertAmplitude."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["This historical \
implementation predates the model-local parameter parser. Its original \
spinor-type setup is no longer active in the function, so it is not a \
supported replacement for the current row-based converter.", "Notes"],
  Cell["The old implementation uses general string replacement and expression \
conversion. Do not use it to import arbitrary model text or rely on it for \
multi-digit labels.", "Notes"], Cell["For new work, load an entire model with \
ReadModel or call ConvertAmplitude with a full row and particle table.",
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["A scalar constant is a minimal compatibility example.",
   "ExampleText"], Cell[BoxData[RowBox[{"ConvertAmplitudeOld", "[", "\"1\"",
      ",", " ", "{", "}", "]"}]], "Input"], Cell[BoxData[RowBox[{"1"}]],
   "Output"], Cell["Use the current converter for a typed amplitude.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "ConvertAmplitude", "[", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "1", ",", " ", "\"<12>\"", "}", ",", " ",
      "qedModel", "[", "[", "1", "]", "]", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
