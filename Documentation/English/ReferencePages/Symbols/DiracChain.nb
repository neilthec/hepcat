Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["DiracChain", "ObjectName"],
  Cell[TextData[{"Represents a fermion-line numerator between specified \
external fermion endpoints."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracChain", "[", "bar", ",", " ",
         "word", ",", " ", "ket", "]"}]], "InlineFormula"], "  ",
     "joins FermionBar and FermionKet endpoints through one DiracWord."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracChain", "[", "bar", ",", "word",
         ",", "ket", "]"}]], "InlineFormula"], " joins a ",
     ButtonBox["FermionBar", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FermionBar"], " to a ",
     ButtonBox["FermionKet", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FermionKet"], " through an ordered ",
     ButtonBox["DiracWord", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracWord"], ". It is the Feynman \
representation of a fermion bilinear before conversion to angle and square \
brackets."}], "Notes"], Cell[TextData[{"The endpoints determine the external \
particles and the word determines the numerator operators. A scalar coupling \
uses an empty word; a vector interaction inserts a gamma matrix; a fermion \
propagator can contribute a momentum slash."}], "Notes"],
  Cell[TextData[{ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " converts \
a complete contracted expression containing one or more chains. ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " can also accept \
raw diagram amplitudes together with their Feynman model and perform the \
conversion for you."}], "Notes"],
  Cell[TextData[{"Keep the pairing and signs produced by diagram generation \
when an amplitude contains several fermion lines. Exchanging endpoints by \
hand can change the fermionic statistics sign. All symbolic momenta use \
HEPCAT's all-incoming convention."}], "Notes"],
  Cell[TextData[{"An internal slash within the word remains off shell. The \
external equations of motion and the Clifford algebra are sufficient for the \
ordinary conversion; diagram-local constructive shell assumptions are not \
used."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Construct a scalar bilinear."}], "ExampleText"],
  Cell[BoxData[RowBox[{"bilinear", " ", "=", " ", "DiracChain", "[",
      "FermionBar", "[", "1", ",", " ", "m", ",", " ", "\"Dirac\"", "]", ",",
      " ", "DiracWord", "[", "]", ",", " ", "FermionKet", "[", "2", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracChain", "[", "FermionBar", "[", "1", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", ",", " ", "DiracWord", "[", "]", ",",
      " ", "FermionKet", "[", "2", ",", " ", "m", ",", " ", "\"Dirac\"", "]",
      "]"}]], "Output"],
  Cell[TextData[{"Convert its endpoints into spinor products."}],
   "ExampleText"], Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[",
      "bilinear", "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"-", InterpretationBox[
         TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
             StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"],
           TemplateBox[{StyleBox["2", Bold, StripOnInput -> False],
             "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
         SpinorChain[Spinor["Spin", "Angle", 1], Spinor["Spin", "Angle", 2]],
         Editable -> False]}], "-", InterpretationBox[
       TemplateBox[{TemplateBox[{"\"[\"", StyleBox["1", Bold,
            StripOnInput -> False]}, "RowDefault"], TemplateBox[
          {StyleBox["2", Bold, StripOnInput -> False], "\"]\""},
          "RowDefault"]}, "RowDefault"], SpinorChain[Spinor["Spin", "Square",
         1], Spinor["Spin", "Square", 2]], Editable -> False]}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["DiracWord", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracWord"], "  \[Bullet]  ",
     ButtonBox["FermionBar", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FermionBar"], "  \[Bullet]  ",
     ButtonBox["FermionKet", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FermionKet"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"]}],
   "SeeAlso"], Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "DiracChain - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
