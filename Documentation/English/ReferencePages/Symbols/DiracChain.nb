Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["DiracChain", "ObjectName"],
  Cell["Represents an ordered external-fermion bilinear.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracChain", "[", "bar", ",", " ",
         "word", ",", " ", "ket", "]"}]], "InlineFormula"], "  ",
     "joins FermionBar and FermionKet endpoints through one DiracWord."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["Order is part of the \
expression. Keep gamma matrices and internal momentum slashes inside the \
DiracWord.", "Notes"], Cell["All external labels follow HEPCAT's incoming \
convention. Internal Feynman numerator momenta remain off shell.", "Notes"],
  Cell["When several fermion lines occur, retain the explicit pairing and \
signs generated by diagramAmplitudes instead of rearranging endpoints by \
hand.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Construct a scalar bilinear.", "ExampleText"],
  Cell[BoxData[RowBox[{"bilinear", " ", "=", " ", "DiracChain", "[",
      "FermionBar", "[", "1", ",", " ", "m", ",", " ", "\"Dirac\"", "]", ",",
      " ", "DiracWord", "[", "]", ",", " ", "FermionKet", "[", "2", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracChain", "[", "FermionBar", "[", "1", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", ",", " ", "DiracWord", "[", "]", ",",
      " ", "FermionKet", "[", "2", ",", " ", "m", ",", " ", "\"Dirac\"", "]",
      "]"}]], "Output"], Cell["Convert its endpoints into spinor products.",
   "ExampleText"], Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[",
      "bilinear", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {RowBox[{"-", TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
            StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"],
          TemplateBox[{StyleBox["2", Bold, StripOnInput -> False],
            "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"]}],
      "-", TemplateBox[{TemplateBox[{"\"[\"", StyleBox["1", Bold,
           StripOnInput -> False]}, "RowDefault"],
        TemplateBox[{StyleBox["2", Bold, StripOnInput -> False], "\"]\""},
         "RowDefault"]}, "RowDefault"]}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["DiracWord", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracWord"], "  \[Bullet]  ",
     ButtonBox["FermionBar", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FermionBar"], "  \[Bullet]  ",
     ButtonBox["FermionKet", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FermionKet"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"]}],
   "SeeAlso"], Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "DiracChain - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/DiracChain", "title" -> "DiracChain",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
