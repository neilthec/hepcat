           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ColorTrace", "ObjectName"],
  Cell[TextData[
    {"Represents an ordered fundamental SU(3) generator trace."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorTrace", "[", "a", ",", " ", "b",
         ",", " ", "...", "]"}]], "InlineFormula"], "  ",
     "represents Tr(T^a T^b ...) in the written order."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorTrace", "[", "]"}]],
      "InlineFormula"], "  ",
     "represents the trace of the fundamental identity."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[
    {"The arguments are adjoint color labels, not generator matrices: ",
     Cell[BoxData[RowBox[{"ColorTrace", "[", "a", ",", "b", ",", "c", "]"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "means", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"Tr", "(", "T", "^", "a", " ",
         "T", "^", "b", " ", "T", "^", "c", ")"}]], "InlineFormula"], ". \
Generator order matters. Notebook output shows the trace in this familiar \
notation while preserving the underlying expression."}], "Notes"],
  Cell[TextData[{"Use ", ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"], " to apply trace \
normalization, cyclicity and completeness identities. For example, a \
one-generator trace vanishes, the empty trace is 3, and a repeated dummy in "\
, Cell[BoxData[RowBox[{"ColorTrace", "[", "a", ",", "a", "]"}]],
      "InlineFormula"], " sums to 4."}], "Notes"],
  Cell[TextData[{"Repeated symbolic dummy labels are summed by the reducer. \
Literal positive integers select fixed generator components. External ",
     ButtonBox["ColorIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorIndex"], " labels remain free \
unless an explicit external-color sum is requested. Conjugation reverses \
generator order, as required for Hermitian SU(3) generators."}], "Notes"],
  Cell[TextData[{"Ordered traces and indexed ", ButtonBox["ColorGenerator",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ColorGenerator"],
     " tensors use the same exact SU(3) color basis. They can participate in \
coherent amplitude comparisons and numerical SPINAS color sums without \
discarding interference."}], "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Write an ordered trace. Its notebook appearance is \
conventional trace notation."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ColorTrace", "[", "ColorIndex", "[", "3", "]", ",",
      " ", "ColorIndex", "[", "4", "]", ",", " ", "ColorIndex", "[", "5",
      "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[TemplateBox[{"\"Tr(\"",
       TemplateBox[{TemplateBox[{"\"T\"", SubscriptBox["\"c\"", "3"]},
          "Superscript", SyntaxForm -> SuperscriptBox], "\"\[ThinSpace]\"",
         TemplateBox[{"\"T\"", SubscriptBox["\"c\"", "4"]}, "Superscript",
          SyntaxForm -> SuperscriptBox], "\"\[ThinSpace]\"",
         TemplateBox[{"\"T\"", SubscriptBox["\"c\"", "5"]}, "Superscript",
          SyntaxForm -> SuperscriptBox]}, "RowDefault"], "\")\""},
      "RowDefault"], ColorTrace[ColorIndex[3], ColorIndex[4], ColorIndex[5]],
     Editable -> False]], "Output"],
  Cell[TextData[{"Reduce a contracted four-generator trace."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceColor", "[", "ColorTrace",
      "[", "a", ",", " ", "b", ",", " ", "a", ",", " ", "b", "]", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"-", "2", "/", "3"}]], "Output"],
  Cell[TextData[{"Literal generator labels select a fixed component rather \
than a sum over the adjoint index."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceColor", "[", "ColorTrace", "[", "1", ",", " ",
      "1", "]", "]"}]], "Input"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"], "  \[Bullet]  ",
     ButtonBox["ColorGenerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorGenerator"], "  \[Bullet]  ",
     ButtonBox["ColorStructure", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorStructure"], "  \[Bullet]  ",
     ButtonBox["ColorDelta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorDelta"], "  \[Bullet]  ",
     ButtonBox["ColorIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorIndex"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
