Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ColorGenerator", "ObjectName"],
  Cell[TextData[{"Represents a fundamental SU(3) generator with ordered quark \
and gluon color slots."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorGenerator", "[",
         "antifundamental", ",", " ", "fundamental", ",", " ", "adjoint",
         "]"}]], "InlineFormula"], "  ",
     "represents a fundamental SU(3) generator."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorGenerator", "[",
         "antifundamental", ",", "fundamental", ",", "adjoint", "]"}]],
      "InlineFormula"], " records the color factor at a quark-gluon \
interaction. The order identifies which indices belong to the conjugate \
quark, quark and gluon representations."}], "Notes"],
  Cell[TextData[{"The normalization is the CalcHEP generator convention ",
     Cell[BoxData[RowBox[{"lambda", "/", "2"}]], "InlineFormula"], ". \
Reordering the slots is therefore a change of the color tensor, rather than a \
display rearrangement."}], "Notes"],
  Cell[TextData[{"HEPCAT retains this tensor when ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " converts \
the accompanying Dirac and Lorentz algebra. External slots can be labeled \
with ", ButtonBox["ColorIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorIndex"],
     "; internal slots are local contraction labels."}], "Notes"],
  Cell[TextData[{"An explicit generator tensor carries color-state \
information. A numerical squared matrix element still requires the \
appropriate contractions, sums and incoming-state averages. The complete \
SPINAS process exporter supports explicit SU(3) color amplitudes and retains \
their coherent interference."}], "Notes"],
  Cell[TextData[{"Notebook output uses standard color notation automatically \
and retains the exact symbolic object when copied. ",
     ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"], " works on these same \
tensors; no separate legacy color notation is needed."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Retain the ordered antiquark, quark and gluon color slots \
of a quark-gluon vertex."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ColorGenerator", "[", "ColorIndex", "[", "1", "]",
      ",", " ", "ColorIndex", "[", "2", "]", ",", " ", "ColorIndex", "[",
      "3", "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[SubscriptBox[
      TemplateBox[{"\"(\"", TemplateBox[{"\"T\"", SubscriptBox["\"c\"",
           "3"]}, "Superscript", SyntaxForm -> SuperscriptBox], "\")\""},
       "RowDefault"], TemplateBox[{SubscriptBox["\"c\"", "1"], "\",\"",
        SubscriptBox["\"c\"", "2"]}, "RowDefault"]],
     ColorGenerator[ColorIndex[1], ColorIndex[2], ColorIndex[3]],
     Editable -> False]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ColorIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorIndex"], "  \[Bullet]  ",
     ButtonBox["ColorDelta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorDelta"], "  \[Bullet]  ",
     ButtonBox["ColorStructure", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorStructure"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["ColorTrace", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorTrace"], "  \[Bullet]  ",
     ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ColorGenerator - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ColorGenerator", "title" -> "ColorGenerator",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" -> "Represents a fundamental SU(3) \
generator with ordered quark and gluon color slots.",
     "keywords" -> {"HEPCAT", "ColorGenerator", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]