  Cell["Represents the ordered chiral trace of momentum matrices.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorTrace", "[", "Mom", "[", "i1",
         "]", ",", " ", "Mom", "[", "i2", "]", ",", " ", "...", "]"}]],
      "InlineFormula"], "  ", "represents a momentum-matrix trace."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The order of momentum \
arguments matters. Trace reductions use HEPCAT's alternating two-component \
matrix conventions; this is not an ordinary Mathematica Tr of symbolic \
vectors.", "Notes"], Cell["ReduceSpinorProducts reduces supported traces and \
preserves chiral ordering. ExtractEnergy can turn supported chains and traces \
into explicit two-component matrix expressions.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Reduce a two-momentum trace.", "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[", "SpinorTrace", "[",
