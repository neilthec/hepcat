Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SpinorTrace", "ObjectName"],
  Cell[TextData[
    {"Represents an ordered chiral trace of momentum matrices."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorTrace", "[", "Mom", "[", "i1",
         "]", ",", " ", "Mom", "[", "i2", "]", ",", " ", "...", "]"}]],
      "InlineFormula"], "  ", "represents a momentum-matrix trace."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Each argument is a momentum insertion written with ",
     ButtonBox["Mom", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mom"], ". ",
     Cell[BoxData[RowBox[{"SpinorTrace", "[", "Mom", "[", "1", "]", ",", " ",
         "Mom", "[", "2", "]", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "is", " ", "the", " ", "two", "-", "momentum",
         " ", "chiral", " ", "trace", ";", " ", "HEPCAT", "'", "s", " ",
         "reduction", " ", "convention", " ", "gives", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"2", " ", "MomProd", "[", "1",
         ",", " ", "2", "]"}]], "InlineFormula"], ". It is not the \
four-component Dirac trace with an extra factor of two."}], "Notes"],
  Cell[TextData[
    {"Longer traces retain the order of their momentum matrices. Apply ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     " to use the supported trace and Clifford identities, or ",
     ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"],
     " to evaluate supported traces in explicit components."}], "Notes"],
  Cell[TextData[{"Trace manipulations follow the same external on-shell \
convention as spinor chains. An internal propagator is not put on shell \
merely because its momentum appears in a trace."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Reduce a two-momentum chiral trace to a scalar momentum product."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorTrace", "[", "Mom", "[", "1", "]", ",", " ", "Mom", "[", "2",
      "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"2", " ", RowBox[{SubscriptBox["p", "1"], ".",
        SubscriptBox["p", "2"]}]}]], "Output"],
  Cell[TextData[{"Display an ordered four-momentum trace."}], "ExampleText"],
  Cell[BoxData[RowBox[{"SpinorTrace", "[", "Mom", "[", "1", "]", ",", " ",
      "Mom", "[", "2", "]", ",", " ", "Mom", "[", "3", "]", ",", " ", "Mom",
      "[", "4", "]", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{"\"Tr(\"", SubscriptBox["p", "1"],
      SubscriptBox["p", "2"], SubscriptBox["p", "3"], SubscriptBox["p", "4"],
      "\")\""}, "RowDefault"]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], "  \[Bullet]  ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SpinorTrace - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
