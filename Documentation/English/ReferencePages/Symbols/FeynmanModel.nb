Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["FeynmanModel", "ObjectName"],
  Cell[TextData[{"Represents a model of particles and Feynman-rule vertices \
read from CalcHEP model tables."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FeynmanModel", "[", "particles", ",",
         " ", "vertices", ",", " ", "variables", ",", " ", "functions",
         "]"}]], "InlineFormula"], "  ",
     "stores the four model tables used by the Feynman backend."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"A ", ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"], " is the model object \
to use when you want HEPCAT to calculate a tree amplitude from ordinary \
Feynman rules. Read a model with ", ButtonBox["ReadModel",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ReadModel"],
     ", keep the returned object in a variable, and pass it to ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], ". The usual diagram \
workflow then produces Dirac and Lorentz tensors for that model."}],
   "Notes"], Cell[TextData[{"The four arguments are, in order, the particle \
table, vertex table, independent parameter table and dependent function \
table. You can inspect them with ",
     Cell[BoxData[RowBox[{"model", "[", "[", "1", "]", "]"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "through", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"model", "[", "[", "4", "]",
         "]"}]], "InlineFormula"], ". Normally you obtain these tables from \
the model reader rather than assembling the object yourself."}], "Notes"],
  Cell[TextData[{"The explicit head distinguishes a Feynman-rule model from a \
constructive model containing known amplitudes. ", ButtonBox["ReadModel",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ReadModel"], " \
selects the appropriate representation from the files in the model directory. \
A directory containing ", Cell[BoxData[RowBox[{"lgrngN", ".", "mdl"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "supplies", " ", "Feynman",
         " ", "rules", ";", " ", "a", " ", "constructive", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"ampsN", ".", "mdl"}]],
      "InlineFormula"], " file supplies on-shell amplitudes."}], "Notes"],
  Cell["Using the model in a calculation", "NotesSection"],
  Cell[TextData[{"Generate the diagrams, obtain their amplitudes, and use ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     " to express the result in HEPCAT spinor notation. ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " can perform \
conversion and ordinary reduction together when given the Feynman model."}],
   "Notes"], Cell[TextData[{"Parameters are kept in the model as ",
     ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], " objects. Loading a \
second model therefore does not replace the masses and couplings of the \
first. Use ", ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], " when you need \
the numerical values belonging to one particular model."}], "Notes"],
  Cell["Scope of the Feynman calculation", "NotesSection"],
  Cell[TextData[{"Internal Feynman propagators and their numerator momenta \
remain off shell. External wavefunctions obey the external-particle \
conventions of HEPCAT. Keeping this distinction makes the result useful as an \
independent comparison with a constructive amplitude."}], "Notes"],
  Cell[TextData[{"The supported physical tree backend uses unitary-gauge \
massive-vector propagators and excludes Goldstone and ghost exchange \
consistently. Model interactions and particle data still come from the \
supplied CalcHEP tables. Unsupported Majorana flow or higher-spin fields \
return ", Cell[BoxData[RowBox[{"Failure"}]], "InlineFormula"], "."}],
   "Notes"], Cell[TextData[{"For a factorization check, supply a constructive \
model containing complete lower-point amplitudes to ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ". A \
table of Feynman vertices describes the interactions, and is not itself a \
table of those complete amplitudes."}], "Notes"],
  Cell["Consistent field conventions", "NotesSection"],
  Cell[TextData[{"A lower-point amplitude becomes an ingredient of \
higher-point factorization. Its sign must therefore follow one consistent \
convention throughout the model. The bundled constructive SM vertices use the \
same charged-current sign as the unchanged CalcHEP vertex table, for both W \
charges and all fermion generations. All values live in the model tables; the \
generic reader and converter contain no SM-specific sign adjustment."}],
   "Notes"], Cell[TextData[{"A consistent field-basis change must be applied \
at every vertex. For example, reversing both charged W fields multiplies \
every complete tree by the product of its external W phases. Each internal W \
pairs W+ with W-, so its two minus signs cancel. The same argument holds for \
products of lower-point amplitudes on every factorization channel, at any \
multiplicity. Regenerate lower-point amplitudes from the corrected vertices \
instead of flipping final formulas one by one. ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], " retains an \
unexplained opposite sign as a diagnostic that prevents a validated \
construction."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "feynmanModelDirectory", " ", "=", " ",
         "\"~/code/hepcat/model_feynman\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[{"Read the bundled massive-electron QED Feynman model."}],
   "ExampleText"], Cell[BoxData[RowBox[{"fm", " ", "=", " ", "ReadModel",
      "[", "feynmanModelDirectory", ",", " ", "2", "]", ";", " ", "Head",
      "[", "fm", "]"}]], "Input"], Cell[BoxData[RowBox[{"FeynmanModel"}]],
   "Output"],
  Cell[TextData[{"Inspect the four tables without changing the model."}],
   "ExampleText"], Cell[BoxData[RowBox[{"Length", " ", "/@", " ", "(",
      "List", " ", "@@", " ", "fm", ")"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "2", ",", " ", "1", ",", " ", "2", ",", " ", "0",
      "}"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], "  \[Bullet]  ",
     ButtonBox["DiagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudes"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "FeynmanModel - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
