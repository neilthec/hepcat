Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["FeynmanModel", "ObjectName"],
  Cell["Represents a model specified by off-shell Feynman rules.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FeynmanModel", "[", "particles", ",",
         " ", "vertices", ",", " ", "variables", ",", " ", "functions",
         "]"}]], "InlineFormula"], "  ",
     "stores the four model tables used by the Feynman backend."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["ReadModel automatically returns this \
head when the selected model contains CalcHEP lgrngN.mdl rules instead of \
constructive ampsN.mdl amplitudes.", "Notes"], Cell["The four parts are the \
particle table, vertex table, independent parameters and dependent functions. \
ModelParameter keeps each model's parameters local, so several models can be \
used together.", "Notes"], Cell["Use the same CreateDiagrams and \
diagramAmplitudes workflow as for a constructive model. The model head \
selects ordered Dirac and Lorentz tensors with off-shell internal \
propagators.", "Notes"], Cell["The supported tree backend uses unitary gauge \
for massive vectors, excludes ghosts and Goldstones consistently, and retains \
the CalcHEP tensor auxiliary for the four-gluon interaction. Unsupported \
Majorana flow or higher-spin fields return Failure.", "Notes"],
  Cell["A Feynman vertex table is not a table of complete lower-point \
amplitudes. Use a constructive model containing complete amplitudes as the \
factorization model.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Read the bundled massive-electron QED Feynman model.",
   "ExampleText"], Cell[BoxData[RowBox[{"fm", " ", "=", " ", "ReadModel",
      "[", "feynmanModelDirectory", ",", " ", "2", "]", ";", " ", "Head",
      "[", "fm", "]"}]], "Input"], Cell[BoxData[RowBox[{"FeynmanModel"}]],
   "Output"], Cell["Inspect the four tables without changing the model.",
   "ExampleText"], Cell[BoxData[RowBox[{"Length", " ", "/@", " ", "(",
      "List", " ", "@@", " ", "fm", ")"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "2", ",", " ", "1", ",", " ", "2", ",", " ", "0",
      "}"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], "  \[Bullet]  ",
     ButtonBox["diagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/diagramAmplitudes"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "FeynmanModel - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
