Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ExtractEnergy", "ObjectName"],
  Cell["Evaluates supported spinor chains as explicit energy-angle matrix \
expressions.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractEnergy", "[", "expr", ",", " ",
         "particleSpins", "]"}]], "InlineFormula"], "  ", "substitutes \
momentum matrices and two-component spinors for the listed particles."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["A massless or scalar \
entry can be {particle}. A massive spin entry is {particle,spin,projection}, \
using physical spin values such as {1,1/2,1/2}.", "Notes"],
  Cell["Results use En[i], MomMagnitude[i], Theta[i] and Phi[i]. The spatial \
momentum convention is p(sin(theta)cos(phi),sin(theta)sin(phi),cos(theta)).",
   "Notes"], Cell["Internally, ExtractEnergy1 substitutes momentum matrices \
and ExtractEnergy2 substitutes spinor rows and columns; the final pass \
evaluates Dot and Tr.", "Notes"], Cell["Supply a complete and consistent \
on-shell configuration for numerical use. The function does not generate \
phase space or enforce total momentum conservation.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Evaluate an angle bracket in explicit massless components.",
   "ExampleText"], Cell[BoxData[RowBox[{"ExtractEnergy", "[", "SpinorChain",
      "[", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ",
      "1", "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "2", "]", "]", ",", " ", "{", "{", "1", "}",
      ",", " ", "{", "2", "}", "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"2", "*", "E", "^", "(", "I", "*", "Phi", "[", "1",
      "]", ")", "*", "Cos", "[", "Theta", "[", "2", "]", "/", "2", "]", "*",
      "Sqrt", "[", "En", "[", "1", "]", "]", "*", "Sqrt", "[", "En", "[",
      "2", "]", "]", "*", "Sin", "[", "Theta", "[", "1", "]", "/", "2", "]",
      " ", "-", " ", "2", "*", "E", "^", "(", "I", "*", "Phi", "[", "2", "]",
      ")", "*", "Cos", "[", "Theta", "[", "1", "]", "/", "2", "]", "*",
