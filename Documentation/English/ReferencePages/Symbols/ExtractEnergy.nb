Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ExtractEnergy", "ObjectName"],
  Cell[TextData[{"Evaluates supported spinor expressions in an explicit \
energy, momentum-angle and spin basis."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractEnergy", "[", "expr", ",", " ",
         "particleSpins", "]"}]], "InlineFormula"], "  ", "substitutes \
momentum matrices and two-component spinors for the listed particles."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractEnergy", "[", "expr", ",", " ",
         "particleSpins", ",", " ", "\"MassRules\"", " ", "->", " ", "{",
         "Mass", "[", "i", "]", " ", "->", " ", "mass", ",", " ", "...", "}",
         "]"}]], "InlineFormula"], "  ", "supplies known external on-shell \
masses for stable numerical evaluation."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this to inspect a bracket numerically or compare an \
identity at a chosen set of momenta. It replaces supported momentum matrices \
and spinor endpoints by two-component expressions and evaluates the resulting \
matrix products and traces."}], "Notes"],
  Cell[TextData[{"The particle list tells HEPCAT which external labels to \
evaluate. An entry {i} handles a massless or scalar leg. A massive spin entry \
{i, spin, projection}, such as {1,1/2,1/2}, also chooses its physical spin \
component."}], "Notes"],
  Cell[TextData[{"The result uses ", ButtonBox["En", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/En"], "[i], ",
     ButtonBox["MomMagnitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomMagnitude"], "[i], ",
     ButtonBox["Theta", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Theta"], "[i] and ", ButtonBox["Phi",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/Phi"], "[i]. The \
spatial momentum is p {Sin[theta] Cos[phi], Sin[theta] Sin[phi], Cos[theta]}. \
Substitute a complete, consistent set of these values after constructing the \
expression."}], "Notes"], Cell[TextData[{"The function evaluates the supplied \
configuration; it does not generate conserved phase space or repair \
inconsistent momenta. To compare complete scattering amplitudes at controlled \
kinematics, use ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], "."}], "Notes"],
  Cell["Masses and highly boosted particles", "NotesSection"],
  Cell[TextData[{"Supply known external masses through the string option ",
     Cell[BoxData[RowBox[{"\"MassRules\"", " ", "->", " ", "{", "Mass", "[",
         "1", "]", " ", "->", " ", "me", ",", " ", "...", "}"}]],
      "InlineFormula"], ". For supported positive-energy, on-shell numerical \
input, HEPCAT can then evaluate the small spinor component sqrt(E-p) as \
Abs[m]/sqrt(E+p), avoiding subtraction of almost equal numbers."}], "Notes"],
  Cell[TextData[{"The supplied mass is independent physical input. Once \
rounded energy and momentum values have become equal, their difference cannot \
recover a tiny mass. The numerical consistency checks protect the stable \
substitution but do not prove that tiny mass from rounded data."}], "Notes"],
  Cell[TextData[{"Symbolic formulas, signed-energy inputs, and unsupported \
branches retain their corresponding expressions. Supplying external masses \
does not impose an internal propagator's mass shell."}], "Notes"],
  Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MassRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Known external on-shell masses for \
ExtractEnergy numerical evaluation, supplied as {Mass[leg] -> mass, ...}. The \
default {} preserves the existing energy-angle formulas. Supplied masses \
permit stable small spinor components and supported momentum expressions; \
they do not impose internal propagator shells."}], "TableText"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Left, Left}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.23], Scaled[0.19],
         Scaled[0.58]}}, GridBoxDividers ->
      {"Rows" -> {False, True, {False}, False}}]], "3ColumnTableMod"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"], Cell["Explicit components",
   "ExampleSubsection"],
  Cell[TextData[
    {"Evaluate an angle bracket in explicit massless components."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ExtractEnergy", "[", "SpinorChain",
      "[", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ",
      "1", "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "2", "]", "]", ",", " ", "{", "{", "1", "}",
      ",", " ", "{", "2", "}", "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"2", "*", "E", "^", "(", "I", "*", "Phi", "[", "1",
      "]", ")", "*", "Cos", "[", "Theta", "[", "2", "]", "/", "2", "]", "*",
      "Sqrt", "[", "En", "[", "1", "]", "]", "*", "Sqrt", "[", "En", "[",
      "2", "]", "]", "*", "Sin", "[", "Theta", "[", "1", "]", "/", "2", "]",
      " ", "-", " ", "2", "*", "E", "^", "(", "I", "*", "Phi", "[", "2", "]",
      ")", "*", "Cos", "[", "Theta", "[", "1", "]", "/", "2", "]", "*",
      "Sqrt", "[", "En", "[", "1", "]", "]", "*", "Sqrt", "[", "En", "[",
      "2", "]", "]", "*", "Sin", "[", "Theta", "[", "2", "]", "/", "2",
      "]"}]], "Output"], Cell["Explicit components", "ExampleSubsection"],
  Cell[TextData[{"Evaluate a scalar momentum product."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ExtractEnergy", "[", "MomProd", "[", "1", ",", " ",
      "2", "]", ",", " ", "{", "{", "1", "}", ",", " ", "{", "2", "}", "}",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"En", "[", "1", "]", "*", "En", "[", "2", "]", " ",
      "-", " ", "Cos", "[", "Theta", "[", "1", "]", "]", "*", "Cos", "[",
      "Theta", "[", "2", "]", "]", "*", "MomMagnitude", "[", "1", "]", "*",
      "MomMagnitude", "[", "2", "]", " ", "-", " ", "Cos", "[", "Phi", "[",
      "1", "]", "]", "*", "Cos", "[", "Phi", "[", "2", "]", "]", "*",
      "MomMagnitude", "[", "1", "]", "*", "MomMagnitude", "[", "2", "]", "*",
      "Sin", "[", "Theta", "[", "1", "]", "]", "*", "Sin", "[", "Theta", "[",
      "2", "]", "]", " ", "-", " ", "MomMagnitude", "[", "1", "]", "*",
      "MomMagnitude", "[", "2", "]", "*", "Sin", "[", "Phi", "[", "1", "]",
      "]", "*", "Sin", "[", "Phi", "[", "2", "]", "]", "*", "Sin", "[",
      "Theta", "[", "1", "]", "]", "*", "Sin", "[", "Theta", "[", "2", "]",
      "]"}]], "Output"], Cell["Highly boosted massive particles",
   "ExampleSubsection"], Cell[TextData[{"Retain a tiny massive spinor \
component after machine energy and momentum have rounded to the same value. \
The result is nonzero because the mass is supplied independently."}],
   "ExampleText"], Cell[BoxData[RowBox[{"energyExpression", " ", "=", " ",
      "ExtractEnergy", "[", "\n", " ", " ", "SpinorChain", "[", "Spinor",
      "[", "\"Spin\"", ",", " ", "\"Upper\"", ",", " ", "\"Angle\"", ",",
      " ", "1", ",", " ", "1", "/", "2", "]", ",", "\n", " ", " ", " ", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2",
      "]", "]", ",", " ", "{", "{", "1", "}", ",", " ", "{", "2", "}", "}",
      ",", "\n", " ", " ", "\"MassRules\"", " ", "->", " ", "{", "Mass", "[",
      "1", "]", " ", "->", " ", "1", "/", "2000", ",", " ", "Mass", "[", "2",
      "]", " ", "->", " ", "0", "}", "]", ";", "\n", "energyExpression", " ",
      "/.", " ", "{", "En", "[", "1", "]", " ", "->", " ", "10.", "^", "12",
      ",", " ", "MomMagnitude", "[", "1", "]", " ", "->", " ", "10.", "^",
      "12", ",", "\n", " ", " ", "Theta", "[", "1", "]", " ", "->", " ",
      "0.", ",", " ", "Phi", "[", "1", "]", " ", "->", " ", "0.", ",", " ",
      "En", "[", "2", "]", " ", "->", " ", "1.", ",", "\n", " ", " ",
      "MomMagnitude", "[", "2", "]", " ", "->", " ", "1.", ",", " ", "Theta",
      "[", "2", "]", " ", "->", " ", "0.", ",", " ", "Phi", "[", "2", "]",
      " ", "->", " ", "0.", "}"}]], "Input"],
  Cell[BoxData[RowBox[{"5.*^-10", " ", "+", " ", "0.", "*", "I"}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["En", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/En"], "  \[Bullet]  ",
     ButtonBox["MomMagnitude", BaseStyle -> "Link",
