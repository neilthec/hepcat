Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PlainText", "ObjectName"],
  Cell["Writes readable bracket notation or explicit model-readable amplitude \
text.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PlainText", "[", "expr", "]"}]],
      "InlineFormula"], "  ", "returns compact human-readable text."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PlainText", "[", "expr", ",", " ",
         "\"Model\"", "]"}]], "InlineFormula"], "  ", "returns explicit text \
suitable for storing a supported exact expression in a HEPCAT model."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The ordinary form uses \
angle and square bracket notation. Model mode inserts explicit multiplication \
and typed forms where compact notation would be ambiguous.", "Notes"],
  Cell["Model mode returns Failure for unsupported or inexact objects rather \
than silently emitting an ambiguous model expression. Exact symbolic \
coefficients and rational numbers are preferred.", "Notes"],
  Cell["The output is a string. For a complete C++ process, use \
WriteSPINASProcess; for adding amplitudes to a factorization model, use \
AppendModelAmplitudes.", "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Write a readable bracket expression.", "ExampleText"],
  Cell[BoxData[RowBox[{"PlainText", "[", "2", " ", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"2*<12>\""}]], "Output"],
  Cell["Write an exact expression in model syntax.", "ExampleText"],
  Cell[BoxData[RowBox[{"PlainText", "[", "(", "2", "/", "3", ")", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", ",",
      " ", "\"Model\"", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"((2/3)*<12>)\""}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ConvertStringAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConvertStringAmplitude"],
     "  \[Bullet]  ", ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"],
     "  \[Bullet]  ", ButtonBox["TeX", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/TeX"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
