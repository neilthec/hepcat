Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PlainText", "ObjectName"],
  Cell[TextData[{"Converts a spinor expression to readable bracket text or \
exact model-file syntax."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PlainText", "[", "expr", "]"}]],
      "InlineFormula"], "  ", "returns compact human-readable text."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PlainText", "[", "expr", ",", " ",
         "\"Model\"", "]"}]], "InlineFormula"], "  ", "returns explicit text \
suitable for storing a supported exact expression in a HEPCAT model."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"PlainText[expression] returns a string using compact angle \
and square brackets. It is useful for a plain-text derivation, a message, or \
a quick inspection of a formula outside the notebook display."}], "Notes"],
  Cell[TextData[{"PlainText[expression,\"Model\"] has a different purpose: it \
writes a supported exact expression so the model reader can recover its \
meaning. It inserts explicit multiplication and typed forms wherever compact \
bracket notation would be ambiguous."}], "Notes"],
  Cell[TextData[{"Model mode refuses unsupported or inexact objects with \
Failure. Use exact rational coefficients and symbolic model parameters when \
saving a reusable analytic amplitude; machine decimal approximations may have \
already discarded information."}], "Notes"],
  Cell[TextData[
    {"To append a known amplitude to a factorization model, use ",
     ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"], ", which also \
checks the model entry. To generate a complete numerical C++ project, use ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"],
     ". PlainText by itself only returns text and writes no files."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"], Cell["Readable text",
   "ExampleSubsection"],
  Cell[TextData[{"Write a readable bracket expression."}], "ExampleText"],
  Cell[BoxData[RowBox[{"PlainText", "[", "2", " ", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"2*<12>\""}]], "Output"],
  Cell["Model-file text", "ExampleSubsection"],
  Cell[TextData[{"Write an exact expression in model syntax."}],
   "ExampleText"], Cell[BoxData[RowBox[{"PlainText", "[", "(", "2", "/", "3",
      ")", " ", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", ",",
      " ", "\"Model\"", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"((2/3)*<12>)\""}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ConvertStringAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConvertStringAmplitude"],
     "  \[Bullet]  ", ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"],
     "  \[Bullet]  ", ButtonBox["TeX", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/TeX"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FormattingAndExport"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "PlainText - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/PlainText", "title" -> "PlainText",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" -> "Converts a spinor expression to \
readable bracket text or exact model-file syntax.",
     "keywords" -> {"HEPCAT", "PlainText", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]