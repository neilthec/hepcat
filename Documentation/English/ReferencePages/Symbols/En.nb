   "AnchorBarGrid"], Cell["En", "ObjectName"],
  Cell[
   "Labels the energy of an external particle in explicit spinor formulas.",
   "Notes"], Cell[TextData[{Cell[BoxData[RowBox[{"En", "[", "i", "]"}]],
      "InlineFormula"], "  ",
     "constructs the corresponding symbolic object."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["ExtractEnergy returns expressions in \
En[i], MomMagnitude[i], Theta[i] and Phi[i]. Supply consistent numerical \
on-shell kinematics before numerical evaluation.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Inspect a symbolic example.", "ExampleText"],
  Cell[BoxData[RowBox[{"ExtractEnergy", "[", "MomProd", "[", "1", ",", " ",
      "2", "]", ",", " ", "{", "{", "1", "}", ",", " ", "{", "2", "}", "}",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"En", "[", "1", "]", "*", "En", "[", "2", "]", " ",
      "-", " ", "Cos", "[", "Theta", "[", "1", "]", "]", "*", "Cos", "[",
      "Theta", "[", "2", "]", "]", "*", "MomMagnitude", "[", "1", "]", "*",
      "MomMagnitude", "[", "2", "]", " ", "-", " ", "Cos", "[", "Phi", "[",
      "1", "]", "]", "*", "Cos", "[", "Phi", "[", "2", "]", "]", "*",
      "MomMagnitude", "[", "1", "]", "*", "MomMagnitude", "[", "2", "]", "*",
      "Sin", "[", "Theta", "[", "1", "]", "]", "*", "Sin", "[", "Theta", "[",
      "2", "]", "]", " ", "-", " ", "MomMagnitude", "[", "1", "]", "*",
      "MomMagnitude", "[", "2", "]", "*", "Sin", "[", "Phi", "[", "1", "]",
      "]", "*", "Sin", "[", "Phi", "[", "2", "]", "]", "*", "Sin", "[",
      "Theta", "[", "1", "]", "]", "*", "Sin", "[", "Theta", "[", "2", "]",
      "]"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"], "  \[Bullet]  ",
     ButtonBox["MomMagnitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomMagnitude"], "  \[Bullet]  ",
