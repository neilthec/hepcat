Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SpinorExpressionComplexity", "ObjectName"],
  Cell[TextData[{"Scores the size of a spinor expression, with extra weight \
for momentum insertions and scalar momentum products."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorExpressionComplexity", "[",
         "expr", "]"}]], "InlineFormula"], "  ", "counts terms, momentum \
insertions and scalar momentum products with the package's simplification \
weights."}], "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this to compare intermediate forms produced by ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"], ", ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], ", or a manually \
chosen identity route. A smaller value generally favors fewer terms and fewer \
momentum insertions."}], "Notes"],
  Cell[TextData[
    {"The score accounts for branches hidden in composite momentum slots. ",
     Cell[BoxData[RowBox[{"Mom", "[", "Multiparticle", "[", "1", ",", "3",
         "]", "]"}]], "InlineFormula"], " inside a chain represents two \
momentum contributions, so packing a sum into a single label does not make it \
artificially inexpensive."}], "Notes"],
  Cell[TextData[{"Physical ", ButtonBox["PropDen", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PropDen"], " factors are treated as \
opaque. The score measures a practical algebraic representation, not \
numerical stability, high-energy behavior, or whether the amplitude is \
physically correct. Use ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"],
     " for those separate tests."}], "Notes"],
  Cell[TextData[{"Two equivalent expressions can have different scores, and \
the lower-scoring intermediate form need not lie on the shortest route to the \
final answer. Retain useful alternative routes when a temporary increase \
exposes a later cancellation."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Compare a bracket with a chain containing two momentum insertions."}],
   "ExampleText"], Cell[BoxData[RowBox[{"{", "SpinorExpressionComplexity",
      "[", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", "]",
      ",", " ", "SpinorExpressionComplexity", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Mom", "[", "3", "]", ",", " ", "Mom", "[", "4", "]",
      ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",",
      " ", "2", "]", "]", "]", "}"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "1", ",", " ", "9", "}"}]], "Output"],
  Cell[TextData[{"Inspect a single expression's score."}], "ExampleText"],
  Cell[BoxData[RowBox[{"SpinorExpressionComplexity", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"1"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["SpinorIdentityCandidates",
