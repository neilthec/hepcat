Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SPINAS", "ObjectName"],
  Cell[TextData[{"Converts supported chains and algebra to the earlier SPINAS \
C++ expression notation."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SPINAS", "[", "expr", "]"}]],
      "InlineFormula"], "  ",
     "returns a C++ expression using the older named-product convention."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"This expression formatter is retained for older scripts \
that assemble their own C++ process files. It returns text referring to named \
spinor products; it does not by itself construct those objects, assign \
momenta, compile code, or supply a complete spin sum."}], "Notes"],
  Cell[TextData[{"For a new numerical process, prefer ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], ". That function \
writes a complete class with product initialization, momentum updates, \
crossing, parameter handling, normalization and optional independent \
validation."}], "Notes"], Cell[TextData[{"Do not interpret a successfully \
formatted string as a numerical or physical validation. The supported syntax \
is narrower than that of the complete exporter, and the earlier formatter \
does not provide all of its safeguards."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {
     "Write a named spinor-product call for the massless angle bracket <12>."}\
], "ExampleText"], Cell[BoxData[RowBox[{"SPINAS", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"a12a.v()\""}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FormattingAndExport"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SPINAS - HEPCAT Documentation",
