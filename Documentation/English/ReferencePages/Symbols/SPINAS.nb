Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SPINAS", "ObjectName"],
  Cell[
   "Formats a supported expression as a legacy SPINAS C++ expression string."\
, "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SPINAS", "[", "expr", "]"}]],
      "InlineFormula"], "  ",
     "returns the corresponding formatted output."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This formatter emits .v() calls and \
scalar arithmetic for already declared spinor products. It does not create a \
complete process class, cross external legs, configure spin sums, or build a \
program. WriteSPINASProcess is the complete exporter.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Format a small spinor example.", "ExampleText"],
  Cell[BoxData[RowBox[{"SPINAS", "[", "SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2",
      "]", "]", "]"}]], "Input"], Cell[BoxData[RowBox[{"\"a12a.v()\""}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], "  \[Bullet]  ",
     ButtonBox["CreateSPName", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateSPName"], "  \[Bullet]  ",
     ButtonBox["InitializeSPINASSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/InitializeSPINASSpinorProducts"]}],
   "SeeAlso"], Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FormattingAndExport"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SPINAS - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/SPINAS", "title" -> "SPINAS", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
