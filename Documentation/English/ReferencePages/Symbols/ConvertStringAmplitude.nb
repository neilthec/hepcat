Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ConvertStringAmplitude", "ObjectName"],
  Cell["Parses legacy compact bracket notation into typed HEPCAT spinor \
expressions.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[", "text",
         ",", " ", "masses", "]"}]], "InlineFormula"], "  ", "uses the \
per-particle mass list to distinguish massless and massive spinors."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[", "text",
         ",", " ", "masses", ",", " ", "InternalMasses", " ", "->", " ",
         "rules", "]"}]], "InlineFormula"], "  ",
     "also supplies mass rules for composite endpoint labels."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["Examples include <12>, [12], \
<1|p2|3], p1.p2, s12 and x12. The compact grammar was designed around \
single-digit external labels and specialized composite notation.", "Notes"],
  Cell["A zero mass selects \"Helicity\" and a nonzero mass selects \"Spin\". \
Explicit ^ or _ index markers in supported bracket notation become upper or \
lower little-group indices.", "Notes"], Cell["The parser finishes with \
ToExpression, so parse only trusted input. For modern model persistence, \
prefer PlainText[expr,\"Model\"] together with the model reader.", "Notes"],
  Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"InternalMasses"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell["Mass replacement rules supplied to the older \
compact-string amplitude converters. This is a legacy symbol option, distinct \
from model-local numerical ParameterRules.", "TableText"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Left, Left}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.23], Scaled[0.19],
         Scaled[0.58]}}, GridBoxDividers ->
      {"Rows" -> {False, True, {False}, False}}]], "3ColumnTableMod"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Parse a massless angle bracket.", "ExampleText"],
  Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[", "\"<12>\"", ",", " ",
      "{", "0", ",", " ", "0", "}", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
       "RowDefault"], TemplateBox[{"2", "\"\[RightAngleBracket]\""},
       "RowDefault"]}, "RowDefault"]], "Output"],
  Cell["Use the mass list to select a massive endpoint.", "ExampleText"],
  Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[", "\"<12>\"", ",", " ",
      "{", "m", ",", " ", "0", "}", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
        StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"],
      TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ConvertStringHattedAmplitude",
