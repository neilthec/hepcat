Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ConvertStringAmplitude", "ObjectName"],
  Cell[TextData[{"Reads a compact spinor-bracket string and constructs a \
typed HEPCAT expression."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[", "text",
         ",", " ", "masses", "]"}]], "InlineFormula"], "  ", "uses the \
per-particle mass list to distinguish massless and massive spinors."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[", "text",
         ",", " ", "masses", ",", " ", "InternalMasses", " ", "->", " ",
         "rules", "]"}]], "InlineFormula"], "  ",
     "also supplies mass rules for composite endpoint labels."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when importing a formula written in the older \
compact bracket notation. The mass list is in particle order and tells the \
reader whether a leg should be represented by a massless helicity spinor or a \
massive spinor."}], "Notes"],
  Cell[TextData[{"The result contains ordinary typed objects such as ",
     ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], ", ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], " and ", ButtonBox["Mom",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/Mom"],
     ", so it can be passed to the algebra and preparation functions."}],
   "Notes"], Cell[TextData[{"The optional symbolic option InternalMasses \
supplies mass information for supported composite endpoint labels. It is \
input information for interpreting the formula, not permission to put every \
internal line on shell."}], "Notes"],
  Cell[TextData[{"For readable output use ", ButtonBox["PlainText",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/PlainText"],
     ". When storing a new exact amplitude in a model, use ",
     Cell[BoxData[RowBox[{"PlainText", "[", "expression", ",", "\"Model\"",
         "]"}]], "InlineFormula"], " or ", ButtonBox["AppendModelAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/AppendModelAmplitudes"],
     " rather than relying on ambiguous handwritten compact strings."}],
   "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"InternalMasses"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Mass replacement rules supplied to the \
older compact-string amplitude converters. This is a legacy symbol option, \
distinct from model-local numerical ParameterRules."}], "TableText"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Left, Left}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.23], Scaled[0.19],
         Scaled[0.58]}}, GridBoxDividers ->
      {"Rows" -> {False, True, {False}, False}}]], "3ColumnTableMod"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Parse a massless angle bracket."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[", "\"<12>\"", ",", " ",
      "{", "0", ",", " ", "0", "}", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
        TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"], ShowStringCharacters -> False],
     SpinorChain[Spinor["Helicity", "Angle", 1], Spinor["Helicity", "Angle",
       2]], Editable -> False]], "Output"],
  Cell[TextData[{"Use the mass list to select a massive endpoint."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ConvertStringAmplitude", "[",
      "\"<12>\"", ",", " ", "{", "m", ",", " ", "0", "}", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", StyleBox["1", Bold,
           StripOnInput -> False]}, "RowDefault"],
        TemplateBox[{"2", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"], ShowStringCharacters -> False],
     SpinorChain[Spinor["Spin", "Angle", 1], Spinor["Helicity", "Angle", 2]],
     Editable -> False]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ConvertStringHattedAmplitude",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ConvertStringHattedAmplitude"], "  \[Bullet]  ",
     ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"], "  \[Bullet]  ",
     ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
