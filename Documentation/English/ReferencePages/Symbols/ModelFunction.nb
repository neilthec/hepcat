Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ModelFunction", "ObjectName"],
  Cell["Retain an external model function call as inert data.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelFunction", "[", "name", ",", " ",
         "scope", ",", " ", "arguments", "]"}]], "InlineFormula"], "  ",
     "Represent an external function belonging to a model."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The model expression reader can \
encounter named functions that are not supported numerical arithmetic. Such a \
call is stored rather than executed in the caller's session.", "Notes"],
  Cell["StandardForm and TraditionalForm display a familiar function call \
while retaining the typed head internally. PlainText, TeX and SPINAS preserve \
its name and arguments for output.", "Notes"], Cell["An unsupported function \
prevents a dependent parameter from resolving numerically. It does not \
justify executing an arbitrary Wolfram function with the same displayed \
name.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Inspect an inert call without invoking a global function.",
   "ExampleText"], Cell[BoxData[RowBox[{"externalCall", " ", "=", " ",
      "ModelFunction", "[", "\"RunningCoupling\"", ",", " ",
      "\"example-model\"", ",", " ", "{", "3", "/", "2", "}", "]", ";", "\n",
      "Head", "[", "externalCall", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"ModelFunction"}]], "Output"],
  Cell["Convert the retained call to model-style text.", "ExampleText"],
  Cell[BoxData[RowBox[{"PlainText", "[", "externalCall", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"RunningCoupling((3)/(2) )\""}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadFunctions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadFunctions"], "  \[Bullet]  ",
     ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], "  \[Bullet]  ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"],
     "  \[Bullet]  ", ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ModelFunction - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ModelFunction", "title" -> "ModelFunction",
     "type" -> "Symbol", "paclet" -> "HEPCAT", "language" -> "en",
