Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ModelFunction", "ObjectName"],
  Cell[TextData[
    {"Keep a model-supplied external function as symbolic data."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelFunction", "[", "name", ",", " ",
         "scope", ",", " ", "arguments", "]"}]], "InlineFormula"], "  ",
     "Represent an external function belonging to a model."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Some model tables refer to a function implemented by the \
model's numerical environment, for example a running-mass prescription. ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], " keeps such a call as ",
     Cell[BoxData[RowBox[{"ModelFunction", "[", "name", ",", " ", "scope",
         ",", " ", "arguments", "]"}]], "InlineFormula"], " instead of \
evaluating an arbitrary Mathematica function with the same name."}],
   "Notes"], Cell[TextData[{"The scope identifies the model and the final \
list contains the arguments. Usually this object appears as part of a \
dependent parameter definition rather than something you need to construct by \
hand."}], "Notes"], Cell[TextData[{"A retained function call can be used in \
symbolic work, but its numerical value is not automatically available. ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], " resolves \
supported arithmetic and dependencies; unsupported external calls remain \
unresolved. Supply appropriate declared inputs or a supported numerical \
prescription before relying on checks that require that quantity."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Inspect an inert call without invoking a global function."}],
   "ExampleText"], Cell[BoxData[RowBox[{"externalCall", " ", "=", " ",
      "ModelFunction", "[", "\"RunningCoupling\"", ",", " ",
      "\"example-model\"", ",", " ", "{", "3", "/", "2", "}", "]", ";", "\n",
      "Head", "[", "externalCall", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"ModelFunction"}]], "Output"],
  Cell[TextData[{"Convert the retained call to model-style text."}],
   "ExampleText"], Cell[BoxData[RowBox[{"PlainText", "[", "externalCall",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"RunningCoupling((3)/(2) )\""}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], "  \[Bullet]  ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"],
     "  \[Bullet]  ", ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ModelFunction - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ModelFunction", "title" -> "ModelFunction",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" ->
      "Keep a model-supplied external function as symbolic data.",
     "keywords" -> {"HEPCAT", "ModelFunction", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]