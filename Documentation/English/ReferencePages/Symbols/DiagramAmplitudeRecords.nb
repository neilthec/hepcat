   "AnchorBarGrid"], Cell["DiagramAmplitudeRecords", "ObjectName"],
  Cell[TextData[{"Inspect the expression, propagators and assumptions \
associated with each diagram."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiagramAmplitudeRecords", "[",
         "diagrams", "]"}]], "InlineFormula"], "  ", "Build a record for each \
generated diagram without adding an automatic shell reduction."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiagramAmplitudeRecords", "[",
         "diagrams", ",", " ", "options", "]"}]], "InlineFormula"], "  ", "Ap\
ply a supplied pair-preserving simplification and record any declared shell \
usage."}], "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"This is an advanced inspection tool for a list returned by \
", ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], ". It returns one \
association per diagram, keeping its original expression, numerator, physical \
propagators, external particles and mass rules together."}], "Notes"],
  Cell[TextData[{"Use it when you need to see which numerator assumptions \
belong to a particular diagram, rather than to the complete summed amplitude. \
The default does not apply a new internal-shell simplification."}], "Notes"],
  Cell[TextData[{"An optional ",
     Cell[BoxData[RowBox[{"\"SimplificationFunction\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "acts", " ", "on", " ", "the", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"{", "massRules", ",", " ",
         "expression", "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "pair", " ", "and", " ", "must", " ",
         "return", " ", "a", " ", "pair", " ", "with", " ", "the", " ",
         "same", " ", "mass", " ", "rules", ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"NumeratorOnShellChannels\""}]],
      "InlineFormula"], " records the cut conditions that your supplied \
operation used. Recording assumptions is not a proof that an arbitrary \
supplied function is a legal identity."}], "Notes"],
  Cell[TextData[{"Most calculations should use ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " with ",
     Cell[BoxData[RowBox[{"\"ReturnDetails\"", " ", "->", " ", "True"}]],
      "InlineFormula"], ". That interface performs the built-in preparation \
and retains the reduction information that ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"],
     " knows how to reuse."}], "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"SimplificationFunction\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Identity"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Transformation applied to each \
