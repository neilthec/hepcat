   "AnchorBarGrid"], Cell["ParticleMass", "ObjectName"],
  Cell["Look up a particle or antiparticle mass in a particle table.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ParticleMass", "[", "name", ",", " ",
         "particles", "]"}]], "InlineFormula"], "  ",
     "Return the mass declared for a particle name."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The second argument is the particle \
section of a model, normally model[[1]], rather than the entire four-element \
model.", "Notes"], Cell["The lookup recognizes either the particle name or \
its antiparticle name. It returns the declared symbolic mass, including a \
ModelParameter when that is what the model contains.", "Notes"],
  Cell["The empty padding name \"\" has mass 0. An unknown nonempty particle \
name returns -1. Check for this sentinel when accepting user particle names."\
, "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Particle and antiparticle have the declared common mass.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "ParticleMass", "[", "\"e\"", ",", " ", "qedModel", "[", "[", "1", "]",
      "]", "]", " ", "===", " ", "ParticleMass", "[", "\"E\"", ",", " ",
      "qedModel", "[", "[", "1", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"True"}]], "Output"],
  Cell["Distinguish model padding from an unknown name.", "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "{", "ParticleMass",
      "[", "\"\"", ",", " ", "qedModel", "[", "[", "1", "]", "]", "]", ",",
      " ", "ParticleMass", "[", "\"not-a-particle\"", ",", " ", "qedModel",
      "[", "[", "1", "]", "]", "]", "}"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "0", ",", " ", "-", "1", "}"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadParticles", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadParticles"], "  \[Bullet]  ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
