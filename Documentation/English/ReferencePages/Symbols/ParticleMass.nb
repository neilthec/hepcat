   "AnchorBarGrid"], Cell["ParticleMass", "ObjectName"],
  Cell[TextData[{"Find the mass declared for a particle or antiparticle."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ParticleMass", "[", "name", ",", " ",
         "particles", "]"}]], "InlineFormula"], "  ",
     "Return the mass declared for a particle name."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"The first argument is a model particle name such as ",
     Cell[BoxData[RowBox[{"\"e\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "The", " ", "second", " ", "is", " ",
         "the", " ", "particle", " ", "table", ",", " ", "normally", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"model", "[", "[", "1", "]",
         "]"}]], "InlineFormula"], ", rather than the complete model. Both \
the particle name and its antiparticle name are recognized."}], "Notes"],
  Cell[TextData[
    {"The answer is the mass as declared in the model. If it is a ",
     ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"],
     ", it remains symbolic until you apply ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], ". This lets \
the same expression be used with more than one numerical parameter choice."}]\
, "Notes"], Cell[TextData[{"The empty name ", Cell[BoxData[RowBox[{"\"\""}]],
      "InlineFormula"], Cell[BoxData[RowBox[{",", " ", "used", " ", "as",
         " ", "padding", " ", "in", " ", "model", " ", "tables", ",", " ",
         "gives", " "}]], "InlineFormula"], Cell[BoxData[RowBox[{"0"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{".", " ", "An", " ", "unknown",
         " ", "nonempty", " ", "name", " ", "gives", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"-", "1"}]], "InlineFormula"], "\
. When accepting a process supplied by someone else, check for that value \
rather than interpreting it as a physical mass."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[
    {"Particle and antiparticle have the declared common mass."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "ParticleMass", "[", "\"e\"", ",", " ", "qedModel", "[", "[", "1", "]",
      "]", "]", " ", "===", " ", "ParticleMass", "[", "\"E\"", ",", " ",
      "qedModel", "[", "[", "1", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"True"}]], "Output"],
  Cell[TextData[{"Distinguish model padding from an unknown name."}],
