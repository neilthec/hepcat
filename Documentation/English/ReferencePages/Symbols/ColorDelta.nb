Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ColorDelta", "ObjectName"],
  Cell[TextData[
    {"Represents a Kronecker delta connecting two symbolic color indices."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorDelta", "[", "index1", ",", " ",
         "index2", "]"}]], "InlineFormula"], "  ",
     "represents a contracted color Kronecker tensor."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorDelta", "[", "i", ",", "j",
         "]"}]], "InlineFormula"], " records the identity contraction between \
two compatible color slots. A color-singlet interaction on a quark line can \
carry this tensor alongside its Lorentz and spinor factor."}], "Notes"],
  Cell[TextData[{"The arguments can be external ", ButtonBox["ColorIndex",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ColorIndex"], " \
labels or local internal labels generated by the diagram code. Retain their \
contractions when simplifying the rest of the expression."}], "Notes"],
  Cell[TextData[{"The tensor remains symbolic during Feynman-to-spinor \
conversion. Its presence alone does not perform external color sums, \
initial-color averages or a trace over all color states."}], "Notes"],
  Cell[TextData[{"Use the model's contraction and generator conventions when \
comparing a colored amplitude with another calculation. See ",
     ButtonBox["ColorGenerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorGenerator"],
     " for the ordered quark-gluon generator tensor."}], "Notes"],
  Cell[TextData[{"Notebook output uses standard color notation automatically \
and retains the exact symbolic object when copied. ",
     ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"], " works on these same \
tensors; no separate legacy color notation is needed."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Write a color identity linking external legs 1 and 2."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ColorDelta", "[", "ColorIndex", "[",
      "1", "]", ",", " ", "ColorIndex", "[", "2", "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[SubscriptBox["\"\[Delta]\"",
      TemplateBox[{SubscriptBox["\"c\"", "1"], "\",\"",
        SubscriptBox["\"c\"", "2"]}, "RowDefault"]],
     ColorDelta[ColorIndex[1], ColorIndex[2]], Editable -> False]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ColorIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorIndex"], "  \[Bullet]  ",
     ButtonBox["ColorGenerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorGenerator"], "  \[Bullet]  ",
     ButtonBox["ColorStructure", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorStructure"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["ColorTrace", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorTrace"], "  \[Bullet]  ",
     ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ColorDelta - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
