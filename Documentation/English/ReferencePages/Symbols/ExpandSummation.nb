Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ExpandSummation", "ObjectName"],
  Cell[TextData[{"Writes supported contracted massive-spin indices as \
explicit two-component sums."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExpandSummation", "[", "expr", "]"}]],
      "InlineFormula"], "  ",
     "writes eligible repeated symbolic indices as a two-component sum."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when you want to inspect a contraction component \
by component. Eligible repeated symbolic little-group indices are expanded \
into the +1/2 and -1/2 components used by HEPCAT."}], "Notes"],
  Cell[TextData[{"The input is expanded before the matching contraction \
patterns are applied. This can be useful for checking a small spin sum but \
can make a large expression much longer."}], "Notes"],
  Cell[TextData[{"For routine sewing, ", ButtonBox["ReduceSpinContractions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinContractions"],
     " usually gives a more compact expression directly in spinor chains. ",
     ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"],
     " selects a physical state instead of expanding a repeated-index sum."}]\
, "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Expand a repeated massive upper/lower index."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ExpandSummation", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Upper\"",
      ",", " ", "\"Angle\"", ",", " ", "1", ",", " ", "j", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3",
      "]", "]", " ", "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ",
      "\"Lower\"", ",", " ", "\"Square\"", ",", " ", "1", ",", " ", "j", "]",
      ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Square\"", ",",
      " ", "4", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {RowBox[{InterpretationBox[TemplateBox[
          {TemplateBox[{"\"[\"", SubscriptBox[StyleBox["1", Bold,
               StripOnInput -> False], RowBox[{"-", FractionBox["1",
                 "2"]}]]}, "RowDefault"], TemplateBox[{"4", "\"]\""},
            "RowDefault"]}, "RowDefault"], SpinorChain[Spinor["Spin",
           "Lower", "Square", 1, -2^(-1)], Spinor["Helicity", "Square", 4]],
         Editable -> False], " ", InterpretationBox[TemplateBox[
          {TemplateBox[{"\"\[LeftAngleBracket]\"", TemplateBox[
              {StyleBox["1", Bold, StripOnInput -> False], RowBox[
                {"-", FractionBox["1", "2"]}]}, "Superscript",
              SyntaxForm -> SuperscriptBox]}, "RowDefault"],
           TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
          "RowDefault"], SpinorChain[Spinor["Spin", "Upper", "Angle", 1,
           -2^(-1)], Spinor["Helicity", "Angle", 3]], Editable -> False]}],
      "+", RowBox[{InterpretationBox[TemplateBox[
          {TemplateBox[{"\"[\"", SubscriptBox[StyleBox["1", Bold,
               StripOnInput -> False], FractionBox["1", "2"]]},
            "RowDefault"], TemplateBox[{"4", "\"]\""}, "RowDefault"]},
          "RowDefault"], SpinorChain[Spinor["Spin", "Lower", "Square", 1,
           1/2], Spinor["Helicity", "Square", 4]], Editable -> False], " ",
        InterpretationBox[TemplateBox[{TemplateBox[
            {"\"\[LeftAngleBracket]\"", TemplateBox[{StyleBox["1", Bold,
                StripOnInput -> False], FractionBox["1", "2"]},
              "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
           TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
          "RowDefault"], SpinorChain[Spinor["Spin", "Upper", "Angle", 1,
           1/2], Spinor["Helicity", "Angle", 3]], Editable -> False]}]}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     "  \[Bullet]  ", ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"], "  \[Bullet]  ",
     ButtonBox["SquareAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SquareAmplitude"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ExpandSummation - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
