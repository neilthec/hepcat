   "AnchorBarGrid"], Cell["ExpandSummation", "ObjectName"],
  Cell["Expands supported contracted massive spin indices into explicit \
plus/minus half components.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExpandSummation", "[", "expr", "]"}]],
      "InlineFormula"], "  ",
     "writes eligible repeated symbolic indices as a two-component sum."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The input is expanded \
before the supported matching index patterns are replaced. A repeated \
upper/lower index on the same particle is resolved into its two spin-half \
components.", "Notes"], Cell["This exposes component sums instead of sewing \
them into momentum insertions. ReduceSpinContractions is usually the more \
compact alternative.", "Notes"], Cell["The routine does not insert an initial \
spin average or an identical-particle symmetry factor.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Expand a repeated massive upper/lower index.", "ExampleText"],
