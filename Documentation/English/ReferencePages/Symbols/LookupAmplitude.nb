Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/DiagramsAndFactorization"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["LookupAmplitude", "ObjectName"],
  Cell[TextData[{"Retrieve a stored lower-point amplitude with a specified \
particle numbering."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LookupAmplitude", "[", "particles",
         ",", " ", "model", "]"}]], "InlineFormula"], "  ", "Retrieve a saved \
amplitude for an ordered list of all-incoming particle names."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LookupAmplitude", "[",
         "taggedParticles", ",", " ", "model", ",", " ", "rightSide", ",",
         " ", "spinIndices", "]"}]], "InlineFormula"], "  ", "Match particle \
names, multiply the stored factor, and relabel typed particle slots."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Read the model once with ", ButtonBox["ReadModel",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ReadModel"], ", \
then pass an ordered list of particle names, including any helicity suffixes. \
The result includes the stored overall factor. Models 4 and 5 contain the \
single-flavor QED catalog through nine external legs with the physical- and \
spurious-pole choices, respectively."}], "Notes"],
  Cell[TextData[{"An exact row ordering has priority. Otherwise HEPCAT finds \
the unique row with the same particle and helicity counts and assigns \
successive occurrences of each species to successive positions. It relabels \
external spinors, momenta and explicit color slots. Coefficients, exponents \
and independent spin indices keep their stored values."}], "Notes"],
  Cell[TextData[{"The two-argument form returns Missing for an absent row, \
the number zero for a stored zero, and Failure for an ambiguous match or a \
Feynman rules model. To calculate an amplitude from diagrams and \
factorization, use ", ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], "."}], "Notes"],
  Cell[TextData[{"The four-argument form labels legs explicitly for sewing. \
The rightSide flag and four spin-index names control the internal leg. This \
form returns zero for an absent amplitude, as required by ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"],
     "."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[
    {"Retrieve the QED positive-helicity three-point amplitude."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";", "\n",
      "LookupAmplitude", "[", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", "}", ",", " ", "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"-", RowBox[{"(", RowBox[{SqrtBox["2"], " ",
          InterpretationBox["EE", ModelParameter["EE",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], " ", InterpretationBox[
           StyleBox[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
                StyleBox["1", Bold, StripOnInput -> False]}, "RowDefault"],
              TemplateBox[{StyleBox["2", Bold, StripOnInput -> False],
                "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
            ShowStringCharacters -> False], SpinorChain[Spinor["Spin",
             "Angle", 1], Spinor["Spin", "Angle", 2]], Editable -> False],
          " ", SubscriptBox["\"x\"", "\"1,2\""]}], ")"}]}]], "Output"],
  Cell[TextData[
    {"An absent lower-point amplitude contributes zero during sewing."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";", "\n",
      "LookupAmplitude", "[", "{", "{", "\"e\"", ",", " ", "1", "}", ",",
      " ", "{", "\"e\"", ",", " ", "2", "}", ",", " ", "{", "\"e\"", ",",
      " ", "3", "}", "}", ",", " ", "qedModel", ",", " ", "False", ",", " ",
      "{", "i1", ",", " ", "i2", ",", " ", "i3", ",", " ", "i4", "}", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"],
     "  \[Bullet]  ", ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Diagrams and Factorization Channels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/DiagramsAndFactorization"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "LookupAmplitude - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/LookupAmplitude", "title" -> "LookupAmplitude",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
