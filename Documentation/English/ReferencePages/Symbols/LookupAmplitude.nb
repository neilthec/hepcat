     Cell[BoxData[RowBox[{"taggedParticles"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "has", " ", "entries", " ", "such", " ", "as",
         " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"{", "\"e\"", ",", " ", "1", "}"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "and", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"{", "\"E\"", ",", " ", "2",
         "}"}]], "InlineFormula"], ". The function matches their particle \
content to a stored model row, includes that row's overall factor and \
relabels its typed particle slots to the supplied numbering."}], "Notes"],
  Cell[TextData[{"Only particle-label positions are relabeled. Numerical \
coefficients, powers and independent spin-index symbols are not interpreted \
as particle numbers. Repeated identical species are assigned distinct \
matching labels instead of repeatedly replacing every occurrence by the same \
leg."}], "Notes"],
  Cell[TextData[{"The ", Cell[BoxData[RowBox[{"rightSide"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "argument", " ", "and",
         " ", "four", " ", "supplied", " ", "spin", "-", "index", " ",
         "names", " ", "support", " ", "sewing", " ", "lower", "-", "point",
         " ", "amplitudes", " ", "across", " ", "an", " ", "internal", " ",
         "line", ".", " ", "In", " ", "an", " ", "ordinary", " ", "lookup",
         " ", "with", " ", "only", " ", "integer", " ", "external", " ",
         "labels", ",", " ", "the", " ", "common", " ", "form", " ", "is",
         " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"LookupAmplitude", "[", "Thread", "[", "{",
         "particles", ",", " ", "Range", "[", "Length", "[", "particles",
