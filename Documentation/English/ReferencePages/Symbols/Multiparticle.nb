Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Multiparticle", "ObjectName"],
  Cell[TextData[{"Labels the sum of a specified set of external momenta."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Multiparticle", "[", "i1", ",", " ",
         "i2", ",", " ", "...", "]"}]], "InlineFormula"], "  ",
     "identifies the sum p_i1+p_i2+... as a typed channel label."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Multiparticle[1, 3] is a channel label. Inside ",
     ButtonBox["Mom", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mom"], " it means p1+p3; inside ",
     ButtonBox["Mass", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mass"], " it identifies the mass assigned to that \
channel. The labels always refer to positions in the external-particle list."}\
], "Notes"], Cell[TextData[{"This typed label lets ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], ", ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ", \
and the amplitude checker recognize a channel without guessing which ordinary \
integer sums denote momenta."}], "Notes"],
  Cell[TextData[{"Keep the typed label in stored amplitudes and mass rules. \
For algebra inside a chain, ", ButtonBox["ReduceSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinorProducts"], " can distribute a \
composite momentum into its individual insertions when useful. A composite \
label does not impose an internal on-shell condition."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Record the channel momentum p1+p3 as one typed momentum sum."}],
   "ExampleText"], Cell[BoxData[RowBox[{"Mom", "[", "Multiparticle", "[",
      "1", ",", " ", "3", "]", "]"}]], "Input"],
  Cell[BoxData[SubscriptBox["p", RowBox[{"1", ",", "3"}]]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Mom", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mom"], "  \[Bullet]  ",
     ButtonBox["Mass", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mass"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "Multiparticle - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/Multiparticle", "title" -> "Multiparticle",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" ->
      "Labels the sum of a specified set of external momenta.",
     "keywords" -> {"HEPCAT", "Multiparticle", "spinor amplitudes"},
