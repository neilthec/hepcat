Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["AppendModelAmplitudes", "ObjectName"],
  Cell[TextData[{"Add established amplitude expressions to a constructive \
model for later factorization calculations."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"AppendModelAmplitudes", "[",
         "directory", ",", " ", "number", ",", " ", "entries", "]"}]],
      "InlineFormula"], "  ", "Append {particles, amplitude} or {particles, \
factor, amplitudeOverFactor} entries to ampsN.mdl."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this function after obtaining and checking a new \
amplitude. For example, once a five-point result has been established, \
storing it in a model makes it available when ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], " \
builds six-point channels. The function writes the expressions you supply; it \
does not derive or validate their physics."}], "Notes"],
  Cell[TextData[
    {"Give the target directory, model number and a list of entries. An entry \
", Cell[BoxData[RowBox[{"{", "particles", ",", " ", "amplitude", "}"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "writes", " ", "the", " ",
         "complete", " ", "expression", ".", " ", "The", " ", "longer", " ",
         "form", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"{", "particles", ",", " ", "factor", ",", " ",
         "amplitudeOverFactor", "}"}]], "InlineFormula"], " separates a \
common overall factor from the expression stored after it. The particle list \
uses the same all-ingoing order and names as the expression."}], "Notes"],
  Cell[TextData[{"The target model supplies the particle declarations and \
parameter names. When taking a result from a different model, replace its \
model-local ", ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], " objects with the \
corresponding parameters of the target model before writing. Matching printed \
names do not by themselves merge the two parameter scopes."}], "Notes"],
  Cell[TextData[{"The result reports the destination file and the numbers of \
added and skipped entries. An identical existing entry is skipped. A \
conflicting expression for the same particle multiset rejects the batch \
instead of silently replacing the old result. Every proposed row must be \
readable again before the amplitude file is replaced."}], "Notes"],
  Cell[TextData[{"Existing rows and comments are preserved. Reload with ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], " to use the new data. \
First try a temporary copy of a model, as in the example, and use ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], " and any \
independent comparisons appropriate to the process before promoting a result \
to factorization input."}], "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"], Cell[TextData[{"Append a known four-point result to a \
temporary copy of the three-point QED model."}], "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "knownQEDModel", " ",
      "=", " ", "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";",
      "\n", "temporaryModelDirectory", " ", "=", " ", "CreateDirectory", "[",
      "]", ";", "\n", "Scan", "[", "CopyFile", "[", "FileNameJoin", "[", "{",
      "modelDirectory", ",", " ", "#", " ", "<>", " ", "\"2.mdl\"", "}", "]",
      ",", " ", "FileNameJoin", "[", "{", "temporaryModelDirectory", ",",
      " ", "#", " ", "<>", " ", "\"2.mdl\"", "}", "]", "]", " ", "&", ",",
      " ", "{", "\"prtcls\"", ",", " ", "\"amps\"", ",", " ", "\"vars\"",
      ",", " ", "\"func\"", "}", "]", ";", "\n", "particles", " ", "=", " ",
      "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ",
      "\"A.+\"", "}", ";", "\n", "knownAmplitude", " ", "=", " ",
      "LookupAmplitude", "[", "Thread", "[", "{", "particles", ",", " ",
      "Range", "[", "4", "]", "}", "]", ",", " ", "knownQEDModel", ",", " ",
      "False", ",", " ", "{", "i1", ",", " ", "i2", ",", " ", "i3", ",", " ",
      "i4", "}", "]", ";", "\n",
      "(* Use parameters declared in the target copy. *)", "\n",
      "copiedModel", " ", "=", " ", "ReadModel", "[",
      "temporaryModelDirectory", ",", " ", "2", "]", ";", "\n",
      "parameterMap", " ", "=", " ", "Thread", "[", "(", "First", " ", "/@",
      " ", "ModelParameterRules", "[", "knownQEDModel", "]", ")", " ", "->",
      " ", "(", "ModelParameter", "[", "copiedModel", ",", " ",
      "ModelParameterName", "[", "#", "]", "]", " ", "&", " ", "/@", " ",
      "(", "First", " ", "/@", " ", "ModelParameterRules", "[",
      "knownQEDModel", "]", ")", ")", "]", ";", "\n",
      "AppendModelAmplitudes", "[", "temporaryModelDirectory", ",", " ", "2",
      ",", " ", "{", "{", "particles", ",", " ", "knownAmplitude", " ", "/.",
      " ", "parameterMap", "}", "}", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"],
  Cell[TextData[
    {
     "An empty batch leaves the target untouched and reports zero additions."}\
], "ExampleText"], Cell[BoxData[RowBox[{"AppendModelAmplitudes", "[",
      "modelDirectory", ",", " ", "2", ",", " ", "{", "}", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"], "  \[Bullet]  ",
     ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"], "  \[Bullet]  ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], "  \[Bullet]  ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"]}],
   "SeeAlso"], Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
  "AppendModelAmplitudes - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
