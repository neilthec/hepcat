Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ColorStructure", "ObjectName"],
  Cell[TextData[{"Represents the SU(3) structure constant with three ordered \
adjoint color indices."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorStructure", "[", "a", ",", " ",
         "b", ",", " ", "c", "]"}]], "InlineFormula"], "  ",
     "represents an SU(3) structure constant."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ColorStructure", "[", "a", ",", "b",
         ",", "c", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "denotes", " ", "the", " ", "structure", " ",
         "constant", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"f", "(", "a", ",", "b", ",", "c", ")"}]],
      "InlineFormula"], " appearing in gluon self-interactions. Its arguments \
identify the three adjoint color slots."}], "Notes"],
  Cell[TextData[{"The tensor is antisymmetric in its color labels. Keep the \
ordering and accompanying scalar coefficient supplied by the model when \
following a diagram or comparing conventions."}], "Notes"],
  Cell[TextData[
    {"In the imported CalcHEP convention, an accompanying factor of ",
     Cell[BoxData[RowBox[{"I"}]], "InlineFormula"], " from the vertex is \
retained separately from the structure-constant head. Removing that \
coefficient would change the amplitude."}], "Notes"],
  Cell[TextData[{"The color tensor survives ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], ". \
Conversion of its Lorentz factor does not carry out external color sums or \
create a complete numerical color-averaged process."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Retain the three adjoint color slots of a gluon self-interaction."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ColorStructure", "[", "a", ",", " ",
