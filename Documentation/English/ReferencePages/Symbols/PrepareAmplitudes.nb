Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/AmplitudeConstruction"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PrepareAmplitudes", "ObjectName"],
  Cell[TextData[{"Simplify diagram expressions, factorization channels or a \
completed amplitude before the next calculation stage."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PrepareAmplitudes", "[", "items", ",",
         " ", "model", "]"}]], "InlineFormula"], "  ", "Prepare a mass-rule \
pair, a list of diagram pairs or compact factorization-channel rows."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PrepareAmplitudes", "[", "items", ",",
         " ", "model", ",", " ", "\"PolePreference\"", " ", "->", " ",
         "preference", "]"}]], "InlineFormula"], "  ", "Choose and simplify a \
bounded set of allowed reference-spinor assignments."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PrepareAmplitudes", "[", "items", ",",
         " ", "model", ",", " ", "\"ReturnDetails\"", " ", "->", " ", "True",
         "]"}]], "InlineFormula"], "  ", "Retain original inputs, selected \
references, discarded remainders and preparation diagnostics."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"This is the preparation step between generating expressions \
and completing an amplitude. It contracts spin indices, chooses requested \
reference spinors, reduces spinor products and tries bounded improving \
identities. Unlike ", ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"],
     ", it does not add missing physical contributions."}], "Notes"],
  Cell[TextData[{"Accepted inputs are one ",
     Cell[BoxData[RowBox[{"{", "massRules", ",", " ", "expression", "}"}]],
      "InlineFormula"],
     " pair, a list of such diagram pairs, or the compact rows returned by ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ". \
The ordinary output keeps the same format. You can inspect one prepared \
diagram or channel without unpacking a large report."}], "Notes"],
  Cell[TextData[{"The mass declarations are part of the meaning of an input. \
A diagram may declare several internal cuts; a factorization row declares \
only its selected cut; a completed amplitude should carry external mass rules \
only. Preparation does not infer new on-shell conditions merely because a \
denominator appears in the expression."}], "Notes"],
  Cell[TextData[{"For a four-leg amplitude, preparation can first keep a \
channel momentum as one off-shell vector while reducing neighboring external \
endpoints. For example, using ",
     Cell[BoxData[RowBox[{"P", "=", "p1", "+", "p2", "=", "-", "(", "p3",
         "+", "p4", ")"}]], "InlineFormula"], " together in several chains \
can expose a cancellation that disappears when each chain is expanded \
separately. The pass uses exact affine momentum identities and external Dirac \
equations, then restores the original momentum labels. It records no \
internal-shell assumption and preserves each complete denominator product. \
The rule is structural and also applies to unequal masses, relabeled \
particles and explicit spin indices."}], "Notes"],
  Cell[TextData[{"For small four-leg numerator sums with a declared massless \
external particle, a bounded Schouten lookahead can inspect an intermediate \
expression that is temporarily larger. Each candidate is followed by \
chainwise external Dirac reduction, declared massless momentum factorization \
and ordinary momentum conservation. This ordering can expose a short result \
that a strictly greedy one-edit search misses. The original inverse factors \
are protected throughout, and only a completed, strictly simpler candidate is \
retained. Detailed output records the Schouten edits and the subsequent \
identity steps."}], "Notes"],
  Cell[TextData[{"For a complete amplitude, preparation can cancel a massless \
angle- or square-bracket denominator whose invariant factor becomes visible \
only after terms are combined. It expands numerator propagators by their \
exact definitions and uses the declared external masses and, when enabled, \
total momentum conservation. Physical propagator denominators remain off \
shell. Any nonzero polynomial remainder retains its original bracket \
denominator, so this pass does not discard regular terms or impose an \
internal shell condition. The bounded pass keeps the input when it finds no \
improvement. Standalone ", ButtonBox["ReduceSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     " still does not infer momentum conservation."}], "Notes"],
  Cell[TextData[{"A useful cancellation may require replacing the same \
momentum in several chains together. For a completed amplitude, preparation \
therefore revisits small numerator groups that share their complete \
denominator product, using coherent momentum conservation followed by \
ordinary spinor reduction. Existing inverse factors stay intact, so the trial \
cannot impose an internal mass shell. Canonical color coefficients can be \
simplified separately and reassembled exactly. The whole candidate must \
improve the existing complexity ranking before it is selected."}], "Notes"],
  Cell[TextData[{"Preparation can also simplify scalar coefficients using \
dependent functions declared in the supplied model, such as a weak mixing \
relation or a chiral coupling definition. This uses symbolic definitions, not \
the numerical default values of independent parameters. A propagator's \
declared mass and width remain unchanged, and equally named parameters from \
another model remain distinct. A definition is expanded only when the \
completed expression becomes simpler and the coefficient change has an exact \
algebraic certificate. Explicit local overrides of dependent parameters in ",
     ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"],
     " are respected."}], "Notes"],
  Cell[TextData[{"These are bounded searches for better representations. An \
unchanged result means that the inspected routes found no improvement within \
their limits; it does not establish a global minimum. Request ",
     Cell[BoxData[RowBox[{"\"ReturnDetails\"", " ", "->", " ", "True"}]],
      "InlineFormula"], " to inspect accepted reductions and their \
ordinary-identity routes. Simplifying a saved amplitude also does not replace \
its physical validation with ", ButtonBox["CheckAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/CheckAmplitudes"], "."}], "Notes"],
  Cell[TextData[{"With ", Cell[BoxData[RowBox[{"\"Parallelization\"", " ",
         "->", " ", "Automatic"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{",", " ", "tiny", " ", "batches", " ", "stay", " ",
         "serial", " ", "when", " ", "no", " ", "HEPCAT", " ", "worker", " ",
         "pool", " ", "is", " ", "already", " ", "available", ",", " ",
         "avoiding", " ", "startup", " ", "cost", " ", "for", " ", "work",
         " ", "that", " ", "finishes", " ", "almost", " ", "immediately",
         ".", " ", "A", " ", "warm", " ", "pool", " ", "can", " ", "be", " ",
         "reused", ".", " ", "Substantial", " ", "batches", " ", "can", " ",
         "still", " ", "start", " ", "workers", " ", "using", " ", "the",
         " ", "available", " ", "processor", " ", "allowance", ",", " ",
         "and", " ", "explicit", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"True"}]], "InlineFormula"], " requests the \
parallel route. This execution choice does not alter the identity rules or \
the order of returned items."}], "Notes"],
  Cell[TextData[{"For a supported four-leg massive tensor with two spinor \
endpoints per external leg, preparation also tries a bounded combination of \
Schouten, external Dirac and momentum-conservation identities. This can \
remove momentum products or several insertions together even when no single \
greedy edit improves the expression. It uses the supplied expression and \
external masses, without a known target amplitude. An optimizer may propose \
coefficients, but an exact rational replay through the ordinary identities is \
required before accepting the result. Physical propagator arguments and other \
kinematic inverse factors remain protected, and the route adds no \
internal-shell assumption. Unsupported sectors keep the existing route. \
Detailed output records the accepted identity certificates."}], "Notes"],
  Cell["On-shell conditions and protected denominators", "NotesSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"], " and ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"], " apply the \
ordinary contraction and external-particle identities. Preparation \
additionally knows the complete external leg list and can try \
momentum-conservation reductions."}], "Notes"],
  Cell[TextData[{"Some reductions become shorter only after several \
identities work together. For a completed amplitude, a bounded \
endpoint-contraction pass can combine Schouten identities with external Dirac \
equations, join massless spinor products into a momentum chain, and use \
declared external momentum conservation to contract the result. Angle and \
square forms are considered on the same footing. A completed trial is kept \
only when its whole-expression complexity improves; the diagnostic report \
records the accepted route. These are ordinary identities, so they do not put \
any internal propagator on shell. Set ",
     Cell[BoxData[RowBox[{"\"MomentumConservation\"", " ", "->", " ",
         "False"}]], "InlineFormula"], " to exclude the steps that need the \
complete external momentum sum."}], "Notes"],
  Cell[TextData[{"With ", Cell[BoxData[RowBox[{"\"InternalOnShell\"", " ",
         "->", " ", "True"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{",", " ", "constructive", " ", "numerator", " ",
         "reductions", " ", "can", " ", "use", " ", "the", " ", "internal",
         " ", "mass", " ", "declarations", " ", "belonging", " ", "to", " ",
         "that", " ", "individual", " ", "diagram", " ", "or", " ",
         "channel", ".", " ", "For", " ", "example", ",", " ", "knowing",
         " ", "the", " ", "mass", " ", "of", " ", "the", " ", "line", " ",
         "with", " ", "momentum", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"p2", "+", "p5"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "can", " ", "replace", " ", "its", " ",
         "numerator", " ", "scalar", " ", "product", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"p2", ".", "p5"}]],
      "InlineFormula"], " by a combination of masses. The physical ",
     ButtonBox["PropDen", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PropDen"], " denominators remain off shell."}],
   "Notes"], Cell[TextData[{"Such a numerator choice is a representative \
valid on the declared cut; it need not be an identity away from that cut. \
Request ", Cell[BoxData[RowBox[{"\"ReturnDetails\"", " ", "->", " ",
         "True"}]], "InlineFormula"], " when the result will feed completion. \
The report retains the original expressions and discarded remainders, giving \
completion more information than the compact result alone."}], "Notes"],
  Cell[TextData[{"A completed ",
     Cell[BoxData[RowBox[{"{", "externalMassRules", ",", " ", "expression",
         "}"}]], "InlineFormula"], " pair has no internal cut declarations, \
so it can be prepared again using ordinary identities without introducing \
internal-shell conditions. Feynman preparation also keeps internal numerators \
off shell and uses one common reference assignment for each external gauge \
leg across all diagrams."}], "Notes"], Cell["Choosing reference spinors",
   "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"PolePreference\"", " ", "->", " ",
         "Automatic"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "compares", " ", "allowed", " ", "choices",
         " ", "and", " ", "keeps", " ", "the", " ", "simplest", " ",
         "completed", " ", "trial", " ", "within", " ", "the", " ",
         "reference", " ", "budget", ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"AllSpurious\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "prefers", " ", "other", " ", "eligible", " ",
         "massless", " ", "external", " ", "particles", " ", "as", " ",
         "references", " ", "and", " ", "uses", " ", "a", " ", "certified",
         " ", "physical", " ", "momentum", "-", "insertion", " ",
         "reference", " ", "for", " ", "a", " ", "leg", " ", "when", " ",
         "no", " ", "spurious", " ", "choice", " ", "is", " ", "available",
         ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"AllPhysical\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "uses", " ", "momentum", "-", "insertion",
         " ", "references", " ", "that", " ", "introduce", " ", "physical",
         " ", "poles", " ", "outside", " ", "the", " ", "constructive", " ",
         "item", "'", "s", " ", "own", " ", "cuts", ".", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"Mixed\""}]],
      "InlineFormula"], " compares both types."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"Cyclic\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"ReverseCyclic\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "give", " ", "reproducible", " ", "massless",
         "-", "particle", " ", "reference", " ", "choices", ".", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"Xi\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "makes", " ", "the", " ", "references", " ",
         "common", ",", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"IndependentXi\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "keeps", " ", "a", " ", "separate", " ",
         "generic", " ", "reference", " ", "for", " ", "each", " ",
         "external", " ", "particle", ",", " ", "and", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"None"}]], "InlineFormula"],
     " leaves the supplied references unchanged."}], "Notes"],
  Cell[TextData[{"These options express a choice of representation. The \
search is finite, so a result is not guaranteed to be globally shortest. An \
unavailable requested choice or an unfinished computation is reported rather \
than silently treated as fully prepared."}], "Notes"],
  Cell["Keeping the result and controlling effort", "NotesSection"],
  Cell[TextData[
    {"Use the ordinary output for inspection or a short calculation. Use ",
     Cell[BoxData[RowBox[{"\"ReturnDetails\"", " ", "->", " ", "True"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "when", " ", "passing",
         " ", "preparation", " ", "information", " ", "into", " ", "[",
         "CompleteFactorization", "]", "(", "paclet", ":", "HEPCAT", "/",
         "ref", "/", "CompleteFactorization", ")", ".", " "}]],
      "InlineFormula"], ButtonBox["CompleteFactorization",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/CompleteFactorization"], ". ",
     Cell[BoxData[RowBox[{"\"Output\"", " ", "->", " ", "\"Expression\""}]],
      "InlineFormula"], " returns a bare sum; details preserve the item \
reports, reference assignments and retained differences."}], "Notes"],
  Cell[TextData[{"A final bounded regrouping can shorten the written result \
without changing its expanded terms or momentum insertions. It groups terms \
by their existing physical propagators and factors shared spinor \
coefficients. A regular piece can be combined with an existing pole group \
when that makes the whole expression smaller. Every accepted rewrite has an \
exact rational-algebra identity check with the spinor chains treated as \
independent objects; no additional on-shell or momentum-conservation \
condition is used, and no new spinor denominator is introduced. This is a \
presentation improvement, so ", ButtonBox["SpinorExpressionComplexity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorExpressionComplexity"], " can remain \
unchanged even when the expression is shorter. The same search can group \
propagators in two levels, first by a mass class or by whether their channels \
contain a declared external leg, then by the remaining pole factors. This \
exposes short exchange-current blocks that can be obscured by one large \
common denominator. The groups are inferred from the supplied expression; no \
known amplitude is substituted."}], "Notes"],
  Cell[TextData[{"Normal resource settings are automatic. The live display \
shows progress through the items. Independent diagrams or channels can be \
prepared in parallel; set ", Cell[BoxData[RowBox[{"\"Parallelization\"", " ",
         "->", " ", "False"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "to", " ", "keep", " ", "the", " ", "work",
         " ", "on", " ", "the", " ", "main", " ", "kernel", ",", " ", "or",
         " ", "use", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"MaxKernels\""}]], "InlineFormula"],
     " to reduce the worker count."}], "Notes"],
  Cell[TextData[{"The ranking compares weighted complexity first, expression \
size second, and additive grouping third. This favors a shorter expression \
tree when two forms have the same weighted complexity, even if it uses more \
separate fractions. On eligible completed inputs, a short initial pass also \
tries ordinary grouping by existing physical poles before heavier \
exploration; it retains a completed improvement if later optional work \
reaches its limit. If preparation stops at a limit, inspect its status before \
assuming all requested reductions were completed. Giving more time permits a \
larger search but does not prove that a shorter expression exists. ",
     ButtonBox["SpinorExpressionComplexity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorExpressionComplexity"],
     " provides the ranking measure used to compare candidate forms."}],
   "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"PolePreference\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Reference and representation preference shared by \
preparation and completion. ConstructAmplitude defaults to \"AllPhysical\"; \
choose \"AllSpurious\" or \"Mixed\" explicitly for a different preference. \
The individual preparation/completion functions retain their own Automatic \
comparison or inheritance rules. Cyclic/common/independent reference choices \
and None are also available. Required checks remain unchanged."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ExternalParticles\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Ordered external particle names when compact amplitude \
pairs no longer retain the process. Automatic uses recorded metadata or only \
unambiguous model matches; equal masses alone never establish identical \
species."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FermionHelicities\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Leg-to-helicity rules or an association \
specifying massless Dirac external states for Feynman conversion. Required \
missing massless-fermion helicities are reported rather than guessed."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxReferenceChoices\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum reference assignments tried during bounded \
preparation. Automatic currently allows up to 64 trials, subject to the \
shared reference and item clocks; this is not exhaustive global \
minimization."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReferenceTimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Budget for reference comparisons in checking, or \
reference-choice search in preparation. Automatic bounds this work; \
preparation shares it with the remaining per-item clock rather than adding an \
unlimited extra search."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"InternalOnShell\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether preparation may use declared \
constructive internal-channel masses in each item's numerator. True never \
puts PropDen denominators on shell and never transfers one diagram's \
assumptions to another; False leaves internal-shell reductions disabled."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxSteps\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum improving identity-search steps during \
preparation. Automatic scales the bounded effort to the workload; 0 retains \
deterministic contraction, spinor and permitted scalar-shell reductions while \
skipping the search."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxCandidates\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Bound on candidate identity edits considered during \
preparation. Automatic selects a finite workload-dependent allowance rather \
than searching every possible route."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"TimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum elapsed time allowed by the operation or \
stage. Where Automatic is supported it selects a finite workload-dependent \
budget; explicit seconds or supported Infinity override it. A timeout is \
reported, never treated as a successful amplitude."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MomentumConservation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether identities may use the complete \
declared external momentum sum. The operation uses the known external-leg \
list rather than imposing unrelated internal cut conditions."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Parallelization\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether independent items or checks may use local \
Wolfram workers. Automatic uses suitable parallel work within available \
resources; False requests serial evaluation, and result order is retained."}]\
, "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxKernels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum local Wolfram worker kernels available to \
parallel stages. Automatic respects processor availability and license \
limits; 1 requests serial execution. Worker setup and expression transfer can \
outweigh small jobs."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ProgressReporting\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether preparation and construction \
stages display their progress. False suppresses the live stage display \
without changing the algebra or validation."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ProgressFunction\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Optional callback receiving stage progress \
information. Automatic uses the normal progress display; callbacks are \
evaluated on the main kernel rather than independently by workers."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReturnDetails\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to expose optional diagnostic \
data instead of the compact default result. For preparation and factorization \
completion it retains provenance, directions and validation and takes \
precedence over Output; for export it returns file paths and build/run \
results."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Output\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"Amplitudes\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Choose the amount and shape of returned information. \
Defaults are a compact check table, prepared input forms, a completed \
{externalMassRules, expression} pair, or a bare constructed expression; \
\"Details\" preserves diagnostics and provenance."}], "TableText"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Left, Left}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.23], Scaled[0.19],
         Scaled[0.58]}}, GridBoxDividers ->
      {"Rows" -> {False, True, {False}, False}}]], "3ColumnTableMod"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[
    {"Prepare the two QED diagrams with a physical-pole preference."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "process", " ", "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "\"A.+\"", "}", ";", "\n", "diagrams", " ", "=",
      " ", "CreateDiagrams", "[", "process", ",", " ", "qedModel", "]", ";",
      "\n", "amplitudes", " ", "=", " ", "DiagramAmplitudes", "[",
      "diagrams", "]", ";", "\n", "PrepareAmplitudes", "[", "amplitudes",
      ",", " ", "qedModel", ",", " ", "\"PolePreference\"", " ", "->", " ",
      "\"AllPhysical\"", "]"}]], "Input"], Cell["This example writes files, \
starts a longer calculation, or requires an optional external tool. Evaluate \
