   "AnchorBarGrid"], Cell["LorentzScalarProduct", "ObjectName"],
  Cell["Retains an off-shell scalar product in a Feynman rule.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzScalarProduct", "[", "p", ",",
         " ", "q", "]"}]], "InlineFormula"], "  ",
     "retains an off-shell scalar product in a Feynman rule."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["A CalcHEP momentum dot product is \
retained as this typed object before vertex momentum slots have been \
attached.", "Notes"], Cell["It does not apply p squared = mass squared to an \
internal momentum. The Feynman result must retain the full off-shell \
numerator.", "Notes"], Cell["After conversion, ordinary spinor expressions \
use MomProd or explicit momentum chains instead.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Construct the symbolic object.", "ExampleText"],
  Cell[BoxData[RowBox[{"LorentzScalarProduct", "[", "Mom", "[", "1", "]",
      " ", "+", " ", "Mom", "[", "3", "]", ",", " ", "Mom", "[", "2", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"LorentzScalarProduct", "[",
      RowBox[{RowBox[{SubscriptBox["p", "1"], "+", SubscriptBox["p", "3"]}],
