        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["LorentzScalarProduct", "ObjectName"],
  Cell[TextData[{"Represents a contracted momentum dot product before \
Feynman-rule conversion."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzScalarProduct", "[", "p", ",",
         " ", "q", "]"}]], "InlineFormula"], "  ",
     "retains an off-shell scalar product in a Feynman rule."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzScalarProduct", "[", "p", ",",
         "q", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "records", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"p", ".", "q"}]], "InlineFormula"],
     " in a Feynman vertex. Unlike ", ButtonBox["LorentzMomentum",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/LorentzMomentum"], ", it has no exposed Lorentz \
index: the contraction is already specified."}], "Notes"],
  Cell[TextData[{"Its arguments can contain sums of ",
     ButtonBox["Mom", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mom"], " objects. The reader keeps this form while \
the momenta still refer to local vertex slots. Diagram generation then \
attaches those slots to actual diagram momenta."}], "Notes"],
  Cell[TextData[{ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " \
distributes the scalar product over the supported momentum sums and writes \
the result with ", ButtonBox["MomProd", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomProd"],
     ". Internal momenta remain off shell throughout this conversion."}],
   "Notes"], Cell[TextData[{"The presence of an internal mass in a propagator \
does not set this scalar product to that mass squared. The retained \
virtuality is part of the ordinary Feynman numerator."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Keep a dot product with the composite momentum p1+p3 \
visible before conversion distributes it."}], "ExampleText"],
  Cell[BoxData[RowBox[{"LorentzScalarProduct", "[", "Mom", "[", "1", "]",
      " ", "+", " ", "Mom", "[", "3", "]", ",", " ", "Mom", "[", "2", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"LorentzScalarProduct", "[",
      RowBox[{RowBox[{SubscriptBox["p", "1"], "+", SubscriptBox["p", "3"]}],
        ",", SubscriptBox["p", "2"]}], "]"}]], "Output"],
  Cell[TextData[{"Distribute a dot product over its momentum sum while \
keeping every momentum off shell."}], "ExampleText"],
  Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[",
      "LorentzScalarProduct", "[", "Mom", "[", "1", "]", " ", "+", " ",
      "Mom", "[", "3", "]", ",", " ", "Mom", "[", "2", "]", "]", ",", " ",
      "\"ReduceSpinorProducts\"", " ", "->", " ", "False", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["LorentzMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMomentum"], "  \[Bullet]  ",
     ButtonBox["MomProd", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/MomProd"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
