   "AnchorBarGrid"], Cell["SymmetrizeSpins", "ObjectName"],
  Cell[TextData[{"Symmetrizes massive little-group indices for a list of \
external particles."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SymmetrizeSpins", "[", "expr", ",",
         " ", "indexLists", "]"}]], "InlineFormula"], "  ",
     "applies SymmetrizeSpin to each particle's index list."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"The index list at position i belongs to external leg i. For \
example, {{i},{j,k},{}} describes one spin-half leg, one spin-one leg, and \
one scalar leg."}], "Notes"],
  Cell[TextData[{"The function applies ", ButtonBox["SymmetrizeSpin",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpin"],
     " to each particle. It averages distinct assignments within each \
particle, including the proper treatment of repeated labels."}], "Notes"],
  Cell[TextData[{"This does not sum over physical external spin \
configurations or symmetrize identical particles. Those operations have \
different normalization and statistics factors. ",
     ButtonBox["SquareAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SquareAmplitude"], " uses these \
little-group manipulations when constructing a symbolic conjugate product."}]\
, "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Assign one index to each massive endpoint."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SymmetrizeSpins", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", ",", " ", "Spinor", "[", "\"Spin\"", ",", " ",
      "\"Angle\"", ",", " ", "2", "]", "]", ",", " ", "{", "{", "i", "}",
      ",", " ", "{", "j", "}", "}", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", TemplateBox[
           {StyleBox["1", Bold, StripOnInput -> False], "i"}, "Superscript",
           SyntaxForm -> SuperscriptBox]}, "RowDefault"],
        TemplateBox[{TemplateBox[{StyleBox["2", Bold, StripOnInput -> False],
            "j"}, "Superscript", SyntaxForm -> SuperscriptBox],
          "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
      ShowStringCharacters -> False], SpinorChain[Spinor["Spin", "Upper",
       "Angle", 1, i], Spinor["Spin", "Upper", "Angle", 2, j]],
     Editable -> False]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SymmetrizeSpin", BaseStyle -> "Link",
