  Cell[TextData[{Cell[BoxData[RowBox[{"DiracGamma5"}]], "InlineFormula"],
     "  ", "represents the chirality matrix in an ordered Dirac word."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracGamma5"}]], "InlineFormula"],
     " is a symbol used as an operator inside ", ButtonBox["DiracWord",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/DiracWord"], ". \
It does not take a Lorentz index. Its position records which matrices lie to \
its left and right."}], "Notes"],
  Cell[TextData[{ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " uses ",
     Cell[BoxData[RowBox[{"gamma5", " ", "=", " ", "diag", "(", "-", "1",
         ",", "+", "1", ")"}]], "InlineFormula"], " in its Weyl-block \
convention. This determines the signs of the angle and square contributions \
to a chiral coupling."}], "Notes"],
  Cell[TextData[{"Chiral projectors are linear combinations of the identity \
and this matrix. Keep the corresponding scalar coefficients and separate \
matrix terms when representing a projector explicitly. ",
     Cell[BoxData[RowBox[{"DiracWord", "[", "]"}]], "InlineFormula"],
     " supplies the identity part."}], "Notes"],
  Cell[TextData[{"The model reader inserts chirality operators from the \
supplied vertex rules. For routine model calculations, let ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], " and the diagram code \
retain these operators until conversion, rather than adding helicity signs by \
hand."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
