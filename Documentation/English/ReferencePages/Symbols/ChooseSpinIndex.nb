   "AnchorBarGrid"], Cell["ChooseSpinIndex", "ObjectName"],
  Cell["Selects a physical spin projection for one external massive \
particle.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ChooseSpinIndex", "[", "expr", ",",
         " ", "i", ",", " ", "projection", "]"}]], "InlineFormula"], "  ",
     "inserts the explicit spin-index combination for particle i."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["Supported projections \
include spin one half (+1/2 or -1/2) and spin one (+1,0,-1). The longitudinal \
spin-one state is a normalized sum of the two mixed index assignments.",
   "Notes"], Cell["These values are physical spin projections, not the \
doubled-spin integers used by the generated SPINAS C++ interface.", "Notes"],
  Cell["The function works with implicit massive Spinor indices and expands \
the input to apply the supported patterns. It is not a sum over spins.",
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Choose the positive spin-half state of leg 1.", "ExampleText"],
  Cell[BoxData[RowBox[{"ChooseSpinIndex", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Spin\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3",
      "]", "]", ",", " ", "1", ",", " ", "1", "/", "2", "]"}]], "Input"],
