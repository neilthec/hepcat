Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ChooseSpinIndex", "ObjectName"],
  Cell[TextData[
    {
     "Selects one physical spin projection of a massive external particle."}]\
, "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ChooseSpinIndex", "[", "expr", ",",
         " ", "i", ",", " ", "projection", "]"}]], "InlineFormula"], "  ",
     "inserts the explicit spin-index combination for particle i."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"The particle argument identifies the external leg. The last \
argument is its physical spin projection, such as +1/2 or -1/2 for a fermion, \
or +1, 0 and -1 for a spin-one particle."}], "Notes"],
  Cell[TextData[
    {"The input should contain that particle's implicit massive ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], " factors. HEPCAT replaces them by the \
appropriate explicit little-group components. For the longitudinal spin-one \
state it uses the normalized sum of the two mixed index assignments."}],
   "Notes"], Cell[TextData[{"This selects a state; it does not sum over \
states or average incoming spins. It also differs from merely naming indices \
with ", ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"], "."}],
   "Notes"], Cell[TextData[{"The generated ", ButtonBox["SPINAS",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/SPINAS"], " \
interface uses doubled-spin integers, while this symbolic function uses \
physical half-integer values. Thus a positive spin-half state is selected \
here by 1/2, not by the C++ label 1. To select several legs in particle \
order, use ", ButtonBox["ChooseSpinIndices", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndices"], "."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Choose the positive spin-half state of leg 1."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ChooseSpinIndex", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", "]", ",", " ", "1", ",", " ", "1",
      "/", "2", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", TemplateBox[
           {StyleBox["1", Bold, StripOnInput -> False], FractionBox["1",
             "2"]}, "Superscript", SyntaxForm -> SuperscriptBox]},
         "RowDefault"], TemplateBox[{"3", "\"\[RightAngleBracket]\""},
         "RowDefault"]}, "RowDefault"], ShowStringCharacters -> False],
     SpinorChain[Spinor["Spin", "Upper", "Angle", 1, 1/2],
      Spinor["Helicity", "Angle", 3]], Editable -> False]], "Output"],
  Cell[TextData[{"Choose the longitudinal state of a spin-one leg."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ChooseSpinIndex", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", "]", " ", "SpinorChain", "[",
      "Spinor", "[", "\"Spin\"", ",", " ", "\"Square\"", ",", " ", "1", "]",
      ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Square\"", ",",
      " ", "4", "]", "]", ",", " ", "1", ",", " ", "0", "]"}]], "Input"],
  Cell[BoxData[FractionBox[
     RowBox[{RowBox[{InterpretationBox[StyleBox[TemplateBox[
            {TemplateBox[{"\"\[LeftAngleBracket]\"", TemplateBox[
                {StyleBox["1", Bold, StripOnInput -> False], FractionBox["1",
                  "2"]}, "Superscript", SyntaxForm -> SuperscriptBox]},
              "RowDefault"], TemplateBox[{"3", "\"\[RightAngleBracket]\""},
              "RowDefault"]}, "RowDefault"], ShowStringCharacters -> False],
          SpinorChain[Spinor["Spin", "Upper", "Angle", 1, 1/2],
           Spinor["Helicity", "Angle", 3]], Editable -> False], " ",
         InterpretationBox[StyleBox[TemplateBox[
            {TemplateBox[{"\"[\"", TemplateBox[{StyleBox["1", Bold,
                  StripOnInput -> False], RowBox[{"-", FractionBox["1",
                    "2"]}]}, "Superscript", SyntaxForm -> SuperscriptBox]},
              "RowDefault"], TemplateBox[{"4", "\"]\""}, "RowDefault"]},
            "RowDefault"], ShowStringCharacters -> False],
          SpinorChain[Spinor["Spin", "Upper", "Square", 1, -2^(-1)],
           Spinor["Helicity", "Square", 4]], Editable -> False]}], "+",
       RowBox[{InterpretationBox[StyleBox[TemplateBox[
            {TemplateBox[{"\"\[LeftAngleBracket]\"", TemplateBox[
                {StyleBox["1", Bold, StripOnInput -> False], RowBox[
                  {"-", FractionBox["1", "2"]}]}, "Superscript",
                SyntaxForm -> SuperscriptBox]}, "RowDefault"],
             TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
            "RowDefault"], ShowStringCharacters -> False],
          SpinorChain[Spinor["Spin", "Upper", "Angle", 1, -2^(-1)],
           Spinor["Helicity", "Angle", 3]], Editable -> False], " ",
         InterpretationBox[StyleBox[TemplateBox[
            {TemplateBox[{"\"[\"", TemplateBox[{StyleBox["1", Bold,
                  StripOnInput -> False], FractionBox["1", "2"]},
                "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
             TemplateBox[{"4", "\"]\""}, "RowDefault"]}, "RowDefault"],
           ShowStringCharacters -> False], SpinorChain[Spinor["Spin",
            "Upper", "Square", 1, 1/2], Spinor["Helicity", "Square", 4]],
          Editable -> False]}]}], SqrtBox["2"]]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ChooseSpinIndices", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndices"], "  \[Bullet]  ",
     ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"],
     "  \[Bullet]  ", ButtonBox["SymmetrizeSpin", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpin"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ChooseSpinIndex - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ChooseSpinIndex", "title" -> "ChooseSpinIndex",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" ->
      "Selects one physical spin projection of a massive external particle.",
     "keywords" -> {"HEPCAT", "ChooseSpinIndex", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]