Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/AmplitudeValidation"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["CheckAmplitudes", "ObjectName"],
  Cell[TextData[{"Check a proposed amplitude against physical factorization, \
spurious-pole, high-energy and reference-spinor conditions."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CheckAmplitudes", "[", "amplitude",
         ",", " ", "channels", ",", " ", "model", "]"}]], "InlineFormula"],
     "  ", "Run the combined checks and return a compact status table."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CheckAmplitudes", "[", "amplitudePairs\
", ",", " ", "channels", ",", " ", "model", ",", " ", "options", "]"}]],
      "InlineFormula"], "  ",
     "Check the sum while retaining external mass information."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CheckAmplitudes", "[", "amplitude",
         ",", " ", "channels", ",", " ", "model", ",", " ", "\"Output\"",
         " ", "->", " ", "\"Details\"", "]"}]], "InlineFormula"], "  ",
     "Retain samples, differences, diagnostics and the run seed."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[
    {"Give the proposed amplitude, the ordinary channel rows from ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ", \
and the constructive model used for those channels. The amplitude may be a \
bare expression, one ", Cell[BoxData[RowBox[{"{", "externalMassRules", ",",
         " ", "expression", "}"}]], "InlineFormula"],
     " pair or a list of diagram pairs to be summed."}], "Notes"],
  Cell[TextData[{"The default result is a compact table of checks. ",
     Cell[BoxData[RowBox[{"PASS"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "means", " ", "that", " ", "the", " ",
         "requested", " ", "comparison", " ", "succeeded", " ", "at", " ",
         "the", " ", "recorded", " ", "samples", ".", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"FAIL"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "is", " ", "a", " ", "disagreement", ".",
         " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"Opp", " ", "Sign"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "means", " ", "a", " ", "residue", " ", "or",
         " ", "full", "-", "amplitude", " ", "comparison", " ", "agrees",
         " ", "after", " ", "an", " ", "overall", " ", "sign", " ",
         "reversal", ";", " ", "it", " ", "is", " ", "useful", " ",
         "diagnostic", " ", "information", ",", " ", "not", " ", "a", " ",
         "passing", " ", "result", ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"UNRESOLVED"}]], "InlineFormula"], " means the \
requested calculation could not establish a result, for example because a \
form is unsupported or a time limit was reached."}], "Notes"],
  Cell[TextData[{"The function reports what the supplied expression does. It \
does not change a sign, fit a normalization, simplify away a discrepancy by a \
new internal-shell assumption or repair the amplitude. To determine \
corrections from the known channels, use ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], "."}],
   "Notes"], Cell["What is checked", "NotesSection"],
  Cell[TextData[{"Physical poles are defined by the supplied factorization \
channels. At each pole, the checker compares the residue of the full \
amplitude with the sewn product of complete lower-point amplitudes. It \
accounts for HEPCAT's amplitude and propagator conventions, including the \
sewing minus sign. Every other propagator is kept away from its pole during \
an ordinary single-pole comparison."}], "Notes"],
  Cell[TextData[{"Apparent denominator poles not certified as physical by \
those channels are examined for cancellation. The checker discovers supported \
angle brackets, square brackets and other inverse factors from the \
expression. A spurious-pole ", Cell[BoxData[RowBox[{"PASS"}]],
      "InlineFormula"], " is evidence that the complete amplitude is finite \
on the tested approach to that apparent pole; individual summands may still \
diverge and cancel."}], "Notes"],
  Cell[TextData[{"The high-energy check increases the energy at fixed \
scattering angles while holding external masses and couplings fixed. The \
default bound is the renormalizable tree-level expectation ",
     Cell[BoxData[RowBox[{"E", "^", "(", "4", "-", "n", ")"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "for", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"n"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "external", " ", "particles", ".", " ", "If",
         " ", "your", " ", "theory", " ", "requires", " ", "another", " ",
         "bound", ",", " ", "state", " ", "it", " ", "with", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"HighEnergyBound\""}]],
      "InlineFormula"], "."}], "Notes"],
  Cell[TextData[{"When explicit Xi reference spinors remain, their choices \
are varied together while the physical momenta and external spin states are \
held fixed. An expression without explicit Xi objects has no explicit \
reference choice left to vary. This check does not claim a separate \
Ward-identity proof."}], "Notes"], Cell["Inspecting a disagreement",
   "NotesSection"],
  Cell[TextData[
    {"Start with the table to see which kind of check failed. Ask for ",
     Cell[BoxData[RowBox[{"\"Output\"", " ", "->", " ", "\"Residues\""}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "to", " ", "display", " ",
         "calculated", " ", "and", " ", "expected", " ", "pole", " ",
         "samples", ",", " ", "or", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"HighEnergy\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"References\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "to", " ", "inspect", " ", "those", " ",
         "comparisons", ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"Summary\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "gives", " ", "counts", ";", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"Details\""}]],
      "InlineFormula"], " retains the full report, sampled momenta, parameter \
rules and the actual random seed."}], "Notes"],
  Cell[TextData[
    {"Numerical parameter values come from the model by default. A ",
     Cell[BoxData[RowBox[{"\"ParameterRules\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "list", " ", "overrides", " ", "selected",
         " ", "inputs", " ", "locally", " ", "and", " ", "recomputes", " ",
         "dependent", " ", "values", ",", " ", "without", " ", "changing",
         " ", "the", " ", "symbolic", " ", "amplitude", ".", " ", "Set", " ",
         "an", " ", "integer", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"RandomSeed\""}]], "InlineFormula"],
     " to replay the same sampled comparison."}], "Notes"],
  Cell[TextData[{"The checks provide sampled evidence, not a proof that two \
symbolic expressions are identical for every allowed kinematic point. \
Increase the sample count or use independent tools when investigating a \
suspected agreement. The detailed report states which checks and kinematic \
restrictions were actually completed."}], "Notes"],
  Cell["Optional comparisons and narrower reports", "NotesSection"],
  Cell[TextData[{"Use ", Cell[BoxData[RowBox[{"\"FeynmanAmplitudes\""}]],
      "InlineFormula"], " to supply an independently obtained spinor-form \
Feynman expression or amplitude pairs. The full sums are compared away from \
propagator poles with no internal-shell substitutions. ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " and ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"],
     " provide the conversion and ordinary preparation steps."}], "Notes"],
  Cell[TextData[{"All four standard categories are enabled by their automatic \
defaults when applicable. For a deliberately narrower physical-residue-only \
report, set ", Cell[BoxData[RowBox[{"\"SpuriousPoles\"", " ", "->", " ", "{",
         "}"}]], "InlineFormula"], Cell[BoxData[RowBox[{",", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"HighEnergyCheck\"", " ",
         "->", " ", "False"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"ReferenceCheck\"", " ", "->", " ", "False"}]],
      "InlineFormula"], ". A missing or disabled test must not be interpreted \
as a successful check of that property."}], "Notes"],
  Cell[TextData[{"Automatic scheduling takes the number of coherent \
massive-spin components into account. A short expression can still represent \
sixteen or more components; those checks can reuse an existing worker pool \
instead of being treated as a small scalar calculation. Explicit parallel \
settings and custom kinematic maps keep their usual meaning."}], "Notes"],
  Cell[TextData[{"A high-energy PASS can come from an exact conservative \
bound on every spin component. This route also applies to compact expressions \
with several massive-spin legs, where separate Laurent expansions would be \
expensive. The report then says \[OpenCurlyDoubleQuote]At \
most\[CloseCurlyDoubleQuote] and records an upper-bound certificate; it does \
not claim to have measured a leading power."}], "Notes"],
  Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"KinematicMap\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Function map[expression, channels, poleVariables] \
evaluating every spinor, momentum and propagator consistently near selected \
cuts. The checker can construct supported automatic charts; \
PhysicalPoleResidue with Automatic alone returns a FORMAL structural \
coefficient."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"KinematicKind\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"Sample\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Scope of a supplied physical cut chart: \"Sample\" for \
sampled kinematics or \"Symbolic\" for a symbolic chart. A sampled match is \
evidence on the chart, not a general analytic identity."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"TimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"30"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Maximum elapsed time allowed by the \
operation or stage. Where Automatic is supported it selects a finite \
workload-dependent budget; explicit seconds or supported Infinity override \
it. A timeout is reported, never treated as a successful amplitude."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"UncutChannels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Other known physical channels that must \
remain generic while the selected cut is imposed. The chart validator rejects \
unintended extra cuts or incompatible external data."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Tolerance\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"1", "/", "10000000000"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Numerical comparison tolerance for sampled amplitudes \
and residues. Exact cancellations remain exact; tightening a tolerance does \
not remove floating-point conditioning problems near singular points."}],
        "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"Samples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"4"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Number of physical cut samples or \
fitting samples, depending on the stage. Automatic completion settings choose \
a bounded process-dependent count; successful fitting is followed by separate \
validation samples."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RandomSeed\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Random-sampling seed. Automatic resolves one \
time-based seed for the operation; an explicit integer, including zero, \
reproduces the sample choices. Detailed reports retain the resolved seed. \
ComplicateAmplitude uses the legacy symbol key RandomSeed; modern \
construction/checking functions use the string key \"RandomSeed\"."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ParameterRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Local numerical parameter overrides keyed by model \
references or string names. Automatic resolves the model's variables and \
dependent functions; fitting and checks do not assign global values or \
replace parameters in the symbolic final amplitude."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Output\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"Table\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Choose the amount and shape of returned information. \
Defaults are a compact check table, prepared input forms, a completed \
{externalMassRules, expression} pair, or a bare constructed expression; \
\"Details\" preserves diagnostics and provenance."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"SpuriousPoles\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Apparent nonphysical poles to test. Automatic \
discovers denominator factors not accounted for by the supplied physical \
channels; {} disables these tests instead of certifying cancellation."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"HighEnergyCheck\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether to test high-energy scaling of the complete \
amplitude. Automatic runs the applicable built-in check; False omits it and \
therefore narrows the reported validation."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"HighEnergyBound\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum allowed power of energy with masses fixed. \
Automatic uses the renormalizable tree target E^(4-n); provide a justified \
different bound for another theory or normalization."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"HighEnergySamples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"3"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Number of independent kinematic \
directions/spin assignments sampled for high-energy scaling. More samples \
improve numerical evidence but do not turn the check into a symbolic proof."}]\
, "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"HighEnergyTimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Time budget for the high-energy diagnostic. Automatic \
chooses a bounded allowance; unresolved scaling or a timeout is not counted \
as a pass."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReferenceCheck\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether the checker varies explicit Xi reference \
spinors. Automatic runs the applicable test; if no Xi remains, the report \
records no explicit dependence rather than claiming an additional analytic \
Ward-identity proof."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReferenceSamples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"3"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Number of reference-spinor comparisons \
on conserved external kinematics. These comparisons hold the physical \
phase-space point fixed while changing admissible references."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReferenceTimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Budget for reference comparisons in checking, or \
reference-choice search in preparation. Automatic bounds this work; \
preparation shares it with the remaining per-item clock rather than adding an \
unlimited extra search."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FeynmanAmplitudes\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Independent Feynman amplitude \
expressions or pairs to compare at ordinary off-cut momenta. None omits this \
extra comparison; it does not disable the constructive physical-pole checks."}\
], "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"FeynmanModel\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"The independent model used with Feynman amplitudes. In \
ConstructAmplitude, None omits Feynman generation and an explicit model \
enables it; in the checker, Automatic uses the appropriate supplied model \
context when available."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FeynmanSamples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Number of independent phase-space/spin comparisons \
with the supplied Feynman result. Automatic chooses a bounded count \
appropriate to the checking workload."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FeynmanTimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Time budget for the independent Feynman comparison. \
Automatic resolves a bounded allowance; a timeout is reported as unresolved, \
not as agreement."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Parallelization\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether independent items or checks may use local \
Wolfram workers. Automatic uses suitable parallel work within available \
resources; False requests serial evaluation, and result order is retained."}]\
, "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxKernels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum local Wolfram worker kernels available to \
parallel stages. Automatic respects processor availability and license \
limits; 1 requests serial execution. Worker setup and expression transfer can \
outweigh small jobs."}], "TableText"]}}, GridBoxAlignment ->
      {"Columns" -> {Left, Left, Left}}, GridBoxItemSize ->
      {"Columns" -> {Scaled[0.23], Scaled[0.19], Scaled[0.58]}},
     GridBoxDividers -> {"Rows" -> {False, True, {False}, False}}]],
   "3ColumnTableMod"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"], Cell[TextData[{"Check a known QED four-point amplitude \
against channels from three-point vertices."}], "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "knownQEDModel", " ",
      "=", " ", "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";",
      "\n", "process", " ", "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",",
      " ", "\"A.+\"", ",", " ", "\"A.+\"", "}", ";", "\n", "amplitude", " ",
      "=", " ", "LookupAmplitude", "[", "Thread", "[", "{", "process", ",",
      " ", "Range", "[", "4", "]", "}", "]", ",", " ", "knownQEDModel", ",",
      " ", "False", ",", " ", "{", "i1", ",", " ", "i2", ",", " ", "i3", ",",
      " ", "i4", "}", "]", ";", "\n", "channels", " ", "=", " ",
      "FactorizationAmplitudeChannels", "[", "process", ",", " ", "qedModel",
      "]", ";", "\n", "CheckAmplitudes", "[", "amplitude", ",", " ",
      "channels", ",", " ", "knownQEDModel", ",", " ", "\"RandomSeed\"", " ",
      "->", " ", "314159", "]"}]], "Input"], Cell["This example writes files, \
starts a longer calculation, or requires an optional external tool. Evaluate \
it when you want to perform that operation.", "ExampleText"],
  Cell[TextData[{"Ask for the concrete comparisons only when needed."}],
   "ExampleText"], Cell[BoxData[RowBox[{"CheckAmplitudes", "[", "amplitude",
      ",", " ", "channels", ",", " ", "knownQEDModel", ",", " ",
      "\"Output\"", " ", "->", " ", "\"Residues\"", ",", " ",
      "\"RandomSeed\"", " ", "->", " ", "314159", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
