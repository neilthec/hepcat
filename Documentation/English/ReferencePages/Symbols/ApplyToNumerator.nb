Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ApplyToNumerator", "ObjectName"],
  Cell[TextData[{"Applies replacement rules to each existing additive term's \
numerator while preserving its denominator."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ApplyToNumerator", "[", "expr", ",",
         " ", "rules", "]"}]], "InlineFormula"], "  ", "applies one \
replacement rule or a list of rules to each term's numerator."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when an identity is allowed in a diagram numerator \
but must not act on its propagator. The function visits the additive terms \
already present in the expression and applies your replacement rule or rule \
list to each numerator."}], "Notes"],
  Cell[TextData[{"It does not call Together or Expand first. A factored sum \
inside one term therefore stays within that numerator; separate rational \
terms are not merged into a common fraction before applying the rules."}],
   "Notes"], Cell[TextData[{"Only the stated replacement is requested. The \
denominator of each visited term is restored unchanged, although ordinary \
Mathematica evaluation can simplify the resulting expression afterward."}],
   "Notes"], Cell[TextData[{"This function does not decide whether your rules \
are valid identities or which internal channel is on shell. For a general \
diagram-preparation calculation, ", ButtonBox["PrepareAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PrepareAmplitudes"], " obtains those assumptions \
from the item's declared mass rules and protects ",
     ButtonBox["PropDen", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PropDen"], " factors."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Replace numerator symbols without altering their denominators."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ApplyToNumerator", "[", "(", "a",
      " ", "+", " ", "b", ")", "/", "d", " ", "+", " ", "c", "/", "e", ",",
      " ", "{", "a", " ", "->", " ", "x", ",", " ", "c", " ", "->", " ", "y",
      "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"(", "b", " ", "+", " ", "x", ")", "/", "d", " ", "+",
      " ", "y", "/", "e"}]], "Output"],
  Cell[TextData[{"Transform a factored numerator without expansion."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ApplyToNumerator", "[", "(", "a",
      " ", "+", " ", "b", ")", "^", "2", "/", "d", ",", " ", "{", "a", " ",
      "->", " ", "x", "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"(", "b", " ", "+", " ", "x", ")", "^", "2", "/",
      "d"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ApplyToNumerator - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ApplyToNumerator", "title" -> "ApplyToNumerator",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
