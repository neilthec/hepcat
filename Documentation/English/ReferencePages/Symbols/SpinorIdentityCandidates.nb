                  TemplateBox[{"4", "\"\[RightAngleBracket]\""},
                   "RowDefault"]}, "RowDefault"]}], "}"}]}], ",",
          RowBox[{"\"Splits\"", "\[Rule]", RowBox[{"{", RowBox[{"0", ",",
                "0"}], "}"}]}]}], "]"}], "}"}]], "Output"],
