  Cell[TextData[{"Refer to a mass, coupling or other parameter belonging to a \
particular model."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameter", "[", "model", ",",
         " ", "name", "]"}]], "InlineFormula"], "  ",
     "Find a declared parameter by its string name."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameter", "[", "name", ",",
         " ", "scope", ",", " ", "domain", "]"}]], "InlineFormula"], "  ",
     "Retain a parameter as inert model-local data."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use ", Cell[BoxData[RowBox[{"ModelParameter", "[", "model",
         ",", " ", "\"Me\"", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "to", " ", "retrieve", " ", "the", " ",
