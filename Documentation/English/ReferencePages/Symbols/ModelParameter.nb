Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ModelParameter", "ObjectName"],
  Cell["Represent and retrieve a parameter belonging to one model.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameter", "[", "model", ",",
         " ", "name", "]"}]], "InlineFormula"], "  ",
     "Find a declared parameter by its string name."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameter", "[", "name", ",",
         " ", "scope", ",", " ", "domain", "]"}]], "InlineFormula"], "  ",
     "Retain a parameter as inert model-local data."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["Parameters display their model \
names, such as Me or EE, but are not global Wolfram symbols. Keep the typed \
parameter in expressions and obtain numerical replacements with \
ModelParameterRules.", "Notes"], Cell["The scope separates declarations \
belonging to different model data. A string lookup returns Failure when the \
name is absent or ambiguous; it does not create a new declaration.",
   "Notes"], Cell["The domain \"Real\" makes Conjugate[parameter] evaluate to \
parameter. Imported model declarations currently retain this real-parameter \
convention. Other domains do not receive that automatic conjugation rule.",
   "Notes"], Cell["Use ModelParameterName to inspect the displayed name. \
Directly constructing a reference is mainly useful for tools that preserve \
model data; routine physics code should retrieve the reference from its \
model.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Retrieve a declared electron mass.", "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "me", " ", "=", " ",
      "ModelParameter", "[", "qedModel", ",", " ", "\"Me\"", "]", ";", "\n",
      "{", "ModelParameterName", "[", "me", "]", ",", " ", "Conjugate", "[",
      "me", "]", " ", "===", " ", "me", "}"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "\"Me\"", ",", " ", "True", "}"}]], "Output"],
  Cell["Override a value locally without assigning Me globally.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "me", " ", "=", " ", "ModelParameter", "[", "qedModel", ",", " ",
      "\"Me\"", "]", ";", "\n", "me", " ", "/.", " ", "ModelParameterRules",
      "[", "qedModel", ",", " ", "{", "\"Me\"", " ", "->", " ", "1", "}",
      "]"}]], "Input"], Cell[BoxData[RowBox[{"1"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ModelParameterName", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterName"], "  \[Bullet]  ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"],
     "  \[Bullet]  ", ButtonBox["ModelFunction", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelFunction"], "  \[Bullet]  ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ModelParameter - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ModelParameter", "title" -> "ModelParameter",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" ->
      "Represent and retrieve a parameter belonging to one model.",
     "keywords" -> {"HEPCAT", "ModelParameter", "spinor amplitudes"},
