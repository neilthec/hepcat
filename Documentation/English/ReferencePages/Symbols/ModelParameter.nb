      "\"Me\"", "]", ";", "\n", "{", "ModelParameterName", "[", "me", "]",
      ",", " ", "Conjugate", "[", "me", "]", " ", "===", " ", "me", "}"}]],
   "Input"], Cell[BoxData[RowBox[{"{", "\"Me\"", ",", " ", "True", "}"}]],
   "Output"],
  Cell[TextData[{"Override a value locally without assigning Me globally."}],
