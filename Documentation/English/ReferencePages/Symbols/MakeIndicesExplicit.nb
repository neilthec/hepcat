Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["MakeIndicesExplicit", "ObjectName"],
  Cell[TextData[{"Inserts specified upper little-group indices into the \
implicit massive spinors of an expression."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"MakeIndicesExplicit", "[", "expr",
         ",", " ", "i", ",", " ", "{", "indices", "}", "]"}]],
      "InlineFormula"], "  ", "assigns the listed indices to particle i."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"MakeIndicesExplicit", "[", "expr",
         ",", " ", "indexLists", "]"}]], "InlineFormula"], "  ",
     "assigns the per-particle list at position i to particle i."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when deriving a spin sum or when you need to see \
which massive-spinor occurrence carries which little-group index. For one \
spin-half leg, supply one index; higher-spin states need the corresponding \
list of two, three or four indices."}], "Notes"],
  Cell[TextData[{"The two-argument form takes a list of index lists in \
external-particle order. An empty list can be used for a scalar leg. The \
three-argument form acts on one explicitly numbered particle."}], "Notes"],
  Cell[TextData[{"Index insertion does not symmetrize the state or select a \
normalized physical projection. Use ", ButtonBox["SymmetrizeSpin",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpin"],
     " for index symmetrization and ", ButtonBox["ChooseSpinIndex",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ChooseSpinIndex"],
     " for a definite physical spin state."}], "Notes"],
  Cell[TextData[{"The implementation expands the relevant products while \
matching implicit factors. Internal spin contractions should be handled with \
", ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     " before assigning the remaining external indices."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Insert one explicit upper little-group index."}],
   "ExampleText"], Cell[BoxData[RowBox[{"MakeIndicesExplicit", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", "]", ",", " ", "1", ",", " ", "{",
      "j", "}", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
        TemplateBox[{StyleBox["1", Bold, StripOnInput -> False], "j"},
         "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
      TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"]], "Output"],
  Cell[TextData[{"Supply index lists in particle order."}], "ExampleText"],
  Cell[BoxData[RowBox[{"MakeIndicesExplicit", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"", ",", " ", "1", "]",
      ",", " ", "Spinor", "[", "\"Spin\"", ",", " ", "\"Square\"", ",", " ",
      "2", "]", "]", ",", " ", "{", "{", "i", "}", ",", " ", "{", "j", "}",
      "}", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
        TemplateBox[{StyleBox["1", Bold, StripOnInput -> False], "i"},
         "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
      TemplateBox[{TemplateBox[{StyleBox["2", Bold, StripOnInput -> False],
          "j"}, "Superscript", SyntaxForm -> SuperscriptBox], "\"]\""},
       "RowDefault"]}, "RowDefault"]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["MakeIndicesImplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesImplicit"],
     "  \[Bullet]  ", ButtonBox["SymmetrizeSpin", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpin"], "  \[Bullet]  ",
     ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
  "MakeIndicesExplicit - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/MakeIndicesExplicit",
     "title" -> "MakeIndicesExplicit", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
