   "AnchorBarGrid"], Cell["MakeIndicesExplicit", "ObjectName"],
  Cell["Replaces implicit massive spin indices with specified explicit upper \
indices.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"MakeIndicesExplicit", "[", "expr",
         ",", " ", "i", ",", " ", "{", "indices", "}", "]"}]],
      "InlineFormula"], "  ", "assigns the listed indices to particle i."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"MakeIndicesExplicit", "[", "expr",
         ",", " ", "indexLists", "]"}]], "InlineFormula"], "  ",
     "assigns the per-particle list at position i to particle i."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The supported patterns \
contain one through four spin indices per particle, corresponding to spin one \
half through spin two. A scalar leg can have an empty index list.", "Notes"],
  Cell["This is index insertion, not a symmetrized spin state. Use \
SymmetrizeSpin or ChooseSpinIndex for those operations.", "Notes"],
  Cell["ConstructiveAmplitude wrappers are supported by acting on their \
numerator. The implementation expands relevant expressions before matching.",
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Insert one explicit upper little-group index.", "ExampleText"],
  Cell[BoxData[RowBox[{"MakeIndicesExplicit", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"", ",", " ", "1", "]",
      ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",",
      " ", "3", "]", "]", ",", " ", "1", ",", " ", "{", "j", "}", "]"}]],
