   "AnchorBarGrid"], Cell["CreateDiagrams", "ObjectName"],
  Cell[TextData[{"Generate the tree diagrams allowed by a model for an \
ordered external process."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CreateDiagrams", "[", "{", "p1", ",",
         " ", "p2", ",", " ", "...", "}", ",", " ", "model", "]"}]],
      "InlineFormula"], "  ",
     "Generate trees for an ordered all-ingoing external particle list."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CreateDiagrams", "[", "p1", ",", " ",
         "p2", ",", " ", "...", ",", " ", "model", "]"}]], "InlineFormula"],
     "  ", "Use the equivalent separate-particle argument form."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"The process is a list of model particle-name strings. Their \
positions fix labels ", Cell[BoxData[RowBox[{"1"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{",", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"2"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{",", " ", "and", " ", "so", " ", "on", ",", " ",
         "and", " ", "all", " ", "external", " ", "momenta", " ", "are", " ",
         "ingoing", ".", " ", "For", " ", "example", ",", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"{", "\"e\"", ",", " ", "\"E\"",
         ",", " ", "\"A.+\"", ",", " ", "\"A.-\"", "}"}]], "InlineFormula"],
     " selects two fermion states and two photon helicities in the bundled \
QED model."}], "Notes"],
  Cell[TextData[
    {"The result is a list of diagram objects, not an amplitude sum. Use ",
     ButtonBox["CreateArrowDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateArrowDiagrams"],
     " to draw them. Use ", ButtonBox["DiagramAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/DiagramAmplitudes"],
     " to obtain one mass-rule/expression pair for each diagram, then ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"],
     " to simplify those expressions."}], "Notes"],
  Cell[TextData[{"For constructive models, each generic internal photon or \
gluon represents the combined helicity contribution. It is not necessary to \
generate a separate topology for each internal helicity. The model's \
particle, antiparticle and twice-spin declarations also determine fermion \
connections and exchange signs."}], "Notes"],
  Cell[TextData[{"With a ", ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"], ", the same call \
selects Feynman vertices and propagators. Those internal numerators remain \
off shell. ", ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " or \
Feynman preparation converts their Lorentz and Dirac structures for \
comparison."}], "Notes"], Cell[TextData[{"This function generates diagrams \
from the supplied interactions. It does not infer missing vertices, complete \
an amplitude from factorization data or establish that a simplified sum \
passes physical checks. ", ButtonBox["ConstructAmplitude",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ConstructAmplitude"],
     " combines those later stages when you want the full workflow."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[{"Generate the two four-point QED orderings."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
