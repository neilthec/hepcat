Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/DiagramsAndFactorization"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["CreateDiagrams", "ObjectName"],
  Cell["Generate tree diagrams from a supplied constructive or Feynman \
model.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CreateDiagrams", "[", "{", "p1", ",",
         " ", "p2", ",", " ", "...", "}", ",", " ", "model", "]"}]],
      "InlineFormula"], "  ",
     "Generate trees for an ordered all-ingoing external particle list."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CreateDiagrams", "[", "p1", ",", " ",
         "p2", ",", " ", "...", ",", " ", "model", "]"}]], "InlineFormula"],
     "  ", "Use the equivalent separate-particle argument form."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The external list determines \
particle labels 1, 2, and so on. Use the model's literal names, including \
massless helicity suffixes such as A.+ and A.-.", "Notes"],
  Cell["For constructive photon or gluon internal lines, one generic internal \
line represents both helicities. The graph count is not doubled for each \
internal helicity.", "Notes"], Cell["Each tree is an association containing \
graph and particle data, propagators, vertex information and index maps. Pass \
the resulting list to CreateArrowDiagrams for display or diagramAmplitudes \
for expressions.", "Notes"], Cell["Constructive and Feynman models follow \
their own amplitude rules. Feynman internal propagators and numerators remain \
off shell; constructive numerator preparation can use explicitly declared \
diagram-local shell conditions.", "Notes"], Cell["Use the model containing \
the intended vertices for diagram generation. A complete higher-point \
amplitude included for factorization is not automatically a new independent \
interaction in the theory.", "Notes"], Cell["Fewer than three external legs \
or unsupported particle names produce no generated diagrams.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Generate the two four-point QED orderings.", "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "process", " ", "=",
      " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ",
      "\"A.+\"", "}", ";", "\n", "diagrams", " ", "=", " ", "CreateDiagrams",
      "[", "process", ",", " ", "qedModel", "]", ";", "\n", "Length", "[",
      "diagrams", "]"}]], "Input"], Cell[BoxData[RowBox[{"2"}]], "Output"],
  Cell["Generate all six photon orderings at five points.", "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "Length", "[",
      "CreateDiagrams", "[", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "\"A.+\"", ",", " ", "\"A.+\"", "}", ",", " ",
      "qedModel", "]", "]"}]], "Input"], Cell[BoxData[RowBox[{"6"}]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["CreateArrowDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateArrowDiagrams"],
     "  \[Bullet]  ", ButtonBox["diagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/diagramAmplitudes"], "  \[Bullet]  ",
     ButtonBox["DiagramAmplitudeRecords", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudeRecords"],
     "  \[Bullet]  ", ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Diagrams and Factorization Channels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/DiagramsAndFactorization"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "CreateDiagrams - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
