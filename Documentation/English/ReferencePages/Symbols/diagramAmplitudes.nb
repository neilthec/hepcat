Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/DiagramsAndFactorization"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["diagramAmplitudes", "ObjectName"],
  Cell["Evaluate every tree while retaining its separate mass and \
internal-cut declarations.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"diagramAmplitudes", "[", "diagrams",
         "]"}]], "InlineFormula"], "  ",
     "Return {{massRules, expression}, ...} for the generated diagrams."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The first entry of each \
pair declares external masses and, for constructive diagrams, the internal \
channel masses belonging to that diagram. The second entry is the expression \
with known mass replacements already applied.", "Notes"],
  Cell["Keep each diagram's conditions separate. Conditions from different \
constructive diagrams are not simultaneous shell assumptions for the complete \
sum.", "Notes"], Cell["Feynman diagram pairs contain external mass \
declarations without internal on-shell assumptions. Their exact propagators \
remain off shell.", "Notes"], Cell["External x factors are already expanded. \
Use PrepareAmplitudes next rather than manually repeating the old x-factor \
replacement step.", "Notes"], Cell["Total[Last /@ amplitudes] extracts the \
bare sum, but loses useful process and preparation provenance. Detailed \
preparation reports retain discarded terms for later completion.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Get the two separately declared four-point diagram expressions.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "process", " ", "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "\"A.+\"", "}", ";", "\n", "diagrams", " ", "=",
      " ", "CreateDiagrams", "[", "process", ",", " ", "qedModel", "]", ";",
      "\n", "amplitudes", " ", "=", " ", "diagramAmplitudes", "[",
      "diagrams", "]", ";", "\n", "Length", "[", "amplitudes", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"2"}]], "Output"],
  Cell["Prepare them with a physical-pole preference.", "ExampleText"],
  Cell[BoxData[RowBox[{"prepared", " ", "=", " ", "PrepareAmplitudes", "[",
      "amplitudes", ",", " ", "qedModel", ",", " ", "\"PolePreference\"",
      " ", "->", " ", "\"AllPhysical\"", "]", ";", "\n", "prepared"}]],
   "Input"], Cell["This example writes files, starts a longer calculation, or \
requires an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], "  \[Bullet]  ",
     ButtonBox["diagramAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/diagramAmplitude"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "  \[Bullet]  ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"],
     "  \[Bullet]  ", ButtonBox["DiagramAmplitudeRecords",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/DiagramAmplitudeRecords"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Diagrams and Factorization Channels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/DiagramsAndFactorization"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "diagramAmplitudes - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
