Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["LorentzMetric", "ObjectName"],
  Cell[TextData[{"Represents the Minkowski metric used to contract Lorentz \
indices in a Feynman expression."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzMetric", "[", "index1", ",",
         " ", "index2", "]"}]], "InlineFormula"], "  ",
     "represents the Minkowski metric with two Lorentz indices."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzMetric", "[", "mu", ",", "nu",
         "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "represents", " ", "the", " ", "metric", " ",
         "with", " ", "signature", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"(", "+", ",", "-", ",", "-", ",", "-", ")"}]],
      "InlineFormula"],
     ". Its two arguments label the tensor indices to be contracted."}],
   "Notes"], Cell[TextData[{"For example, the product ",
     Cell[BoxData[RowBox[{"LorentzMetric", "[", "mu", ",", "nu", "]", " ",
         "LorentzMomentum", "[", "Mom", "[", "1", "]", ",", "mu", "]", " ",
         "LorentzMomentum", "[", "Mom", "[", "2", "]", ",", "nu", "]"}]],
      "InlineFormula"], " represents the scalar product of two momenta. ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     " contracts such products before writing the answer with ",
     ButtonBox["MomProd", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/MomProd"], " and spinor chains."}], "Notes"],
  Cell[TextData[{"A single metric with different free indices is a tensor, \
not a scalar amplitude. Conversion of a complete amplitude requires all its \
indices to be contracted. A repeated metric index represents the \
four-dimensional trace."}], "Notes"],
  Cell[TextData[{"Use ", ButtonBox["LorentzScalarProduct",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/LorentzScalarProduct"],
     " for a dot product that is already contracted and ",
     ButtonBox["LorentzMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMomentum"],
     " for a momentum with one index still exposed."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Write the metric acting on a momentum. The remaining free \
index makes this a vector tensor, ready for another contraction."}],
   "ExampleText"], Cell[BoxData[RowBox[{"LorentzMetric", "[", "mu", ",", " ",
      "nu", "]", " ", "LorentzMomentum", "[", "Mom", "[", "1", "]", ",", " ",
      "nu", "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"LorentzMetric", "[",
        RowBox[{"mu", ",", "nu"}], "]"}], " ",
      RowBox[{"LorentzMomentum", "[", RowBox[{SubscriptBox["p", "1"], ",",
          "nu"}], "]"}]}]], "Output"],
  Cell[TextData[{"Contract the four-dimensional metric trace. This is a \
scalar expression with no external wavefunctions."}], "ExampleText"],
  Cell[BoxData[RowBox[{"FeynmanToSpinorProducts", "[", "LorentzMetric", "[",
      "mu", ",", " ", "mu", "]", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["LorentzIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzIndex"], "  \[Bullet]  ",
     ButtonBox["LorentzMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMomentum"], "  \[Bullet]  ",
     ButtonBox["LorentzScalarProduct", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzScalarProduct"],
     "  \[Bullet]  ", ButtonBox["FeynmanToSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/FeynmanToSpinorProducts"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "LorentzMetric - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
