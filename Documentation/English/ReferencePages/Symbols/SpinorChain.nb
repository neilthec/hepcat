      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"0"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
