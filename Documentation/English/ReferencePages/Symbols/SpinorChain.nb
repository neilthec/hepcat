Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SpinorChain", "ObjectName"],
  Cell[TextData[{"Represents a spinor bracket or an ordered spinor chain with \
momentum insertions."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorChain", "[", "left", ",", " ",
         "right", "]"}]], "InlineFormula"], "  ",
     "represents a bracket with two spinor endpoints."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorChain", "[", "left", ",", " ",
         "Mom", "[", "i1", "]", ",", " ", "Mom", "[", "i2", "]", ",", " ",
         "...", ",", " ", "right", "]"}]], "InlineFormula"], "  ",
     "represents a momentum chain with its given order."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"The first and last arguments are ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], " objects. The intervening arguments, \
when present, are momentum insertions written with ",
     ButtonBox["Mom", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mom"],
     ". For example, a square endpoint on leg 1, ",
     Cell[BoxData[RowBox[{"Mom", "[", "2", "]"}]], "InlineFormula"],
     ", and an angle endpoint on leg 3 display as [123>."}], "Notes"],
  Cell[TextData[{"The endpoint types and number of momentum insertions \
determine the chain's chirality. Keep the momentum arguments in their \
intended order: p2 p3 and p3 p2 are matrix products, and their difference is \
controlled by spinor identities rather than ordinary commutativity."}],
   "Notes"], Cell[TextData[{"In the typeset display, the middle labels give \
the momentum insertions in order. For example, [1234] is a square chain with \
p2 followed by p3. Parentheses group a summed momentum into one slot and \
commas separate multi-digit labels. The typed expression retains the endpoint \
chirality, momenta and spin indices."}], "Notes"],
  Cell[TextData[{"Constructing a chain records the expression; it does not \
request every available simplification. Use ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     " for algebraic reduction, or ", ButtonBox["SpinorIdentityCandidates",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorIdentityCandidates"], " and ",
     ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"],
     " when you want to choose and record individual identity steps."}],
   "Notes"], Cell["Momentum sums inside a chain", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Mom", "[", "Multiparticle", "[", "2",
         ",", " ", "3", "]", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "records", " ", "p2", "+", "p3", " ", "in",
         " ", "one", " ", "slot", ".", " ", "It", " ", "represents", " ",
         "the", " ", "same", " ", "linear", " ", "momentum", " ",
         "insertion", " ", "as", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"Mom", "[", "2", "]", "+", "Mom", "[", "3", "]"}]],
      "InlineFormula"], ". The reducer can distribute such a slot when doing \
so is useful, while preserving the order of the remaining insertions."}],
   "Notes"], Cell[TextData[{"A chain containing a composite momentum is not \
by itself an instruction to put that momentum on shell. Diagram-specific \
internal-shell information is supplied separately through ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"], Cell["Writing chains",
   "ExampleSubsection"],
  Cell[TextData[
    {
     "Build the square bracket [12] from its two typed massless endpoints."}]\
, "ExampleText"], Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "2",
      "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"[\"", "1"}, "RowDefault"],
        TemplateBox[{"2", "\"]\""}, "RowDefault"]}, "RowDefault"],
      ShowStringCharacters -> False], SpinorChain[Spinor["Helicity",
       "Square", 1], Spinor["Helicity", "Square", 2]], Editable -> False]],
   "Output"], Cell["Writing chains", "ExampleSubsection"],
  Cell[TextData[{"Keep p2 as a matrix insertion between a square spinor on \
leg 1 and an angle spinor on leg 3, giving [123>."}], "ExampleText"],
  Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Square\"", ",", " ", "1", "]", ",", " ", "Mom", "[", "2",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "3", "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"[\"", "1"}, "RowDefault"], "2",
        TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"], ShowStringCharacters -> False],
     SpinorChain[Spinor["Helicity", "Square", 1], Mom[2],
      Spinor["Helicity", "Angle", 3]], Editable -> False]], "Output"],
  Cell["Reducing a chain", "ExampleSubsection"],
  Cell[TextData[{"Reduce a repeated massless angle endpoint."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", "]", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Spinor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Spinor"], "  \[Bullet]  ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinContractions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinContractions"], "  \[Bullet]  ",
     ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SpinorChain - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/SpinorChain", "title" -> "SpinorChain",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" -> "Represents a spinor bracket or an \
ordered spinor chain with momentum insertions.",
     "keywords" -> {"HEPCAT", "SpinorChain", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]