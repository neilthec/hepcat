   "AnchorBarGrid"], Cell["SpinorChain", "ObjectName"],
  Cell["Represents an angle or square spinor bracket, optionally with an \
ordered sequence of momentum insertions.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorChain", "[", "left", ",", " ",
         "right", "]"}]], "InlineFormula"], "  ",
     "represents a bracket with two spinor endpoints."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorChain", "[", "left", ",", " ",
         "Mom", "[", "i1", "]", ",", " ", "Mom", "[", "i2", "]", ",", " ",
         "...", ",", " ", "right", "]"}]], "InlineFormula"], "  ",
     "represents a momentum chain with its given order."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["Angle and square are represented by \
Spinor endpoints with type \"Angle\" or \"Square\". An even number of \
momentum insertions connects equal chiralities; an odd number connects \
opposite chiralities.", "Notes"], Cell["SpinorChain already has readable \
notebook formatting. Keep the expression itself for algebra, substitution and \
export.", "Notes"], Cell["ReduceSpinorProducts applies ordinary spinor \
identities. ReduceSpinContractions first sews explicit contracted spin \
indices. Neither a displayed bracket nor a reference spinor alone specifies a \
physical process.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"], Cell["Write a square bracket.",
   "ExampleText"], Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "2",
      "]", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"[\"", "1"}, "RowDefault"],
      TemplateBox[{"2", "\"]\""}, "RowDefault"]}, "RowDefault"]], "Output"],
  Cell["Write [1|p2|3>.", "ExampleText"],
  Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Square\"", ",", " ", "1", "]", ",", " ", "Mom", "[", "2",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "3", "]", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"[\"", "1"}, "RowDefault"],
      "\"|\"", SubscriptBox["p", "2"], "\"|\"",
      TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"]], "Output"],
  Cell["Reduce a repeated massless angle endpoint.", "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[", "SpinorChain", "[",
