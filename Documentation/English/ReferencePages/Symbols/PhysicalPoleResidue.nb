Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/AmplitudeValidation"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PhysicalPoleResidue", "ObjectName"],
  Cell["Extract a single- or compatible multiple-pole coefficient with \
explicit kinematic scope.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PhysicalPoleResidue", "[",
         "expression", ",", " ", "channel", "]"}]], "InlineFormula"], "  ",
     "Extract the coefficient at one declared physical pole."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PhysicalPoleResidue", "[",
         "expression", ",", " ", "{", "channel1", ",", " ", "channel2", ",",
         " ", "...", "}", "]"}]], "InlineFormula"], "  ",
     "Extract a compatible multiple-pole coefficient."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PhysicalPoleResidue", "[",
         "expression", ",", " ", "channels", ",", " ", "\"KinematicMap\"",
         " ", "->", " ", "map", "]"}]], "InlineFormula"], "  ",
     "Restrict the complete expression on a coherent physical cut chart."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The channel input is a \
normalized association or a list of such associations describing \"Cut\", \
\"ExternalLegs\", \"Mass\" and the matching propagator. \
DiagramAmplitudeRecords exposes suitable \"PhysicalPropagators\" records.",
   "Notes"], Cell["With \"KinematicMap\" -> Automatic, the result has \
\"Status\" -> \"FORMAL\". \"StructuralCoefficient\" treats PropDen as an \
opaque pole variable and does not prove that spinor numerators have the \
required physical residue.", "Notes"], Cell["A map is called as \
map[expression, channels, poleVariables]. It must evaluate spinors, momenta \
and denominators consistently while preserving external shells, momentum \
conservation and the selected cut coordinates without imposing unrelated \
cuts.", "Notes"], Cell["With a valid chart the physical result is stored in \
\"PhysicalResidue\". \"KinematicKind\" distinguishes numerical sample charts \
from symbolic charts. A sampled PASS is evidence on that chart, not an \
identity for all kinematics.", "Notes"], Cell["The full rational expression \
is canceled before cut substitution. A surviving higher-order pole, invalid \
chart or timeout returns UNRESOLVED rather than silently substituting into a \
singular denominator.", "Notes"], Cell["The default \"StructuralCoefficient\" \
-> True also computes the optional formal coefficient. False can save that \
extra symbolic work when the physical chart calculation is the intended \
result.", "Notes"], Cell["Physical residue extraction does not inherit a \
collection of internal numerator-shell assumptions from diagrams. The chosen \
cut is imposed through the chart.", "Notes"],
  Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"KinematicMap\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"], Cell["Function map[expression, \
channels, poleVariables] evaluating every spinor, momentum and propagator \
consistently near selected cuts. The checker can construct supported \
automatic charts; PhysicalPoleResidue with Automatic alone returns a FORMAL \
structural coefficient.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"KinematicKind\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"Sample\""}]],
           "InlineFormula"]}], "TableText"], Cell["Scope of a supplied \
physical cut chart: \"Sample\" for sampled kinematics or \"Symbolic\" for a \
symbolic chart. A sampled match is evidence on the chart, not a general \
analytic identity.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"TimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"30"}]], "InlineFormula"]}],
        "TableText"], Cell["Maximum elapsed time allowed by the operation or \
stage. Where Automatic is supported it selects a finite workload-dependent \
budget; explicit seconds or supported Infinity override it. A timeout is \
reported, never treated as a successful amplitude.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"UncutChannels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell["Other known physical channels that must remain \
generic while the selected cut is imposed. The chart validator rejects \
unintended extra cuts or incompatible external data.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"StructuralCoefficient\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell["Whether PhysicalPoleResidue also computes its \
opaque-propagator coefficient. True includes that optional formal result; \
False saves the work and stores Missing[\"NotRequested\"] without skipping \
physical chart validation.", "TableText"]}}, GridBoxAlignment ->
      {"Columns" -> {Left, Left, Left}}, GridBoxItemSize ->
      {"Columns" -> {Scaled[0.23], Scaled[0.19], Scaled[0.58]}},
     GridBoxDividers -> {"Rows" -> {False, True, {False}, False}}]],
   "3ColumnTableMod"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Extract a formal coefficient using a real diagram's cut record.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "process", " ", "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "\"A.+\"", "}", ";", "\n", "diagrams", " ", "=",
      " ", "CreateDiagrams", "[", "process", ",", " ", "qedModel", "]", ";",
      "\n", "record", " ", "=", " ", "First", "[", "DiagramAmplitudeRecords",
      "[", "diagrams", "]", "]", ";", "\n", "channel", " ", "=", " ",
      "First", "[", "record", "[", "\"PhysicalPropagators\"", "]", "]", ";",
      "\n", "denominator", " ", "=", " ", "channel", "[", "\"Propagator\"",
      "]", ";", "\n", "residue", " ", "=", " ", "PhysicalPoleResidue", "[",
      "3", "/", "denominator", " ", "+", " ", "7", ",", " ", "channel", "]",
      ";", "\n", "{", "residue", "[", "\"Status\"", "]", ",", " ", "residue",
      "[", "\"StructuralCoefficient\"", "]", "}"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "\"FORMAL\"", ",", " ", "3", "}"}]], "Output"],
  Cell["The same formal extraction does not claim physical cut validation.",
   "ExampleText"],
  Cell[BoxData[RowBox[{"residue", "[", "\"PhysicalResidue\"", "]"}]],
   "Input"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["DiagramAmplitudeRecords", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudeRecords"],
     "  \[Bullet]  ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
