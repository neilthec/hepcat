  Cell["Read the dependent parameter expressions in a model function table.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReadFunctions", "[", "file", "]"}]],
      "InlineFormula"], "  ", "Return the rows of a funcN.mdl table."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["Rows retain a model-local \
parameter, its defining expression and any comment. Reading a dependent \
parameter is distinct from numerically resolving it.", "Notes"],
  Cell["Supported arithmetic is parsed as inert model data. An external \
function is retained as ModelFunction rather than called in the Wolfram \
session.", "Notes"], Cell["Use ModelParameterRules[model] to obtain the \
numerically resolved subset. A cyclic dependency or unsupported external \
function does not prevent unrelated resolvable parameters from being used.",
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Inspect the QED dependent definitions.", "ExampleText"],
  Cell[BoxData[RowBox[{"functions", " ", "=", " ", "ReadFunctions", "[",
      "FileNameJoin", "[", "{", "modelDirectory", ",", " ", "\"func2.mdl\"",
      "}", "]", "]", ";", "\n", "functions"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "}"}]], "Output"],
  Cell["Resolve the complete model locally.", "ExampleText"],
