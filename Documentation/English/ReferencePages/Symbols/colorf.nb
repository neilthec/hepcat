     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["colorf", "ObjectName"],
  Cell["Represents a structure-constant object in the legacy color trace \
convention.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"colorf", "[", "args", "]"}]],
      "InlineFormula"], "  ", "forms the symbolic color object."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["These older color heads are \
interpreted by ReduceColor with its SU(3) trace conventions. The modern \
Feynman representation uses ColorGenerator, ColorStructure and ColorDelta \
instead.", "Notes"], Cell["Do not interchange the legacy and Feynman heads \
without verifying their normalization and factors of I.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Apply a supported trace reduction.", "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceColor", "[", "colorf", "[", "a", ",", " ", "b",
      ",", " ", "c", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"2", "*", "colorTrace", "[", "colorT", "[", "a", "]",
      ",", " ", "colorT", "[", "b", "]", ",", " ", "colorT", "[", "c", "]",
      "]", " ", "-", " ", "2", "*", "colorTrace", "[", "colorT", "[", "a",
      "]", ",", " ", "colorT", "[", "c", "]", ",", " ", "colorT", "[", "b",
      "]", "]"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"], "  \[Bullet]  ",
     ButtonBox["ColorGenerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorGenerator"], "  \[Bullet]  ",
     ButtonBox["ColorStructure", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ColorStructure"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
