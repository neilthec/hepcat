Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SpinorHat", "ObjectName"],
  Cell[TextData[
    {"Represents a spinor whose momentum has been complex-deformed."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorHat", "[", "kind", ",", " ",
         "type", ",", " ", "i", "]"}]], "InlineFormula"], "  ",
     "marks a helicity, massive or reference spinor as shifted."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorHat", "[", "\"Spin\"", ",", " ",
         "variance", ",", " ", "type", ",", " ", "i", ",", " ", "index",
         "]"}]], "InlineFormula"], "  ", "retains an explicit massive \
little-group index on a shifted spinor."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"SpinorHat has the endpoint forms of ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], ", with an additional meaning that the \
external state belongs to a complex deformation. Construct a consistent \
shifted expression before expanding its particular deformation formulas."}],
   "Notes"], Cell[TextData[{"The argument conventions mirror ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], ". Supported hatted identities and \
complex-shift substitutions preserve chirality and explicit index placement."}\
], "Notes"],
  Cell[TextData[{"A hat alone does not specify the shift parameter or an \
on-shell solution. ", ButtonBox["UnhatMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/UnhatMomenta"], " removes the marker \
without proving that a shifted expression equals the original."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Mark the spinors in a chain as shifted."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", OverscriptBox["1", "^"]},
         "RowDefault"], TemplateBox[{OverscriptBox["2", "^"],
          "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
      ShowStringCharacters -> False], SpinorChain[SpinorHat["Helicity",
       "Angle", 1], SpinorHat["Helicity", "Angle", 2]], Editable -> False]],
   "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Spinor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Spinor"], "  \[Bullet]  ",
     ButtonBox["ComplexifyMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ComplexifyMomenta"], "  \[Bullet]  ",
     ButtonBox["UnhatMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/UnhatMomenta"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SpinorHat - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/SpinorHat", "title" -> "SpinorHat",
