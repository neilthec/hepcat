   "AnchorBarGrid"], Cell["SpinorHat", "ObjectName"],
  Cell["Represents a spinor whose momentum has been complex-deformed.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorHat", "[", "kind", ",", " ",
         "type", ",", " ", "i", "]"}]], "InlineFormula"], "  ",
     "marks a helicity, massive or reference spinor as shifted."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinorHat", "[", "\"Spin\"", ",", " ",
         "variance", ",", " ", "type", ",", " ", "i", ",", " ", "index",
         "]"}]], "InlineFormula"], "  ", "retains an explicit massive \
little-group index on a shifted spinor."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The argument conventions mirror \
Spinor. Supported hatted identities and complex-shift substitutions preserve \
chirality and explicit index placement.", "Notes"],
  Cell["A hat alone does not specify the shift parameter or an on-shell \
solution. UnhatMomenta removes the marker without proving that a shifted \
expression equals the original.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Mark the spinors in a chain as shifted.", "ExampleText"],
  Cell[BoxData[RowBox[{"ComplexifyMomenta", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
