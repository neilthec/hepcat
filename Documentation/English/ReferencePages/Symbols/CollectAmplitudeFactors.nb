Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["CollectAmplitudeFactors", "ObjectName"],
  Cell[TextData[{"Collect repeating scalar factors in a spinor amplitude \
while preserving the order of each spinor chain."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CollectAmplitudeFactors", "[", "expr",
         "]"}]], "InlineFormula"], "  ",
     "groups terms that share a scalar factor."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CollectAmplitudeFactors", "[", "expr",
         ",", " ", "seconds", "]"}]], "InlineFormula"], "  ", "sets a time \
budget for searching for an improvement. The default is two seconds."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"A sum of independently constructed currents often repeats \
the same spinor bracket or propagator in several terms. \
CollectAmplitudeFactors looks for those repeated factors inside sums and \
products. It uses only ordinary scalar algebra and requires no mass list or \
internal on-shell conditions."}], "Notes"],
  Cell[TextData[
    {"The function keeps a candidate when it reduces LeafCount and its ",
     ButtonBox["SpinorExpressionComplexity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorExpressionComplexity"], " is no \
larger. If the search finds no improvement within the budget, it returns the \
original expression. Ordered spinor chains and reciprocal factors are treated \
as units. Expressions containing noncommutative color tensors are left \
intact."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Collect two terms that contain the same bracket. The common \
bracket then occurs once."}], "ExampleText"],
  Cell[BoxData[RowBox[{"bracket", " ", "=", " ", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", ";", "\n", "CollectAmplitudeFactors", "[",
      "x", " ", "bracket", " ", "+", " ", "y", " ", "bracket", "]"}]],
   "Input"], Cell[TextData[{"Check the exact scalar identity independently by \
expanding the difference."}], "ExampleText"],
  Cell[BoxData[RowBox[{"expr", " ", "=", " ", "a", " ", "b", " ", "+", " ",
      "a", " ", "c", ";", "\n", "Expand", "[", "expr", " ", "-", " ",
      "CollectAmplitudeFactors", "[", "expr", "]", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SpinorExpressionComplexity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorExpressionComplexity"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
  "CollectAmplitudeFactors - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/CollectAmplitudeFactors",
     "title" -> "CollectAmplitudeFactors", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" -> "Collect repeating scalar factors in a spinor amplitude \
while preserving the order of each spinor chain.",
     "keywords" -> {"HEPCAT", "CollectAmplitudeFactors",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]