Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Phi", "ObjectName"],
  Cell[TextData[
    {"Labels the azimuthal angle used for an explicit momentum or spinor."}],
   "Notes"], Cell[TextData[{Cell[BoxData[RowBox[{"Phi", "[", "i", "]"}]],
      "InlineFormula"], "  ",
     "denotes the azimuthal angle in the x-y plane of external particle i."}]\
, "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Phi[i] denotes the azimuthal angle in the x-y plane of \
external leg i in the explicit component basis used by ",
     ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"], "."}], "Notes"],
  Cell[TextData[{"The spatial momentum convention is p {Sin[theta] Cos[phi], \
Sin[theta] Sin[phi], Cos[theta]}. These labels keep the particle number \
visible until you substitute a numerical or symbolic configuration."}],
   "Notes"], Cell[TextData[{"For example, replace Phi[1] -> Pi/4 when \
evaluating a chosen configuration. Supply consistent energy, momentum \
magnitude, external mass and angles; assigning one coordinate does not \
generate or enforce momentum conservation."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Inspect the azimuthal-angle label for particle 1. Numerical \
substitutions use radians."}], "ExampleText"],
  Cell[BoxData[RowBox[{"InputForm", "[", "Phi", "[", "1", "]", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"InputForm", "[", "Phi", "[", "1", "]",
      "]"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Theta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Theta"], "  \[Bullet]  ",
     ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "Phi - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
