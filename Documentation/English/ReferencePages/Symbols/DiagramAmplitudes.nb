Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/DiagramsAndFactorization"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["DiagramAmplitudes", "ObjectName"],
  Cell[TextData[{"Obtain a symbolic amplitude expression and its mass \
replacements for each generated diagram."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiagramAmplitudes", "[", "diagrams",
         "]"}]], "InlineFormula"], "  ",
     "Return {{massRules, expression}, ...} for the generated diagrams."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Pass the complete list returned by ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], ". The result is ",
     Cell[BoxData[RowBox[{"{", "{", "massRules", ",", " ", "expression", "}",
         ",", " ", "...", "}"}]], "InlineFormula"], ", with one entry per \
diagram. This format keeps the expression next to the mass information needed \
when preparing it."}], "Notes"],
  Cell[TextData[{"Each mass list declares the external particle masses and, \
for a constructive diagram, its internal-line masses. Known mass replacements \
are applied to the expression and retained in the list. In particular, the \
declarations identify which internal numerator relations are available to ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "."}], "Notes"],
  Cell[TextData[{"Constructive diagrams combine the internal photon or gluon \
helicities and replace supported external x factors before returning. Use the \
plural function for the full process: some simplifications and pairings \
involve the diagram list rather than an isolated diagram."}], "Notes"],
  Cell[TextData[{"For Feynman diagrams, the result retains Dirac chains, \
Lorentz or color tensors and off-shell propagators. Their mass lists contain \
external masses only; no internal on-shell condition is declared. Use Feynman \
preparation or ", ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     " before comparing their spinor expressions."}], "Notes"],
  Cell[TextData[{"This is the diagram result before factorization and \
high-energy completion. For constructive work, simplify it diagram by diagram \
first and keep preparation details if you want the discarded remainders \
available to ", ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], ". Use ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"],
     " to assess a proposed complete sum."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[
    {"Get the two separately declared four-point diagram expressions."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "process", " ", "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "\"A.+\"", "}", ";", "\n", "diagrams", " ", "=",
      " ", "CreateDiagrams", "[", "process", ",", " ", "qedModel", "]", ";",
      "\n", "amplitudes", " ", "=", " ", "DiagramAmplitudes", "[",
      "diagrams", "]", ";", "\n", "Length", "[", "amplitudes", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"2"}]], "Output"],
  Cell[TextData[{"Prepare them with a physical-pole preference."}],
   "ExampleText"], Cell[BoxData[RowBox[{"prepared", " ", "=", " ",
      "PrepareAmplitudes", "[", "amplitudes", ",", " ", "qedModel", ",", " ",
      "\"PolePreference\"", " ", "->", " ", "\"AllPhysical\"", "]", ";",
      "\n", "prepared"}]], "Input"], Cell["This example writes files, starts \
a longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "  \[Bullet]  ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"],
     "  \[Bullet]  ", ButtonBox["DiagramAmplitudeRecords",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/DiagramAmplitudeRecords"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Diagrams and Factorization Channels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/DiagramsAndFactorization"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "DiagramAmplitudes - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/DiagramAmplitudes", "title" -> "DiagramAmplitudes",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" -> "Obtain a symbolic amplitude expression \
and its mass replacements for each generated diagram.",
     "keywords" -> {"HEPCAT", "DiagramAmplitudes", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]