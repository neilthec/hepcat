Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["DiracGamma", "ObjectName"],
  Cell[TextData[{"Represents a gamma matrix with a Lorentz index in an \
ordered fermion-line numerator."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracGamma", "[", "index", "]"}]],
      "InlineFormula"], "  ",
     "represents a Dirac gamma matrix carrying a Lorentz index."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracGamma", "[", "mu", "]"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "denotes", " ", "the", " ",
         "matrix", " ", "carrying", " ", "the", " ", "Lorentz", " ", "index",
         " "}]], "InlineFormula"], Cell[BoxData[RowBox[{"mu"}]],
      "InlineFormula"], ". Place it in a ", ButtonBox["DiracWord",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/DiracWord"],
     " to specify where it acts along a fermion line."}], "Notes"],
  Cell[TextData[{"The index is a contraction label, not a numerical matrix \
component. For example, a current containing ",
     Cell[BoxData[RowBox[{"DiracGamma", "[", "mu", "]"}]], "InlineFormula"],
     " can contract with another current or with ",
     ButtonBox["LorentzMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMomentum"],
     ". The same index must occur twice in each term passed to ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], "."}],
   "Notes"], Cell[TextData[{"Changing the order of gamma matrices changes the \
numerator. An interchange requires the Clifford identity; it cannot be \
performed by sorting the arguments of a word."}], "Notes"],
  Cell[TextData[{"For a momentum-contracted gamma matrix, ",
     ButtonBox["DiracSlash", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracSlash"], " is often the clearer \
representation. Conversion uses HEPCAT's Weyl and external-state conventions, \
so relative signs follow the same conventions as the resulting ",
     ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], " expressions."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Write two gamma matrices with their order explicit. The \
Lorentz labels can later be contracted with the rest of a diagram."}],
   "ExampleText"], Cell[BoxData[RowBox[{"DiracWord", "[", "DiracGamma", "[",
      "mu", "]", ",", " ", "DiracGamma", "[", "nu", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracWord", "[", "DiracGamma", "[", "mu", "]", ",",
      " ", "DiracGamma", "[", "nu", "]", "]"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["DiracWord", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracWord"], "  \[Bullet]  ",
     ButtonBox["DiracSlash", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracSlash"], "  \[Bullet]  ",
     ButtonBox["LorentzMetric", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMetric"], "  \[Bullet]  ",
     ButtonBox["DiracChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracChain"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
