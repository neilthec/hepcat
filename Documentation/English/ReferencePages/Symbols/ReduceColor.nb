  Cell[TextData[{Cell[BoxData[RowBox[{"ReduceColor", "[", "expr", "]"}]],
      "InlineFormula"], "  ", "applies supported fundamental-color trace and \
completeness identities."}], "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this on the older symbolic generator and \
structure-constant expressions produced by HEPCAT's color algebra. The \
implementation contains the fundamental-generator trace and completeness \
identities of its SU(3) convention."}], "Notes"],
  Cell[TextData[{"The result is still an amplitude-level color expression. It \
is not a sum over all external colors, an average over incoming colors, or a \
replacement for the phase-space symmetry factors of identical particles."}],
   "Notes"], Cell[TextData[{"The tensor objects used by a CalcHEP ",
     ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"], " have a separate \
typed representation. Do not assume that this legacy reducer implements every \
identity for those tensors or for another gauge group."}], "Notes"],
