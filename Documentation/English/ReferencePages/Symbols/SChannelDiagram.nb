Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/DiagramsAndFactorization"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["SChannelDiagram", "ObjectName"],
  Cell["Evaluate a selected four-point s-channel exchange with the historical \
constructive helper.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SChannelDiagram", "[", "p1", ",", " ",
         "p2", ",", " ", "p3", ",", " ", "p4", ",", " ", "internalParticle",
         ",", " ", "model", "]"}]], "InlineFormula"], "  ",
     "Call ConstructiveDiagram for channel {1, 2}."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The six arguments specify four \
all-ingoing external particle names, one internal species and the complete \
model list. This is a fixed four-point convenience function, not general \
factorization.", "Notes"], Cell["The selected pairing is {1, 2}; its \
complement is the other side of the exchange. The model must contain the \
internal particle and both needed vertices.", "Notes"],
  Cell["For new calculations use CreateDiagrams and diagramAmplitudes. They \
retain mass declarations and handle generic internal massless-vector \
helicities rather than asking the user to select a single internal helicity."\
, "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"], Cell["Evaluate a selected \
massive-vector exchange in the bundled constructive SM model.",
   "ExampleText"], Cell[BoxData[RowBox[{"smModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "1", "]", ";", "\n",
      "SChannelDiagram", "[", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"M\"",
      ",", " ", "\"m\"", ",", " ", "\"Z\"", ",", " ", "smModel", "]"}]],
   "Input"], Cell["This example writes files, starts a longer calculation, or \
requires an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"],
  Cell["Generate the complete process with the general interface.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "process", " ", "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ",
      "\"A.+\"", ",", " ", "\"A.+\"", "}", ";", "\n", "diagrams", " ", "=",
      " ", "CreateDiagrams", "[", "process", ",", " ", "qedModel", "]", ";",
      "\n", "CreateArrowDiagrams", "[", "diagrams", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ConstructiveDiagram", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructiveDiagram"],
     "  \[Bullet]  ", ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], "  \[Bullet]  ",
     ButtonBox["diagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/diagramAmplitudes"], "  \[Bullet]  ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"]}],
   "SeeAlso"], Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Diagrams and Factorization Channels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/DiagramsAndFactorization"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "SChannelDiagram - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
