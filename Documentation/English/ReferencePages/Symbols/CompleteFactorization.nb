Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/AmplitudeConstruction"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["CompleteFactorization", "ObjectName"],
  Cell[TextData[{"Add corrections that make a candidate amplitude reproduce \
all supplied physical factorization channels together."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CompleteFactorization", "[",
         "amplitudes", ",", " ", "channels", ",", " ", "model", "]"}]],
      "InlineFormula"], "  ",
     "Fit corrections against all known physical channels simultaneously."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CompleteFactorization", "[",
         "preparationReport", ",", " ", "channelsOrReport", ",", " ",
         "model", "]"}]], "InlineFormula"], "  ", "Start from prepared inputs \
while retaining discarded expressions and original residue targets."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"CompleteFactorization", "[", "input",
         ",", " ", "channels", ",", " ", "model", ",", " ",
         "\"ReturnDetails\"", " ", "->", " ", "True", "]"}]],
      "InlineFormula"], "  ", "Keep the candidate, affine freedom, correction \
directions and validation diagnostics."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Start with diagram expressions or their detailed ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"],
     " report, the channels from ", ButtonBox[
      "FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ", \
and the factorization model. The function compares the candidate's residue \
with the expected lower-point product at every physical pole and solves for \
correction coefficients simultaneously."}], "Notes"],
  Cell[TextData[{"With ", Cell[BoxData[RowBox[{"\"PolePreference\"", " ",
         "->", " ", "\"AllPhysical\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{",", " ", "the", " ", "pole", " ", "check", " ",
         "treats", " ", "finite", " ", "numerical", " ", "factors", " ",
         "such", " ", "as", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"1", "/", "Sqrt", "[", "2", "]"}]],
      "InlineFormula"], " as scalar coefficients. Kinematic denominator \
factors must still be integer powers of propagators supplied by the physical \
channels."}], "Notes"], Cell[TextData[{"A successful ordinary result is ",
     Cell[BoxData[RowBox[{"{", "externalMassRules", ",", " ", "expression",
         "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "It", " ", "contains", " ", "no", " ",
         "internal", "-", "shell", " ", "declarations", " ", "for", " ",
         "the", " ", "complete", " ", "amplitude", " ", "and", " ", "can",
         " ", "be", " ", "passed", " ", "directly", " ", "to", " ",
         "preparation", ",", " ", "[", "CompleteHighEnergy", "]", "(",
         "paclet", ":", "HEPCAT", "/", "ref", "/", "CompleteHighEnergy", ")",
         " ", "or", " ", "[", "CheckAmplitudes", "]", "(", "paclet", ":",
         "HEPCAT", "/", "ref", "/", "CheckAmplitudes", ")", ".", " ", "Use",
         " "}]], "InlineFormula"], ButtonBox["CompleteHighEnergy",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/CompleteHighEnergy"], " or ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], ". Use ",
     Cell[BoxData[RowBox[{"\"Output\"", " ", "->", " ", "\"Expression\""}]],
      "InlineFormula"], " if you specifically want the bare expression."}],
   "Notes"], Cell[TextData[{"For a large massive-spin tensor, a short \
displayed starting expression can still lead to many coupled correction \
directions. The automatic factorization allowance therefore measures the \
original channel targets, prepared channel expressions and retained shell or \
reference source slots before starting the core deadline. Its work estimate \
also counts the model-consistent parameter assignments that the existing \
fitter will use. It does not expand the sources or inspect unrelated \
derivation histories. This estimate changes no correction cap, fit sample \
count or held-out sample count; explicit stage limits and the overall \
construction deadline remain authoritative."}], "Notes"],
  Cell["Why the channels are solved together", "NotesSection"],
  Cell[TextData[{"A factorization channel determines an amplitude on one \
pole. Extending its expression away from that pole is not unique, and \
different channels can share double or higher simultaneous poles. Simply \
adding a correction for each failed channel can double count a shared \
contribution or spoil a channel that already passed."}], "Notes"],
  Cell[TextData[{"Completion therefore constructs a finite set of correction \
directions from the supplied information and determines their coefficients \
using all channel conditions at once. Diagram reweightings, terms retained \
during preparation and alternative reference choices can supply useful \
directions. The original lower-point channel products remain the targets \
throughout."}], "Notes"], Cell[TextData[{"If the initial physical-pole space \
is proved inconsistent, Automatic can try a bounded enlargement derived by \
ordinary external momentum conservation in its numerator sources. Exact \
rewrite records and a reconstruction of every original direction certify any \
dependency removed from that enlarged space. Regular remainders stay \
correlated with their source. This adds no independent contact interaction \
and does not replace the original channel targets."}], "Notes"],
  Cell[TextData[{"Individual correction directions can have higher poles that \
cancel only in their fitted sum. When an exact rational Laurent expansion is \
available, completion constrains all higher principal-part coefficients to \
vanish and fits the finite simple-pole residue at the same time. This retains \
useful correlated directions without accepting a higher-pole final amplitude \
or a singular expected target."}], "Notes"],
  Cell[TextData[{"The function does not search every imaginable expression \
and does not invent an unknown interaction. If a required lower-point \
amplitude is absent from the model, or the available correction directions \
cannot express a needed contribution, longer fitting alone is not a guarantee \
of success."}], "Notes"], Cell[TextData[{"For a small coherent-spin tensor, \
physical-pole completion first tries a compact correction space from the \
already reduced channel sources, including ordinary two-particle cuts. This \
avoids introducing a large collection of redundant coordinates before it is \
needed. A proposal still has to fit every original channel and pass \
independent validation; larger tensor systems retain their correlated source \
route."}], "Notes"], Cell["Retaining information for the following stages",
   "NotesSection"], Cell[TextData[{"Detailed preparation reports are \
preferred when simplifying aggressively. They keep the original diagram \
expressions and the pieces discarded by diagram-local numerator-shell \
reductions. Completion tries useful retained pieces before constructing \
broader alternatives, rather than having to rediscover that information from \
a reduced sum."}], "Notes"],
  Cell[TextData[{"Residue agreement can leave combinations of corrections \
undetermined because they vanish on all tested physical poles. Request ",
     Cell[BoxData[RowBox[{"\"ReturnDetails\"", " ", "->", " ", "True"}]],
      "InlineFormula"], " if the result will go to ",
     ButtonBox["CompleteHighEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteHighEnergy"], ". That report \
retains the whole remaining family, not just one chosen expression."}],
   "Notes"], Cell[TextData[{Cell[BoxData[RowBox[{"\"PolePreference\""}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "biases", " ", "the", " ",
         "representation", " ", "searched", " ", "for", ":", " ", "for", " ",
         "example", ",", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"AllPhysical\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "favors", " ", "forms", " ", "with", " ",
         "physical", " ", "denominator", " ", "poles", ".", " ", "It", " ",
         "never", " ", "permits", " ", "a", " ", "failed", " ", "channel",
         " ", "to", " ", "be", " ", "ignored", ".", " ", "Identical", "-",
         "particle", " ", "exchange", " ", "symmetry", " ", "is", " ",
         "inferred", " ", "from", " ", "the", " ", "supplied", " ",
         "particle", " ", "identities", " ", "and", " ", "model", " ",
         "spins", " ", "when", " ", "that", " ", "information", " ", "is",
         " ", "available", ";", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"ExternalParticles\""}]], "InlineFormula"],
     " can provide the process for a bare expression."}], "Notes"],
  Cell["Validation, limits and failure reports", "NotesSection"],
  Cell[TextData[{"Coefficients are fitted using coherent kinematic samples \
and then checked on independent samples. A failed validation point can be \
added to the equations before another fit. Model numerical values are used \
for fitting and checking; the returned amplitude retains its symbolic \
parameters."}], "Notes"],
  Cell[TextData[{"Resource settings are automatic by default. ",
     Cell[BoxData[RowBox[{"\"TimeConstraint\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"MaxCorrectionTerms\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "can", " ", "impose", " ", "explicit", " ",
         "limits", ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"RandomSeed\""}]], "InlineFormula"], " records or \
repeats the sampling. More time allows more work within the available \
correction space, not an unrestricted search for a unique answer."}],
   "Notes"], Cell[TextData[{"An unfinished result normally returns ",
     Cell[BoxData[RowBox[{"Failure", "[", "\"IncompleteAmplitude\"", ",",
         " ", "...", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "instead", " ", "of", " ", "presenting", " ",
         "an", " ", "unchecked", " ", "candidate", " ", "as", " ", "an", " ",
         "amplitude", ".", " ", "To", " ", "investigate", ",", " ",
         "request", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"ReturnDetails\"", " ", "->", " ", "True"}]],
      "InlineFormula"], " and examine the candidate, validation, attempted \
correction space and remaining free parameters. A successful factorization \
fit still needs the high-energy, spurious-pole and any independent checks \
appropriate to the theory; sampled residue agreement alone is not a \
uniqueness proof."}], "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CorrectionBasis\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Explicit correction expressions whose coefficients may \
be fitted. Automatic uses bounded directions from the supplied diagrams, \
channels and retained preparation data; it does not invent an unrestricted \
interaction ansatz."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ParameterRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Local numerical parameter overrides keyed by model \
references or string names. Automatic resolves the model's variables and \
dependent functions; fitting and checks do not assign global values or \
replace parameters in the symbolic final amplitude."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Samples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Number of physical cut samples or fitting samples, \
depending on the stage. Automatic completion settings choose a bounded \
process-dependent count; successful fitting is followed by separate \
validation samples."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ValidationSamples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Number of held-out samples used after fitting \
correction coefficients. Automatic chooses a bounded workload-dependent \
allowance; these samples are distinct from the fitting equations."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ValidationParameterRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Additional or automatically selected local parameter \
assignments used in independent completion validation. They help detect fits \
tied accidentally to one numerical mass or coupling point without changing \
the symbolic result."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ChannelReferences\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Reference-spinor continuations available to \
factorization completion. Automatic tries a bounded set and verifies each on \
its selected cut; None restricts the fit to the literal correction space."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"AlternativeChannels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Additional compact channel rows to try \
as correction sources if the first completion space does not close. Their \
selected residues must agree with the original targets; they never replace \
those targets."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"BoseSymmetryGroups\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Groups of identical external bosons to symmetrize. \
Automatic infers species and helicity from ordered process metadata and the \
model; {} disables boson exchange projection without disabling fermion \
projection."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FermionSymmetryGroups\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Groups of identical external fermions to \
antisymmetrize with permutation parity signs. Automatic uses ordered process \
metadata and model spin/species declarations; {} disables only fermion \
exchange projection."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ExternalParticles\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Ordered external particle names when compact amplitude \
pairs no longer retain the process. Automatic uses recorded metadata or only \
unambiguous model matches; equal masses alone never establish identical \
species."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"InputReweighting\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether factorization completion first fits a scale on \
the pole-bearing input and a small overlap-reduced candidate. Automatic \
proposes these bounded corrections and validates them; None skips them. It is \
not a rule for averaging diagrams."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RepresentativeSelection\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether completion chooses a simpler particular point \
inside an already validated affine family. Automatic performs bounded exact \
coefficient cancellations while preserving its directions and explicit \
regular input; None retains the original particular point."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"PolePreference\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Reference and representation preference shared by \
preparation and completion. ConstructAmplitude defaults to \"AllPhysical\"; \
choose \"AllSpurious\" or \"Mixed\" explicitly for a different preference. \
The individual preparation/completion functions retain their own Automatic \
comparison or inheritance rules. Cyclic/common/independent reference choices \
and None are also available. Required checks remain unchanged."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ChannelCompanions\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether completion first tries a small set of \
source-derived physical-pole correction directions for eligible two-leg \
channels. Automatic gives this attempt a bounded share of the existing clock; \
None skips it. Every original channel must still validate."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"PreparationRemainders\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether factorization completion first tries grouped \
discarded preparation terms. Automatic uses only retained provenance and a \
bounded share of the clock; None skips this route. The original channel \
targets remain authoritative."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[
             {"\"ShiftedChannelContinuations\""}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether completion tries bounded two-null-leg \
continuation proposals as correction directions. Automatic restricts the \
attempt to its supported eligibility; False or None disables it. Each \
direction is checked on its own cut and no vanishing large-shift boundary is \
assumed."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxRefinements\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"3"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Maximum rounds that feed failed \
independent validation samples back into the simultaneous factorization \
equations. Each refinement is followed by fresh held-out validation."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RandomSeed\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Random-sampling seed. Automatic resolves one \
time-based seed for the operation; an explicit integer, including zero, \
reproduces the sample choices. Detailed reports retain the resolved seed. \
ComplicateAmplitude uses the legacy symbol key RandomSeed; modern \
construction/checking functions use the string key \"RandomSeed\"."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"TimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum elapsed time allowed by the operation or \
stage. Where Automatic is supported it selects a finite workload-dependent \
budget; explicit seconds or supported Infinity override it. A timeout is \
reported, never treated as a successful amplitude."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxCorrectionTerms\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Bound on the size of the fitted correction space. \
Automatic chooses a finite process-dependent limit; explicit values control \
effort without weakening residue and independent-validation requirements."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Parallelization\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Whether independent items or checks may use local \
Wolfram workers. Automatic uses suitable parallel work within available \
resources; False requests serial evaluation, and result order is retained."}]\
, "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaxKernels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum local Wolfram worker kernels available to \
parallel stages. Automatic respects processor availability and license \
limits; 1 requests serial execution. Worker setup and expression transfer can \
outweigh small jobs."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ProgressReporting\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether preparation and construction \
stages display their progress. False suppresses the live stage display \
without changing the algebra or validation."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ProgressFunction\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Optional callback receiving stage progress \
information. Automatic uses the normal progress display; callbacks are \
evaluated on the main kernel rather than independently by workers."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReturnDetails\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to expose optional diagnostic \
data instead of the compact default result. For preparation and factorization \
completion it retains provenance, directions and validation and takes \
precedence over Output; for export it returns file paths and build/run \
results."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Output\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"Amplitude\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Choose the amount and shape of returned information. \
Defaults are a compact check table, prepared input forms, a completed \
{externalMassRules, expression} pair, or a bare constructed expression; \
\"Details\" preserves diagnostics and provenance."}], "TableText"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Left, Left}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.23], Scaled[0.19],
         Scaled[0.58]}}, GridBoxDividers ->
      {"Rows" -> {False, True, {False}, False}}]], "3ColumnTableMod"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"], Cell[TextData[{"Prepare the two QED diagrams, solve \
their residue conditions together, and display the resulting amplitude. Keep \
the detailed result in factorized for the next stage."}], "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "process", " ", "=",
      " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ",
      "\"A.+\"", "}", ";", "\n", "diagrams", " ", "=", " ", "CreateDiagrams",
      "[", "process", ",", " ", "qedModel", "]", ";", "\n", "amplitudes",
      " ", "=", " ", "DiagramAmplitudes", "[", "diagrams", "]", ";", "\n",
      "channels", " ", "=", " ", "FactorizationAmplitudeChannels", "[",
      "process", ",", " ", "qedModel", "]", ";", "\n", "prepared", " ", "=",
      " ", "PrepareAmplitudes", "[", "amplitudes", ",", " ", "qedModel", ",",
      " ", "\"ReturnDetails\"", " ", "->", " ", "True", "]", ";", "\n",
      "factorized", " ", "=", " ", "CompleteFactorization", "[", "prepared",
      ",", " ", "channels", ",", " ", "qedModel", ",", " ",
      "\"ReturnDetails\"", " ", "->", " ", "True", "]", ";", "\n",
      "factorized", "[", "\"Amplitude\"", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"],
  Cell[TextData[
    {"A declared scalar contact amplitude requires no pole correction."}],
   "ExampleText"], Cell[BoxData[RowBox[{"scalarModel", " ", "=", " ", "{",
      "{", "{", "\"scalar\"", ",", " ", "\"s\"", ",", " ", "\"s\"", ",", " ",
      "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",",
      " ", "\"\"", ",", " ", "\"s\"", ",", " ", "\"s\"", "}", "}", ",", " ",
      "{", "{", "\"s\"", ",", " ", "\"s\"", ",", " ", "\"s\"", ",", " ",
      "\"s\"", ",", " ", "1", ",", " ", "7", "}", "}", ",", " ", "{", "}",
      ",", " ", "{", "}", "}", ";", "\n", "externalRules", " ", "=", " ",
      "Thread", "[", "(", "Mass", " ", "/@", " ", "Range", "[", "4", "]",
      ")", " ", "->", " ", "0", "]", ";", "\n", "CompleteFactorization", "[",
      "{", "externalRules", ",", " ", "7", "}", ",", " ", "{", "}", ",", " ",
      "scalarModel", ",", " ", "\"ExternalParticles\"", " ", "->", " ",
      "ConstantArray", "[", "\"s\"", ",", " ", "4", "]", ",", " ",
      "\"ProgressReporting\"", " ", "->", " ", "False", ",", " ",
      "\"RandomSeed\"", " ", "->", " ", "2026", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
