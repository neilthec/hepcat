     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["DiracSlash", "ObjectName"],
  Cell[TextData[{"Represents a four-momentum contracted with gamma matrices \
inside a Dirac word."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracSlash", "[", "Mom", "[", "label",
         "]", "]"}]], "InlineFormula"], "  ",
     "represents a momentum contracted with a Dirac gamma matrix."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracSlash", "[", "Mom", "[", "k",
         "]", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "denotes", " ", "the", " ", "slash", " ",
         "of", " ", "momentum", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"k"}]], "InlineFormula"], ". Its position in a ",
     ButtonBox["DiracWord", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracWord"],
     " matters just as the position of a gamma matrix does."}], "Notes"],
  Cell[TextData[{"The momentum can be a single ",
     ButtonBox["Mom", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mom"], " object, a sum of such objects, or a ",
     ButtonBox["Multiparticle", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Multiparticle"],
     " momentum. For example, ",
     Cell[BoxData[RowBox[{"DiracSlash", "[", "Mom", "[", "Multiparticle",
         "[", "1", ",", "3", "]", "]", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "records", " ", "the", " ", "numerator", " ",
         "momentum", " ", "of", " ", "an", " ", "internal", " ", "line", " ",
         "carrying", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"p1", "+", "p3"}]], "InlineFormula"], "."}],
   "Notes"], Cell[TextData[{"During ", ButtonBox["FeynmanToSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     ", the slash becomes a momentum insertion in the resulting ",
     ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], ". An internal momentum \
remains off shell, even if the associated propagator has a known mass."}],
   "Notes"], Cell[TextData[{"External Dirac identities can reduce an \
insertion when it acts next to the corresponding external spinor. This \
external reduction does not justify replacing the square of an internal slash \
by its propagator mass."}], "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Keep the internal momentum p1+p3 as one slash in the \
numerator. Its square is not assumed to equal an internal mass."}],
   "ExampleText"], Cell[BoxData[RowBox[{"DiracWord", "[", "DiracSlash", "[",
      "Mom", "[", "Multiparticle", "[", "1", ",", " ", "3", "]", "]", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracWord", "[", RowBox[{"DiracSlash", "[",
        SubscriptBox["p", RowBox[{"1", ",", "3"}]], "]"}], "]"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
