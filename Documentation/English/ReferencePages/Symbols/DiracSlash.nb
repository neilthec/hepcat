   "AnchorBarGrid"], Cell["DiracSlash", "ObjectName"],
  Cell["Represents a momentum contracted with a Dirac gamma matrix.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracSlash", "[", "Mom", "[", "label",
         "]", "]"}]], "InlineFormula"], "  ",
     "represents a momentum contracted with a Dirac gamma matrix."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["Use DiracSlash inside \
DiracWord, rather than multiplying it as an unordered matrix factor.",
   "Notes"], Cell["The momentum may be a composite or signed sum. Conversion \
retains internal momenta off shell.", "Notes"],
  Cell["Ordinary external Dirac identities may simplify a contracted \
bilinear, but no internal mass shell is inferred from a propagator.",
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Construct the symbolic object.", "ExampleText"],
  Cell[BoxData[RowBox[{"DiracWord", "[", "DiracSlash", "[", "Mom", "[",
