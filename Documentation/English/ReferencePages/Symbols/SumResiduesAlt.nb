   "AnchorBarGrid"], Cell["SumResiduesAlt", "ObjectName"],
  Cell["Sum the two finite-pole residues in a previously shifted channel \
representation.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SumResiduesAlt", "[", "channels",
         "]"}]], "InlineFormula"], "  ", "Cancel removable factors and \
evaluate the zPlus and zMinus poles of each shifted channel."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This low-level historical ALT helper \
expects channel rows whose final expressions already contain the correct \
shifted rational dependence on z and the cut-specific zPlus and zMinus \
roots.", "Notes"], Cell["It cancels the pole factor before substituting the \
corresponding root and returns minus the sum of both residues over all \
supplied rows. This ordering avoids evaluating an uncanceled 0/0.", "Notes"],
  Cell["The helper does not generate the shift, determine its validity at \
infinity or repair missing boundary data. It is distinct from \
PhysicalPoleResidue, which verifies physical cut kinematics.", "Notes"],
  Cell["For the current diagram-and-factorization workflow, use \
CompleteFactorization and CheckAmplitudes instead of interpreting an \
arbitrary sum of channel products as the final amplitude.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["An empty shifted-channel collection contributes no residues.",
   "ExampleText"], Cell[BoxData[RowBox[{"SumResiduesAlt", "[", "{", "}",
      "]"}]], "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell[
   "Inspect the root and shift symbols required by a shifted expression.",
   "ExampleText"], Cell[BoxData[RowBox[{"DownValues", "[", "SumResiduesAlt",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "HoldPattern", "[", "SumResiduesAlt", "[", "amp",
      "_", "]", "]", " ", ":>", " ", "Module", "[", "{", "newAmp", " ", "=",
      " ", "0", "}", ",", " ", "Do", "[", "newAmp", " ", "+=", " ", "Cancel",
      "[", "Together", "[", "(", "z", " ", "-", " ", "zPlus", "[", "amp",
      "[", "[", "j", ",", "-", "3", "]", "]", "]", ")", "*", "amp", "[", "[",
      "j", ",", "-", "1", "]", "]", "]", "]", " ", "/.", " ", "{", "z", " ",
      "->", " ", "zPlus", "[", "amp", "[", "[", "j", ",", "-", "3", "]", "]",
      "]", "}", ";", " ", "newAmp", " ", "+=", " ", "Cancel", "[",
      "Together", "[", "(", "z", " ", "-", " ", "zMinus", "[", "amp", "[",
      "[", "j", ",", "-", "3", "]", "]", "]", ")", "*", "amp", "[", "[", "j",
      ",", "-", "1", "]", "]", "]", "]", " ", "/.", " ", "{", "z", " ", "->",
