   "AnchorBarGrid"], Cell["SpinToHelicitySpinors", "ObjectName"],
  Cell[TextData[{"Applies legacy spin-to-helicity expansions to selected \
massive particle spinors."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinToHelicitySpinors", "[", "expr",
         ",", " ", "{", "particle", ",", " ", "spin", ",", " ", "helicity",
         "}", "]"}]], "InlineFormula"], "  ",
     "uses the supported fixed-spin helicity expansion."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SpinToHelicitySpinors", "[", "expr",
         ",", " ", "specification1", ",", " ", "specification2", ",", " ",
         "...", "]"}]], "InlineFormula"], "  ",
     "applies up to four specifications in sequence."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"This is an earlier high-energy expansion that expresses \
supported massive-spin states through helicity and auxiliary reference \
spinors. It is useful only within the expansion order and spin cases \
implemented by the routine."}], "Notes"],
  Cell[TextData[{"This older routine uses energy, momentum magnitude, masses \
and auxiliary Zeta spinors. The source describes it as implemented only to \
linear order, so do not treat it as a universal exact massive-to-massless \
replacement."}], "Notes"],
  Cell[TextData[{"Use ", ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"], " and ",
     ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"], " for explicit \
physical spin components without relying on this expansion."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Inspect the supported spin-one negative-helicity conversion."}],
