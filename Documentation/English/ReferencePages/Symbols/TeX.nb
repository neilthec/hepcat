Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["TeX", "ObjectName"],
  Cell[TextData[
    {"Converts supported HEPCAT spinor expressions to a LaTeX string."}],
   "Notes"], Cell[TextData[{Cell[BoxData[RowBox[{"TeX", "[", "expr", "]"}]],
      "InlineFormula"], "  ",
     "returns LaTeX source text for the supported expression."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when placing a symbolic result in a paper or a \
LaTeX derivation. The formatter writes supported brackets, momentum \
insertions, masses, propagators and scalar invariants in their mathematical \
notation."}], "Notes"], Cell[TextData[{"The output is source text, not a \
compiled document. Insert the string into an appropriate LaTeX math \
environment and check the resulting formula. Formatting does not simplify the \
amplitude or verify an identity."}], "Notes"],
  Cell[TextData[{"This older formatter covers a defined set of HEPCAT \
expression forms. Keep a copy of the typed expression for subsequent algebra, \
and use ", ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"], " with \"Model\" for \
model-file output rather than importing the LaTeX string as a model \
expression."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Write the LaTeX source for an angle bracket."}],
   "ExampleText"], Cell[BoxData[RowBox[{"TeX", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"\\\\langle12\\\\rangle\""}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FormattingAndExport"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "TeX - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
