        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ApplySpinorIdentity", "ObjectName"],
  Cell[TextData[
    {"Applies one validated identity step to a spinor expression."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ApplySpinorIdentity", "[", "{",
         "massRules", ",", " ", "expr", "}", ",", " ", "edit", ",", " ",
         "opts", "]"}]], "InlineFormula"], "  ", "validates and applies an \
edit returned by SpinorIdentityCandidates."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"First obtain a candidate from ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"], " for the \
current {massRules, expression} pair. Pass that association as the second \
argument, using the same \"OnShellChannels\" and \"MomentumConservation\" \
options."}], "Notes"], Cell[TextData[{"The result is the new expression, not \
a new pair. Retain the mass rules yourself when making the next state: \
{massRules, newExpression}. Keeping the rule list explicit makes it clear \
which diagram-local assumptions each step was allowed to use."}], "Notes"],
  Cell[TextData[{"The function checks the candidate against the current legal \
moves. A stale candidate from an earlier expression, an incompatible \
assumption set, or an invalid edit produces $Failed and a message rather than \
silently changing the formula."}], "Notes"],
  Cell[TextData[{"A legal move need not make the expression shorter. To \
explore a route, record Before, After, and the candidate association. ",
     ButtonBox["SpinorExpressionComplexity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorExpressionComplexity"], " can \
help compare forms, while a sequence of recorded identities provides the \
actual algebraic justification."}], "Notes"],
  Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"OnShellChannels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Internal cuts legal for an explicit identity edit or \
scramble. Automatic reads the current diagram pair's internal mass rules; use \
{} for a combined amplitude with no allowed internal-shell identities."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MomentumConservation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether identities may use the complete \
declared external momentum sum. The operation uses the known external-leg \
list rather than imposing unrelated internal cut conditions."}],
        "TableText"]}}, GridBoxAlignment ->
      {"Columns" -> {Left, Left, Left}}, GridBoxItemSize ->
      {"Columns" -> {Scaled[0.23], Scaled[0.19], Scaled[0.58]}},
     GridBoxDividers -> {"Rows" -> {False, True, {False}, False}}]],
   "3ColumnTableMod"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Select the available Schouten edit and apply it to the same \
starting expression. No internal-shell or momentum-conservation assumption is \
used."}], "ExampleText"],
  Cell[BoxData[RowBox[{"state", " ", "=", " ", "{", "{", "}", ",", "\n", " ",
      " ", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", "\n",
      " ", " ", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4", "]", "]", "}",
      ";", "\n", "edits", " ", "=", " ", "SpinorIdentityCandidates", "[",
      "state", ",", "\n", " ", " ", "\"OnShellChannels\"", " ", "->", " ",
      "{", "}", ",", " ", "\"MomentumConservation\"", " ", "->", " ",
      "False", "]", ";", "\n", "ApplySpinorIdentity", "[", "state", ",", " ",
      "First", "[", "edits", "]", ",", "\n", " ", " ", "\"OnShellChannels\"",
      " ", "->", " ", "{", "}", ",", " ", "\"MomentumConservation\"", " ",
      "->", " ", "False", "]"}]], "Input"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
