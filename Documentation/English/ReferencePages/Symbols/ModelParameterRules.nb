     ButtonBox["ModelParameterName", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterName"], "  \[Bullet]  ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"]}], "SeeAlso"],
