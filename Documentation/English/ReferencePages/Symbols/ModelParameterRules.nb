Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ModelParameterRules", "ObjectName"],
  Cell[TextData[{"Obtain numerical parameter substitutions while keeping \
model definitions local."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameterRules", "[", "model",
         "]"}]], "InlineFormula"], "  ",
     "Resolve model variables and supported dependent functions."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameterRules", "[", "model",
         ",", " ", "overrides", "]"}]], "InlineFormula"], "  ", "Apply local \
overrides keyed by ModelParameter references or string names."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Apply the resulting rules to a symbolic expression when you \
want numbers. The model itself and any global Mathematica names are left \
unchanged. Independent input parameters and the supported dependent \
definitions are resolved together."}], "Notes"],
  Cell[TextData[{"The optional second argument changes selected inputs for \
this calculation. It can use model-local ", ButtonBox["ModelParameter",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ModelParameter"],
     " references or string names, for example ",
     Cell[BoxData[RowBox[{"{", "\"Me\"", " ", "->", " ", "1", "}"}]],
      "InlineFormula"], ". Dependent definitions are then recomputed, so \
changing an input remains consistent with quantities derived from it."}],
   "Notes"], Cell[TextData[{"An explicit override of a dependent parameter \
treats that value as an independent input for this evaluation. This is useful \
for a numerical comparison, but you are responsible for whether that \
parameter choice describes the intended theory."}], "Notes"],
  Cell[TextData[{"A dependency cycle or an unsupported ",
     ButtonBox["ModelFunction", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelFunction"], " call cannot always \
be given a number. Such unresolved definitions are omitted while unrelated \
resolvable parameters are retained. Inspect the rules if a later numerical \
calculation reports a parameter without a value."}], "Notes"],
  Cell[TextData[{ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], ", ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], " and ",
     ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], " normally \
obtain numerical values from the model themselves. You do not need to repeat \
its defaults in every call."}], "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[{"Resolve the bundled QED numerical parameters."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";", "\n",
      "ModelParameterRules", "[", "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{InterpretationBox["EE", ModelParameter["EE",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["31333", "100000"]}],
        ",", RowBox[{InterpretationBox["Me", ModelParameter["Me",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["1", "2000"]}]}],
      "}"}]], "Output"],
  Cell[TextData[{"Replay a calculation at unit mass and charge locally."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";", "\n", "{",
      "ModelParameter", "[", "qedModel", ",", " ", "\"Me\"", "]", ",", " ",
      "ModelParameter", "[", "qedModel", ",", " ", "\"EE\"", "]", "}", " ",
      "/.", " ", "ModelParameterRules", "[", "qedModel", ",", " ", "{",
      "\"Me\"", " ", "->", " ", "1", ",", " ", "\"EE\"", " ", "->", " ", "1",
      "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "1", ",", " ", "1", "}"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ModelParameter", BaseStyle -> "Link",
