Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ModelParameterRules", "ObjectName"],
  Cell["Resolve model parameters numerically without changing the symbolic \
amplitude or global session.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameterRules", "[", "model",
         "]"}]], "InlineFormula"], "  ",
     "Resolve model variables and supported dependent functions."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameterRules", "[", "model",
         ",", " ", "overrides", "]"}]], "InlineFormula"], "  ", "Apply local \
overrides keyed by ModelParameter references or string names."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The default overrides are Automatic. \
Model variables and resolvable function dependencies are evaluated locally \
and returned as ordinary replacement rules.", "Notes"],
  Cell["A cyclic dependency, unknown external function or unresolved \
parameter is omitted rather than guessed. Unrelated parameters that can be \
resolved remain in the returned rules.", "Notes"],
  Cell["String overrides are convenient for user code, for example {\"Me\" -> \
1, \"EE\" -> 1}. Typed parameter keys are useful when working with several \
models at once.", "Notes"], Cell["These replacements are appropriate for \
checks, fitting and exported numerical defaults. They do not overwrite the \
symbolic model list or assign names such as EE globally.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Resolve the bundled QED numerical parameters.", "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "ModelParameterRules",
      "[", "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{InterpretationBox["EE", ModelParameter["EE",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["31333", "100000"]}],
        ",", RowBox[{InterpretationBox["Me", ModelParameter["Me",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["1", "2000"]}]}],
      "}"}]], "Output"],
  Cell["Replay a calculation at unit mass and charge locally.",
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n", "{",
      "ModelParameter", "[", "qedModel", ",", " ", "\"Me\"", "]", ",", " ",
      "ModelParameter", "[", "qedModel", ",", " ", "\"EE\"", "]", "}", " ",
      "/.", " ", "ModelParameterRules", "[", "qedModel", ",", " ", "{",
      "\"Me\"", " ", "->", " ", "1", ",", " ", "\"EE\"", " ", "->", " ", "1",
      "}", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "1", ",", " ", "1", "}"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], "  \[Bullet]  ",
     ButtonBox["ModelParameterName", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterName"], "  \[Bullet]  ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
