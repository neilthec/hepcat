Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Spinor", "ObjectName"],
  Cell[TextData[{"Represents an angle or square spinor belonging to an \
external particle or an auxiliary reference."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Spinor", "[", "\"Helicity\"", ",",
         " ", "type", ",", " ", "i", "]"}]], "InlineFormula"], "  ", "represe\
nts a massless external spinor of chirality \"Angle\" or \"Square\"."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Spinor", "[", "\"Spin\"", ",", " ",
         "type", ",", " ", "i", "]"}]], "InlineFormula"], "  ",
     "represents a massive spinor with its little-group index implicit."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Spinor", "[", "\"Spin\"", ",", " ",
         "variance", ",", " ", "type", ",", " ", "i", ",", " ", "index",
         "]"}]], "InlineFormula"], "  ",
     "makes the \"Upper\" or \"Lower\" little-group index explicit."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Spinor", "[", "\"Xi\"", ",", " ",
         "type", ",", " ", "i", "]"}]], "InlineFormula"], "  ", "represents \
an auxiliary reference spinor; its label need not be an external particle."}]\
, "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"A spinor is an endpoint of a ", ButtonBox["SpinorChain",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], ". \
Use the string \"Angle\" for a ket written |i> and \"Square\" for a ket \
written |i]. When that spinor is the first endpoint of a chain, HEPCAT \
displays the corresponding bra automatically. You do not need a separate \
symbol for a bra."}], "Notes"],
  Cell[TextData[{"The first argument tells HEPCAT what the spinor represents. \
\"Helicity\" denotes a massless particle. \"Spin\" denotes a massive particle \
with little-group spin indices. \"Xi\" denotes a reference spinor, such as \
one used to write a photon polarization."}], "Notes"],
  Cell[TextData[{"The integer particle label refers to the particle's \
position in your ordered process. Thus, leg 3 is the third particle in that \
list; it is not a particle name, a helicity, or a spin index."}], "Notes"],
  Cell[TextData[{"In Spinor[\"Spin\", \"Upper\", \"Angle\", 1, j], the label \
1 identifies the external particle and j identifies its little-group \
component. ", ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"],
     " inserts such indices into an expression. ",
     ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"],
     " instead selects a physical spin projection."}], "Notes"],
  Cell[TextData[{"An Xi label identifies a reference, not necessarily an \
external leg with that number. ", ButtonBox["PrepareAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PrepareAmplitudes"], " can choose and substitute \
reference spinors for a complete diagram or channel calculation."}],
   "Notes"], Cell["Momentum and crossing conventions", "NotesSection"],
  Cell[TextData[{"Analytic HEPCAT expressions use all external momenta \
incoming. To convert selected external momenta to the physical outgoing \
convention, apply ", ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"], " to the complete \
expression. Replacing particle labels alone does not supply the angle-spinor \
signs required by crossing."}], "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"], Cell["Massless brackets",
   "ExampleSubsection"], Cell[TextData[{"Form the angle bracket <12>."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2",
      "]", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
       "RowDefault"], TemplateBox[{"2", "\"\[RightAngleBracket]\""},
       "RowDefault"]}, "RowDefault"]], "Output"],
  Cell["Massive spin indices", "ExampleSubsection"],
  Cell[TextData[{"Display a massive spinor with an explicit upper index."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[",
      "\"Spin\"", ",", " ", "\"Upper\"", ",", " ", "\"Angle\"", ",", " ",
      "1", ",", " ", "j", "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",",
      " ", "\"Angle\"", ",", " ", "3", "]", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"",
        TemplateBox[{StyleBox["1", Bold, StripOnInput -> False], "j"},
         "Superscript", SyntaxForm -> SuperscriptBox]}, "RowDefault"],
      TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], "  \[Bullet]  ",
     ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"],
     "  \[Bullet]  ", ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"], "  \[Bullet]  ",
     ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "Spinor - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
