   "AnchorBarGrid"], Cell["ExtractEnergy1", "ObjectName"],
  Cell["Substitutes one particle's momentum matrices and explicit four-vector \
components.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractEnergy1", "[", "expr", ",",
         " ", "i", ",", " ", "energy", ",", " ", "momentumMagnitude", ",",
         " ", "theta", ",", " ", "phi", "]"}]], "InlineFormula"], "  ",
     "replaces supported momentum occurrences for particle i."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractEnergy1", "[", "expr", ",",
         " ", "i", ",", " ", "energy", ",", " ", "momentumMagnitude", ",",
         " ", "theta", ",", " ", "phi", ",", " ", "mass", "]"}]],
      "InlineFormula"], "  ", "also supplies the known external on-shell mass \
for stable numerical components."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This is the first stage of \
ExtractEnergy. Spinor endpoints remain symbolic until ExtractEnergy2 is \
applied.", "Notes"], Cell["The time-space metric is (+,-,-,-). Upper and \
lower four-vectors carry the corresponding spatial signs. Momentum-matrix \
placement follows the chain's current chirality.", "Notes"],
  Cell["For a finished numerical scalar, normally use ExtractEnergy rather \
than stopping after this intermediate stage.", "Notes"],
  Cell["The optional trailing mass is used only by the supported real \
positive-energy on-shell numerical route. Omitting it preserves the original \
formulas; negative-energy, complex and clearly off-shell inputs retain the \
original branch behavior.", "Notes"], Cell["When the mass is known, a small \
momentum-matrix diagonal is rationalized using the mass and transverse \
momentum rather than subtracting nearly equal energy and longitudinal \
momentum.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Expose the explicit momentum matrix in a chain.", "ExampleText"],
  Cell[BoxData[RowBox[{"ExtractEnergy1", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1", "]", ",",
      " ", "Mom", "[", "2", "]", ",", " ", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "3", "]", "]", ",", " ", "2", ",",
      " ", "energy", ",", " ", "momentum", ",", " ", "0", ",", " ", "0",
      "]"}]], "Input"],
  Cell[BoxData[TemplateBox[{TemplateBox[{"\"[\"", "1"}, "RowDefault"],
      "\"|\"", RowBox[{"{", RowBox[
         {RowBox[{"{", RowBox[{RowBox[{RowBox[{"nice", "[", "energy", "]"}],
                "-", RowBox[{"nice", "[", "momentum", "]"}]}], ",", "0"}],
            "}"}], ",", RowBox[{"{", RowBox[{"0", ",", RowBox[{
                RowBox[{"nice", "[", "energy", "]"}], "+", RowBox[
                 {"nice", "[", "momentum", "]"}]}]}], "}"}]}], "}"}],
      "\"|\"", TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"], "  \[Bullet]  ",
     ButtonBox["ExtractEnergy2", BaseStyle -> "Link",
