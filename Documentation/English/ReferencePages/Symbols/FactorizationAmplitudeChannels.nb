Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/DiagramsAndFactorization"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["FactorizationAmplitudeChannels", "ObjectName"],
  Cell[TextData[{"Build the known lower-point amplitude products that a full \
amplitude must reproduce at its physical poles."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FactorizationAmplitudeChannels", "[",
         "particles", ",", " ", "model", "]"}]], "InlineFormula"], "  ", "Ret\
urn the nonzero channel products for the specified all-ingoing process."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Give an ordered, all-ingoing process list and a \
constructive model containing the required lower-point amplitudes. A channel \
divides the external legs into two groups. When the momentum flowing between \
those groups goes on shell, the full amplitude must factor into the \
corresponding two lower-point amplitudes, with the internal states sewn \
together."}], "Notes"], Cell[TextData[{"The return value is a compact list, \
one row per nonzero channel. A row has the form ",
     Cell[BoxData[RowBox[{"{", "m1", ",", " ", "...", ",", " ", "mn", ",",
         " ", "Multiparticle", "[", "cut", "]", ",", " ", "exchangedMass",
         ",", " ", "expression", "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "The", " ", "first", " ", "entries", " ",
         "are", " ", "the", " ", "external", " ", "masses", " ", "in", " ",
         "process", " ", "order", ";", " ", "the", " ", "cut", " ", "lists",
         " ", "the", " ", "momenta", " ", "that", " ", "sum", " ", "to", " ",
         "the", " ", "internal", " ", "momentum", ".", " ", "The", " ",
         "final", " ", "entry", " ", "is", " ", "the", " ", "sewn", " ",
         "product", " ", "with", " ", "its", " ", "propagator", " ",
         "denominator", " ", "and", " ", "the", " ", "historical", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"1", "/", "z"}]],
      "InlineFormula"], " factor."}], "Notes"],
  Cell[TextData[{"You can inspect these rows directly, but you normally pass \
the list unchanged to ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], " or ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], ". Those \
functions interpret the channel information and sewing convention. Do not \
remove ", Cell[BoxData[RowBox[{"z"}]], "InlineFormula"], ", fit an overall \
sign or simply sum the channel expressions to make a candidate full \
amplitude."}], "Notes"], Cell[TextData[{"Colored channels sew the internal \
color indices as well as the internal spin state. The expression therefore \
retains the same explicit SU(3) tensors as ", ButtonBox["DiagramAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/DiagramAmplitudes"], ". This is important when \
photon, gluon and weak exchange contribute to the same reaction: their color \
tensors interfere differently. Missing or ambiguous color information is not \
replaced by an overall multiplicity."}], "Notes"],
  Cell["Supplying enough lower-point information", "NotesSection"],
  Cell[TextData[{"For four-point factorization, the lower amplitudes have \
three legs. At five points, a channel can involve a three-point and a \
complete four-point amplitude. At six points, complete four- and five-point \
amplitudes can be needed. The diagram model can still contain only the \
allowed vertices; the factorization model serves a different purpose."}],
   "Notes"], Cell[TextData[{"The bundled QED model ",
     Cell[BoxData[RowBox[{"2"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "supplies", " ", "three", "-", "point", " ",
         "vertices", ".", " ", "Model", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"3"}]], "InlineFormula"],
     " also stores known complete amplitudes for larger channels. Use ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"],
     " to load the model appropriate to the multiplicity you are checking."}]\
, "Notes"], Cell[TextData[{"An unlisted lower-point amplitude is treated as \
zero and does not produce a nonzero channel row. The user is responsible for \
supplying all known nonzero lower-point amplitudes. A CalcHEP ",
     ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"], " contains bare \
vertices, so it is not accepted as the factorization model."}], "Notes"],
  Cell["Preparation and interpretation", "NotesSection"],
  Cell[TextData[{"A sewn channel product is already valid before optional \
algebraic simplification. For large expressions, the final ordinary \
simplification attempt has a short finite budget. A timeout retains the \
complete original product, including every propagator and regular term, \
rather than delaying the whole channel inventory indefinitely. Small channel \
expressions keep the established simplification path. No internal on-shell \
assumption is added by this performance safeguard."}], "Notes"],
  Cell[TextData[{ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " can simplify \
channel rows without changing their compact format. Such a row declares only \
its selected internal cut; it does not put every other propagator in the \
product on shell. Request preparation details if you will pass those \
reductions to completion, so the original channel targets remain available."}]\
, "Notes"], Cell[TextData[{"Different channels overlap on multiple poles. \
Adding their products as independent diagrams would generally double count \
those overlaps. ", ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], " instead \
solves the channel conditions together, starting from the diagram expression \
and a bounded space of possible corrections."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"],
  Cell[TextData[{"Generate the electron-exchange channels for four-point \
QED."}], "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "2", "]", ";", "\n", "process", " ", "=",
      " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ",
      "\"A.+\"", "}", ";", "\n", "channels", " ", "=", " ",
      "FactorizationAmplitudeChannels", "[", "process", ",", " ", "qedModel",
      "]", ";", "\n", "Length", "[", "channels", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"2"}]], "Output"],
  Cell[TextData[{"Use higher-point model data for a five-point \
factorization."}], "ExampleText"],
  Cell[BoxData[RowBox[{"knownQEDModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "3", "]", ";", "\n", "fivePointChannels",
      " ", "=", " ", "FactorizationAmplitudeChannels", "[", "{", "\"e\"",
      ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ", "\"A.+\"", ",", " ",
      "\"A.+\"", "}", ",", " ", "knownQEDModel", "]", ";", "\n", "Length",
      "[", "fivePointChannels", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"6"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "  \[Bullet]  ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"],
     "  \[Bullet]  ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Diagrams and Factorization Channels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/DiagramsAndFactorization"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
