Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ReduceSpinorProducts", "ObjectName"],
  Cell[TextData[{"Simplifies spinor chains, traces and products using \
ordinary identities and external-particle on-shell conditions."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[", "expr",
         "]"}]], "InlineFormula"], "  ", "returns a reduced expression using \
bounded, directed algebraic passes."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use ReduceSpinorProducts when you already have a spinor \
expression and want routine algebraic simplification. It handles supported \
chain reversals, momentum-slot linearity, Clifford contractions, external \
Dirac equations, and product identities while comparing useful factored and \
expanded forms."}], "Notes"],
  Cell[TextData[{"The input and output are ordinary HEPCAT expressions. A \
repeated external momentum inside a chain can become an external mass \
squared; an external momentum next to its own massless endpoint can make the \
chain vanish. Model-specific mass values can be substituted with ordinary \
replacement rules."}], "Notes"],
  Cell[TextData[{"Ordinary Dirac and Schouten identities can simplify a sum \
even when a momentum chain has a trailing momentum word. The reducer also \
compares a contraction using both external endpoint equations, retaining its \
scalar-product term. Both angle and square chains, unequal masses and \
explicit massive spin indices use the same identities. These bounded passes \
do not assume that an internal line is on shell."}], "Notes"],
  Cell[TextData[{"The function does not need a model or a complete process, \
so it cannot infer total momentum conservation from a list of external legs. \
For diagram or factorization preparation with that information available, use \
", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "."}], "Notes"],
  Cell["Which on-shell conditions are used?", "NotesSection"],
  Cell[TextData[{"Only the external-particle identities belong to this \
process-independent reducer. It does not infer that a composite internal \
momentum has the propagating particle's mass. Those additional numerator \
assumptions are local to a diagram or selected factorization channel and are \
supplied separately by ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "."}], "Notes"],
  Cell[TextData[{"The reducer protects ", ButtonBox["PropDen",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/PropDen"], " \
arguments, so simplifying a numerator does not also put the corresponding \
denominator on shell. The same ordinary reduction can therefore be applied to \
a completed, combined amplitude."}], "Notes"],
  Cell["Choosing a form and following the calculation", "NotesSection"],
  Cell[TextData[{"There may be many equivalent forms with different numbers \
of terms and momentum insertions. The reducer uses finite, directed passes \
and bounded expansion. It aims to improve a practical complexity measure; it \
cannot promise the globally shortest possible formula."}], "Notes"],
  Cell[TextData[{"The additional sum contractions are directional: the \
complete candidate must have a lower complexity score, or the same score with \
fewer expression leaves. Inverse spinor factors and propagator denominators \
remain protected. Positive powers are handled using their literal \
multiplicity, so taking one factor out of a square does not remove both \
copies. A distribution budget skips a large sum before expanding it."}],
   "Notes"],
  Cell[TextData[
    {"If a useful identity is not chosen automatically, inspect ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     " and apply a selected edit with ", ButtonBox["ApplySpinorIdentity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ApplySpinorIdentity"], ". Keeping that edit and its \
before/after expressions gives a derivation you can inspect and replay. ",
     ButtonBox["SpinorExpressionComplexity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorExpressionComplexity"],
     " provides a consistent score for comparing intermediate forms."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"], Cell["Elementary reductions",
   "ExampleSubsection"],
  Cell[TextData[{"Remove a diagonal massless angle bracket."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", "]", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["Momentum insertions", "ExampleSubsection"],
  Cell[TextData[{"Contract adjacent copies of an external momentum."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Mom", "[", "3", "]", ",",
      " ", "Mom", "[", "3", "]", ",", " ", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{SubsuperscriptBox["M", "3", "2"], " ",
      TemplateBox[{TemplateBox[{"\"\[LeftAngleBracket]\"", "1"},
         "RowDefault"], TemplateBox[{"2", "\"\[RightAngleBracket]\""},
         "RowDefault"]}, "RowDefault"]}]], "Output"],
  Cell["Momentum sums", "ExampleSubsection"],
  Cell[TextData[{"Distribute a momentum sum in a chain."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Mom", "[", "2", "]", " ", "+", " ", "Mom", "[", "3",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Square\"",
      ",", " ", "4", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{TemplateBox[{TemplateBox[{"\"[\"", "4"},
         "RowDefault"], "\"|\"", SubscriptBox["p", "2"], "\"|\"",
        TemplateBox[{"1", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"], "+", TemplateBox[{TemplateBox[{"\"[\"", "4"},
         "RowDefault"], "\"|\"", SubscriptBox["p", "3"], "\"|\"",
        TemplateBox[{"1", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"]}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     "  \[Bullet]  ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "  \[Bullet]  ",
     ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"],
     "  \[Bullet]  ", ButtonBox["SpinorExpressionComplexity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorExpressionComplexity"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
  "ReduceSpinorProducts - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
