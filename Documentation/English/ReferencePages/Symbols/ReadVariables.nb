   "AnchorBarGrid"], Cell["ReadVariables", "ObjectName"],
  Cell[
   "Read a model variable table without assigning global parameter values.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReadVariables", "[", "file", "]"}]],
      "InlineFormula"], "  ",
     "Return the variable rows in a numbered varsN.mdl file."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["Each returned row contains \
{parameter, value, comment}, with parameter represented by \
ModelParameter[name, scope, \"Real\"]. The scope separates models that happen \
to use the same parameter name.", "Notes"], Cell["The table requires its \
final separator. Invalid arithmetic or malformed rows are rejected by the \
model expression parser.", "Notes"], Cell["ReadModel normally calls this \
reader for you. For numerical calculations, use ModelParameterRules on the \
complete model so dependent functions and overrides are resolved \
consistently.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Inspect one declared variable.", "ExampleText"],
  Cell[BoxData[RowBox[{"variables", " ", "=", " ", "ReadVariables", "[",
      "FileNameJoin", "[", "{", "modelDirectory", ",", " ", "\"vars2.mdl\"",
      "}", "]", "]", ";", "\n", "First", "[", "variables", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", RowBox[{InterpretationBox["EE",
         ModelParameter["EE",
          "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad",
          "Real"], Editable -> False], ",", FractionBox["31333", "100000"],
        ",", "\"Electromagnetic coupling constant (<->1/128)\""}], "}"}]],
   "Output"], Cell["List the declared names rather than assigning them.",
   "ExampleText"], Cell[BoxData[RowBox[{"ModelParameterName", " ", "/@", " ",
      "variables", "[", "[", "All", ",", " ", "1", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "\"EE\"", ",", " ", "\"Me\"", "}"}]], "Output"],
