   "AnchorBarGrid"], Cell["ExpandMomHatAlt", "ObjectName"],
  Cell[TextData[
    {"Expands supported all-line-shift momentum and propagator markers."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExpandMomHatAlt", "[", "expr", "]"}]],
      "InlineFormula"], "  ",
     "rewrites shifted composite propagators and chain momentum insertions."}]\
, "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"This is the expansion step for the supported all-line-shift \
momentum markers. It rewrites the recognized shifted propagators and chain \
insertions, using the conventions of the earlier deformation code."}],
   "Notes"], Cell[TextData[{"A ", ButtonBox["MomHat", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomHat"],
     " insertion in a chain becomes ", ButtonBox["Mom", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mom"], " plus z MomQ. A shifted \
composite propagator is expressed using its unshifted ",
     ButtonBox["PropDen", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PropDen"],
     " and the channel roots zPlus and zMinus."}], "Notes"],
  Cell[TextData[{"This legacy all-line-shift helper uses the package symbol \
ConstructiveDiagrams`z. It does not determine the auxiliary q momenta or \
solve for the roots."}], "Notes"],
  Cell[TextData[{"Preserve the shift definitions and assumptions alongside \
the result. This is separate from ordinary amplitude preparation."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Expand one shifted chain insertion."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ExpandMomHatAlt", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "1", "]", ",",
      " ", "MomHat", "[", "2", "]", ",", " ", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "3", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{TemplateBox[{TemplateBox[{"\"[\"", "1"},
         "RowDefault"], "\"|\"", SubscriptBox["p", "2"], "\"|\"",
        TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"], "+", RowBox[{"z", " ", TemplateBox[
         {TemplateBox[{"\"[\"", "1"}, "RowDefault"], "\"|\"",
          SubscriptBox["q", "2"], "\"|\"", TemplateBox[
           {"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
         "RowDefault"]}]}]], "Output"],
  Cell[TextData[{"Expose both roots of a shifted composite propagator."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ExpandMomHatAlt", "[", "1", "/",
      "PropDen", "[", "MomHat", "[", "Multiparticle", "[", "1", ",", " ",
      "3", "]", "]", ",", " ", "m", "]", "]"}]], "Input"],
  Cell[BoxData[FractionBox[RowBox[{SubsuperscriptBox["\"z\"",
        RowBox[{"1", ",", "3"}], "\"+\""], " ", SubsuperscriptBox["\"z\"",
        RowBox[{"1", ",", "3"}], "\"+\""]}],
     RowBox[{RowBox[{"(", RowBox[{RowBox[{"-", SuperscriptBox["m", "2"]}],
           "+", SubsuperscriptBox["p", RowBox[{"1", ",", "3"}], "2"]}],
         ")"}], " ", RowBox[{"(", RowBox[{"z", "-", SubsuperscriptBox[
            "\"z\"", RowBox[{"1", ",", "3"}], "\"+\""]}], ")"}], " ",
       RowBox[{"(", RowBox[{"z", "-", SubsuperscriptBox["\"z\"",
            RowBox[{"1", ",", "3"}], "\"+\""]}], ")"}]}]]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ComplexifyMomenta", BaseStyle -> "Link",
