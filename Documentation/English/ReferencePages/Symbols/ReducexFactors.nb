      {Cell[TextData[{Cell[BoxData[RowBox[{"Momenta"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[
         {Cell[BoxData[RowBox[{"{", "1", ",", " ", "2", ",", " ", "3", ",",
              " ", "4", "}"}]], "InlineFormula"]}], "TableText"],
       Cell["Complete external momentum labels available to the older \
simplification or x-factor helper. This is a legacy symbol option; the list \
supplies the context needed for momentum-conservation identities.",
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"ChannelMomenta"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "1", ",", " ", "4", "}"}]],
           "InlineFormula"]}], "TableText"], Cell["External labels defining \
the selected channel in the older x-factor reducers. This legacy symbol \
option works with ChannelMass and Momenta.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"ChannelMass"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Mchannel"}]], "InlineFormula"]}],
        "TableText"], Cell["Mass of the selected internal channel in the \
older x-factor reducers. This is a legacy symbol option and supplies a \
declared numerator identity, not an instruction to set propagator \
denominators on shell.", "TableText"]}}, GridBoxAlignment ->
