Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["MomProd", "ObjectName"],
  Cell[TextData[{"Represents the Lorentz scalar product of two external or \
composite momenta."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"MomProd", "[", "i", ",", " ", "j",
         "]"}]], "InlineFormula"], "  ", "represents p_i.p_j."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"MomProd", "[", "Multiparticle", "[",
         "i1", ",", " ", "...", "]", ",", " ", "j", "]"}]], "InlineFormula"],
     "  ", "expands the scalar product over a momentum sum."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"MomProd[i, j] means p_i dot p_j. Its arguments are particle \
or channel labels, without ", ButtonBox["Mom", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mom"], " wrappers. For example, \
MomProd[Multiparticle[1, 2], 3] denotes (p1+p2) dot p3."}], "Notes"],
  Cell[TextData[{"Supported signed and composite arguments are handled \
bilinearly, and the scalar product is symmetric. For a single external leg, \
MomProd[i, i] becomes ", Cell[BoxData[RowBox[{"Mass", "[", "i", "]", "^",
         "2"}]], "InlineFormula"],
     " using its external on-shell identity."}], "Notes"],
  Cell[TextData[{"MomProd[1, 3] does not automatically know which internal \
channel belongs to a particular diagram. If that diagram declares \
(p1+p3)^2=m_channel^2, ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " can use ",
     Cell[BoxData[RowBox[{"2", " ", "MomProd", "[", "1", ",", "3", "]", "=",
         "m", "_", "channel", "^", "2", "-", "Mass", "[", "1", "]", "^", "2",
         "-", "Mass", "[", "3", "]", "^", "2"}]], "InlineFormula"],
     " in the diagram's numerator."}], "Notes"],
  Cell[TextData[{ButtonBox["ExtractMandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractMandelstahm"], " expresses \
supported scalar products in terms of s invariants. Keeping MomProd in a \
numerator is also valid and can make later spinor reductions easier."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Expand a composite scalar product."}], "ExampleText"],
  Cell[BoxData[RowBox[{"MomProd", "[", "Multiparticle", "[", "1", ",", " ",
      "2", "]", ",", " ", "3", "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{SubscriptBox["p", "1"], ".",
        SubscriptBox["p", "3"]}], "+", RowBox[{SubscriptBox["p", "2"], ".",
        SubscriptBox["p", "3"]}]}]], "Output"],
  Cell[TextData[{"Use the external mass identity."}], "ExampleText"],
  Cell[BoxData[RowBox[{"MomProd", "[", "1", ",", " ", "1", "]"}]], "Input"],
  Cell[BoxData[SubsuperscriptBox["M", "1", "2"]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Mom", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mom"], "  \[Bullet]  ",
     ButtonBox["Mass", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mass"], "  \[Bullet]  ",
     ButtonBox["ExtractMandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractMandelstahm"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "MomProd - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/MomProd", "title" -> "MomProd", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" -> "Represents the Lorentz scalar product of two external or \
composite momenta.", "keywords" -> {"HEPCAT", "MomProd",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]