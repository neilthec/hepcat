     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["FermionBar", "ObjectName"],
  Cell[TextData[
    {"Records the left antifermion wavefunction of an all-incoming Dirac \
chain."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FermionBar", "[", "leg", ",", " ",
         "mass", ",", " ", "chirality", "]"}]], "InlineFormula"], "  ", "repr\
esents the left antifermion endpoint of an ordered Dirac chain."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FermionBar", "[", "leg", ",", "mass",
         ",", "chirality", "]"}]], "InlineFormula"],
     " is the left endpoint of a ", ButtonBox["DiracChain",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/DiracChain"], ". \
The first argument identifies the external momentum, and the second supplies \
that particle's mass."}], "Notes"],
  Cell[TextData[{"The usual massive Dirac endpoint has chirality tag ",
     Cell[BoxData[RowBox[{"\"Dirac\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "Model", "-", "defined", " ", "chiral",
         " ", "fields", " ", "use", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"L\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "or", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"R\""}]], "InlineFormula"], ". The tag selects \
the field components; it is not a choice of spin state for a massive \
fermion."}], "Notes"],
  Cell[TextData[{ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     " uses the all-incoming antifermion convention ",
     Cell[BoxData[RowBox[{"bar", " ", "v", " ", "=", " ", "(", "<", "p", "|",
         ",", "-", "[", "p", "|", ")"}]], "InlineFormula"], ". In particular, \
the relative sign of its angle and square components belongs to the \
conversion convention and should be kept when checking a result."}],
   "Notes"], Cell[TextData[{"For massless Dirac external fermions, give their \
helicities through the converter's ",
     Cell[BoxData[RowBox[{"\"FermionHelicities\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "option", ".", " ", "Its", " ", "helicity",
         " ", "values", " ", "are", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"-", "1", "/", "2"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"+", "1", "/", "2"}]], "InlineFormula"], "; this \
convention differs from the doubled spin labels used by exported SPINAS C++ \
functions."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Use an all-incoming antifermion at the left endpoint of a \
scalar bilinear."}], "ExampleText"],
  Cell[BoxData[RowBox[{"DiracChain", "[", "FermionBar", "[", "1", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", ",", " ", "DiracWord", "[", "]", ",",
      " ", "FermionKet", "[", "2", ",", " ", "m", ",", " ", "\"Dirac\"", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracChain", "[", "FermionBar", "[", "1", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", ",", " ", "DiracWord", "[", "]", ",",
      " ", "FermionKet", "[", "2", ",", " ", "m", ",", " ", "\"Dirac\"", "]",
      "]"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["FermionKet", BaseStyle -> "Link",
