        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["DiracWord", "ObjectName"],
  Cell[TextData[{"Keeps the order of gamma matrices and momentum slashes \
along a fermion line."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracWord", "[", "operator1", ",",
         " ", "operator2", ",", " ", "...", "]"}]], "InlineFormula"], "  ", "\
represents an ordered product of Dirac matrices and slashed momenta."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{"Use ", Cell[BoxData[RowBox[{"DiracWord"}]],
      "InlineFormula"], " inside a ", ButtonBox["DiracChain",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/DiracChain"], " \
to write the operators between its two external fermions. Matrix \
multiplication is ordered: the first operator is next to the left endpoint, \
and the last is next to the right endpoint."}], "Notes"],
  Cell[TextData[{"The operators accepted by ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " are ",
     ButtonBox["DiracGamma", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracGamma"], ", ",
     ButtonBox["DiracGamma5", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracGamma5"], ", ",
     ButtonBox["DiracSlash", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracSlash"], " and the identity ",
     Cell[BoxData[RowBox[{"1"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"DiracWord", "[", "]"}]], "InlineFormula"],
     " is the identity operator and is useful for a scalar fermion coupling."}\
], "Notes"], Cell[TextData[{"A ", Cell[BoxData[RowBox[{"DiracWord"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "is", " ", "a", " ",
         "symbolic", " ", "record", " ", "of", " ", "an", " ", "ordered",
         " ", "matrix", " ", "product", ".", " ", "Ordinary", " ",
         "Mathematica", " ", "multiplication", " ", "with", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"Times"}]], "InlineFormula"], " \
does not represent that ordering. Put scalar coupling factors outside the \
word, and use separate terms for a sum of matrix products."}], "Notes"],
  Cell[TextData[{"HEPCAT normally creates these words when it builds Feynman \
diagrams. You can inspect a word to follow the momentum insertions in a \
numerator, then convert the complete contracted expression with ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], "."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Record a momentum slash between two gamma matrices. The \
operator order follows the fermion line from left to right."}],
   "ExampleText"], Cell[BoxData[RowBox[{"DiracWord", "[", "DiracGamma", "[",
      "mu", "]", ",", " ", "DiracSlash", "[", "Mom", "[", "3", "]", "]", ",",
      " ", "DiracGamma", "[", "nu", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracWord", "[",
      RowBox[{RowBox[{"DiracGamma", "[", "mu", "]"}], ",",
        RowBox[{"DiracSlash", "[", SubscriptBox["p", "3"], "]"}], ",",
        RowBox[{"DiracGamma", "[", "nu", "]"}]}], "]"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
