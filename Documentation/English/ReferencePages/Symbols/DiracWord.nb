   "AnchorBarGrid"], Cell["DiracWord", "ObjectName"],
  Cell[
   "Represents an ordered product of Dirac matrices and slashed momenta.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"DiracWord", "[", "operator1", ",",
         " ", "operator2", ",", " ", "...", "]"}]], "InlineFormula"], "  ", "\
represents an ordered product of Dirac matrices and slashed momenta."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["Arguments are operators \
in their written order. DiracWord is not a commutative Times product; \
exchanging two gamma matrices requires the corresponding Clifford identity.",
   "Notes"], Cell["DiracGamma, DiracGamma5 and DiracSlash are the supported \
operator types. An empty word represents the identity between fermion \
endpoints.", "Notes"], Cell["These objects are normally generated from a \
Feynman model. Use FeynmanToSpinorProducts after Lorentz indices have been \
contracted.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Construct the symbolic object.", "ExampleText"],
  Cell[BoxData[RowBox[{"DiracWord", "[", "DiracGamma", "[", "mu", "]", ",",
      " ", "DiracSlash", "[", "Mom", "[", "3", "]", "]", ",", " ",
      "DiracGamma", "[", "nu", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracWord", "[",
