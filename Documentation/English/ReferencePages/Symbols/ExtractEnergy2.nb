Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ExtractEnergy2", "ObjectName"],
  Cell["Substitutes explicit two-component spinor rows and columns for one \
particle.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractEnergy2", "[", "expr", ",",
         " ", "i", ",", " ", "energy", ",", " ", "momentumMagnitude", ",",
         " ", "theta", ",", " ", "phi", "]"}]], "InlineFormula"], "  ", "repl\
aces supported helicity and indexed massive spinor endpoints on particle i."}]\
, "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExtractEnergy2", "[", "expr", ",",
         " ", "i", ",", " ", "energy", ",", " ", "momentumMagnitude", ",",
         " ", "theta", ",", " ", "phi", ",", " ", "mass", "]"}]],
      "InlineFormula"], "  ", "also supplies the known external on-shell mass \
for stable numerical components."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["This is the second stage of \
ExtractEnergy. It uses sqrt(E+p) and sqrt(E-p) for massive components, and \
sqrt(2E) for massless helicity spinors. With a known on-shell mass and \
supported positive-energy numerical inputs, the small massive component uses \
abs(m)/sqrt(E+p).", "Notes"], Cell["Explicit massive index values are +1/2 or \
-1/2. Chirality, variance and endpoint position determine the correct row or \
column and signs.", "Notes"], Cell["The returned SpinorChain can still \
contain vectors. ExtractEnergy performs the final conversion to Dot and Tr.",
   "Notes"], Cell["The optional trailing mass is used only by the supported \
real positive-energy on-shell numerical route. Omitting it preserves the \
original formulas; negative-energy, complex and clearly off-shell inputs \
retain the original branch behavior.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Insert a massless angle row at the north pole.", "ExampleText"],
  Cell[BoxData[RowBox[{"ExtractEnergy2", "[", "SpinorChain", "[", "Spinor",
      "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",",
      " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ",
      "2", "]", "]", ",", " ", "1", ",", " ", "energy", ",", " ", "energy",
      ",", " ", "0", ",", " ", "0", "]"}]], "Input"],
  Cell[BoxData[TemplateBox[
     {RowBox[{"lnice", "[", RowBox[{"{", RowBox[{"0", ",",
            RowBox[{RowBox[{"-", SqrtBox["2"]}], " ", SqrtBox["energy"]}]}],
          "}"}], "]"}], TemplateBox[{"2", "\"\[RightAngleBracket]\""},
       "RowDefault"]}, "RowDefault"]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"], "  \[Bullet]  ",
     ButtonBox["ExtractEnergy1", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy1"], "  \[Bullet]  ",
     ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"]}], "SeeAlso"],
