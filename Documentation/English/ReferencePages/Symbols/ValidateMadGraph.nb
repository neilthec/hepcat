      "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";", "\n",
      "helicityProcesses", " ", "=", " ", "{", "{", "\"e\"", ",", " ",
      "\"E\"", ",", " ", "\"A.+\"", ",", " ", "\"A.+\"", "}", ",", " ", "{",
      "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ", "\"A.-\"",
      "}", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.-\"",
