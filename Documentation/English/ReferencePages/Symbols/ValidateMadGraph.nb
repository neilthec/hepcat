Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/AmplitudeValidation"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ValidateMadGraph", "ObjectName"],
  Cell[TextData[{"Checks a HEPCAT/SPINAS amplitude against an independently \
generated MadGraph result at common random physical momenta."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ValidateMadGraph", "[", "directory",
         "]"}]], "InlineFormula"], "  ", "builds and runs the MadGraph \
validator of a SPINAS project exported by the current WriteSPINASProcess."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ValidateMadGraph", "[", "incoming",
         " ", "->", " ", "outgoing", ",", " ", "entries", ",", " ", "model",
         "]"}]], "InlineFormula"], "  ", "exports and validates the supplied \
all-incoming amplitude entries for the declared physical process."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ValidateMadGraph", "[", "particles",
         ",", " ", "amplitude", ",", " ", "model", "]"}]], "InlineFormula"],
     "  ", "validates one all-incoming amplitude at its specified massless \
helicities, with IncomingLegs selecting the physical incoming pair."}],
   "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ValidateMadGraph", "[", "input", ",",
         " ", "...", ",", " ", "\"Output\"", " ", "->", " ", "\"Details\"",
         "]"}]], "InlineFormula"], "  ", "returns the full report, including \
per-helicity failures and the actual random seed."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use ", Cell[BoxData[RowBox[{"ValidateMadGraph"}]],
      "InlineFormula"], " after deriving an amplitude when you want an \
independent numerical check of the formula and its C++ translation. MadGraph \
generates its own reference matrix element; the validator evaluates both \
results at exactly the same physical momenta with matched parameters."}],
   "Notes"], Cell[TextData[{"The normal result is a table with one row for \
each exported massless-helicity combination. A process without massless \
helicities has one corresponding row. A ", Cell[BoxData[RowBox[{"PASS"}]],
      "InlineFormula"], " means that all requested comparisons in that row \
met the stated numerical tolerance."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ValidateMadGraph", "[", "directory",
         "]"}]], "InlineFormula"], " uses an existing project written by ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], ". The \
amplitude-and-model forms first make a private export, build the numerical \
code and run the comparison. Only the comparison executable and its \
dependencies are built for validation, so preparing an optional MadEvent \
integration is a separate operation."}], "Notes"],
  Cell[TextData[{"The comparison is a numerical test over sampled phase \
space. It provides an independent diagnostic of a proposed expression, rather \
than a proof of equality for every kinematic point."}], "Notes"],
  Cell["Providing the reaction and the reference theory", "NotesSection"],
  Cell[TextData[{"Use the same ",
     Cell[BoxData[RowBox[{"incoming", " ", "->", " ", "outgoing"}]],
      "InlineFormula"], ", helicity entries and model as for ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], ". Keep each \
formula all incoming; the exporter performs the outgoing momentum and spinor \
crossing. The four-argument fixed-helicity form retains its single-amplitude \
convention."}], "Notes"],
  Cell[TextData[{"Supply ", Cell[BoxData[RowBox[{"\"MadGraphDirectory\""}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "and", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"MadGraphModel\""}]],
      "InlineFormula"], " explicitly. The model can be a UFO name or \
directory. Choose a theory with the interactions you intend to compare; the \
external particle names alone do not determine which internal exchanges \
belong in it."}], "Notes"],
  Cell[TextData[{"For example, ",
     Cell[BoxData[RowBox[{"\"MadGraphModel\"", " ", "->", " ",
         "\"sm-full\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "with", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"MadGraphAllowedParticles\"", " ", "->", " ",
         "{", "11", ",", "22", "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "explicitly", " ", "restricts", " ", "the",
         " ", "reference", " ", "to", " ", "electrons", ",", " ",
         "positrons", " ", "and", " ", "photons", ".", " ", "This", " ",
         "gives", " ", "a", " ", "pure", "-", "QED", " ", "comparison", " ",
         "while", " ", "retaining", " ", "the", " ", "model", "'", "s", " ",
         "massive", " ", "electron", ".", " ", "Leaving", " ", "the", " ",
         "particle", " ", "filter", " ", "at", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"All"}]], "InlineFormula"], " allows every \
interaction of the selected model, including its Z and Higgs exchanges when \
relevant."}], "Notes"], Cell[TextData[{"Particle filters use positive \
absolute PDG codes, include their antiparticles and must contain every \
external particle type. Unsupported or inconsistent selections produce a \
diagnostic instead of a passing comparison."}], "Notes"],
  Cell["Helicities, spin sums and phases", "NotesSection"],
  Cell[TextData[{"The validator checks each requested massless-helicity \
assignment separately. The table displays labels such as ",
     Cell[BoxData[RowBox[{"3", ":", "-", ",", " ", "4", ":", "+"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{";", " ", "details", " ",
         "retain", " ", "the", " ", "original", " ", "leg", "-", "order",
         " ", "vectors", " ", "with", " ", "doubled", " ", "integer", " ",
         "helicities", ",", " ", "such", " ", "as", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"-", "2"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"+", "2"}]], "InlineFormula"], " for photons."}],
   "Notes"], Cell[TextData[{"Massive spins are summed on each side. \
Individual massive spin components can use different bases in MadGraph and \
SPINAS, so their complex numbers are not compared component by component."}],
   "Notes"], Cell[TextData[{"Each comparison uses a squared amplitude. An \
overall phase, including a sign or a factor of ",
     Cell[BoxData[RowBox[{"I"}]], "InlineFormula"], ", therefore does not \
cause a mismatch. Relative phases between contributions to the same amplitude \
remain essential because they affect interference."}], "Notes"],
  Cell[TextData[{"Incoming averages and outgoing identical-species factors \
are matched once. A fixed incoming or outgoing massless helicity remains the \
selected contribution; it is not silently replaced by an unpolarized sum."}],
   "Notes"], Cell["Sampling and understanding a failed comparison",
   "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphPoints\"", " ", "->", " ",
         "1000"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "requests", " ", "1000", " ", "common", " ",
         "physical", " ", "points", " ", "for", " ", "every", " ",
         "massless", "-", "helicity", " ", "combination", ".", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"MadGraphSeed\"", " ", "->",
         " ", "Automatic"}]], "InlineFormula"], " selects a seed at run time \
and reports it. Supply an unsigned 64-bit integer, including zero, to repeat \
a particular sample sequence."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"RelativeTolerance\"", " ", "->",
         " ", "10", "^", "-", "7"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"AbsoluteTolerance\"", " ", "->", " ", "0"}]],
      "InlineFormula"], " are the default numerical tolerances. Nonfinite \
values, missing evaluations and runtime errors cannot count as a pass. The \
full report retains the first failing momenta and the concrete seed."}],
   "Notes"],
  Cell[TextData[{"Use ", Cell[BoxData[RowBox[{"\"MinimumEnergy\""}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "and", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"MaximumEnergy\""}]],
      "InlineFormula"], " to restrict the sampled center-of-mass energies. \
Automatic choices lie above the process thresholds. These random points are \
validation probes, rather than an integration result or a cross section."}],
   "Notes"], Cell[TextData[{"A failure can expose numerical conditioning as \
well as an incorrect expression. At high energy, large cancellations or \
inverse small masses can make one form lose precision even when a more \
compact equivalent form is stable. Compare the failed values and momenta \
before loosening a tolerance."}], "Notes"],
  Cell["Matching parameters and widths", "NotesSection"],
  Cell[TextData[{"The HEPCAT model supplies its numerical inputs through ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], ". ",
     Cell[BoxData[RowBox[{"\"MadGraphParameterMap\"", " ", "->", " ", "{",
         "\"HEPCATName\"", " ", "->", " ", "\"UFOName\"", ",", " ", "...",
         "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "relates", " ", "differently", " ", "named",
         " ", "parameters", ";", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"MadGraphParameterRules\""}]], "InlineFormula"],
     " supplies explicit external UFO input values when necessary."}],
   "Notes"], Cell[TextData[{"A name mapping does not by itself change a \
derived UFO coupling to an arbitrary value. Its value must agree with the \
selected model's independent inputs. Ambiguous or inconsistent matching \
produces a diagnostic before the comparison can pass."}], "Notes"],
  Cell[TextData[{"The two sides must also use the same propagator-width \
prescription. A bare ", ButtonBox["PropDen", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PropDen"], " has no decay width, so \
independently adjustable, unmatched MadGraph decay-width inputs are set to \
zero. Explicit reference width rules and matched width parameters retain \
their supplied values. The detailed reference report records this choice."}],
   "Notes"], Cell["Reports and external software", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"Output\"", " ", "->", " ",
         "\"Summary\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "gives", " ", "status", " ", "counts", ".",
         " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"Output\"", " ", "->", " ", "\"Details\""}]],
      "InlineFormula"], " gives the complete report, including reference \
setup, helicity selection, numerical errors and failed momenta. These reports \
help distinguish a theory mismatch from a sampling or numerical problem."}],
   "Notes"], Cell[TextData[{"The current validator supports colorless tree \
processes with two incoming particles, at least two outgoing particles and \
external spins through one. It requires MadGraph, a Fortran compiler, SPINAS \
and the normal C++ build tools. Ordinary source-only SPINAS exports remain \
available without those reference tools."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"TimeConstraint\"", " ", "->", " ",
         "600"}]], "InlineFormula"], " bounds MadGraph reference preparation. \
It does not impose a single deadline on the complete CMake build and all \
requested numerical samples."}], "Notes"],
  Cell[TextData[{"The directory form uses the process, model, parameter \
matching and fixed-helicity selection saved in that export. You can vary \
sampling controls such as points, seed, tolerances and energy bounds. To \
change the stored reaction or reference theory, regenerate the project or use \
an amplitude-and-model form."}], "Notes"],
  Cell[TextData[{"For numerical event generation with the HEPCAT amplitude, \
use the MadEvent launcher generated by ", ButtonBox["WriteSPINASProcess",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/WriteSPINASProcess"], ". Running that simulation \
does not replace the independent comparison provided by ",
     Cell[BoxData[RowBox[{"ValidateMadGraph"}]], "InlineFormula"], "."}],
   "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"SPINASDirectory\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Path to the local SPINAS checkout/library. Automatic \
searches SPINAS_ROOT and the sibling spinas checkout; an explicit directory \
selects another installation."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"IncomingLegs\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "1", ",", " ", "2", "}"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"External leg labels that are physically incoming in \
exported C++. Other legs are crossed once from HEPCAT's all-ingoing \
convention, including outgoing angle-spinor signs. Runnable projects \
currently require two incoming particles."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FixedHelicities\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Massless leg-to-doubled-helicity rules selecting \
states in the grouped SPINAS exporter. Automatic retains the requested \
coverage; explicitly fixed incoming helicities are not averaged over, and a \
fixed outgoing helicity is a labeled contribution."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ParameterRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Local numerical parameter overrides keyed by model \
references or string names. Automatic resolves the model's variables and \
dependent functions; fitting and checks do not assign global values or \
replace parameters in the symbolic final amplitude."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ProcessName\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"hepcat_process\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Valid C++ identifier for the exported SPINAS class and \
executable. Choose a readable process name that does not collide with \
reserved generated members."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Precision\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Floating-point type used by exported SPINAS code. \
Automatic reads the local library build configuration; \"Double\" and \
\"LongDouble\" must match the library being linked."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CodeStyle\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"Optimized\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"SPINAS code-generation mode. \"Optimized\", the \
default, analyzes each supplied process and shares numerical work by \
parameter, momentum and spin dependence. \"Readable\" keeps the direct \
formula layout. Both expose the same amplitude and spin-sum interfaces; the \
manifest reports the layout and applied optimizations."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"HelicitySymmetry\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Spin-sum reuse of globally reversed massless \
helicities. Automatic attempts a bounded exact algebraic certificate and \
otherwise keeps exhaustive summation. None disables reuse. \"Conjugation\" \
explicitly asserts the relation for the requested complete massive-spin sum, \
as in real-coupling tree-level vector QED. Every complex amplitude remains \
exported. Only present conjugate partners are paired; fixed or unpaired \
selections remain exhaustive. Nonzero or symbolic widths disable pairing, and \
any nonreal current parameter makes the generated evaluator use the \
exhaustive sum. HelicitySummation in the manifest records what was applied."}]\
, "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"Build\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to configure and compile the \
exported C++ project against the existing SPINAS library. False writes source \
files only; a source-only export does not require CMake."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RunExamples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to build the exported SPINAS \
project and execute its sample phase-space points. True implies the necessary \
build step."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CMakeExecutable\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Path to the CMake program used when building. \
Automatic searches PATH and standard installations, including common macOS \
application and Homebrew locations."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Overwrite\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether existing generated project \
files may be replaced. False protects an existing SPINAS output directory \
from accidental overwriting."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPDirectory\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen CalcHEP installation directory. \
None, the default, leaves the optional backend unconfigured. An explicitly \
supplied Automatic consults the corresponding environment variables only; no \
installation path is guessed."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPModel\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen equivalent CalcHEP reference \
theory as {directory, modelNumber}. None, the default, selects no theory; \
Automatic does not infer a model. This reference model is separate from the \
supplied HEPCAT amplitudes."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPAllowedParticles\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"All"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"All retains the full selected CalcHEP \
theory. A nonempty list of unique positive absolute PDG codes restricts the \
independent reference particle sector, including antiparticles. Every \
external type must be included."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RunCalcHEPValidation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether export builds and runs the \
generated independent CalcHEP comparison. It uses the same physical points on \
both implementations; unsupported polarized or color-stripped comparisons \
report unavailable. When MadGraph is also requested, its check still runs if \
CalcHEP fails. A failed requested reference returns Failure with both reports \
retained in ExportResult."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPPoints\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"1000"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Number of random physical phase-space \
points compared by the generated independent CalcHEP validation executable. \
This tests both implementations at the same points."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPSeed\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Default seed of the generated CalcHEP comparison. \
Automatic chooses from the time when validation runs and prints the concrete \
seed; an unsigned 64-bit integer, including zero, makes the run \
reproducible."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReturnDetails\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to expose optional diagnostic \
data instead of the compact default result. For preparation and factorization \
completion it retains provenance, directions and validation and takes \
precedence over Output; for export it returns file paths and build/run \
results."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphDirectory\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen MadGraph installation directory \
for independent validation and the MadEvent numerical bridge. None, the \
default, leaves this optional support unconfigured. An explicitly supplied \
Automatic consults environment variables only; pass a path to make the \
selection explicit."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphModel\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen MadGraph UFO model name or \
directory. It supplies the independent validation reference and the numerical \
MadEvent model metadata and phase-space topologies. None, the default, \
selects no theory; Automatic does not infer one. Specify the model and any \
particle filter explicitly."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphAllowedParticles\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"All"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"All retains the full selected MadGraph \
theory. A nonempty list of unique positive absolute PDG codes, such as \
{11,22}, restricts the particle sector used for reference validation and \
MadEvent topology generation and includes antiparticles. Every external \
particle type must be present."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphParameterRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Real numerical values for named external MadGraph UFO \
parameters. Automatic uses the supported model-parameter matching; explicit \
rules supply otherwise ambiguous independent inputs."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphParameterMap\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Rules mapping HEPCAT model parameter names to external \
or derived MadGraph UFO parameter names. Automatic uses supported same-name \
and known-model matching; unresolved used parameters prevent a passing \
comparison."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RunMadGraphValidation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether WriteSPINASProcess builds and \
runs the independent MadGraph comparison. False writes the optional support \
without running it; True runs a report for each exported massless-helicity \
combination. A numerical FAIL is returned as Failure, not a successful \
source-export result. If CalcHEP is also requested, both checks are attempted \
and their reports remain in ExportResult."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphPoints\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"1000"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Number of common random phase-space \
points compared for each massless-helicity combination. The default is 1000."}\
], "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphSeed\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Random seed for the generated MadGraph comparison. \
Automatic chooses one time-based seed when validation runs and reports it; an \
explicit unsigned 64-bit integer, including zero, replays the samples."}],
        "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"Output\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"Table\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Choose the amount and shape of returned information. \
Defaults are a compact check table, prepared input forms, a completed \
{externalMassRules, expression} pair, or a bare constructed expression; \
\"Details\" preserves diagnostics and provenance."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RelativeTolerance\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"1", "/", "10000000"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum relative numerical difference allowed by the \
selected comparison. ValidateMadGraph defaults to 10^-7; this is applied \
independently to each tested massless-helicity combination."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"AbsoluteTolerance\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"0"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Optional absolute numerical comparison \
tolerance. ValidateMadGraph defaults to zero so a wrong tiny amplitude cannot \
pass through a fixed absolute floor."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MinimumEnergy\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Lower center-of-mass energy used by ValidateMadGraph's \
random validation samples. Automatic chooses a value above the incoming and \
outgoing mass thresholds."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MaximumEnergy\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Upper center-of-mass energy used by ValidateMadGraph's \
random validation samples. Automatic chooses a suitable range above \
threshold."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"TimeConstraint\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"600"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Time budget in seconds for generating \
and compiling the independent MadGraph reference process. A timeout is an \
incomplete check, not PASS."}], "TableText"]}}, GridBoxAlignment ->
