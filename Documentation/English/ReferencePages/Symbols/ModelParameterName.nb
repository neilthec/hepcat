Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ModelParameterName", "ObjectName"],
  Cell[TextData[{"Return the string name of a model-local parameter."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ModelParameterName", "[", "parameter",
         "]"}]], "InlineFormula"], "  ",
     "Extract the name from a ModelParameter reference."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this when reporting parameters or matching their names \
between two models. For example, the parameter returned by ",
     Cell[BoxData[RowBox[{"ModelParameter", "[", "model", ",", " ", "\"Me\"",
         "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "has", " ", "the", " ", "name", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"Me\""}]], "InlineFormula"], " \
even though the complete object also carries a model scope and a domain."}],
   "Notes"], Cell[TextData[{"The result is a string, not an assignable \
Mathematica symbol and not a numerical value. To obtain numerical replacement \
rules, use ", ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], ". To retrieve \
a parameter in another model, pass the returned name to ",
     ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], "."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";"}]], "Input",
      InitializationCell -> True]}, Closed]], Cell["Basic Examples",
   "ExampleSection"], Cell[TextData[{"Read a declared parameter name."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";", "\n",
      "ModelParameterName", "[", "ModelParameter", "[", "qedModel", ",", " ",
      "\"Me\"", "]", "]"}]], "Input"], Cell[BoxData[RowBox[{"\"Me\""}]],
   "Output"],
  Cell[TextData[{"List the names that resolved to numerical parameter \
values."}], "ExampleText"],
  Cell[BoxData[RowBox[{"qedModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "3", "]", ";", "\n", "ModelParameterName",
      " ", "/@", " ", "(", "First", " ", "/@", " ", "ModelParameterRules",
      "[", "qedModel", "]", ")"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "\"EE\"", ",", " ", "\"Me\"", "}"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], "  \[Bullet]  ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ModelParameterName - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ModelParameterName",
     "title" -> "ModelParameterName", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" -> "Return the string name of a model-local parameter.",
     "keywords" -> {"HEPCAT", "ModelParameterName", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]