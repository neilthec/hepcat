Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ReadParticles", "ObjectName"],
  Cell["Read particle and antiparticle declarations from a model table.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReadParticles", "[", "file", "]"}]],
      "InlineFormula"], "  ", "Read the eleven-column prtclsN.mdl table."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The columns retain the \
full name, particle name, antiparticle name, identifier, twice the spin, \
mass, width, color, auxiliary information and two display names. The list \
order and particle names are model data, not newly created Wolfram symbols.",
   "Notes"], Cell["Mass parameters are parsed into model-local ModelParameter \
references. ParticleMass searches both the particle and antiparticle \
columns.", "Notes"], Cell["Diagram generation and automatic \
identical-particle symmetry use particle identities and twice-spin \
declarations. Equal masses alone do not identify particles.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"], Cell["Read the particle table.",
   "ExampleText"], Cell[BoxData[RowBox[{"particles", " ", "=", " ",
      "ReadParticles", "[", "FileNameJoin", "[", "{", "modelDirectory", ",",
      " ", "\"prtcls2.mdl\"", "}", "]", "]", ";", "\n", "particles"}]],
   "Input"],
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"{", RowBox[{"\"photon\"", ",", "\"A.+\"", ",",
            "\"A.-\"", ",", "22", ",", "2", ",", "0", ",", "\"0\"", ",", "1",
            ",", "\"\"", ",", "\"A\"", ",", "\"A\""}], "}"}], ",",
        RowBox[{"{", RowBox[{"\"electron\"", ",", "\"e\"", ",", "\"E\"", ",",
            "11", ",", "1", ",", InterpretationBox["Me", ModelParameter["Me",
              "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927ea\
ad", "Real"], Editable -> False], ",", "\"0\"", ",", "1", ",", "\"\"", ",",
            "\"e\"", ",", "\"\\\\bar{e}\""}], "}"}]}], "}"}]], "Output"],
  Cell["Find the electron mass from the particle declarations.",
   "ExampleText"], Cell[BoxData[RowBox[{"ParticleMass", "[", "\"e\"", ",",
      " ", "particles", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox["Me", ModelParameter["Me",
      "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad",
      "Real"], Editable -> False]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["ParticleMass", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ParticleMass"], "  \[Bullet]  ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], "  \[Bullet]  ",
     ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "ReadParticles - HEPCAT Documentation",
