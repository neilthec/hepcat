Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PropDen", "ObjectName"],
  Cell[TextData[{"Represents a physical propagator denominator without \
putting its momentum on shell."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PropDen", "[", "Mom", "[", "channel",
         "]", ",", " ", "m", "]"}]], "InlineFormula"], "  ",
     "represents p_channel^2-m^2."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PropDen", "[", "Mom", "[", "channel",
         "]", ",", " ", "m", ",", " ", "width", "]"}]], "InlineFormula"],
     "  ", "represents p_channel^2-m^2+I m width."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"PropDen[Mom[Multiparticle[1, 3]], m] represents \
(p1+p3)^2-m^2. In an amplitude, divide by this object. The momentum and mass \
remain explicit, allowing ", ButtonBox["PhysicalPoleResidue",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PhysicalPoleResidue"], " and ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"],
     " to identify the corresponding physical pole."}], "Notes"],
  Cell[TextData[{"The typeset display writes the square of a sum of external \
momenta as s with the channel labels in its subscript. For example, s123 \
denotes (p1+p2+p3)^2, and the denominator displays as s123 minus the \
propagator mass squared. A zero propagator mass leaves just s123. A supplied \
width contributes its usual imaginary term. Copying the typeset propagator \
recovers the typed PropDen expression."}], "Notes"],
  Cell[TextData[{"The three-argument form adds the width term +I m width. \
Keep this sign convention when comparing with external numerical code. A \
package or library using another width convention needs an explicit \
conversion rather than an unannounced sign change."}], "Notes"],
  Cell[TextData[{"Modern reduction and identity functions treat the arguments \
of PropDen as protected. Diagram-local internal on-shell identities can \
simplify a numerator, but must never replace the diagram's own denominator by \
zero."}], "Notes"], Cell[TextData[{ButtonBox["ExtractMandelstahm",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ExtractMandelstahm"], " can rewrite supported \
two-particle denominators in invariant notation. This is an algebraic change \
of representation, not a residue evaluation or an internal-shell assumption."}\
], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Keep the propagator while reducing the numerator."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", "]", "/",
      "PropDen", "[", "Mom", "[", "Multiparticle", "[", "1", ",", " ", "3",
      "]", "]", ",", " ", "m", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell[TextData[{"Inspect the explicit invariant form."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "PropDen", "[", "Mom", "[",
      "Multiparticle", "[", "1", ",", " ", "3", "]", "]", ",", " ", "m", "]",
      ",", " ", "5", "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"-", SuperscriptBox["m", "2"]}], "+",
      SubscriptBox["\"s\"", "\"13\""]}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Mom", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mom"], "  \[Bullet]  ",
     ButtonBox["Mass", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mass"], "  \[Bullet]  ",
     ButtonBox["ExtractMandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractMandelstahm"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "PropDen - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/PropDen", "title" -> "PropDen", "type" -> "Symbol",
     "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" -> "Represents a physical propagator denominator without \
putting its momentum on shell.", "keywords" -> {"HEPCAT", "PropDen",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]