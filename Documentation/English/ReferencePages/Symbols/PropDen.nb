Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["PropDen", "ObjectName"],
  Cell["Represents an off-shell physical propagator denominator.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PropDen", "[", "Mom", "[", "channel",
         "]", ",", " ", "m", "]"}]], "InlineFormula"], "  ",
     "represents p_channel^2-m^2."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"PropDen", "[", "Mom", "[", "channel",
         "]", ",", " ", "m", ",", " ", "width", "]"}]], "InlineFormula"],
     "  ", "represents p_channel^2-m^2+I m width."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["PropDen is kept opaque by the modern \
spinor reducer and identity tools. Diagram-local internal on-shell identities \
act on numerators and must not set the denominator of the current diagram to \
zero.", "Notes"], Cell["A denominator records the actual momentum and \
propagating mass. It is not merely a shorthand for a channel's on-shell \
condition.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Keep the propagator while reducing the numerator.", "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", "]", "/", "PropDen", "[", "Mom", "[",
      "Multiparticle", "[", "1", ",", " ", "3", "]", "]", ",", " ", "m", "]",
      "]"}]], "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["Inspect the explicit invariant form.", "ExampleText"],
  Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "PropDen", "[", "Mom", "[",
      "Multiparticle", "[", "1", ",", " ", "3", "]", "]", ",", " ", "m", "]",
      ",", " ", "5", "]"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"-", SuperscriptBox["m", "2"]}], "+",
      SubscriptBox["\"s\"", "\"13\""]}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["Mom", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mom"], "  \[Bullet]  ",
     ButtonBox["Mass", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mass"], "  \[Bullet]  ",
     ButtonBox["ExtractMandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractMandelstahm"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "PropDen - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
