Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ComplicateAmplitude", "ObjectName"],
  Cell[
   "Generates a model-free random sequence of reversible symbolic \
identities.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{",
         "massRules", ",", " ", "expr", "}", ",", " ", "n", "]"}]],
      "InlineFormula"], "  ",
     "applies up to n eligible random edits; n defaults to 5."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{",
         "massRules", ",", " ", "expr", "}", ",", " ", "n", ",", " ",
         "RandomSeed", " ", "->", " ", "seed", ",", " ", "\"RecordSteps\"",
         " ", "->", " ", "True", "]"}]], "InlineFormula"], "  ",
     "records a reproducible trajectory."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["The returned association contains \
MassRules, Original, Expression and Steps. With \"RecordSteps\"->True it also \
includes Trajectory, whose entries contain Before, After and Candidate.",
   "Notes"], Cell["The string options \"OnShellChannels\" and \
\"MomentumConservation\" have the same meaning as in \
SpinorIdentityCandidates. RandomSeed is a symbolic option; Automatic uses the \
ordinary random state.", "Notes"], Cell["The routine is useful for testing \
identity replay and generating exact equivalent forms. Random scrambling need \
not monotonically increase complexity, and fewer than n moves can occur when \
no eligible move remains.", "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"RandomSeed"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"], Cell["Random-sampling seed. \
Automatic resolves one time-based seed for the operation; an explicit \
integer, including zero, reproduces the sample choices. Detailed reports \
retain the resolved seed. ComplicateAmplitude uses the legacy symbol key \
RandomSeed; modern construction/checking functions use the string key \
\"RandomSeed\".", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RecordSteps\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell["Whether ComplicateAmplitude retains intermediate \
states and the legal identity edits along its scramble path, rather than \
returning only the ordinary scrambled result.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"OnShellChannels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"], Cell["Internal cuts legal for an \
explicit identity edit or scramble. Automatic reads the current diagram \
pair's internal mass rules; use {} for a combined amplitude with no allowed \
internal-shell identities.", "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MomentumConservation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell["Whether identities may use the complete declared \
external momentum sum. The operation uses the known external-leg list rather \
than imposing unrelated internal cut conditions.", "TableText"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Left, Left}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.23], Scaled[0.19],
         Scaled[0.58]}}, GridBoxDividers ->
      {"Rows" -> {False, True, {False}, False}}]], "3ColumnTableMod"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Generate and retain a short repeatable identity trajectory.",
   "ExampleText"], Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{", "{",
      "}", ",", " ", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",",
      " ", "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4", "]", "]", "}",
      ",", " ", "2", ",", " ", "RandomSeed", " ", "->", " ", "17", ",", " ",
      "\"RecordSteps\"", " ", "->", " ", "True", ",", " ",
      "\"OnShellChannels\"", " ", "->", " ", "{", "}", ",", " ",
      "\"MomentumConservation\"", " ", "->", " ", "False", "]"}]], "Input"],
  Cell["Request no edits.", "ExampleText"],
  Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{", "{", "}", ",", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", "}",
      ",", " ", "0", "]", "[", "\"Steps\"", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"0"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     "  \[Bullet]  ", ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
