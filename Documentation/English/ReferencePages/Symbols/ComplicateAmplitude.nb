Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData ->
            "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ComplicateAmplitude", "ObjectName"],
  Cell[TextData[{"Generates an equivalent expression by applying a random \
sequence of reversible identity steps."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{",
         "massRules", ",", " ", "expr", "}", ",", " ", "n", "]"}]],
      "InlineFormula"], "  ",
     "applies up to n eligible random edits; n defaults to 5."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{",
         "massRules", ",", " ", "expr", "}", ",", " ", "n", ",", " ",
         "RandomSeed", " ", "->", " ", "seed", ",", " ", "\"RecordSteps\"",
         " ", "->", " ", "True", "]"}]], "InlineFormula"], "  ",
     "records a reproducible trajectory."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"This is useful for checking that a simplifier or a recorded \
derivation can recover an equivalent form. The input is {massRules, \
expression}; the second argument is the maximum number of random edits and \
defaults to 5."}], "Notes"],
  Cell[TextData[{"The returned association contains \"MassRules\", \
\"Original\", \"Expression\", and \"Steps\". \"Original\" is the \
canonicalized starting expression, \"Expression\" is the last expression \
reached, and \"Steps\" is the number of moves actually made."}], "Notes"],
  Cell[TextData[{"Set the string option \"RecordSteps\"->True to retain \
\"Trajectory\". Each trajectory entry contains \"Before\", \"After\", and \
\"Candidate\", so the random calculation can be inspected as an identity \
derivation rather than just compared at its endpoints."}], "Notes"],
  Cell[TextData[{"An explicit integer RandomSeed makes the random choices \
repeatable. Automatic uses the ordinary random state within the routine's \
local random scope. The random path does not have to increase complexity at \
every step, and it can stop early when there are no eligible moves."}],
   "Notes"], Cell[TextData[{"The \"OnShellChannels\" and \
\"MomentumConservation\" string options have the same scope as in ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"], ". For a \
completed amplitude, explicitly forbid internal-shell assumptions with \
\"OnShellChannels\"->{}."}], "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"RandomSeed"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Random-sampling seed. Automatic resolves one \
time-based seed for the operation; an explicit integer, including zero, \
reproduces the sample choices. Detailed reports retain the resolved seed. \
ComplicateAmplitude uses the legacy symbol key RandomSeed; modern \
construction/checking functions use the string key \"RandomSeed\"."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RecordSteps\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether ComplicateAmplitude retains \
intermediate states and the legal identity edits along its scramble path, \
rather than returning only the ordinary scrambled result."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"OnShellChannels\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Internal cuts legal for an explicit identity edit or \
scramble. Automatic reads the current diagram pair's internal mass rules; use \
{} for a combined amplitude with no allowed internal-shell identities."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MomentumConservation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether identities may use the complete \
declared external momentum sum. The operation uses the known external-leg \
list rather than imposing unrelated internal cut conditions."}],
        "TableText"]}}, GridBoxAlignment ->
      {"Columns" -> {Left, Left, Left}}, GridBoxItemSize ->
      {"Columns" -> {Scaled[0.23], Scaled[0.19], Scaled[0.58]}},
     GridBoxDividers -> {"Rows" -> {False, True, {False}, False}}]],
   "3ColumnTableMod"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Recording an identity route", "ExampleSubsection"],
  Cell[TextData[{"Generate and retain a short repeatable identity \
trajectory."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{", "{", "}", ",", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4", "]", "]", "}",
      ",", " ", "2", ",", " ", "RandomSeed", " ", "->", " ", "17", ",", " ",
      "\"RecordSteps\"", " ", "->", " ", "True", ",", " ",
      "\"OnShellChannels\"", " ", "->", " ", "{", "}", ",", " ",
      "\"MomentumConservation\"", " ", "->", " ", "False", "]"}]], "Input"],
  Cell["Controlling the step count", "ExampleSubsection"],
  Cell[TextData[{"Request no edits."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ComplicateAmplitude", "[", "{", "{", "}", ",", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", "}",
      ",", " ", "0", "]", "[", "\"Steps\"", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"0"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     "  \[Bullet]  ", ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"],
     "  \[Bullet]  ", ButtonBox["SpinorExpressionComplexity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorExpressionComplexity"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle ->
  "ComplicateAmplitude - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/ComplicateAmplitude",
