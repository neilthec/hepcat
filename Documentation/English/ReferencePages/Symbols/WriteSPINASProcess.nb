Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FormattingAndExport"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["WriteSPINASProcess", "ObjectName"],
  Cell[TextData[{"Writes a runnable SPINAS C++ process from a spinor \
amplitude or a complete set of its helicity amplitudes."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"WriteSPINASProcess", "[", "directory",
         ",", " ", "particles", ",", " ", "amplitude", ",", " ", "model",
         "]"}]], "InlineFormula"], "  ", "exports one all-incoming amplitude \
at its fixed massless helicities."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"WriteSPINASProcess", "[", "directory",
         ",", " ", "entries", ",", " ", "model", "]"}]], "InlineFormula"],
     "  ", "combines helicity-related {particles, amplitude} entries into one \
class."}], "Usage"],
  Cell[TextData[{Cell[BoxData[RowBox[{"WriteSPINASProcess", "[", "directory",
         ",", " ", "incoming", " ", "->", " ", "outgoing", ",", " ",
         "entries", ",", " ", "model", "]"}]], "InlineFormula"], "  ", "decla\
res the physical process and crosses its outgoing legs automatically."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"WriteSPINASProcess"}]],
      "InlineFormula"], " takes an amplitude that you have already obtained \
and writes a C++ project for evaluating it numerically with SPINAS. The \
project includes a readable process class, an example program, build \
instructions and a manifest describing the exported process."}], "Notes"],
  Cell[TextData[{"The usual input is ",
     Cell[BoxData[RowBox[{"incoming", " ", "->", " ", "outgoing"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{",", " ", "a", " ", "list", " ",
         "of", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"{", "{", "particles", ",", " ", "amplitude", "}",
         ",", " ", "...", "}"}]], "InlineFormula"], " entries, and the HEPCAT \
model. This form states the physical reaction explicitly and lets the \
exporter combine its helicity sectors. Each entry still uses HEPCAT's \
all-incoming particle ordering and formula."}], "Notes"],
  Cell[TextData[{"The ordinary return value is the output directory. Use ",
     Cell[BoxData[RowBox[{"\"ReturnDetails\"", " ", "->", " ", "True"}]],
      "InlineFormula"], " to obtain the generated file paths, normalization \
information, build results and any requested validation reports."}],
   "Notes"], Cell[TextData[{"The exporter translates the supplied amplitude; \
it does not derive missing contributions to it. Obtain and check the \
amplitude with ", ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], " or ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"],
     " before using it in a simulation."}], "Notes"],
  Cell["Choosing the process and helicity coverage", "NotesSection"],
  Cell[TextData[{"The concatenated incoming and outgoing lists fix the \
numbered leg order. A physical ",
     Cell[BoxData[RowBox[{"e", ",", "A", " ", "->", " ", "e", ",", "A"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "process", " ",
         "therefore", " ", "has", " ", "an", " ", "all", "-", "incoming",
         " ", "amplitude", " ", "entry", " ", "with", " ", "species", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"e", ",", "A", ",", "E", ",",
         "A"}]], "InlineFormula"], ". The exporter reverses the outgoing \
momenta and angle-spinor signs once. Supply the original all-incoming \
expression, without crossing it in advance."}], "Notes"],
  Cell[TextData[{"A generic massless name such as ",
     Cell[BoxData[RowBox[{"\"A\""}]], "InlineFormula"], " asks for both \
photon helicities. Include an amplitude for each requested sector. The \
exporter reuses equivalent same-role permutations of identical particles, \
with their statistics signs, and refuses incomplete coverage instead of \
inventing a missing parity-related formula."}], "Notes"],
  Cell[TextData[{"Use ", Cell[BoxData[RowBox[{"\"A.+\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{",", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"A.-\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "or", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"FixedHelicities\"", " ", "->", " ", "{", "leg",
         " ", "->", " ", "doubledHelicity", "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "when", " ", "you", " ", "want", " ", "a",
         " ", "selected", " ", "incoming", " ", "or", " ", "outgoing", " ",
         "massless", " ", "helicity", ".", " ", "For", " ", "photons", " ",
         "the", " ", "doubled", " ", "labels", " ", "are", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"+", "2"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"-", "2"}]], "InlineFormula"],
     ". This selection produces a labeled helicity contribution."}],
   "Notes"], Cell[TextData[{"The four-argument ",
     Cell[BoxData[RowBox[{"particles", ",", " ", "amplitude", ",", " ",
         "model"}]], "InlineFormula"], " form exports a single fixed-helicity \
expression and retains its earlier normalization convention. The grouped \
physical-process form is the clearer choice for a complete unpolarized \
reaction."}], "Notes"],
  Cell["What the generated numerical functions calculate", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"amp", "(", "ds1", ",", "...", ",",
         "dsn", ")"}]], "InlineFormula"], " returns the complex amplitude for \
one external spin/helicity assignment. Its phase is retained, and this call \
performs no spin sum. The generated C++ class also accepts the corresponding \
spin array."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"spin", "_", "sum", "(", ")"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "evaluates", " ", "the",
         " ", "requested", " ", "external", " ", "states", " ", "and", " ",
         "adds", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"|", "amp", "|", "^", "2"}]], "InlineFormula"], " \
for each one. It squares each state before summing: amplitudes for different \
external spins or helicities are not added coherently."}], "Notes"],
  Cell[TextData[{"For a helicity family, ",
     Cell[BoxData[RowBox[{"amp2", "(", ")"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "also", " ", "averages", " ", "over", " ",
         "unfixed", " ", "incoming", " ", "states", " ", "and", " ",
         "includes", " ", "the", " ", "final", " ", "identical", "-",
         "species", " ", "factorials", " ", "once", ".", " ", "For", " ",
         "an", " ", "unpolarized", " ", "electron", "/", "positron", " ",
         "pair", " ", "producing", " ", "two", " ", "identical", " ",
         "photons", ",", " ", "these", " ", "factors", " ", "give", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"(", "1", "/", "8", ")", " ",
         "Sum", "[", "|", "amp", "|", "^", "2", "]"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{":", " ", "an", " ", "initial", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"1", "/", "4"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "spin", " ", "average",
         " ", "and", " ", "a", " ", "final", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"1", "/", "2", "!"}]], "InlineFormula"],
     " symmetry factor."}], "Notes"],
  Cell[TextData[{"Fixing an incoming massless helicity removes its averaging \
factor. A selected outgoing helicity remains a partial contribution with the \
same full identical-species factorial convention. The manifest records the \
selection and normalization."}], "Notes"],
  Cell[TextData[{"The symmetric spinor components describing one massive \
vector state are combined before squaring that state. Separate external \
vector polarizations are then summed as probabilities. The exported complex \
amplitudes retain the information needed for explicit spin-state \
calculations; a production-decay sewing engine is not supplied."}], "Notes"],
  Cell["Writing, building and changing model parameters", "NotesSection"],
  Cell[TextData[{"By default the exporter writes source only. ",
     Cell[BoxData[RowBox[{"\"Build\"", " ", "->", " ", "True"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "configures", " ", "CMake",
         " ", "and", " ", "links", " ", "the", " ", "selected", " ",
         "SPINAS", " ", "library", ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"RunExamples\"", " ", "->", " ", "True"}]],
      "InlineFormula"], " also runs three conserved physical phase-space \
points. Those examples check that the generated numerical process runs; they \
do not compare with an independent amplitude."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"SPINASDirectory\""}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "selects", " ", "the", " ",
         "SPINAS", " ", "installation", " ", "or", " ", "checkout", ".",
         " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"CMakeExecutable\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "accepts", " ", "a", " ", "full", " ",
         "CMake", " ", "path", " ", "when", " ", "automatic", " ",
         "discovery", " ", "is", " ", "unsuitable", ".", " ", "SPINAS", " ",
         "precision", " ", "must", " ", "match", " ", "the", " ", "library",
         " ", "ABI", ";", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"Precision\"", " ", "->", " ", "Automatic"}]],
      "InlineFormula"], " reads the selected build configuration. HEPCAT does \
not install or rebuild the external library."}], "Notes"],
  Cell[TextData[{"Numerical defaults come from the supplied model through ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], ". ",
     Cell[BoxData[RowBox[{"\"ParameterRules\""}]], "InlineFormula"], " \
overrides them for this export without assigning global values to the model's \
parameters. The generated mass and parameter interfaces update the process \
consistently when numerical values change."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"\"Overwrite\"", " ", "->", " ",
         "True"}]], "InlineFormula"], " permits replacing generated project \
files in an existing export directory. Keep saved calculations or hand-edited \
C++ files separately if you want to preserve them."}], "Notes"],
  Cell[TextData[{"Current complete exports are colorless tree processes with \
two incoming particles and at least two outgoing particles. Resolve auxiliary \
Xi spinors, hats, explicit color tensors and unsupported functions before \
export. Unsupported input returns ", Cell[BoxData[RowBox[{"Failure"}]],
      "InlineFormula"], " rather than a partly usable numerical process."}],
   "Notes"], Cell["Independent validation with CalcHEP or MadGraph",
   "NotesSection"], Cell[TextData[{"Independent validation compares the \
exported numerical expression with a separately generated reference amplitude \
at the same physical phase-space points. ", ButtonBox["ValidateMadGraph",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ValidateMadGraph"], " is the Mathematica entry \
point for a per-massless-helicity MadGraph comparison. A common overall \
amplitude phase is harmless because the comparisons use squared amplitudes."}]\
, "Notes"], Cell[TextData[{"For CalcHEP, supply ",
     Cell[BoxData[RowBox[{"\"CalcHEPDirectory\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"CalcHEPModel\"", " ", "->", " ", "{",
         "directory", ",", " ", "modelNumber", "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"RunCalcHEPValidation\"", " ", "->", " ",
         "True"}]], "InlineFormula"], " builds and runs the independent \
unpolarized comparison. Fixed-helicity subsets cannot be compared with an \
unpolarized CalcHEP result."}], "Notes"],
  Cell[TextData[{"For MadGraph, supply ",
     Cell[BoxData[RowBox[{"\"MadGraphDirectory\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"MadGraphModel\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"RunMadGraphValidation\"", " ", "->", " ",
         "True"}]], "InlineFormula"], " checks each requested \
massless-helicity sector while summing massive spins in each library's \
basis."}], "Notes"], Cell[TextData[{"Each reference generator must use the \
intended theory. The particle filters default to ",
     Cell[BoxData[RowBox[{"All"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{";", " ", "an", " ", "explicit", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"CalcHEPAllowedParticles\"",
         " ", "->", " ", "{", "11", ",", "22", "}"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "or", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"MadGraphAllowedParticles\"", " ", "->", " ",
         "{", "11", ",", "22", "}"}]], "InlineFormula"], " selects electrons, \
positrons and photons for a pure-QED comparison. Selecting the full Standard \
Model would also allow its other exchanges."}], "Notes"],
  Cell[TextData[{"Used masses, couplings and width prescriptions must agree \
on both sides. Parameter maps relate different names, and explicit reference \
parameter rules resolve numerical inputs when needed. Inspect the detailed \
reference report if matching is ambiguous."}], "Notes"],
  Cell[TextData[{"Automatic seeds are chosen when validation runs and are \
reported for replay. Requested mismatches, unavailable checks and evaluation \
errors return ", Cell[BoxData[RowBox[{"Failure"}]], "InlineFormula"], "; \
completing a source export or a C++ build is not reported as a successful \
independent validation."}], "Notes"],
  Cell["Running CalcHEP integration with the HEPCAT amplitude",
   "NotesSection"], Cell[TextData[{"The numerical ",
     Cell[BoxData[RowBox[{"n", "_", "calchep"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "backend", " ", "uses", " ", "CalcHEP", "'",
         "s", " ", "phase", "-", "space", " ", "integration", ",", " ",
         "menus", ",", " ", "cuts", ",", " ", "histograms", " ", "and", " ",
         "VEGAS", " ", "with", " ", "the", " ", "supplied", " ", "SPINAS",
         " ", "matrix", " ", "element", ".", " ", "It", " ", "does", " ",
         "not", " ", "ask", " ", "CalcHEP", " ", "to", " ", "generate", " ",
         "a", " ", "symbolic", " ", "reference", " ", "amplitude", ",", " ",
         "so", " ", "an", " ", "equivalent", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"CalcHEPModel"}]], "InlineFormula"],
     " is not required for this numerical backend."}], "Notes"],
  Cell[TextData[{"When the CalcHEP numerical libraries are available, the \
build places the actual executable copy at ",
     Cell[BoxData[RowBox[{"build", "/", "results", "/", "n", "_",
         "calchep"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "From", " ", "the", " ", "build", " ",
         "directory", ",", " ", "enter", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"results"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " ", "run", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", "/", "n", "_", "calchep"}]], "InlineFormula"],
     ". The directory belongs to the CMake build tree even when you configure \
an alternative build location."}], "Notes"],
  Cell[TextData[{"The numerical parameter and mass menus are connected to the \
generated process, including dependent parameter functions. The explicit \
width prescription of the supplied amplitude is retained. Unsupported \
automatic-width or gauge-restoring operations are reported."}], "Notes"],
  Cell[TextData[{"The ", Cell[BoxData[RowBox[{"results"}]], "InlineFormula"],
     " directory contains the numerical session's executable, settings and \
output. Move the complete directory elsewhere before deleting the enclosing \
build tree if you want to keep it. Installed CalcHEP and system runtime \
libraries remain required."}], "Notes"],
  Cell["Running MadEvent integration with the HEPCAT amplitude",
   "NotesSection"], Cell[TextData[{"The MadEvent backend uses the explicitly \
selected MadGraph model to obtain particle information, parameters and \
phase-space topologies. Its numerical matrix element is the supplied \
HEPCAT/SPINAS amplitude. Independent MadGraph validation remains a separate \
calculation using MadGraph's own amplitude."}], "Notes"],
  Cell[TextData[{"For a process named ", Cell[BoxData[RowBox[{"eeAA"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{",", " ", "the", " ", "build",
         " ", "writes", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"build", "/", "eeAA", "_", "madevent"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{".", " ", "Enter", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"build"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " ", "run", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", "/", "eeAA", "_", "madevent", " ", "--",
         "prepare"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "to", " ", "create", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"build", "/", "PROC", "_", "eeAA"}]],
      "InlineFormula"], ". Compiling the launcher alone does not create the \
native numerical process."}], "Notes"],
  Cell[TextData[{"The default workspace is the compiled export's build \
directory, regardless of the current shell directory. Thus ",
     Cell[BoxData[RowBox[{".", "/", "build", "/", "eeAA", "_", "madevent"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "from", " ", "the", " ",
         "exported", " ", "source", " ", "directory", " ", "still", " ",
         "uses", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"build", "/", "PROC", "_", "eeAA"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{".", " ", "Use", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"--", "work", "-", "directory",
         " ", "DIR"}]], "InlineFormula"], " to select another workspace \
explicitly. The launcher prints the card, HTML and event locations."}],
   "Notes"], Cell[TextData[{"After preparation, enter ",
     Cell[BoxData[RowBox[{"PROC", "_", "eeAA"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "and", " ", "run", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", "/", "bin", "/", "madevent"}]],
      "InlineFormula"], Cell[BoxData[RowBox[{".", " ", "Its", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"Cards", "/", "run", "_",
         "card", ".", "dat"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "controls", " ", "beams", ",", " ", "cuts",
         " ", "and", " ", "event", " ", "settings", ";", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"Cards", "/", "param", "_",
         "card", ".", "dat"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "controls", " ", "model", " ", "inputs", ".",
         " ", "The", " ", "HTML", " ", "entry", " ", "page", " ", "is",
         " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"index", ".", "html"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{",", " ", "and", " ", "generated", " ", "events",
         " ", "are", " ", "under", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"Events", "/", "run", "_", "name"}]],
      "InlineFormula"], "."}], "Notes"],
  Cell[TextData[{"The complete prepared ",
     Cell[BoxData[RowBox[{"PROC", "_", "eeAA"}]], "InlineFormula"], " \
directory contains its HEPCAT/SPINAS amplitude sources, headers, numerical \
libraries and private model support. Move that whole directory between runs \
if you want to keep it outside build. It then runs without the original \
export, build tree or SPINAS checkout. MadGraph, Python, a compatible Fortran \
toolchain and system libraries remain external requirements."}], "Notes"],
  Cell[TextData[{"Current support is colorless leading-order tree simulation. \
Fixed massless helicities are retained, massive spins are summed, and \
incoming averages and final identical-particle factors are applied once. NLO \
matching, massive polarized beams, MadSpin and coherent production-decay \
correlations require additional interfaces and are not supplied by this \
bridge."}], "Notes"], Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"SPINASDirectory\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Path to the local SPINAS checkout/library. Automatic \
searches SPINAS_ROOT and the sibling spinas checkout; an explicit directory \
selects another installation."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"IncomingLegs\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "1", ",", " ", "2", "}"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"External leg labels that are physically incoming in \
exported C++. Other legs are crossed once from HEPCAT's all-ingoing \
convention, including outgoing angle-spinor signs. Runnable projects \
currently require two incoming particles."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"FixedHelicities\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Massless leg-to-doubled-helicity rules selecting \
states in the grouped SPINAS exporter. Automatic retains the requested \
coverage; explicitly fixed incoming helicities are not averaged over, and a \
fixed outgoing helicity is a labeled contribution."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ParameterRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Local numerical parameter overrides keyed by model \
references or string names. Automatic resolves the model's variables and \
dependent functions; fitting and checks do not assign global values or \
replace parameters in the symbolic final amplitude."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ProcessName\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"\"hepcat_process\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Valid C++ identifier for the exported SPINAS class and \
executable. Choose a readable process name that does not collide with \
reserved generated members."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Precision\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Floating-point type used by exported SPINAS code. \
Automatic reads the local library build configuration; \"Double\" and \
\"LongDouble\" must match the library being linked."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Build\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to configure and compile the \
exported C++ project against the existing SPINAS library. False writes source \
files only; a source-only export does not require CMake."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RunExamples\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to build the exported SPINAS \
project and execute its sample phase-space points. True implies the necessary \
build step."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CMakeExecutable\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Path to the CMake program used when building. \
Automatic searches PATH and standard installations, including common macOS \
application and Homebrew locations."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"Overwrite\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether existing generated project \
files may be replaced. False protects an existing SPINAS output directory \
from accidental overwriting."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPDirectory\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen CalcHEP installation directory. \
None, the default, leaves the optional backend unconfigured. An explicitly \
supplied Automatic consults the corresponding environment variables only; no \
installation path is guessed."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPModel\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen equivalent CalcHEP reference \
theory as {directory, modelNumber}. None, the default, selects no theory; \
Automatic does not infer a model. This reference model is separate from the \
supplied HEPCAT amplitudes."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPAllowedParticles\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"All"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"All retains the full selected CalcHEP \
theory. A nonempty list of unique positive absolute PDG codes restricts the \
independent reference particle sector, including antiparticles. Every \
external type must be included."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RunCalcHEPValidation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether export builds and runs the \
generated independent CalcHEP comparison. It uses the same physical points on \
both implementations; unsupported polarized or color-stripped comparisons \
report unavailable. When MadGraph is also requested, its check still runs if \
CalcHEP fails. A failed requested reference returns Failure with both reports \
retained in ExportResult."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPPoints\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"1000"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Number of random physical phase-space \
points compared by the generated independent CalcHEP validation executable. \
This tests both implementations at the same points."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"CalcHEPSeed\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Default seed of the generated CalcHEP comparison. \
Automatic chooses from the time when validation runs and prints the concrete \
seed; an unsigned 64-bit integer, including zero, makes the run \
reproducible."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"ReturnDetails\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether to expose optional diagnostic \
data instead of the compact default result. For preparation and factorization \
completion it retains provenance, directions and validation and takes \
precedence over Output; for export it returns file paths and build/run \
results."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphDirectory\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen MadGraph installation directory \
for independent validation and the MadEvent numerical bridge. None, the \
default, leaves this optional support unconfigured. An explicitly supplied \
Automatic consults environment variables only; pass a path to make the \
selection explicit."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphModel\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"None"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Chosen MadGraph UFO model name or \
directory. It supplies the independent validation reference and the numerical \
MadEvent model metadata and phase-space topologies. None, the default, \
selects no theory; Automatic does not infer one. Specify the model and any \
particle filter explicitly."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphAllowedParticles\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"All"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"All retains the full selected MadGraph \
theory. A nonempty list of unique positive absolute PDG codes, such as \
{11,22}, restricts the particle sector used for reference validation and \
MadEvent topology generation and includes antiparticles. Every external \
particle type must be present."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphParameterRules\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Real numerical values for named external MadGraph UFO \
parameters. Automatic uses the supported model-parameter matching; explicit \
rules supply otherwise ambiguous independent inputs."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphParameterMap\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Rules mapping HEPCAT model parameter names to external \
or derived MadGraph UFO parameter names. Automatic uses supported same-name \
and known-model matching; unresolved used parameters prevent a passing \
comparison."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"RunMadGraphValidation\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether WriteSPINASProcess builds and \
runs the independent MadGraph comparison. False writes the optional support \
without running it; True runs a report for each exported massless-helicity \
combination. A numerical FAIL is returned as Failure, not a successful \
source-export result. If CalcHEP is also requested, both checks are attempted \
and their reports remain in ExportResult."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphPoints\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"1000"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Number of common random phase-space \
points compared for each massless-helicity combination. The default is 1000."}\
], "TableText"]}, {Cell[TextData[{Cell[BoxData[RowBox[{"\"MadGraphSeed\""}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"Automatic"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Random seed for the generated MadGraph comparison. \
Automatic chooses one time-based seed when validation runs and reports it; an \
explicit unsigned 64-bit integer, including zero, replays the samples."}],
        "TableText"]}}, GridBoxAlignment ->
      {"Columns" -> {Left, Left, Left}}, GridBoxItemSize ->
