Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ExpandComplexMomenta", "ObjectName"],
  Cell[TextData[{"Expands supported legacy complex-shift formulas with \
specified masses and companion legs."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ExpandComplexMomenta", "[", "expr",
         ",", " ", "{", "i", ",", " ", "mi", "}", ",", " ", "k", ",", " ",
         "{", "j", ",", " ", "mj", "}", ",", " ", "l", ",", " ", "mik",
         "]"}]], "InlineFormula"], "  ", "applies the implemented shift \
identities for the chosen mass pattern."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this to expand one of the particular massive or \
massless deformation cases implemented by the earlier shift machinery. The \
shifted particle pairs, their masses, companion legs and channel mass are \
mathematical input to that chosen construction."}], "Notes"],
  Cell[TextData[{"The pair arguments identify the shifted legs and their \
masses; k and l identify the companion legs used by the construction, and mik \
is the corresponding channel mass."}], "Notes"],
  Cell[TextData[{"This is a collection of specialized massive/massless cases. \
It is not a generic solver for an arbitrary complex deformation. Preserve the \
original expression and verify the assumptions when using it."}], "Notes"],
  Cell[TextData[{"For an expression without any matching shifted object, the \
input remains unchanged."}], "Notes"], Cell["Examples",
   "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Expand a scalar-product marker in the supported massive \
zero-channel case."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ExpandComplexMomenta", "[", "MomProdHat1", "[", "1",
      ",", " ", "5", "]", ",", " ", "{", "1", ",", " ", "m1", "}", ",", " ",
      "3", ",", " ", "{", "2", ",", " ", "m2", "}", ",", " ", "4", ",", " ",
      "0", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"-", InterpretationBox[
       RowBox[{SubscriptBox["p", "3"], ".", SubscriptBox["p", "5"]}],
       MomProd[3, 5], Editable -> False]}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ComplexifyMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ComplexifyMomenta"], "  \[Bullet]  ",
     ButtonBox["ReplaceSpinorZ", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReplaceSpinorZ"], "  \[Bullet]  ",
     ButtonBox["UnhatMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/UnhatMomenta"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
