Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Mandelstahm", "ObjectName"],
  Cell[TextData[{"Represents the two-particle invariant (p_i+p_j)^2."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"Mandelstahm", "[", "i", ",", " ", "j",
         "]"}]], "InlineFormula"], "  ",
     "denotes the invariant (p_i+p_j)^2."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Mandelstahm[i, j] is HEPCAT's historical spelling of a \
Mandelstam invariant. It denotes the invariant itself, not the massive \
propagator denominator: the latter is Mandelstahm[i, j]-m^2."}], "Notes"],
  Cell[TextData[{"Use ", ButtonBox["ExtractMandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractMandelstahm"],
     " to convert supported ", ButtonBox["MomProd", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomProd"], " and ",
     ButtonBox["PropDen", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PropDen"], " expressions to this notation. Supply \
the multiplicity when working beyond four particles, since complementary \
two-particle invariants coincide only in the four-point case."}], "Notes"],
  Cell[TextData[{"External momenta are all incoming. Crossing a leg therefore \
changes the momentum combination represented by an invariant; apply ",
     ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"], " to the typed \
amplitude before interpreting its physical scattering channels."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {
     "Write the invariant carried by the pair of incoming momenta p1 and p2."}\
], "ExampleText"], Cell[BoxData[RowBox[{"ExtractMandelstahm", "[", "2", " ",
      "MomProd", "[", "1", ",", " ", "3", "]", ",", " ", "5", "]"}]],
   "Input"], Cell[BoxData[RowBox[{SubscriptBox["\"s\"", "\"13\""], "-",
      SubsuperscriptBox["M", "1", "2"], "-", SubsuperscriptBox["M", "3",
       "2"]}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ExtractMandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractMandelstahm"], "  \[Bullet]  ",
     ButtonBox["MomProd", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/MomProd"], "  \[Bullet]  ",
     ButtonBox["PropDen", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PropDen"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "Mandelstahm - HEPCAT Documentation",
