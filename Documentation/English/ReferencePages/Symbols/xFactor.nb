   "AnchorBarGrid"], Cell["xFactor", "ObjectName"],
  Cell["Represents a constructive three-point x-factor.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"xFactor", "[",
         "massiveLegOrComposite", ",", " ", "masslessLegOrComposite", "]"}]],
      "InlineFormula"], "  ", "records the ordered x-factor labels."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["x-factors carry \
reference-spinor information until expanded or reduced. Modern \
diagramAmplitudes expands supported external x-factors before returning \
amplitudes.", "Notes"], Cell["For existing expressions, ExpandXFactors \
requires the diagram and model information. The older ReducexFactors utility \
uses four-point channel assumptions explicitly.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Inspect an x-factor without imposing a reference choice.",
   "ExampleText"], Cell[BoxData[RowBox[{"InputForm", "[", "xFactor", "[",
      "1", ",", " ", "3", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"InputForm", "[", "xFactor", "[", "1", ",", " ", "3",
      "]", "]"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ExpandXFactors", BaseStyle -> "Link",
