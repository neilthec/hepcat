   "AnchorBarGrid"], Cell["xFactor", "ObjectName"],
  Cell[TextData[{"Represents a constructive three-point x-factor."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"xFactor", "[",
         "massiveLegOrComposite", ",", " ", "masslessLegOrComposite", "]"}]],
      "InlineFormula"], "  ", "records the ordered massive-pair and \
massless-vector labels of the three-point building block."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"xFactor records the angle-reference three-point building \
block used when a massless vector couples to a massive pair. Its ordered \
arguments identify the associated massive and massless momentum labels."}],
   "Notes"], Cell[TextData[{"These objects can appear when reading \
constructive vertices or working through older intermediate expressions. \
Current diagram preparation normally replaces their reference-dependent \
representation as part of its amplitude workflow."}], "Notes"],
  Cell[TextData[{"Use ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"],
     " for a process-aware calculation. The older ",
     ButtonBox["ReducexFactors", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReducexFactors"], " function supports \
particular four-point channel formulas and needs that channel's information \
explicitly; it is not a general identity for every higher-point expression."}]\
, "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Inspect an x-factor without imposing a reference choice."}],
   "ExampleText"], Cell[BoxData[RowBox[{"InputForm", "[", "xFactor", "[",
      "1", ",", " ", "3", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"InputForm", "[", "xFactor", "[", "1", ",", " ", "3",
      "]", "]"}]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["xTildeFactor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/xTildeFactor"], "  \[Bullet]  ",
     ButtonBox["ReducexFactors", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReducexFactors"], "  \[Bullet]  ",
     ButtonBox["DiagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
