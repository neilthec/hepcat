   "AnchorBarGrid"], Cell["SimplifySpinorProducts", "ObjectName"],
  Cell[TextData[{"Runs the earlier iterative simplifier with explicitly \
declared external momenta and optional internal-channel information."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"SimplifySpinorProducts", "[", "expr",
         ",", " ", "opts", "]"}]], "InlineFormula"], "  ", "runs a directed \
iterative simplification with declared momenta and mass rules."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"This function is retained for calculations built around \
HEPCAT's earlier three- and four-point simplification workflow. Unlike ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"], ", it is \
supplied a list of external momenta and can use its implemented \
momentum-conservation rules."}], "Notes"],
  Cell[TextData[{"For a new general diagram calculation, prefer ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], ". That function \
keeps process information and diagram-local assumptions with their \
amplitudes, chooses references, and reports preparation progress. For algebra \
without a process or model, use ", ButtonBox["ReduceSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinorProducts"], "."}], "Notes"],
  Cell[TextData[{"The option names here are symbols, such as Momenta, \
InternalLines, InternalLineOnShell, nTimes, massReplacementRules and \
PrintWarnings. The newer preparation and identity functions instead use \
string option names. Copy the syntax of the function you are actually \
calling."}], "Notes"], Cell[TextData[{"Defaults assume Momenta->{1,2,3,4}, \
InternalLines->{1,2}, InternalLineOnShell->False and nTimes->10. Change the \
external list when it does not describe your process. \
InternalLineOnShell->True permits additional channel assumptions and must be \
confined to that individual diagram."}], "Notes"],
  Cell[TextData[{"The function can print the momentum-conservation and \
channel assumptions it uses. Inspect those assumptions before suppressing the \
messages with PrintWarnings->False."}], "Notes"],
  Cell["Options", "NotesSection"],
  Cell[BoxData[GridBox[{{Cell["Option", "TableHeader"],
       Cell["Default", "TableHeader"], Cell["Meaning", "TableHeader"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"Momenta"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[
         {Cell[BoxData[RowBox[{"{", "1", ",", " ", "2", ",", " ", "3", ",",
              " ", "4", "}"}]], "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Complete external momentum labels available to the \
older simplification or x-factor helper. This is a legacy symbol option; the \
list supplies the context needed for momentum-conservation identities."}],
        "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"InternalLines"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "1", ",", " ", "2", "}"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"External labels composing the internal line used by \
the older SimplifySpinorProducts helper. It matters only when the \
corresponding internal-shell reductions are enabled and its mass rules are \
supplied."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"InternalLineOnShell"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"False"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether the older \
SimplifySpinorProducts helper may additionally use the stated InternalLines \
shell. False is the default; ordinary ReduceSpinorProducts does not acquire \
an internal-shell assumption."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"nTimes"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{Cell[BoxData[RowBox[{"10"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{"Maximum number of repeated simplification rounds in \
the older SimplifySpinorProducts helper. This is a legacy symbol option, not \
a wall-clock limit."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"massReplacementRules"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Explicit Mass[...] replacement rules \
for the older SimplifySpinorProducts helper. Supply only assumptions \
justified for the current item; do not combine incompatible diagram-local \
shells."}], "TableText"]},
      {Cell[TextData[{Cell[BoxData[RowBox[{"PrintWarnings"}]],
           "InlineFormula"]}], "TableText"],
       Cell[TextData[{Cell[BoxData[RowBox[{"True"}]], "InlineFormula"]}],
        "TableText"], Cell[TextData[{"Whether the older \
SimplifySpinorProducts helper prints warnings about its iterative \
simplification. This legacy symbol option affects messages rather than the \
allowed physical assumptions."}], "TableText"]}}, GridBoxAlignment ->
      {"Columns" -> {Left, Left, Left}}, GridBoxItemSize ->
      {"Columns" -> {Scaled[0.23], Scaled[0.19], Scaled[0.58]}},
     GridBoxDividers -> {"Rows" -> {False, True, {False}, False}}]],
   "3ColumnTableMod"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
