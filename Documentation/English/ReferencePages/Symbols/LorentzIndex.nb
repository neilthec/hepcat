Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/FeynmanAmplitudes"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["LorentzIndex", "ObjectName"],
  Cell[TextData[
    {"Labels a Lorentz index in a Feynman vertex or diagram expression."}],
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzIndex", "[", "slot", "]"}]],
      "InlineFormula"], "  ", "labels a Lorentz slot in a Feynman tensor."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzIndex", "[", "slot", "]"}]],
      "InlineFormula"], " names a Lorentz slot of a vertex. You will see it \
in parsed rules containing ", ButtonBox["LorentzMetric", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMetric"], ", ",
     ButtonBox["LorentzMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMomentum"], " or ",
     ButtonBox["DiracGamma", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracGamma"], ". Diagram generation \
attaches these local vertex slots to the incident lines."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"LorentzIndex", "[", "slot", ",", "2",
         "]"}]], "InlineFormula"], " names a second slot of a tensor \
auxiliary field. The second argument distinguishes two indices carried by the \
same field; it does not refer to a second external particle."}], "Notes"],
  Cell[TextData[{"For a complete scalar amplitude, every Lorentz contraction \
label must occur exactly twice in each term. ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " checks \
this condition. A free index usually means that the supplied expression is \
still a current or tensor, rather than a complete amplitude."}], "Notes"],
  Cell[TextData[{"You normally inspect these labels while following a raw \
diagram. There is no need to assign them values or sum numerical components \
by hand."}], "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Name the two metric slots of a local Feynman vertex."}],
   "ExampleText"], Cell[BoxData[RowBox[{"LorentzMetric", "[", "LorentzIndex",
      "[", "1", "]", ",", " ", "LorentzIndex", "[", "2", "]", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"LorentzMetric", "[", "LorentzIndex", "[",
      "1", "]", ",", " ", "LorentzIndex", "[", "2", "]", "]"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["LorentzMetric", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMetric"], "  \[Bullet]  ",
     ButtonBox["LorentzMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LorentzMomentum"], "  \[Bullet]  ",
     ButtonBox["DiracGamma", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiracGamma"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}],
   "MoreAbout"]}, WindowTitle -> "LorentzIndex - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/ref/LorentzIndex", "title" -> "LorentzIndex",
     "type" -> "Symbol", "label" -> "HEPCAT Symbol", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" ->
      "Labels a Lorentz index in a Feynman vertex or diagram expression.",
     "keywords" -> {"HEPCAT", "LorentzIndex", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]