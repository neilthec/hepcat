   "AnchorBarGrid"], Cell["FermionKet", "ObjectName"],
  Cell["Represents the right fermion endpoint of an ordered Dirac chain.",
   "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FermionKet", "[", "leg", ",", " ",
         "mass", ",", " ", "chirality", "]"}]], "InlineFormula"], "  ",
     "represents the right fermion endpoint of an ordered Dirac chain."}],
   "Usage"], Cell["Details", "NotesSection"], Cell["The endpoint uses an \
all-incoming external-leg label and its external mass.", "Notes"],
  Cell["The normal Dirac tag is \"Dirac\". Massive spin states are retained \
as spinor indices, not fixed by a chirality string.", "Notes"],
  Cell["HEPCAT conversion uses u = (-|p>,|p]). Massless Dirac external fields \
need an explicit helicity assignment for conversion.", "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Basic Examples", "ExampleSection"],
  Cell["Construct the symbolic object.", "ExampleText"],
  Cell[BoxData[RowBox[{"DiracChain", "[", "FermionBar", "[", "1", ",", " ",
      "m", ",", " ", "\"Dirac\"", "]", ",", " ", "DiracWord", "[",
      "DiracSlash", "[", "Mom", "[", "3", "]", "]", "]", ",", " ",
      "FermionKet", "[", "2", ",", " ", "m", ",", " ", "\"Dirac\"", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracChain", "[",
      RowBox[{RowBox[{"FermionBar", "[", RowBox[{"1", ",", "m", ",",
