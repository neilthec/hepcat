   "AnchorBarGrid"], Cell["FermionKet", "ObjectName"],
  Cell[TextData[
    {
     "Records the right fermion wavefunction of an all-incoming Dirac chain."}\
], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FermionKet", "[", "leg", ",", " ",
         "mass", ",", " ", "chirality", "]"}]], "InlineFormula"], "  ",
     "represents the right fermion endpoint of an ordered Dirac chain."}],
   "Usage"], Cell["Details", "NotesSection"],
  Cell[TextData[{Cell[BoxData[RowBox[{"FermionKet", "[", "leg", ",", "mass",
         ",", "chirality", "]"}]], "InlineFormula"],
     " is the right endpoint of a ", ButtonBox["DiracChain",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/DiracChain"],
     ". The external-leg label and mass have the same meaning as in ",
     ButtonBox["FermionBar", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FermionBar"], "."}], "Notes"],
  Cell[TextData[{"For a massive Dirac field, use the tag ",
     Cell[BoxData[RowBox[{"\"Dirac\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "The", " ", "resulting", " ", "spinor",
         " ", "expression", " ", "retains", " ", "the", " ", "external", " ",
         "massive", " ", "spin", " ", "index", ".", " ", "The", " ", "tags",
         " "}]], "InlineFormula"], Cell[BoxData[RowBox[{"\"L\""}]],
      "InlineFormula"], Cell[BoxData[RowBox[{" ", "and", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"\"R\""}]], "InlineFormula"], " \
select model field components rather than a numerical massive spin \
projection."}], "Notes"],
  Cell[TextData[{ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " uses ",
     Cell[BoxData[RowBox[{"u", " ", "=", " ", "(", "-", "|", "p", ">", ",",
         "|", "p", "]", ")"}]], "InlineFormula"], " for this all-incoming \
endpoint. Its relative component sign is therefore fixed by HEPCAT's \
conventions."}], "Notes"], Cell[TextData[{"A massless endpoint with tag ",
     Cell[BoxData[RowBox[{"\"Dirac\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "needs", " ", "a", " ", "helicity", " ",
         "assignment", " ", "before", " ", "conversion", ".", " ", "Supply",
         " ", "a", " ", "rule", " ", "such", " ", "as", " "}]],
      "InlineFormula"], Cell[BoxData[RowBox[{"1", " ", "->", " ", "-", "1",
         "/", "2"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "through", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"FermionHelicities\""}]], "InlineFormula"],
     ". This option uses physical half-integer helicities."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {
     "Place a momentum slash between the two external fermion wavefunctions."}\
], "ExampleText"], Cell[BoxData[RowBox[{"DiracChain", "[", "FermionBar", "[",
      "1", ",", " ", "m", ",", " ", "\"Dirac\"", "]", ",", " ", "DiracWord",
      "[", "DiracSlash", "[", "Mom", "[", "3", "]", "]", "]", ",", " ",
      "FermionKet", "[", "2", ",", " ", "m", ",", " ", "\"Dirac\"", "]",
      "]"}]], "Input"],
  Cell[BoxData[RowBox[{"DiracChain", "[",
      RowBox[{RowBox[{"FermionBar", "[", RowBox[{"1", ",", "m", ",",
            "\"Dirac\""}], "]"}], ",", RowBox[{"DiracWord", "[",
          RowBox[{"DiracSlash", "[", SubscriptBox["p", "3"], "]"}], "]"}],
        ",", RowBox[{"FermionKet", "[", RowBox[{"2", ",", "m", ",",
            "\"Dirac\""}], "]"}]}], "]"}]], "Output"],
  Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["FermionBar", BaseStyle -> "Link",
