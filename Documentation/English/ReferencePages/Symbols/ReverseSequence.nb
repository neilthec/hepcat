  Cell[TextData[{Cell[BoxData[RowBox[{"ReverseSequence", "[", "a1", ",", " ",
         "a2", ",", " ", "...", ",", " ", "an", "]"}]], "InlineFormula"],
     "  ", "returns the arguments in reverse sequence order."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["Unlike Reverse[{a,b,c}], this helper \
removes the intermediate List wrapper. Its result is intended to splice into \
the arguments of another head.", "Notes"], Cell["For general Mathematica list \
manipulation, prefer Reverse; this helper is useful when constructing a \
reversed spinor-chain argument sequence.", "Notes"],
