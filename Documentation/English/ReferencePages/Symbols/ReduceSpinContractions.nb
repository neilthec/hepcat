   "AnchorBarGrid"], Cell["ReduceSpinContractions", "ObjectName"],
  Cell[TextData[{"Contracts repeated spin indices and joins the associated \
spinor factors into momentum chains."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReduceSpinContractions", "[", "expr",
         "]"}]], "InlineFormula"], "  ", "applies supported spin-sum and \
little-group contraction identities."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"Use this after sewing lower-point amplitudes or forming \
products that contain contracted massive or massless spinors. The function \
applies the supported spin sums and little-group epsilon contractions, \
replacing those index contractions by shorter typed spinor chains."}],
   "Notes"], Cell[TextData[{"This is the usual first algebraic step for a \
diagram amplitude. The result may still contain several momentum insertions \
and reducible brackets; follow it with ", ButtonBox["ReduceSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     " for ordinary spinor identities."}], "Notes"],
  Cell[TextData[{"The function does not choose reference spinors, generate \
factorization channels, or impose a diagram's internal-shell conditions. ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " coordinates \
those preparation steps using the model and each item's declared mass rules."}\
], "Notes"], Cell[TextData[{"A repeated spin index has a mathematical \
contraction meaning. Keep external spin indices distinct until you intend to \
sum them, or choose a definite component with ", ButtonBox["ChooseSpinIndex",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ChooseSpinIndex"], "."}], "Notes"],
  Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[{"Sew massless spinors through leg 3."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceSpinContractions", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"", ",", " ", "1", "]",
      ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",",
      " ", "3", "]", "]", " ", "SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "3", "]", ",", " ",
      "Spinor", "[", "\"Spin\"", ",", " ", "\"Square\"", ",", " ", "4", "]",
      "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[TemplateBox[
      {TemplateBox[{"\"\[LeftAngleBracket]\"", StyleBox["1", Bold,
          StripOnInput -> False]}, "RowDefault"], "3",
       TemplateBox[{StyleBox["4", Bold, StripOnInput -> False], "\"]\""},
