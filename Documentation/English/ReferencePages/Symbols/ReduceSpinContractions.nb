  Cell["Sews contracted massive or massless spinor indices into shorter \
momentum chains.", "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ReduceSpinContractions", "[", "expr",
         "]"}]], "InlineFormula"], "  ", "applies supported spin-sum and \
little-group contraction identities."}], "Usage"],
  Cell["Details", "NotesSection"], Cell["Apply this to diagram products \
before ordinary spinor reduction. Matching repeated upper and lower massive \
indices are contracted with HEPCAT's epsilon and completeness conventions.",
   "Notes"], Cell["Massless completeness also joins a pair of chains through \
a matching helicity leg. Powers and spectator factors are supported.",
   "Notes"], Cell["This function contracts indices already present in the \
expression. It does not average initial spins, add symmetry factors, or \
choose a process.", "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
