Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT SYMBOL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}],
        "AnchorBar"]}}, GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["ChooseSpinIndices", "ObjectName"],
  Cell[TextData[{"Selects physical spin projections for successive massive \
external particles."}], "Notes"],
  Cell[TextData[{Cell[BoxData[RowBox[{"ChooseSpinIndices", "[", "expr", ",",
         " ", "projection1", ",", " ", "projection2", ",", " ", "...",
         "]"}]], "InlineFormula"], "  ", "applies ChooseSpinIndex to legs \
1,2,... with the corresponding projections."}], "Usage"],
  Cell["Details", "NotesSection"],
  Cell[TextData[{"The projection arguments correspond to external legs 1, 2, \
and so on. The function applies ", ButtonBox["ChooseSpinIndex",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ChooseSpinIndex"], " in that order, using the \
physical projections rather than doubled-spin C++ labels."}], "Notes"],
  Cell[TextData[{"Use this when the desired spin configuration is most \
naturally written in external-particle order. To select only one particular \
leg, call ", ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"],
     " directly so the intended particle number is explicit."}], "Notes"],
  Cell[TextData[{"The resulting expression is one selected spin \
configuration. Summing or averaging the squared amplitudes over a set of \
configurations remains a separate operation; ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"],
     " supplies that numerical interface for complete exported processes."}],
   "Notes"], Cell["Examples", "PrimaryExamplesSection"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Basic Examples", "ExampleSection"],
  Cell[TextData[
    {"Choose spin-half projections for both massive endpoints."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ChooseSpinIndices", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Spin\"", ",", " ", "\"Angle\"",
      ",", " ", "1", "]", ",", " ", "Spinor", "[", "\"Spin\"", ",", " ",
      "\"Angle\"", ",", " ", "2", "]", "]", ",", " ", "1", "/", "2", ",",
      " ", "-", "1", "/", "2", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", TemplateBox[
           {StyleBox["1", Bold, StripOnInput -> False], FractionBox["1",
             "2"]}, "Superscript", SyntaxForm -> SuperscriptBox]},
         "RowDefault"], TemplateBox[{TemplateBox[{StyleBox["2", Bold,
             StripOnInput -> False], RowBox[{"-", FractionBox["1", "2"]}]},
           "Superscript", SyntaxForm -> SuperscriptBox],
          "\"\[RightAngleBracket]\""}, "RowDefault"]}, "RowDefault"],
      ShowStringCharacters -> False], SpinorChain[Spinor["Spin", "Upper",
       "Angle", 1, 1/2], Spinor["Spin", "Upper", "Angle", 2, -2^(-1)]],
     Editable -> False]], "Output"], Cell["See Also", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
