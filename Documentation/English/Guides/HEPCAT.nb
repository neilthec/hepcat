Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT GUIDE", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"],
  Cell["HEPCAT: High Energy Physics Constructive Amplitude Tool",
   "GuideTitle"], Cell[TextData[{"Build, simplify, complete and validate \
scattering amplitudes with explicit spinor identities."}], "GuideAbstract"],
  Cell[TextData[{"HEPCAT helps you derive scattering amplitudes using spinor \
identities, constructive diagrams and factorization. You can start with an \
expression you already have, work through individual diagrams, or ask ",
     ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], " to carry out \
the supported construction workflow. If this is your first visit, begin with \
", ButtonBox["Getting Started", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/tutorial/GettingStarted"], "."}],
   "GuideAbstract"], Cell[TextData[{"A process is an ordered list such as ",
     Cell[BoxData[RowBox[{"{", "\"e\"", ",", " ", "\"E\"", ",", " ",
         "\"A.+\"", ",", " ", "\"A.+\"", "}"}]], "InlineFormula"], ". The \
positions in that list give the particle labels in the resulting formula. All \
analytic momenta are incoming. You choose the physical incoming and outgoing \
states later, when exporting a numerical process."}], "GuideAbstract"],
  Cell[TextData[{"The model is an explicit input to each calculation. ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], " loads particle \
properties, interactions and numerical parameter values into one model \
object. A diagram model contains the elementary interactions. A factorization \
model must also contain the complete lower-point amplitudes needed to test \
the process you are constructing. Keeping these two roles distinct is \
particularly important above four points."}], "GuideAbstract"],
  Cell[TextData[{"For a guided calculation, generate diagrams with ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"],
     ", convert them with ", ButtonBox["DiagramAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/DiagramAmplitudes"], ", and simplify them with ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], ". ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], " and ",
     ButtonBox["CompleteHighEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteHighEnergy"],
     " then try to repair the remaining discrepancies. The ",
     ButtonBox["staged construction tutorial", BaseStyle -> "Link",
      ButtonData ->
       "paclet:HEPCAT/tutorial/ConstructingAndCheckingAnAmplitude"],
     " explains what each step receives and returns."}], "GuideAbstract"],
  Cell[TextData[{"Use ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], " to inspect a \
proposed result. Its report separates physical residues, apparent spurious \
poles, high-energy behavior and explicit reference-spinor dependence. A \
numerical PASS is evidence from the tested configurations; an unresolved \
check remains visible. For a finished symbolic result, ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], " creates \
numerical C++ code and can connect it to independent CalcHEP and MadGraph \
checks."}], "GuideAbstract"], Cell["Start Here", "GuideFunctionsSubsection"],
  Cell[TextData[
    {"A short first calculation and the notation used throughout HEPCAT."}],
   "GuideText"], Cell[TextData[{ButtonBox["Getting Started with HEPCAT",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/GettingStarted"], "  \[Bullet]  ",
     ButtonBox["Constructing and Checking an Amplitude in Stages",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ConstructingAndCheckingAnAmplitude"]}],
   "GuideTutorial"], Cell["Models, Diagrams and Construction",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["Diagrams and Factorization Channels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/DiagramsAndFactorization"],
     "  \[Bullet]  ", ButtonBox["Constructing and Completing Amplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/AmplitudeConstruction"]}], "GuideMoreAbout"],
  Cell["Spinors and Exact Identities", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["Identities and Simplification", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/IdentitiesAndSimplification"]}],
   "GuideMoreAbout"],
  Cell[TextData[{ButtonBox["Applying Spinor Identities in a Derivation",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ApplyingSpinorIdentities"], "  \[Bullet]  ",
     ButtonBox["Kinematics, References and On-Shell Conditions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/KinematicsAndOnShellConditions"]}],
   "GuideTutorial"], Cell["Check and Compare Results",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["Checking Amplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/AmplitudeValidation"],
     "  \[Bullet]  ", ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"]}], "GuideMoreAbout"],
  Cell[TextData[
    {ButtonBox["Comparing a Constructive Result with Feynman Diagrams",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/FeynmanComparison"]}], "GuideTutorial"],
  Cell["Display, Save and Run Numerical Code", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FormattingAndExport"]}], "GuideMoreAbout"],
  Cell[TextData[{ButtonBox["Exporting a Numerical SPINAS Process",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ExportingToSPINAS"]}], "GuideTutorial"],
  Cell["Browse the Package", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["HEPCAT Reference Index", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/ReferenceIndex"]}],
   "GuideMoreAbout"]}, WindowTitle -> "HEPCAT: High Energy Physics \
Constructive Amplitude Tool - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/guide/HEPCAT", "title" ->
      "HEPCAT: High Energy Physics Constructive Amplitude Tool",
     "type" -> "Guide", "label" -> "HEPCAT Guide", "paclet" -> "HEPCAT",
