Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT GUIDE", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Constructing and Completing Amplitudes",
   "GuideTitle"], Cell[TextData[{"Prepare diagram seeds, solve factorization \
constraints and complete allowed high-energy behavior."}], "GuideAbstract"],
  Cell[TextData[{ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], " is the normal \
starting point when you want a complete supported amplitude rather than an \
isolated symbolic reduction. Give it the ordered process, an interaction \
model for diagrams and a model containing the known lower-point amplitudes \
for factorization. It reports the stage being performed and the elapsed \
time."}], "GuideAbstract"],
  Cell[TextData[{"The stages are also available separately. ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"],
     " simplifies the starting diagram expressions. ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"],
     " tries corrections constrained by the physical channel residues. ",
     ButtonBox["CompleteHighEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteHighEnergy"], " uses the \
remaining allowed freedom to address the high-energy conditions while \
retaining the other constraints."}], "GuideAbstract"],
  Cell[TextData[
    {"For an ordinary calculation, start with the defaults, including ",
     Cell[BoxData[RowBox[{"\"PolePreference\"", " ", "->", " ",
         "\"AllPhysical\""}]], "InlineFormula"],
     Cell[BoxData[RowBox[{".", " ", "Set", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"PolePreference\"", " ", "->", " ",
         "\"AllSpurious\""}]], "InlineFormula"], " or another supported \
choice when you want a different representation preference. The final checks \
still decide whether the proposed result is acceptable. A clock, an \
insufficient correction space or an unresolved comparison can prevent \
completion, and the function reports that rather than returning an unchecked \
result as a success. Successful output includes the final ",
     ButtonBox["SpinorExpressionComplexity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorExpressionComplexity"],
     " score with its timing and checks."}], "GuideAbstract"],
  Cell[TextData[{"If you supply an independent ",
     Cell[BoxData[RowBox[{"\"FeynmanModel\""}]], "InlineFormula"], ", ",
     ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], " can validate \
one fixed constructive representative even when proving every remaining \
affine-family identity is unfinished. All standard checks and the Feynman \
comparison must pass at the normal validation parameter assignments. The \
benchmark does not supply the answer or fit its coefficients. Details retain \
the family and state that uniqueness has not been established; direct ",
     ButtonBox["CompleteHighEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteHighEnergy"],
     " calls keep their strict completion semantics."}], "GuideAbstract"],
  Cell[TextData[{"If a construction fails, repeat the relevant stage with its \
detailed output and inspect the failing channels or unresolved checks. The ",
     ButtonBox["staged tutorial", BaseStyle -> "Link",
      ButtonData ->
       "paclet:HEPCAT/tutorial/ConstructingAndCheckingAnAmplitude"], " \
provides a calculation you can follow without hiding the intermediate \
amplitudes."}], "GuideAbstract"], Cell["Normal Workflow",
   "GuideFunctionsSubsection"],
  Cell[TextData[{"Use the wrapper for a complete calculation, or the \
individual stages when you want to inspect each result."}], "GuideText"],
  Cell[TextData[{ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], ": ", "Construct \
and check an amplitude from its external process and the models supplying its \
interactions and known lower-point amplitudes."}], "GuideText"],
  Cell[TextData[{ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], ": ", "Simplify \
diagram expressions, factorization channels or a completed amplitude before \
the next calculation stage."}], "GuideText"],
  Cell[TextData[{ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], ": ", "Add \
corrections that make a candidate amplitude reproduce all supplied physical \
factorization channels together."}], "GuideText"],
  Cell[TextData[{ButtonBox["CompleteHighEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteHighEnergy"], ": ", "Use \
high-energy and other full-amplitude conditions to fix freedom left after \
physical factorization."}], "GuideText"],
  Cell[TextData[{ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], ": ", "Check a \
proposed amplitude against physical factorization, spurious-pole, high-energy \
and reference-spinor conditions."}], "GuideText"],
  Cell["Inputs and Diagnostics", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], ": ", "Generate the \
tree diagrams allowed by a model for an ordered external process."}],
   "GuideText"], Cell[TextData[{ButtonBox["DiagramAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/DiagramAmplitudes"], ": ", "Obtain a symbolic \
amplitude expression and its mass replacements for each generated diagram."}]\
, "GuideText"], Cell[TextData[{ButtonBox["FactorizationAmplitudeChannels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ": ", "Build the \
known lower-point amplitude products that a full amplitude must reproduce at \
its physical poles."}], "GuideText"],
  Cell[TextData[{ButtonBox["DiagramAmplitudeRecords", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudeRecords"], ": ", "Insp\
ect the expression, propagators and assumptions associated with each \
diagram."}], "GuideText"],
  Cell[TextData[{ButtonBox["PhysicalPoleResidue", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PhysicalPoleResidue"], ": ", "Extract \
the coefficient of one physical propagator pole, or of compatible \
simultaneous poles."}], "GuideText"], Cell["Tutorials",
   "GuideTutorialsSection"],
  Cell[TextData[
    {ButtonBox["Constructing and Checking an Amplitude in Stages",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ConstructingAndCheckingAnAmplitude"],
     "  \[Bullet]  ", ButtonBox[
      "Kinematics, References and On-Shell Conditions", BaseStyle -> "Link",
      ButtonData ->
       "paclet:HEPCAT/tutorial/KinematicsAndOnShellConditions"]}],
   "GuideTutorial"]}, WindowTitle ->
  "Constructing and Completing Amplitudes - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
