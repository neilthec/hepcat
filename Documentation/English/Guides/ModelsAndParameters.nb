Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT GUIDE", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Models and Model-Local Parameters", "GuideTitle"],
  Cell[TextData[
    {"Read model tables, retrieve known amplitudes and save new results."}],
   "GuideAbstract"],
  Cell[TextData[{"Use ", ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], " as the entry point for \
a model directory. It reads the related model tables together, resolves their \
parameter names consistently, and returns an object that you pass to \
subsequent functions. The component-file readers are implementation details \
of that operation."}], "GuideAbstract"],
  Cell[TextData[{"You can keep several models in one Mathematica session. A \
parameter such as the electron mass belongs to its model; loading a second \
model does not overwrite a global electron-mass value. ",
     ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], ", ",
     ButtonBox["ModelFunction", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelFunction"], " and ",
     ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], " let you \
inspect those symbolic quantities and their numerical assignments."}],
   "GuideAbstract"], Cell[TextData[{"The distinction between an interaction \
and a complete amplitude matters. Use elementary interactions for ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"],
     ". Use complete known amplitudes for ",
     ButtonBox["FactorizationAmplitudeChannels", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ". \
For example, a five-point factorization channel can require a known \
four-point amplitude, even though the five-point diagrams are built from \
three-point vertices."}], "GuideAbstract"],
  Cell[TextData[{"After obtaining and checking a new result, ",
     ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"], " can write \
it to the factorization model for a later higher-point calculation. Check the \
particle order, helicities and overall sign before saving. ",
     ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"],
     " retrieves a stored expression for inspection or export."}],
   "GuideAbstract"], Cell["Read and Inspect Models",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], ": ", "Load the particle \
content, amplitudes and parameters of a model for use throughout HEPCAT."}],
   "GuideText"], Cell[TextData[{ButtonBox["ParticleMass",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ParticleMass"],
     ": ", "Find the mass declared for a particle or antiparticle."}],
   "GuideText"], Cell[TextData[{ButtonBox["FeynmanModel",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"],
     ": ", "Represents a model of particles and Feynman-rule vertices read \
from CalcHEP model tables."}], "GuideText"],
  Cell["Parameters Stay with Their Model", "GuideFunctionsSubsection"],
  Cell[TextData[{"Inspect or override numerical assignments without replacing \
symbolic masses and couplings throughout the notebook."}], "GuideText"],
  Cell[TextData[{ButtonBox["ModelParameter", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameter"], ": ", "Refer to a \
mass, coupling or other parameter belonging to a particular model."}],
   "GuideText"], Cell[TextData[{ButtonBox["ModelFunction",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/ModelFunction"],
     ": ", "Keep a model-supplied external function as symbolic data."}],
   "GuideText"], Cell[TextData[{ButtonBox["ModelParameterName",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ModelParameterName"], ": ",
     "Return the string name of a model-local parameter."}], "GuideText"],
  Cell[TextData[{ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"], ": ", "Obtain \
numerical parameter substitutions while keeping model definitions local."}],
   "GuideText"], Cell["Known Amplitudes and Text Input",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"], ": ", "Retrieve a \
stored lower-point amplitude with a specified particle numbering."}],
   "GuideText"], Cell[TextData[{ButtonBox["ConvertStringAmplitude",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ConvertStringAmplitude"], ": ", "Reads a compact \
spinor-bracket string and constructs a typed HEPCAT expression."}],
   "GuideText"], Cell[TextData[{ButtonBox["ConvertStringHattedAmplitude",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ConvertStringHattedAmplitude"], ": ", "Parses a \
legacy bracket expression and marks its spinors and momenta as shifted."}],
   "GuideText"], Cell["Extend a Factorization Model",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"], ": ", "Add \
established amplitude expressions to a constructive model for later \
factorization calculations."}], "GuideText"],
  Cell["Tutorials", "GuideTutorialsSection"],
  Cell[TextData[{ButtonBox["Getting Started with HEPCAT",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/GettingStarted"], "  \[Bullet]  ",
     ButtonBox["Constructing and Checking an Amplitude in Stages",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ConstructingAndCheckingAnAmplitude"]}],
   "GuideTutorial"]}, WindowTitle ->
  "Models and Model-Local Parameters - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/guide/ModelsAndParameters",
     "title" -> "Models and Model-Local Parameters", "type" -> "Guide",
     "label" -> "HEPCAT Guide", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" ->
      "Read model tables, retrieve known amplitudes and save new results.",
     "keywords" -> {"HEPCAT", "ModelsAndParameters", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]