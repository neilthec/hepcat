Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT GUIDE", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Formatting, Model Output and SPINAS Export",
   "GuideTitle"],
  Cell[TextData[
    {"Display analytic expressions and write numerical C++ processes."}],
   "GuideAbstract"], Cell[TextData[{"Choose an output tool according to what \
you want to do with the expression. ", ButtonBox["PlainText",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/PlainText"], " \
gives a readable text representation, including a model-file form for \
supported exact expressions. ", ButtonBox["TeX", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/TeX"],
     " writes mathematical LaTeX notation. ", ButtonBox["SPINAS",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/SPINAS"],
     " is the older expression-level C++ formatter."}], "GuideAbstract"],
  Cell[TextData[{"For a complete numerical process, use ",
     ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], ". It writes the \
process class, spin/helicity interface, build files, examples and optional \
validation backends together. Supply all analytic massless-helicity sectors \
needed by the physical process, or explicitly select the helicities that you \
want to retain."}], "GuideAbstract"],
  Cell[TextData[{"Analytic expressions use all incoming momenta. The \
numerical exporter needs an explicit physical incoming-to-outgoing process, \
so it can cross the outgoing momenta and angle spinors exactly once. Do not \
manually cross a formula and then give it to an exporter that will cross it \
again."}], "GuideAbstract"],
  Cell[TextData[{"The ", ButtonBox["SPINAS export tutorial",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ExportingToSPINAS"], " covers source \
generation, compiling, independent comparisons and numerical event \
generation. Generated run directories live under the build directory by \
default. To store a new symbolic result for later factorization, use ",
     ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"],
     " rather than copying C++ output into a model file."}],
   "GuideAbstract"], Cell["Readable Analytic Output",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"], ": ", "Converts a spinor \
expression to readable bracket text or exact model-file syntax."}],
   "GuideText"], Cell[TextData[{ButtonBox["TeX", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/TeX"], ": ",
     "Converts supported HEPCAT spinor expressions to a LaTeX string."}],
   "GuideText"], Cell["Save Model Amplitudes", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"], ": ", "Add \
established amplitude expressions to a constructive model for later \
factorization calculations."}], "GuideText"],
  Cell[TextData[{ButtonBox["ConvertStringAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConvertStringAmplitude"], ": ", "Reads \
a compact spinor-bracket string and constructs a typed HEPCAT expression."}],
   "GuideText"], Cell["Complete Numerical Process",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], ": ", "Writes a \
runnable SPINAS C++ process from a spinor amplitude or a complete set of its \
helicity amplitudes."}], "GuideText"],
  Cell[TextData[{ButtonBox["ValidateMadGraph", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ValidateMadGraph"], ": ", "Checks a \
HEPCAT/SPINAS amplitude against an independently generated MadGraph result at \
common random physical momenta."}], "GuideText"],
  Cell["Lower-Level SPINAS Formatting", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["SPINAS", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SPINAS"], ": ", "Converts supported \
chains and algebra to the earlier SPINAS C++ expression notation."}],
   "GuideText"], Cell["More Functions and Symbols",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["ConvertStringHattedAmplitude",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ConvertStringHattedAmplitude"], ": ", "Parses a \
legacy bracket expression and marks its spinors and momenta as shifted."}],
   "GuideText"], Cell["Tutorials", "GuideTutorialsSection"],
  Cell[TextData[{ButtonBox["Exporting a Numerical SPINAS Process",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ExportingToSPINAS"]}], "GuideTutorial"]},
 WindowTitle ->
  "Formatting, Model Output and SPINAS Export - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/guide/FormattingAndExport",
     "title" -> "Formatting, Model Output and SPINAS Export",
     "type" -> "Guide", "label" -> "HEPCAT Guide", "paclet" -> "HEPCAT",
     "language" -> "en", "summary" ->
      "Display analytic expressions and write numerical C++ processes.",
     "keywords" -> {"HEPCAT", "FormattingAndExport", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]