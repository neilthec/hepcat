Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT GUIDE", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Diagrams and Factorization Channels",
   "GuideTitle"],
  Cell[TextData[
    {"Generate diagrams and physical channel expressions from model data."}],
   "GuideAbstract"], Cell[TextData[{"Diagrams and factorization channels \
describe the same process in different ways. ", ButtonBox["CreateDiagrams",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"],
     " enumerates the tree diagrams allowed by the supplied interaction \
model. ", ButtonBox["CreateArrowDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateArrowDiagrams"],
     " shows their topology and particle flow, and ",
     ButtonBox["DiagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudes"],
     " converts the complete list to algebraic expressions."}],
   "GuideAbstract"], Cell[TextData[{"The amplitude converter returns one ",
     Cell[BoxData[RowBox[{"{", "massRules", ",", " ", "expression", "}"}]],
      "InlineFormula"], " pair for each diagram. The mass rules identify the \
known external masses and the internal channels associated with that \
particular constructive diagram. Keep each pair together until preparation is \
complete. Summing the expressions first would lose the association between a \
numerator and its allowed internal on-shell conditions."}], "GuideAbstract"],
  Cell[TextData[{ButtonBox["FactorizationAmplitudeChannels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], " instead starts \
from complete known lower-point amplitudes. Each returned channel identifies \
the momentum that goes on shell and gives the sewn product divided by its \
propagator denominator. Those channel expressions are the targets for ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], " and ",
     ButtonBox["CompleteFactorization", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CompleteFactorization"], "."}],
   "GuideAbstract"], Cell[TextData[{"For a Feynman model, the same diagram \
entry points return ordinary off-shell internal tensors. ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " converts \
supported tensors to the spinor notation. This provides an independent \
comparison rather than a new source of constructive internal-shell \
assumptions."}], "GuideAbstract"], Cell["Diagrams and Pictures",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"], ": ", "Generate the \
tree diagrams allowed by a model for an ordered external process."}],
   "GuideText"], Cell[TextData[{ButtonBox["CreateArrowDiagram",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/CreateArrowDiagram"], ": ", "Draw one tree diagram \
and optionally inspect its vertex and propagator expressions."}],
   "GuideText"], Cell[TextData[{ButtonBox["CreateArrowDiagrams",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/CreateArrowDiagrams"], ": ",
     "Draw all the diagrams generated for a process."}], "GuideText"],
  Cell[TextData[{ButtonBox["DiagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudes"], ": ", "Obtain a \
symbolic amplitude expression and its mass replacements for each generated \
diagram."}], "GuideText"],
  Cell[TextData[{ButtonBox["DiagramAmplitudeRecords", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudeRecords"], ": ", "Insp\
ect the expression, propagators and assumptions associated with each \
diagram."}], "GuideText"], Cell["Channels and Residues",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["FactorizationAmplitudeChannels",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/FactorizationAmplitudeChannels"], ": ", "Build the \
known lower-point amplitude products that a full amplitude must reproduce at \
its physical poles."}], "GuideText"],
  Cell[TextData[{ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"], ": ", "Retrieve a \
stored lower-point amplitude with a specified particle numbering."}],
   "GuideText"], Cell[TextData[{ButtonBox["PhysicalPoleResidue",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PhysicalPoleResidue"], ": ", "Extract the \
coefficient of one physical propagator pole, or of compatible simultaneous \
poles."}], "GuideText"], Cell["Tutorials", "GuideTutorialsSection"],
  Cell[TextData[
    {ButtonBox["Constructing and Checking an Amplitude in Stages",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ConstructingAndCheckingAnAmplitude"],
     "  \[Bullet]  ", ButtonBox[
      "Kinematics, References and On-Shell Conditions", BaseStyle -> "Link",
      ButtonData ->
       "paclet:HEPCAT/tutorial/KinematicsAndOnShellConditions"]}],
   "GuideTutorial"]}, WindowTitle ->
  "Diagrams and Factorization Channels - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/guide/DiagramsAndFactorization",
     "title" -> "Diagrams and Factorization Channels", "type" -> "Guide",
     "label" -> "HEPCAT Guide", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" ->
      "Generate diagrams and physical channel expressions from model data.",
     "keywords" -> {"HEPCAT", "DiagramsAndFactorization",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]