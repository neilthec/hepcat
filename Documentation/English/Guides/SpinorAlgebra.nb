       "paclet:HEPCAT/ref/ChooseSpinIndices"], ": ",
     "Selects spin projections in external-particle order."}], "GuideText"],
  Cell[TextData[{ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"], ": ", "Replaces \
implicit massive spin indices with specified explicit upper indices."}],
   "GuideText"], Cell[TextData[{ButtonBox["MakeIndicesImplicit",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/MakeIndicesImplicit"], ": ",
     "Removes supported explicit upper massive spin indices from chains."}],
   "GuideText"], Cell[TextData[{ButtonBox["SymmetrizeSpin",
