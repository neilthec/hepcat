Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT GUIDE", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Spinors, Momenta and Spin Sums", "GuideTitle"],
  Cell[TextData[{"Represent and manipulate angle brackets, square brackets, \
momentum chains and spin indices."}], "GuideAbstract"],
  Cell[TextData[
    {"A bracket such as an angle or square product is represented by ",
     ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], ", with ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], " objects at its ends. Put ",
     ButtonBox["Mom", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Mom"], " objects between the endpoints for momentum \
insertions. The notebook display gives the familiar bracket notation while \
retaining an expression that the algebra functions can manipulate."}],
   "GuideAbstract"], Cell[TextData[{"Particle labels and spin indices play \
different roles. A label identifies which external momentum belongs to a \
factor; an explicit massive-spin index selects a component. ",
     ButtonBox["ChooseSpinIndices", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndices"],
     " makes spin choices, whereas ", ButtonBox["PermuteParticles",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PermuteParticles"],
     " relabels the particles throughout the expression. ",
     ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"],
     " implements crossing, including the associated spinor signs."}],
   "GuideAbstract"], Cell[TextData[{"Start with ",
     ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     " when contracted spin indices remain, and ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"], " for ordinary \
chain identities. Neither is a substitute for supplying the complete process \
and diagram-local assumptions to ", ButtonBox["PrepareAmplitudes",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PrepareAmplitudes"], ". The ",
     ButtonBox["identity tutorial", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/tutorial/ApplyingSpinorIdentities"],
     " shows how to inspect individual exact moves."}], "GuideAbstract"],
  Cell["Build Expressions", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["Spinor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Spinor"], ": ", "Represents an angle \
or square spinor belonging to an external particle or an auxiliary \
reference."}], "GuideText"],
  Cell[TextData[{ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], ": ", "Represents a \
spinor bracket or an ordered spinor chain with momentum insertions."}],
   "GuideText"], Cell[TextData[{ButtonBox["SpinorTrace", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorTrace"], ": ",
     "Represents an ordered chiral trace of momentum matrices."}],
   "GuideText"], Cell[TextData[{ButtonBox["Mom", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mom"], ": ",
     "Represents a momentum in a spinor chain or a propagator."}],
   "GuideText"], Cell[TextData[{ButtonBox["Mass", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mass"], ": ", "Represents an \
external-particle mass or the assigned mass of an internal channel."}],
   "GuideText"], Cell[TextData[{ButtonBox["Multiparticle",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/Multiparticle"],
     ": ", "Labels the sum of a specified set of external momenta."}],
   "GuideText"], Cell[TextData[{ButtonBox["PropDen", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PropDen"], ": ", "Represents a \
physical propagator denominator without putting its momentum on shell."}],
   "GuideText"], Cell[TextData[{ButtonBox["MomProd", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomProd"], ": ", "Represents the \
Lorentz scalar product of two external or composite momenta."}],
   "GuideText"], Cell["Spin Indices and Squaring",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["ChooseSpinIndex", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ChooseSpinIndex"], ": ",
     "Selects one physical spin projection of a massive external particle."}]\
, "GuideText"], Cell[TextData[{ButtonBox["ChooseSpinIndices",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ChooseSpinIndices"], ": ", "Selects physical spin \
projections for successive massive external particles."}], "GuideText"],
  Cell[TextData[{ButtonBox["MakeIndicesExplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesExplicit"], ": ", "Inserts \
specified upper little-group indices into the implicit massive spinors of an \
expression."}], "GuideText"],
  Cell[TextData[{ButtonBox["MakeIndicesImplicit", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MakeIndicesImplicit"], ": ", "Removes \
the supported explicit upper massive-spin indices from spinor chains."}],
   "GuideText"], Cell[TextData[{ButtonBox["SymmetrizeSpin",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpin"],
     ": ", "Assigns and symmetrizes the little-group indices of one massive \
external particle."}], "GuideText"],
  Cell[TextData[{ButtonBox["SymmetrizeSpins", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SymmetrizeSpins"], ": ", "Symmetrizes \
massive little-group indices for a list of external particles."}],
   "GuideText"], Cell[TextData[{ButtonBox["ReduceSpinContractions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinContractions"], ": ", "Contracts repeated \
spin indices and joins the associated spinor factors into momentum chains."}]\
, "GuideText"], Cell[TextData[{ButtonBox["SquareAmplitude",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SquareAmplitude"], ": ", "Constructs an amplitude \
times its Hermitian conjugate, retaining the massive-spin contractions to be \
reduced."}], "GuideText"],
  Cell[TextData[{ButtonBox["ExpandSummation", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExpandSummation"], ": ", "Writes \
supported contracted massive-spin indices as explicit two-component sums."}],
   "GuideText"], Cell["Crossing, Relabeling and Kinematics",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"], ": ", "Crosses \
selected external momenta, including their spinor signs, in a complete \
amplitude expression."}], "GuideText"],
  Cell[TextData[{ButtonBox["PermuteParticles", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PermuteParticles"], ": ", "Cyclically \
relabels selected external particles in typed spinor and momentum \
expressions."}], "GuideText"],
  Cell[TextData[{ButtonBox["ExtractEnergy", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractEnergy"], ": ", "Evaluates \
supported spinor expressions in an explicit energy, momentum-angle and spin \
basis."}], "GuideText"],
  Cell[TextData[{ButtonBox["SpinToHelicitySpinors", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinToHelicitySpinors"], ": ", "Applie\
s legacy spin-to-helicity expansions to selected massive particle spinors."}]\
, "GuideText"], Cell["Reference Factors and Deformations",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["xFactor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/xFactor"], ": ",
     "Represents a constructive three-point x-factor."}], "GuideText"],
  Cell[TextData[{ButtonBox["xTildeFactor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/xTildeFactor"], ": ",
     "Represents a constructive three-point x-factor."}], "GuideText"],
  Cell[TextData[{ButtonBox["SpinorHat", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorHat"], ": ",
     "Represents a spinor whose momentum has been complex-deformed."}],
   "GuideText"], Cell[TextData[{ButtonBox["MomHat", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomHat"], ": ",
     "Represents a complex-deformed momentum insertion."}], "GuideText"],
  Cell[TextData[{ButtonBox["MomProdHat1", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomProdHat1"], ": ",
     "Represents a scalar product involving complex-deformed momenta."}],
   "GuideText"], Cell[TextData[{ButtonBox["MomProdHat2", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomProdHat2"], ": ",
     "Represents a scalar product involving complex-deformed momenta."}],
   "GuideText"], Cell[TextData[{ButtonBox["MomProdHat12",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/ref/MomProdHat12"],
     ": ",
     "Represents a scalar product involving complex-deformed momenta."}],
   "GuideText"], Cell[TextData[{ButtonBox["SpinorEps", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorEps"], ": ", "Represents the \
antisymmetric tensor used to raise and lower massive little-group indices."}]\
, "GuideText"], Cell[TextData[{ButtonBox["ComplexifyMomenta",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ComplexifyMomenta"], ": ", "Marks supported momenta \
and spinors for a legacy complex deformation."}], "GuideText"],
  Cell[TextData[{ButtonBox["UnhatMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/UnhatMomenta"], ": ",
     "Removes the standard complex-deformation markers."}], "GuideText"],
  Cell[TextData[{ButtonBox["ExpandComplexMomenta", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExpandComplexMomenta"], ": ", "Expands \
supported legacy complex-shift formulas with specified masses and companion \
legs."}], "GuideText"],
  Cell[TextData[{ButtonBox["ReplaceSpinorZ", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReplaceSpinorZ"], ": ",
     "Replaces a two-index auxiliary z object in a supported massive shift."}]\
, "GuideText"], Cell[TextData[{ButtonBox["UnHatSpinors", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/UnHatSpinors"], ": ",
     "Removes SpinorHat markers while leaving shifted momenta unchanged."}],
   "GuideText"], Cell["Other Symbolic Heads", "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["Mandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/Mandelstahm"], ": ",
     "Represents the two-particle invariant (p_i+p_j)^2."}], "GuideText"],
  Cell[TextData[{ButtonBox["MandelstahmHat", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MandelstahmHat"], ": ",
     "Represents the complex-deformed version of a two-particle invariant."}]\
, "GuideText"], Cell[TextData[{ButtonBox["En", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/En"], ": ", "Labels the energy of an \
external particle in explicit spinor formulas."}], "GuideText"],
  Cell[TextData[{ButtonBox["MomMagnitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/MomMagnitude"], ": ",
     "Labels the magnitude of a particle's spatial momentum."}],
