Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT GUIDE", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Identities and Simplification", "GuideTitle"],
  Cell[TextData[
    {"Apply exact identities and inspect legal one-step rewrites."}],
   "GuideAbstract"],
  Cell[TextData[{"There are three useful levels of simplification. ",
     ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     " removes contracted spin indices. ", ButtonBox["ReduceSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     " applies ordinary chain and external on-shell identities. ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " also knows the \
process, the supplied mass rules and the reference-spinor prescription, so it \
can make more informed choices."}], "GuideAbstract"],
  Cell[TextData[{"When you want to understand a derivation, use ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     " to inspect legal edits and ", ButtonBox["ApplySpinorIdentity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ApplySpinorIdentity"], " to replay one. This keeps \
the identity route explicit instead of treating a large simplification as one \
unexplained operation. ", ButtonBox["SpinorExpressionComplexity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorExpressionComplexity"],
     " gives a consistent measure for comparing intermediate forms."}],
   "GuideAbstract"], Cell[TextData[{"Apply numerator-specific rules with ",
     ButtonBox["ApplyToNumerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplyToNumerator"], ". It works on the \
terms as they stand: it does not expand a factored numerator or combine \
different denominators. Internal on-shell conditions belong only to the \
individual constructive numerator for which they were supplied. They must not \
be imposed on a complete final amplitude or on its physical propagator \
denominators."}], "GuideAbstract"],
  Cell[TextData[{"A shorter expression is not automatically a physically \
correct one. After combining diagrams or adding corrections, use ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], ". The ",
     ButtonBox["kinematics tutorial", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/tutorial/KinematicsAndOnShellConditions"],
     " explains which assumptions remain valid at each stage."}],
   "GuideAbstract"], Cell["Normal Reductions", "GuideFunctionsSubsection"],
  Cell[TextData[
    {"Use these for ordinary algebra before attempting a process-aware \
search."}], "GuideText"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"], ": ", "Contr\
acts repeated spin indices and joins the associated spinor factors into \
momentum chains."}], "GuideText"],
  Cell[TextData[{ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"], ": ", "Simplif\
ies spinor chains, traces and products using ordinary identities and \
external-particle on-shell conditions."}], "GuideText"],
  Cell[TextData[{ButtonBox["SimplifySpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SimplifySpinorProducts"], ": ", "Runs \
the earlier iterative simplifier with explicitly declared external momenta \
and optional internal-channel information."}], "GuideText"],
  Cell[TextData[{ButtonBox["ApplyToNumerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplyToNumerator"], ": ", "Applies \
replacement rules to each existing additive term's numerator while preserving \
its denominator."}], "GuideText"],
  Cell[TextData[{ButtonBox["ExtractMandelstahm", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ExtractMandelstahm"], ": ", "Rewrites \
supported scalar momentum products and two-particle propagators in terms of s \
invariants."}], "GuideText"],
  Cell[TextData[{ButtonBox["ReducexFactors", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReducexFactors"], ": ", "Reduces the \
supported legacy four-point x-factor formulas for an explicitly specified \
channel."}], "GuideText"],
  Cell[TextData[{ButtonBox["ReduceColor", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceColor"], ": ", "Applies the \
supported fundamental SU(3) color identities and writes the result in trace \
form."}], "GuideText"], Cell["Inspect and Replay Identities",
   "GuideFunctionsSubsection"],
  Cell[TextData[{"See which identity changes an expression, and retain the \
step for a reproducible derivation."}], "GuideText"],
  Cell[TextData[{ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"], ": ", "Lis\
ts the identity steps available for a spinor expression under its declared \
mass and momentum assumptions."}], "GuideText"],
  Cell[TextData[{ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"], ": ",
     "Applies one validated identity step to a spinor expression."}],
   "GuideText"], Cell[TextData[{ButtonBox["SchoutenRewrite",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SchoutenRewrite"], ": ", "Rewrites a product of two \
spinor chains using a chosen generalized Schouten identity."}], "GuideText"],
  Cell[TextData[{ButtonBox["SchoutenCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SchoutenCandidates"], ": ", "Finds the \
generalized Schouten replacements that can be applied to products of chains \
in an expression."}], "GuideText"],
  Cell[TextData[{ButtonBox["SpinorExpressionComplexity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorExpressionComplexity"], ": ", "S\
cores the size of a spinor expression, with extra weight for momentum \
insertions and scalar momentum products."}], "GuideText"],
  Cell[TextData[{ButtonBox["ComplicateAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ComplicateAmplitude"], ": ", "Generate\
s an equivalent expression by applying a random sequence of reversible \
identity steps."}], "GuideText"], Cell["Process-Aware Preparation",
   "GuideFunctionsSubsection"],
  Cell[TextData[{ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], ": ", "Simplify \
diagram expressions, factorization channels or a completed amplitude before \
the next calculation stage."}], "GuideText"],
  Cell["Tutorials", "GuideTutorialsSection"],
  Cell[TextData[{ButtonBox["Applying Spinor Identities in a Derivation",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ApplyingSpinorIdentities"], "  \[Bullet]  ",
     ButtonBox["Kinematics, References and On-Shell Conditions",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/KinematicsAndOnShellConditions"]}],
   "GuideTutorial"]}, WindowTitle ->
  "Identities and Simplification - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/guide/IdentitiesAndSimplification",
     "title" -> "Identities and Simplification", "type" -> "Guide",
     "label" -> "HEPCAT Guide", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" ->
      "Apply exact identities and inspect legal one-step rewrites.",
     "keywords" -> {"HEPCAT", "IdentitiesAndSimplification",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]