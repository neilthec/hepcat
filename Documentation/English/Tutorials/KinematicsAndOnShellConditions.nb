Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Kinematics, References and On-Shell Conditions",
   "TechNoteTitle"], Cell[TextData[{"Keep external kinematics, channel \
residues and diagram numerator assumptions distinct."}], "TechNoteText"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["All External Momenta Are Incoming", "TechNoteSection"],
  Cell[TextData[{"HEPCAT writes analytic amplitudes with every external \
momentum incoming. Consequently momentum conservation is the sum of those \
incoming momenta equal to zero. The particle order supplies the labels: \
relabeling the external list changes what 1, 2 and the other integers mean."}]\
, "TechNoteText"], Cell[TextData[{"Use ", ButtonBox["ReverseMomentum",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReverseMomentum"], " when you explicitly cross a \
symbolic external momentum. The transformation also includes its spinor \
convention. ", ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], " performs the \
crossing automatically from the physical incoming-to-outgoing process, so \
give that exporter the original all-incoming formula."}], "TechNoteText"],
  Cell["External and Internal Conditions", "TechNoteSection"],
  Cell[TextData[{"External mass-shell conditions describe the external \
particles of the complete amplitude. These are valid during ordinary spinor \
reduction. Internal-shell conditions have a narrower role: in the \
constructive diagram workflow they identify a numerator representative for a \
particular diagram, or the residue on a specified factorization cut."}],
   "TechNoteText"],
  Cell[TextData[{"The physical propagator denominators stay off shell. ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " uses only the \
internal conditions actually supplied with an individual constructive item. A \
completed expression has external mass rules only, and a Feynman diagram has \
no constructive internal-shell assumptions."}], "TechNoteText"],
  Cell[TextData[{"Simplifying a factorization channel on its own cut may \
change its continuation away from that pole. Keep the original channels as \
the residue targets. This is why ", ButtonBox["CompleteFactorization",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/CompleteFactorization"], " can use prepared \
expressions as useful sources while retaining the original obligations for \
validation."}], "TechNoteText"], Cell["Reference Choices",
   "TechNoteSection"], Cell[TextData[{"Reference spinors describe the \
massless external polarization choice. The ",
     Cell[BoxData[RowBox[{"\"PolePreference\""}]], "InlineFormula"],
     " option of ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " controls how \
those choices are made and also guides the later completion search. \
AllPhysical favors references with physical denominator structure; \
AllSpurious favors suitable massless-particle references; Mixed allows both \
kinds."}], "TechNoteText"],
  Cell[TextData[{"A compact individual diagram can be a useful starting point \
even when its reference denominators introduce apparent spurious poles. Those \
poles must cancel in the complete correct amplitude. ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], " discovers \
supported denominator poles and reports whether the sampled comparisons \
establish the required finiteness."}], "TechNoteText"],
  Cell[TextData[{"Feynman diagrams require a consistent reference choice for \
each massless external leg across the diagram sum. A constructive numerator \
preparation may make different local choices. In either case, inspect the \
complete result and its checks rather than judging correctness from the \
appearance of one diagram."}], "TechNoteText"],
  Cell["Related Functions", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReverseMomentum", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReverseMomentum"], "  \[Bullet]  ",
     ButtonBox["PermuteParticles", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PermuteParticles"], "  \[Bullet]  ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "  \[Bullet]  ",
     ButtonBox["PropDen", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/PropDen"], "  \[Bullet]  ",
     ButtonBox["PhysicalPoleResidue", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PhysicalPoleResidue"],
     "  \[Bullet]  ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Spinors, Momenta and Spin Sums",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/SpinorAlgebra"], "  \[Bullet]  ",
     ButtonBox["Constructing and Completing Amplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/AmplitudeConstruction"],
     "  \[Bullet]  ", ButtonBox["Checking Amplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/AmplitudeValidation"]}],
   "MoreAbout"]}, WindowTitle ->
  "Kinematics, References and On-Shell Conditions - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/tutorial/KinematicsAndOnShellConditions",
     "title" -> "Kinematics, References and On-Shell Conditions",
     "type" -> "Tutorial", "label" -> "HEPCAT Tutorial",
     "paclet" -> "HEPCAT", "language" -> "en", "summary" -> "Keep external \
kinematics, channel residues and diagram numerator assumptions distinct.",
     "keywords" -> {"HEPCAT", "KinematicsAndOnShellConditions",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]