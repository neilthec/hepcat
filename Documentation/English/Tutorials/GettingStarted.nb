Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Getting Started with HEPCAT", "TechNoteTitle"],
  Cell["Load the package, read a model and make a first spinor calculation.",
   "TechNoteText"], Cell[CellGroupData[
    {Cell["Load HEPCAT", "ExampleSubsection"], Cell["Evaluate this setup once \
before the examples. The paths refer to the local HEPCAT checkout; no model \
parameters are assigned global numerical values.", "ExampleText"],
     Cell[BoxData[RowBox[{"If", "[", "!", "StringQ", "[",
         "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ", "[",
         "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Load HEPCAT", "TechNoteSection"], Cell["Set $HEPCATpath to the source \
directory in your checkout, then evaluate Get. Replace the example directory \
with your own. Loading registers this checkout with Mathematica Help without \
opening any windows.", "TechNoteText"], Cell["After loading, put the cursor \
in a public symbol and press F1. Search Documentation for HEPCAT, or use the \
main HEPCAT guide. Reload the package if you have updated its documentation."\
, "TechNoteText"], Cell["Load the package from a local checkout.",
   "ExampleText"], Cell[BoxData[RowBox[{"Global`$HEPCATpath", " ", "=", " ",
      "FileNameJoin", "[", "{", "$HomeDirectory", ",", " ", "\"code\"", ",",
      " ", "\"hepcat\"", ",", " ", "\"source\"", "}", "]", ";", "\n", "Get",
      "[", "FileNameJoin", "[", "{", "$HEPCATpath", ",", " ",
      "\"HEPCAT.wl\"", "}", "]", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Read a Model", "TechNoteSection"],
  Cell["The examples use the bundled QED model 2 for three-point vertices and \
model 3 for complete amplitudes through four points. Keep both model lists if \
needed; their parameters do not overwrite global definitions.",
   "TechNoteText"],
  Cell["Locate the model directory and read the elementary QED model.",
   "ExampleText"], Cell[BoxData[RowBox[{"hepcatDirectory", " ", "=", " ",
      "ParentDirectory", "[", "Global`$HEPCATpath", "]", ";", "\n",
      "modelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
      "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
      "qedModel", " ", "=", " ", "ReadModel", "[", "modelDirectory", ",",
      " ", "2", "]", ";", "\n", "Length", " ", "/@", " ", "qedModel"}]],
   "Input"], Cell[BoxData[RowBox[{"{", "2", ",", " ", "2", ",", " ", "2",
      ",", " ", "0", "}"}]], "Output"],
  Cell["Obtain numerical mass and coupling rules from this model.",
   "ExampleText"], Cell[BoxData[RowBox[{"ModelParameterRules", "[",
      "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{InterpretationBox["EE", ModelParameter["EE",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["31333", "100000"]}],
        ",", RowBox[{InterpretationBox["Me", ModelParameter["Me",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["1", "2000"]}]}],
      "}"}]], "Output"], Cell["Write and Reduce a Spinor Chain",
   "TechNoteSection"], Cell["Labels refer to the ordered external particles. \
Strings such as Angle and Square select the chirality. A massless \
self-bracket vanishes; the basic reducer does not need to know the process.",
   "TechNoteText"], Cell["Display <13> in the notebook.", "ExampleText"],
  Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[", "\"Helicity\"",
      ",", " ", "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3", "]", "]"}]],
   "Input"], Cell[BoxData[TemplateBox[
     {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
      TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
     "RowDefault"]], "Output"], Cell["Reduce a vanishing self-bracket.",
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3", "]", "]", "]"}]],
   "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["Construct a Complete Amplitude", "TechNoteSection"],
  Cell["For a first full calculation, let automatic defaults choose the \
working budgets. ConstructAmplitude reports each stage and its elapsed time, \
the final checks and the final amplitude with its external mass rules. A \
complete known factorization model is essential at higher multiplicity.",
   "TechNoteText"], Cell["Construct a four-point QED amplitude.",
   "ExampleText"], Cell[BoxData[RowBox[{"ConstructAmplitude", "[", "{",
      "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ", "\"A.+\"",
      "}", ",", " ", "qedModel", ",", " ", "qedModel", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Related Functions", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], "  \[Bullet]  ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], "  \[Bullet]  ",
     ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], "  \[Bullet]  ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[
    {ButtonBox["HEPCAT: Constructive Amplitudes and Spinor Algebra",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"],
     "  \[Bullet]  ", ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["Spinors, Momenta and Spin Sums", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}], "MoreAbout"]},
 WindowTitle -> "Getting Started with HEPCAT - HEPCAT Documentation",
