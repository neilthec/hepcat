Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Getting Started with HEPCAT", "TechNoteTitle"],
  Cell[TextData[
    {"Load the package, read a model and make a first spinor calculation."}],
   "TechNoteText"], Cell["Load HEPCAT", "TechNoteSection"],
  Cell[TextData[{"These first examples introduce the expression format before \
constructing a small QED amplitude. They assume your checkout is in \
~/code/hepcat. Change that path if you installed it elsewhere."}],
   "TechNoteText"],
  Cell[TextData[{"Load the package in a separate input cell. One ",
     ButtonBox["Get", BaseStyle -> "Link", ButtonData -> "paclet:ref/Get"], " \
command is enough; the loader finds its companion source files and registers \
the Help pages automatically. You do not need to set a global path variable."}\
], "TechNoteText"], Cell[TextData[{"Load the package from its checkout. \
Change the path if your HEPCAT folder is elsewhere."}], "ExampleText"],
  Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
      "]"}]], "Input"], Cell[BoxData[RowBox[{"Null"}]], "Output"],
  Cell["Read a Model", "TechNoteSection"],
  Cell[TextData[{"A calculation begins with a model value returned by ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], ". The bundled model \
numbered 2 supplies the QED interactions used in this example. Keep the \
returned value in a notebook variable and pass it to the functions that need \
the theory."}], "TechNoteText"],
  Cell[TextData[{"A constructive model has four parts: particle data, known \
interactions or amplitudes, independent parameters and dependent functions. "\
, Cell[BoxData[RowBox[{"Length", " ", "/@", " ", "qedModel"}]],
      "InlineFormula"], " is a quick way to see the size of those parts, not \
the amplitude itself. ", ButtonBox["ModelParameterRules",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ModelParameterRules"],
     " shows the numerical assignments used by numerical checks."}],
   "TechNoteText"],
  Cell[TextData[
    {"Locate the model directory and read the elementary QED model."}],
   "ExampleText"], Cell[BoxData[RowBox[{"modelDirectory", " ", "=", " ",
      "\"~/code/hepcat/models\"", ";", "\n", "qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "Length", " ", "/@", " ", "qedModel"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "2", ",", " ", "2", ",", " ", "2", ",", " ", "0",
      "}"}]], "Output"],
  Cell[TextData[
    {"Obtain numerical mass and coupling rules from this model."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ModelParameterRules", "[",
      "qedModel", "]"}]], "Input"],
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{InterpretationBox["EE", ModelParameter["EE",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["31333", "100000"]}],
        ",", RowBox[{InterpretationBox["Me", ModelParameter["Me",
            "c290c11592fdb153523bc79fa19d6792772af2948585b673a998d4f95927eaad\
", "Real"], Editable -> False], "\[Rule]", FractionBox["1", "2000"]}]}],
      "}"}]], "Output"], Cell["Write and Reduce a Spinor Chain",
   "TechNoteSection"],
  Cell[TextData[{ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], " stores a bracket or a \
longer chain as ordinary Mathematica data. The following first expression \
displays an angle bracket. The second applies ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"], " to an angle \
bracket with the same massless spinor at both ends, which vanishes."}],
   "TechNoteText"], Cell[TextData[{"The label 1 identifies the first external \
particle; it is not a numerical momentum value. Expressions remain symbolic \
until you ask for a numerical evaluation or a validation check."}],
   "TechNoteText"], Cell[TextData[{"Display <13> in the notebook."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SpinorChain", "[", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1", "]", ",", " ",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3",
      "]", "]"}]], "Input"],
  Cell[BoxData[InterpretationBox[StyleBox[TemplateBox[
       {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
        TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
       "RowDefault"], ShowStringCharacters -> False],
     SpinorChain[Spinor["Helicity", "Angle", 1], Spinor["Helicity", "Angle",
       3]], Editable -> False]], "Output"],
  Cell[TextData[{"Reduce a vanishing self-bracket."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "3", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["Construct a Complete Amplitude", "TechNoteSection"],
  Cell[TextData[{"Now give ", ButtonBox["ConstructAmplitude",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ConstructAmplitude"], " the ordered external \
particle list and the two model roles. Here the process is four point, so \
products of three-point amplitudes suffice for factorization and the same QED \
model can serve both roles."}], "TechNoteText"],
  Cell[TextData[{"The calculation prints its progress and final check table, \
then returns the validated expression when the supported construction \
succeeds. The two A.+ entries select positive photon helicity in the analytic \
all-incoming convention. For more control and visible intermediate \
expressions, continue with the ", ButtonBox["staged tutorial",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/tutorial/ConstructingAndCheckingAnAmplitude"], "."}],
   "TechNoteText"], Cell[TextData[{"Construct a four-point QED amplitude."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ConstructAmplitude", "[", "{",
      "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ", "\"A.+\"",
      "}", ",", " ", "qedModel", ",", " ", "qedModel", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Related Functions", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["ConstructAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ConstructAmplitude"], "  \[Bullet]  ",
     ButtonBox["Spinor", BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/Spinor"], "  \[Bullet]  ",
     ButtonBox["SpinorChain", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorChain"], "  \[Bullet]  ",
     ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[
    {ButtonBox["HEPCAT: High Energy Physics Constructive Amplitude Tool",
      BaseStyle -> "Link", ButtonData -> "paclet:HEPCAT/guide/HEPCAT"],
     "  \[Bullet]  ", ButtonBox["Models and Model-Local Parameters",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/ModelsAndParameters"], "  \[Bullet]  ",
     ButtonBox["Spinors, Momenta and Spin Sums", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}], "MoreAbout"]},
 WindowTitle -> "Getting Started with HEPCAT - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/tutorial/GettingStarted",
     "title" -> "Getting Started with HEPCAT", "type" -> "Tutorial",
     "label" -> "HEPCAT Tutorial", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" ->
      "Load the package, read a model and make a first spinor calculation.",
     "keywords" -> {"HEPCAT", "GettingStarted", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]