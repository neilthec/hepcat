Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Exporting a Numerical SPINAS Process",
   "TechNoteTitle"], Cell[TextData[{"Export a checked amplitude family, build \
its numerical code, and compare or integrate it with independent external \
tools."}], "TechNoteText"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "hepcatDirectory", " ", "=", " ",
         "\"~/code/hepcat\"", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";", "\n", "feynmanModelDirectory", " ",
         "=", " ", "\"~/code/hepcat/tests/reference-models/calchep\"",
         ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Collect Analytic Helicity Amplitudes", "TechNoteSection"],
  Cell[TextData[{"This tutorial starts with known, checked QED amplitudes and \
turns them into one numerical process. It separates source generation, \
compilation, independent validation and event generation so you can choose \
the stage you need."}], "TechNoteText"],
  Cell[TextData[{"The input entries remain in HEPCAT's all-incoming \
convention. The physical process passed to ", ButtonBox["WriteSPINASProcess",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/WriteSPINASProcess"], " determines which momenta \
are crossed in the generated numerical code. The exporter needs the formulas \
for the requested helicity combinations, not just a spin-summed squared \
amplitude."}], "TechNoteText"],
  Cell[TextData[{ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"], " retrieves the \
stored four-point formulas from the bundled factorization model. Here the \
three analytic sectors, together with the exporter's allowed \
identical-particle permutations, provide the photon-helicity coverage for the \
unpolarized physical process."}], "TechNoteText"],
  Cell[TextData[{"Collect the independent photon-helicity cases."}],
   "ExampleText"], Cell[BoxData[RowBox[{"knownModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "3", "]", ";", "\n",
      "processes", " ", "=", " ", "{", "{", "\"e\"", ",", " ", "\"E\"", ",",
      " ", "\"A.+\"", ",", " ", "\"A.+\"", "}", ",", " ", "{", "\"e\"", ",",
      " ", "\"E\"", ",", " ", "\"A.+\"", ",", " ", "\"A.-\"", "}", ",", " ",
      "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.-\"", ",", " ",
      "\"A.-\"", "}", "}", ";", "\n", "entries", " ", "=", " ", "{", "#",
      ",", " ", "LookupAmplitude", "[", "Thread", "[", "{", "#", ",", " ",
      "Range", "[", "4", "]", "}", "]", ",", " ", "knownModel", ",", " ",
      "False", ",", " ", "{", "i1", ",", " ", "i2", ",", " ", "i3", ",", " ",
      "i4", "}", "]", "}", " ", "&", " ", "/@", " ", "processes", ";"}]],
   "Input"], Cell["Specify Physical Incoming and Outgoing Particles",
   "TechNoteSection"],
  Cell[TextData[{"The rule ",
     Cell[BoxData[RowBox[{"{", "\"e\"", ",", " ", "\"E\"", "}", " ", "->",
         " ", "{", "\"A\"", ",", " ", "\"A\"", "}"}]], "InlineFormula"], " \
describes electron-positron annihilation to two photons. Generic A requests \
the photon helicities required by that physical process. A fixed-helicity \
choice must be explicit if you want only a selected contribution."}],
   "TechNoteText"], Cell[TextData[{"The ordinary export writes source files \
and a README; it does not require a compiler. The returned directory contains \
the generated process class and build instructions. Keep that directory \
distinct from the symbolic model files."}], "TechNoteText"],
  Cell[TextData[{"Write files into a new temporary directory."}],
   "ExampleText"], Cell[BoxData[RowBox[{"exportDirectory", " ", "=", " ",
      "CreateDirectory", "[", "]", ";", "\n", "WriteSPINASProcess", "[",
      "exportDirectory", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", "}", " ",
      "->", " ", "{", "\"A\"", ",", " ", "\"A\"", "}", ",", " ", "entries",
      ",", " ", "knownModel", ",", " ", "\"ProcessName\"", " ", "->", " ",
      "\"eeAA\"", "]"}]], "Input"], Cell["This example writes files, starts a \
longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell["Build and Run", "TechNoteSection"],
  Cell[TextData[{"Set ", Cell[BoxData[RowBox[{"\"Build\"", " ", "->", " ",
         "True"}]], "InlineFormula"],
     Cell[BoxData[RowBox[{" ", "when", " ", "SPINAS", " ", "and", " ", "a",
         " ", "compatible", " ", "compiler", " ", "toolchain", " ", "are",
         " ", "available", ".", " "}]], "InlineFormula"],
     Cell[BoxData[RowBox[{"\"RunExamples\"", " ", "->", " ", "True"}]],
      "InlineFormula"], " also evaluates the supplied physical example \
momenta. Building or obtaining a finite example value is useful for checking \
the numerical interface, but is not an independent validation of the \
physics."}], "TechNoteText"],
  Cell[TextData[{"The generated class has an amplitude function for explicit \
spins/helicities and a squared-amplitude function with the declared spin \
average and identical-particle factor. It sums squared moduli of the selected \
amplitudes; it does not square a sum of their moduli."}], "TechNoteText"],
  Cell[TextData[
    {"Build and run the generated example where SPINAS is installed."}],
   "ExampleText"], Cell[BoxData[RowBox[{"WriteSPINASProcess", "[",
      "exportDirectory", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", "}", " ",
      "->", " ", "{", "\"A\"", ",", " ", "\"A\"", "}", ",", " ", "entries",
      ",", " ", "knownModel", ",", " ", "\"ProcessName\"", " ", "->", " ",
      "\"eeAA\"", ",", " ", "\"Overwrite\"", " ", "->", " ", "True", ",",
      " ", "\"Build\"", " ", "->", " ", "True", ",", " ", "\"RunExamples\"",
      " ", "->", " ", "True", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["CalcHEP Validation and Integration",
   "TechNoteSection"], Cell[TextData[{"Optional CalcHEP validation generates \
an independent symbolic reference process and compares squared amplitudes on \
shared random kinematics. Select CalcHEPDirectory and CalcHEPModel \
explicitly; neither is guessed. CalcHEPAllowedParticles -> All uses the full \
selected model, while a visible PDG list selects a smaller reference sector."}\
], "TechNoteText"], Cell[TextData[{"The optional n_calchep backend has a \
different purpose: it connects CalcHEP's numerical integration machinery to \
the HEPCAT SPINAS matrix element without CalcHEP symbolically regenerating \
that matrix element. Generated parameter and mass interfaces keep the runtime \
values consistent."}], "TechNoteText"],
  Cell[TextData[{"After building, enter build/results from the exported \
project directory and run ./n_calchep. If you are already in build, use cd \
results. This folder contains the runtime executable, numerical settings and \
output. It is created inside the CMake build directory, including an \
alternative build directory selected during configuration, so generated run \
data stays separate from source. Validation and example programs stay in \
build. Move the complete results directory elsewhere before deleting build if \
you want to keep that numerical session. Keep the installed CalcHEP and \
system runtime dependencies available."}], "TechNoteText"],
  Cell["Validate Each Photon Helicity with MadGraph", "TechNoteSection"],
  Cell[TextData[{"ValidateMadGraph provides an independent numerical check \
using MadGraph's own generated matrix element. It fixes each massless \
helicity combination, sums massive-particle spins and evaluates both \
implementations on exactly the same physical momenta. Masses, couplings, \
initial-state averages and identical-particle factors must agree."}],
   "TechNoteText"], Cell[TextData[{"Select the MadGraph installation, UFO \
model and particle content explicitly. The example uses sm-full for a massive \
electron and then MadGraphAllowedParticles -> {11,22} to choose only the \
electron/positron/photon sector. Without that filter the full Standard Model \
also contains weak exchange in four-fermion processes. Parameter overrides \
and maps must match the chosen reference theory; no fitted ratio hides a \
mismatch."}], "TechNoteText"],
  Cell[TextData[{"Use the same ValidateMadGraph call for large expressions. \
HEPCAT selects the build settings automatically and keeps its large \
validation build separate from the regular simulation build. See ",
     ButtonBox["ValidateMadGraph", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ValidateMadGraph"],
     " for the build stages and the reference time limit."}],
   "TechNoteText"],
  Cell[TextData[{"Validate the already exported process."}], "ExampleText"],
  Cell[BoxData[RowBox[{"madGraphDirectory", " ", "=", " ", "FileNameJoin",
      "[", "{", "ParentDirectory", "[", "hepcatDirectory", "]", ",", " ",
      "\"MadGraph\"", "}", "]", ";", "\n", "WriteSPINASProcess", "[",
      "exportDirectory", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", "}", " ",
      "->", " ", "{", "\"A\"", ",", " ", "\"A\"", "}", ",", " ", "entries",
      ",", " ", "knownModel", ",", " ", "\"ProcessName\"", " ", "->", " ",
      "\"eeAA\"", ",", " ", "\"Overwrite\"", " ", "->", " ", "True", ",",
      " ", "\"MadGraphDirectory\"", " ", "->", " ", "madGraphDirectory", ",",
      " ", "\"MadGraphModel\"", " ", "->", " ", "\"sm-full\"", ",", " ",
      "\"MadGraphAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", "]", ";", "\n", "ValidateMadGraph", "[", "exportDirectory",
      "]"}]], "Input"], Cell["This example writes files, starts a longer \
calculation, or requires an optional external tool. Evaluate it when you want \
to perform that operation.", "ExampleText"],
  Cell[TextData[{"Keep a replayable diagnostic report."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ValidateMadGraph", "[", "exportDirectory", ",", " ",
      "\"MadGraphSeed\"", " ", "->", " ", "12345", ",", " ", "\"Output\"",
      " ", "->", " ", "\"Details\"", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Use the SPINAS Amplitude in MadEvent",
   "TechNoteSection"],
  Cell[TextData[{"The same ", ButtonBox["WriteSPINASProcess",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/WriteSPINASProcess"], " export supports two \
separate MadGraph workflows. ValidateMadGraph compares with an independently \
generated MadGraph amplitude. The MadEvent numerical bridge instead uses the \
supplied HEPCAT/SPINAS amplitude for integration and event generation, while \
retaining MadEvent's phase-space channels, beam settings and cuts."}],
   "TechNoteText"], Cell[TextData[{"Select the installation, UFO model and \
any particle restriction explicitly as in the validation example. Keep the \
analytic entries in the all-incoming convention; the exporter crosses the \
declared outgoing legs once. Parameter and mass changes must remain \
consistent with the supplied amplitude and the chosen numerical model."}],
   "TechNoteText"], Cell[TextData[{"This bridge is for supported colorless \
leading-order tree amplitudes. It does not create the additional matrix \
elements needed for a next-to-leading-order or matched calculation. \
Massive-spin correlations cannot be inferred from a spin-summed result or \
from treating the two libraries' spin bases as identical."}],
   "TechNoteText"], Cell[TextData[{"Request \"Build\" -> True in the same \
export call. For ProcessName -> \"eeAA\", the normal CMake build prepares the \
native numerical process in build/PROC_eeAA automatically. It calls the \
Python preparation code directly; there is no outer eeAA_madevent executable \
at the build root. To prepare the process manually after configuration, run \
cmake --build build --target eeAA_madevent_process. An alternative CMake \
build directory receives its own PROC_eeAA directory."}], "TechNoteText"],
  Cell[TextData[{"Enter build/PROC_eeAA and run ./bin/madevent to open the \
native numerical interface. Cards/run_card.dat controls beam energies, cuts, \
event counts, integration settings and the random seed; Cards/param_card.dat \
controls numerical model inputs. Open index.html for progress and results, \
and find each run beneath Events, for example Events/run_01."}],
   "TechNoteText"], Cell[TextData[{"New numerical sessions use pointlike \
beams (lpp1 = lpp2 = 0) for the elementary incoming particles specified in \
the export. This avoids an implicit photon-PDF choice for one beam and a \
different PDF choice for the other. Beam energies and cuts remain in the \
native run card. You can choose supported beam distributions there later; \
rebuilding an existing session preserves your cards and events. The builder \
generates and checks the native card include files before compiling Fortran."}\
], "TechNoteText"], Cell[TextData[{"Use the native MadEvent commands and card \
files to configure and run the calculation. Repeated preparation preserves \
existing cards and events. The numerical integration and event generation use \
the exported HEPCAT/SPINAS amplitude, while the separate validation \
executable still compares it with an independent MadGraph matrix element."}],
   "TechNoteText"], Cell[TextData[{"Move or copy the whole PROC_eeAA \
directory when you want to keep the numerical process elsewhere. Move it \
outside build before deleting build, then enter that directory and run \
./bin/madevent. Its amplitude sources, headers, HEPCAT/SPINAS numerical \
libraries and private model support are included, so the original exported \
project, build directory and SPINAS checkout can be removed. Keep the \
external MadGraph installation, Python, Fortran toolchain and system \
libraries available. Move the directory between runs while no integration or \
compilation is active."}], "TechNoteText"],
  Cell[TextData[{"The independent comparison remains available through \
ValidateMadGraph[exportDirectory] and the generated eeAA_validate_madgraph \
program. The two workflows share the export and selected model while \
performing different calculations."}], "TechNoteText"],
  Cell[TextData[{"Export the numerical MadEvent bridge and the independent \
validator together. Set the installation and model explicitly; this example \
selects only electrons, positrons and photons."}], "ExampleText"],
  Cell[BoxData[RowBox[{"madGraphDirectory", " ", "=", " ", "FileNameJoin",
      "[", "{", "ParentDirectory", "[", "hepcatDirectory", "]", ",", " ",
      "\"MadGraph\"", "}", "]", ";", "\n", "WriteSPINASProcess", "[",
      "exportDirectory", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", "}", " ",
      "->", " ", "{", "\"A\"", ",", " ", "\"A\"", "}", ",", " ", "entries",
      ",", " ", "knownModel", ",", " ", "\"ProcessName\"", " ", "->", " ",
      "\"eeAA\"", ",", " ", "\"Overwrite\"", " ", "->", " ", "True", ",",
      " ", "\"Build\"", " ", "->", " ", "True", ",", " ",
      "\"MadGraphDirectory\"", " ", "->", " ", "madGraphDirectory", ",", " ",
      "\"MadGraphModel\"", " ", "->", " ", "\"sm-full\"", ",", " ",
      "\"MadGraphAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", "]"}]], "Input"], Cell["This example writes files, starts a \
longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell["Run Both Independent References", "TechNoteSection"],
  Cell[TextData[{"The two reference checks answer separate questions and both \
should be available even when one fails. Ask the exporter to run both checks, \
with an explicit installation and model for each program. The supplied HEPCAT \
expression is not replaced by either reference result."}], "TechNoteText"],
  Cell[TextData[{"A failed requested comparison returns Failure. Its \
ExportResult retains the generated project and both reference reports, so a \
CalcHEP failure does not hide the MadGraph result. Compilation or writing \
source does not by itself establish amplitude agreement. Differences in the \
selected theory, masses, couplings or conventions must be investigated rather \
than fitted away."}], "TechNoteText"],
  Cell[TextData[{"Run both comparisons on the same exported QED helicity \
family. Replace the installation paths with your selected locations."}],
   "ExampleText"], Cell[BoxData[RowBox[{"calcHEPDirectory", " ", "=", " ",
      "\"/path/to/CalcHEP\"", ";", "\n", "exportReport", " ", "=", " ",
      "WriteSPINASProcess", "[", "exportDirectory", ",", " ", "{", "\"e\"",
      ",", " ", "\"E\"", "}", " ", "->", " ", "{", "\"A\"", ",", " ",
      "\"A\"", "}", ",", " ", "entries", ",", " ", "knownModel", ",", "\n",
      " ", " ", "\"ProcessName\"", " ", "->", " ", "\"eeAA\"", ",", " ",
      "\"Overwrite\"", " ", "->", " ", "True", ",", "\n", " ", " ",
      "\"CalcHEPDirectory\"", " ", "->", " ", "calcHEPDirectory", ",", "\n",
      " ", " ", "\"CalcHEPModel\"", " ", "->", " ", "{",
      "feynmanModelDirectory", ",", " ", "2", "}", ",", "\n", " ", " ",
      "\"CalcHEPAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", ",", "\n", " ", " ", "\"MadGraphDirectory\"", " ", "->",
      " ", "madGraphDirectory", ",", " ", "\"MadGraphModel\"", " ", "->",
      " ", "\"sm-full\"", ",", "\n", " ", " ",
      "\"MadGraphAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", ",", "\n", " ", " ", "\"RunCalcHEPValidation\"", " ", "->",
      " ", "True", ",", " ", "\"RunMadGraphValidation\"", " ", "->", " ",
      "True", ",", "\n", " ", " ", "\"ReturnDetails\"", " ", "->", " ",
      "True", "]", ";"}]], "Input"], Cell["This example writes files, starts \
a longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell[TextData[{"Inspect a failed combined comparison without losing the \
other reference report."}], "ExampleText"],
  Cell[BoxData[RowBox[{"referenceReports", " ", "=", " ", "Replace", "[",
      "exportReport", ",", " ", "Failure", "[", "\"SPINASValidation\"", ",",
      " ", "data", "_", "Association", "]", " ", ":>", " ", "data", "[",
      "\"ExportResult\"", "]", "]", ";", "\n", "If", "[", "AssociationQ",
      "[", "referenceReports", "]", ",", " ", "KeyTake", "[",
      "referenceReports", ",", " ", "{", "\"CalcHEPValidation\"", ",", " ",
      "\"MadGraphValidation\"", "}", "]", ",", " ", "referenceReports",
      "]"}]], "Input"], Cell["This example writes files, starts a longer \
calculation, or requires an optional external tool. Evaluate it when you want \
to perform that operation.", "ExampleText"], Cell["Related Functions",
   "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], "  \[Bullet]  ",
     ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"], "  \[Bullet]  ",
     ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"],
     "  \[Bullet]  ", ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"],
     "  \[Bullet]  ", ButtonBox["SPINAS", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SPINAS"], "  \[Bullet]  ",
     ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"], "  \[Bullet]  ",
     ButtonBox["ValidateMadGraph", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ValidateMadGraph"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FormattingAndExport"], "  \[Bullet]  ",
     ButtonBox["Models and Model-Local Parameters", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
   "MoreAbout"]}, WindowTitle ->
  "Exporting a Numerical SPINAS Process - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/tutorial/ExportingToSPINAS",
     "title" -> "Exporting a Numerical SPINAS Process", "type" -> "Tutorial",
     "label" -> "HEPCAT Tutorial", "paclet" -> "HEPCAT", "language" -> "en",
     "summary" -> "Export a checked amplitude family, build its numerical \
code, and compare or integrate it with independent external tools.",
     "keywords" -> {"HEPCAT", "ExportingToSPINAS", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]