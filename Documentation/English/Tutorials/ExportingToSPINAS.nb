Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Exporting a Numerical SPINAS Process",
   "TechNoteTitle"], Cell["Group helicities, declare physical crossing and \
build readable numerical code.", "TechNoteText"],
  Cell[CellGroupData[{Cell["Load HEPCAT", "ExampleSubsection"],
     Cell["Evaluate this setup once before the examples. The paths refer to \
the local HEPCAT checkout; no model parameters are assigned global numerical \
values.", "ExampleText"], Cell[BoxData[RowBox[{"If", "[", "!", "StringQ",
         "[", "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ",
         "[", "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Collect Analytic Helicity Amplitudes", "TechNoteSection"],
  Cell["One exported process should contain the massless helicity choices \
needed by the requested spin sum. The expressions still use HEPCAT's \
all-incoming convention. The known four-point QED model is a small example \
that does not need a new construction run.", "TechNoteText"],
  Cell["Collect the independent photon-helicity cases.", "ExampleText"],
  Cell[BoxData[RowBox[{"knownModel", " ", "=", " ", "ReadModel", "[",
      "modelDirectory", ",", " ", "3", "]", ";", "\n", "processes", " ", "=",
      " ", "{", "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",",
      " ", "\"A.+\"", "}", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", ",",
      " ", "\"A.+\"", ",", " ", "\"A.-\"", "}", ",", " ", "{", "\"e\"", ",",
      " ", "\"E\"", ",", " ", "\"A.-\"", ",", " ", "\"A.-\"", "}", "}", ";",
      "\n", "entries", " ", "=", " ", "{", "#", ",", " ", "LookupAmplitude",
      "[", "Thread", "[", "{", "#", ",", " ", "Range", "[", "4", "]", "}",
      "]", ",", " ", "knownModel", ",", " ", "False", ",", " ", "{", "i1",
      ",", " ", "i2", ",", " ", "i3", ",", " ", "i4", "}", "]", "}", " ",
      "&", " ", "/@", " ", "processes", ";"}]], "Input"],
  Cell["Specify Physical Incoming and Outgoing Particles",
   "TechNoteSection"], Cell["The physical process makes crossing unambiguous. \
WriteSPINASProcess reverses the outgoing momenta and spinor conventions. For \
identical photons it can use the supported permutation completion of supplied \
helicity cases; incomplete requested helicity coverage must be reported \
rather than silently summed as zero.", "TechNoteText"],
  Cell["Use an explicit helicity in the physical process when that particle \
is intentionally fixed. A spin-summed amplitude squares the modulus for each \
spin/helicity assignment and then adds those contributions. It does not add \
amplitudes from different external spin states before squaring.",
   "TechNoteText"], Cell["Write files into a new temporary directory.",
   "ExampleText"], Cell[BoxData[RowBox[{"exportDirectory", " ", "=", " ",
      "CreateDirectory", "[", "]", ";", "\n", "WriteSPINASProcess", "[",
      "exportDirectory", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", "}", " ",
      "->", " ", "{", "\"A\"", ",", " ", "\"A\"", "}", ",", " ", "entries",
      ",", " ", "knownModel", ",", " ", "\"ProcessName\"", " ", "->", " ",
      "\"eeAA\"", "]"}]], "Input"], Cell["This example writes files, starts a \
longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell["Build and Run", "TechNoteSection"], Cell["The exporter writes the \
process header and implementation, a small driver, CMake support and \
validation helpers. Request building when SPINAS and the required compiler \
tools are installed. The output report gives the generated locations and \
build/run diagnostics.", "TechNoteText"], Cell["Normal random validation uses \
a time-based seed. Pass an explicit seed when replaying a failure. The \
generated numerical tests compare the same phase-space points for both \
implementations.", "TechNoteText"],
  Cell["Build and run the generated example where SPINAS is installed.",
   "ExampleText"], Cell[BoxData[RowBox[{"WriteSPINASProcess", "[",
      "exportDirectory", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", "}", " ",
      "->", " ", "{", "\"A\"", ",", " ", "\"A\"", "}", ",", " ", "entries",
      ",", " ", "knownModel", ",", " ", "\"ProcessName\"", " ", "->", " ",
      "\"eeAA\"", ",", " ", "\"Overwrite\"", " ", "->", " ", "True", ",",
      " ", "\"Build\"", " ", "->", " ", "True", ",", " ", "\"RunExamples\"",
      " ", "->", " ", "True", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["CalcHEP Validation and Integration",
   "TechNoteSection"], Cell["Optional CalcHEP validation generates an \
independent symbolic reference process and compares squared amplitudes on \
shared random kinematics. Select CalcHEPDirectory and CalcHEPModel \
explicitly; neither is guessed. CalcHEPAllowedParticles -> All uses the full \
selected model, while a visible PDG list selects a smaller reference sector."\
, "TechNoteText"], Cell["The optional n_calchep backend has a different \
purpose: it connects CalcHEP's numerical integration machinery to the HEPCAT \
SPINAS matrix element without CalcHEP symbolically regenerating that matrix \
element. Generated parameter and mass interfaces keep the runtime values \
consistent.", "TechNoteText"], Cell["After building, enter the exported \
project's results directory and run ./n_calchep. The actual executable is \
copied there, so it does not disappear when the original build directory is \
removed. This folder holds the numerical run's settings and output; \
validation and example programs stay in build. Keep the installed CalcHEP and \
system runtime dependencies available.", "TechNoteText"],
  Cell["Validate Each Photon Helicity with MadGraph", "TechNoteSection"],
  Cell["ValidateMadGraph provides an independent numerical check using \
MadGraph's own generated matrix element. It fixes each massless helicity \
combination, sums massive-particle spins and evaluates both implementations \
on exactly the same physical momenta. Masses, couplings, initial-state \
averages and identical-particle factors must agree.", "TechNoteText"],
  Cell["Select the MadGraph installation, UFO model and particle content \
explicitly. The example uses sm-full for a massive electron and then \
MadGraphAllowedParticles -> {11,22} to choose only the \
electron/positron/photon sector. Without that filter the full Standard Model \
also contains weak exchange in four-fermion processes. Parameter overrides \
and maps must match the chosen reference theory; no fitted ratio hides a \
mismatch.", "TechNoteText"], Cell["Validate the already exported process.",
   "ExampleText"], Cell[BoxData[RowBox[{"madGraphDirectory", " ", "=", " ",
      "FileNameJoin", "[", "{", "ParentDirectory", "[", "hepcatDirectory",
      "]", ",", " ", "\"MadGraph\"", "}", "]", ";", "\n",
      "WriteSPINASProcess", "[", "exportDirectory", ",", " ", "{", "\"e\"",
      ",", " ", "\"E\"", "}", " ", "->", " ", "{", "\"A\"", ",", " ",
      "\"A\"", "}", ",", " ", "entries", ",", " ", "knownModel", ",", " ",
      "\"ProcessName\"", " ", "->", " ", "\"eeAA\"", ",", " ",
      "\"Overwrite\"", " ", "->", " ", "True", ",", " ",
      "\"MadGraphDirectory\"", " ", "->", " ", "madGraphDirectory", ",", " ",
      "\"MadGraphModel\"", " ", "->", " ", "\"sm-full\"", ",", " ",
      "\"MadGraphAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", "]", ";", "\n", "ValidateMadGraph", "[", "exportDirectory",
      "]"}]], "Input"], Cell["This example writes files, starts a longer \
calculation, or requires an optional external tool. Evaluate it when you want \
to perform that operation.", "ExampleText"],
  Cell["Keep a replayable diagnostic report.", "ExampleText"],
  Cell[BoxData[RowBox[{"ValidateMadGraph", "[", "exportDirectory", ",", " ",
      "\"MadGraphSeed\"", " ", "->", " ", "12345", ",", " ", "\"Output\"",
      " ", "->", " ", "\"Details\"", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Use the SPINAS Amplitude in MadEvent",
   "TechNoteSection"], Cell["The same WriteSPINASProcess export supports two \
separate MadGraph workflows. ValidateMadGraph compares with an independently \
generated MadGraph amplitude. The MadEvent numerical bridge instead uses the \
supplied HEPCAT/SPINAS amplitude for integration and event generation, while \
retaining MadEvent's phase-space channels, beam settings and cuts.",
   "TechNoteText"], Cell["Select the installation, UFO model and any particle \
restriction explicitly as in the validation example. Keep the analytic \
entries in the all-incoming convention; the exporter crosses the declared \
outgoing legs once. Parameter and mass changes must remain consistent with \
the supplied amplitude and the chosen numerical model.", "TechNoteText"],
  Cell["This bridge is for supported colorless leading-order tree amplitudes. \
It does not create the additional matrix elements needed for a \
next-to-leading-order or matched calculation. Massive-spin correlations \
cannot be inferred from a spin-summed result or from treating the two \
libraries' spin bases as identical.", "TechNoteText"],
  Cell["Request \"Build\" -> True in the same export call. For ProcessName -> \
\"eeAA\", enter build and run ./eeAA_madevent --prepare. The default output \
workspace is the directory from which you run the launcher, so this creates \
build/PROC_eeAA. The PROC_ name follows ProcessName for other processes. The \
launcher prints the full card, HTML and event-output locations. The first \
generation step can take longer than later runs because MadEvent builds its \
integration code.", "TechNoteText"], Cell["From the same build directory, \
./eeAA_madevent opens the numerical interface and ./eeAA_madevent --run \
run_01 generates events. Under that working directory, \
PROC_eeAA/Cards/run_card.dat controls beam energies, cuts, event counts, \
integration settings and the random seed; PROC_eeAA/Cards/param_card.dat \
controls numerical model inputs. Open PROC_eeAA/index.html for progress and \
results, and find the event file in PROC_eeAA/Events/run_01.",
   "TechNoteText"], Cell["Use --work-directory DIR to select another output \
workspace, or --command-file path to run a normal MadEvent command file. \
Existing sessions are retained where they were created; use their own \
bin/madevent program to continue a prepared process. Repeated launches in the \
same workspace preserve its cards and events.", "TechNoteText"],
  Cell["After --prepare finishes, move or copy the whole PROC_eeAA directory \
to the location where you want to keep the numerical process. Enter that \
directory and run ./bin/madevent. Its amplitude sources, headers, \
HEPCAT/SPINAS numerical libraries and private model support are included, so \
the original exported project, build directory and SPINAS checkout can be \
removed without breaking the prepared process. Keep the external MadGraph \
installation, Python, Fortran toolchain and system libraries available. The \
outer eeAA_madevent program is the initial setup launcher; the complete \
prepared directory is the unit to move. Move it between runs while no \
integration or compilation is active.", "TechNoteText"],
  Cell["The independent comparison remains available through \
ValidateMadGraph[exportDirectory] and the generated eeAA_validate_madgraph \
program. The two workflows share the export and selected model while \
performing different calculations.", "TechNoteText"],
  Cell["Export the numerical MadEvent bridge and the independent validator \
together. Set the installation and model explicitly; this example selects \
only electrons, positrons and photons.", "ExampleText"],
  Cell[BoxData[RowBox[{"madGraphDirectory", " ", "=", " ", "FileNameJoin",
      "[", "{", "ParentDirectory", "[", "hepcatDirectory", "]", ",", " ",
      "\"MadGraph\"", "}", "]", ";", "\n", "WriteSPINASProcess", "[",
      "exportDirectory", ",", " ", "{", "\"e\"", ",", " ", "\"E\"", "}", " ",
      "->", " ", "{", "\"A\"", ",", " ", "\"A\"", "}", ",", " ", "entries",
      ",", " ", "knownModel", ",", " ", "\"ProcessName\"", " ", "->", " ",
      "\"eeAA\"", ",", " ", "\"Overwrite\"", " ", "->", " ", "True", ",",
      " ", "\"Build\"", " ", "->", " ", "True", ",", " ",
      "\"MadGraphDirectory\"", " ", "->", " ", "madGraphDirectory", ",", " ",
      "\"MadGraphModel\"", " ", "->", " ", "\"sm-full\"", ",", " ",
      "\"MadGraphAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", "]"}]], "Input"], Cell["This example writes files, starts a \
longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell["Run Both Independent References", "TechNoteSection"],
  Cell["The two reference checks answer separate questions and both should be \
available even when one fails. Ask the exporter to run both checks, with an \
explicit installation and model for each program. The supplied HEPCAT \
expression is not replaced by either reference result.", "TechNoteText"],
  Cell["A failed requested comparison returns Failure. Its ExportResult \
retains the generated project and both reference reports, so a CalcHEP \
failure does not hide the MadGraph result. Compilation or writing source does \
not by itself establish amplitude agreement. Differences in the selected \
theory, masses, couplings or conventions must be investigated rather than \
fitted away.", "TechNoteText"], Cell["Run both comparisons on the same \
exported QED helicity family. Replace the installation paths with your \
selected locations.", "ExampleText"],
  Cell[BoxData[RowBox[{"calcHEPDirectory", " ", "=", " ",
      "\"/path/to/CalcHEP\"", ";", "\n", "exportReport", " ", "=", " ",
      "WriteSPINASProcess", "[", "exportDirectory", ",", " ", "{", "\"e\"",
      ",", " ", "\"E\"", "}", " ", "->", " ", "{", "\"A\"", ",", " ",
      "\"A\"", "}", ",", " ", "entries", ",", " ", "knownModel", ",", "\n",
      " ", " ", "\"ProcessName\"", " ", "->", " ", "\"eeAA\"", ",", " ",
      "\"Overwrite\"", " ", "->", " ", "True", ",", "\n", " ", " ",
      "\"CalcHEPDirectory\"", " ", "->", " ", "calcHEPDirectory", ",", "\n",
      " ", " ", "\"CalcHEPModel\"", " ", "->", " ", "{",
      "feynmanModelDirectory", ",", " ", "2", "}", ",", "\n", " ", " ",
      "\"CalcHEPAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", ",", "\n", " ", " ", "\"MadGraphDirectory\"", " ", "->",
      " ", "madGraphDirectory", ",", " ", "\"MadGraphModel\"", " ", "->",
      " ", "\"sm-full\"", ",", "\n", " ", " ",
      "\"MadGraphAllowedParticles\"", " ", "->", " ", "{", "11", ",", " ",
      "22", "}", ",", "\n", " ", " ", "\"RunCalcHEPValidation\"", " ", "->",
      " ", "True", ",", " ", "\"RunMadGraphValidation\"", " ", "->", " ",
      "True", ",", "\n", " ", " ", "\"ReturnDetails\"", " ", "->", " ",
      "True", "]", ";"}]], "Input"], Cell["This example writes files, starts \
a longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell["Inspect a failed combined comparison without losing the other \
reference report.", "ExampleText"],
  Cell[BoxData[RowBox[{"referenceReports", " ", "=", " ", "Replace", "[",
      "exportReport", ",", " ", "Failure", "[", "\"SPINASValidation\"", ",",
      " ", "data", "_", "Association", "]", " ", ":>", " ", "data", "[",
      "\"ExportResult\"", "]", "]", ";", "\n", "If", "[", "AssociationQ",
      "[", "referenceReports", "]", ",", " ", "KeyTake", "[",
      "referenceReports", ",", " ", "{", "\"CalcHEPValidation\"", ",", " ",
      "\"MadGraphValidation\"", "}", "]", ",", " ", "referenceReports",
      "]"}]], "Input"], Cell["This example writes files, starts a longer \
calculation, or requires an optional external tool. Evaluate it when you want \
to perform that operation.", "ExampleText"], Cell["Related Functions",
   "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["WriteSPINASProcess", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/WriteSPINASProcess"], "  \[Bullet]  ",
     ButtonBox["LookupAmplitude", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/LookupAmplitude"], "  \[Bullet]  ",
     ButtonBox["AppendModelAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/AppendModelAmplitudes"],
     "  \[Bullet]  ", ButtonBox["ModelParameterRules", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ModelParameterRules"],
     "  \[Bullet]  ", ButtonBox["SPINAS", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SPINAS"], "  \[Bullet]  ",
     ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"], "  \[Bullet]  ",
     ButtonBox["ValidateMadGraph", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ValidateMadGraph"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Formatting, Model Output and SPINAS Export",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FormattingAndExport"], "  \[Bullet]  ",
     ButtonBox["Models and Model-Local Parameters", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/ModelsAndParameters"]}],
   "MoreAbout"]}, WindowTitle ->
  "Exporting a Numerical SPINAS Process - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/tutorial/ExportingToSPINAS",
     "title" -> "Exporting a Numerical SPINAS Process", "type" -> "Tutorial",
     "paclet" -> "HEPCAT", "language" -> "en", "summary" -> "Group \
helicities, declare physical crossing and build readable numerical code.",
     "keywords" -> {"HEPCAT", "ExportingToSPINAS", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]