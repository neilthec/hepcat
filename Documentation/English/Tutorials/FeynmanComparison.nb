Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"],
  Cell["Comparing a Constructive Result with Feynman Diagrams",
   "TechNoteTitle"],
  Cell[TextData[
    {"Read a Feynman model, convert its diagrams and compare the same \
process."}], "TechNoteText"],
  Cell[CellGroupData[{Cell["Load HEPCAT if needed", "ExampleSubsection"],
     Cell["Skip this setup if HEPCAT is already loaded. These examples assume \
the checkout is in ~/code/hepcat; change the paths if yours is elsewhere. \
Evaluate loading in its own cell before the calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";", "\n", "modelDirectory", " ", "=", " ",
         "\"~/code/hepcat/models\"", ";", "\n", "feynmanModelDirectory", " ",
         "=", " ", "\"~/code/hepcat/tests/reference-models/calchep\"",
         ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Choose Consistent Models", "TechNoteSection"],
  Cell[TextData[{"A useful independent comparison needs the same particle \
properties, masses, couplings and conventions on both sides. Here the \
constructive QED model supplies the target formula and factorization \
channels, while the bundled CalcHEP QED model supplies the Feynman rules."}],
   "TechNoteText"], Cell[TextData[{"Read each with ",
     ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], ", keeping them in \
separate variables. The diagram entry points recognize ",
     ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"],
     " and generate the corresponding tensor expressions."}],
   "TechNoteText"],
  Cell[TextData[{"Read both models and select a four-point process."}],
   "ExampleText"], Cell[BoxData[RowBox[{"qedModel", " ", "=", " ",
      "ReadModel", "[", "modelDirectory", ",", " ", "2", "]", ";", "\n",
      "feynmanModel", " ", "=", " ", "ReadModel", "[",
      "feynmanModelDirectory", ",", " ", "2", "]", ";", "\n", "process", " ",
      "=", " ", "{", "\"e\"", ",", " ", "\"E\"", ",", " ", "\"A.+\"", ",",
      " ", "\"A.+\"", "}", ";"}]], "Input"],
  Cell["Generate and Convert the Feynman Expression", "TechNoteSection"],
  Cell[TextData[{"Generate the Feynman diagrams with ",
     ButtonBox["CreateDiagrams", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CreateDiagrams"],
     " and convert their complete list using ",
     ButtonBox["DiagramAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/DiagramAmplitudes"], ". The \
intermediate expressions contain Dirac and Lorentz tensors rather than the \
final bracket formula."}], "TechNoteText"],
  Cell[TextData[{ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"], " converts \
supported tensors using the HEPCAT sign and spin conventions. It applies no \
internal on-shell conditions, so this result remains independent of \
constructive diagram-local numerator choices."}], "TechNoteText"],
  Cell[TextData[{"Produce spinor-product Feynman amplitudes."}],
   "ExampleText"], Cell[BoxData[RowBox[{"feynmanDiagrams", " ", "=", " ",
      "CreateDiagrams", "[", "process", ",", " ", "feynmanModel", "]", ";",
      "\n", "feynmanAmplitudes", " ", "=", " ", "FeynmanToSpinorProducts",
      "[", "DiagramAmplitudes", "[", "feynmanDiagrams", "]", "]", ";"}]],
   "Input"], Cell["This example writes files, starts a longer calculation, or \
requires an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Prepare with Shared References",
   "TechNoteSection"],
  Cell[TextData[{ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], " can process the \
converted Feynman expressions. Its reference selection is shared consistently \
across the diagrams. The example uses AllPhysical to resolve the explicit Xi \
spinors into a form suitable for a direct comparison."}], "TechNoteText"],
  Cell[TextData[{"Choosing references is not a license to put an internal \
Feynman line on shell. The preparation recognizes the Feynman input type and \
retains its off-shell internal algebra."}], "TechNoteText"],
  Cell[TextData[
    {"Use a physical-pole preference consistently across the list."}],
   "ExampleText"], Cell[BoxData[RowBox[{"preparedFeynman", " ", "=", " ",
      "PrepareAmplitudes", "[", "feynmanAmplitudes", ",", " ",
      "feynmanModel", ",", " ", "\"PolePreference\"", " ", "->", " ",
      "\"AllPhysical\"", "]", ";"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Compare with a Constructive Result",
   "TechNoteSection"], Cell[TextData[{"Construct the proposed analytic result \
and the original factorization channels, then pass the independent Feynman \
expression to ", ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"], ". The report now \
includes the Feynman comparison alongside the usual consistency checks."}],
   "TechNoteText"], Cell[TextData[{"For a disagreement, inspect the detailed \
report and confirm particle order, crossing, parameters and spin conventions \
before changing a formula. A sign difference is reported as useful diagnostic \
information; the checker does not silently adjust the supplied amplitude to \
force agreement."}], "TechNoteText"],
  Cell[TextData[{"Construct the corresponding analytic result."}],
   "ExampleText"], Cell[BoxData[RowBox[{"finalAmplitude", " ", "=", " ",
      "ConstructAmplitude", "[", "process", ",", " ", "qedModel", ",", " ",
      "qedModel", "]", ";", "\n", "channels", " ", "=", " ",
      "FactorizationAmplitudeChannels", "[", "process", ",", " ", "qedModel",
      "]", ";"}]], "Input"], Cell["This example writes files, starts a longer \
calculation, or requires an optional external tool. Evaluate it when you want \
to perform that operation.", "ExampleText"],
  Cell[TextData[
    {"Include the independent Feynman expression in the combined report."}],
   "ExampleText"], Cell[BoxData[RowBox[{"CheckAmplitudes", "[",
      "finalAmplitude", ",", " ", "channels", ",", " ", "qedModel", ",", " ",
      "\"FeynmanAmplitudes\"", " ", "->", " ", "preparedFeynman", ",", " ",
      "\"FeynmanModel\"", " ", "->", " ", "feynmanModel", ",", " ",
      "\"RandomSeed\"", " ", "->", " ", "314159", "]"}]], "Input"],
  Cell["This example writes files, starts a longer calculation, or requires \
an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Related Functions", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReadModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReadModel"], "  \[Bullet]  ",
     ButtonBox["FeynmanModel", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanModel"], "  \[Bullet]  ",
     ButtonBox["FeynmanToSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/FeynmanToSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"], "  \[Bullet]  ",
     ButtonBox["CheckAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/CheckAmplitudes"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Feynman Models and Spinor Conversion",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/FeynmanAmplitudes"], "  \[Bullet]  ",
     ButtonBox["Checking Amplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/AmplitudeValidation"]}],
   "MoreAbout"]}, WindowTitle -> "Comparing a Constructive Result with \
Feynman Diagrams - HEPCAT Documentation", Saveable -> False,
 WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/tutorial/FeynmanComparison",
     "title" -> "Comparing a Constructive Result with Feynman Diagrams",
     "type" -> "Tutorial", "label" -> "HEPCAT Tutorial",
     "paclet" -> "HEPCAT", "language" -> "en", "summary" -> "Read a Feynman \
model, convert its diagrams and compare the same process.",
     "keywords" -> {"HEPCAT", "FeynmanComparison", "spinor amplitudes"},
     "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]