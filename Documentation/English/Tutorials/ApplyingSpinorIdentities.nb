Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Applying Spinor Identities in a Derivation",
   "TechNoteTitle"],
  Cell[TextData[
    {"Use ordinary reductions and inspect individual legal rewrites."}],
   "TechNoteText"], Cell[CellGroupData[{Cell["Load HEPCAT if needed",
      "ExampleSubsection"], Cell["Skip this setup if HEPCAT is already \
loaded. These examples assume the checkout is in ~/code/hepcat; change the \
paths if yours is elsewhere. Evaluate loading in its own cell before the \
calculation.", "ExampleText"],
     Cell[BoxData[RowBox[{"Get", "[", "\"~/code/hepcat/source/HEPCAT.wl\"",
         "]", ";"}]], "Input", InitializationCell -> True]}, Closed]],
  Cell["Ordinary Reduction", "TechNoteSection"],
  Cell[TextData[{"Start with ", ButtonBox["ReduceSpinorProducts",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ReduceSpinorProducts"], " for ordinary bracket and \
chain identities. It applies external on-shell relations but does not know a \
diagram's internal on-shell assumptions. The equal-endpoint massless square \
bracket below is a simple example whose result you can check immediately."}],
   "TechNoteText"], Cell[TextData[{"Reduce a self-bracket."}],
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Square\"", ",", " ", "4", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "4", "]", "]",
      "]"}]], "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["Keep Denominators Protected", "TechNoteSection"],
  Cell[TextData[{"Use ", ButtonBox["ApplyToNumerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplyToNumerator"], " when a \
replacement is valid in numerators but must not change denominators. It walks \
over the additive terms in the expression as supplied. It neither calls \
Together to combine the fractions nor expands a factored numerator."}],
   "TechNoteText"], Cell[TextData[{"This separation matters for constructive \
internal-shell identities. A numerator relation must not turn the physical \
propagator denominator of the diagram into zero. ",
     ButtonBox["PlainText", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PlainText"], " is useful when you want \
to read or save an intermediate spinor expression as text."}],
   "TechNoteText"], Cell[TextData[{"Replace a numerator symbol while keeping \
an ordinary denominator untouched."}], "ExampleText"],
  Cell[BoxData[RowBox[{"ApplyToNumerator", "[", "x", "/", "y", " ", "+", " ",
      "x", "/", "z", ",", " ", "x", " ", "->", " ", "a", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"a", "/", "y", " ", "+", " ", "a", "/", "z"}]],
   "Output"],
  Cell[TextData[{"Inspect the transformed expression in text form."}],
   "ExampleText"], Cell[BoxData[RowBox[{"PlainText", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"<12>\""}]], "Output"],
  Cell["Explore a Single Identity", "TechNoteSection"],
  Cell[TextData[{"For a derivation that you can replay, ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     " lists the legal local edits of a ",
     Cell[BoxData[RowBox[{"{", "massRules", ",", " ", "expression", "}"}]],
      "InlineFormula"], " pair. An edit records the identity and the \
expression pieces it changes. ", ButtonBox["ApplySpinorIdentity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/ApplySpinorIdentity"],
     " checks that the edit is still legal before applying it."}],
   "TechNoteText"], Cell[TextData[{"The example deliberately disables \
internal-shell and momentum-conservation moves, so only ordinary identities \
are being explored. Applying the first listed edit illustrates the mechanism; \
it does not assert that the first edit is the best simplification. Compare \
resulting expressions with ", ButtonBox["SpinorExpressionComplexity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorExpressionComplexity"],
     ", and retain the edit if you want a reproducible route."}],
   "TechNoteText"],
  Cell[TextData[
    {"List ordinary exact edits for a product of angle brackets."}],
   "ExampleText"], Cell[BoxData[RowBox[{"pair", " ", "=", " ", "{", "{", "}",
      ",", " ", "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "1", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "2", "]", "]", " ",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "3", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "4", "]", "]", "}",
      ";", "\n", "edits", " ", "=", " ", "SpinorIdentityCandidates", "[",
      "pair", ",", " ", "\"OnShellChannels\"", " ", "->", " ", "{", "}", ",",
      " ", "\"MomentumConservation\"", " ", "->", " ", "False", "]", ";",
      "\n", "Length", "[", "edits", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"1"}]], "Output"],
  Cell[TextData[
    {"Apply one of the listed identities and inspect the resulting \
expression."}], "ExampleText"],
  Cell[BoxData[RowBox[{"editedExpression", " ", "=", " ",
      "ApplySpinorIdentity", "[", "pair", ",", " ", "First", "[", "edits",
      "]", ",", " ", "\"OnShellChannels\"", " ", "->", " ", "{", "}", ",",
      " ", "\"MomentumConservation\"", " ", "->", " ", "False", "]"}]],
   "Input"],
  Cell[BoxData[RowBox[
     {RowBox[{"-", RowBox[{"(", RowBox[{InterpretationBox[TemplateBox[
              {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
               TemplateBox[{"4", "\"\[RightAngleBracket]\""}, "RowDefault"]},
              "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 1],
              Spinor["Helicity", "Angle", 4]], Editable -> False], " ",
            InterpretationBox[TemplateBox[{TemplateBox[
                {"\"\[LeftAngleBracket]\"", "2"}, "RowDefault"], TemplateBox[
                {"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
              "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 2],
              Spinor["Helicity", "Angle", 3]], Editable -> False]}], ")"}]}],
      "+", RowBox[{InterpretationBox[TemplateBox[
          {TemplateBox[{"\"\[LeftAngleBracket]\"", "1"}, "RowDefault"],
           TemplateBox[{"3", "\"\[RightAngleBracket]\""}, "RowDefault"]},
          "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 1],
          Spinor["Helicity", "Angle", 3]], Editable -> False], " ",
        InterpretationBox[TemplateBox[{TemplateBox[
            {"\"\[LeftAngleBracket]\"", "2"}, "RowDefault"],
           TemplateBox[{"4", "\"\[RightAngleBracket]\""}, "RowDefault"]},
          "RowDefault"], SpinorChain[Spinor["Helicity", "Angle", 2],
          Spinor["Helicity", "Angle", 4]], Editable -> False]}]}]],
   "Output"],
  Cell[TextData[
    {"Compare the expression complexity before and after that edit."}],
   "ExampleText"], Cell[BoxData[RowBox[{"SpinorExpressionComplexity", " ",
      "/@", " ", "{", "pair", "[", "[", "2", "]", "]", ",", " ",
      "editedExpression", "}"}]], "Input"],
  Cell[BoxData[RowBox[{"{", "1", ",", " ", "2", "}"}]], "Output"],
  Cell["Use Known Masses Only Where Valid", "TechNoteSection"],
  Cell[TextData[{"When an expression comes from one constructive diagram, its \
accompanying mass list can justify additional numerator identities. ",
     ButtonBox["PrepareAmplitudes", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/PrepareAmplitudes"],
     " keeps that scope local to the item it is preparing."}],
   "TechNoteText"], Cell[TextData[{"Once diagrams have been combined into a \
complete amplitude, keep only external mass rules for further ordinary \
simplification. Reapplying every diagram's internal on-shell conditions to \
the sum would impose incompatible assumptions on different terms. Use the ",
     ButtonBox["kinematics tutorial", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/tutorial/KinematicsAndOnShellConditions"],
     " to follow that distinction in the full workflow."}], "TechNoteText"],
  Cell["Related Functions", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["ApplyToNumerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplyToNumerator"], "  \[Bullet]  ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     "  \[Bullet]  ", ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"],
     "  \[Bullet]  ", ButtonBox["SpinorExpressionComplexity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorExpressionComplexity"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["Spinors, Momenta and Spin Sums", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}], "MoreAbout"]},
 WindowTitle ->
  "Applying Spinor Identities in a Derivation - HEPCAT Documentation",
 Saveable -> False, WindowSize -> {1000, 850}, CellContext -> Notebook,
 TaggingRules -> {"Metadata" -> {"context" -> "ConstructiveDiagrams`",
     "uri" -> "HEPCAT/tutorial/ApplyingSpinorIdentities",
     "title" -> "Applying Spinor Identities in a Derivation",
     "type" -> "Tutorial", "label" -> "HEPCAT Tutorial",
     "paclet" -> "HEPCAT", "language" -> "en",
     "summary" ->
      "Use ordinary reductions and inspect individual legal rewrites.",
     "keywords" -> {"HEPCAT", "ApplyingSpinorIdentities",
       "spinor amplitudes"}, "status" -> "None", "index" -> True}},
 StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "Reference.nb"]]