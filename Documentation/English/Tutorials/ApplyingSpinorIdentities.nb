Notebook[
 {Cell[BoxData[GridBox[{{Cell["HEPCAT TUTORIAL", "PacletNameCell"],
       Cell[TextData[{ButtonBox["HEPCAT", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"], "  \[Bullet]  ",
          ButtonBox["Related Guide", BaseStyle -> "Link",
           ButtonData -> "paclet:HEPCAT/guide/HEPCAT"]}], "AnchorBar"]}},
     GridBoxAlignment -> {"Columns" -> {Left, Right}},
     GridBoxItemSize -> {"Columns" -> {Scaled[0.42], Scaled[0.58]}}]],
   "AnchorBarGrid"], Cell["Applying Spinor Identities in a Derivation",
   "TechNoteTitle"],
  Cell["Use ordinary reductions and inspect individual legal rewrites.",
   "TechNoteText"], Cell[CellGroupData[
    {Cell["Load HEPCAT", "ExampleSubsection"], Cell["Evaluate this setup once \
before the examples. The paths refer to the local HEPCAT checkout; no model \
parameters are assigned global numerical values.", "ExampleText"],
     Cell[BoxData[RowBox[{"If", "[", "!", "StringQ", "[",
         "Global`$HEPCATpath", "]", " ", "||", " ", "!", "DirectoryQ", "[",
         "Global`$HEPCATpath", "]", ",", "\n", " ", " ",
         "Global`$HEPCATpath", " ", "=", " ", "FileNameJoin", "[", "{",
         "First", "[", "PacletFind", "[", "\"HEPCAT\"", "]", "]", "[",
         "\"Location\"", "]", ",", " ", "\"source\"", "}", "]", "]", ";",
         "\n", "If", "[", "!", "MemberQ", "[", "$Packages", ",", " ",
         "\"ConstructiveDiagrams`\"", "]", ",", "\n", " ", " ", "Get", "[",
         "FileNameJoin", "[", "{", "Global`$HEPCATpath", ",", " ",
         "\"HEPCAT.wl\"", "}", "]", "]", "]", ";", "\n", "hepcatDirectory",
         " ", "=", " ", "ParentDirectory", "[", "Global`$HEPCATpath", "]",
         ";", "\n", "modelDirectory", " ", "=", " ", "FileNameJoin", "[",
         "{", "hepcatDirectory", ",", " ", "\"models\"", "}", "]", ";", "\n",
         "feynmanModelDirectory", " ", "=", " ", "FileNameJoin", "[", "{",
         "hepcatDirectory", ",", " ", "\"model_feynman\"", "}", "]", ";"}]],
      "Input", InitializationCell -> True]}, Open]],
  Cell["Ordinary Reduction", "TechNoteSection"],
  Cell["ReduceSpinorProducts applies HEPCAT's oriented spinor rules. It \
handles ordinary momentum-chain algebra and external mass identities, but it \
does not know the total number of particles, infer momentum conservation or \
impose internal on-shell conditions.", "TechNoteText"],
  Cell["ReduceSpinContractions and ReduceSpinorProducts have distinct roles. \
First contract the explicit spin indices, then reduce the resulting chains. \
For an amplitude, process-aware preparation performs the broader bounded \
simplification search.", "TechNoteText"], Cell["Reduce a self-bracket.",
   "ExampleText"], Cell[BoxData[RowBox[{"ReduceSpinorProducts", "[",
      "SpinorChain", "[", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Square\"", ",", " ", "4", "]", ",", " ", "Spinor", "[",
      "\"Helicity\"", ",", " ", "\"Square\"", ",", " ", "4", "]", "]",
      "]"}]], "Input"], Cell[BoxData[RowBox[{"0"}]], "Output"],
  Cell["Keep Denominators Protected", "TechNoteSection"],
  Cell["applyToNumerator takes replacement rules and applies them to the \
numerator of each existing top-level term. It does not combine terms using \
Together and does not expand them first. This is useful when an identity is \
valid only in the numerator of a particular diagram.", "TechNoteText"],
  Cell["Replace a numerator symbol while keeping an ordinary denominator \
untouched.", "ExampleText"],
  Cell[BoxData[RowBox[{"applyToNumerator", "[", "x", "/", "y", " ", "+", " ",
      "x", "/", "z", ",", " ", "x", " ", "->", " ", "a", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"a", "/", "y", " ", "+", " ", "a", "/", "z"}]],
   "Output"], Cell["Inspect the transformed expression in text form.",
   "ExampleText"], Cell[BoxData[RowBox[{"PlainText", "[", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "1",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "2", "]", "]", "]"}]], "Input"],
  Cell[BoxData[RowBox[{"\"<12>\""}]], "Output"],
  Cell["Explore a Single Identity", "TechNoteSection"],
  Cell["SpinorIdentityCandidates lists legal local rewrites. Each candidate \
carries enough information for ApplySpinorIdentity to replay it. Inspect the \
returned data rather than inventing a process-specific substitution that has \
not been justified.", "TechNoteText"], Cell["The complexity score is a search \
heuristic. A lower score is helpful, but an intermediate increase can be \
required for cancellations. Use the candidate details and exact identities to \
justify the derivation independently of the heuristic.", "TechNoteText"],
  Cell["Build a Schouten expression and inspect candidate identities.",
   "ExampleText"], Cell[BoxData[RowBox[{"expr", " ", "=", " ", "SpinorChain",
      "[", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ",
      "1", "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ",
      "\"Angle\"", ",", " ", "2", "]", "]", " ", "SpinorChain", "[",
      "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"", ",", " ", "3",
      "]", ",", " ", "Spinor", "[", "\"Helicity\"", ",", " ", "\"Angle\"",
      ",", " ", "4", "]", "]", ";", "\n", "SpinorIdentityCandidates", "[",
      "expr", "]"}]], "Input"], Cell["This example writes files, starts a \
longer calculation, or requires an optional external tool. Evaluate it when \
you want to perform that operation.", "ExampleText"],
  Cell["Measure a search expression.", "ExampleText"],
  Cell[BoxData[RowBox[{"SpinorExpressionComplexity", "[", "expr", "]"}]],
   "Input"], Cell["This example writes files, starts a longer calculation, or \
requires an optional external tool. Evaluate it when you want to perform that \
operation.", "ExampleText"], Cell["Use Known Masses Only Where Valid",
   "TechNoteSection"], Cell["For an individual constructive diagram, the \
declared internal masses may be used in its numerator. For a factorization \
channel, only the cut line is additionally on shell. For the final sum and \
for all Feynman internal propagators, keep internal momenta off shell.",
   "TechNoteText"], Cell["Do not prove equivalence of two final amplitudes by \
imposing their internal on-shell conditions. Compare them with ordinary \
spinor identities, external conditions and momentum conservation, or use the \
validation framework for numerical evidence.", "TechNoteText"],
  Cell["Related Functions", "SeeAlsoSection"],
  Cell[TextData[{ButtonBox["ReduceSpinContractions", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinContractions"],
     "  \[Bullet]  ", ButtonBox["ReduceSpinorProducts", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ReduceSpinorProducts"],
     "  \[Bullet]  ", ButtonBox["applyToNumerator", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/applyToNumerator"], "  \[Bullet]  ",
     ButtonBox["SpinorIdentityCandidates", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/SpinorIdentityCandidates"],
     "  \[Bullet]  ", ButtonBox["ApplySpinorIdentity", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/ref/ApplySpinorIdentity"],
     "  \[Bullet]  ", ButtonBox["SpinorExpressionComplexity",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/ref/SpinorExpressionComplexity"]}], "SeeAlso"],
  Cell["Related Guides", "MoreAboutSection"],
  Cell[TextData[{ButtonBox["Identities and Simplification",
      BaseStyle -> "Link", ButtonData ->
       "paclet:HEPCAT/guide/IdentitiesAndSimplification"], "  \[Bullet]  ",
     ButtonBox["Spinors, Momenta and Spin Sums", BaseStyle -> "Link",
      ButtonData -> "paclet:HEPCAT/guide/SpinorAlgebra"]}], "MoreAbout"]},
